{
  // Tarefas do projeto — Terminal › Executar Tarefa (ou Ctrl+Shift+P › "Run Task").
  // A ideia é não precisar digitar comando nenhum: cada coisa que a gente faz no
  // dia a dia virou um item desta lista, na ordem em que costuma acontecer.
  //
  // Duas versões do código convivem: a PUBLICADA (branch main, o que está na
  // rede) e a DE TESTE (branch do Claude, o que ainda está sendo avaliado).
  // As tarefas 1a/1b trocam entre elas; nenhuma usa "git pull", que tentava
  // juntar a cópia velha com a nova e dava conflito.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1a · Pegar a versão PUBLICADA (main)",
      "detail": "Deixa o código igual ao que está na rede. Descarta alteração local não salva no GitHub.",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "git fetch origin main; if ($?) { git checkout -B main origin/main; git log --oneline -1 }"
        ]
      },
      "command": "git fetch origin main && git checkout -B main origin/main && git log --oneline -1",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "1b · Pegar a versão DE TESTE (branch do Claude)",
      "detail": "Traz a última entrega para testar antes de publicar. Descarta alteração local não salva no GitHub.",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "git fetch origin claude/licenses-project-visual-identity-wiaoc1; if ($?) { git checkout -B claude/licenses-project-visual-identity-wiaoc1 origin/claude/licenses-project-visual-identity-wiaoc1; git log --oneline -1 }"
        ]
      },
      "command": "git fetch origin claude/licenses-project-visual-identity-wiaoc1 && git checkout -B claude/licenses-project-visual-identity-wiaoc1 origin/claude/licenses-project-visual-identity-wiaoc1 && git log --oneline -1",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "2 · Compilar",
      "detail": "Compila e mostra os erros — sempre rode isto antes de publicar.",
      "type": "shell",
      "command": "dotnet build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "3 · Rodar o programa",
      "detail": "Sobe o sistema na primeira porta livre e abre o navegador. Fecha sozinho quando a última aba fechar.",
      "type": "shell",
      "command": "dotnet run",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "3b · Rodar mesmo com o programa preso",
      "detail": "Use quando o build reclamar de 'arquivo em uso': compila em outra pasta e sobe em outra porta.",
      "type": "shell",
      "command": "dotnet run --property:OutDir=bin/Debug/run2/",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "4 · Publicar na rede",
      "detail": "Compila em Release e publica na pasta da rede, com atalho e logo. Antes, rode 1a.",
      "type": "shell",
      "windows": { "command": "${workspaceFolder}\\publicar.bat" },
      "command": "./publicar.bat",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Encerrar o programa aberto",
      "detail": "Mata as cópias do programa rodando nesta máquina (a que trava o build ou a porta).",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "Get-Process 'Howden Sales Forecast' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; taskkill /IM 'Howden Sales Forecast.exe' /F 2>$null | Out-Null; Start-Sleep 1; $v = Get-Process 'Howden Sales Forecast' -ErrorAction SilentlyContinue; if ($v) { Write-Host \"Ainda vivo (PID $($v.Id -join ', ')): foi iniciado com mais privilegio que este terminal. Feche o VS Code inteiro e abra de novo, ou reinicie o computador.\" } else { Write-Host 'Pronto: nenhuma copia do programa rodando.' }"
        ]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Consertar o atalho da rede",
      "detail": "Recria só o atalho (com a logo), sem republicar o programa.",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass",
          "-File", "${workspaceFolder}\\atalho.ps1",
          "-Destino", "\\\\BZVCPFIL003\\proj_ramires$\\DB\\AFM_HSA\\previsao\\arquivo\\02"
        ]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Criar o atalho na minha área de trabalho",
      "detail": "Põe o atalho com a logo na sua área de trabalho (logo guardado na máquina).",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass",
          "-File", "${workspaceFolder}\\atalho.ps1",
          "-AreaDeTrabalho",
          "-Alvo", "\\\\BZVCPFIL003\\proj_ramires$\\DB\\AFM_HSA\\previsao\\arquivo\\02",
          "-IconeLocal"
        ]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
