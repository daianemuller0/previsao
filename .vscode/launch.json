{
  // F5 roda o sistema com depuração (pontos de parada funcionam).
  // Para só rodar, sem depurar: Ctrl+F5, ou a tarefa "3 · Rodar o programa".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rodar o Howden Sales Forecast",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "2 · Compilar",
      "program": "${workspaceFolder}/bin/Debug/net8.0/Howden Sales Forecast.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      // O próprio programa abre o navegador (OpenBrowser no appsettings).
      "serverReadyAction": { "action": "none" },
      "env": { "DOTNET_ENVIRONMENT": "Development" }
    }
  ]
}
