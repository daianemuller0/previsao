<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HowdenSalesForecast</RootNamespace>

    <!-- Ícone do executável: é o que aparece no atalho do Windows. -->
    <ApplicationIcon>wwwroot\howden.ico</ApplicationIcon>
    <!-- Identificação exibida nas propriedades do arquivo (.exe). -->
    <AssemblyName>Howden Sales Forecast</AssemblyName>
    <Product>Howden Sales Forecast</Product>
    <Company>Howden · A Chart Industries Company</Company>
    <Description>Sales &amp; Revenue Intelligence — Howden Brasil</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider ADO.NET do DuckDB (inclui a lib nativa). Mesma versão do projeto
         de Licenças, para manter o padrão de dados aprovado internamente. -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.3" />
    <!-- Leitura/escrita de Excel moderno (.xlsx/.xlsm) -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- Leitura do Excel ANTIGO (.xls, formato binário BIFF). O CRM exporta a
         planilha do Aftermarket nesse formato e o ClosedXML só lê OpenXML. -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <!-- Codificações legadas (windows-1252 etc.) exigidas pelo .xls no .NET. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
