@inject OpportunityRepository Repo
@inject Catalog Cat
@inject NavigationManager Nav
@inject ListRepository Lists
@inject ControleRepository Controle
@inject ColumnPrefsRepository ColPrefs
@inject IJSRuntime JS
@implements IDisposable

@* Tabela de oportunidades reutilizável. Apresenta EXATAMENTE as mesmas colunas
   da guia Oportunidades e oferece as mesmas ações (editar, duplicar e excluir),
   para que as listagens da Visão Executiva se comportem igual à guia — sem
   inventar campos nem comportamentos. *@
@* Barra de colunas: cada usuário escolhe ordem e o que fica visível. *@
@if (ShowColumnPicker)
{
    <div class="cols-bar">
        <button class="btn-link" @onclick="() => _colsOpen = !_colsOpen">@Icons.Svg("layers")Colunas</button>
        <span class="muted" style="font-size:11.5px">@_cols.Count(c => c.Visible) de @_cols.Count visíveis</span>
    </div>
}
@if (_colsOpen)
{
    <ColumnPicker Cols="_cols" OnApply="AplicarColunas" OnReset="ResetarColunas" OnClose="() => _colsOpen = false" />
}

@* Régua de rolagem horizontal ACIMA da tabela: com dezenas de colunas, a barra
   lá embaixo obriga a percorrer a lista inteira só para deslocar as colunas. *@
<div class="tbl-scroll-topo" id="@RolaId"><div></div></div>
<div class="table-wrap @CssClass" id="@WrapId" style="@Style">
    <table class="grid-tbl">
        <thead>
            @* Arraste o cabeçalho para reordenar as colunas (guardado por usuário). *@
            <tr id="@HeadId" class="th-drag">
                <th class="center actions-col"></th>
                @foreach (var c in Visiveis)
                {
                    <th class="@c.Def.Align" draggable="true" data-key="@c.Def.Key" title="@c.Def.Label — arraste para mover a coluna">@c.Def.Label</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Rows)
            {
                var q = o.ExpectedDateValue is { } dt ? $"Q{Fmt.QuarterOf(dt.Month)} {dt.Year}" : "—";
                <tr class="clickable @(o.IndicadaValue ? "row-ind" : "") @(Sim(o.Otp) ? "row-otp" : "")" @onclick='() => Nav.NavigateTo($"/oportunidades/{o.Id}")'>
                    <td class="center actions-col">
                        <button class="row-act ind-btn @(o.IndicadaValue ? "on" : "")" title="@(o.IndicadaValue ? "Remover da Previsão" : "Indicar na Previsão")" @onclick="() => ToggleIndicada(o)" @onclick:stopPropagation="true">@Icons.Svg("flag")</button>
                        @if (o.PrevisaoIncompleta)
                        {
                            <button class="row-act pend" title="Indicada na previsão, mas faltam dados: @string.Join(", ", o.PendenciasPrevisao)" @onclick="() => AbrirPendencias(o)" @onclick:stopPropagation="true">@Icons.Svg("alert")</button>
                        }
                        <button class="row-act sell" title="Indicar venda — mover para o Controle (Ofertas e pedidos)" @onclick="() => OpenSell(o)" @onclick:stopPropagation="true">@Icons.Svg("dollar")</button>
                        <button class="row-act" title="Editar oportunidade" @onclick="() => OpenEdit(o)" @onclick:stopPropagation="true">@Icons.Svg("edit")</button>
                        <button class="row-act" title="Duplicar oportunidade" @onclick="() => Duplicate(o)" @onclick:stopPropagation="true">@Icons.Svg("copy")</button>
                        <button class="row-act del" title="Excluir oportunidade" @onclick="() => AskDelete(o)" @onclick:stopPropagation="true">@Icons.Svg("trash")</button>
                    </td>
                    @foreach (var c in Visiveis)
                    {
                        switch (c.Def.Key)
                        {
                            // SetorEfetivo, e nao o campo cru: cobre as linhas antigas sem o
                            // campo gravado e as criadas a mao, que escolhem o setor.
                            case "setor":     <td class="center">@if (o.SetorEfetivo != "") { <span class="setor-tag setor-@o.SetorEfetivo.ToLower()">@o.SetorEfetivo</span> }</td> break;
                            case "quarter":   <td class="nowrap">@q</td> break;
                            case "date":      <td class="nowrap">@MonthLabel(o)</td> break;
                            case "pais":      <td>@Cat.CountryName(o.CountryId)</td> break;
                            case "marketvar": <td>@Cat.SubMarketName(o.SubMarketId)</td> break;
                            case "market":    <td>@Cat.MarketName(o.MarketId)</td> break;
                            case "product":   <td>@Cat.ProductName(o.ProductId)</td> break;
                            case "kam":       <td>@Cat.KamName(o.KamId)</td> break;
                            case "customer":  <td class="col-strong">@Cat.CustomerName(o.CustomerId)</td> break;
                            case "plantname": <td>@Dash(o.EndUserSite)</td> break;
                            case "proposta":  <td>@o.ProposalNumber</td> break;
                            case "netvalue":  <td class="right num">@Fmt.Brl(o.AmountBrl)</td> break;
                            case "pm":        <td class="right num">@Fmt.Pct(o.GmPercentValue)</td> break;
                            case "ganho":     <td class="right num">@Fmt.Pct(o.WinProbabilityValue)</td> break;
                            case "sairmes":   <td class="right num">@Fmt.Pct(o.CloseProbabilityValue)</td> break;
                            case "conversao": <td class="right num">@Fmt.Brl(ForecastCalc.ConversionBrl(o))</td> break;
                            case "nbafm":     <td class="center">@Dash(o.CategoriaNbAfm)</td> break;
                            case "servico":   <td>@Dash(o.ServicoPrevisto)</td> break;
                            case "onestream": <td>@Dash(o.MarketOnestream)</td> break;
                            case "unidade":   <td>@Dash(Cat.BuCode(o.PvBusinessUnitId))</td> break;
                            case "buinter":   <td>@Dash(Cat.BuCode(o.IntercompanyBu))</td> break;
                            case "obs":       <td>@Dash(o.Notes)</td> break;
                            case "pv":        <td>@Dash(o.PvNumber)</td> break;
                            case "ramp":      <td>@Dash(o.Ramp)</td> break;
                            case "usd":       <td class="right num">@Fmt.Usd(o.AmountUsd)</td> break;
                            case "taxa":      <td class="right num">@o.ExchangeRateValue.ToString("0.00", _pt)</td> break;
                            case "coluna1":   <td>@Dash(o.Coluna1)</td> break;
                            case "otp":       <td class="center">@Mark(o.Otp)</td> break;
                            case "top10":     <td class="center">@Mark(o.Top10)</td> break;
                            case "kyc":       <td class="center">@Mark(o.Kyc)</td> break;
                        }
                    }
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="@(Visiveis.Count + 1)" class="empty">@EmptyText</td></tr>
            }
        </tbody>
    </table>
</div>

@* ---- Datalists das listas de preenchimento (sugestões + texto livre) ---- *@
@foreach (var (id, key) in FormLists)
{
    <datalist id="@id">
        @foreach (var v in Lists.Items(key)) { <option value="@v" /> }
    </datalist>
}

@* ---- Dados obrigatórios da previsão (ao indicar a oportunidade) ---- *@
@if (_pend is not null)
{
    <div class="drawer-backdrop" @onclick="FecharPendencias"></div>
    <div class="confirm-box" style="width:min(560px,calc(100vw - 32px))">
        <div class="confirm-head" style="color:var(--warn, #b7791f)">@Icons.Svg("alert")<span>Complete os dados da previsão</span></div>
        <p class="confirm-text">
            <strong>@_pend.Name</strong> entrou na previsão. Falta preencher:
            <strong>@string.Join(", ", _pendFaltam)</strong>.
        </p>
        <div class="form-grid">
            <label class="fld">% de Ganho<input class="field num" @bind="_pend.WinProbability" /></label>
            <label class="fld">% de Sair no Mês<input class="field num" @bind="_pend.CloseInPeriodProbability" /></label>
            <label class="fld">RAMP<input class="field" @bind="_pend.Ramp" /></label>
            <label class="fld">OTP<select class="field" @bind="_pend.Otp"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">TOP 10<select class="field" @bind="_pend.Top10"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">KYC<select class="field" @bind="_pend.Kyc"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
        </div>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="FecharPendencias">Preencher depois</button>
            <button class="btn-primary" @onclick="SalvarPendencias">@Icons.Svg("check")Salvar</button>
        </div>
    </div>
}

@* ---- Confirmar exclusão de uma oportunidade ---- *@
@if (_delTarget is not null)
{
    <div class="drawer-backdrop" @onclick="() => _delTarget = null"></div>
    <div class="confirm-box">
        <div class="confirm-head">@Icons.Svg("alert")<span>Excluir oportunidade</span></div>
        <p class="confirm-text">Tem certeza que deseja excluir <strong>@_delTarget.Name</strong> (@_delTarget.ProposalNumber)? Esta ação não pode ser desfeita.</p>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _delTarget = null">Cancelar</button>
            <button class="btn-danger" @onclick="ConfirmDelete">@Icons.Svg("trash")Excluir</button>
        </div>
    </div>
}

@* ---- Indicar venda: confirmar/editar os dados que vão para o Controle ---- *@
@if (_sell is not null && _sellReg is not null)
{
    <div class="drawer-backdrop" @onclick="() => _sell = null"></div>
    <div class="confirm-box" style="width:min(640px,calc(100vw - 32px))">
        <div class="confirm-head">@Icons.Svg("dollar")<span>Indicar venda</span></div>
        <p class="confirm-text">Confira e, se precisar, <strong>edite</strong> os dados. Ao confirmar, a oferta <strong>sai das Oportunidades</strong> e vai para o <strong>Controle · Ofertas e pedidos</strong>.</p>
        <div class="form-grid">
            <label class="fld">Oferta (proposta)<input class="field" @bind="_sellReg.Oferta" /></label>
            <label class="fld">Pedido (PV)<input class="field" @bind="_sellReg.Pedido" /></label>
            <label class="fld full">Cliente<input class="field" @bind="_sellReg.Cliente" /></label>
            <label class="fld">Mercado<input class="field" @bind="_sellReg.Mercado" /></label>
            <label class="fld">Vendedor (KAM)<input class="field" @bind="_sellReg.Kam" /></label>
            <label class="fld">Tipo
                <select class="field" @bind="_sellReg.Tipo">
                    <option value="">—</option>
                    @foreach (var t in ControleRegistro.Tipos){<option value="@t">@t</option>}
                </select>
            </label>
            <label class="fld">Status<input class="field" list="dl-status-oferta" @bind="_sellReg.Status" placeholder="situação da oferta" /></label>
            <label class="fld">Valor Líquido (R$)<input class="field num" @bind="_sellReg.ValorLiquido" /></label>
            <label class="fld">Classificação do valor <span class="hint">define a cor na tabela do Controle</span>
                <select class="field" @bind="_sellReg.Classificacao">
                    <option value="">—</option>
                    @foreach (var c in ControleRegistro.Classificacoes){<option value="@c">@c</option>}
                </select>
            </label>
            <label class="fld">POC
                <select class="field" @bind="_sellReg.Poc"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select>
            </label>
            <label class="fld">Moeda de origem<input class="field" @bind="_sellReg.Moeda" /></label>
            <label class="fld">Valor na moeda de origem<input class="field num" @bind="_sellReg.ValorOriginal" /></label>
            <label class="fld">Semana<input class="field num" @bind="_sellReg.Semana" /></label>
            <label class="fld">Mês
                @* Número, não nome: é o que o Controle usa para achar o câmbio
                   de fechamento do mês da oferta. *@
                <select class="field" @bind="_sellReg.Mes"><option value="">—</option>@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select>
            </label>
            <label class="fld full">Observação<textarea class="field" rows="2" @bind="_sellReg.Observacao"></textarea></label>
            <label class="fld full">Nota de atenção <span class="hint">se preenchida, a oferta fica destacada para o Controle</span>
                <textarea class="field" rows="2" @bind="_sellReg.Atencao" placeholder="Ex.: pendência documental, aguardando aprovação…"></textarea>
            </label>
        </div>
        <datalist id="dl-status-oferta">@foreach (var v in Lists.Items("status_oferta")){<option value="@v" />}</datalist>
        @if (!string.IsNullOrEmpty(_sellErr)) { <div class="confirm-err">@_sellErr</div> }
        <div class="modal-actions">
            <button class="btn-ghost" disabled="@_sellBusy" @onclick="() => _sell = null">Cancelar</button>
            <button class="btn-primary" disabled="@_sellBusy" @onclick="ConfirmSell">
                @if (_sellBusy) { <span class="spinner-sm"></span><text>Movendo…</text> } else { @Icons.Svg("check") <text>OK, indicar venda</text> }
            </button>
        </div>
    </div>
}

@* ---- Editar / duplicar oportunidade (todos os campos) ---- *@
@if (_edit is not null)
{
    <div class="drawer-backdrop" @onclick="() => _edit = null"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">@(_editDup ? "Duplicar oportunidade" : "Editar oportunidade")</h2>
                <p class="subtitle">@(_editDup ? "Cópia — ajuste só o que muda e salve como nova" : $"{_edit.ProposalNumber} · altere qualquer campo")</p>
            </div>
            <button class="icon-btn" @onclick="() => _edit = null">@Icons.Svg("x")</button>
        </div>
        <div class="form-grid">
            <label class="fld full">Nome da oportunidade<input class="field" @bind="_edit.Name" /></label>

            <label class="fld">Mês da previsão
                <select class="field" @bind="_editMonthNum">@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select>
            </label>
            <label class="fld">Ano da previsão
                <select class="field" @bind="_editYear">@for (var y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++){<option value="@y">@y</option>}</select>
            </label>
            <label class="fld">Proposta<input class="field" @bind="_edit.ProposalNumber" /></label>
            <label class="fld">PV<input class="field" @bind="_edit.PvNumber" /></label>

            <label class="fld">País<input class="field" list="dl-pais" @bind="_edit.CountryId" /></label>
            <label class="fld">Market<input class="field" list="dl-market" @bind="_edit.MarketId" /></label>
            <label class="fld">Market Variável<input class="field" list="dl-market_var" @bind="_edit.SubMarketId" /></label>
            <label class="fld">Product<input class="field" list="dl-product" @bind="_edit.ProductId" /></label>
            <label class="fld">Key Account<input class="field" list="dl-key_account" @bind="_edit.KamId" /></label>
            <label class="fld">Customer<input class="field" list="dl-customer" @bind="_edit.CustomerId" /></label>
            @* PlantName vem da planilha (AFM: coluna PlantName; NB: End User Site). *@
            <label class="fld">PlantName<input class="field" @bind="_edit.EndUserSite" /></label>

            @* Veio de planilha: a categoria é o setor de origem e não se inventa.
               Criada à mão: não há planilha por trás, então é a pessoa que diz —
               e a escolha alimenta a coluna Setor. *@
            @if (_edit.VeioDePlanilha)
            {
                <label class="fld">Categoria (NB/AFM) <span class="hint">vem do setor de origem</span>
                    <input class="field" value="@_edit.CategoriaNbAfm" readonly />
                </label>
            }
            else
            {
                <label class="fld">Categoria (NB/AFM) <span class="hint">define a coluna Setor</span>
                    <select class="field" @bind="_edit.Setor">
                        <option value="">—</option>
                        @foreach (var st in Opportunity.SetoresManuais){<option value="@st">@st</option>}
                    </select>
                </label>
            }
            <label class="fld">Serviço previsto<input class="field" list="dl-servico" @bind="_edit.ServicoPrevisto" /></label>
            <label class="fld">Etapa do funil
                <select class="field" @bind="_edit.Stage">
                    <option value="">—</option>
                    @if (Unknown(_edit.Stage, Cat.Stages.Select(x => x.Name))) { <option value="@_edit.Stage" selected>@_edit.Stage</option> }
                    @foreach (var s in Cat.Stages) { <option value="@s.Name">@s.Name</option> }
                </select>
            </label>

            <label class="fld">Moeda
                <select class="field" @bind="_edit.CurrencyCode">@foreach (var c in Cat.Currencies) { <option value="@c.Code">@c.Code</option> }</select>
            </label>
            <label class="fld">Net Value (valor)<input class="field num" @bind="_edit.AmountOriginal" /></label>
            <label class="fld">Taxa (BRL/USD)<input class="field num" @bind="_edit.ExchangeRate" /></label>
            <label class="fld">Valor USD (calculado)<input class="field num" value="@Fmt.Usd(_edit.AmountUsd)" readonly /></label>

            <label class="fld">PM % (GM)<input class="field num" @bind="_edit.GmPercent" /></label>
            <label class="fld">% de Ganho<input class="field num" @bind="_edit.WinProbability" /></label>
            <label class="fld">% de Sair no Mês<input class="field num" @bind="_edit.CloseInPeriodProbability" /></label>

            <label class="fld">Unidade de Venda<input class="field" list="dl-unidade" @bind="_edit.PvBusinessUnitId" /></label>
            <label class="fld">BU Intercompany<input class="field" list="dl-bu_inter" @bind="_edit.IntercompanyBu" /></label>
            <label class="fld">Is Inter Company <span class="hint">vem da planilha</span><input class="field" @bind="_edit.IsInterCompany" /></label>

            @* Colunas do funil que vêm da planilha e não tinham lugar no formulário. *@
            <label class="fld">Commercial Segment<input class="field" @bind="_edit.CommercialSegment" /></label>
            <label class="fld">Process<input class="field" @bind="_edit.Process" /></label>
            <label class="fld">Brand<input class="field" @bind="_edit.Brand" /></label>
            <label class="fld">Chance<input class="field" @bind="_edit.Chance" /></label>
            <label class="fld">Customer Ref#<input class="field" @bind="_edit.CustomerRef" /></label>
            <label class="fld full">Description<input class="field" @bind="_edit.Description" /></label>

            <label class="fld">RAMP<input class="field" @bind="_edit.Ramp" /></label>
            <label class="fld">Coluna1<input class="field" @bind="_edit.Coluna1" /></label>
            <label class="fld">OTP<select class="field" @bind="_edit.Otp"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">TOP 10<select class="field" @bind="_edit.Top10"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">KYC<select class="field" @bind="_edit.Kyc"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld full">Observação<input class="field" @bind="_edit.Notes" /></label>
            <label class="fld full">Próxima ação<input class="field" @bind="_edit.NextAction" /></label>
        </div>
        <div class="modal-actions">
            @if (!_editDup) { <button class="btn-danger-ghost" @onclick="DeleteFromEdit">@Icons.Svg("trash")Excluir</button> }
            <div class="filterbar-spacer"></div>
            <button class="btn-ghost" @onclick="() => _edit = null">Cancelar</button>
            <button class="btn-primary" @onclick="SaveEdit">@Icons.Svg("check")@(_editDup ? "Criar cópia" : "Salvar alterações")</button>
        </div>
    </div>
}

@code {
    [Parameter] public List<Opportunity> Rows { get; set; } = new();
    [Parameter] public string EmptyText { get; set; } = "Nenhuma oportunidade no recorte.";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Mostra o botão "Colunas" (a mesma tabela aparece em vários blocos
    /// da Visão Executiva; só o principal precisa oferecer a configuração).</summary>
    [Parameter] public bool ShowColumnPicker { get; set; } = true;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _user = "—";

    private DateTime _today = DateTime.Today;

    // ---- colunas configuráveis por usuário ----
    private List<TableColumns.ColState> _cols = OpportunityColumns.Default();
    private bool _colsOpen;
    private string _login = "";
    private int _colsVersion = -1;   // versão da preferência já aplicada nesta tabela

    private List<TableColumns.ColState> Visiveis => _cols.Where(c => c.Visible).ToList();

    // Cada instância tem o seu <tr>: o id precisa ser único na página.
    private readonly string HeadId = "th-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string RolaId = "sc-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string WrapId = "tw-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<OpportunityTable>? _ref;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _user = user.Identity?.Name ?? "—";
            _login = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                     ?? user.Identity?.Name ?? "";
        }
        CarregarColunas();
    }

    // A mesma página pode ter várias tabelas: quando uma grava a preferência,
    // as outras percebem pela versão e se realinham no próximo render.
    protected override void OnParametersSet()
    {
        if (_colsVersion != ColPrefs.Version) CarregarColunas();
    }

    private void CarregarColunas()
    {
        _cols = OpportunityColumns.Parse(ColPrefs.Get(_login, OpportunityColumns.Tabela));
        _colsVersion = ColPrefs.Version;
    }

    private void AplicarColunas(List<TableColumns.ColState> cols)
    {
        _colsOpen = false;
        Gravar(cols);
    }

    private void Gravar(List<TableColumns.ColState> cols)
    {
        ColPrefs.Save(_login, OpportunityColumns.Tabela, TableColumns.Serialize(cols));
        _cols = cols;
        _colsVersion = ColPrefs.Version;
    }

    /// <summary>Nova ordem das colunas depois de arrastar o cabeçalho.</summary>
    [JSInvokable]
    public Task SaveColumnOrder(string tabela, string[] ordem) => InvokeAsync(() =>
    {
        Gravar(TableColumns.Reorder(_cols, ordem));
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("colOrder.init", HeadId, _ref, OpportunityColumns.Tabela); } catch { }
        // A cada render: o número de colunas pode ter mudado e a régua precisa
        // acompanhar a largura nova da tabela.
        try { await JS.InvokeVoidAsync("appRolagemTopo", RolaId, WrapId); } catch { }
    }

    public void Dispose() => _ref?.Dispose();

    private void ResetarColunas()
    {
        _colsOpen = false;
        ColPrefs.Reset(_login, OpportunityColumns.Tabela);
        _cols = OpportunityColumns.Default();
        _colsVersion = ColPrefs.Version;
    }

    // Edição / duplicação
    private Opportunity? _edit;
    private bool _editDup;
    private int _editMonthNum = 1, _editYear = DateTime.Today.Year;

    // Exclusão
    private Opportunity? _delTarget;

    private static readonly System.Globalization.CultureInfo _pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) || s == "—" ? "—" : s!;
    // Marcador "Sim" (OTP, TOP 10, KYC) vindo da planilha ou preenchido na tela.
    private static bool Sim(string? s) => string.Equals(s, "Sim", StringComparison.OrdinalIgnoreCase);
    private static MarkupString Mark(string? s) =>
        string.Equals(s, "Sim", StringComparison.OrdinalIgnoreCase) ? new("<span class='mk yes'>Sim</span>")
        : (string.Equals(s, "Não", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "Nao", StringComparison.OrdinalIgnoreCase)) ? new MarkupString("<span class='mk no'>Não</span>")
        : new MarkupString("—");
    private static string MonthLabel(Opportunity o) =>
        o.ExpectedDateValue is { } d ? $"{Fmt.MonthName(d.Month)}/{d.Year}" : "—";
    private static bool Unknown(string id, IEnumerable<string> knownIds) =>
        !string.IsNullOrEmpty(id) && !knownIds.Contains(id);

    private static readonly (string Id, string Key)[] FormLists =
    {
        ("dl-pais", "pais"), ("dl-market_var", "market_var"), ("dl-market", "market"),
        ("dl-product", "product"), ("dl-key_account", "key_account"),
        ("dl-customer", "customer"), ("dl-servico", "servico_previsto"),
        ("dl-unidade", "unidade_venda"), ("dl-bu_inter", "bu_intercompany"),
        // Usado pelo formulário de "Nova oportunidade" (criada à mão, sem planilha).
        // NB/AFM saiu daqui: virou uma escolha fechada, que alimenta a coluna Setor.
        ("dl-onestream", "market_onestream"),
    };

    // ---- edição completa ----
    private void OpenEdit(Opportunity o)
    {
        _editDup = false;
        _edit = Repo.Get(o.Id) ?? o;                       // cópia isolada do cache
        var d = _edit.ExpectedDateValue ?? _today;
        _editMonthNum = d.Month;
        _editYear = d.Year;

        // Traduz Ids do catálogo para os nomes legíveis (campos de texto/lista).
        _edit.CountryId = Cat.Countries.FirstOrDefault(x => x.Id == _edit.CountryId)?.Name ?? _edit.CountryId;
        _edit.MarketId = Cat.Markets.FirstOrDefault(x => x.Id == _edit.MarketId)?.Name ?? _edit.MarketId;
        _edit.SubMarketId = Cat.SubMarkets.FirstOrDefault(x => x.Id == _edit.SubMarketId)?.Name ?? _edit.SubMarketId;
        _edit.ProductId = Cat.Products.FirstOrDefault(x => x.Id == _edit.ProductId)?.Name ?? _edit.ProductId;
        _edit.KamId = Cat.Kams.FirstOrDefault(x => x.Id == _edit.KamId)?.Name ?? _edit.KamId;
        _edit.CustomerId = Cat.Customers.FirstOrDefault(x => x.Id == _edit.CustomerId)?.Name ?? _edit.CustomerId;
        _edit.PvBusinessUnitId = Cat.BusinessUnits.FirstOrDefault(x => x.Id == _edit.PvBusinessUnitId)?.Code ?? _edit.PvBusinessUnitId;
        _edit.IntercompanyBu = Cat.BusinessUnits.FirstOrDefault(x => x.Id == _edit.IntercompanyBu)?.Code ?? _edit.IntercompanyBu;
    }

    // Duplica: mesmo formulário preenchido, mas salvo como um NOVO registro.
    private void Duplicate(Opportunity o)
    {
        OpenEdit(o);
        if (_edit is null) return;
        _edit.Id = "opp-" + Guid.NewGuid().ToString("N");
        _edit.ProposalNumber = "";   // Proposta e PV vêm do Salesforce: preencher manual na cópia
        _edit.PvNumber = "";
        _edit.CreatedAt = _today.ToString("yyyy-MM-dd");
        _editDup = true;
    }

    private async Task SaveEdit()
    {
        if (_edit is null) return;
        if (_editMonthNum is >= 1 and <= 12 && _editYear >= 2000)
            _edit.ExpectedDate = new DateTime(_editYear, _editMonthNum, 1).ToString("yyyy-MM-dd");
        _edit.UpdatedAt = _today.ToString("yyyy-MM-dd");
        _edit.UpdatedBy = Cat.KamName(_edit.KamId);
        Repo.Save(_edit);
        _edit = null;
        await OnChanged.InvokeAsync();
    }

    private void DeleteFromEdit()
    {
        if (_edit is null) return;
        _delTarget = _edit;
        _edit = null;
    }

    // ---- Indicar na Previsão (marcador do vendedor) ----
    // Ao indicar, a previsão precisa de % de ganho, % de sair no mês, RAMP, OTP,
    // TOP 10 e KYC. Se faltar algo, o formulário curto abre na hora — é o momento
    // em que a pessoa tem o negócio na cabeça.
    private Opportunity? _pend;
    private IReadOnlyList<string> _pendFaltam = Array.Empty<string>();

    private async Task ToggleIndicada(Opportunity o)
    {
        var full = Repo.Get(o.Id) ?? o;
        var indicando = !full.IndicadaValue;
        full.Indicada = indicando ? "Sim" : "";
        full.UpdatedAt = _today.ToString("yyyy-MM-dd");
        Repo.Save(full);
        await OnChanged.InvokeAsync();

        if (indicando && full.PendenciasPrevisao.Count > 0) AbrirPendencias(full);
    }

    private void AbrirPendencias(Opportunity o)
    {
        _pend = Repo.Get(o.Id) ?? o;              // cópia isolada do cache
        _pendFaltam = _pend.PendenciasPrevisao;
    }

    private void FecharPendencias() { _pend = null; _pendFaltam = Array.Empty<string>(); }

    private async Task SalvarPendencias()
    {
        if (_pend is null) return;
        _pend.UpdatedAt = _today.ToString("yyyy-MM-dd");
        _pend.UpdatedBy = _user;
        Repo.Save(_pend);
        FecharPendencias();
        await OnChanged.InvokeAsync();
    }

    // ---- exclusão de uma oportunidade ----
    private void AskDelete(Opportunity o) => _delTarget = o;

    private async Task ConfirmDelete()
    {
        if (_delTarget is null) return;
        Repo.Delete(_delTarget.Id);
        _delTarget = null;
        await OnChanged.InvokeAsync();
    }

    // ---- Indicar venda: move a oportunidade para o Controle (Ofertas e pedidos) ----
    private Opportunity? _sell;
    private ControleRegistro? _sellReg;
    private string _sellErr = "";
    private bool _sellBusy;

    // Monta um rascunho editável do registro (Ofertas e pedidos) a partir da proposta.
    private void OpenSell(Opportunity o)
    {
        _sell = o; _sellErr = ""; _sellBusy = false;
        var d = o.ExpectedDateValue;
        _sellReg = new ControleRegistro
        {
            Oferta = string.IsNullOrWhiteSpace(o.ProposalNumber) ? o.Name : o.ProposalNumber,
            Pedido = o.PvNumber,
            Cliente = Cat.CustomerName(o.CustomerId),
            Mercado = Cat.MarketName(o.MarketId),
            Kam = OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId)),
            ValorLiquido = o.AmountBrl.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            Semana = d is { } dd ? System.Globalization.ISOWeek.GetWeekOfYear(dd).ToString() : "",
            Mes = d is { } dm ? dm.Month.ToString() : "",
            Poc = "",
            Moeda = string.IsNullOrWhiteSpace(o.CurrencyCode) ? "BRL" : o.CurrencyCode,
            ValorOriginal = o.AmountOriginalValue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            Observacao = o.Notes ?? "",
            OppId = o.Id,           // permite devolver a oferta às Oportunidades
        };
    }

    private async Task ConfirmSell()
    {
        if (_sell is null || _sellReg is null || _sellBusy) return;
        _sellBusy = true; _sellErr = "";
        var o = _sell;
        var reg = _sellReg;
        try
        {
            await Task.Run(() =>
            {
                Controle.SaveRegistro(reg, _user);   // usa os valores (possivelmente editados)

                var full = Repo.Get(o.Id) ?? o;
                full.MovidaControle = "Sim";
                full.UpdatedAt = _today.ToString("yyyy-MM-dd");
                full.UpdatedBy = _user;
                Repo.Save(full);
            });
            _sell = null; _sellReg = null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _sellErr = "Falha ao indicar a venda: " + ex.Message; }
        finally { _sellBusy = false; }
    }
}
