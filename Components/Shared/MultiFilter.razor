@* Filtro de múltipla seleção reutilizável da barra de filtros.
   - Permite marcar VÁRIAS opções (nenhuma marcada = todas).
   - Fecha ao clicar em qualquer área em branco (backdrop transparente),
     no botão "Fechar" ou ao clicar de novo no próprio filtro. *@

<div class="flt flt-multi">
    <span class="flt-label">@Label</span>
    <button type="button" class="flt-multi-btn" @onclick="Toggle">
        @(Selected.Count == 0 ? AllText : Selected.Count == 1 ? Selected.First() : Selected.Count + " selec.")<span class="flt-caret">▾</span>
    </button>
    @if (_open)
    {
        @* Área em branco: clicar fora recolhe o filtro. *@
        <div class="flt-multi-backdrop" @onclick="Close"></div>
        <div class="flt-multi-panel">
            <div class="flt-multi-head">
                <span>@Selected.Count selecionado(s)</span>
                @if (Selected.Count > 0) { <button class="btn-link" @onclick="ClearAll">Limpar</button> }
                <button class="btn-link" @onclick="Close">Fechar</button>
            </div>
            @foreach (var op in Options)
            {
                var v = op;
                <label class="flt-check">
                    <input type="checkbox" checked="@Selected.Contains(v)" @onchange="() => Pick(v)" />
                    <span>@v</span>
                </label>
            }
            @if (!Options.Any()) { <div class="flt-multi-empty">@EmptyText</div> }
        </div>
    }
</div>

@implements IDisposable

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string AllText { get; set; } = "Todos";
    [Parameter] public string EmptyText { get; set; } = "Sem opções no recorte.";
    [Parameter] public IEnumerable<string> Options { get; set; } = Array.Empty<string>();
    [Parameter] public HashSet<string> Selected { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task Pick(string v)
    {
        if (!Selected.Remove(v)) Selected.Add(v);
        await Avisar();
    }

    private async Task ClearAll()
    {
        Selected.Clear();
        await Avisar();
    }

    // Avisar a página custa caro: ela refaz funis, rankings, mapa e tabela sobre
    // todo o recorte. Quem marca quatro vendedores seguidos pagava esse preço
    // quatro vezes, e a tela travava entre um clique e outro.
    //
    // A marcação continua aparecendo na hora — quem redesenha é só este painel.
    // O que espera é o aviso: cada clique novo cancela a espera do anterior, e a
    // página é refeita uma vez só, quando a escolha termina. Mesma ideia da
    // busca, que já espera a digitação parar.
    private CancellationTokenSource? _espera;

    private async Task Avisar()
    {
        _espera?.Cancel();
        var cts = new CancellationTokenSource();
        _espera = cts;
        try { await Task.Delay(300, cts.Token); }
        catch (OperationCanceledException) { return; }   // veio outro clique: quem avisa é o último
        await OnChanged.InvokeAsync();
    }

    public void Dispose() => _espera?.Cancel();
}
