@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HowdenSalesForecast.Data.BrandRepository Brand
@implements IDisposable

<aside class="sidebar no-print @(Collapsed ? "collapsed" : "")">
    <div class="brand @(Collapsed ? "center" : "")">
        @if (AppLogo is { } logo)
        {
            <img src="@logo" alt="Logo" class="brand-logo-img" />
        }
        else
        {
            <div class="brand-mark">H</div>
            @if (!Collapsed)
            {
                <div class="brand-text">
                    <div class="brand-name">Howden</div>
                    <div class="brand-sub">Sales Forecast</div>
                </div>
            }
        }
    </div>

    <nav class="nav">
        @foreach (var group in Groups)
        {
            var items = group.Items.Where(i => Allowed(i.Key)).ToList();
            if (items.Count == 0) { continue; }
            @if (!Collapsed)
            {
                <div class="nav-section">@group.Name</div>
            }
            @foreach (var it in items)
            {
                <a class="nav-item @(IsActive(it.Route) ? "active" : "")" href="@it.Route" title="@it.Label">
                    @Icons.Svg(it.Icon, "nav-ico")
                    <span>@it.Label</span>
                </a>
            }
        }
    </nav>

    <div class="sidebar-footer">
        @if (!Collapsed)
        {
            <div class="version">Howden Sales Forecast · v0.1</div>
        }
        <button class="collapse-btn" @onclick="Toggle" title="Recolher menu">
            @Icons.Svg(Collapsed ? "chevron-right" : "chevron-left")
        </button>
    </div>
</aside>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool Collapsed { get; set; }
    private string _role = HowdenSalesForecast.Models.AccessRoles.Admin;
    private string? AppLogo => Brand.Get(HowdenSalesForecast.Data.BrandRepository.AppLogo);

    private record NavItem(string Key, string Route, string Icon, string Label);
    private record NavGroup(string Name, NavItem[] Items);

    private static readonly NavGroup[] Groups =
    {
        new("Executivo", new[]
        {
            new NavItem("executivo", "/executivo", "executive", "Visão Executiva"),
        }),
        new("Comercial", new[]
        {
            new NavItem("oportunidades", "/oportunidades", "opportunity", "Oportunidades"),
            new NavItem("controle", "/controle", "review", "Controle"),
        }),
        new("Dados", new[]
        {
            new NavItem("listas", "/listas", "layers", "Listas"),
        }),
        new("Sistema", new[]
        {
            new NavItem("configuracoes", "/configuracoes", "import", "Configurações"),
            new NavItem("identidade", "/identidade", "image", "Identidade visual"),
            new NavItem("administracao", "/administracao", "admin", "Administração"),
        }),
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            if (!string.IsNullOrEmpty(role)) { _role = HowdenSalesForecast.Models.AccessRoles.Normalize(role); }
        }
        // O menu fica FORA da área que troca ao navegar, então o Blazor não o
        // redesenha sozinho: sem isso, o destaque azul continuava na guia
        // anterior. Aqui ele pede o próprio redesenho a cada mudança de página.
        Nav.LocationChanged += AoNavegar;
    }

    private void AoNavegar(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= AoNavegar;

    // Abas visíveis conforme o papel do login (controle de acesso).
    private bool Allowed(string key) => HowdenSalesForecast.Models.AccessRoles.CanTab(_role, key);

    private bool IsActive(string route)
    {
        // Só o caminho interessa: "?filtro=x" e "#ancora" não mudam a guia.
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        var corte = rel.IndexOfAny(new[] { '?', '#' });
        if (corte >= 0) rel = rel[..corte];
        var path = "/" + rel.TrimEnd('/');

        if (route == "/executivo" && path == "/") return true;
        // "/oportunidades/123" conta como Oportunidades; "/oportunidades-x", não.
        return path.Equals(route, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase);
    }

    private async Task Toggle()
    {
        Collapsed = !Collapsed;
        try { await JS.InvokeVoidAsync("appToggleSidebar", Collapsed); } catch { }
    }
}
