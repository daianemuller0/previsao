@page "/importacoes"
@attribute [Authorize]
@rendermode InteractiveServer

<div class="breadcrumbs"><span>Dados</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Importações</span></div>

<div class="page-head">
    <div>
        <h1>Importação do Excel</h1>
        <p class="subtitle">Substitui o processo atual em planilha · upload, mapeamento, validação e confirmação</p>
    </div>
</div>

<div class="exec-grid cols-4" style="margin-bottom:18px">
    @foreach (var (i, step) in _steps.Select((s, i) => (i + 1, s)))
    {
        <div class="stat @(i == 1 ? "accent-left" : "")">
            <div class="stat-label">Etapa @i</div>
            <div class="stat-value sm">@step.Title</div>
            <div class="stat-context">@step.Desc</div>
        </div>
    }
</div>

<div class="grid-2-1">
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Mapeamento de campos <span class="hint">coluna do Excel → campo do sistema</span></div></div>
        <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
            <table class="grid-tbl">
                <thead><tr><th>Coluna do Excel</th><th>Campo do sistema</th><th>Destino</th></tr></thead>
                <tbody>
                    @foreach (var m in _map)
                    {
                        <tr><td class="col-strong">@m.Excel</td><td>@m.Field</td><td><span class="tag">@m.Entity</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Upload</div></div>
        <label class="fld">Arquivo .xlsx do forecast
            <InputFile class="field" OnChange="OnFile" accept=".xlsx" />
        </label>
        @if (!string.IsNullOrEmpty(_fileName))
        {
            <div class="info-banner mt-16">Arquivo selecionado: <strong>@_fileName</strong> (@_fileSize KB)</div>
        }
        <div class="toolbar mt-16">
            <label class="fld" style="flex:1">Modo
                <select class="field"><option>Substituir base</option><option>Adicionar à base</option></select>
            </label>
        </div>
        <button class="btn-primary btn-block" style="width:100%;justify-content:center" disabled="@string.IsNullOrEmpty(_fileName)">@Icons.Svg("import")Validar e pré-visualizar</button>
        <p class="muted" style="font-size:11.5px;margin-top:10px">A leitura tolerante do Excel (ClosedXML) e a gravação em Parquet reutilizam o padrão do módulo de Licenças.</p>
    </div>
</div>

<div class="panel mt-16">
    <div class="panel-head"><div class="panel-title">Validações aplicadas <span class="hint">a importação não falha em silêncio — cada problema é reportado</span></div></div>
    <div class="attention">
        @foreach (var v in _validations)
        {
            <div class="att-item">
                <div class="att-ico @v.Tone">@Icons.Svg(v.Tone == "neg" ? "x" : v.Tone == "warn" ? "alert" : "check")</div>
                <div class="att-body"><div class="att-title">@v.Rule</div><div class="att-desc">@v.Desc</div></div>
            </div>
        }
    </div>
</div>

@code {
    private record Step(string Title, string Desc);
    private record Map(string Excel, string Field, string Entity);
    private record Val(string Tone, string Rule, string Desc);
    private string _fileName = "";
    private long _fileSize;

    private readonly Step[] _steps =
    {
        new("Upload", "Arquivo .xlsx exportado"),
        new("Mapeamento", "Colunas → campos"),
        new("Validação", "Inconsistências"),
        new("Confirmação", "Gravação em Parquet"),
    };

    private readonly Map[] _map =
    {
        new("Quarter", "Quarter (derivado da data)", "Forecast"),
        new("Date", "Data prevista", "Opportunity"),
        new("País", "País", "Country"),
        new("Market", "Mercado", "Market"),
        new("Sub_Market", "Submercado", "SubMarket"),
        new("Product", "Produto", "Product"),
        new("Tipo de equipamento", "Tipo de equipamento", "EquipmentType"),
        new("KAM", "Responsável", "Kam"),
        new("Cliente/Planta", "Cliente + Planta", "Customer / Plant"),
        new("Proposta", "Número da proposta", "Opportunity"),
        new("Valor BRL", "Valor em BRL", "Opportunity"),
        new("GM%", "Margem bruta", "Opportunity"),
        new("% de ganho", "Prob. de ganho", "Forecast"),
        new("% de sair no mês", "Prob. no período", "Forecast"),
        new("NB/RT/AFM/SV", "Categoria comercial", "CommercialCategory"),
        new("BU Intercompany", "BU Intercompany", "BusinessUnit"),
        new("BU do PV", "BU do PV", "BusinessUnit"),
        new("PV", "Número do PV", "Opportunity"),
        new("Valor USD", "Valor em USD (derivado)", "Opportunity"),
        new("Taxa de câmbio", "Câmbio BRL/USD", "ExchangeRate"),
        new("Observações", "Observações", "Opportunity"),
    };

    private readonly Val[] _validations =
    {
        new("pos", "Campos obrigatórios", "Cliente, produto, valor e data prevista presentes"),
        new("pos", "Percentuais válidos", "Probabilidades entre 0 e 100"),
        new("warn", "Datas", "Formatos dd/mm/aaaa, serial do Excel e ISO aceitos"),
        new("warn", "Cadastros ausentes", "Clientes/produtos/KAMs novos são sinalizados p/ criação"),
        new("neg", "Duplicidades", "Propostas repetidas bloqueiam a linha"),
        new("neg", "Câmbio ausente", "Linha em moeda estrangeira sem taxa é rejeitada"),
    };

    private void OnFile(InputFileChangeEventArgs e)
    {
        _fileName = e.File.Name;
        _fileSize = e.File.Size / 1024;
    }
}
