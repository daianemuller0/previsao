@page "/followup"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject FollowUpRepository FUp

@* ===========================================================================
   Follow-up das propostas em aberto. Puxa as oportunidades em aberto do forecast
   e organiza a rotina de acompanhamento: último contato, próximo follow-up
   (cadência), status e histórico de interações por proposta.
   =========================================================================== *@

<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Follow-up</span></div>

<div class="page-head">
    <div>
        <h1>Follow-up de propostas</h1>
        <p class="subtitle">Rotina de acompanhamento das propostas em aberto · @_rows.Count proposta(s) · @Fmt.Brl(_rows.Sum(r => r.Opp.AmountBrl)) em pipeline</p>
    </div>
</div>

@* ---- KPIs ---- *@
<div class="g12 top">
    <div class="c3"><div class="kpi"><div class="kpi-l">Em aberto</div><div class="kpi-v">@_rows.Count</div><div class="kpi-s">@Fmt.Brl(_rows.Sum(r => r.Opp.AmountBrl))</div></div></div>
    <div class="c3"><div class="kpi"><div class="kpi-l">Follow-up atrasado</div><div class="kpi-v" style="color:var(--neg)">@_rows.Count(r => r.Rank == 0)</div><div class="kpi-s">vencidos ou sem contato</div></div></div>
    <div class="c3"><div class="kpi"><div class="kpi-l">Para hoje</div><div class="kpi-v">@_rows.Count(r => r.Rank == 1)</div><div class="kpi-s">agendados para hoje</div></div></div>
    <div class="c3"><div class="kpi"><div class="kpi-l">Esta semana</div><div class="kpi-v">@_rows.Count(r => r.Rank == 2)</div><div class="kpi-s">próximos 7 dias</div></div></div>
</div>

@* ---- Filtros ---- *@
<div class="filterbar" style="margin-top:14px">
    <div class="flt"><span class="flt-label">Vendedor</span><select @bind="_kam"><option value="">Todos</option>@foreach (var v in _kamOptions){<option value="@v">@v</option>}</select></div>
    <div class="flt"><span class="flt-label">Status</span><select @bind="_status"><option value="">Todos</option>@foreach (var s in FollowUpStatus.All){<option value="@s">@s</option>}</select></div>
    <label class="flt-toggle @(_onlyDue ? "on" : "")" title="Só os que precisam de follow-up agora"><input type="checkbox" @bind="_onlyDue" />@Icons.Svg("clock")<span>Só pendentes de contato</span></label>
    <div class="filterbar-spacer"></div>
    <span class="tag">Cadência padrão @_defaultCadence dias</span>
</div>

@* ---- Lista ---- *@
<div class="table-wrap tbl-compact" style="max-height:720px;overflow:auto;margin-top:12px">
    <table class="grid-tbl">
        <thead>
            <tr>
                <th class="no-sort">Follow-up</th>
                <th class="no-sort">Cliente / Proposta</th>
                <th class="no-sort">Vendedor</th>
                <th class="no-sort">Stage</th>
                <th class="no-sort right">Valor</th>
                <th class="no-sort">Fechamento</th>
                <th class="no-sort">Último contato</th>
                <th class="no-sort">Próximo</th>
                <th class="no-sort">Status</th>
                <th class="no-sort center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Filtered())
            {
                <tr class="@(r.Rank == 0 ? "fu-urgent" : "")">
                    <td><span class="fu-due @DueCss(r)">@DueLabel(r)</span></td>
                    <td class="col-strong">@Cat.CustomerName(r.Opp.CustomerId)<div class="fu-sub">@(string.IsNullOrWhiteSpace(r.Opp.ProposalNumber) ? r.Opp.Name : r.Opp.ProposalNumber)</div></td>
                    <td>@Vendedor(r.Opp)</td>
                    <td>@(string.IsNullOrWhiteSpace(r.Opp.Stage) ? "—" : r.Opp.Stage)</td>
                    <td class="right num">@Fmt.Brl(r.Opp.AmountBrl)</td>
                    <td class="nowrap">@Fmt.Date(r.Opp.ExpectedDate)</td>
                    <td class="nowrap">@(r.Fu.LastContactValue is { } lc ? lc.ToString("dd/MM/yy") : "—")</td>
                    <td class="nowrap">@(r.Next is { } nx ? nx.ToString("dd/MM/yy") : "—")</td>
                    <td><span class="badge @StatusCss(r.Fu.Status)">@r.Fu.Status</span></td>
                    <td class="center nowrap">
                        <button class="btn-ghost" style="padding:3px 9px" @onclick="() => OpenRegister(r)">@Icons.Svg("check")Registrar</button>
                        <button class="row-act" title="Adiar 7 dias" @onclick="() => Adiar(r, 7)">@Icons.Svg("clock")</button>
                    </td>
                </tr>
            }
            @if (!Filtered().Any())
            {
                <tr><td colspan="10" class="empty">Nenhuma proposta em aberto no filtro.</td></tr>
            }
        </tbody>
    </table>
</div>

@* ---- Registrar follow-up (drawer) ---- *@
@if (_edit is not null && _editOpp is not null)
{
    <div class="drawer-backdrop" @onclick="() => _edit = null"></div>
    <div class="drawer">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">Registrar follow-up</h2>
                <p class="subtitle">@Cat.CustomerName(_editOpp.CustomerId) · @(string.IsNullOrWhiteSpace(_editOpp.ProposalNumber) ? _editOpp.Name : _editOpp.ProposalNumber)</p>
            </div>
            <button class="icon-btn" @onclick="() => _edit = null">@Icons.Svg("x")</button>
        </div>
        <div class="form-grid">
            <label class="fld">Data do contato<input class="field" type="date" @bind="_regDate" /></label>
            <label class="fld">Canal<select class="field" @bind="_regChannel">@foreach (var c in FollowUpChannel.All){<option value="@c">@c</option>}</select></label>
            <label class="fld">Resultado / Status<select class="field" @bind="_regStatus">@foreach (var s in FollowUpStatus.All){<option value="@s">@s</option>}</select></label>
            <label class="fld">Próximo follow-up<input class="field" type="date" @bind="_regNext" /></label>
            <label class="fld full">Observação<textarea class="field" rows="3" @bind="_regNote" placeholder="O que foi tratado, próximos passos…"></textarea></label>
        </div>
        <div class="fu-hist">
            <div class="fu-hist-h">Histórico</div>
            @if (_editLogs.Count == 0) { <div class="muted" style="font-size:12px">Nenhuma interação registrada ainda.</div> }
            else
            {
                @foreach (var l in _editLogs)
                {
                    <div class="fu-hist-row">
                        <span class="fu-hist-date">@(l.TsValue?.ToString("dd/MM/yy") ?? "—")</span>
                        <span class="fu-hist-body"><strong>@l.Channel</strong> · @l.Outcome@(string.IsNullOrWhiteSpace(l.Note) ? "" : " — " + l.Note)</span>
                    </div>
                }
            }
        </div>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _edit = null">Cancelar</button>
            <button class="btn-primary" @onclick="SaveRegister">@Icons.Svg("check")Salvar follow-up</button>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _user = "—";

    private record Row(Opportunity Opp, FollowUp Fu, DateTime? Next, int Rank);

    private List<Row> _rows = new();
    private IEnumerable<string> _kamOptions = Array.Empty<string>();
    private const int _defaultCadence = 14;

    // Filtros.
    private string _kam = "", _status = "";
    private bool _onlyDue;

    // Drawer de registro.
    private FollowUp? _edit;
    private Opportunity? _editOpp;
    private DateTime? _regDate, _regNext;
    private string _regChannel = "Ligação", _regStatus = FollowUpStatus.Pendente, _regNote = "";
    private List<FollowUpLog> _editLogs = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) { var st = await AuthState; _user = st.User.Identity?.Name ?? "—"; }
        Load();
    }

    private void Load()
    {
        var today = DateTime.Today;
        var fu = FUp.All();
        var open = Repo.All().Where(o => ForecastCategories.IsOpen(o.Category)).ToList();

        _rows = open.Select(o =>
        {
            var f = fu.TryGetValue(o.Id, out var x) ? x : new FollowUp { Id = o.Id, Status = FollowUpStatus.Pendente, CadenceDays = _defaultCadence.ToString() };
            var next = f.NextFollowUpValue;
            int rank;
            if (next is null) rank = 0;                                   // sem próximo agendado → precisa iniciar
            else { var days = (next.Value.Date - today).Days; rank = days < 0 ? 0 : days == 0 ? 1 : days <= 7 ? 2 : 3; }
            return new Row(o, f, next, rank);
        })
        .OrderBy(r => r.Rank)
        .ThenBy(r => r.Next ?? DateTime.MinValue)
        .ThenByDescending(r => r.Opp.AmountBrl)
        .ToList();

        _kamOptions = _rows.Select(r => Vendedor(r.Opp)).Where(s => !string.IsNullOrWhiteSpace(s) && s != "—")
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private IEnumerable<Row> Filtered()
    {
        IEnumerable<Row> q = _rows;
        if (_kam != "") q = q.Where(r => string.Equals(Vendedor(r.Opp), _kam, StringComparison.OrdinalIgnoreCase));
        if (_status != "") q = q.Where(r => r.Fu.Status == _status);
        if (_onlyDue) q = q.Where(r => r.Rank <= 1);
        return q;
    }

    private string Vendedor(Opportunity o) => OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId));

    // ---- ações ----
    private void OpenRegister(Row r)
    {
        _editOpp = r.Opp;
        _edit = new FollowUp
        {
            Id = r.Fu.Id, Status = r.Fu.Status, LastContact = r.Fu.LastContact,
            NextFollowUp = r.Fu.NextFollowUp, CadenceDays = r.Fu.CadenceDays, Notes = r.Fu.Notes,
        };
        _regDate = DateTime.Today;
        _regChannel = "Ligação";
        _regStatus = string.IsNullOrWhiteSpace(r.Fu.Status) ? FollowUpStatus.EmContato : r.Fu.Status;
        _regNext = DateTime.Today.AddDays(r.Fu.CadenceDaysValue);
        _regNote = "";
        _editLogs = FUp.Logs(r.Opp.Id);
    }

    private void SaveRegister()
    {
        if (_edit is null || _editOpp is null) return;
        var contato = _regDate ?? DateTime.Today;
        _edit.Status = _regStatus;
        _edit.LastContact = contato.ToString("yyyy-MM-dd");
        // Ganho/Perdido encerram a rotina (sem próximo follow-up).
        _edit.NextFollowUp = FollowUpStatus.IsActive(_regStatus) && _regNext is { } nx ? nx.ToString("yyyy-MM-dd") : "";
        _edit.Notes = _regNote;
        FUp.Save(_edit, _user);
        FUp.AddLog(new FollowUpLog
        {
            OppId = _editOpp.Id, User = _user, Channel = _regChannel, Outcome = _regStatus,
            Note = _regNote, Ts = contato.ToString("yyyy-MM-ddTHH:mm:ss"),
        });
        _edit = null; _editOpp = null;
        Load();
    }

    private void Adiar(Row r, int dias)
    {
        var baseDate = r.Next ?? DateTime.Today;
        var f = new FollowUp
        {
            Id = r.Fu.Id, Status = string.IsNullOrWhiteSpace(r.Fu.Status) ? FollowUpStatus.Pendente : r.Fu.Status,
            LastContact = r.Fu.LastContact, CadenceDays = r.Fu.CadenceDays, Notes = r.Fu.Notes,
            NextFollowUp = baseDate.AddDays(dias).ToString("yyyy-MM-dd"),
        };
        FUp.Save(f, _user);
        Load();
    }

    // ---- rótulos / cores ----
    private static string DueLabel(Row r)
    {
        if (r.Next is null) return "A iniciar";
        var days = (r.Next.Value.Date - DateTime.Today).Days;
        return days < 0 ? $"Atrasado {-days}d" : days == 0 ? "Hoje" : days <= 7 ? $"Em {days}d" : r.Next.Value.ToString("dd/MM");
    }
    private static string DueCss(Row r) => r.Rank switch { 0 => "due-late", 1 => "due-today", 2 => "due-week", _ => "due-future" };

    private static string StatusCss(string s) => s switch
    {
        FollowUpStatus.Ganho => "fc-commit",
        FollowUpStatus.Perdido => "badge-neg",
        FollowUpStatus.SemRetorno => "fc-pipe",
        FollowUpStatus.Aguardando => "fc-upside",
        FollowUpStatus.EmContato => "fc-best",
        _ => "fc-pipe",
    };
}
