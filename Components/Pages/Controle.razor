@page "/controle"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ControleRepository Repo
@inject Catalog Cat
@using HowdenSalesForecast.Models
@using System.Globalization

@{ Build(); }

<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Controle</span></div>

<div class="page-head">
    <div>
        <h1>Controle</h1>
        <p class="subtitle">REPORT HSA · realizado × budget por mês · valores em @Sym</p>
    </div>
    <div class="page-actions">
        <div class="flt" style="border:1px solid var(--border);border-radius:999px;padding:5px 12px"><span class="flt-label">Ano</span><select @bind="_year" @bind:after="Reload">@foreach (var y in Years){<option value="@y">@y</option>}</select></div>
        <div class="segmented">
            <button class="@(_cur == "BRL" ? "active" : "")" @onclick='() => _cur = "BRL"'>BRL</button>
            <button class="@(_cur == "USD" ? "active" : "")" @onclick='() => _cur = "USD"'>USD</button>
        </div>
        @if (_edit)
        {
            <button class="btn-ghost" @onclick="Cancel">Cancelar</button>
            <button class="btn-primary" @onclick="Save">@Icons.Svg("check")Salvar@(_pending.Count > 0 ? $" ({_pending.Count})" : "")</button>
        }
        else
        {
            <button class="btn-primary" @onclick="() => _edit = true">@Icons.Svg("edit")Editar dados</button>
        }
    </div>
</div>

@if (_loading)
{
    <div class="exec-grid cols-4">@for (var i = 0; i < 4; i++){<div class="card skel" style="height:96px"></div>}</div>
    <div class="skel" style="height:320px;margin-top:16px;border-radius:12px"></div>
}
else
{
    @if (_edit)
    {
        <div class="edit-banner">@Icons.Svg("edit")<span><strong>Modo de edição.</strong> Altere os valores de orçamento, realizado e intercompany diretamente nas células destacadas. As linhas de total e atingimento são calculadas automaticamente.</span></div>
    }

    @* ---- Cartões por semestre ---- *@
    <div class="exec-grid cols-4" style="margin-bottom:18px">
        <div class="stat accent-left"><div class="stat-label">1º semestre · Meta</div><div class="stat-value sm">@Brl(Sum(_budget, 0, 6))</div><div class="stat-context">Realizado @Brl(Sum(_real, 0, 6))</div></div>
        <div class="stat accent-left"><div class="stat-label">1º semestre · Atingimento</div><div class="stat-value sm" style="color:@AtCol(Attain(0, 6))">@Pct(Attain(0, 6))</div><div class="stat-context">Realizado ÷ Budget (Jan–Jun)</div></div>
        <div class="stat accent-left"><div class="stat-label">2º semestre · Meta</div><div class="stat-value sm">@Brl(Sum(_budget, 6, 12))</div><div class="stat-context">Realizado @Brl(Sum(_real, 6, 12))</div></div>
        <div class="stat accent-left"><div class="stat-label">2º semestre · Atingimento</div><div class="stat-value sm" style="color:@AtCol(Attain(6, 12))">@(Sum(_real, 6, 12) > 0 ? Pct(Attain(6, 12)) : "—")</div><div class="stat-context">Realizado ÷ Budget (Jul–Dez)</div></div>
    </div>

    @* ---- REPORT HSA ---- *@
    <div class="panel">
        <div class="panel-head"><div class="panel-title">REPORT HSA <span class="hint">valores em @Sym</span></div><span class="ctrl-upd">Atualizado @_updated · @_updatedBy</span></div>
        <div class="table-wrap rep-wrap">
            <table class="grid-tbl rep-tbl">
                <thead>
                    <tr><th>Indicador</th>@for (var m = 1; m <= 12; m++){<th class="right @(m == _month ? "cur" : "")">@Fmt.MonthName(m)</th>}<th class="right">Acum.</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="rname">Intercompany HCHL e HPU</td>
                        @for (var m = 1; m <= 12; m++){var mm = m;<td class="right @(mm == _month ? "cur" : "")">@Cell("INTER", mm, "Realizado")</td>}
                        <td class="right strong">@Num(Enumerable.Range(1, 12).Sum(x => Real("INTER", x)))</td>
                    </tr>
                    <tr>
                        <td class="rname">Vendas NB+AFM (Realizado)</td>
                        @for (var m = 1; m <= 12; m++){<td class="right @(m == _month ? "cur" : "")" title="calculado">@Num(ConsReal(m))</td>}
                        <td class="right strong">@Num(Enumerable.Range(1, 12).Sum(ConsReal))</td>
                    </tr>
                    <tr>
                        <td class="rname">Meta NB+AFM (Budget)</td>
                        @for (var m = 1; m <= 12; m++){var mm = m;<td class="right @(mm == _month ? "cur" : "")">@Cell("CONS", mm, "Budget")</td>}
                        <td class="right strong">@Num(Enumerable.Range(1, 12).Sum(Budget))</td>
                    </tr>
                    <tr class="rep-att">
                        <td class="rname">Atendimento ao Budget</td>
                        @for (var m = 1; m <= 12; m++){var a = Budget(m) > 0 && ConsReal(m) > 0 ? ConsReal(m) / Budget(m) * 100 : (double?)null;<td class="right att @(m == _month ? "cur" : "")" style="@AttStyle(a)">@(a is { } av ? Pct(av) : "—")</td>}
                        <td class="right strong">@(Sum(_budget, 0, 12) > 0 ? Pct(Sum(_real, 0, 12) / Sum(_budget, 0, 12) * 100) : "—")</td>
                    </tr>
                    <tr class="rep-meta">
                        <td class="rname">Meta</td>
                        @for (var m = 1; m <= 12; m++){<td class="right @(m == _month ? "cur" : "")">100%</td>}
                        <td class="right">100%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* ---- Composição mensal ---- *@
    <div class="panel" style="margin-top:16px">
        <div class="panel-head"><div class="panel-title">Composição mensal <span class="hint">NB · AFM · SV · LTSA · em @Sym</span></div></div>
        <div class="table-wrap rep-wrap">
            <table class="grid-tbl rep-tbl">
                <thead><tr><th>Categoria</th>@for (var m = 1; m <= 12; m++){<th class="right @(m == _month ? "cur" : "")">@Fmt.MonthName(m)</th>}<th class="right">Acum.</th></tr></thead>
                <tbody>
                    @foreach (var c in CompCats)
                    {
                        var ck = c.Key;
                        <tr>
                            <td class="rname"><span class="cat-dot" style="background:@c.Color"></span>@c.Label</td>
                            @for (var m = 1; m <= 12; m++){var mm = m;<td class="right @(mm == _month ? "cur" : "")">@Cell(ck, mm, "Realizado")</td>}
                            <td class="right strong">@Num(Enumerable.Range(1, 12).Sum(x => Real(ck, x)))</td>
                        </tr>
                    }
                    <tr class="rep-total">
                        <td class="rname">Total realizado</td>
                        @for (var m = 1; m <= 12; m++){<td class="right @(m == _month ? "cur" : "")">@Num(ConsReal(m))</td>}
                        <td class="right">@Num(Enumerable.Range(1, 12).Sum(ConsReal))</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_toast)){<div class="ctrl-toast">@Icons.Svg("check")<div>@((MarkupString)_toast)</div><button class="icon-btn" @onclick="() => _toast = null">@Icons.Svg("x")</button></div>}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");
    private static readonly string[] Cats = { "NB", "AFM", "SV", "LTSA" };

    private int _year = DateTime.Today.Year, _month = DateTime.Today.Month;
    private string _cur = "BRL";
    private bool _edit, _loading = true;
    private string? _toast, _user = "—", _updated = "—", _updatedBy = "—";
    private IEnumerable<int> Years => new[] { DateTime.Today.Year, DateTime.Today.Year - 1 };

    private record CatOpt(string Key, string Label, string Color);
    private readonly CatOpt[] CompCats =
    {
        new("NB", "NB", "#007A9E"), new("AFM", "AFM", "#0f8a8c"), new("SV", "SV", "#7a5cc0"), new("LTSA", "LTSA", "#b7791f"),
    };

    private List<ControleEntry> _entries = new();
    private Dictionary<(int, string), ControleEntry> _map = new();
    private Dictionary<string, string> _pending = new();  // "m|cat|field" -> raw
    private double[] _real = new double[13], _budget = new double[13];

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) { var st = await AuthState; _user = st.User.Identity?.Name ?? "—"; }
        Reload();
    }

    private void Reload()
    {
        _loading = true;
        _entries = Repo.Entries(_year);
        var last = _entries.Select(e => e.UpdatedAtValue).Where(d => d is not null).DefaultIfEmpty(null).Max();
        _updated = last?.ToString("dd/MM/yyyy HH:mm") ?? "—";
        _updatedBy = _entries.OrderByDescending(e => e.UpdatedAtValue).FirstOrDefault()?.UpdatedBy ?? "—";
        _pending.Clear();
        _loading = false;
    }

    private void Build()
    {
        _map = new();
        foreach (var e in _entries) _map[(e.MonthV, e.Category)] = e;
        for (var m = 1; m <= 12; m++) { _real[m] = ConsReal(m); _budget[m] = Budget(m); }
    }

    private ControleEntry? Entry(int m, string cat) => _map.GetValueOrDefault((m, cat));
    private string PKey(int m, string cat, string field) => $"{m}|{cat}|{field}";
    private double? Pend(int m, string cat, string field) => _pending.TryGetValue(PKey(m, cat, field), out var s) ? ParseVal(s) : null;

    private double Real(string cat, int m) => Pend(m, cat, "Realizado") ?? (Entry(m, cat)?.RealizadoV ?? 0);
    private double Budget(int m) => Pend(m, "CONS", "Budget") ?? (Entry(m, "CONS")?.BudgetV ?? 0);
    private double ConsReal(int m) => Cats.Sum(c => Real(c, m));

    private static double Sum(double[] a, int from, int to) { double s = 0; for (var i = from; i < to; i++) s += a[i + 1]; return s; }
    private double Attain(int from, int to) { var b = Sum(_budget, from, to); return b > 0 ? Sum(_real, from, to) / b * 100 : 0; }

    // Célula: input no modo edição, texto caso contrário.
    private RenderFragment Cell(string cat, int m, string field) => builder =>
    {
        var val = field == "Budget" ? Budget(m) : Real(cat, m);
        if (_edit)
        {
            builder.OpenElement(0, "input");
            builder.AddAttribute(1, "class", "cell-in" + (_pending.ContainsKey(PKey(m, cat, field)) ? " changed" : ""));
            builder.AddAttribute(2, "value", val == 0 ? "" : val.ToString("0", CultureInfo.InvariantCulture));
            builder.AddAttribute(3, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<ChangeEventArgs>(this, e => SetPending(m, cat, field, e.Value?.ToString())));
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(4, val == 0 ? "—" : Num(val));
        }
    };

    private void SetPending(int m, string cat, string field, string? raw)
    {
        var k = PKey(m, cat, field);
        var orig = field == "Budget" ? (Entry(m, cat)?.BudgetV ?? 0) : (Entry(m, cat)?.RealizadoV ?? 0);
        var parsed = ParseVal(raw);
        if (parsed is null) return;
        if (parsed.Value == orig) _pending.Remove(k);
        else _pending[k] = raw ?? "";
    }

    private void Cancel() { _pending.Clear(); _edit = false; }

    private void Save()
    {
        var groups = _pending.Keys.Select(k => k.Split('|')).GroupBy(p => (int.Parse(p[0]), p[1]));
        int n = _pending.Count;
        foreach (var g in groups)
        {
            var (m, cat) = g.Key;
            double? b = Pend(m, cat, "Budget");
            double? r = Pend(m, cat, "Realizado");
            Repo.Save(_year, m, cat, b, r, null, "", _user ?? "—", "Edição no Controle");
        }
        _pending.Clear(); _edit = false;
        Reload();
        if (n > 0) _toast = $"<strong>{n} valor(es) salvo(s) com sucesso.</strong>";
    }

    // ---- formatação --------------------------------------------------------
    private double Rate => Cat.RateToUsd("USD");
    private double Cv(double brl) => _cur == "USD" ? (Rate > 0 ? brl / Rate : brl) : brl;
    private string Sym => _cur == "USD" ? "US$" : "R$";
    private string Num(double brl) { var v = Cv(brl); return v == 0 ? "—" : v.ToString("#,##0", Pt); }
    private string Brl(double brl) => Sym + " " + Cv(brl).ToString("#,##0.00", Pt);
    private static string Pct(double v) => v.ToString("0", Pt) + "%";
    private static double? ParseVal(string? s) => double.TryParse((s ?? "").Replace("R$", "").Replace("US$", "").Replace(".", "").Replace(",", ".").Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : (string.IsNullOrWhiteSpace(s) ? 0 : (double?)null);

    private static string AtCol(double a) => a >= 100 ? "var(--pos)" : a >= 90 ? "var(--warn)" : "var(--neg)";
    private static string AttStyle(double? a)
    {
        if (a is null) return "color:var(--muted)";
        var v = a.Value;
        if (v >= 100) return "background:#eef8f1;color:#1f7a48";
        if (v >= 90) return "background:#fdf6e7;color:#9a6a15";
        return "background:#fbeeec;color:#b23a2b";
    }
}
