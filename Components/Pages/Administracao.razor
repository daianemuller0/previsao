@page "/administracao"
@attribute [Authorize]
@rendermode InteractiveServer
@inject Catalog Cat

<div class="breadcrumbs"><span>Sistema</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Administração</span></div>

<div class="page-head">
    <div>
        <h1>Administração</h1>
        <p class="subtitle">Perfis de acesso, governança e informações da plataforma</p>
    </div>
</div>

<div class="grid-2">
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Perfis de acesso</div></div>
        <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
            <table class="grid-tbl">
                <thead><tr><th>Perfil</th><th>Escopo</th></tr></thead>
                <tbody>
                    @foreach (var (role, desc) in _perfis)
                    {
                        <tr><td class="col-strong">@Roles.DisplayName(role)</td><td>@desc</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted" style="font-size:11.5px;margin-top:10px">O controle de acesso é aplicado também no nível dos dados (cada KAM vê sua carteira).</p>
    </div>
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Plataforma</div></div>
        <dl class="detail-grid" style="grid-template-columns:1fr">
            <div class="dl"><dt>Aplicação</dt><dd>Howden Sales Forecast</dd></div>
            <div class="dl"><dt>Stack</dt><dd>.NET 8 · Blazor Server</dd></div>
            <div class="dl"><dt>Persistência</dt><dd>DuckDB sobre Parquet</dd></div>
            <div class="dl"><dt>Autenticação</dt><dd>Cookie · perfil por sessão</dd></div>
            <div class="dl"><dt>Mercados</dt><dd>@Cat.Markets.Count</dd></div>
            <div class="dl"><dt>Clientes / Plantas</dt><dd>@Cat.Customers.Count / @Cat.Plants.Count</dd></div>
            <div class="dl"><dt>KAMs</dt><dd>@Cat.Kams.Count</dd></div>
        </dl>
    </div>
</div>

<div class="panel mt-16">
    <div class="panel-head"><div class="panel-title">Governança &amp; auditoria</div></div>
    <div class="attention">
        <div class="att-item"><div class="att-ico info">@Icons.Svg("history")</div><div class="att-body"><div class="att-title">Trilha de auditoria</div><div class="att-desc">Toda alteração de oportunidade registra usuário, data e valores</div></div></div>
        <div class="att-item"><div class="att-ico info">@Icons.Svg("layers")</div><div class="att-body"><div class="att-title">Snapshots de forecast</div><div class="att-desc">Fotografias periódicas para comparação histórica</div></div></div>
        <div class="att-item"><div class="att-ico info">@Icons.Svg("check")</div><div class="att-body"><div class="att-title">Data Quality Score</div><div class="att-desc">Indicador de completude e atualização por KAM e mercado</div></div></div>
        <div class="att-item"><div class="att-ico info">@Icons.Svg("admin")</div><div class="att-body"><div class="att-title">Escrita append-only</div><div class="att-desc">Concorrência segura em pasta de rede compartilhada</div></div></div>
    </div>
</div>

@code {
    private readonly (string Role, string Desc)[] _perfis =
    {
        (Roles.Admin, "Acesso completo à plataforma e configurações"),
        (Roles.Diretoria, "Todas as análises e o consolidado executivo"),
        (Roles.Gestor, "Vendedores e oportunidades sob sua gestão"),
        (Roles.Kam, "Próprias oportunidades e resultados"),
        (Roles.Financeiro, "Valores, margens, moedas, câmbio e análises financeiras"),
        (Roles.Viewer, "Somente consulta ao consolidado executivo"),
    };
}
