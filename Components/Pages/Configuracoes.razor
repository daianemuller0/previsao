@page "/configuracoes"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DataSyncService Sync
@inject ControleRepository Controle

@* ===========================================================================
   Configurações de importação — De-Para das colunas das duas origens de dados
   (New Business = planilha Funil de Vendas HSA · Aftermarket = novo CRM). Página
   de referência: deixa claro qual coluna de cada origem alimenta cada campo do
   sistema, além das regras de conversão de moeda e de margem (GM).
   =========================================================================== *@

<div class="breadcrumbs"><span>Sistema</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Configurações</span></div>

<div class="page-head">
    <div>
        <h1>Configurações de importação</h1>
        <p class="subtitle">
            De-Para das colunas das duas origens de dados · como cada planilha conversa com os campos do sistema<br />
            O valor final usado em todo o sistema é o <strong>Amount (converted)</strong>, sempre em R$.
        </p>
    </div>
</div>

@* ---- As duas origens ---- *@
<div class="g12 top">
    <div class="c6">
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">Origem 1 · New Business <span class="hint">planilha Funil de Vendas HSA (atual)</span></div>
                <span class="badge fc-best">NB</span>
            </div>
            <p class="cfg-lead">Vem do CRM Salesforce (Funil de Vendas HSA). Lida automaticamente da pasta de rede a cada abertura do programa. Toda oferta desta base entra como <strong>New Business</strong> e o valor já chega em R$ na coluna <em>Amount (converted)</em> — sem conversão.</p>
        </div>
    </div>
    <div class="c6">
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">Origem 2 · Aftermarket <span class="hint">novo CRM · planilha AFM</span></div>
                <span class="badge fc-upside">AFM</span>
            </div>
            <p class="cfg-lead">Vinda de outro CRM. Lida automaticamente da pasta de rede a cada abertura do programa. Toda oferta desta base entra como <strong>Aftermarket</strong>. O valor vem na moeda de origem (coluna N) e é <strong>convertido para R$</strong> pela taxa cadastrada na aba Controle, gerando o <em>Amount (converted)</em>.</p>
        </div>
    </div>
</div>

@* ---- Sincronização automática (New Business + Aftermarket) ---- *@
<div class="section-head" style="margin-top:20px"><span class="st-title">Sincronização automática</span><span class="st-sub">lê as planilhas do CRM na rede a cada abertura do programa</span><span class="st-line"></span></div>
<div class="g12">
    <div class="c4">
        <div class="panel" style="height:100%">
            <div class="panel-head">
                <div class="panel-title">New Business <span class="badge fc-best">NB</span></div>
                <button class="btn-ghost" @onclick="SincronizarNb" disabled="@_sincronizando">@Icons.Svg("import")Sincronizar</button>
            </div>
            <div class="cfg-kv"><span class="cfg-k">Caminho</span><code class="cfg-path">@(string.IsNullOrWhiteSpace(Sync.NbPath) ? "— não configurado" : Sync.NbPath)</code></div>
            @if (_nb.HasRun)
            {
                <div class="cfg-kv"><span class="cfg-k">Resultado</span><span><span class="badge @(_nb.Ok ? "fc-commit" : "badge-neg")">@(_nb.Ok ? "OK" : "Atenção")</span> @_nb.Message</span></div>
                <div class="cfg-kv"><span class="cfg-k">Oportunidades</span><span>@_nb.Rows@(_nb.Warnings > 0 ? $" · {_nb.Warnings} aviso(s)" : "")</span></div>
                @if (_nb.FinishedAt is { } fin) { <div class="cfg-kv"><span class="cfg-k">Executado</span><span>@fin.ToString("dd/MM HH:mm:ss")</span></div> }
            }
            else { <p class="cfg-lead">Sincroniza na abertura do programa. Use o botão para atualizar agora.</p> }
        </div>
    </div>
    <div class="c4">
        <div class="panel" style="height:100%">
            <div class="panel-head">
                <div class="panel-title">Aftermarket <span class="badge fc-upside">AFM</span></div>
                <button class="btn-ghost" @onclick="SincronizarAfm" disabled="@_sincronizando">@Icons.Svg("import")Sincronizar</button>
            </div>
            <div class="cfg-kv"><span class="cfg-k">Caminho</span><code class="cfg-path">@(string.IsNullOrWhiteSpace(Sync.AfmPath) ? "— não configurado" : Sync.AfmPath)</code></div>
            @if (_afm.HasRun)
            {
                <div class="cfg-kv"><span class="cfg-k">Resultado</span><span><span class="badge @(_afm.Ok ? "fc-commit" : "badge-neg")">@(_afm.Ok ? "OK" : "Atenção")</span> @_afm.Message</span></div>
                <div class="cfg-kv"><span class="cfg-k">Oportunidades</span><span>@_afm.Rows@(_afm.Warnings > 0 ? $" · {_afm.Warnings} aviso(s)" : "")</span></div>
                @if (_afm.Currencies.Count > 0) { <div class="cfg-kv"><span class="cfg-k">Moedas</span><span class="cfg-chips" style="margin-top:0">@foreach (var c in _afm.Currencies){<span class="chip" style="cursor:default">@c</span>}</span></div> }
                @if (_afm.FinishedAt is { } fin) { <div class="cfg-kv"><span class="cfg-k">Executado</span><span>@fin.ToString("dd/MM HH:mm:ss")</span></div> }
            }
            else { <p class="cfg-lead">Sincroniza na abertura do programa. Use o botão para atualizar agora.</p> }
        </div>
    </div>
    <div class="c4">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Taxas de conversão <span class="hint">R$ por unidade · AFM</span></div></div>
            @if (_rates.Count == 0)
            {
                <div class="empty">Nenhuma moeda estrangeira detectada ainda. As moedas encontradas na planilha AFM aparecem aqui para informar a taxa.</div>
            }
            else
            {
                <div class="rate-list">
                    @foreach (var m in _rates)
                    {
                        <div class="rate-row @(m.HasRate ? "" : "rate-missing")">
                            <span class="rate-code">@m.Code</span>
                            <input class="rate-in" @bind="m.Rate" placeholder="0,00" />
                            <button class="btn-ghost rate-save" @onclick="() => SalvarTaxa(m)">@Icons.Svg("check")Salvar</button>
                        </div>
                    }
                </div>
                <p class="cfg-foot">Moedas sem taxa deixam o valor zerado até serem informadas. <strong>BRL</strong> não precisa de taxa.</p>
            }
        </div>
    </div>
</div>

@* ---- De-Para de colunas ---- *@
<div class="section-head" style="margin-top:20px"><span class="st-title">De-Para de colunas</span><span class="st-sub">campo do sistema ← coluna de cada origem</span><span class="st-line"></span></div>
<div class="table-wrap">
    <table class="grid-tbl">
        <thead>
            <tr>
                <th class="no-sort">Campo no sistema (Funil HSA)</th>
                <th class="no-sort">Origem NB · Funil de Vendas HSA</th>
                <th class="no-sort">Origem AFM · novo CRM</th>
                <th class="no-sort">Observação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Mapa)
            {
                <tr class="@(m.Destaque ? "cfg-hi" : "")">
                    <td class="col-strong">@m.Sistema</td>
                    <td>@Src(m.Nb)</td>
                    <td>@Src(m.Afm)</td>
                    <td class="cfg-note">@m.Nota</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ---- Regras especiais ---- *@
<div class="g12" style="margin-top:20px">
    @* Conversão de moeda (AFM) *@
    <div class="c6">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Conversão de moeda <span class="hint">somente Aftermarket</span></div></div>
            <ol class="cfg-steps">
                <li>Lê a <strong>moeda</strong> da proposta na <strong>coluna M</strong> e o <strong>valor</strong> na <strong>coluna N</strong>.</li>
                <li>Se a moeda for <strong>BRL</strong>, mantém o valor como está.</li>
                <li>Para as demais moedas, multiplica o valor pela <strong>taxa cadastrada na aba Controle</strong> para chegar ao valor em R$.</li>
                <li>O resultado em R$ vira o <strong>Amount (converted)</strong> — o valor usado em todo o sistema.</li>
            </ol>
            <div class="cfg-callout">
                <span class="badge fc-pipe">Exemplo</span>
                <span>Valor <strong>USD 100.000</strong> · taxa Controle <strong>5,42</strong> → Amount (converted) = <strong>R$ 542.000</strong>.</span>
            </div>
            <p class="cfg-foot">As taxas por moeda ficam na aba <a href="/controle">Controle</a>. New Business não passa por conversão — já chega em R$.</p>
        </div>
    </div>

    @* Margem GM (AFM) *@
    <div class="c6">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Margem bruta (GM) <span class="hint">somente Aftermarket</span></div></div>
            <p class="cfg-lead">No CRM do Aftermarket a coluna <strong>GM</strong> vem como <strong>número inteiro</strong> (ex.: <code>25</code>). O sistema interpreta esse número como <strong>percentual</strong> e grava em <em>Gross Margin(%)</em>.</p>
            <div class="cfg-callout">
                <span class="badge fc-pipe">Exemplo</span>
                <span>GM <strong>25</strong> no CRM → <strong>25%</strong> de margem no sistema.</span>
            </div>
            <p class="cfg-foot">New Business já traz a margem em <em>Gross Margin(%)</em>, sem ajuste.</p>
        </div>
    </div>
</div>

@* ---- Equivalência de etapas do funil (AFM → nosso funil) ---- *@
<div class="section-head" style="margin-top:20px"><span class="st-title">Funil · equivalência de etapas</span><span class="st-sub">FunnelStage do AFM → etapa do nosso funil (NB)</span><span class="st-line"></span></div>
<div class="table-wrap">
    <table class="grid-tbl">
        <thead>
            <tr>
                <th class="no-sort">Etapa no AFM (FunnelStage)</th>
                <th class="no-sort">Etapa no nosso funil (NB)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in FunilDePara)
            {
                <tr>
                    <td>@s.Afm</td>
                    <td class="col-strong">@s.Nb</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="panel" style="margin-top:12px">
    <div class="cfg-callout">
        <span class="badge fc-upside">Regra OTP</span>
        <span>Se a coluna <strong>Status</strong> da planilha AFM estiver marcada <strong>OTP</strong>, a oportunidade entra direto na etapa <strong>E1 Order Entry</strong>, independentemente do FunnelStage.</span>
    </div>
</div>

@* ---- Colunas sem correspondência ---- *@
<div class="section-head" style="margin-top:20px"><span class="st-title">Colunas do CRM Aftermarket sem correspondência</span><span class="st-sub">não alimentam nenhum campo do sistema</span><span class="st-line"></span></div>
<div class="panel">
    <p class="cfg-lead">Estas colunas existem na planilha do Aftermarket mas <strong>não têm campo equivalente</strong> no sistema hoje — são ignoradas na importação. Se alguma precisar ser aproveitada, é só avisar.</p>
    <div class="cfg-chips">
        @foreach (var c in SemDePara)
        {
            <span class="chip" style="cursor:default">@c</span>
        }
    </div>
</div>

@code {
    private bool _sincronizando;
    private DataSyncStatus _nb = new();
    private DataSyncStatus _afm = new();
    private List<CurrencyRate> _rates = new();

    protected override void OnInitialized()
    {
        _nb = Sync.LastNb;
        _afm = Sync.LastAfm;
        _rates = Controle.CurrencyRates();
    }

    private Task SincronizarNb() => Sincronizar(() => Sync.SyncNb());
    private Task SincronizarAfm() => Sincronizar(() => Sync.SyncAfm());

    private async Task Sincronizar(Action run)
    {
        if (_sincronizando) return;
        _sincronizando = true;
        try { await Task.Run(run); }
        finally
        {
            _nb = Sync.LastNb;
            _afm = Sync.LastAfm;
            _rates = Controle.CurrencyRates();
            _sincronizando = false;
        }
    }

    private void SalvarTaxa(CurrencyRate m)
    {
        var s = (m.Rate ?? "").Replace(",", ".").Trim();
        if (double.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) && v >= 0)
            Controle.SaveCurrencyRate(m.Code, v, "Configurações");
        _rates = Controle.CurrencyRates();
    }

    private record MapRow(string Sistema, string Nb, string Afm, string Nota = "", bool Destaque = false);

    // Fonte única do De-Para. A mesma relação será usada para conectar a planilha
    // do Aftermarket aos campos do sistema quando o arquivo for importado.
    private static readonly MapRow[] Mapa =
    {
        new("Amount (converted) · valor usado no sistema", "Amount (converted) — já em R$", "Valor (col N) convertido de Moeda (col M) para R$", "Valor principal. AFM: conversão pela taxa da aba Controle.", true),
        new("Close Date", "Close Date", "PO Esperado"),
        new("Installation Location (País)", "Installation Location", "Country"),
        new("Parent Opportunity: End User Site", "Parent Opportunity: End User Site", "PlantName"),
        new("Commercial Segment", "Commercial Segment", "CRS_Market"),
        new("Market", "Market", "Industry"),
        new("Sub-Market", "Sub-Market", "SubIndustry"),
        new("Process", "Process", "Process"),
        new("Product Type", "Product Type", "ProductType"),
        new("Outside Sales Rep (Vendedor)", "Outside Sales Rep", "", "AFM não possui vendedor externo mapeado (ContractorName não corresponde)."),
        new("Opportunity Number", "Opportunity Number", "QuoteNumber"),
        new("Gross Margin(%)", "Gross Margin(%)", "GM (inteiro → %)", "AFM: número inteiro convertido para percentual.", true),
        new("Stage", "Stage", "FunnelStage", "AFM: convertido para a etapa equivalente do funil (ver tabela abaixo)."),
        new("Chance", "Chance", "Chance"),
        new("Customer Ref#", "Customer Ref#", "ClientRef"),
        new("Business Unit", "Business Unit", "BU"),
        new("Description", "Description", "Description"),
        new("Categoria comercial (NB / AFM)", "NB/AFM da planilha", "Fixo: AFM", "Define se a oferta é New Business ou Aftermarket.", true),
    };

    // Equivalência das etapas do funil: FunnelStage do AFM → etapa do nosso funil.
    private record StageRow(string Afm, string Nb);
    private static readonly StageRow[] FunilDePara =
    {
        new("qualification", "Qualification"),
        new("Value Proposal", "Arrived at Agreement on Need"),
        new("Quote submission", "Proposal Pending/Waiting"),
        new("Quote clarification", "Negotiation Phase/Review"),
        new("Closing", "Verbal Commitment"),
        new("Status = OTP", "E1 Order Entry"),
    };

    // Colunas do CRM Aftermarket que não têm campo equivalente no sistema.
    // (Status passou a ser usado na regra OTP → E1 Order Entry.)
    private static readonly string[] SemDePara =
    {
        "ContractorName", "ADDTOFORECAST", "Special", "Category",
    };

    // Célula de origem: mostra o traço quando não há correspondência.
    private static RenderFragment Src(string v) => builder =>
    {
        if (string.IsNullOrEmpty(v)) { builder.AddMarkupContent(0, "<span class=\"cfg-none\">— sem correspondência</span>"); }
        else { builder.AddContent(1, v); }
    };
}
