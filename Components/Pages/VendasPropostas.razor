    private async Task ExportarPowerPoint()
    {
        _gerandoPpt = true; _msg = null; _editCores = _editCoresMetas = false; _dica = null;
        StateHasChanged();
        var metOriginal = _met;
        async Task Foto(string chave, string seletor) => await JS.InvokeAsync<bool>("vpPptx.capturar", chave, seletor);
        try
        {
            await JS.InvokeVoidAsync("vpPptx.inicio");
            await Foto("kpis", ".vp-page .cvx-kpis");
            await Foto("mes-a-mes", "#mes-a-mes .chart-body");
            await Foto("mes-a-mes-setor", "#mes-a-mes-setor .chart-body");
            foreach (var m in new[] { "qtd", "valor", "vendas", "taxa" })
            {
                _met = m;
                StateHasChanged();
                await Task.Delay(450);   // a página redesenha o gráfico antes da foto
                await Foto("mensal-" + m, "#mensal .chart-body");
            }
            _met = metOriginal;
            StateHasChanged();
            await Task.Delay(300);
            await Foto("anos", "#mensal .vp-conv-grid");
            await Foto("setores", "#setores .vp-conv-grid");
            await Foto("metas", "#metas");
            await Foto("bu", "#unidades .cvx-card");
            await Foto("mercado", "#mercado .cvx-card");
            await Foto("produto", "#produto .cvx-card");
            await Foto("vendedores", "#vendedores .cvx-card");
            await Foto("pais", "#pais .cvx-card");
            await Foto("perdas", "#perdas .cvx-card");
            await Foto("acumulado", "#budget .cvx-card");
            await Foto("mes-ano", "#mes-ano .cvx-card");
            await JS.InvokeVoidAsync("vpPptx.gerar", DadosApresentacao());
            _msgOk = true; _msg = T("Apresentação gerada: veja o arquivo .pptx nos downloads do navegador.", "Presentation generated: find the .pptx file in your browser downloads.");
        }
        catch (Exception ex) { _msgOk = false; _msg = T("Não deu para gerar a apresentação: ", "Could not generate the presentation: ") + ex.Message; }
        finally
        {
            try { await JS.InvokeVoidAsync("vpPptx.fim"); } catch { }
            _met = metOriginal;
            _gerandoPpt = false;
        }
    }

    private bool _gerandoPdfSetores;

    /// <summary>
    /// PDF do quadro "Vendas por setor" com três páginas: NB + AFM, só NB e só AFM. Passa o filtro de Setor por
    /// cada caso (vendas, propostas e conversão do setor), copia o quadro desenhado e, no fim, volta o filtro
    /// como estava e imprime as três cópias (wwwroot/app.js, vpPdfMulti). Os outros filtros continuam valendo.
    /// </summary>
    private async Task PdfSetores()
    {
        _gerandoPdfSetores = true;
        var antes = _fil.Origens.ToList();
        var ok = false;
        try
        {
            await JS.InvokeVoidAsync("vpPdfMulti.inicio");
            foreach (var (setores, rotulo) in new[]
            {
                (Array.Empty<string>(), T("Gráfico 1 de 3 · Aftermarket + NB juntos (AFM + NB)", "Chart 1 of 3 · Aftermarket + NB together (AFM + NB)")),
                (new[] { ConversaoService.Afm }, T("Gráfico 2 de 3 · Só Aftermarket (AFM)", "Chart 2 of 3 · Aftermarket only (AFM)")),
                (new[] { ConversaoService.Nb }, T("Gráfico 3 de 3 · Só New Business (NB)", "Chart 3 of 3 · New Business only (NB)")),
            })
            {
                _fil.Origens.Clear();
                foreach (var x in setores) _fil.Origens.Add(x);
                Carregar();
                StateHasChanged();
                await Task.Delay(500);   // a página redesenha o quadro (e as linhas, em vpmAjustar) antes da cópia
                await JS.InvokeVoidAsync("vpPdfMulti.copiar", "mes-a-mes-setor", rotulo);
            }
            ok = true;
        }
        catch (Exception ex) { _msgOk = false; _msg = T("Não deu para gerar o PDF: ", "Could not generate the PDF: ") + ex.Message; }
        finally
        {
            _fil.Origens.Clear();
            foreach (var x in antes) _fil.Origens.Add(x);
            Carregar();
            _gerandoPdfSetores = false;
            StateHasChanged();
        }
        try
        {
            if (ok) await JS.InvokeVoidAsync("vpPdfMulti.imprimir", T("Vendas por setor - AFM + NB, AFM e NB", "Sales by sector - AFM + NB, AFM and NB"));
            else await JS.InvokeVoidAsync("vpPdfMulti.cancelar");
        }
        catch { }
    }

    private async Task Exportar()
    {
        // a planilha sai sempre em R$ (o layout da equipe): em US$, recalcula as propostas em R$ só para ela
        var meses = _meses;
        if (_fil.EmDolar && Conv.Ok)
        {
            var enviadasBrl = ConversaoDeVendas.PropostasEnviadas(Conv.Atual.Propostas.Where(p => _fil.Passa(p, ignorarAno: true)), Cambio.Todas())
                .Where(p => p.Data.Year >= AnoIni && p.Data.Year <= AnoFim).ToList();
            meses = ConversaoDeVendas.Meses(_brutos, enviadasBrl).Where(m => m.Ano >= AnoIni && m.Ano <= AnoFim).ToList();
        }
        var bytes = VendasMensaisRepository.Planilha(_brutos, _budgets, meses, _vSetorBrl.Values.OrderBy(v => v.Ano).ThenBy(v => v.Mes).ToList());
        await JS.InvokeVoidAsync("appDownload", "vendas_e_propostas.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
