                            <td>@(A.MesesP > 0 ? N0(A.Propostas) : "n/d")</td><td>@(B.MesesP > 0 ? N0(B.Propostas) : "n/d")</td>
                            <td>@(A.MesesP > 0 && B.MesesP > 0 ? DifQtd(A.Propostas - B.Propostas) : "—")</td><td>@(VarMm(A.Propostas, B.Propostas) is double yp && A.MesesP > 0 ? PctSinal(yp) : "—")</td>
                            <td>@(A.Taxa is double ta1 ? P1(ta1) : "—")</td><td>@(B.Taxa is double tb2 ? P1(tb2) : "—")</td>
