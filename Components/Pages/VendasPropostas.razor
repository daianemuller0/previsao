@page "/vendas-propostas"
@attribute [Authorize(Roles = "admin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Text
@inject VendasMensaisRepository VendasRepo
@inject ConversaoService Conv
@inject CambioAnualRepository Cambio
@inject IJSRuntime JS
@inject ChartPrefsRepository ChartPrefs

@* ===========================================================================
   Vendas × Propostas · mesmo padrão visual da guia Conversão (cvx).
   Primeira informação: propostas enviadas (quantidade e valor) e vendas,
   mês a mês (uma linha por ano, 2022 em diante) e ano a ano.
   As propostas vêm das planilhas da guia Conversão (AFM e NB, data de envio);
   as vendas e os budgets, do histórico da equipe (editável aqui).
   =========================================================================== *@

<PageTitle>@T("Performance Comercial", "Sales Performance") · Howden South America</PageTitle>

<div class="cvx vp-page">
    <div class="breadcrumbs"><span>@T("Executivo", "Executive")</span><span class="sep">/</span><span>@T("Performance Comercial", "Sales Performance")</span></div>
    <div class="page-head">
        <div>
            <h1>@T("Performance Comercial", "Sales Performance") | Howden South America</h1>
            <p class="subtitle">
                @T("Resultados, indicadores e oportunidades de crescimento", "Results, indicators and growth opportunities") · @Periodo · @T("valores em", "values in") @Sim@(_fil.UsaTaxaTela ? T($" (valores em R$ ÷ {_fil.TaxaTela!.Value.ToString("0.0000", Br)}, a taxa digitada na tela)", $" (R$ values ÷ {_fil.TaxaTela!.Value.ToString("0.0000", EnUs)}, the rate entered on screen)") : _fil.EmDolar ? T(" (R$ ÷ taxa USD/BRL do ano; AFM no valor original em US$)", " (R$ ÷ the year's USD/BRL rate; AFM at its original US$ value)") : "")<br />
                @T("Propostas: planilhas da guia Conversão (AFM e NB), pela data de envio", "Proposals: Conversion tab spreadsheets (AFM and NB), by send date")@(Conv.AtualizadoEm is { } quando ? (En ? $" · updated {quando.ToString("MM/dd/yyyy 'at' h:mm tt", EnUs)}" : $" · atualizadas em {quando:dd/MM/yyyy 'às' HH:mm}") : "") · @T("Vendas e budgets: histórico da equipe", "Sales and budgets: team history")
            </p>
        </div>
        <div class="page-actions">
            <button class="btn-ghost" title="@T("Reler as planilhas de propostas", "Reload the proposal spreadsheets")" disabled="@_carregando" @onclick="Reler">@Icons.Svg("import")@(_carregando ? T("Atualizando…", "Refreshing…") : T("Atualizar", "Refresh"))</button>
            <button class="btn-ghost" @onclick="Exportar">@Icons.Svg("download")@T("Exportar Excel", "Export Excel")</button>
            <button class="btn-ghost" disabled="@_gerandoPpt" title="@T("Gera uma apresentação com os gráficos e os dados desta tela (com os filtros atuais)", "Builds a presentation with the charts and data on this screen (with the current filters)")" @onclick="ExportarPowerPoint">@Icons.Svg("download")@(_gerandoPpt ? T("Gerando…", "Generating…") : T("Apresentação (PowerPoint)", "Presentation (PowerPoint)"))</button>
            <button class="btn-primary" @onclick="() => { _editando = !_editando; _msg = null; }">@(_editando ? T("✕ Fechar edição", "✕ Close editing") : T("✎ Atualizar dados", "✎ Edit data"))</button>
        </div>
    </div>

    @if (_gerandoPpt) { <div class="vp-gerando" role="status"><div><b>@T("Gerando a apresentação…", "Generating the presentation…")</b><span>@T("Fotografando os gráficos da tela. Leva alguns segundos; não feche a página.", "Capturing the charts on screen. It takes a few seconds; do not close the page.")</span></div></div> }
    @if (_msg is not null) { <div class="cvx-alert @(_msgOk ? "vp-ok" : "erro")">@_msg</div> }

    @* filtros da guia Conversão (mesma barra, congelada no topo): valem para as propostas e as seções de conversão *@
    <Conversao Embutido="true" Parte="filtros" Filtros="_fil" FiltrosMudaram="AoMudarFiltros" />

    @if (_anos.Count == 0)
    {
        <div class="cvx-card"><div class="empty" style="padding:34px 12px">@T("Sem dados de vendas nem de propostas.", "No sales or proposal data.")</div></div>
    }
    else
    {
        var foco = AnoDoFoco;
        var linhaFoco = Linha(foco.Ano);
        var mesLim = MesLimite(foco.Ano);
        var anoAnt = foco.Ano - 1;
        var qtdAnt = AnoIni <= anoAnt ? QtdAte(anoAnt, mesLim) : (int?)null;
        var valAnt = AnoIni <= anoAnt ? ValorAte(anoAnt, mesLim) : null;
        var vendAnt = AnoIni <= anoAnt && foco.UltimoMes > 0 ? ConversaoDeVendas.AteOMes(_meses, anoAnt, foco.UltimoMes) : 0m;
        var periodo = mesLim < 12 ? JanAte(mesLim) : T("ano inteiro", "full year");
        var periodoVendas = foco.UltimoMes is > 0 and < 12 ? JanAte(foco.UltimoMes) : T("ano inteiro", "full year");

        <div class="cvx-filters vp-foco">
            <div class="flt"><span class="flt-label">@T("Ano em foco", "Focus year")</span>
                <div class="cvx-seg-ctl">
                    @foreach (var a in AnosDoPainel)
                    {
                        var ano = a;
                        <button class="@(ano == _foco ? "on" : "")" @onclick="() => { _foco = ano; _dica = null; }">@ano</button>
                    }
                </div>
            </div>
            <span class="cvx-note">@T($"O filtro de Ano escolhe os anos da página. Os outros filtros valem para as propostas e as taxas; vendas e metas são da empresa toda. Comparações com o mesmo período de {anoAnt}.", $"The Year filter picks the years shown on the page. The other filters apply to proposals and rates; sales and targets are company-wide. Comparisons with the same period of {anoAnt}.")</span>
        </div>

        @if (_carregando && _enviadas.Count == 0) { <div class="cvx-alert">@T("Lendo as planilhas de propostas…", "Reading the proposal spreadsheets…")</div> }
        @if (_anosSemCambio.Count > 0)
        {
            <div class="cvx-alert">
                <strong>@T("Em US$ falta a taxa de câmbio de", "In US$, the exchange rate is missing for") @string.Join(", ", _anosSemCambio):</strong>
                @T("as vendas e os budgets desses anos (em R$) ficam \"n/d\" em dólar. Cadastre a taxa USD/BRL na guia Conversão (botão “Taxas de câmbio”).", "sales and budgets for those years (in R$) show \"n/a\" in dollars. Add the USD/BRL rate in the Conversion tab (“Exchange rates” button).")
            </div>
        }
        @if (Conv.Ok && Conv.AjusteTexto != "")
        {
            <div class="cvx-alert vp-ok"><strong>@T("Ajuste manual na conversão:", "Manual conversion adjustment:")</strong> @AjusteTxt()</div>
        }
        @if (AnosSemTaxa() is { Count: > 0 } semTaxa)
        {
            <div class="cvx-alert">
                <strong>@T("Valor enviado parcial em", "Partial value sent in") @string.Join(", ", semTaxa.Select(s => s.Ano)):</strong>
                @string.Join(" · ", semTaxa.Select(s => En ? $"{N0(s.Qtd)} {(_fil.EmDolar ? "NB" : "AFM")} proposal(s) in {s.Ano} without an exchange rate" : $"{N0(s.Qtd)} proposta(s) do {(_fil.EmDolar ? "NB" : "AFM")} em {s.Ano} sem taxa de câmbio")).
                @T("Elas contam na quantidade, mas ficam fora do valor. Cadastre a taxa USD/BRL desses anos na guia Conversão (botão “Taxas de câmbio”).", "They count in the number of proposals but are left out of the value. Add the USD/BRL rate for those years in the Conversion tab (“Exchange rates” button).")
            </div>
        }

        <div class="cvx-page">

        @* ================= 1 · PROPOSTAS ENVIADAS (o principal) ================= *@
        <section id="propostas" class="cvx-sec">
            <div class="xsec lvl1"><span class="xsec-t">@T("Propostas enviadas", "Proposals sent")</span><span class="xsec-s">@T("Quantidade, valor enviado e vendas · mês a mês e ano a ano", "Count, value sent and sales · month by month and year by year") · @Periodo</span><span class="xsec-line"></span></div>

            <div class="cvx-kpis">
                @Kpi($"{T("Propostas enviadas", "Proposals sent")} · {foco.Ano}", linhaFoco.Qtd is int qk ? N0(qk) : "—", $"{periodo}{(_setor == "" ? "" : " · " + _setor)}",
                    T("Propostas com data de envio no ano (cada número de proposta conta uma vez)", "Proposals with a send date in the year (each proposal number counts once)"), CorTx, Delta(QtdAte(foco.Ano, mesLim), qtdAnt, anoAnt))
                @Kpi($"{T("Valor enviado", "Value sent")} · {foco.Ano}", linhaFoco.Valor is decimal vk ? Mi(vk) : "—", linhaFoco.SemTaxa > 0 ? (En ? $"{periodo} · partial: {N0(linhaFoco.SemTaxa)} without an exchange rate" : $"{periodo} · parcial: {N0(linhaFoco.SemTaxa)} sem taxa de câmbio") : periodo,
                    T($"Soma do valor das propostas enviadas no ano, em {Sim}", $"Total value of proposals sent in the year, in {Sim}"), "#155A96", Delta(ValorAte(foco.Ano, mesLim), valAnt, anoAnt))
                @Kpi($"{T("Vendas", "Sales")} · {foco.Ano}", foco.MesesComVendas > 0 ? Mi(foco.Vendas) : "—", $"{periodoVendas}{(foco.BudgetHsa is > 0 ? $" · {Pct(foco.Vendas / foco.BudgetHsa!.Value)} {T("do budget HSA", "of HSA budget")}" : "")}",
                    T("Vendas da empresa no ano (histórico da equipe)", "Company sales in the year (team history)"), "#1f9254", Delta(foco.Vendas, vendAnt, anoAnt))
                @Kpi($"{T("Valor médio por proposta", "Average value per proposal")} · {foco.Ano}", linhaFoco.Qtd is > 0 && linhaFoco.Valor is decimal vm && linhaFoco.ComValor > 0 ? Mi(vm / linhaFoco.ComValor) : "—",
                    $"{periodo} · {T("valor enviado ÷ propostas com valor", "value sent ÷ proposals with a value")}", T($"Média do valor das propostas enviadas no ano ({Sim})", $"Average value of proposals sent in the year ({Sim})"), "#2478B8",
                    AnoIni <= anoAnt ? Delta(MedioAte(foco.Ano, mesLim), MedioAte(anoAnt, mesLim), anoAnt) : null)
                @Kpi($"{T("Venda por proposta", "Sales per proposal")} · {foco.Ano}", linhaFoco.VendaPorProposta is decimal vpp ? Mi(vpp) : "—", $"{periodoVendas} · {T("vendas ÷ propostas enviadas, nos meses com as duas", "sales ÷ proposals sent, in months with both")}",
                    T($"Quanto foi vendido ({Sim}) para cada proposta enviada, só nos meses que têm venda e propostas", $"How much was sold ({Sim}) for each proposal sent, only in months with both sales and proposals"), "#007A9E")
                @{ var txFoco = Taxa(foco.Ano); var txFocoAnt = Taxa(anoAnt, mesLim); var txFocoAte = Taxa(foco.Ano, mesLim); }
                @Kpi($"{T("Taxa de conversão", "Conversion rate")} · {foco.Ano}", txFoco.Taxa is double tq ? P1(tq) : T("Não calculável", "Not computable"),
                    $"{N0(txFoco.G)} {T("ganhas", "won")} / {N0(txFoco.Base)} {DenRot}{(PorValor ? (txFoco.TaxaQtd is double tqq ? $" · {T("por quantidade", "by count")} {P1(tqq)}" : "") : (txFoco.TaxaValor is double tv ? $" · {T("por valor", "by value")} {P1(tv)}" : ""))}",
                    En ? $"Conversion rate {(PorValor ? "by value" : "by count")} = {RegraTxt}. Same rule as the Conversion tab; the \"Rate base\" and \"Conversion by\" buttons are in the filter bar."
                       : $"Taxa de Conversão {(PorValor ? "por valor" : "por quantidade")} = {RegraTxt}. Mesma regra da guia Conversão; os botões \"Taxa sobre\" e \"Conversão por\" ficam na barra de filtros.",
                    CorTx, DeltaPp(txFocoAte.Taxa, txFocoAnt.Taxa, anoAnt))
            </div>

            @* o mês de relance: vendas e propostas de cada mês, um ano, dois anos comparados ou todos os anos *@
            <div class="panel vp-principal vpm" id="mes-a-mes">
                @SecaoMesAMes(foco.Ano, false)
            </div>

            @* o mesmo quadro com as vendas separadas por setor (NB e AFM, seguem o filtro de Setor) e as duas conversões *@
            <div class="panel vp-principal vpm" id="mes-a-mes-setor">
                @SecaoMesAMes(foco.Ano, true)
            </div>

            <div class="panel vp-principal" id="mensal">
                <div class="panel-head">
                    <div class="panel-title">@TituloGrafico()
                        <span class="hint">@T("uma linha por ano · jan a dez", "one line per year · Jan to Dec") · @(_met switch { "vendas" => T("vendas da empresa no mês · ", "company sales in the month · ") + Sim, "valor" => T("mês de envio da proposta · ", "proposal send month · ") + Sim, "taxa" => BaseTodas ? T("ganhas ÷ todas as propostas enviadas no mês", "won ÷ all proposals sent in the month") : T("ganhas ÷ decididas do mês", "won ÷ decided in the month"), _ => T("mês de envio da proposta", "proposal send month") })@(_met != "vendas" && _setor != "" ? " · " + _setor : "")</span>
                    </div>
                    <div class="rep-attain-group">
                        <div class="rep-attain-box">
                            <span class="ra-label">@T("Propostas enviadas", "Proposals sent") (@foco.Ano)</span>
                            <span class="ra-value" style="color:@CorDoAno(foco.Ano)">@(linhaFoco.Qtd is int qh ? N0(qh) : "—")</span>
                        </div>
                        <div class="rep-attain-box">
                            <span class="ra-label">@T("Valor enviado", "Value sent") (@foco.Ano)</span>
                            <span class="ra-value" style="color:@CorDoAno(foco.Ano)">@(linhaFoco.Valor is decimal vh ? Mi(vh) : "—")</span>
                        </div>
                        <div class="rep-attain-box">
                            <span class="ra-label">@T("Vendas", "Sales") (@foco.Ano)</span>
                            <span class="ra-value" style="color:#1f9254">@(foco.MesesComVendas > 0 ? Mi(foco.Vendas) : "—")</span>
                        </div>
                    </div>
                </div>
                <div class="vp-met">
                    <div class="cvx-seg-ctl">
                        <button class="@(_met == "qtd" ? "on" : "")" @onclick='() => _met = "qtd"'>@T("Quantidade de propostas", "Number of proposals")</button>
                        <button class="@(_met == "valor" ? "on" : "")" @onclick='() => _met = "valor"'>@T("Valor enviado", "Value sent") (@Sim)</button>
                        <button class="@(_met == "vendas" ? "on" : "")" @onclick='() => _met = "vendas"'>@T("Vendas", "Sales") (@Sim)</button>
                        <button class="@(_met == "taxa" ? "on" : "")" @onclick='() => _met = "taxa"'>@T("Taxa de conversão (%)", "Conversion rate (%)")</button>
                    </div>
                    <div class="vp-cores-wrap">
                        <button class="btn-ghost vp-btn-cores" aria-expanded="@(_editCores ? "true" : "false")" @onclick="() => _editCores = !_editCores">🎨 @T("Cores das linhas", "Line colors")</button>
                        @if (_editCores)
                        {
                            <div class="flt-multi-backdrop" @onclick="() => _editCores = false"></div>
                            <div class="vp-cores-pop" role="dialog" aria-label="@T("Cores das linhas", "Line colors")">
                                <div class="vp-cores-tit">@T("Cor de cada ano", "Color of each year")</div>
                                @foreach (var a in AnosDoPainel.OrderByDescending(x => x))
                                {
                                    var ano = a;
                                    <label class="vp-cor-lin" title="@T("Cor da linha de", "Line color for") @ano">
                                        <input type="color" value="@CorDoAno(ano)" @onchange="e => MudarCor(ano.ToString(), e.Value?.ToString())" />
                                        <span>@ano</span>
                                    </label>
                                }
                                <div class="vp-cores-pe">
                                    <button class="btn-link" disabled="@(!Editaveis.Keys.Any(k => int.TryParse(k, out _)))" @onclick="() => RestaurarCores(AnosDoPainel.Select(a => a.ToString()))">@T("Restaurar cores padrão", "Restore default colors")</button>
                                    <button class="btn-primary" @onclick="() => _editCores = false">@T("Concluir", "Done")</button>
                                </div>
                                <div class="vp-cores-nota">@NotaCores</div>
                            </div>
                        }
                    </div>
                    <span class="cvx-note">@T($"Ano em foco ({foco.Ano}) com área e valores; troque o ano no filtro acima. Passe o mouse num mês para ver todos os anos.", $"Focus year ({foco.Ano}) with area and values; change the year in the filter above. Hover over a month to see all years.")</span>
                </div>
                <div class="chart-body">@((MarkupString)SvgAnos(_met, foco.Ano))</div>

                @* ano a ano, embaixo do gráfico: taxa de conversão + valor enviado, valor médio e vendas, um cartão por ano na cor da linha *@
                <div class="vp-anos-tit">@T("Taxa de conversão e resultados, ano a ano", "Conversion rate and results, year by year") <span>@RegraTxt · @(BaseTodas ? T("todas as propostas", "all proposals") : T("só as decididas", "decided only")) @T("(botão \"Taxa sobre\" no filtro)", "(\"Rate base\" button in the filter)")@(_setor != "" ? " · " + _setor : "")</span></div>
                <div class="vp-conv-grid">
                    @foreach (var a in AnosDoPainel)
                    {
                        var ano = a;
                        var c = Composicao(a);
                        var limC = MesLimite(a);
                        var tA = Taxa(a, limC); var tB = a - 1 >= AnoIni ? Taxa(a - 1, limC) : default;
                        var dC = a - 1 >= AnoIni ? DeltaPp(tA.TaxaQtd, tB.TaxaQtd, null) : null;
                        var dCv = a - 1 >= AnoIni ? DeltaPp(tA.TaxaValor, tB.TaxaValor, null) : null;
                        var baseBarra = Math.Max(1, c.Total);
                        var rv = _anos.FirstOrDefault(x => x.Ano == a);
                        var dV = a - 1 >= AnoIni && rv is { MesesComVendas: > 0 } ? DeltaCurto(rv.Vendas, ConversaoDeVendas.AteOMes(_meses, a - 1, rv.UltimoMes)) : null;
                        <button type="button" class="vp-conv-card @(a == foco.Ano ? "foco" : "")" style="--ac:@CorDoAno(a)" @onclick="() => { _foco = ano; _dica = null; }">
                            <div class="vp-cc-ano">@a@if (a == DateTime.Today.Year) { <small>@T("até", "through") @MesCurtoFrase(limC)</small> }</div>
                            @* as duas conversões em destaque: por quantidade (grande) e por valor (embaixo, em negrito) *@
                            <div class="vp-cc-taxa">
                                <b>@(c.TaxaQtd is double t ? P1(t) : "—")</b>
                                @if (dC is not null) { <em class="@DeltaCls(dC)">@Seta(dC)</em> }
                            </div>
                            <div class="vp-cc-tipo">@T("por quantidade", "by count")</div>
                            <div class="vp-cc-taxa valor">
                                <b>@(c.TaxaValor is double tvc ? P1(tvc) : "—")</b>
                                @if (dCv is not null) { <em class="@DeltaCls(dCv)">@Seta(dCv)</em> }
                            </div>
                            <div class="vp-cc-tipo">@T("por valor", "by value") (@Sim @T("ganho ÷", "won ÷") @(BaseTodas ? T("enviado", "sent") : T("decidido", "decided")))</div>
                            <div class="vp-cc-sub">@N0(c.G) @T("ganhas de", "won of") @N0(c.Base) @DenRot</div>
                            <div class="vp-cc-vendas" title="@(T("Vendas do ano (histórico da equipe, empresa toda, por mês de faturamento)", "Sales for the year (team history, company-wide, by billing month)") + (dV is not null ? T(" · variação contra os mesmos meses do ano anterior", " · change vs the same months of the previous year") : ""))">
                                <span>@T("Vendido no ano", "Sold in the year")@(rv is { UltimoMes: > 0 and < 12 } ? $" ({T("até", "through")} {MesCurtoFrase(rv.UltimoMes)})" : "")</span>
                                <b>@(rv is { MesesComVendas: > 0 } ? Mi(rv.Vendas) : "—")</b>
                                @if (dV is not null) { <em class="@DeltaCls(dV)">@Seta(dV)</em> }
                            </div>
                            <div class="vp-cc-barra" title="@($"{T("Ganhas", "Won")} {N0(c.G)} · {T("Perdidas", "Lost")} {N0(c.P)} · {T("Abertas", "Open")} {N0(c.A)}" + (c.NC > 0 ? $" · {T("Não classificadas", "Unclassified")} {N0(c.NC)}" : ""))">
                                <i style="width:@F(c.G * 100.0 / baseBarra)%;background:#1f9254"></i><i style="width:@F(c.P * 100.0 / baseBarra)%;background:#6FB3DC"></i><i style="width:@F(c.A * 100.0 / baseBarra)%;background:#007A9E"></i><i style="width:@F(c.NC * 100.0 / baseBarra)%;background:#c3ccd8"></i>
                            </div>
                            <div class="vp-cc-linhas">
                                <span>@T("Propostas enviadas", "Proposals sent")</span><b>@N0(c.Total)</b>
                                <span><i style="background:#1f9254"></i>@T("Ganhas", "Won")</span><b>@N0(c.G)</b>
                                <span><i style="background:#6FB3DC"></i>@T("Perdidas", "Lost")</span><b>@N0(c.P)</b>
                                <span><i style="background:#007A9E"></i>@T("Abertas", "Open")</span><b>@N0(c.A)</b>
                            </div>
                        </button>
                    }
                </div>
                <div class="vp-cc-leg"><span><i style="background:#1f9254"></i>@T("Ganhas", "Won")</span><span><i style="background:#6FB3DC"></i>@T("Perdidas", "Lost")</span><span><i style="background:#007A9E"></i>@T("Abertas", "Open")</span><span>@T("Variação em pontos percentuais contra o mesmo período do ano anterior · clique num ano para colocá-lo em foco", "Change in percentage points vs the same period of the previous year · click a year to bring it into focus")</span></div>
                <p class="cvx-note" style="margin-top:8px">@T("Propostas", "Proposals"): @_fonte. @T("Cada número de proposta conta uma vez, no mês da data de envio.", "Each proposal number counts once, in the month of its send date.")</p>
            </div>

            @* ano a ano por setor (AFM × NB) e os valores: o que antes ficava embaixo dos cartões da taxa *@
            <div class="panel vp-principal" id="setores">
                <div class="panel-head">
                    <div class="panel-title">@T("AFM × NB e valores, ano a ano", "AFM × NB and values, year by year")
                        <span class="hint">@T("AFM = planilha de Aftermarket · NB = planilha de New Business · valores em", "AFM = Aftermarket spreadsheet · NB = New Business spreadsheet · values in") @Sim · @T("taxa", "rate"): @RegraTxt@(_setor != "" ? " · " + _setor : "")</span>
                    </div>
                </div>
                <div class="vp-conv-grid vp-setores">
                    @foreach (var a in AnosDoPainel)
                    {
                        var ano = a;
                        var limC = MesLimite(a);
                        var l = Linha(a);
                        var r = _anos.FirstOrDefault(x => x.Ano == a);
                        var dVal = a - 1 >= AnoIni && l.SemTaxa == 0 ? DeltaCurto(ValorAte(a, limC), ValorAte(a - 1, limC)) : null;
                        var dVen = a - 1 >= AnoIni && r is { MesesComVendas: > 0 } ? DeltaCurto(r.Vendas, ConversaoDeVendas.AteOMes(_meses, a - 1, r.UltimoMes)) : null;
                        var sa = PorSetor(a, ConversaoService.Afm); var sn = PorSetor(a, ConversaoService.Nb); var totSet = Math.Max(1, sa.Total + sn.Total);
                        <button type="button" class="vp-conv-card @(a == foco.Ano ? "foco" : "")" style="--ac:@CorDoAno(a)" @onclick="() => { _foco = ano; _dica = null; }">
                            <div class="vp-cc-ano">@a@if (a == DateTime.Today.Year) { <small>@T("até", "through") @MesCurtoFrase(limC)</small> }</div>
                            @{ var pa = sa.Total * 100.0 / totSet; var pn = sn.Total * 100.0 / totSet; }
                            <div class="vp-cc-setor" title="@T("AFM = planilha de Aftermarket · NB = planilha de New Business", "AFM = Aftermarket spreadsheet · NB = New Business spreadsheet")">
                                <div class="vp-cs-barra grossa">
                                    @if (sa.Total + sn.Total > 0)
                                    {
                                        <i style="width:@F(pa)%;background:@CorAfm" title="AFM: @N0(sa.Total) @T("propostas", "proposals") (@Math.Round(pa)% @T("das enviadas", "of those sent"))">@(pa >= 22 ? $"AFM {Math.Round(pa)}%" : pa >= 12 ? Math.Round(pa) + "%" : "")</i><i style="width:@F(pn)%;background:@CorNb" title="NB: @N0(sn.Total) @T("propostas", "proposals") (@Math.Round(pn)% @T("das enviadas", "of those sent"))">@(pn >= 22 ? $"NB {Math.Round(pn)}%" : pn >= 12 ? Math.Round(pn) + "%" : "")</i>
                                    }
                                </div>
                                <div class="vp-cs-grade">
                                    <span></span><b class="cab"><i style="background:@CorAfm"></i>AFM</b><b class="cab"><i style="background:@CorNb"></i>NB</b>
                                    <span>@T("Taxa", "Rate")</span><b class="tx">@(sa.Taxa is double ta ? P1(ta) : "—")</b><b class="tx">@(sn.Taxa is double tn ? P1(tn) : "—")</b>
                                    <span>@T("Propostas", "Proposals")</span><b>@N0(sa.Total)</b><b>@N0(sn.Total)</b>
                                    <span>@T("Ganhas", "Won")</span><b>@N0(sa.G)</b><b>@N0(sn.G)</b>
                                    <span>@T("Valor enviado", "Value sent")</span><b title="@(sa.Valor > 0 ? Cheio(sa.Valor) : "")">@(sa.Valor > 0 ? MiEixo(sa.Valor) : "—")@if (sa.SemTaxa > 0) { <em class="vp-parcial" title="@N0(sa.SemTaxa) @T("proposta(s) sem taxa de câmbio do ano", "proposal(s) without the year's exchange rate")">@T("parcial", "partial")</em> }</b><b title="@(sn.Valor > 0 ? Cheio(sn.Valor) : "")">@(sn.Valor > 0 ? MiEixo(sn.Valor) : "—")</b>
                                </div>
                            </div>
                            <div class="vp-cc-valor">
                                <span>@T("Valor enviado", "Value sent")</span><b>@(l.Valor is decimal vv ? Mi(vv) : "—")@if (l.SemTaxa > 0) { <em class="vp-parcial" title="@N0(l.SemTaxa) @T("proposta(s) do AFM sem taxa de câmbio do ano: fora do valor", "AFM proposal(s) without the year's exchange rate: left out of the value")">@T("parcial", "partial")</em> } else if (dVal is not null) { <em class="@DeltaCls(dVal)">@Seta(dVal)</em> }</b>
                                <span>@T("Valor médio", "Average value")</span><b>@(l.Valor is decimal vm2 && l.ComValor > 0 ? Mi(vm2 / l.ComValor) : "—")</b>
                                <span>@T("Vendas", "Sales")@(r is { UltimoMes: > 0 and < 12 } ? $" ({T("até", "through")} {MesCurtoFrase(r.UltimoMes)})" : "")</span><b>@(r is { MesesComVendas: > 0 } ? Mi(r.Vendas) : "—")@if (dVen is not null) { <em class="@DeltaCls(dVen)">@Seta(dVen)</em> }</b>
                            </div>
                        </button>
                    }
                </div>
                <div class="vp-cc-leg"><span><i style="background:@CorAfm"></i>AFM</span><span><i style="background:@CorNb"></i>NB</span><span>@T("Barra: divisão das propostas enviadas entre AFM e NB · “parcial” = há propostas do AFM sem taxa de câmbio do ano · variação contra o mesmo período do ano anterior · clique num ano para colocá-lo em foco", "Bar: split of proposals sent between AFM and NB · “partial” = some AFM proposals lack the year's exchange rate · change vs the same period of the previous year · click a year to bring it into focus")</span></div>
            </div>

            @{
                var pctGrupo = foco.PctGrupo; var pctHsa = foco.PctHsa;
            }
            <div class="panel vp-principal" id="metas">
                <div class="panel-head">
                    <div class="panel-title">@T("Vendas totais × metas, ano a ano", "Total sales × targets, year by year")
                        <span class="hint">@T("vendas da empresa × Meta Grupo e Meta HSA", "company sales × Group Target and HSA Target") · @Sim · @Periodo</span>
                    </div>
                    <div class="rep-attain-group">
                        <div class="rep-attain-box">
                            <span class="ra-label">@T("Atend. Meta Grupo", "Group Target attainment") (@foco.Ano)</span>
                            <span class="ra-value" style="color:#172B43">@(pctGrupo is decimal pg0 ? Pct(pg0) : "—")</span>
                        </div>
                        <div class="rep-attain-box">
                            <span class="ra-label">@T("Atend. Meta HSA", "HSA Target attainment") (@foco.Ano)</span>
                            <span class="ra-value" style="color:#172B43">@(pctHsa is decimal ph0 ? Pct(ph0) : "—")</span>
                        </div>
                    </div>
                </div>
                <div class="vp-met">
                    <div class="vp-cores-wrap">
                        <button class="btn-ghost vp-btn-cores" aria-expanded="@(_editCoresMetas ? "true" : "false")" @onclick="() => _editCoresMetas = !_editCoresMetas">🎨 @T("Cores das barras", "Bar colors")</button>
                        @if (_editCoresMetas)
                        {
                            <div class="flt-multi-backdrop" @onclick="() => _editCoresMetas = false"></div>
                            <div class="vp-cores-pop" role="dialog" aria-label="@T("Cores das barras", "Bar colors")">
                                <div class="vp-cores-tit">@T("Cor da barra e das metas", "Color of the bar and the targets")</div>
                                @foreach (var sm in SeriesMetas)
                                {
                                    var chave = sm.Chave;
                                    <label class="vp-cor-lin"><input type="color" value="@CorMeta(chave)" @onchange="e => MudarCor(chave, e.Value?.ToString())" /><span>@NomeSerieMeta(chave, sm.Nome)</span></label>
                                }
                                <div class="vp-cores-pe">
                                    <button class="btn-link" disabled="@(!SeriesMetas.Any(x => Editaveis.ContainsKey(x.Chave)))" @onclick="() => RestaurarCores(SeriesMetas.Select(x => x.Chave))">@T("Restaurar cores padrão", "Restore default colors")</button>
                                    <button class="btn-primary" @onclick="() => _editCoresMetas = false">@T("Concluir", "Done")</button>
                                </div>
                                <div class="vp-cores-nota">@NotaCores</div>
                            </div>
                        }
                    </div>
                    <span class="cvx-note">@(foco.UltimoMes is > 0 and < 12 ? (En ? $"{foco.Ano} through {NomeDoMesFrase(foco.UltimoMes)} (sales up to the last closed month). " : $"{foco.Ano} até {NomeDoMesFrase(foco.UltimoMes)} (vendas até o último mês fechado). ") : "")@T("A barra é o vendido; os traços, onde ficam as metas. Clique num ano para colocá-lo em foco.", "The bar is what was sold; the marks show where the targets are. Click a year to bring it into focus.")</span>
                </div>
                @MetasExecutivo(foco.Ano)
            </div>

        </section>

        @* ================= conversão: BU, mercado | produto, país, perdas e base (componente da guia Conversão) ================= *@
        <Conversao Embutido="true" Parte="secoes" Filtros="_fil" FiltrosMudaram="AoMudarFiltros" LinhasVisiveis="5" />

        @* ================= 3 · VENDAS × BUDGET ================= *@
        <section id="budget" class="cvx-sec">
            <div class="xsec"><span class="xsec-t">@T("Vendas × budget", "Sales × budget")</span><span class="xsec-s">@T($"O ritmo de {foco.Ano} contra os anos anteriores e os budgets HSA e Grupo", $"The pace of {foco.Ano} against previous years and the HSA and Group budgets")</span><span class="xsec-line"></span></div>
            <div>
                @{ var ac = Acumulado(foco); }
                <div class="cvx-card">
                    <div class="cvx-ch"><div><h3 class="cvx-h3">@T("Acumulado no ano", "Year to date")</h3><p>@T("Vendas somadas mês a mês", "Sales added up month by month")</p></div></div>
                    <div class="cvx-leg" style="margin:0 0 6px">
                        <span><i class="cvx-ln" style="border-top-color:@CorFoco"></i>@foco.Ano</span>
                        @if (AnoVisivel(anoAnt) && _anos.Any(a => a.Ano == anoAnt && a.MesesComVendas > 0)) { <span><i class="cvx-ln dash" style="border-top-color:@CorAnterior"></i>@anoAnt</span> }
                        <span><i class="cvx-ln" style="border-top-color:@CorOutros"></i>@T("outros anos", "other years")</span>
                        <span><i class="cvx-ln" style="border-top-color:#172B43;border-top-width:1.5px"></i>@T("budget HSA", "HSA budget")</span>
                        <span><i class="cvx-ln dash" style="border-top-color:#8493A3;border-top-width:1.5px"></i>@T("budget Grupo", "Group budget")</span>
                    </div>
                    <div class="vp-grafico" @onmouseleave='() => SairDe("ac")'>
                        <svg viewBox="0 0 @F(ac.W) @F(ac.H)" role="img" aria-label="@T($"Vendas acumuladas por mês, por ano, e os budgets de {foco.Ano}", $"Cumulative sales by month, by year, and the {foco.Ano} budgets")">
                            @foreach (var (v, y) in ac.Ticks)
                            {
                                <g>
                                <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(y)" y2="@F(y)" stroke="@(v == 0 ? "#d3dcea" : "#edf1f6")" />
                                <text x="@F(ac.X0 - 8)" y="@F(y + 4)" text-anchor="end" class="vp-eixo">@Eixo(v)</text>
                                </g>
                            }
                            @for (var m = 1; m <= 12; m++)
                            {
                                <g><text x="@F(ac.Xm(m))" y="@F(ac.Base + 18)" text-anchor="middle" class="vp-eixo">@MesCurto(m).ToUpperInvariant()</text></g>
                            }
                            @if (foco.BudgetGrupo is decimal bg)
                            {
                                <g>
                                <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(ac.Y(bg))" y2="@F(ac.Y(bg))" stroke="#8493A3" stroke-dasharray="6 4" />
                                <text x="@F(ac.W - 104)" y="@F(ac.Y(bg) + 4)" class="vp-meta-rot">@T("Grupo", "Group") @MiEixo(bg)</text>
                                </g>
                            }
                            @if (foco.BudgetHsa is decimal bh)
                            {
                                <g>
                                <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(ac.Y(bh))" y2="@F(ac.Y(bh))" stroke="#172B43" />
                                <text x="@F(ac.W - 104)" y="@F(ac.Y(bh) + 4)" class="vp-meta-rot forte">HSA @MiEixo(bh)</text>
                                </g>
                            }
                            @foreach (var s in ac.Series.OrderBy(s => s.Ano == foco.Ano ? 2 : s.Ano == anoAnt ? 1 : 0))
                            {
                                var cor = s.Ano == foco.Ano ? CorFoco : s.Ano == anoAnt ? CorAnterior : CorOutros;
                                <g>
                                <polyline points="@s.Pontos" fill="none" stroke="@cor" stroke-width="@(s.Ano == foco.Ano ? "3.5" : "2.2")" stroke-dasharray="@(s.Ano == anoAnt ? "6 4" : "")" stroke-linejoin="round" stroke-linecap="round" />
                                @if (s.Ano == foco.Ano || s.Ano == anoAnt)
                                {
                                    <g>
                                    <circle cx="@F(s.FimX)" cy="@F(s.FimY)" r="5" fill="@cor" stroke="#fff" stroke-width="2" />
                                    <text x="@F(s.FimX + 9)" y="@F(s.FimY + (s.Ano == foco.Ano ? 4 : 14))" class="vp-rotulo" fill="@cor">@s.Ano · @MiEixo(s.Fim)</text>
                                    </g>
                                }
                                </g>
                            }
                            @if (_dica?.Grafico == "ac" && _dica.Mes is int mc)
                            {
                                <g><line x1="@F(ac.Xm(mc))" x2="@F(ac.Xm(mc))" y1="@F(ac.Topo)" y2="@F(ac.Base)" stroke="#9aa4b2" /></g>
                            }
                            @for (var m = 1; m <= 12; m++)
                            {
                                var mes = m;
                                <g>
                                <rect x="@F(ac.Xm(m) - ac.Passo / 2)" y="@F(ac.Topo)" width="@F(ac.Passo)" height="@F(ac.Base - ac.Topo)" fill="transparent"
                                      @onmouseenter="() => DicaDoAcumulado(mes, ac, foco.Ano)" />
                                </g>
                            }
                        </svg>
                        @Dica("ac")
                    </div>
                </div>

            </div>

            @{
                var representativos = _anos.Where(a => a.Representativo).ToList();
                var referencia = representativos.Where(a => a.Ano < foco.Ano).OrderByDescending(a => a.Ano).FirstOrDefault()
                                 ?? representativos.FirstOrDefault(a => a.Ano == foco.Ano) ?? representativos.LastOrDefault();
            }
            @if (referencia is not null && referencia.VendaPorProposta is decimal vpr && foco.BudgetHsa is decimal bhs)
            {
                var necessarias = (int)Math.Ceiling(bhs / vpr);
                var faltam = Math.Max(0m, bhs - foco.Vendas);
                <div class="cvx-insight static">
                    @if (En)
                    {
                        <small>How many proposals the @foco.Ano HSA budget calls for</small>
                        @:In <b>@referencia.Ano</b>, each proposal sent corresponded, on average, to <b>@Mi(vpr)</b> in sales (all sources).
                        @:At the same pace, the @foco.Ano HSA budget (@Mi(bhs)) calls for <b>≈ @N0(necessarias) proposals</b>@(faltam > 0 ? $"; {Mi(faltam)} to go, ≈ {N0((int)Math.Ceiling(faltam / vpr))} proposals." : " — budget achieved.")
                    }
                    else
                    {
                        <small>Quantas propostas o budget HSA @foco.Ano pede</small>
                        @:Em <b>@referencia.Ano</b>, cada proposta enviada correspondeu, em média, a <b>@Mi(vpr)</b> em vendas (todas as origens).
                        @:No mesmo ritmo, o budget HSA de @foco.Ano (@Mi(bhs)) pede <b>≈ @N0(necessarias) propostas</b>@(faltam > 0 ? $"; faltam {Mi(faltam)}, ≈ {N0((int)Math.Ceiling(faltam / vpr))} propostas." : " — budget atingido.")
                    }
                </div>
            }
        </section>

        @* ================= 4 · MÊS × ANO ================= *@
        @{
            var anosTabela = _anos.Where(a => AnoVisivel(a.Ano) && (a.MesesComVendas > 0 || a.BudgetHsa is not null)).Select(a => a.Ano).ToList();
            var completos = _anos.Where(a => a.MesesComVendas == 12 && AnoVisivel(a.Ano)).Select(a => a.Ano).ToList();
            var maxMes = _meses.Where(m => m.Vendas is > 0).Select(m => m.Vendas!.Value).DefaultIfEmpty(1m).Max();
        }
        <section id="mes-ano" class="cvx-sec">
            <div class="xsec"><span class="xsec-t">@T("Vendas mês × ano", "Sales month × year")</span><span class="xsec-s">@T("Como a planilha da equipe · quanto mais escuro, maior a venda do mês", "Like the team spreadsheet · the darker, the higher the month's sales")</span><span class="xsec-line"></span></div>
            <div class="cvx-card">
                <div class="cvx-ch">
                    <div><p>@T("A média é dos anos fechados", "The average is over closed years") (@(completos.Count > 0 ? $"{completos.Min()}–{completos.Max()}" : "—")).@(_vSetor.Count > 0 ? T(" Nos anos com NB e AFM, o total do mês é a soma dos dois.", " In years with NB and AFM, the month total is the sum of both.") : "")</p></div>
                    @if (_vSetor.Count > 0)
                    {
                        <div class="cvx-seg-ctl" role="group" aria-label="@T("NB e AFM", "NB and AFM")">
                            <button class="@(!_mesAnoSep ? "on" : "")" @onclick="() => _mesAnoSep = false">@T("Só o total", "Total only")</button>
                            <button class="@(_mesAnoSep ? "on" : "")" @onclick="() => _mesAnoSep = true">@T("Separar NB e AFM", "Split NB and AFM")</button>
                        </div>
                    }
                    <div class="vp-escala" aria-hidden="true"><span>@T("menor", "lowest")</span>@foreach (var c in Rampa) { <i style="background:@c"></i> }<span>@T("maior", "highest")</span></div>
                </div>
                <table class="vp-tabela">
                    <thead>
                        <tr>
                            <th>@T("Mês", "Month")</th>
                            @foreach (var a in anosTabela) { <th class="r @(a == foco.Ano ? "foco" : "")">@a</th> }
                            <th class="r vp-media">@T("Média", "Average")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var mes = m;
                            <tr>
                                <th>@NomeDoMes(m)</th>
                                @foreach (var a in anosTabela)
                                {
                                    var v = _meses.FirstOrDefault(x => x.Ano == a && x.Mes == mes)?.Vendas;
                                    @if (v is decimal val)
                                    {
                                        var (fundo, tinta) = CorDaCelula(val, maxMes);
                                        var sx = _mesAnoSep ? _vSetor.GetValueOrDefault((a, mes)) : null;
                                        var temSx = sx is { Nb: not null, Afm: not null };
                                        <td class="r vp-cel" style="background:@fundo;color:@tinta" title="@TituloCelMes(mes, a, val, temSx ? sx : null)">@if (val < 0) { <span aria-hidden="true">▼ </span> }@MiEixo(val)@if (temSx) { <small class="vp-cel-setor">NB @MiEixo(sx!.Nb!.Value) · AFM @MiEixo(sx.Afm!.Value)</small> }</td>
                                    }
                                    else { <td class="r vp-cel vazia">—</td> }
                                }
                                @{ var media = _meses.Where(x => completos.Contains(x.Ano) && x.Mes == mes && x.Vendas is not null).Select(x => x.Vendas!.Value).DefaultIfEmpty().Average(); }
                                <td class="r vp-media">@(completos.Count > 0 ? MiEixo(media) : "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="vp-tot"><th>Total</th>@foreach (var a in anosTabela)
                        {
                            var r = _anos.First(x => x.Ano == a);
                            var sxa = _mesAnoSep ? _vSetor.Values.Where(x => x.Ano == a && x.Nb is not null && x.Afm is not null).ToList() : new();
                            <td class="r">@MiEixo(r.Vendas)@if (sxa.Count > 0) { <small class="vp-cel-setor">NB @MiEixo(sxa.Sum(x => x.Nb!.Value)) · AFM @MiEixo(sxa.Sum(x => x.Afm!.Value))</small> }</td>
                        }<td class="r vp-media">@(completos.Count > 0 ? MiEixo(_anos.Where(x => completos.Contains(x.Ano)).Average(x => x.Vendas)) : "—")</td></tr>
                        <tr><th>@T("Budget HSA", "HSA budget")</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@(r.BudgetHsa is decimal b ? MiEixo(b) : "—")</td> }<td></td></tr>
                        <tr><th>@T("% do budget HSA", "% of HSA budget")</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@MedidorFino(r.PctHsa)</td> }<td></td></tr>
                        <tr><th>@T("Budget Grupo", "Group budget")</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@(r.BudgetGrupo is decimal b ? MiEixo(b) : "—")</td> }<td></td></tr>
                        <tr><th>@T("% do budget Grupo", "% of Group budget")</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@MedidorFino(r.PctGrupo)</td> }<td></td></tr>
                    </tfoot>
                </table>
            </div>
        </section>

        @if (_editando)
        {
            <section id="editar" class="cvx-sec">
                <div class="xsec"><span class="xsec-t">@T("Atualizar dados", "Edit data")</span><span class="xsec-s">@T("Digite os valores por mês (sempre em R$ cheios, mesmo com a tela em US$; ex.: 33.253.000) ou importe a planilha no layout da equipe: coluna \"Mês\" e uma coluna por ano", "Type the values per month (always in whole R$, even with the screen in US$; Brazilian format, e.g. 33.253.000) or import the spreadsheet in the team layout: a \"Mês\" (month) column and one column per year")</span><span class="xsec-line"></span></div>
                <div class="cvx-card">
                    <div class="cvx-ch">
                        <div class="cvx-seg-ctl">
                            @foreach (var (cod, nome) in new[] { ("vendas", T("Vendas", "Sales")), ("vnb", T("Vendas NB", "NB sales")), ("vafm", T("Vendas AFM", "AFM sales")), ("propostas", T("Propostas enviadas", "Proposals sent")), ("valor", T("Valor enviado", "Value sent")), ("budgets", "Budgets") })
                            {
                                var c = cod;
                                <button class="@(_aba == c ? "on" : "")" @onclick="() => _aba = c">@nome</button>
                            }
                        </div>
                    </div>
                    @if (_aba == "budgets")
                    {
                        <table class="cvx-tbl vp-ed">
                            <thead><tr><th>@T("Ano", "Year")</th><th class="r">@T("Budget HSA (R$)", "HSA budget (R$)")</th><th class="r">@T("Budget Grupo (R$)", "Group budget (R$)")</th></tr></thead>
                            <tbody>
                                @foreach (var a in _anosEditor)
                                {
                                    var ano = a;
                                    var b = _budgets.FirstOrDefault(x => x.Ano == ano);
                                    <tr>
                                        <td><b>@a</b></td>
                                        <td class="r"><input class="cell num" value="@Campo(b?.Hsa)" @onchange="e => MudarBudget(ano, true, e)" /></td>
                                        <td class="r"><input class="cell num" value="@Campo(b?.Grupo)" @onchange="e => MudarBudget(ano, false, e)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <table class="cvx-tbl vp-ed">
                            <thead><tr><th>@T("Mês", "Month")</th>@foreach (var a in _anosEditor) { <th class="r">@a</th> }</tr></thead>
                            <tbody>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    var mes = m;
                                    <tr>
                                        <td><b>@NomeDoMes(m)</b></td>
                                        @foreach (var a in _anosEditor)
                                        {
                                            var ano = a;
                                            var reg = _brutos.FirstOrDefault(x => x.Ano == ano && x.Mes == mes);
                                            var sist = _meses.FirstOrDefault(x => x.Ano == ano && x.Mes == mes);
                                            var valor = _aba switch
                                            {
                                                "vendas" => Campo(reg?.Vendas), "propostas" => reg?.Propostas?.ToString(Br) ?? "",
                                                "vnb" => Campo(_vSetorBrl.GetValueOrDefault((ano, mes))?.Nb), "vafm" => Campo(_vSetorBrl.GetValueOrDefault((ano, mes))?.Afm),
                                                _ => Campo(reg?.ValorProposto),
                                            };
                                            var dica = reg?.Propostas is null && sist?.FonteDasPropostas == "sistema"
                                                ? _aba switch { "propostas" => $"{T("planilhas", "spreadsheets")}: {sist.Propostas}", "valor" => sist.ValorProposto is decimal vs ? $"{T("planilhas", "spreadsheets")}: {Campo(Math.Round(vs))}" : "", _ => "" } : "";
                                            // vendas de mês com NB e AFM: o total é a soma dos dois (edite nas abas Vendas NB / Vendas AFM)
                                            var somaSetor = _aba == "vendas" && _vSetorBrl.GetValueOrDefault((ano, mes)) is { Nb: not null, Afm: not null };
                                            <td class="r"><input class="cell num" value="@valor" placeholder="@dica" disabled="@somaSetor"
                                                title="@(somaSetor ? T("Total = NB + AFM (edite nas abas Vendas NB e Vendas AFM)", "Total = NB + AFM (edit in the NB sales and AFM sales tabs)") : null)"
                                                @onchange="e => MudarMes(ano, mes, e)" /></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_aba is "vnb" or "vafm") { <p class="cvx-note">@T("Vendas por setor do quadro \"Vendas por setor (NB e AFM)\". Na importação, a planilha tem a coluna dos meses e uma coluna por setor e ano: \"NB 2025\", \"AFM 2025\", \"NB 2026\", \"AFM 2026\"…", "Sales by sector for the \"Sales by sector (NB and AFM)\" panel. For import, the spreadsheet has the months column and one column per sector and year: \"NB 2025\", \"AFM 2025\", \"NB 2026\", \"AFM 2026\"…")</p> }
                        else if (_aba != "vendas") { <p class="cvx-note">@T("Vazio = vale a contagem das planilhas da guia Conversão (o número em cinza). Digitar um valor troca a das planilhas naquele mês.", "Empty = the count from the Conversion tab spreadsheets applies (the number in grey). Typing a value replaces the spreadsheets' figure for that month.")</p> }
                    }
                    <div class="vp-editor-pe">
                        <button class="btn-ghost" @onclick="AcrescentarAno">+ @T("ano", "year") @((_anosEditor.LastOrDefault() + 1).ToString())</button>
                        <label class="vp-drop">
                            <InputFile OnChange="Importar" accept=".xlsx,.xlsm,.xls,.csv" />
                            @if (En)
                            {
                                <span>⇪ <strong>Import spreadsheet</strong> of @(_aba switch { "propostas" => "proposals sent", "valor" => "value sent", "vnb" or "vafm" => "sales by sector (NB and AFM)", _ => "sales (with BUDGET HSA and BUDGET GRUPO)" })</span>
                            }
                            else
                            {
                                <span>⇪ <strong>Importar planilha</strong> de @(_aba switch { "propostas" => "propostas enviadas", "valor" => "valor enviado", "vnb" or "vafm" => "vendas por setor (NB e AFM)", _ => "vendas (com BUDGET HSA e BUDGET GRUPO)" })</span>
                            }
                        </label>
                    </div>
                </div>
            </section>
        }
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Br = new("pt-BR");
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    /// <summary>O projeto começa em 2022: nada antes disso entra no painel.</summary>
    private const int AnoIni = 2022;
    private static int AnoFim => DateTime.Today.Year;

    // paleta da guia Conversão: ano atual em azul-marinho, anteriores em azuis/cinzas mais claros
    private const string CorTx = "#12355B", CorFoco = "#12355B", CorAnterior = "#4F7AA8", CorOutros = "#C9D3DE", CorContexto = "#B3C0D1";
    private static readonly string[] Rampa = { "#EEF3F9", "#DCE6F1", "#C9D8EA", "#B3C7DE", "#9BB4D2", "#83A1C5", "#6B8DB7", "#5479A8", "#3F6597", "#2C5283", "#1D416D", "#12355B" };

    /// <summary>Vendas e valores informados como gravados (sempre em R$): o editor e a exportação usam estes.</summary>
    private List<MesDeVendas> _brutos = new();
    /// <summary>Vendas por setor como gravadas (R$); _vSetor é a cópia da tela (em US$ quando a moeda é dólar).</summary>
    private Dictionary<(int Ano, int Mes), VendaPorSetor> _vSetorBrl = new();
    /// <summary>Em US$: anos com vendas ou budgets mas sem taxa USD/BRL (os valores deles ficam "n/d").</summary>
    private List<int> _anosSemCambio = new();
    /// <summary>O símbolo da moeda da tela (botão "Moeda" da barra de filtros).</summary>
    private string Sim => _fil.EmDolar ? "US$" : "R$";
    /// <summary>Tela em inglês (botão "Idioma" da barra de filtros; guardado por usuário).</summary>
    private bool En => _fil.EmIngles;
    /// <summary>O texto no idioma da tela: T("Propostas enviadas", "Proposals sent").</summary>
    private string T(string pt, string en) => En ? en : pt;
    private static readonly CultureInfo EnUs = new("en-US");
    private const string ChaveIdioma = "vendas_propostas_idioma";
    private List<BudgetDoAno> _budgets = new();
    private List<ResumoDoMes> _meses = new();
    private List<ResumoDoAno> _anos = new();
    private List<ConversaoDeVendas.PropostaEnviada> _enviadas = new();
    private List<ConversaoDeVendas.PropostaEnviada> _enviadasSetor = new();
    private Dictionary<(int Ano, int Mes), PropMes> _porMes = new();
    /// <summary>As linhas das planilhas da guia Conversão (sem juntar números repetidos, como na própria guia), para a taxa de conversão.</summary>
    /// <param name="ClasseValor">a classe nas contas por valor (ajuste manual: ganha na quantidade, aberta no valor)</param>
    private sealed record LinhaConv(int Ano, int Mes, string Origem, ClasseProposta Classe, double? Brl, ClasseProposta ClasseValor, bool Aj = false);
    private List<LinhaConv> _conv = new(), _convSetor = new();
    private bool _gerandoPpt;
    private string _fonte = "";
    private int _foco;
    private bool _editando, _msgOk, _carregando;
    private string? _msg;
    private string _aba = "vendas", _met = "qtd";
    /// <summary>Filtros da guia Conversão, compartilhados com a barra e as seções embutidas.</summary>
    private readonly FiltrosConversao _fil = new() { AnoMinimo = AnoIni };
    /// <summary>
    /// "" sem filtro; senão um rótulo curto (as vendas não seguem os filtros, então as relações com elas só valem sem filtro).
    /// O filtro de Ano não conta: ele só escolhe quais anos a página mostra, não muda as propostas de cada ano.
    /// </summary>
    private string _setor => _fil.Ativos - (_fil.Anos.Count > 0 ? 1 : 0) > 0 ? T("filtrado", "filtered") : "";
    /// <summary>O ano aparece na página? (filtro de Ano vazio = todos, de 2022 até hoje)</summary>
    private string _anosFiltrados = "";
    private bool AnoVisivel(int ano) => _fil.Anos.Count == 0 || _fil.Anos.Contains(ano.ToString());
    /// <summary>Os anos da página, para os títulos: "2022 → 2026" ou os escolhidos no filtro de Ano.</summary>
    private string Periodo
    {
        get
        {
            var anos = AnosDoPainel;
            if (_fil.Anos.Count == 0 || anos.Count == 0) return $"{AnoIni} → {AnoFim}";
            return anos.Count > 2 && anos[^1] - anos[0] == anos.Count - 1 ? $"{anos[0]} → {anos[^1]}" : string.Join(", ", anos);
        }
    }
    private List<int> _anosEditor = new();
    /// <summary>Vendas mês × ano: mostra o NB e o AFM embaixo do total, nos anos que têm a divisão.</summary>
    private bool _mesAnoSep = true;
    /// <summary>O ajuste manual de ganhas (appsettings "Conversao:AjustesGanhas"), no idioma da tela.</summary>
    private string AjusteTxt()
    {
        var g = Conv.Atual.Propostas.Where(p => p.AjusteManual && p.Data is not null)
            .GroupBy(p => (p.Origem, p.Data!.Value.Year, p.Data.Value.Month)).OrderBy(x => x.Key).ToList();
        var lista = string.Join(", ", g.Select(x => $"{x.Count()} {x.Key.Origem} {x.Key.Month:00}/{x.Key.Year}"));
        // o efeito no ano do ajuste, com os filtros da tela: sem o ajuste (elas abertas) → com o ajuste (ganhas)
        var efeitos = new List<string>();
        foreach (var ano in g.Select(x => x.Key.Year).Distinct())
        {
            var l = _convSetor.Where(x => x.Ano == ano).ToList();
            var aj = l.Where(x => x.Aj).ToList();
            if (aj.Count == 0) continue;
            int gC = l.Count(x => x.Classe == ClasseProposta.Ganha), pC = l.Count(x => x.Classe == ClasseProposta.Perdida);
            double vgC = l.Where(x => x.Classe == ClasseProposta.Ganha).Sum(x => x.Brl ?? 0), vpC = l.Where(x => x.Classe == ClasseProposta.Perdida).Sum(x => x.Brl ?? 0);
            int gS = gC - aj.Count; double vgS = vgC - aj.Sum(x => x.Brl ?? 0);
            double? Q(int gg, int bb) => bb > 0 ? gg * 100.0 / bb : null;
            double? V(double vv, double bb) => bb > 0 ? vv / bb * 100 : null;
            var (bqC, bqS) = BaseTodas ? (l.Count, l.Count) : (gC + pC, gS + pC);
            var (bvC, bvS) = BaseTodas ? (l.Sum(x => x.Brl ?? 0), l.Sum(x => x.Brl ?? 0)) : (vgC + vpC, vgS + vpC);
            string P(double? x) => x is double d ? P1(d) : "—";
            efeitos.Add(T($"{ano}: por quantidade {P(Q(gS, bqS))} → {P(Q(gC, bqC))} ({N0(gS)} → {N0(gC)} ganhas); por valor {P(V(vgS, bvS))} → {P(V(vgC, bvC))} (+{Mi((decimal)aj.Sum(x => x.Brl ?? 0))} ganhos)",
                           $"{ano}: by count {P(Q(gS, bqS))} → {P(Q(gC, bqC))} ({N0(gS)} → {N0(gC)} won); by value {P(V(vgS, bvS))} → {P(V(vgC, bvC))} (+{Mi((decimal)aj.Sum(x => x.Brl ?? 0))} won)"));
        }
        return T($"{lista} proposta(s) aberta(s) contada(s) como ganha(s) — pedidos que ainda não foram lançados no CRM. Entram na conversão por quantidade e por valor (com o valor de cada proposta). Efeito, sem → com o ajuste: ",
                 $"{lista} open proposal(s) counted as won — orders not yet entered in the CRM. Included in conversion by count and by value (at each proposal's value). Effect, without → with the adjustment: ")
            + string.Join(" · ", efeitos) + ".";
    }
    private string TituloCelMes(int mes, int ano, decimal val, VendaPorSetor? sx) =>
        $"{NomeDoMes(mes)} {ano}: {Cheio(val)}" + (sx is { Nb: decimal nb, Afm: decimal af } ? $" · NB {Cheio(nb)} · AFM {Cheio(af)}" : "");
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _login = "", _usuario = "";
    private bool _editCores, _editCoresMetas;

    /// <summary>Cores escolhidas pela pessoa para cada ano (as que faltam seguem o padrão).</summary>
    private Dictionary<string, string> _cores = new();
    /// <summary>Cores-padrão de todos: as que o administrador escolheu (valem para quem não mudou as suas).</summary>
    private Dictionary<string, string> _coresPadrao = new();
    private bool _isAdmin;
    private const string ChaveCores = "vendas_propostas_cores";
    /// <summary>"Login" reservado onde fica o padrão definido pelo administrador.</summary>
    private const string LoginPadrao = "*padrao*";
    /// <summary>O que esta pessoa edita: o administrador mexe no padrão de todos; os outros, nas suas cores.</summary>
    private Dictionary<string, string> Editaveis => _isAdmin ? _coresPadrao : _cores;
    private string NotaCores => _isAdmin
        ? T("Como administrador, a cor que você escolhe vira o padrão de todos. Cada pessoa ainda pode mudar a sua.", "As an administrator, the color you pick becomes everyone's default. Each person can still change their own.")
        : T("Guardadas só para o seu login. \"Restaurar\" volta ao padrão definido pelo administrador.", "Saved only for your login. \"Restore\" goes back to the default set by the administrator.");

    /// <summary>As propostas de um mês: quantidade, valor (null = sem valor), quantas sem taxa de câmbio e quantas com valor.</summary>
    private sealed record PropMes(int Qtd, decimal? Valor, int SemTaxa, int ComValor);

    /// <summary>Um ano na tabela e nos indicadores (com o filtro de setor).</summary>
    private sealed record LinhaDoAno(int? Qtd, decimal? Valor, int SemTaxa, int ComValor, decimal? VendaPorProposta, decimal? Conversao);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var u = (await AuthState).User;
            _login = u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? u.Identity?.Name ?? "";
            _usuario = u.Identity?.Name ?? _login;   // o nome que aparece no topo da tela: vai na capa da apresentação
        }
        _isAdmin = AuthState is not null && (await AuthState).User.IsInRole("admin");
        _coresPadrao = LerCores(ChartPrefs.Get(LoginPadrao, ChaveCores).Ordem);
        _cores = LerCores(ChartPrefs.Get(_login, ChaveCores).Ordem);
        _fil.EmIngles = ChartPrefs.Get(_login, ChaveIdioma).Ordem == "en";   // o idioma escolhido fica guardado para o login
        _idiomaSalvo = _fil.EmIngles;
        if (_isAdmin)
        {
            // o administrador não tem cor própria: o que ele escolhe é o padrão. Cores que ele tinha
            // guardado só para si (antes desta regra) passam a ser o padrão, se o padrão ainda estiver vazio.
            if (_coresPadrao.Count == 0 && _cores.Count > 0) { _coresPadrao = new(_cores); GravarCores(); }
            _cores = new();
        }
        Carregar();
        _foco = AnosDoPainel.DefaultIfEmpty(AnoFim).Max();
        // as propostas vêm das planilhas da guia Conversão (leitura da rede): em segundo plano
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(false)); } catch { /* sem as planilhas, o painel mostra só as vendas */ }
        finally { _carregando = false; }
        Carregar();
        if (!AnosDoPainel.Contains(_foco)) _foco = AnosDoPainel.DefaultIfEmpty(AnoFim).Max();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("vpmAjustar"); } catch { /* página saindo */ }
    }

    private async Task Reler()
    {
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(true)); } catch { }
        finally { _carregando = false; }
        Carregar();
    }

    private void Carregar()
    {
        _brutos = VendasRepo.Meses().Where(m => m.Ano >= AnoIni).ToList();
        _budgets = VendasRepo.Budgets().Where(b => b.Ano >= AnoIni).ToList();
        _vSetorBrl = VendasRepo.PorSetor().Where(v => v.Ano >= AnoIni).ToDictionary(v => (v.Ano, v.Mes));
        // botão "Moeda": em US$, as vendas, os budgets e os valores informados (em R$) passam pela taxa USD/BRL do ano.
        // O que se edita e se exporta continua em R$ (_brutos, _budgets, _vSetorBrl); a tela usa as cópias convertidas.
        var dolar = _fil.EmDolar;
        var taxasAno = Cambio.Todas();
        // taxa da tela (digitada ao lado de US$): divide o que a tela mostraria em R$ por um número só
        var taxaTela = _fil.UsaTaxaTela ? _fil.TaxaTela!.Value : (double?)null;
        decimal? Moeda(decimal? v, int ano) => !dolar || v is null ? v
            : taxaTela is double tt ? v / (decimal)tt
            : taxasAno.TryGetValue(ano, out var t) && t > 0 ? v / (decimal)t : null;
        var brutosTela = !dolar ? _brutos : _brutos.Select(m => new MesDeVendas
            { Ano = m.Ano, Mes = m.Mes, Vendas = Moeda(m.Vendas, m.Ano), Propostas = m.Propostas, ValorProposto = Moeda(m.ValorProposto, m.Ano) }).ToList();
        var budgetsTela = !dolar ? _budgets : _budgets.Select(b => new BudgetDoAno { Ano = b.Ano, Hsa = Moeda(b.Hsa, b.Ano), Grupo = Moeda(b.Grupo, b.Ano) }).ToList();
        _vSetor = !dolar ? _vSetorBrl : _vSetorBrl.ToDictionary(kv => kv.Key, kv => new VendaPorSetor
            { Ano = kv.Value.Ano, Mes = kv.Value.Mes, Nb = Moeda(kv.Value.Nb, kv.Value.Ano), Afm = Moeda(kv.Value.Afm, kv.Value.Ano) });
        _anosSemCambio = dolar && taxaTela is null ? _brutos.Where(m => m.Vendas is not null).Select(m => m.Ano).Concat(_budgets.Select(b => b.Ano))
            .Where(a => !(taxasAno.TryGetValue(a, out var t) && t > 0)).Distinct().OrderBy(a => a).ToList() : new();
        var enviadas = new List<ConversaoDeVendas.PropostaEnviada>();
        try
        {
            if (Conv.Ok) enviadas = ConversaoDeVendas.PropostasEnviadas(Conv.Atual.Propostas.Where(p => _fil.Passa(p, ignorarAno: true)), taxasAno, dolar && taxaTela is null)
                .Where(p => p.Data.Year >= AnoIni && p.Data.Year <= AnoFim)
                .Select(p => taxaTela is double tt ? p with { ValorReais = Math.Round(p.ValorReais / (decimal)tt, 2) } : p).ToList();
        }
        catch (Exception) { /* sem as propostas, o painel mostra só as vendas */ }
        _enviadas = enviadas;
        try
        {
            // primeiro mês com propostas (sem filtros): antes dele o mês é "n/d", não zero
            var ini = Conv.Ok ? Conv.Atual.Propostas.Where(p => p.Data is DateTime d && d.Year >= AnoIni && d.Year <= AnoFim)
                .Select(p => p.Data!.Value.Year * 100 + p.Data.Value.Month).DefaultIfEmpty(int.MaxValue).Min() : int.MaxValue;
            var manual = _brutos.Where(b => b.Propostas is not null).Select(b => b.Ano * 100 + b.Mes).DefaultIfEmpty(int.MaxValue).Min();
            _mmIniPropostas = Math.Min(ini, manual);
        }
        catch { _mmIniPropostas = int.MaxValue; }
        try
        {
            var taxas = Cambio.Todas();
            _conv = !Conv.Ok ? new() : Conv.Atual.Propostas.Where(p => _fil.Passa(p, ignorarAno: true))
                .Where(p => p.Data is DateTime d && d.Year >= AnoIni && d.Year <= AnoFim)
                .Select(p => new LinhaConv(p.Data!.Value.Year, p.Data.Value.Month, p.Origem, p.Classe,
                    taxaTela is double tt2
                        ? (p.ValorBrl ?? (p.ValorUsd is double u2 && taxas.TryGetValue(p.Data.Value.Year, out var t2) ? u2 * t2 : null)) / tt2
                    : dolar
                        ? p.ValorUsd ?? (p.ValorBrl is double r && taxas.TryGetValue(p.Data.Value.Year, out var tu) && tu > 0 ? r / tu : null)
                        : p.ValorBrl ?? (p.ValorUsd is double u && taxas.TryGetValue(p.Data.Value.Year, out var t) ? u * t : null),
                    p.ClasseValor, p.AjusteManual))
                .ToList();
        }
        catch { _conv = new(); }
        _meses = ConversaoDeVendas.Meses(brutosTela, enviadas).Where(m => m.Ano >= AnoIni && m.Ano <= AnoFim).ToList();
        _anos = ConversaoDeVendas.Anos(_meses, budgetsTela);
        var informados = _brutos.Count(b => b.Propostas is not null);
        _fonte = string.Join("; ", new[]
        {
            enviadas.Count(p => p.Fonte == ConversaoService.Afm) is var s && s > 0 ? $"{N0(s)} {T("da planilha AFM", "from the AFM spreadsheet")}" : "",
            enviadas.Count(p => p.Fonte == ConversaoService.Nb) is var r && r > 0 ? $"{N0(r)} {T("da planilha NB", "from the NB spreadsheet")}" : "",
            informados > 0 ? $"{informados} {T("mês(es) informado(s) à mão", "month(s) entered by hand")}" : "",
        }.Where(x => x.Length > 0)) is { Length: > 0 } t ? t : (_carregando ? T("lendo as planilhas…", "reading the spreadsheets…") : T("nenhuma registrada ainda", "none recorded yet"));
        var anos = _brutos.Select(b => b.Ano).Concat(_budgets.Select(b => b.Ano)).Append(AnoIni).Distinct().ToList();
        _anosEditor = Enumerable.Range(AnoIni, Math.Max(anos.Max(), _anosEditor.DefaultIfEmpty(AnoIni).Max()) - AnoIni + 1).ToList();
        Montar();
    }

    private bool _idiomaSalvo;

    private void AoMudarFiltros()
    {
        if (_fil.EmIngles != _idiomaSalvo && _login != "")
        {
            _idiomaSalvo = _fil.EmIngles;
            try { ChartPrefs.Save(_login, ChaveIdioma, _fil.EmIngles ? "en" : "pt", ChartPrefsRepository.BarraPadrao); } catch { }
        }
        _dica = null;
        Carregar();
        // o filtro de Ano escolhe os anos da página: ao mudar, o ano em foco passa a ser o mais recente deles
        var anos = AnosDoPainel;
        var assinAnos = string.Join(",", _fil.Anos.OrderBy(x => x));
        if (anos.Count > 0 && (assinAnos != _anosFiltrados || !anos.Contains(_foco))) _foco = anos.Max();
        _anosFiltrados = assinAnos;
        StateHasChanged();
    }

    /// <summary>As propostas por mês com o filtro de setor. Em "Ambos", os meses informados à mão valem mais que as planilhas.</summary>
    private void Montar()
    {
        _enviadasSetor = _enviadas;   // já filtradas em Carregar
        _convSetor = _conv;
        var d = _enviadasSetor.GroupBy(p => (p.Data.Year, p.Data.Month))
            .ToDictionary(g => g.Key, g => new PropMes(g.Count(), g.Sum(p => p.ValorReais), g.Count(p => p.SemTaxa), g.Count(p => p.ValorReais > 0)));
        if (_setor == "")
            foreach (var m in _meses.Where(m => m.FonteDasPropostas == "informado" && m.Propostas is int))
                d[(m.Ano, m.Mes)] = new PropMes(m.Propostas!.Value, m.ValorProposto, 0, m.ValorProposto is > 0 ? m.Propostas.Value : 0);
        _porMes = d;
    }

    /// <summary>Todos os anos com dados (2022 em diante), sem o filtro de Ano: fixa a cor de cada ano.</summary>
    private List<int> AnosComDados =>
        Enumerable.Range(AnoIni, AnoFim - AnoIni + 1)
            .Where(a => _anos.Any(x => x.Ano == a && (x.MesesComVendas > 0 || x.Propostas is not null)) || _porMes.Keys.Any(k => k.Ano == a))
            .ToList();

    /// <summary>Os anos que a página mostra: os com dados, restritos ao filtro de Ano quando ele está ligado.</summary>
    private List<int> AnosDoPainel => AnosComDados.Where(AnoVisivel).ToList();

    private ResumoDoAno AnoDoFoco => _anos.FirstOrDefault(a => a.Ano == _foco) ?? _anos.Last();

    /// <summary>O último mês a comparar no ano: no ano corrente, o mês de hoje; nos outros, dezembro.</summary>
    private static int MesLimite(int ano) => ano == DateTime.Today.Year ? DateTime.Today.Month : 12;

    /// <summary>Base da taxa (botão "Taxa sobre" da barra de filtros): false = decididas; true = todas as propostas enviadas.</summary>
    private bool BaseTodas => _fil.BaseTodas;
    private string DenRot => BaseTodas ? T("enviadas", "sent") : T("decididas", "decided");
    /// <summary>Conversão por valor (botão "Conversão por" da barra de filtros): false = por quantidade de propostas.</summary>
    private bool PorValor => _fil.PorValor;
    private string RegraTxt => PorValor
        ? (BaseTodas ? T("Por valor: valor ganho ÷ valor de todas as propostas enviadas × 100", "By value: won value ÷ value of all proposals sent × 100") : T("Por valor: valor ganho ÷ (valor ganho + valor perdido) × 100", "By value: won value ÷ (won value + lost value) × 100"))
        : (BaseTodas ? T("Ganhas ÷ todas as propostas enviadas × 100", "Won ÷ all proposals sent × 100") : T("Ganhas ÷ (Ganhas + Perdidas) × 100", "Won ÷ (Won + Lost) × 100"));

    /// <summary>
    /// Taxa de conversão do ano (até o mês dado), com a regra da guia Conversão:
    /// decididas = Ganhas ÷ (Ganhas + Perdidas), por valor ganho ÷ (ganho + perdido);
    /// todas = Ganhas ÷ todas as propostas enviadas, por valor ganho ÷ valor total cotado.
    /// </summary>
    private (int G, int P, int Base, double? Taxa, double? TaxaValor, double? TaxaQtd) Taxa(int ano, int ateMes = 12)
    {
        var l = _convSetor.Where(x => x.Ano == ano && x.Mes <= ateMes).ToList();
        int g = l.Count(x => x.Classe == ClasseProposta.Ganha), p = l.Count(x => x.Classe == ClasseProposta.Perdida);
        double vg = l.Where(x => x.ClasseValor == ClasseProposta.Ganha).Sum(x => x.Brl ?? 0), vp = l.Where(x => x.Classe == ClasseProposta.Perdida).Sum(x => x.Brl ?? 0);
        var (b, vb) = BaseTodas ? (l.Count, l.Sum(x => x.Brl ?? 0)) : (g + p, vg + vp);
        double? tq = b > 0 ? g * 100.0 / b : null, tv = vb > 0 ? vg / vb * 100 : null;
        return (g, p, b, PorValor ? tv : tq, tv, tq);
    }

    /// <summary>Composição do ano (regra da guia Conversão): ganhas, perdidas, abertas, não classificadas, a taxa e o valor ganho.</summary>
    private (int Total, int G, int P, int A, int NC, int Base, double? Taxa, double VG, double? TaxaValor, double? TaxaQtd) Composicao(int ano)
    {
        var l = _convSetor.Where(x => x.Ano == ano).ToList();
        int g = l.Count(x => x.Classe == ClasseProposta.Ganha), p = l.Count(x => x.Classe == ClasseProposta.Perdida),
            a = l.Count(x => x.Classe == ClasseProposta.Aberta), nc = l.Count(x => x.Classe == ClasseProposta.NaoClassificada);
        double vg = l.Where(x => x.ClasseValor == ClasseProposta.Ganha).Sum(x => x.Brl ?? 0), vp = l.Where(x => x.Classe == ClasseProposta.Perdida).Sum(x => x.Brl ?? 0);
        var (b, vb) = BaseTodas ? (l.Count, l.Sum(x => x.Brl ?? 0)) : (g + p, vg + vp);
        double? tq = b > 0 ? g * 100.0 / b : null, tv = vb > 0 ? vg / vb * 100 : null;
        return (l.Count, g, p, a, nc, b, PorValor ? tv : tq, vg, tv, tq);
    }

    private const string CorAfm = "#12355B", CorNb = "#2BA59A";

    /// <summary>
    /// O ano dividido por setor (AFM ou NB): propostas, ganhas e a taxa (pela base de "Taxa sobre"),
    /// das linhas da guia Conversão; e o valor enviado, das propostas enviadas (cada número uma vez).
    /// </summary>
    private (int Total, int G, double? Taxa, decimal Valor, int SemTaxa) PorSetor(int ano, string origem)
    {
        var l = _convSetor.Where(x => x.Ano == ano && x.Origem == origem).ToList();
        int g = l.Count(x => x.Classe == ClasseProposta.Ganha), p = l.Count(x => x.Classe == ClasseProposta.Perdida);
        var b = BaseTodas ? l.Count : g + p;
        double vg = l.Where(x => x.ClasseValor == ClasseProposta.Ganha).Sum(x => x.Brl ?? 0), vp = l.Where(x => x.Classe == ClasseProposta.Perdida).Sum(x => x.Brl ?? 0);
        var vb = BaseTodas ? l.Sum(x => x.Brl ?? 0) : vg + vp;
        double? tx = PorValor ? (vb > 0 ? vg / vb * 100 : null) : (b > 0 ? g * 100.0 / b : null);
        var env = _enviadasSetor.Where(x => x.Data.Year == ano && x.Fonte == origem).ToList();
        return (l.Count, g, tx, env.Sum(x => x.ValorReais), env.Count(x => x.SemTaxa));
    }

    /// <summary>Taxa do mês no gráfico, pela base escolhida em "Taxa sobre": ganhas ÷ decididas do mês, ou ganhas ÷ todas as enviadas no mês.</summary>
    private (int Total, int G, double? Taxa) TaxaMes(int ano, int mes)
    {
        var l = _convSetor.Where(x => x.Ano == ano && x.Mes == mes).ToList();
        var g = l.Count(x => x.Classe == ClasseProposta.Ganha);
        var b = BaseTodas ? l.Count : g + l.Count(x => x.Classe == ClasseProposta.Perdida);
        return (b, g, PorValor ? TaxaValorMes(ano, mes) : b > 0 ? g * 100.0 / b : null);
    }

    private PropMes? Prop(int a, int m) => _porMes.TryGetValue((a, m), out var p) ? p : null;
    private int QtdAte(int ano, int mes) => Enumerable.Range(1, mes).Sum(m => Prop(ano, m)?.Qtd ?? 0);
    private decimal? ValorAte(int ano, int mes)
    {
        var l = Enumerable.Range(1, mes).Select(m => Prop(ano, m)).Where(p => p is not null).ToList();
        return l.Count == 0 || l.Any(p => p!.SemTaxa > 0) ? null : l.Sum(p => p!.Valor ?? 0m);
    }

    /// <summary>Valor médio por proposta de jan até o mês (valor enviado ÷ propostas com valor), para comparar períodos iguais.</summary>
    private decimal? MedioAte(int ano, int mes)
    {
        var com = Enumerable.Range(1, mes).Sum(m => Prop(ano, m)?.ComValor ?? 0);
        return ValorAte(ano, mes) is decimal v && com > 0 ? v / com : null;
    }

    private LinhaDoAno Linha(int ano)
    {
        var meses = Enumerable.Range(1, 12).Select(m => (Mes: m, P: Prop(ano, m), V: _meses.FirstOrDefault(x => x.Ano == ano && x.Mes == m)?.Vendas)).ToList();
        var com = meses.Where(x => x.P is not null).ToList();
        if (com.Count == 0) return new LinhaDoAno(null, null, 0, 0, null, null);
        var qtd = com.Sum(x => x.P!.Qtd);
        var valor = com.Any(x => x.P!.Valor is not null) ? com.Sum(x => x.P!.Valor ?? 0m) : (decimal?)null;
        var semTaxa = com.Sum(x => x.P!.SemTaxa);
        // relações só nos meses com venda e propostas (a venda de dezembro não se compara com propostas que ainda não existem)
        var ambos = com.Where(x => x.V is not null).ToList();
        var qAmbos = ambos.Sum(x => x.P!.Qtd);
        var vAmbos = ambos.Sum(x => x.V!.Value);
        var valAmbos = ambos.Sum(x => x.P!.Valor ?? 0m);
        decimal? vpp = _setor == "" && qAmbos > 0 && vAmbos > 0 ? vAmbos / qAmbos : null;   // as vendas são da empresa toda
        decimal? conv = _setor == "" && semTaxa == 0 && valAmbos > 0 ? vAmbos / valAmbos : null;
        return new LinhaDoAno(qtd, valor, semTaxa, com.Sum(x => x.P!.ComValor), vpp, conv);
    }

    private List<(int Ano, int Qtd)> AnosSemTaxa() =>
        _enviadasSetor.Where(p => p.SemTaxa).GroupBy(p => p.Data.Year).OrderBy(g => g.Key).Select(g => (g.Key, g.Count())).ToList();

    // ================= formatos =================

    /// <summary>A cultura dos números da tela: pt-BR, ou en-US com a tela em inglês.</summary>
    private CultureInfo Cul => En ? EnUs : Br;
    /// <summary>Unidade curta: pt " mi"/" bi"/" mil"; en "M"/"B"/"K" (colado ao número).</summary>
    private string Uni(string pt) => En ? pt switch { "bi" => "B", "mi" => "M", "mil" => "K", _ => pt } : " " + pt;
    private static readonly string[] NomesDosMesesEn = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    private static readonly string[] MesesCurtosEn = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

    private static string F(double v) => v.ToString("0.##", Inv);
    private string N0(int v) => v.ToString("#,##0", Cul);
    private string Pct(decimal v) => v.ToString("P1", Cul);
    private string Cheio(decimal v) => (v < 0 ? "−" : "") + Sim + " " + Math.Abs(v).ToString("#,##0", Cul);
    private string Mi(decimal v) => (v < 0 ? "−" : "") + Sim + " " + Compacto(Math.Abs(v));
    private string MiEixo(decimal v) => (v < 0 ? "−" : "") + Compacto(Math.Abs(v));
    private string Compacto(decimal a) =>
        a >= 1_000_000_000m ? (a / 1_000_000_000m).ToString("#,##0.0#", Cul) + Uni("bi")
        : a >= 1_000_000m ? (a / 1_000_000m).ToString("#,##0.0", Cul) + Uni("mi")
        : a >= 1_000m ? (a / 1_000m).ToString("#,##0", Cul) + Uni("mil") : a.ToString("#,##0", Cul);
    private string Eixo(decimal v) => (v < 0 ? "−" : "") +
        (Math.Abs(v) >= 1_000_000_000m ? (Math.Abs(v) / 1_000_000_000m).ToString("#,##0.#", Cul) + Uni("bi")
        : Math.Abs(v) >= 1_000_000m ? (Math.Abs(v) / 1_000_000m).ToString("#,##0.#", Cul) + Uni("mi") : Math.Abs(v).ToString("#,##0", Cul));
    private string NomeDoMes(int m) => En ? NomesDosMesesEn[m - 1] : VendasMensaisRepository.NomesDosMeses[m - 1];
    private string MesCurto(int m) => En ? MesesCurtosEn[m - 1] : VendasMensaisRepository.MesesCurtos[m - 1];
    /// <summary>Mês no meio da frase: em português, minúsculo ("out", "outubro"); em inglês, com maiúscula ("Oct", "October").</summary>
    private string MesCurtoFrase(int m) => En ? MesCurto(m) : MesCurto(m).ToLowerInvariant();
    private string NomeDoMesFrase(int m) => En ? NomeDoMes(m) : NomeDoMes(m).ToLowerInvariant();
    /// <summary>De janeiro até o mês: "jan–out" / "Jan–Oct".</summary>
    private string JanAte(int m) => $"{MesCurtoFrase(1)}–{MesCurtoFrase(m)}";
    /// <summary>Campo do editor ("Atualizar dados"): sempre pt-BR, porque volta a ser lido por VendasMensaisRepository.Numero.</summary>
    private static string Campo(decimal? v) => v?.ToString("#,##0.##", Br) ?? "";
    private static string Esc(string s) => System.Net.WebUtility.HtmlEncode(s);

    /// <summary>Variação contra o mesmo período do ano anterior (texto começa pelo sinal).</summary>
    private string? Delta(decimal? atual, decimal? anterior, int anoAnt) =>
        atual is decimal a && anterior is decimal b && b > 0 ? $"{(a - b) / b * 100:+0;-0;0}% {T("vs mesmo período de", "vs same period of")} {anoAnt}" : null;
    private string? Delta(int atual, int? anterior, int anoAnt) => Delta((decimal)atual, anterior, anoAnt);

    private string P1(double v) => v.ToString("0.0", Cul) + "%";
    /// <summary>Variação da taxa em pontos percentuais ("+2,1 p.p."), contra o mesmo período do ano anterior.</summary>
    private string? DeltaPp(double? atual, double? anterior, int? anoAnt) =>
        atual is double a && anterior is double b ? $"{(a - b).ToString("+0.0;-0.0;0.0", Cul)} {T("p.p.", "pp")}{(anoAnt is int y ? $" {T("vs mesmo período de", "vs same period of")} {y}" : "")}" : null;

    /// <summary>Variação curta para os cartões dos anos ("+12%").</summary>
    private static string? DeltaCurto(decimal? atual, decimal? anterior) =>
        atual is decimal x && anterior is decimal y && y > 0 ? $"{(x - y) / y * 100:+0;-0;0}%" : null;

    private static string DeltaCls(string? d) => d is null || d.StartsWith("+0") || d.StartsWith("0") ? "neu" : d.StartsWith("+") ? "pos" : "neg";
    private static string Seta(string d) => d.StartsWith("+0") || d.StartsWith("0") ? d : (d.StartsWith("+") ? "▲ " : d.StartsWith("-") ? "▼ " : "") + d;

    private RenderFragment Kpi(string rotulo, string valor, string sub, string tip, string cor, string? delta = null) =>
        @<article class="cvx-kpi" style="--kc:@cor" title="@tip">
