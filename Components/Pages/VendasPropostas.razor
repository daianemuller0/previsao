    /// <summary>
    /// Botão "Cores" de cada modo do mês a mês ("u" um ano, "c" comparar, "t" todos os anos): a cor das colunas de
    /// vendas e de propostas de cada ano, das linhas (valor enviado e conversão) e da venda negativa. Cada modo
    /// guarda as suas; sem escolha, vale o padrão (as cores dos anos). Mesma regra de gravação das outras cores.
    /// </summary>
    private RenderFragment PaletaMm(string modo, List<int> anos) => __builder =>
    {
        var chaveAberta = (_mmS ? "s" : "") + modo;   // cada quadro abre a sua (as cores são as mesmas nos dois)
        var aberto = _mmPaleta == chaveAberta;
        var porAno = modo != "t";   // nos mini-gráficos as linhas ligam os anos de um mês: uma cor para cada linha
        var nomeModo = modo switch { "u" => T("Um ano", "One year"), "c" => T("Comparar dois anos", "Compare two years"), _ => T("Todos os anos", "All years") };
        var prefixo = "m" + modo;
        <div class="vp-cores-wrap vpm-pal-wrap">
            <button class="btn-ghost vp-btn-cores" aria-expanded="@(aberto ? "true" : "false")" @onclick="() => _mmPaleta = aberto ? null : chaveAberta">🎨 @T("Cores", "Colors")</button>
            @if (aberto)
            {
                <div class="flt-multi-backdrop" @onclick="() => _mmPaleta = null"></div>
                <div class="vp-cores-pop vpm-pal" role="dialog" aria-label="@T("Cores do gráfico", "Chart colors") · @nomeModo">
                    <div class="vp-cores-tit">@T("Cores", "Colors") · @nomeModo</div>
                    <table class="vpm-pal-t">
                        <thead><tr><th></th><th>@T("Vendas", "Sales")</th><th>@T("Propostas", "Proposals")</th>@if (porAno) { <th>@T("Valor enviado", "Value sent")</th><th>@T("Conversão", "Conversion")</th> }</tr></thead>
                        <tbody>
                            @foreach (var a in anos.OrderByDescending(x => x))
                            {
                                var ano = a;
                                <tr>
                                    <th>@ano</th>
                                    @foreach (var el in porAno ? new[] { 'v', 'p', 'e', 'x' } : new[] { 'v', 'p' })
                                    {
                                        var chave = ChaveMm(modo, el, ano);
                                        <td><input type="color" value="@CorMm(modo, el, ano)" title="@($"{ano} · {NomeElMm(el)}")" @onchange="e => MudarCor(chave, e.Value?.ToString())" /></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!porAno)
                    {
                        <label class="vp-cor-lin"><input type="color" value="@CorMm(modo, 'e', 0)" @onchange="e => MudarCor(ChaveMm(modo, 'e', 0), e.Value?.ToString())" /><span>@T("Linha do valor enviado", "Value sent line")</span></label>
                        <label class="vp-cor-lin"><input type="color" value="@CorMm(modo, 'x', 0)" @onchange="e => MudarCor(ChaveMm(modo, 'x', 0), e.Value?.ToString())" /><span>@T("Linha da conversão", "Conversion line")</span></label>
                    }
                    <label class="vp-cor-lin"><input type="color" value="@CorMm(modo, 'n', 0)" @onchange="e => MudarCor(ChaveMm(modo, 'n', 0), e.Value?.ToString())" /><span>@T("Venda negativa", "Negative sales")</span></label>
                    <div class="vp-cores-pe">
                        <button class="btn-link" disabled="@(!Editaveis.Keys.Any(k => k.StartsWith(prefixo)))" @onclick="() => RestaurarCores(Editaveis.Keys.Where(k => k.StartsWith(prefixo)).ToList())">@T("Restaurar padrão", "Restore default")</button>
                        <button class="btn-primary" @onclick="() => _mmPaleta = null">@T("Concluir", "Done")</button>
                    </div>
                    <div class="vp-cores-nota">@T($"Só para \"{nomeModo}\". Sem escolha, vale a cor do ano (botão de cores do gráfico de linhas).", $"Only for \"{nomeModo}\". With no choice, the year's color applies (colors button of the line chart).") @NotaCores</div>
                </div>
            }
        </div>
    };

    /// <summary>
    /// "Um ano" e "Comparar dois anos": um gráfico só, com a mesma estrutura dos mini-gráficos de "Todos os anos",
    /// de cima para baixo: linha do valor enviado em propostas (R$) → colunas de vendas subindo da linha de base
    /// ("R$ 31,4 mi") → colunas de propostas descendo, espelhadas (quantidade) → linha tracejada da conversão do
    /// mês → meses. Um par de colunas por ano em cada mês, na cor do ano. vpmAjustar (app.js) desenha as linhas
    /// e sobe os números que se encostariam.
    /// </summary>
    private RenderFragment ComboMm(List<int> anos, int principal) => __builder =>
    {
        var dois = anos.Count == 2;
        var comp = dois ? anos[1] : 0;
        var modo = dois ? "c" : "u";
        var cv = anos.ToDictionary(a => a, a => Enumerable.Range(1, 12).Select(m => CelVenda(a, m)).ToArray());
        var cp = anos.ToDictionary(a => a, a => Enumerable.Range(1, 12).Select(m => CelProp(a, m)).ToArray());
        var escV = EscalaMmDe(cv.Values.SelectMany(x => x).Where(x => x.Tem).Select(x => (double)x.Valor), dois ? 0.3 : 0.2);
        var maxP = (double)cp.Values.SelectMany(x => x).Where(x => x.Tem && !x.Parcial).Select(x => x.Valor).DefaultIfEmpty(0m).Max();
        if (maxP <= 0) maxP = (double)cp.Values.SelectMany(x => x).Where(x => x.Tem).Select(x => x.Valor).DefaultIfEmpty(1m).Max();
        if (maxP <= 0) maxP = 1;
        <div class="vpm-graf combo @(dois ? "dois" : "um")">
            <div class="vpm-gtit">
                <b>@(_mmS ? T("Vendas por setor, propostas e conversão, mês a mês", "Sales by sector, proposals and conversion, month by month") : T("Vendas, propostas e conversão, mês a mês", "Sales, proposals and conversion, month by month"))</b>
                <span>@(dois ? $"{principal} × {comp}" : principal.ToString())@(_setor != "" ? T(" · propostas e conversão: ", " · proposals and conversion: ") + _setor : "")</span>
                <span class="vpm-gleg">@foreach (var a in anos) { <span><i style="background:@CorMm(modo, 'v', a)"></i>@a</span> }</span>
                @PaletaMm(modo, anos)
            </div>
            <div class="vpm-sm-leg sub vpm-combo-leg">
                <span><i class="sw cheia"></i>@T("colunas para cima: vendas", "upward columns: sales") (@Sim, @VendasDeMm)</span>
                <span><i class="sw clara"></i>@T("colunas para baixo: propostas enviadas (qtd)", "downward columns: proposals sent (count)")</span>
            </div>
            @if (dois)
            {
                <div class="vpm-var-cap">@T("Variação das vendas", "Sales change"), @principal × @comp</div>
                <div class="vpm-var" aria-label="@T("Variação das vendas em cada mês", "Sales change in each month")">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var a = cv[principal][m - 1]; var b = cv[comp][m - 1];
                        var pct = a.Tem && b.Tem ? VarMm(a.Valor, b.Valor) : null;
                        var dif = a.Tem && b.Tem ? a.Valor - b.Valor : (decimal?)null;
                        var pa = cp[principal][m - 1]; var pb = cp[comp][m - 1];
                        var difP = pa.Tem && pb.Tem && !pa.Parcial && !pb.Parcial ? (int)(pa.Valor - pb.Valor) : (int?)null;
                        var dica = (dif is decimal d ? $"{NomeDoMes(m)}: {T("vendas", "sales")} {DifReais(d)}" : NomeDoMes(m)) + (difP is int dp ? $" · {T("propostas", "proposals")} {DifQtd(dp)}" : "");
                        @if (pct is double p) { <span class="vpm-pill @ClsVar(p, false)" title="@dica">@PctSinal(p)</span> }
                        else if (dif is decimal d2) { <span class="vpm-pill neu" title="@dica">@DifReais(d2)</span> }
                        else { <span class="vpm-pill vazio">—</span> }
                    }
                </div>
            }
            @BandaMm("env", anos, principal)
            <div class="vpm-plot vpm-dc sobe">
                @if (escV.Zero > 0.5) { <div class="vpm-zero neg" style="bottom:@F(escV.Zero)%"></div> }
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <div class="vpm-col">
                        @foreach (var a in anos)
                        {
                            var x = cv[a][mes - 1];
                            <div class="vpm-slot" title="@($"{NomeDoMes(mes)} {a} · {T("vendas", "sales")}: {CelTxt(true, x, true)}")">
                                @if (x.Tem)
                                {
                                    var v = (double)x.Valor; var neg = v < 0;
                                    <i class="vpm-bar" style="bottom:@F(escV.Base(v))%;height:@F(Math.Max(escV.Alt(v), 0.5))%;--c:@(neg ? CorMm(modo, 'n', 0) : CorMm(modo, 'v', a))"></i>
                                    <b class="vpm-val vpm-rot @(a == principal ? "pri" : "cmp") @(neg ? "neg" : "")" style="bottom:calc(@F(neg ? escV.Base(v) : escV.Topo(v))% @(neg ? "- 20px" : "+ 3px"))">@ReaisMi(x.Valor)</b>
                                }
                                else if (x.Sit == SitMes.AApurar)
                                {
                                    <i class="vpm-bar apurar" style="bottom:@F(escV.Zero)%;height:7%"></i>
                                }
                                else
                                {
                                    <b class="vpm-val nd" style="bottom:calc(@F(escV.Zero)% + 3px)">@T("n/d", "n/a")</b>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="vpm-plot desce">
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <div class="vpm-col">
                        @foreach (var a in anos)
                        {
                            var x = cp[a][mes - 1];
                            <div class="vpm-slot" title="@($"{NomeDoMes(mes)} {a} · {T("propostas", "proposals")}: {CelTxt(false, x, true)}")">
                                @if (x.Tem)
                                {
                                    var h = Math.Min(100, Math.Max((double)x.Valor / maxP * 70, 0.6));
                                    <i class="vpm-bar @(x.Parcial ? "parcial" : "")" style="height:@F(h)%;--c:@CorMm(modo, 'p', a)"></i>
                                    <b class="vpm-lp @(a == principal ? "pri" : "cmp")" style="top:calc(@F(h)% + 3px)">@N0((int)x.Valor)@(x.Parcial ? "*" : "")</b>
                                }
                                else if (x.Sit == SitMes.AApurar)
                                {
                                    <i class="vpm-bar apurar" style="height:8%"></i>
                                }
                                else
                                {
                                    <b class="vpm-lp nd" style="top:3px">@T("n/d", "n/a")</b>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            @BandaMm("conv", anos, principal)
            @if (_mmS) { @BandaMm("convv", anos, principal) }
            <div class="vpm-meses">
                @for (var m = 1; m <= 12; m++)
                {
                    var v = cv[principal][m - 1]; var p = cp[principal][m - 1];
                    <div><b>@MesCurto(m).ToUpperInvariant()</b>@if (p.Parcial) { <small>@T("parcial", "partial")</small> } else if (v.Sit == SitMes.AApurar && p.Sit == SitMes.AApurar) { <small>@T("a apurar", "pending")</small> } else if (v.Sit == SitMes.AApurar) { <small>@T("vendas a apurar", "sales pending")</small> }</div>
                }
            </div>
        </div>
    };

    /// <summary>
    /// Faixa de linha por ano, alinhada às colunas do gráfico do mês a mês: "env" = valor enviado em propostas (R$);
    /// "conv" = taxa de conversão do mês (regra de "Taxa sobre"). Os pontos e números ficam aqui; a linha que liga
    /// os pontos de cada ano é desenhada em app.js (vpmAjustar), a partir da posição real de cada ponto.
    /// </summary>
    private RenderFragment BandaMm(string tipo, List<int> anos, int principal) => __builder =>
    {
        var env = tipo == "env";
        var porValor = tipo == "convv";   // quadro por setor: a conversão por valor, embaixo da de quantidade
        var cls = porValor ? "conv valor" : tipo;
        var modo = anos.Count == 2 ? "c" : "u";
        var el = env ? 'e' : 'x';
        double? Val(int a, int m) => env
            ? (Prop(a, m)?.Valor is decimal v && v > 0 ? (double)v : null)
            : (CelProp(a, m).Tem ? (porValor ? TaxaValorMes(a, m) : TaxaMm(a, m)) : null);
        var pts = anos.SelectMany(a => Enumerable.Range(1, 12).Select(m => (a, m, v: Val(a, m), parc: CelProp(a, m).Parcial))).ToList();
        var base0 = pts.Where(p => p.v is not null && !p.parc).Select(p => p.v!.Value).ToList();
        if (base0.Count == 0) base0 = pts.Where(p => p.v is not null).Select(p => p.v!.Value).ToList();
        double min = env ? 0 : base0.DefaultIfEmpty(0).Min(), max = base0.DefaultIfEmpty(1).Max();
        double Y(double v) => max - min < 1e-9 ? 36 : 9 + Math.Clamp((v - min) / (max - min), 0, 1.05) * 50;   // folga em cima para os números
        <div class="vpm-banda-cap @cls"><i></i>@(env ? T($"Valor enviado em propostas ({Sim})", $"Value sent in proposals ({Sim})") : porValor ? T($"Taxa de conversão do mês por valor ({RegraValorMm})", $"Monthly conversion rate by value ({RegraValorMm})") : T($"Taxa de conversão do mês ({RegraCurtaMm})", $"Monthly conversion rate ({RegraCurtaMm})"))</div>
        <div class="vpm-banda @cls vpm-dc">
            <svg class="vpm-banda-svg" aria-hidden="true"></svg>
            <div class="vpm-banda-g">
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <div class="vpm-col">
                        @foreach (var a in anos)
                        {
                            var p = pts.First(x => x.a == a && x.m == mes);
                            <div class="vpm-slot">
                                @if (p.v is double v)
                                {
                                    var y = Y(v);
                                    <i class="vpm-pt @(p.parc ? "parc" : "")" style="bottom:@F(y)%;--c:@CorMm(modo, el, a)" data-ano="@a" data-m="@mes" data-cor="@CorMm(modo, el, a)" data-pri="@(a == principal ? "1" : "")"
                                       title="@($"{NomeDoMes(mes)} {a} · {(env ? T("valor enviado ", "value sent ") + Mi((decimal)v) : (porValor ? T("conversão por valor ", "conversion by value ") : T("conversão ", "conversion ")) + P1(v))}{(p.parc ? T(" (parcial)", " (partial)") : "")}")"></i>
                                    <b class="vpm-blab vpm-rot @(a == principal ? "pri" : "cmp")" style="bottom:calc(@F(y)% + 6px)">@(env ? ReaisMi((decimal)v) : P1(v))@(p.parc ? "*" : "")</b>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    };

    /// <summary>Resumo lateral de dois anos, no período comparável (meses fechados nos dois).</summary>
    private RenderFragment ResumoComparativoMm(int a1, int a2) => __builder =>
    {
        var (mv, mp, A, B) = ResumoMm(a1, a2);
        var vV = VarMm(A.Vendas, B.Vendas);
        var vP = VarMm(A.Propostas, B.Propostas);
        double? dT = A.Taxa is double ta && B.Taxa is double tb ? ta - tb : null;
        double? dTv = A.TaxaV is double tva && B.TaxaV is double tvb ? tva - tvb : null;
        var temV = A.MesesV > 0 && B.MesesV > 0;
        var temP = A.MesesP > 0 && B.MesesP > 0;
        // venda total do ano: todos os meses lançados, sem o corte do período comparável (o ano corrente vai até o último mês lançado)
        (decimal Soma, int Ult) TotalAno(int a)
        {
            var l = Enumerable.Range(1, 12).Select(m => (m, c: CelVenda(a, m))).Where(x => x.c.Tem).ToList();
            return (l.Sum(x => x.c.Valor), l.Count > 0 ? l.Max(x => x.m) : 0);
        }
        <aside class="vpm-resumo cmp">
            <div class="vpm-rtit">@T("Resumo comparativo", "Comparison summary")</div>
            <div class="vpm-rper">@T("Vendas", "Sales")@(_mmS ? $" ({VendasDeMm})" : ""): @MesesTxt(mv) · @T("propostas e conversão", "proposals and conversion"): @MesesTxt(mp)</div>
            <div class="vpm-anos2">
                @foreach (var L in new[] { A, B })
                {
                    <div class="vpm-ano @(L.Ano == a1 ? "pri" : "")" style="--ac:@CorMm("c", 'v', L.Ano)">
                        <div class="vpm-ano-t">@L.Ano</div>
                        <div class="vpm-ano-l"><span>@T("Vendas", "Sales")</span><b title="@(L.MesesV > 0 ? Reais(L.Vendas) : "")">@(L.MesesV > 0 ? Mi(L.Vendas) : T("n/d", "n/a"))</b></div>
                        <div class="vpm-ano-l"><span>@T("Propostas", "Proposals")</span><b>@(L.MesesP > 0 ? N0(L.Propostas) : T("n/d", "n/a"))</b></div>
                        @if (_mmS)
                        {
                            <div class="vpm-ano-l"><span>@T("Conversão (qtd)", "Conversion (count)")</span><b title="@($"{N0(L.G)} {T("ganhas de", "won of")} {N0(L.Base)} {DenRot}")">@(L.Taxa is double t ? P1(t) : "—")</b></div>
                            <div class="vpm-ano-l"><span>@T("Conversão (valor)", "Conversion (value)")</span><b title="@RegraValorMm">@(L.TaxaV is double tv ? P1(tv) : "—")</b></div>
                        }
                        else
                        {
                            <div class="vpm-ano-l"><span>@T("Conversão", "Conversion")@(PorValor ? T(" (valor)", " (value)") : "")</span><b title="@(PorValor ? RegraMm : $"{N0(L.G)} {T("ganhas de", "won of")} {N0(L.Base)} {DenRot}")">@(L.Taxa is double t ? P1(t) : "—")</b></div>
                        }
                        @{ var (totAno, ultAno) = TotalAno(L.Ano); var andamento = ultAno is > 0 and < 12 && L.Ano >= DateTime.Today.Year; }
                        <div class="vpm-ano-l vpm-ano-tot" title="@(ultAno > 0 ? $"{Reais(totAno)} · {MesesTxtSemFiltro(ultAno)}" : "")">
                            <span>@T("Venda total do ano", "Total sales for the year")</span>
                            <b>@(ultAno > 0 ? Mi(totAno) : T("n/d", "n/a"))</b>
                            @if (ultAno > 0) { <small>@MesesTxtSemFiltro(ultAno)@(andamento ? T(" · ano em andamento", " · year in progress") : "")</small> }
                        </div>
                    </div>
                }
            </div>
            <div class="vpm-rtit2">@T("Variação", "Change") @a1 × @a2</div>
            <div class="vpm-varl">
                <span>@T("Vendas", "Sales")</span>
                <b class="@ClsVar(vV, false)">@(temV && vV is double x1 ? Seta(x1) + PctSinal(x1) : "—")</b>
                <em>@(temV ? DifReais(A.Vendas - B.Vendas) : "")</em>
                <span>@T("Propostas", "Proposals")</span>
                <b class="neu">@(temP && vP is double x2 ? Seta(x2) + PctSinal(x2) : "—")</b>
                <em>@(temP ? DifQtd(A.Propostas - B.Propostas) : "")</em>
                <span>@(_mmS ? T("Conversão (qtd)", "Conversion (count)") : T("Conversão", "Conversion"))</span>
                <b class="@ClsVar(dT, false)">@(dT is double x3 ? Seta(x3) + PpSinal(x3) : "—")</b>
                <em></em>
                @if (_mmS)
                {
                    <span>@T("Conversão (valor)", "Conversion (value)")</span>
                    <b class="@ClsVar(dTv, false)">@(dTv is double x4 ? Seta(x4) + PpSinal(x4) : "—")</b>
                    <em></em>
                }
            </div>
            <p class="vpm-rnota">
                @T("Mesmos meses nos dois anos", "Same months in both years")@(_fil.Meses.Count > 0 ? T(" (os do filtro Mês)", " (those in the Month filter)") : "")@((a1 == DateTime.Today.Year || a2 == DateTime.Today.Year) && MesNoFiltro(DateTime.Today.Month) ? (En ? $"; proposals and conversion up to the current month ({NomeDoMesFrase(DateTime.Today.Month)} partial, up to today); sales up to the last month entered" : $"; propostas e conversão até o mês presente ({NomeDoMesFrase(DateTime.Today.Month)} parcial, até hoje); vendas até o último mês lançado") : "").
                @T("Conversão", "Conversion"): @RegraMm.
                @T("Mais ou menos propostas não é, por si, melhora ou piora.", "More or fewer proposals is not, by itself, an improvement or a decline.")
            </p>
        </aside>
    };

    /// <summary>
    /// "Todos os anos": 12 mini-gráficos, um por mês. Em cada um, as vendas sobem da linha central
    /// (uma coluna por ano, na cor do ano) e as propostas descem espelhadas, no mesmo tom mais claro.
    /// Todos os números ficam escritos: vendas em cima; propostas e valor enviado embaixo. A escala de
    /// cada metade é a do próprio mês, para comparar os anos dentro dele.
    /// </summary>
    private RenderFragment MiniGraficosMm(List<int> anos) => __builder =>
    {
        var semProp = anos.Where(a => Enumerable.Range(1, 12).All(m => CelProp(a, m).Sit == SitMes.SemDado)).ToList();
        var semVenda = anos.Where(a => Enumerable.Range(1, 12).All(m => CelVenda(a, m).Sit == SitMes.SemDado)).ToList();
        string Curto(int a) => "'" + (a % 100).ToString("00");
        <div class="vpm-sm-leg">
            @foreach (var a in anos) { <span class="ano"><i style="background:@CorMm("t", 'v', a)"></i>@a</span> }
            @PaletaMm("t", anos)
        </div>
        <div class="vpm-sm-leg sub">
            <span><i class="sw linha"></i>@T("linha: valor enviado em propostas", "line: value sent in proposals") (@Sim)</span>
            <span><i class="sw cheia"></i>@T("colunas de cima: vendas", "upper columns: sales") (@Sim @T("mi", "M")@(_mmS ? ", " + VendasDeMm : ""))</span>
            <span><i class="sw clara"></i>@T("colunas de baixo: propostas enviadas (qtd)", "lower columns: proposals sent (count)")</span>
            <span><i class="sw conv"></i>@T("linha de baixo: taxa de conversão do mês", "bottom line: monthly conversion rate") (@RegraCurtaMm)</span>
            <span><i class="sw parcial"></i>@T("mês em andamento (parcial)", "month in progress (partial)")</span>
            <span><i class="sw neg"></i>@T("venda negativa", "negative sales")</span>
            <span class="txt">@T("— = a apurar · n/d = sem dado registrado", "— = pending · n/a = no data recorded")</span>
        </div>
        <div class="vpm-sm-grid" style="--cn:@CorMm("t", 'n', 0);--le:@CorMm("t", 'e', 0);--lx:@CorMm("t", 'x', 0)">
            @for (var m = 1; m <= 12; m++)
            {
                var mes = m;
                var cv = anos.Select(a => (a, c: CelVenda(a, mes))).ToList();
                var cp = anos.Select(a => (a, c: CelProp(a, mes))).ToList();
                // escalas do próprio mês; o mês parcial não entra no máximo
                var maxV = (double)cv.Where(x => x.c.Tem && x.c.Valor > 0).Select(x => x.c.Valor).DefaultIfEmpty(0m).Max();
                var minV = (double)cv.Where(x => x.c.Tem && x.c.Valor < 0).Select(x => x.c.Valor).DefaultIfEmpty(0m).Min();
                var maxP = (double)cp.Where(x => x.c.Tem && !x.c.Parcial).Select(x => x.c.Valor).DefaultIfEmpty(0m).Max();
                if (maxP <= 0) maxP = (double)cp.Where(x => x.c.Tem).Select(x => x.c.Valor).DefaultIfEmpty(1m).Max();
                if (maxP <= 0) maxP = 1;
                // linha do valor enviado em propostas (R$): escala do próprio mês; o mês parcial não entra no máximo
                var env = anos.Select((a, i) => (a, i, v: Prop(a, mes)?.Valor is decimal ev && ev > 0 ? ev : (decimal?)null, parc: CelProp(a, mes).Parcial)).ToList();
                var maxE = (double)env.Where(x => x.v is not null && !x.parc).Select(x => x.v!.Value).DefaultIfEmpty(0m).Max();
                if (maxE <= 0) maxE = (double)env.Where(x => x.v is not null).Select(x => x.v!.Value).DefaultIfEmpty(1m).Max();
                double Xe(int i) => (i + 0.5) / anos.Count * 100;
                double Ye(decimal v) => 12 + Math.Min(1, (double)v / maxE) * 58;   // % a partir de baixo da faixa da linha
                var trechos = new List<List<(double X, double Y)>>(); var trecho = new List<(double X, double Y)>();
                foreach (var e in env)
                {
                    if (e.v is not decimal ev2) { if (trecho.Count > 0) { trechos.Add(trecho); trecho = new(); } continue; }
                    trecho.Add((Xe(e.i), 100 - Ye(ev2)));
                }
                if (trecho.Count > 0) trechos.Add(trecho);
                // linha da taxa de conversão do mês (regra de "Taxa sobre"): escala entre a menor e a maior taxa do mês
                var conv = anos.Select((a, i) => (a, i, t: CelProp(a, mes).Tem ? TaxaMm(a, mes) : null, parc: CelProp(a, mes).Parcial)).ToList();
                var tcs = conv.Where(x => x.t is not null).Select(x => x.t!.Value).ToList();
                double tMin = tcs.DefaultIfEmpty(0).Min(), tMax = tcs.DefaultIfEmpty(0).Max();
                double Yc(double t) => tMax - tMin < 0.5 ? 45 : 14 + (t - tMin) / (tMax - tMin) * 52;
                var trechosC = new List<List<(double X, double Y)>>(); var trechoC = new List<(double X, double Y)>();
                foreach (var c in conv)
                {
                    if (c.t is not double tc) { if (trechoC.Count > 0) { trechosC.Add(trechoC); trechoC = new(); } continue; }
                    trechoC.Add((Xe(c.i), 100 - Yc(tc)));
                }
                if (trechoC.Count > 0) trechosC.Add(trechoC);
                var topoV = Math.Max(maxV, 0.0001) * 1.25;          // folga para o número em cima da coluna
                var faixaV = topoV - minV * 1.6;                     // folga para o número da venda negativa
                var zeroV = -minV * 1.6 / faixaV * 100;              // onde fica o zero das vendas (0 = na linha central)
                <div class="vpm-sm" style="--n:@anos.Count">
                    <div class="vpm-sm-t">@NomeDoMes(mes)</div>
                    <div class="vpm-sm-g">
                        <i class="vpm-sm-base"></i>
                        @if (minV < 0) { <i class="vpm-sm-zero" style="top:calc(var(--hl) + var(--hv) * @F(1 - zeroV / 100))"></i> }
                        <div class="vpm-sm-conv" aria-label="@T("Taxa de conversão do mês, por ano", "Monthly conversion rate, by year")">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                @foreach (var t in trechosC.Where(t => t.Count > 1))
                                {
                                    <polyline points="@string.Join(" ", t.Select(q => $"{F(q.X)},{F(q.Y)}"))" />
                                }
                            </svg>
                            @foreach (var c in conv.Where(x => x.t is not null))
                            {
                                var y = Yc(c.t!.Value);
                                <i class="vpm-sm-pt cv @(c.parc ? "parc" : "")" style="left:@F(Xe(c.i))%;bottom:@F(y)%"></i>
                                <b class="vpm-sm-le cv" style="left:@F(Xe(c.i))%;bottom:calc(@F(y)% + 5px)">@P1(c.t!.Value)@(c.parc ? "*" : "")</b>
                            }
                        </div>
                        <div class="vpm-sm-linha" aria-label="@T("Valor enviado em propostas, por ano", "Value sent in proposals, by year")">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                @foreach (var t in trechos.Where(t => t.Count > 1))
                                {
                                    <polyline points="@string.Join(" ", t.Select(q => $"{F(q.X)},{F(q.Y)}"))" />
                                }
                            </svg>
                            @foreach (var e in env.Where(x => x.v is not null))
                            {
                                var y = Ye(e.v!.Value);
                                <i class="vpm-sm-pt @(e.parc ? "parc" : "")" style="left:@F(Xe(e.i))%;bottom:@F(y)%"></i>
                                <b class="vpm-sm-le" style="left:@F(Xe(e.i))%;bottom:calc(@F(y)% + 5px)">@ReaisMi(e.v!.Value)@(e.parc ? "*" : "")</b>
                            }
                        </div>
                        @foreach (var a in anos)
                        {
                            var v = cv.First(x => x.a == a).c; var p = cp.First(x => x.a == a).c;
                            var pm = Prop(a, mes);
                            var cor = CorMm("t", 'v', a);
                            var txtV = v.Tem ? (v.Valor < 0 ? "−" : "") + Sim + " " + (Math.Abs(v.Valor) / 1_000_000m).ToString("#,##0.0", Cul) + Uni("mi") : v.Sit == SitMes.AApurar ? T("a apurar", "pending") : T("n/d", "n/a");
                            var txtP = p.Tem ? N0((int)p.Valor) + (p.Parcial ? T(" (parcial)", " (partial)") : "") : p.Sit == SitMes.AApurar ? T("a apurar", "pending") : T("n/d", "n/a");
                            var txtE = pm?.Valor is decimal ve && ve > 0 ? Mi(ve) + (pm.SemTaxa > 0 ? (En ? $" (partial: {pm.SemTaxa} without exchange rate)" : $" (parcial: {pm.SemTaxa} sem câmbio)") : "") : "—";
                            var porProp = v.Tem && p.Tem && !p.Parcial && p.Valor > 0 ? $"\n{(v.Valor < 0 ? "−" : "")}{Sim} {(Math.Abs(v.Valor) / p.Valor / 1000m).ToString("#,##0", Cul)}{Uni("mil")} {T("por proposta", "per proposal")}" : "";
                            <div class="vpm-sm-c" style="--c:@cor;--cp:@CorMm("t", 'p', a)" title="@($"{NomeDoMes(mes)} {a}\n{T("Vendas", "Sales")}: {txtV}\n{T("Propostas", "Proposals")}: {txtP}\n{T("Valor enviado", "Value sent")}: {txtE}\n{T("Conversão", "Conversion")}: {(conv.FirstOrDefault(x => x.a == a).t is double tcv ? P1(tcv) : "—")}{(_mmS && p.Tem && TaxaValorMes(a, mes) is double tvv ? $"\n{T("Conversão por valor", "Conversion by value")}: {P1(tvv)}" : "")}{porProp}")">
                                <div class="vpm-sm-l"></div>
                                <div class="vpm-sm-v">
                                    @if (v.Tem)
                                    {
                                        var val = (double)v.Valor;
                                        var alt = Math.Abs(val) / faixaV * 100;
                                        @if (val >= 0)
                                        {
                                            <i class="vpm-sm-bar v" style="bottom:@F(zeroV)%;height:@F(Math.Max(alt, 0.8))%"></i>
                                            <b class="vpm-sm-num" style="bottom:calc(@F(zeroV + alt)% + 2px)">@ReaisMi(v.Valor)</b>
                                        }
                                        else
                                        {
                                            <i class="vpm-sm-bar neg" style="bottom:@F(zeroV - alt)%;height:@F(alt)%"></i>
                                            <b class="vpm-sm-num neg" style="bottom:calc(@F(zeroV)% + 2px)">@ReaisMi(v.Valor)</b>
                                        }
                                    }
                                    else
                                    {
                                        <b class="vpm-sm-num vazio" style="bottom:calc(@F(zeroV)% + 2px)">@(v.Sit == SitMes.AApurar ? "—" : T("n/d", "n/a"))</b>
                                    }
                                </div>
                                <div class="vpm-sm-p">
                                    @if (p.Tem)
                                    {
                                        var h = Math.Min(60, Math.Max((double)p.Valor / maxP * 60, 0.8));
                                        <i class="vpm-sm-bar p @(p.Parcial ? "parcial" : "")" style="height:@F(h)%"></i>
                                        <span class="vpm-sm-lp" style="top:calc(@F(h)% + 2px)">
                                            <b>@N0((int)p.Valor)@(p.Parcial ? "*" : "")</b>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="vpm-sm-lp vazio" style="top:3px"><b>@(p.Sit == SitMes.AApurar ? "—" : T("n/d", "n/a"))</b></span>
                                    }
                                </div>
                                <div class="vpm-sm-cz"></div>
                                <span class="vpm-sm-ano">@Curto(a)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        string TotV(int a)
        {
            var l = Enumerable.Range(1, 12).Where(MesNoFiltro).Select(m => (m, c: CelVenda(a, m))).Where(x => x.c.Tem).ToList();
            if (l.Count == 0) return $"{a} {T("n/d", "n/a")}";
            var ult = l.Max(x => x.m);
            return $"{a} {MiCurto(l.Sum(x => x.c.Valor))}" + (ult < 12 || _fil.Meses.Count > 0 ? $" ({MesesTxt(ult)})" : "");
        }
        string TotP(int a)
        {
            var l = Enumerable.Range(1, 12).Where(MesNoFiltro).Select(m => (m, c: CelProp(a, m))).Where(x => x.c.Tem).ToList();
            if (l.Count == 0) return $"{a} {T("n/d", "n/a")}";
            var ult = l.Max(x => x.m); var parc = l.FirstOrDefault(x => x.c.Parcial);
            return $"{a} {N0((int)l.Sum(x => x.c.Valor))}" + (ult < 12 || _fil.Meses.Count > 0 ? $" ({MesesTxt(ult)}{(parc.c.Parcial ? $", {MesCurtoFrase(parc.m)} {T("parcial", "partial")}" : "")})" : "");
        }
        string TotE(int a)
        {
            var l = Enumerable.Range(1, 12).Select(m => Prop(a, m)).Where(p => p?.Valor is > 0).ToList();
            return l.Count == 0 ? $"{a} {T("n/d", "n/a")}" : $"{a} {MiRot(l.Sum(p => p!.Valor!.Value))}" + (l.Any(p => p!.SemTaxa > 0) ? T(" (parcial: sem câmbio)", " (partial: no exchange rate)") : "");
        }
        <div class="vpm-sm-tot">
            <div><b>@T("Vendas", "Sales") (@Sim @T("mi", "M")@(_mmS ? ", " + VendasDeMm : "")):</b> @string.Join(" · ", anos.Select(TotV))</div>
            <div><b>@T("Propostas", "Proposals"):</b> @string.Join(" · ", anos.Select(TotP))@(_setor != "" ? " · " + _setor : "")</div>
            <div><b>@T("Valor enviado", "Value sent") (@Sim @T("mi", "M")):</b> @string.Join(" · ", anos.Select(TotE))</div>
            @if (semProp.Count > 0 || semVenda.Count > 0)
            {
                @if (En)
                {
                    <div class="nd">@(semVenda.Count > 0 ? $"{string.Join(" and ", semVenda)}: no{(_mmS ? " sector" : "")} sales recorded. " : "")@(semProp.Count > 0 ? $"{string.Join(" and ", semProp)}: no proposals recorded (n/a, not zero)." : "") * = partial month or partial value (proposal without an exchange rate).</div>
                }
                else
                {
                    <div class="nd">@(semVenda.Count > 0 ? $"{string.Join(" e ", semVenda)}: sem vendas{(_mmS ? " por setor" : "")} registradas. " : "")@(semProp.Count > 0 ? $"{string.Join(" e ", semProp)}: sem propostas registradas (n/d, não é zero)." : "") * = mês parcial ou valor parcial (proposta sem taxa de câmbio).</div>
                }
            }
        </div>
    };

    private string RegraCurtaMm => PorValor && !_mmS
        ? (BaseTodas ? T($"por valor: {Sim} ganho ÷ {Sim} de todas as enviadas no mês", $"by value: {Sim} won ÷ {Sim} of all sent in the month") : T($"por valor: {Sim} ganho ÷ {Sim} (ganho + perdido) no mês", $"by value: {Sim} won ÷ {Sim} (won + lost) in the month"))
        : (BaseTodas ? T("por quantidade: ganhas ÷ todas as enviadas no mês", "by count: won ÷ all sent in the month") : T("por quantidade: ganhas ÷ decididas no mês", "by count: won ÷ decided in the month"));
    /// <summary>A regra da conversão do quadro mês a mês, por extenso (quantidade ou valor; decididas ou todas).</summary>
    private string RegraMm => _mmS
        ? (En ? $"by count, {(BaseTodas ? "won ÷ all proposals sent" : "won ÷ (won + lost)")}; by value, {RegraValorMm}"
              : $"por quantidade, {(BaseTodas ? "ganhas ÷ todas as propostas enviadas" : "ganhas ÷ (ganhas + perdidas)")}; por valor, {RegraValorMm}")
        : RegraTxt;
    /// <summary>A conversão por valor do mês (linha pontilhada do quadro por setor), pela base de "Taxa sobre".</summary>
    private string RegraValorMm => BaseTodas
        ? T($"{Sim} ganho ÷ {Sim} de todas as enviadas no mês", $"{Sim} won ÷ {Sim} of all sent in the month")
        : T($"{Sim} ganho ÷ {Sim} (ganho + perdido) no mês", $"{Sim} won ÷ {Sim} (won + lost) in the month");

    /// <summary>Valor em reais, curto: R$ 39.000.000 → "R$ 39 mi"; R$ 54.400.000 → "R$ 54,4 mi"; "R$ 1,2 bi".</summary>
    private string ReaisMi(decimal v)
    {
        var mi = Math.Abs(v) / 1_000_000m;
        var t = mi >= 1000 ? (mi / 1000m).ToString("#,##0.#", Cul) + Uni("bi") : mi.ToString("#,##0.#", Cul) + Uni("mi");
        return (v < 0 ? "−" : "") + Sim + " " + t;
    }

    /// <summary>R$ em milhões, curto para caber na coluna: "45,2", "421", "1,2 bi".</summary>
    private string MiRot(decimal v)
    {
        var mi = Math.Abs(v) / 1_000_000m;
        var t = mi >= 1000 ? (mi / 1000m).ToString("#,##0.0", Cul) + Uni("bi") : mi >= 100 ? mi.ToString("#,##0", Cul) : mi.ToString("#,##0.0", Cul);
        return (v < 0 ? "−" : "") + t;
    }

    /// <summary>Resumo lateral de um ano: totais dos meses fechados, média e os meses mais forte e mais fraco.</summary>
    private RenderFragment ResumoAnoMm(int a) => __builder =>
    {
        var mv = FechadoV(a); var mp = FechadoP(a);
        var (sv, nv) = SomaMm(true, a, mv);
        var (sp, np) = SomaMm(false, a, mp);
        var vendasM = Enumerable.Range(1, mv).Where(MesNoFiltro).Select(m => (m, c: CelVenda(a, m))).Where(x => x.c.Tem).ToList();
        var propsM = Enumerable.Range(1, mp).Where(MesNoFiltro).Select(m => (m, c: CelProp(a, m))).Where(x => x.c.Tem && !x.c.Parcial).ToList();
        var parcial = a == DateTime.Today.Year ? CelProp(a, DateTime.Today.Month) : default;
        var tx = Taxa(a);
        var txMm = _mmS ? tx.TaxaQtd : tx.Taxa;   // já segue "Conversão por" (no quadro por setor, quantidade; a de valor tem o seu bloco)
        <aside class="vpm-resumo um">
            <div class="vpm-rtit">@T("Resumo de", "Summary of") @a</div>
            <div class="vpm-blk">
                <span class="vpm-blk-t">@T("Vendas", "Sales")@(_mmS ? $" ({VendasDeMm})" : "") · @MesesTxt(mv)</span>
                <b class="vpm-blk-v" title="@(nv > 0 ? Reais(sv) : "")">@(nv > 0 ? Mi(sv) : T("n/d", "n/a"))</b>
                @if (nv > 0)
                {
                    var mx = vendasM.MaxBy(x => x.c.Valor); var mn = vendasM.MinBy(x => x.c.Valor);
                    <span>@T("média", "average") @Mi(sv / nv) @T("por mês", "per month")</span>
                    <span>@T("maior", "highest"): @MesCurtoFrase(mx.m) @Mi(mx.c.Valor) · @T("menor", "lowest"): @MesCurtoFrase(mn.m) @Mi(mn.c.Valor)</span>
                }
            </div>
            <div class="vpm-blk">
                <span class="vpm-blk-t">@T("Propostas enviadas", "Proposals sent") · @MesesTxt(mp)</span>
                <b class="vpm-blk-v">@(np > 0 ? N0((int)sp) : T("n/d", "n/a"))</b>
                @if (np > 0)
                {
                    var mx = propsM.MaxBy(x => x.c.Valor); var mn = propsM.MinBy(x => x.c.Valor);
                    <span>@T("média", "average") @N0((int)Math.Round(sp / np)) @T("por mês", "per month")</span>
                    <span>@T("maior", "highest"): @MesCurtoFrase(mx.m) @N0((int)mx.c.Valor) · @T("menor", "lowest"): @MesCurtoFrase(mn.m) @N0((int)mn.c.Valor)</span>
                }
                @if (parcial.Tem && parcial.Parcial && parcial.Valor > 0) { <span class="vpm-parc">@(En ? $"includes {N0((int)parcial.Valor)} in {NomeDoMesFrase(DateTime.Today.Month)} (partial, up to today)" : $"inclui {N0((int)parcial.Valor)} em {NomeDoMesFrase(DateTime.Today.Month)} (parcial, até hoje)")</span> }
            </div>
            <div class="vpm-blk">
                <span class="vpm-blk-t">@T("Conversão", "Conversion") · @(a == DateTime.Today.Year ? JanAte(DateTime.Today.Month) : JanAte(12))</span>
                <b class="vpm-blk-v">@(txMm is double t ? P1(t) : "—")</b>
                <span>@(PorValor && !_mmS ? T("por valor · ", "by value · ") + RegraMm : $"{(_mmS ? T("por quantidade · ", "by count · ") : "")}{N0(tx.G)} {T("ganhas de", "won of")} {N0(tx.Base)} {DenRot}{(_mmS ? "" : " · " + RegraTxt)}")</span>
            </div>
            @if (_mmS)
            {
                <div class="vpm-blk">
                    <span class="vpm-blk-t">@T("Conversão por valor", "Conversion by value") · @(a == DateTime.Today.Year ? JanAte(DateTime.Today.Month) : JanAte(12))</span>
                    <b class="vpm-blk-v">@(tx.TaxaValor is double tv ? P1(tv) : "—")</b>
                    <span>@RegraValorMm.Replace(T(" no mês", " in the month"), "")</span>
                </div>
            }
        </aside>
    };

    /// <summary>Matriz ano × mês (todos os anos): o número de cada mês, com a cor mais forte onde o valor é maior.</summary>
    private RenderFragment MatrizMm(bool vendas, List<int> anos) => __builder =>
    {
        var cel = anos.ToDictionary(a => a, a => Enumerable.Range(1, 12).Select(m => Cel(vendas, a, m)).ToArray());
        var max = cel.Values.SelectMany(x => x).Where(x => x.Tem && x.Valor > 0).Select(x => x.Valor).DefaultIfEmpty(1m).Max();
        var corForte = vendas ? "#1f8a4c" : "#1d4f91";   // tabela de apoio: verde = vendas, azul = propostas
        var corFraca = vendas ? "#f3faf5" : "#f2f6fc";
        <div class="vpm-mat-card">
            <div class="vpm-gtit">
                <b>@(vendas ? T("Vendas por ano e mês", "Sales by year and month") : T("Propostas enviadas por ano e mês", "Proposals sent by year and month"))</b>
                <span>@(vendas ? Sim + T(" milhões · ", " millions · ") + VendasDeMm : T("quantidade", "count") + (_setor != "" ? " · " + _setor : ""))</span>
                <span class="vpm-gleg"><span><i class="ol forte"></i>@T("mês mais forte do ano", "strongest month of the year")</span><span><i class="ol fraco"></i>@T("mês mais fraco", "weakest month")</span></span>
            </div>
            <div class="vpm-mat-wrap">
                <table class="vpm-mat">
                    <thead><tr><th>@T("Ano", "Year")</th>@for (var m = 1; m <= 12; m++) { <th>@MesCurto(m).ToUpperInvariant()</th> }<th class="tot">Total</th></tr></thead>
                    <tbody>
                        @foreach (var a in anos)
                        {
                            var linha = cel[a];
                            var fechados = linha.Select((x, i) => (x, m: i + 1)).Where(t => t.x.Tem && !t.x.Parcial).ToList();
                            var forte = fechados.Count > 1 ? fechados.MaxBy(t => t.x.Valor).m : 0;
                            var fraco = fechados.Count > 1 ? fechados.MinBy(t => t.x.Valor).m : 0;
                            var total = linha.Where(x => x.Tem).Sum(x => x.Valor);
                            var ultimo = linha.Select((x, i) => (x, m: i + 1)).Where(t => t.x.Tem).Select(t => t.m).DefaultIfEmpty(0).Max();
                            var temParc = linha.Any(x => x.Parcial);
                            <tr class="@(a == _foco ? "foco" : "")">
                                <th>@a</th>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    var x = linha[m - 1];
                                    var cls = (m == forte ? " forte" : "") + (m == fraco ? " fraco" : "");
                                    @if (x.Tem && x.Valor < 0)
                                    {
                                        <td class="neg@(cls)" title="@($"{NomeDoMes(m)} {a}: {CelTxt(vendas, x, true)}")">@CelTxt(vendas, x, false)</td>
                                    }
                                    else if (x.Tem)
                                    {
                                        var pct = (double)Math.Clamp(x.Valor / max, 0m, 1m) * 88 + 4;
                                        var estilo = $"background:color-mix(in srgb, {corForte} {F(pct)}%, {corFraca});color:{(pct > 52 ? "#fff" : "#172B43")}";
                                        <td class="@((x.Parcial ? "parc" : "") + cls)" style="@estilo" title="@($"{NomeDoMes(m)} {a}: {CelTxt(vendas, x, true)}")">@CelTxt(vendas, x, false)@(x.Parcial ? "*" : "")</td>
                                    }
                                    else
                                    {
                                        <td class="@(x.Sit == SitMes.AApurar ? "apurar" : "nd")">@CelTxt(vendas, x, false)</td>
                                    }
                                }
                                <td class="tot" title="@(vendas ? Reais(total) : N0((int)total))">
                                    @(ultimo > 0 ? (vendas ? MiCurto(total) : N0((int)total)) : T("n/d", "n/a"))
                                    @if (ultimo is > 0 and < 12 || temParc) { <small>@MesesTxt(ultimo)@(temParc ? T(" (último parcial)", " (last one partial)") : "")</small> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    };

    /// <summary>"Ver dados detalhados": os valores completos (R$ com centavos) e as quantidades exatas.</summary>
    private RenderFragment TabelaMm(string modo, List<int> anos, int principal, int? comp) => __builder =>
    {
        <div class="vpm-det-wrap">
            @if (modo == "comparar" && comp is int b)
            {
                var (mv, mp, A, B) = ResumoMm(principal, b);
                <table class="vpm-det">
                    <thead>
                        <tr><th rowspan="2">@T("Mês", "Month")</th><th colspan="4">@T("Vendas", "Sales") (@Sim@(_mmS ? ", " + VendasDeMm : ""))</th><th colspan="4">@T("Propostas enviadas", "Proposals sent")</th><th colspan="2">@(_mmS ? T("Conversão (qtd)", "Conversion (count)") : T("Conversão", "Conversion"))</th>@if (_mmS) { <th colspan="2">@T("Conversão (valor)", "Conversion (value)")</th> }</tr>
                        <tr><th>@principal</th><th>@b</th><th>@T("Diferença", "Difference")</th><th>@T("Var.", "Chg.")</th><th>@principal</th><th>@b</th><th>@T("Dif.", "Diff.")</th><th>@T("Var.", "Chg.")</th><th>@principal</th><th>@b</th>@if (_mmS) { <th>@principal</th><th>@b</th> }</tr>
                    </thead>
                    <tbody>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var va = CelVenda(principal, m); var vb = CelVenda(b, m);
                            var pa = CelProp(principal, m); var pb = CelProp(b, m);
                            var okV = va.Tem && vb.Tem; var okP = pa.Tem && pb.Tem && !pa.Parcial && !pb.Parcial;
                            var tA = TaxaMm(principal, m); var tB = TaxaMm(b, m);
                            <tr>
                                <th>@NomeDoMes(m)</th>
                                <td class="@(va.Tem && va.Valor < 0 ? "neg" : "")">@CelTxt(true, va, true)</td><td class="@(vb.Tem && vb.Valor < 0 ? "neg" : "")">@CelTxt(true, vb, true)</td>
                                <td>@(okV ? Reais(va.Valor - vb.Valor) : "—")</td><td>@(okV && VarMm(va.Valor, vb.Valor) is double x ? PctSinal(x) : "—")</td>
                                <td>@CelTxt(false, pa, true)</td><td>@CelTxt(false, pb, true)</td>
                                <td>@(okP ? DifQtd((int)(pa.Valor - pb.Valor)) : "—")</td><td>@(okP && VarMm(pa.Valor, pb.Valor) is double y ? PctSinal(y) : "—")</td>
                                <td>@(pa.Tem && tA is double t1 ? P1(t1) : "—")</td><td>@(pb.Tem && tB is double t2 ? P1(t2) : "—")</td>
                                @if (_mmS)
                                {
                                    <td>@(pa.Tem && TaxaValorMes(principal, m) is double tv1 ? P1(tv1) : "—")</td><td>@(pb.Tem && TaxaValorMes(b, m) is double tv2 ? P1(tv2) : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>@T("Período comparável", "Comparable period")<small>@T("vendas", "sales") @MesesTxt(mv) · @T("propostas", "proposals") @MesesTxt(mp)</small></th>
                            <td>@(A.MesesV > 0 ? Reais(A.Vendas) : T("n/d", "n/a"))</td><td>@(B.MesesV > 0 ? Reais(B.Vendas) : T("n/d", "n/a"))</td>
                            <td>@(A.MesesV > 0 && B.MesesV > 0 ? Reais(A.Vendas - B.Vendas) : "—")</td><td>@(VarMm(A.Vendas, B.Vendas) is double xv && A.MesesV > 0 ? PctSinal(xv) : "—")</td>
                            <td>@(A.MesesP > 0 ? N0(A.Propostas) : T("n/d", "n/a"))</td><td>@(B.MesesP > 0 ? N0(B.Propostas) : T("n/d", "n/a"))</td>
                            <td>@(A.MesesP > 0 && B.MesesP > 0 ? DifQtd(A.Propostas - B.Propostas) : "—")</td><td>@(VarMm(A.Propostas, B.Propostas) is double yp && A.MesesP > 0 ? PctSinal(yp) : "—")</td>
                            <td>@(A.Taxa is double ta1 ? P1(ta1) : "—")</td><td>@(B.Taxa is double tb2 ? P1(tb2) : "—")</td>
                            @if (_mmS) { <td>@(A.TaxaV is double tav ? P1(tav) : "—")</td><td>@(B.TaxaV is double tbv ? P1(tbv) : "—")</td> }
                        </tr>
                    </tfoot>
                </table>
            }
            else if (modo == "historico")
            {
                <table class="vpm-det">
                    <thead>
                        <tr><th rowspan="2">@T("Mês", "Month")</th>@foreach (var a in anos) { <th colspan="2">@a</th> }</tr>
                        <tr>@foreach (var a in anos) { <th>@T("Vendas", "Sales") (@Sim)</th><th>@T("Propostas", "Proposals")</th> }</tr>
                    </thead>
                    <tbody>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var mes = m;
                            <tr>
                                <th>@NomeDoMes(m)</th>
                                @foreach (var a in anos)
                                {
                                    var v = CelVenda(a, mes); var p = CelProp(a, mes);
                                    <td class="@(v.Tem && v.Valor < 0 ? "neg" : "")">@CelTxt(true, v, true)</td><td>@CelTxt(false, p, true)</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>@T("Total registrado", "Total recorded")<small>@T("inclui o mês parcial", "includes the partial month")</small></th>
                            @foreach (var a in anos)
                            {
                                var sv = Enumerable.Range(1, 12).Select(m => CelVenda(a, m)).Where(x => x.Tem).ToList();
                                var sp = Enumerable.Range(1, 12).Select(m => CelProp(a, m)).Where(x => x.Tem).ToList();
                                <td>@(sv.Count > 0 ? Reais(sv.Sum(x => x.Valor)) : T("n/d", "n/a"))</td><td>@(sp.Count > 0 ? N0((int)sp.Sum(x => x.Valor)) : T("n/d", "n/a"))</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                var a = principal;
                var mv = FechadoV(a); var mp = FechadoP(a);
                var (sv, nv) = SomaMm(true, a, mv); var (sp, np) = SomaMm(false, a, mp);
                var envF = Enumerable.Range(1, mp).Select(m => Prop(a, m)).Where(p => p is not null).ToList();
                var txAte = mp > 0 ? Taxa(a, mp) : default;
                var txF = mp > 0 ? (_mmS ? txAte.TaxaQtd : txAte.Taxa) : null;
                <table class="vpm-det">
                    <thead><tr><th>@T("Mês", "Month") @a</th><th>@T("Situação", "Status")</th><th>@T("Vendas", "Sales") (@Sim@(_mmS ? ", " + VendasDeMm : ""))</th><th>@T("Propostas enviadas", "Proposals sent")</th><th>@T("Valor enviado", "Value sent") (@Sim)</th><th>@(_mmS ? T("Conversão (qtd)", "Conversion (count)") : T("Conversão do mês", "Monthly conversion"))</th>@if (_mmS) { <th>@T("Conversão (valor)", "Conversion (value)")</th> }</tr></thead>
                    <tbody>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var v = CelVenda(a, m); var p = CelProp(a, m); var pm = Prop(a, m); var tm = TaxaMm(a, m);
                            var sit = p.Parcial ? T("parcial (em andamento)", "partial (in progress)") : v.Sit == SitMes.AApurar && p.Sit == SitMes.AApurar ? T("a apurar", "pending") : v.Tem || p.Tem ? T("fechado", "closed") : T("sem dado", "no data");
                            <tr>
                                <th>@NomeDoMes(m)</th><td class="sit">@sit</td>
                                <td class="@(v.Tem && v.Valor < 0 ? "neg" : "")">@CelTxt(true, v, true)</td>
                                <td>@CelTxt(false, p, true)</td>
                                <td>@(pm?.Valor is decimal ve && ve > 0 ? Reais(ve) + (pm.SemTaxa > 0 ? (En ? $" (partial: {pm.SemTaxa} without exchange rate)" : $" (parcial: {pm.SemTaxa} sem câmbio)") : "") : "—")</td>
                                <td>@(p.Tem && tm is double t ? P1(t) : "—")</td>
                                @if (_mmS) { <td>@(p.Tem && TaxaValorMes(a, m) is double tvm ? P1(tvm) : "—")</td> }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>@T("Meses fechados", "Closed months")<small>@T("vendas", "sales") @MesesTxt(mv) · @T("propostas", "proposals") @MesesTxt(mp)</small></th><td></td>
                            <td>@(nv > 0 ? Reais(sv) : T("n/d", "n/a"))</td><td>@(np > 0 ? N0((int)sp) : T("n/d", "n/a"))</td>
                            <td>@(envF.Count > 0 ? Reais(envF.Sum(p => p!.Valor ?? 0m)) : "—")</td><td>@(txF is double tf ? P1(tf) : "—")</td>
                            @if (_mmS) { <td>@(mp > 0 && txAte.TaxaValor is double tfv ? P1(tfv) : "—")</td> }
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    };

    // ================= gráfico 2: vendas totais × metas, ano a ano =================


    /// <summary>
    /// Vendas × metas, ano a ano, no mesmo padrão das barras da guia Conversão (taxa por unidade): uma linha por
    /// ano com os números em cima (vendido, Meta Grupo e Meta HSA com o atingido) e a barra grossa em degradê
    /// embaixo; as metas são marcas sobre a barra. O ano em foco fica destacado. Clique num ano para focá-lo.
    /// </summary>
    private RenderFragment MetasExecutivo(int focoAno) => __builder =>
    {
        var anos = _anos.Where(a => a.Ano >= AnoIni && AnoVisivel(a.Ano) && (a.MesesComVendas > 0 || a.BudgetHsa is not null || a.BudgetGrupo is not null)).OrderBy(a => a.Ano).ToList();
        if (anos.Count == 0) { <div class="empty">@T("Sem vendas nem metas cadastradas.", "No sales or targets recorded.")</div> return; }
        string cV = CorMeta("vendas"), cG = CorMeta("grupo"), cH = CorMeta("hsa");
        var max = anos.Select(a => new[] { a.Vendas, a.BudgetGrupo ?? 0m, a.BudgetHsa ?? 0m }.Max()).DefaultIfEmpty(1m).Max();
        var passo = Passo(Math.Max(max, 1m));
        var escala = Math.Ceiling(Math.Max(max, 1m) * 1.04m / passo) * passo;
        double Pc(decimal v) => (double)(Math.Max(0m, v) / escala * 100m);
        <div class="vp-bul-leg">
            <span><i class="vp-b vp-grad" style="--c:@cV"></i>@T("Vendas totais", "Total sales")</span>
            <span><i class="vp-m" style="background:@cG"></i>@T("Meta Grupo", "Group Target")</span>
            <span><i class="vp-m" style="background:@cH"></i>@T("Meta HSA", "HSA Target")</span>
        </div>
        <div class="ibar cvx-ibar vp-metas-ibar">
            @foreach (var a in anos)
            {
                var ano = a.Ano;
                var periodo = a.UltimoMes is > 0 and < 12 ? JanAte(a.UltimoMes) : "";
                <div class="ibar-item @(a.Ano == focoAno ? "xf-on" : "")" @onclick="() => { _foco = ano; _dica = null; }"
                     title="@($"{a.Ano}{(periodo != "" ? $" ({periodo})" : "")} · {T("Vendas", "Sales")} {(a.MesesComVendas > 0 ? Cheio(a.Vendas) : "—")} · {T("Meta Grupo", "Group Target")} {(a.BudgetGrupo is decimal g0 ? Cheio(g0) : "—")} · {T("Meta HSA", "HSA Target")} {(a.BudgetHsa is decimal h0 ? Cheio(h0) : "—")}")">
                    <div class="ibar-head">
                        <span class="ibar-num vp-mt-ano">@a.Ano</span>
                        @if (periodo != "") { <span class="vp-mt-per">@periodo</span> }
                        <div class="ibar-metrics">
                            <span class="vp-mt-v"><small>@T("Vendido", "Sold")</small><b class="ibar-val">@(a.MesesComVendas > 0 ? Mi(a.Vendas) : "—")</b></span>
                            <span class="ibar-sep"></span>
                            <span class="vp-mt-m"><i style="background:@cG"></i><small>@T("Meta Grupo", "Group Target")</small><b>@(a.BudgetGrupo is decimal g ? Mi(g) : "—")</b><em>@(a.PctGrupo is decimal pg ? Pct(pg) : "—")</em></span>
                            <span class="ibar-sep"></span>
                            <span class="vp-mt-m"><i style="background:@cH"></i><small>@T("Meta HSA", "HSA Target")</small><b>@(a.BudgetHsa is decimal h ? Mi(h) : "—")</b><em>@(a.PctHsa is decimal ph ? Pct(ph) : "—")</em></span>
                        </div>
                    </div>
                    <div class="vp-mt-barra">
                        <div class="ibar-track"><span class="ibar-fill" style="width:@F(a.MesesComVendas > 0 ? Pc(a.Vendas) : 0)%;--c:@cV"></span></div>
                        @if (a.BudgetGrupo is decimal bg) { <em class="vp-mt-mk" style="left:@F(Pc(bg))%;background:@cG" title="@T("Meta Grupo", "Group Target"): @Cheio(bg)"></em> }
                        @if (a.BudgetHsa is decimal bh) { <em class="vp-mt-mk" style="left:@F(Pc(bh))%;background:@cH" title="@T("Meta HSA", "HSA Target"): @Cheio(bh)"></em> }
                    </div>
                </div>
            }
            <div class="vp-mt-eixo">
                @for (var v = 0m; v <= escala; v += passo) { <em style="left:@F(Pc(v))%">@Eixo(v)</em> }
            </div>
        </div>
    };

    // ================= gráficos de vendas × budget =================

    private static (string Fundo, string Tinta) CorDaCelula(decimal v, decimal max)
    {
        if (v < 0) return ("#fdecec", "#b42318");
        var t = (double)Math.Clamp(v / max, 0m, 1m);
        var i = (int)Math.Round(t * (Rampa.Length - 1));
        return (Rampa[i], i >= 6 ? "#ffffff" : "#172B43");
    }

    /// <summary>Um passo "redondo" para o eixo (em R$), para ~4 linhas de grade.</summary>
    private static decimal Passo(decimal max)
    {
        var alvo = max / 4m;
        foreach (var p in new[] { 1e6m, 2e6m, 5e6m, 10e6m, 20e6m, 25e6m, 50e6m, 100e6m, 200e6m, 250e6m, 500e6m })
            if (p >= alvo) return p;
        return 1e9m;
    }

    private sealed record Serie(int Ano, string Pontos, double FimX, double FimY, decimal Fim);
    private sealed record GraficoAcumulado(double W, double H, double X0, double Topo, double Base, double Passo, Func<int, double> Xm, Func<decimal, double> Y,
        List<(decimal V, double Y)> Ticks, List<Serie> Series, Dictionary<int, decimal[]> Valores);

    private GraficoAcumulado Acumulado(ResumoDoAno foco)
    {
        const double W = 1100, H = 320, X0 = 64, Topo = 16, Base = 282;
        var passoX = (W - 110 - X0) / 12;
        double Xm(int m) => X0 + passoX * (m - 0.5);
        var valores = new Dictionary<int, decimal[]>();
        foreach (var a in _anos.Where(a => a.MesesComVendas > 0 && AnoVisivel(a.Ano)))
        {
            var acum = new decimal[12];
            var soma = 0m;
            for (var m = 1; m <= 12; m++)
            {
                var v = _meses.FirstOrDefault(x => x.Ano == a.Ano && x.Mes == m)?.Vendas;
                soma += v ?? 0m;
                acum[m - 1] = m <= a.UltimoMes ? soma : -1m;
            }
            valores[a.Ano] = acum;
        }
        var max = new[] { valores.Values.SelectMany(v => v).DefaultIfEmpty(0m).Max(), foco.BudgetHsa ?? 0m, foco.BudgetGrupo ?? 0m, 1m }.Max();
        var passo = Passo(max);
        var topoV = Math.Ceiling(max / passo) * passo;
        double Y(decimal v) => Base - (double)(v / topoV) * (Base - Topo);
        var ticks = new List<(decimal, double)>();
        for (var v = 0m; v <= topoV; v += passo) ticks.Add((v, Y(v)));
        var series = valores.Where(kv => kv.Value.Any(v => v >= 0)).Select(kv =>
        {
            var pts = kv.Value.Select((v, i) => (v, i)).Where(p => p.v >= 0).Select(p => $"{F(Xm(p.i + 1))},{F(Y(p.v))}").ToList();
            var ultimo = kv.Value.Select((v, i) => (v, i)).Where(p => p.v >= 0).Last();
            return new Serie(kv.Key, string.Join(" ", pts), Xm(ultimo.i + 1), Y(ultimo.v), ultimo.v);
        }).ToList();
        return new GraficoAcumulado(W, H, X0, Topo, Base, passoX, Xm, Y, ticks, series, valores);
    }

