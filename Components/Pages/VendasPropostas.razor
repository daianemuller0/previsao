@page "/vendas-propostas"
@attribute [Authorize(Roles = "admin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@inject VendasMensaisRepository VendasRepo
@inject ConversaoService Conv
@inject CambioAnualRepository Cambio
@inject IJSRuntime JS

<PageTitle>Vendas × Propostas</PageTitle>

<div class="vp">
<div class="page-head">
    <div>
        <h1>Vendas × Propostas</h1>
        <p class="subtitle">Quanto vendemos mês a mês ao longo dos anos — e quantas propostas enviamos para chegar nesse valor.</p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" @onclick="Exportar">⬇ Exportar Excel</button>
        @if (_podeEditar)
        {
            <button class="btn-primary" @onclick="() => { _editando = !_editando; _msg = null; }">@(_editando ? "✕ Fechar edição" : "✎ Atualizar dados")</button>
        }
    </div>
</div>

@if (_carregando) { <div class="vp-nota" style="margin-bottom:12px">Lendo as planilhas de propostas…</div> }
@if (_msg is not null) { <div class="@(_msgOk ? "vp-ok" : "alert-error")" style="margin-bottom:12px">@_msg</div> }

@if (_anos.Count == 0)
{
    <div class="panel empty-state"><div class="vp-vazio-tit">Sem dados de vendas</div></div>
}
else
{
    var foco = AnoDoFoco;
    var anterior = _anos.FirstOrDefault(a => a.Ano == foco.Ano - 1);
    var periodo = foco.UltimoMes > 0 && foco.UltimoMes < 12 ? $"jan–{MesCurto(foco.UltimoMes).ToLowerInvariant()}" : "ano inteiro";
    var mesmoPeriodoAnterior = anterior is null ? 0m : ConversaoDeVendas.AteOMes(_meses, anterior.Ano, foco.UltimoMes);
    var variacao = mesmoPeriodoAnterior > 0 ? foco.Vendas / mesmoPeriodoAnterior - 1m : (decimal?)null;
    var projecao = foco.MesesComVendas is > 0 and < 12 ? foco.Vendas / foco.MesesComVendas * 12m : (decimal?)null;
    var melhor = _meses.Where(m => m.Ano == foco.Ano && m.Vendas is not null).OrderByDescending(m => m.Vendas).FirstOrDefault();

    @* o filtro: o ano em foco vale para tudo abaixo *@
    <div class="vp-filtro">
        <span class="vp-filtro-rot">Ano em foco</span>
        <div class="segmented">
            @foreach (var a in _anos.Where(a => a.MesesComVendas > 0))
            {
                var ano = a.Ano;
                <button class="@(ano == _foco ? "active" : "")" @onclick="() => { _foco = ano; _dica = null; }">@ano</button>
            }
        </div>
        <span class="vp-filtro-nota">comparado com o mesmo período de @(foco.Ano - 1)</span>
    </div>

    @* ================= indicadores ================= *@
    <div class="vp-kpis">
        <div class="vp-kpi vp-hero">
            <span class="vp-kpi-rot">Vendas @foco.Ano · @periodo</span>
            <span class="vp-hero-valor">@Mi(foco.Vendas)</span>
            @if (variacao is decimal d)
            {
                <span class="vp-delta @(d >= 0 ? "sobe" : "desce")">
                    <span aria-hidden="true">@(d >= 0 ? "▲" : "▼")</span> @Pct(Math.Abs(d)) @(d >= 0 ? "acima" : "abaixo") do mesmo período de @(foco.Ano - 1) (@Mi(mesmoPeriodoAnterior))
                </span>
            }
            @if (projecao is decimal pj)
            {
                <span class="vp-kpi-sub">No ritmo do ano, @Mi(pj) até dezembro@(foco.BudgetHsa is > 0 ? $" ({Pct(pj / foco.BudgetHsa!.Value)} do budget HSA)" : "")</span>
            }
        </div>
        @Medidor($"Budget HSA {foco.Ano}", foco.Vendas, foco.BudgetHsa)
        @Medidor($"Budget Grupo {foco.Ano}", foco.Vendas, foco.BudgetGrupo)
        <div class="vp-kpi">
            <span class="vp-kpi-rot">Média por mês</span>
            <span class="vp-kpi-valor">@(foco.MesesComVendas > 0 ? Mi(foco.Vendas / foco.MesesComVendas) : "—")</span>
            @if (melhor is not null)
            {
                <span class="vp-kpi-sub">melhor mês: @NomeDoMes(melhor.Mes).ToLowerInvariant() · @Mi(melhor.Vendas!.Value)</span>
            }
        </div>
        <div class="vp-kpi">
            <span class="vp-kpi-rot">Propostas enviadas @foco.Ano</span>
            @if (foco.Propostas is int np)
            {
                <span class="vp-kpi-valor">@np.ToString("#,##0", Br)</span>
                <span class="vp-kpi-sub">@(foco.VendaPorProposta is decimal vp && foco.Representativo ? $"{Mi(vp)} vendidos por proposta · " : "")@(foco.MesesComPropostas == 1 ? "1 mês" : $"{foco.MesesComPropostas} meses") com propostas registradas</span>
            }
            else
            {
                <span class="vp-kpi-valor vp-vazio">—</span>
                <span class="vp-kpi-sub">sem propostas registradas no ano@(_podeEditar ? " · informe em ✎ Atualizar dados" : "")</span>
            }
        </div>
    </div>

    @* ================= vendas mês a mês, todos os anos ================= *@
    var lt = LinhaDoTempo();
    <section class="panel vp-card">
        <div class="vp-card-cab">
            <div>
                <h2>Vendas mês a mês, @_anos.First(a => a.MesesComVendas > 0).Ano → @_anos.Last(a => a.MesesComVendas > 0).Ano</h2>
                <p>Cada coluna é um mês; @foco.Ano em destaque. Passe o mouse para ver o valor.</p>
            </div>
            <div class="vp-legenda">
                <span><i class="vp-sw" style="background:@CorFoco"></i>@foco.Ano</span>
                <span><i class="vp-sw" style="background:@CorContexto"></i>outros anos</span>
                @if (lt.Barras.Any(b => b.Valor < 0)) { <span><i class="vp-sw" style="background:@CorNegativo"></i>mês negativo</span> }
            </div>
        </div>
        <div class="vp-grafico" @onmouseleave='() => SairDe("lt")'>
            <svg viewBox="0 0 @F(lt.W) @F(lt.H)" role="img" aria-label="Vendas por mês de @lt.Barras.First().Ano a @lt.Barras.Last().Ano">
                @foreach (var (v, y) in lt.Ticks)
                {
                    <g>
                    <line x1="@F(lt.X0)" x2="@F(lt.W - 8)" y1="@F(y)" y2="@F(y)" class="@(v == 0 ? "vp-base" : "vp-grade")" />
                    <text x="@F(lt.X0 - 8)" y="@F(y + 4)" text-anchor="end" class="vp-eixo">@Eixo(v)</text>
                    </g>
                }
                @foreach (var g in lt.Grupos)
                {
                    <g>
                    @if (g.X > lt.X0 + 1) { <line x1="@F(g.X)" x2="@F(g.X)" y1="@F(lt.Topo - 6)" y2="@F(lt.Base + 22)" class="vp-divisa" /> }
                    <text x="@F(g.X + g.W / 2)" y="@F(lt.H - 6)" text-anchor="middle" class="vp-ano @(g.Ano == foco.Ano ? "foco" : "")">@g.Ano</text>
                    <text x="@F(g.X + g.W / 2)" y="@F(lt.Topo - 12)" text-anchor="middle" class="vp-total-ano">@Mi(g.Total)</text>
                    </g>
                }
                @foreach (var b in lt.Barras)
                {
                    var barra = b;
                    var cor = b.Valor < 0 ? CorNegativo : b.Ano == foco.Ano ? CorFoco : CorContexto;
                    <g>
                    <path d="@Coluna(b.X, lt.Zero, b.Y, b.L)" fill="@cor" class="vp-barra @(_dica?.Chave == b.Chave ? "ativa" : "")" />
                    @if (b.Ano == foco.Ano)
                    {
                        <g>
                        <text x="@F(b.X + b.L / 2)" y="@F(lt.Base + 14)" text-anchor="middle" class="vp-mes">@MesCurto(b.Mes)[..1]</text>
                        </g>
                    }
                    <rect x="@F(b.X - (b.Slot - b.L) / 2)" y="@F(lt.Topo)" width="@F(b.Slot)" height="@F(lt.Base - lt.Topo)" fill="transparent"
                          @onmouseenter="() => DicaDaBarra(barra, lt)" />
                    </g>
                }
                @if (lt.Barras.OrderByDescending(b => b.Valor).FirstOrDefault() is { } maior)
                {
                    <g>
                    <text x="@F(maior.X + maior.L / 2)" y="@F(maior.Y - 6)" text-anchor="middle" class="vp-rotulo">@MiEixo(maior.Valor) · @MesCurto(maior.Mes)/@(maior.Ano % 100)</text>
                    </g>
                }
                @foreach (var neg in lt.Barras.Where(b => b.Valor < 0))
                {
                    <g>
                    <text x="@F(neg.X + neg.L / 2)" y="@F(neg.Y + 14)" text-anchor="middle" class="vp-rotulo">@Mi(neg.Valor)</text>
                    </g>
                }
            </svg>
            @Dica("lt")
        </div>
    </section>

    @* ================= acumulado × budget  |  ano × budgets ================= *@
    <div class="vp-dois">
        @{ var ac = Acumulado(foco); }
        <section class="panel vp-card">
            <div class="vp-card-cab">
                <div>
                    <h2>Acumulado no ano</h2>
                    <p>O ritmo de @foco.Ano contra os anos anteriores e o budget.</p>
                </div>
            </div>
            <div class="vp-legenda" style="margin-bottom:6px">
                <span><i class="vp-linha" style="background:@CorFoco"></i>@foco.Ano</span>
                @if (anterior is not null) { <span><i class="vp-linha" style="background:@CorAnterior"></i>@anterior.Ano</span> }
                <span><i class="vp-linha" style="background:@CorOutros"></i>outros anos</span>
                <span><i class="vp-linha fina" style="background:var(--text)"></i>budget HSA @foco.Ano</span>
                <span><i class="vp-linha fina" style="background:#8a94a6"></i>budget Grupo @foco.Ano</span>
            </div>
            <div class="vp-grafico" @onmouseleave='() => SairDe("ac")'>
                <svg viewBox="0 0 @F(ac.W) @F(ac.H)" role="img" aria-label="Vendas acumuladas por mês, por ano, e os budgets de @foco.Ano">
                    @foreach (var (v, y) in ac.Ticks)
                    {
                        <g>
                        <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(y)" y2="@F(y)" class="@(v == 0 ? "vp-base" : "vp-grade")" />
                        <text x="@F(ac.X0 - 8)" y="@F(y + 4)" text-anchor="end" class="vp-eixo">@Eixo(v)</text>
                        </g>
                    }
                    @for (var m = 1; m <= 12; m++)
                    {
                        <g>
                        <text x="@F(ac.Xm(m))" y="@F(ac.Base + 18)" text-anchor="middle" class="vp-eixo">@MesCurto(m)</text>
                        </g>
                    }
                    @if (foco.BudgetGrupo is decimal bg)
                    {
                        <g>
                        <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(ac.Y(bg))" y2="@F(ac.Y(bg))" class="vp-meta grupo" />
                        <text x="@F(ac.W - 104)" y="@F(ac.Y(bg) + 4)" class="vp-meta-rot">Grupo @MiEixo(bg)</text>
                        </g>
                    }
                    @if (foco.BudgetHsa is decimal bh)
                    {
                        <g>
                        <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(ac.Y(bh))" y2="@F(ac.Y(bh))" class="vp-meta" />
                        <text x="@F(ac.W - 104)" y="@F(ac.Y(bh) + 4)" class="vp-meta-rot forte">HSA @MiEixo(bh)</text>
                        </g>
                    }
                    @foreach (var s in ac.Series.OrderBy(s => s.Ano == foco.Ano ? 2 : s.Ano == foco.Ano - 1 ? 1 : 0))
                    {
                        var cor = s.Ano == foco.Ano ? CorFoco : s.Ano == foco.Ano - 1 ? CorAnterior : CorOutros;
                        <g>
                        <polyline points="@s.Pontos" fill="none" stroke="@cor" stroke-width="@(s.Ano == foco.Ano ? "2.5" : "2")" stroke-linejoin="round" stroke-linecap="round" />
                        @if (s.Ano == foco.Ano || s.Ano == foco.Ano - 1)
                        {
                            <g>
                            <circle cx="@F(s.FimX)" cy="@F(s.FimY)" r="4.5" fill="@cor" stroke="#fff" stroke-width="2" />
                            <text x="@F(s.FimX + 9)" y="@F(s.FimY + (s.Ano == foco.Ano ? 4 : 14))" class="vp-rotulo">@s.Ano · @MiEixo(s.Fim)</text>
                            </g>
                        }
                        </g>
                    }
                    @if (_dica?.Grafico == "ac" && _dica.Mes is int mc)
                    {
                        <g>
                        <line x1="@F(ac.Xm(mc))" x2="@F(ac.Xm(mc))" y1="@F(ac.Topo)" y2="@F(ac.Base)" class="vp-cruz" />
                        </g>
                    }
                    @for (var m = 1; m <= 12; m++)
                    {
                        var mes = m;
                        <g>
                        <rect x="@F(ac.Xm(m) - ac.Passo / 2)" y="@F(ac.Topo)" width="@F(ac.Passo)" height="@F(ac.Base - ac.Topo)" fill="transparent"
                              @onmouseenter="() => DicaDoAcumulado(mes, ac, foco.Ano)" />
                        </g>
                    }
                </svg>
                @Dica("ac")
            </div>
        </section>

        @{ var aa = AnoAAno(foco.Ano); }
        <section class="panel vp-card">
            <div class="vp-card-cab">
                <div>
                    <h2>Ano a ano × budgets</h2>
                    <p>O total vendido em cada ano e onde ficaram os budgets.</p>
                </div>
            </div>
            <div class="vp-legenda" style="margin-bottom:6px">
                <span><i class="vp-sw" style="background:@CorFoco"></i>vendas</span>
                <span><i class="vp-tick" style="background:var(--text)"></i>budget HSA</span>
                <span><i class="vp-tick" style="background:#8a94a6"></i>budget Grupo</span>
            </div>
            <div class="vp-grafico" @onmouseleave='() => SairDe("aa")'>
                <svg viewBox="0 0 @F(aa.W) @F(aa.H)" role="img" aria-label="Vendas por ano e budgets">
                    @foreach (var (v, x) in aa.Ticks)
                    {
                        <g>
                        <line x1="@F(x)" x2="@F(x)" y1="@F(aa.Topo - 4)" y2="@F(aa.Base)" class="@(v == 0 ? "vp-base" : "vp-grade")" />
                        <text x="@F(x)" y="@F(aa.Base + 16)" text-anchor="middle" class="vp-eixo">@Eixo(v)</text>
                        </g>
                    }
                    @foreach (var l in aa.Linhas)
                    {
                        var linha = l;
                        <g>
                        <text x="@F(aa.X0 - 10)" y="@F(l.Y + 5)" text-anchor="end" class="vp-ano @(l.Ano.Ano == foco.Ano ? "foco" : "")">@l.Ano.Ano</text>
                        @if (l.Ano.UltimoMes is > 0 and < 12)
                        {
                            <g>
                            <text x="@F(aa.X0 - 10)" y="@F(l.Y + 18)" text-anchor="end" class="vp-eixo">jan–@MesCurto(l.Ano.UltimoMes).ToLowerInvariant()</text>
                            </g>
                        }
                        <path d="@Barra(aa.X0, l.Y - 9, l.Fim, 18)" fill="@(l.Ano.Ano == foco.Ano ? CorFoco : CorContexto)" />
                        @if (l.Hsa is double xh) { <rect x="@F(xh - 1.5)" y="@F(l.Y - 15)" width="3" height="30" rx="1" fill="#1c2a3a" /> }
                        @if (l.Grupo is double xg) { <rect x="@F(xg - 1.5)" y="@F(l.Y - 13)" width="3" height="26" rx="1" fill="#8a94a6" /> }
                        <text x="@F(aa.W - 6)" y="@F(l.Y + 1)" text-anchor="end" class="vp-rotulo">@Mi(l.Ano.Vendas)</text>
                        <text x="@F(aa.W - 6)" y="@F(l.Y + 15)" text-anchor="end" class="vp-eixo">@(l.Ano.PctHsa is decimal ph ? $"{Pct(ph)} do HSA" : l.Ano.PctGrupo is decimal pg ? $"{Pct(pg)} do Grupo" : "")</text>
                        <rect x="@F(aa.X0)" y="@F(l.Y - 20)" width="@F(aa.Fim - aa.X0)" height="40" fill="transparent" @onmouseenter="() => DicaDoAno(linha, aa)" />
                        </g>
                    }
                </svg>
                @Dica("aa")
            </div>
        </section>
    </div>

    @* ================= mês × ano (a tabela da planilha, em mapa de calor) ================= *@
    var anosTabela = _anos.Where(a => a.MesesComVendas > 0 || a.BudgetHsa is not null).Select(a => a.Ano).ToList();
    var completos = _anos.Where(a => a.MesesComVendas == 12).Select(a => a.Ano).ToList();
    var maxMes = _meses.Where(m => m.Vendas is > 0).Select(m => m.Vendas!.Value).DefaultIfEmpty(1m).Max();
    <section class="panel vp-card">
        <div class="vp-card-cab">
            <div>
                <h2>Mês × ano</h2>
                <p>Quanto mais escuro, maior a venda do mês. A média é dos anos fechados (@(completos.Count > 0 ? $"{completos.Min()}–{completos.Max()}" : "—")).</p>
            </div>
            <div class="vp-escala" aria-hidden="true">
                <span>menor</span>
                @foreach (var c in Rampa) { <i style="background:@c"></i> }
                <span>maior</span>
            </div>
        </div>
        <div class="vp-rolante">
            <table class="vp-tabela">
                <thead>
                    <tr>
                        <th>Mês</th>
                        @foreach (var a in anosTabela) { <th class="right @(a == foco.Ano ? "foco" : "")">@a</th> }
                        <th class="right vp-media">Média</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var m = 1; m <= 12; m++)
                    {
                        var mes = m;
                        <tr>
                            <th>@NomeDoMes(m)</th>
                            @foreach (var a in anosTabela)
                            {
                                var v = _meses.FirstOrDefault(x => x.Ano == a && x.Mes == mes)?.Vendas;
                                @if (v is decimal val)
                                {
                                    var (fundo, tinta) = CorDaCelula(val, maxMes);
                                    <td class="right vp-cel @(val < 0 ? "neg" : "")" style="background:@fundo;color:@tinta" title="@NomeDoMes(mes) @a: @Cheio(val)">
                                        @if (val < 0) { <span aria-hidden="true">▼ </span> }@MiEixo(val)
                                    </td>
                                }
                                else
                                {
                                    <td class="right vp-cel vazia">—</td>
                                }
                            }
                            @{ var media = _meses.Where(x => completos.Contains(x.Ano) && x.Mes == mes && x.Vendas is not null).Select(x => x.Vendas!.Value).DefaultIfEmpty().Average(); }
                            <td class="right vp-media">@(completos.Count > 0 ? MiEixo(media) : "—")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="vp-tot">
                        <th>Total</th>
                        @foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="right">@MiEixo(r.Vendas)</td> }
                        <td class="right vp-media">@(completos.Count > 0 ? MiEixo(_anos.Where(x => completos.Contains(x.Ano)).Average(x => x.Vendas)) : "—")</td>
                    </tr>
                    <tr>
                        <th>Budget HSA</th>
                        @foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="right">@(r.BudgetHsa is decimal b ? MiEixo(b) : "—")</td> }
                        <td></td>
                    </tr>
                    <tr>
                        <th>% do budget HSA</th>
                        @foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="right">@MedidorFino(r.PctHsa)</td> }
                        <td></td>
                    </tr>
                    <tr>
                        <th>Budget Grupo</th>
                        @foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="right">@(r.BudgetGrupo is decimal b ? MiEixo(b) : "—")</td> }
                        <td></td>
                    </tr>
                    <tr>
                        <th>% do budget Grupo</th>
                        @foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="right">@MedidorFino(r.PctGrupo)</td> }
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

    @* ================= propostas × vendas ================= *@
    var comPropostas = _anos.Where(a => a.Propostas is > 0).ToList();
    var representativos = _anos.Where(a => a.Representativo).ToList();
    var referencia = representativos.Where(a => a.Ano < foco.Ano).OrderByDescending(a => a.Ano).FirstOrDefault()
                     ?? representativos.FirstOrDefault(a => a.Ano == foco.Ano) ?? representativos.LastOrDefault();
    <section class="panel vp-card">
        <div class="vp-card-cab">
            <div>
                <h2>Propostas × vendas</h2>
                <p>Quantas propostas enviamos para chegar no valor vendido. As propostas vêm das planilhas da guia Conversão (AFM e NB), no mês da data de envio; com número de proposta, cada número conta uma vez.</p>
            </div>
            <div class="vp-legenda">
                <span><i class="vp-sw" style="background:@CorPropostas"></i>propostas enviadas</span>
            </div>
        </div>

        @if (referencia is not null && referencia.VendaPorProposta is decimal vpp)
        {
            <div class="vp-resposta">
                <div>
                    Em <strong>@referencia.Ano</strong>, enviamos <strong>@referencia.PropostasComVendas.ToString("#,##0", Br) propostas</strong>
                    e vendemos <strong>@Mi(referencia.VendasNosMesesComPropostas)</strong>@(referencia.MesesComAmbos < referencia.MesesComVendas ? $" (nos {referencia.MesesComAmbos} meses com propostas registradas)" : "")
                    — cada proposta enviada correspondeu, em média, a <strong>@Mi(vpp)</strong> em vendas@(referencia.Conversao is decimal cvv ? $", e {Pct(cvv)} do valor proposto virou venda" : "").
                </div>
                @if (foco.BudgetHsa is decimal bhs)
                {
                    var necessarias = (int)Math.Ceiling(bhs / vpp);
                    var faltam = Math.Max(0m, bhs - foco.Vendas);
                    <div class="vp-resposta-num">
                        <span class="vp-kpi-rot">Para o budget HSA @foco.Ano (@Mi(bhs))</span>
                        <strong>≈ @necessarias.ToString("#,##0", Br) propostas</strong>
                        <span class="vp-kpi-sub">no ritmo de @referencia.Ano@(faltam > 0 ? $" · faltam {Mi(faltam)} ≈ {Math.Ceiling(faltam / vpp).ToString("#,##0", Br)} propostas" : " · budget atingido")</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="vp-aviso">
                <strong>Ainda faltam as propostas enviadas do histórico</strong> — com elas, o painel responde quantas propostas foram necessárias para cada R$ vendido e quantas o budget pede.
                @if (comPropostas.Count > 0) { <span>Hoje há propostas registradas em @comPropostas.Sum(a => a.MesesComPropostas) mês(es), pouco para uma média confiável.</span> }
                O painel conta sozinho as propostas das planilhas da guia Conversão (AFM e NB), pela data de envio;
                para os meses de antes delas, informe a quantidade de propostas por mês@(_podeEditar ? " em ✎ Atualizar dados (ou importe a planilha no mesmo layout das vendas)" : " (peça a quem administra o sistema)").
            </div>
        }

        @{ var lp = LinhaDasPropostas(lt); }
        <div class="vp-sub-titulo">Propostas enviadas por mês</div>
        <div class="vp-grafico" @onmouseleave='() => SairDe("lp")'>
            <svg viewBox="0 0 @F(lt.W) @F(lp.H)" role="img" aria-label="Propostas enviadas por mês">
                @foreach (var (v, y) in lp.Ticks)
                {
                    <g>
                    <line x1="@F(lt.X0)" x2="@F(lt.W - 8)" y1="@F(y)" y2="@F(y)" class="@(v == 0 ? "vp-base" : "vp-grade")" />
                    <text x="@F(lt.X0 - 8)" y="@F(y + 4)" text-anchor="end" class="vp-eixo">@v</text>
                    </g>
                }
                @foreach (var g in lt.Grupos)
                {
                    <g>
                    @if (g.X > lt.X0 + 1) { <line x1="@F(g.X)" x2="@F(g.X)" y1="@F(lp.Topo - 4)" y2="@F(lp.Base + 4)" class="vp-divisa" /> }
                    <text x="@F(g.X + g.W / 2)" y="@F(lp.H - 4)" text-anchor="middle" class="vp-ano @(g.Ano == foco.Ano ? "foco" : "")">@g.Ano</text>
                    </g>
                }
                @foreach (var b in lp.Barras)
                {
                    var barra = b;
                    <g>
                    @if (b.Qtd is int q && q > 0)
                    {
                        <g>
                        <path d="@Coluna(b.X, lp.Base, lp.Y(q), b.L)" fill="@CorPropostas" />
                        </g>
                    }
                    else if (b.Qtd is null)
                    {
                        <g>
                        <rect x="@F(b.X)" y="@F(lp.Base - 2)" width="@F(b.L)" height="2" fill="#dde3eb" />
                        </g>
                    }
                    <rect x="@F(b.X - (b.Slot - b.L) / 2)" y="@F(lp.Topo)" width="@F(b.Slot)" height="@F(lp.Base - lp.Topo)" fill="transparent"
                          @onmouseenter="() => DicaDaProposta(barra, lp, lt.W)" />
                    </g>
                }
            </svg>
            @Dica("lp")
        </div>
        <p class="vp-nota">Traço cinza = mês sem propostas registradas.</p>

        <div class="vp-rolante" style="margin-top:12px">
            <table class="vp-tabela vp-conv">
                <thead>
                    <tr>
                        <th>Ano</th><th class="right">Vendas</th><th class="right">Propostas enviadas</th><th class="right">Valor proposto</th>
                        <th class="right" title="Vendas ÷ valor proposto, nos meses com propostas registradas">Conversão em valor</th>
                        <th class="right">Venda por proposta</th><th class="right">Propostas por R$ 1 mi</th>
                        <th class="right" title="Budget HSA ÷ venda por proposta">Propostas para o budget HSA</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _anos.Where(a => a.MesesComVendas > 0 || a.Propostas is not null))
                    {
                        <tr class="@(a.Ano == foco.Ano ? "foco" : "")">
                            <th>@a.Ano@(a.UltimoMes is > 0 and < 12 ? $" (jan–{MesCurto(a.UltimoMes).ToLowerInvariant()})" : "")</th>
                            <td class="right">@Mi(a.Vendas)</td>
                            <td class="right">@(a.Propostas is int p ? p.ToString("#,##0", Br) : "—")@if (a.Propostas is not null && a.MesesComAmbos < a.MesesComVendas) { <span class="vp-cobertura" title="meses com venda e propostas registradas"> · @a.MesesComAmbos de @a.MesesComVendas meses</span> }</td>
                            <td class="right">@(a.ValorProposto is decimal vp ? Mi(vp) : "—")</td>
                            <td class="right">@(a.Conversao is decimal cv ? Pct(cv) : "—")</td>
                            <td class="right">@(a.VendaPorProposta is decimal vv ? Mi(vv) : "—")</td>
                            <td class="right">@(a.PropostasPorMilhao is decimal pm ? pm.ToString(pm < 1 ? "0.00" : "0.0", Br) : "—")</td>
                            <td class="right">@(a.PropostasParaOBudget is int pb ? pb.ToString("#,##0", Br) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="vp-nota">
            Propostas: @_fonte.
            A conversão compara o vendido com o proposto no mesmo período; a venda de um mês pode vir de propostas de meses anteriores, por isso a leitura é por ano.
        </p>
    </section>

    @* ================= propostas enviadas no ano: quantas, quanto e de quem ================= *@
    var doAno = _enviadas.Where(p => p.Data.Year == foco.Ano && (_setor == "" || p.Fonte == _setor)).ToList();
    <section class="panel vp-card" id="vp-enviadas">
        <div class="vp-card-cab">
            <div>
                <h2>Propostas enviadas em @foco.Ano: quantas e quanto</h2>
                <p>Das planilhas da guia Conversão, pela data de envio. Valores em R$ (o AFM convertido pela taxa de câmbio do ano).</p>
            </div>
            <div class="segmented">
                @foreach (var (cod, nome) in new[] { ("", "Ambos"), (ConversaoService.Afm, "AFM"), (ConversaoService.Nb, "NB") })
                {
                    var c = cod;
                    <button class="@(_setor == c ? "active" : "")" @onclick="() => _setor = c">@nome</button>
                }
            </div>
        </div>
        @if (doAno.Count == 0)
        {
            <div class="vp-aviso">@(_carregando ? "Lendo as planilhas de propostas…" : $"Nenhuma proposta com data de envio em {foco.Ano} nas planilhas da guia Conversão{(_setor == "" ? "" : $" ({_setor})")}.")</div>
        }
        else
        {
            var valorAno = doAno.Sum(p => p.ValorReais);
            var ganhas = doAno.Where(p => p.Classe == ClasseProposta.Ganha).ToList();
            var valorGanho = ganhas.Sum(p => p.ValorReais);
            var comValor = doAno.Count(p => p.ValorReais > 0);
            <div class="vp-minis">
                <div class="vp-mini"><span class="vp-kpi-rot">Propostas enviadas</span><span class="vp-kpi-valor">@doAno.Count.ToString("#,##0", Br)</span>
                    <span class="vp-kpi-sub">@(doAno.Select(p => p.Vendedor).Distinct().Count()) vendedor(es)</span></div>
                <div class="vp-mini"><span class="vp-kpi-rot">Valor enviado</span><span class="vp-kpi-valor">@Mi(valorAno)</span>
                    <span class="vp-kpi-sub">@(comValor < doAno.Count ? $"{doAno.Count - comValor} proposta(s) sem valor" : "todas com valor")</span></div>
                <div class="vp-mini"><span class="vp-kpi-rot">Valor médio por proposta</span><span class="vp-kpi-valor">@(comValor > 0 ? Mi(valorAno / comValor) : "—")</span>
                    <span class="vp-kpi-sub">nas propostas com valor</span></div>
                <div class="vp-mini"><span class="vp-kpi-rot">Ganhas</span><span class="vp-kpi-valor">@ganhas.Count.ToString("#,##0", Br)</span>
                    <span class="vp-kpi-sub">@Mi(valorGanho)@(valorAno > 0 ? $" · {Pct(valorGanho / valorAno)} do valor enviado" : "")</span></div>
            </div>

            <div class="vp-dois">
                <div>
                    <div class="vp-sub-titulo">Mês a mês</div>
                    <div class="vp-rolante">
                        <table class="vp-tabela vp-conv">
                            <thead>
                                <tr><th>Mês</th><th class="right">Propostas</th><th class="right">Valor enviado</th><th class="right">Ganhas</th><th class="right" title="Vendas da empresa no mês (todas as origens)">Vendas do mês</th></tr>
                            </thead>
                            <tbody>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    var mes = m;
                                    var doMes = doAno.Where(p => p.Data.Month == mes).ToList();
                                    var venda = _meses.FirstOrDefault(x => x.Ano == foco.Ano && x.Mes == mes)?.Vendas;
                                    if (doMes.Count == 0 && venda is null) continue;
                                    <tr>
                                        <th>@NomeDoMes(mes)</th>
                                        <td class="right">@(doMes.Count > 0 ? doMes.Count.ToString("#,##0", Br) : "—")</td>
                                        <td class="right">@(doMes.Count > 0 ? Mi(doMes.Sum(p => p.ValorReais)) : "—")</td>
                                        <td class="right">@(doMes.Count(p => p.Classe == ClasseProposta.Ganha) is var g && g > 0 ? g.ToString("#,##0", Br) : "—")</td>
                                        <td class="right">@(venda is decimal v ? Mi(v) : "—")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="vp-tot">
                                    <th>Total</th>
                                    <td class="right">@doAno.Count.ToString("#,##0", Br)</td>
                                    <td class="right">@Mi(valorAno)</td>
                                    <td class="right">@ganhas.Count.ToString("#,##0", Br)</td>
                                    <td class="right">@Mi(foco.Vendas)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div>
                    <div class="vp-sub-titulo">Por vendedor</div>
                    <div class="vp-rolante">
                        <table class="vp-tabela vp-conv">
                            <thead>
                                <tr><th>Vendedor</th><th class="right">Propostas</th><th class="right">Valor enviado</th><th class="right">Ganhas</th>
                                    <th class="right" title="Valor das ganhas ÷ valor enviado">Conversão em valor</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var g in doAno.GroupBy(p => p.Vendedor).OrderByDescending(g => g.Sum(p => p.ValorReais)).ThenByDescending(g => g.Count()))
                                {
                                    var val = g.Sum(p => p.ValorReais);
                                    var gan = g.Where(p => p.Classe == ClasseProposta.Ganha).ToList();
                                    var valGan = gan.Sum(p => p.ValorReais);
                                    <tr>
                                        <th>@g.Key</th>
                                        <td class="right">@g.Count().ToString("#,##0", Br)</td>
                                        <td class="right">
                                            @Mi(val)
                                            @if (valorAno > 0) { <span class="vp-medidor fino" title="@Pct(val / valorAno) do valor enviado"><i style="width:@F((double)(val / valorAno) * 100)%"></i></span> }
                                        </td>
                                        <td class="right">@(gan.Count > 0 ? $"{gan.Count.ToString("#,##0", Br)} · {Mi(valGan)}" : "—")</td>
                                        <td class="right">@(val > 0 && gan.Count > 0 ? Pct(valGan / val) : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <p class="vp-nota">Ganhas = status de ganha na planilha (a mesma classificação da guia Conversão). As vendas do mês são as da empresa toda, para comparar com o que foi enviado.</p>
        }
    </section>

    @if (_editando && _podeEditar)
    {
        <section class="panel vp-card vp-editor">
            <div class="vp-card-cab">
                <div>
                    <h2>Atualizar dados</h2>
                    <p>Digite os valores por mês (R$ cheios, ex.: 33.253.000) ou arraste a planilha no mesmo layout da equipe: a coluna "Mês" e uma coluna por ano.</p>
                </div>
                <div class="segmented">
                    @foreach (var (cod, nome) in new[] { ("vendas", "Vendas"), ("propostas", "Propostas enviadas"), ("valor", "Valor proposto"), ("budgets", "Budgets") })
                    {
                        var c = cod;
                        <button class="@(_aba == c ? "active" : "")" @onclick="() => _aba = c">@nome</button>
                    }
                </div>
            </div>
            @{ var anosEd = _anosEditor; }
            @if (_aba == "budgets")
            {
                <table class="vp-tabela vp-ed">
                    <thead><tr><th>Ano</th><th class="right">Budget HSA (R$)</th><th class="right">Budget Grupo (R$)</th></tr></thead>
                    <tbody>
                        @foreach (var a in anosEd)
                        {
                            var ano = a;
                            var b = _budgets.FirstOrDefault(x => x.Ano == ano);
                            <tr>
                                <th>@a</th>
                                <td><input class="cell num" value="@Campo(b?.Hsa)" @onchange="e => MudarBudget(ano, true, e)" /></td>
                                <td><input class="cell num" value="@Campo(b?.Grupo)" @onchange="e => MudarBudget(ano, false, e)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="vp-rolante">
                <table class="vp-tabela vp-ed">
                    <thead><tr><th>Mês</th>@foreach (var a in anosEd) { <th class="right">@a</th> }</tr></thead>
                    <tbody>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var mes = m;
                            <tr>
                                <th>@NomeDoMes(m)</th>
                                @foreach (var a in anosEd)
                                {
                                    var ano = a;
                                    var reg = _brutos.FirstOrDefault(x => x.Ano == ano && x.Mes == mes);
                                    var sist = _meses.FirstOrDefault(x => x.Ano == ano && x.Mes == mes);
                                    var valor = _aba switch { "vendas" => Campo(reg?.Vendas), "propostas" => reg?.Propostas?.ToString(Br) ?? "", _ => Campo(reg?.ValorProposto) };
                                    var dica = _aba == "propostas" && reg?.Propostas is null && sist?.FonteDasPropostas == "sistema" ? $"sistema: {sist.Propostas}" : "";
                                    <td><input class="cell num" value="@valor" placeholder="@dica" @onchange="e => MudarMes(ano, mes, e)" /></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                @if (_aba != "vendas") { <p class="vp-nota">Vazio = vale a contagem do sistema (o número em cinza). Digitar um valor troca a do sistema naquele mês.</p> }
            }
            <div class="vp-editor-pe">
                <button class="btn-ghost" @onclick="AcrescentarAno">+ ano @((_anosEditor.LastOrDefault() + 1).ToString())</button>
                <label class="vp-drop">
                    <InputFile OnChange="Importar" accept=".xlsx,.xlsm,.xls,.csv" />
                    <span>⇪ <strong>Importar planilha</strong> de @(_aba switch { "propostas" => "propostas enviadas", "valor" => "valor proposto", _ => "vendas (com BUDGET HSA e BUDGET GRUPO)" })</span>
                </label>
            </div>
        </section>
    }
}
</div>

@code {
    private static readonly CultureInfo Br = new("pt-BR");
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // cores (validadas: azul e laranja separam também para daltônicos; a rampa é uma só cor, do claro ao escuro)
    private const string CorFoco = "#2a78d6", CorContexto = "#b7d3f6", CorAnterior = "#6b7280", CorOutros = "#cdd3dc",
        CorPropostas = "#eb6834", CorNegativo = "#d03b3b";
    private static readonly string[] Rampa = { "#e7f0fc", "#cde2fb", "#b7d3f6", "#9ec5f4", "#86b6ef", "#6da7ec", "#5598e7", "#3987e5", "#2a78d6", "#256abf", "#1c5cab", "#184f95" };

    private List<MesDeVendas> _brutos = new();
    private List<BudgetDoAno> _budgets = new();
    private List<ResumoDoMes> _meses = new();
    private List<ResumoDoAno> _anos = new();
    private string _fonte = "";
    private int _foco;
    private bool _podeEditar, _editando, _msgOk;
    private string? _msg;
    private string _aba = "vendas";
    private List<int> _anosEditor = new();
    private bool _carregando;
    private string _setor = "";
    private List<ConversaoDeVendas.PropostaEnviada> _enviadas = new();

    protected override async Task OnInitializedAsync()
    {
        _podeEditar = true;   // a guia já é só do administrador
        Carregar();
        _foco = _anos.Where(a => a.MesesComVendas > 0).Select(a => a.Ano).DefaultIfEmpty(DateTime.Today.Year).Max();
        // as propostas vêm das planilhas da guia Conversão (leitura da rede): em segundo plano
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(false)); } catch { /* sem as planilhas, o painel mostra só as vendas */ }
        finally { _carregando = false; }
        Carregar();
    }

    private void Carregar()
    {
        _brutos = VendasRepo.Meses();
        _budgets = VendasRepo.Budgets();
        var enviadas = new List<ConversaoDeVendas.PropostaEnviada>();
        try
        {
            if (Conv.Ok) enviadas = ConversaoDeVendas.PropostasEnviadas(Conv.Atual.Propostas, Cambio.Todas());
        }
        catch (Exception) { /* sem as propostas, o painel mostra só as vendas */ }
        _enviadas = enviadas;
        _meses = ConversaoDeVendas.Meses(_brutos, enviadas);
        _anos = ConversaoDeVendas.Anos(_meses, _budgets);
        var informados = _brutos.Count(b => b.Propostas is not null);
        _fonte = string.Join("; ", new[]
        {
            enviadas.Count(p => p.Fonte == ConversaoService.Afm) is var s && s > 0 ? $"{s.ToString("#,##0", Br)} da planilha AFM" : "",
            enviadas.Count(p => p.Fonte == ConversaoService.Nb) is var r && r > 0 ? $"{r.ToString("#,##0", Br)} da planilha NB" : "",
            enviadas.Count(p => p.SemTaxa) is var st && st > 0 ? $"{st} do AFM sem taxa de câmbio do ano (contam na quantidade, sem valor)" : "",
            informados > 0 ? $"{informados} mês(es) informado(s) à mão" : "",
        }.Where(x => x.Length > 0)) is { Length: > 0 } t ? t : (_carregando ? "lendo as planilhas…" : "nenhuma registrada ainda");
        var anos = _brutos.Select(b => b.Ano).Concat(_budgets.Select(b => b.Ano)).Distinct().OrderBy(a => a).ToList();
        _anosEditor = anos.Count > 0 ? Enumerable.Range(anos.Min(), Math.Max(anos.Max(), _anosEditor.DefaultIfEmpty(0).Max()) - anos.Min() + 1).ToList() : new() { DateTime.Today.Year };
    }

    private ResumoDoAno AnoDoFoco => _anos.FirstOrDefault(a => a.Ano == _foco) ?? _anos.Last();

    // ================= formatos =================

    private static string F(double v) => v.ToString("0.##", Inv);
    private static string Pct(decimal v) => v.ToString("P1", Br);
    private static string Cheio(decimal v) => (v < 0 ? "−" : "") + "R$ " + Math.Abs(v).ToString("#,##0", Br);
    private static string Mi(decimal v) => (v < 0 ? "−" : "") + "R$ " + Compacto(Math.Abs(v));
    private static string MiEixo(decimal v) => (v < 0 ? "−" : "") + Compacto(Math.Abs(v));
    private static string Compacto(decimal a) =>
        a >= 1_000_000m ? (a / 1_000_000m).ToString("#,##0.0", Br) + " mi"
        : a >= 1_000m ? (a / 1_000m).ToString("#,##0", Br) + " mil" : a.ToString("#,##0", Br);
    /// <summary>Marca do eixo: número redondo, sem casa decimal quando não precisa.</summary>
    private static string Eixo(decimal v) => (v < 0 ? "−" : "") +
        (Math.Abs(v) >= 1_000_000m ? (Math.Abs(v) / 1_000_000m).ToString("#,##0.#", Br) + " mi" : Math.Abs(v).ToString("#,##0", Br));
    private static string NomeDoMes(int m) => VendasMensaisRepository.NomesDosMeses[m - 1];
    private static string MesCurto(int m) => VendasMensaisRepository.MesesCurtos[m - 1];
    private static string Campo(decimal? v) => v?.ToString("#,##0.##", Br) ?? "";

    private static (string Fundo, string Tinta) CorDaCelula(decimal v, decimal max)
    {
        if (v < 0) return ("#fdecec", "#b42318");
        var t = (double)Math.Clamp(v / max, 0m, 1m);
        var i = (int)Math.Round(t * (Rampa.Length - 1));
        return (Rampa[i], i >= 7 ? "#ffffff" : "#1c2a3a");
    }

    /// <summary>Um passo "redondo" para o eixo (em R$), para ~4 linhas de grade.</summary>
    private static decimal Passo(decimal max)
    {
        var alvo = max / 4m;
        foreach (var p in new[] { 1e6m, 2e6m, 5e6m, 10e6m, 20e6m, 25e6m, 50e6m, 100e6m, 200e6m, 250e6m, 500e6m })
            if (p >= alvo) return p;
        return 1e9m;
    }

    /// <summary>Coluna com a ponta de dado arredondada (4px) e a base reta.</summary>
    private static string Coluna(double x, double baseY, double y, double w)
    {
        var r = Math.Min(4, Math.Min(w / 2, Math.Abs(baseY - y)));
        if (y <= baseY)   // positiva: arredonda em cima
            return $"M{F(x)},{F(baseY)} V{F(y + r)} Q{F(x)},{F(y)} {F(x + r)},{F(y)} H{F(x + w - r)} Q{F(x + w)},{F(y)} {F(x + w)},{F(y + r)} V{F(baseY)} Z";
        return $"M{F(x)},{F(baseY)} V{F(y - r)} Q{F(x)},{F(y)} {F(x + r)},{F(y)} H{F(x + w - r)} Q{F(x + w)},{F(y)} {F(x + w)},{F(y - r)} V{F(baseY)} Z";
    }

    /// <summary>Barra horizontal com a ponta arredondada à direita.</summary>
    private static string Barra(double x0, double y, double x1, double h)
    {
        var r = Math.Min(4, Math.Max(0, (x1 - x0) / 2));
        return $"M{F(x0)},{F(y)} H{F(x1 - r)} Q{F(x1)},{F(y)} {F(x1)},{F(y + r)} V{F(y + h - r)} Q{F(x1)},{F(y + h)} {F(x1 - r)},{F(y + h)} H{F(x0)} Z";
    }

    // ================= linha do tempo (todos os meses) =================

    private sealed record BarraMes(int Ano, int Mes, decimal Valor, double X, double Y, double L, double Slot)
    {
        public string Chave => $"lt{Ano}-{Mes}";
    }
    private sealed record GrupoAno(int Ano, double X, double W, decimal Total);
    private sealed record LinhaTempo(double W, double H, double X0, double Topo, double Base, double Zero, List<(decimal V, double Y)> Ticks,
        List<BarraMes> Barras, List<GrupoAno> Grupos, int Ano0);

    private LinhaTempo LinhaDoTempo()
    {
        const double W = 1100, H = 330, X0 = 64, Topo = 40, Base = 286;
        var anos = _anos.Where(a => a.MesesComVendas > 0).Select(a => a.Ano).ToList();
        var ano0 = anos.Min();
        var slots = anos.Count * 12;
        var slot = (W - 8 - X0) / slots;
        var largura = Math.Min(24, slot * 0.64);
        var vals = _meses.Where(m => m.Vendas is not null && anos.Contains(m.Ano)).ToList();
        var max = vals.Max(m => m.Vendas!.Value);
        var min = Math.Min(0m, vals.Min(m => m.Vendas!.Value));
        var passo = Passo(max);
        var topoV = Math.Ceiling(max / passo) * passo;
        var baseV = min < 0 ? -Math.Ceiling(-min / passo) * passo / 2m : 0m;   // meia faixa abaixo do zero, se houver mês negativo
        double Y(decimal v) => Base - (double)((v - baseV) / (topoV - baseV)) * (Base - Topo);
        var ticks = new List<(decimal, double)>();
        for (var v = baseV < 0 ? 0m : baseV; v <= topoV; v += passo) ticks.Add((v, Y(v)));
        var barras = vals.Select(m =>
        {
            var i = (m.Ano - ano0) * 12 + (m.Mes - 1);
            var x = X0 + i * slot + (slot - largura) / 2;
            return new BarraMes(m.Ano, m.Mes, m.Vendas!.Value, x, Y(m.Vendas!.Value), largura, slot);
        }).ToList();
        var grupos = anos.Select(a => new GrupoAno(a, X0 + (a - ano0) * 12 * slot, 12 * slot, _anos.First(x => x.Ano == a).Vendas)).ToList();
        return new LinhaTempo(W, H, X0, Topo, Base, Y(0), ticks, barras, grupos, ano0);
    }

    // propostas, alinhadas à linha do tempo das vendas (mesmo eixo de meses)
    private sealed record BarraProposta(int Ano, int Mes, int? Qtd, decimal? Valor, string Fonte, double X, double L, double Slot);
    private sealed record LinhaPropostas(double H, double Topo, double Base, Func<int, double> Y, List<(int V, double Y)> Ticks, List<BarraProposta> Barras);

    private LinhaPropostas LinhaDasPropostas(LinhaTempo lt)
    {
        const double H = 150, Topo = 14, Base = 122;
        var max = Math.Max(1, _meses.Where(m => m.Ano >= lt.Ano0).Select(m => m.Propostas ?? 0).DefaultIfEmpty(0).Max());
        var passo = max <= 4 ? 1 : max <= 10 ? 2 : max <= 25 ? 5 : max <= 50 ? 10 : max <= 100 ? 20 : max <= 250 ? 50 : 100;
        var topoV = (int)Math.Ceiling(max / (double)passo) * passo;
        double Y(int v) => Base - v / (double)topoV * (Base - Topo);
        var ticks = new List<(int, double)>();
        for (var v = 0; v <= topoV; v += passo) ticks.Add((v, Y(v)));
        var barras = new List<BarraProposta>();
        foreach (var b in lt.Grupos)
            for (var m = 1; m <= 12; m++)
            {
                var r = _meses.FirstOrDefault(x => x.Ano == b.Ano && x.Mes == m);
                var vendaOuProposta = r is not null && (r.Vendas is not null || r.TemPropostas);
                if (!vendaOuProposta) continue;
                var slot = b.W / 12;
                var largura = Math.Min(24, slot * 0.64);
                barras.Add(new BarraProposta(b.Ano, m, r!.Propostas, r.ValorProposto, r.FonteDasPropostas, b.X + (m - 1) * slot + (slot - largura) / 2, largura, slot));
            }
        return new LinhaPropostas(H, Topo, Base, Y, ticks, barras);
    }

    // ================= acumulado no ano =================

    private sealed record Serie(int Ano, string Pontos, double FimX, double FimY, decimal Fim);
    private sealed record GraficoAcumulado(double W, double H, double X0, double Topo, double Base, double Passo, Func<int, double> Xm, Func<decimal, double> Y,
        List<(decimal V, double Y)> Ticks, List<Serie> Series, Dictionary<int, decimal[]> Valores);

    private GraficoAcumulado Acumulado(ResumoDoAno foco)
    {
        const double W = 560, H = 300, X0 = 58, Topo = 16, Base = 262;
        var passoX = (W - 110 - X0) / 12;
        double Xm(int m) => X0 + passoX * (m - 0.5);
        var valores = new Dictionary<int, decimal[]>();
        foreach (var a in _anos.Where(a => a.MesesComVendas > 0))
        {
            var acum = new decimal[12];
            var soma = 0m;
            for (var m = 1; m <= 12; m++)
            {
                var v = _meses.FirstOrDefault(x => x.Ano == a.Ano && x.Mes == m)?.Vendas;
                soma += v ?? 0m;
                acum[m - 1] = m <= a.UltimoMes ? soma : -1m;
            }
            valores[a.Ano] = acum;
        }
        var max = new[] { valores.Values.SelectMany(v => v).DefaultIfEmpty(0m).Max(), foco.BudgetHsa ?? 0m, foco.BudgetGrupo ?? 0m }.Max();
        var passo = Passo(max);
        var topoV = Math.Ceiling(max / passo) * passo;
        double Y(decimal v) => Base - (double)(v / topoV) * (Base - Topo);
        var ticks = new List<(decimal, double)>();
        for (var v = 0m; v <= topoV; v += passo) ticks.Add((v, Y(v)));
        var series = valores.Select(kv =>
        {
            var pts = kv.Value.Select((v, i) => (v, i)).Where(p => p.v >= 0).Select(p => $"{F(Xm(p.i + 1))},{F(Y(p.v))}").ToList();
            var ultimo = kv.Value.Select((v, i) => (v, i)).Where(p => p.v >= 0).Last();
            return new Serie(kv.Key, string.Join(" ", pts), Xm(ultimo.i + 1), Y(ultimo.v), ultimo.v);
        }).ToList();
        return new GraficoAcumulado(W, H, X0, Topo, Base, passoX, Xm, Y, ticks, series, valores);
    }

    // ================= ano a ano × budgets =================

    private sealed record LinhaAno(ResumoDoAno Ano, double Y, double Fim, double? Hsa, double? Grupo);
    private sealed record GraficoAnos(double W, double H, double X0, double Fim, double Topo, double Base, List<(decimal V, double X)> Ticks, List<LinhaAno> Linhas);

    private GraficoAnos AnoAAno(int foco)
    {
        const double W = 560, X0 = 74, Topo = 22;
        var anos = _anos.Where(a => a.MesesComVendas > 0).ToList();
        var fim = W - 120;
        var altura = 52.0;
        var baseY = Topo + anos.Count * altura;
        var max = anos.Select(a => new[] { a.Vendas, a.BudgetHsa ?? 0m, a.BudgetGrupo ?? 0m }.Max()).DefaultIfEmpty(1m).Max();
        var passo = Passo(max);
        var topoV = Math.Ceiling(max / passo) * passo;
        double X(decimal v) => X0 + (double)(Math.Max(0m, v) / topoV) * (fim - X0);
        var ticks = new List<(decimal, double)>();
        for (var v = 0m; v <= topoV; v += passo) ticks.Add((v, X(v)));
        var linhas = anos.Select((a, i) => new LinhaAno(a, Topo + altura * i + altura / 2, X(a.Vendas),
            a.BudgetHsa is decimal h ? X(h) : null, a.BudgetGrupo is decimal g ? X(g) : null)).ToList();
        return new GraficoAnos(W, baseY + 26, X0, fim, Topo, baseY, ticks, linhas);
    }

    // ================= dicas (hover) =================

    private sealed record DicaVisivel(string Grafico, string Chave, double XPct, double YPct, string Titulo, List<(string Cor, string Valor, string Rotulo)> Linhas, int? Mes = null);
    private DicaVisivel? _dica;

    private void SairDe(string grafico) { if (_dica?.Grafico == grafico) _dica = null; }

    private void DicaDaBarra(BarraMes b, LinhaTempo lt)
    {
        var doAno = _anos.First(a => a.Ano == b.Ano).Vendas;
        var anterior = _meses.FirstOrDefault(m => m.Ano == b.Ano - 1 && m.Mes == b.Mes)?.Vendas;
        var linhas = new List<(string, string, string)> { (b.Valor < 0 ? CorNegativo : b.Ano == _foco ? CorFoco : CorContexto, Cheio(b.Valor), "vendido no mês") };
        if (doAno != 0 && b.Valor > 0) linhas.Add(("", Pct(b.Valor / doAno), $"do total de {b.Ano}"));
        if (anterior is decimal ant && ant != 0) linhas.Add(("", (b.Valor / ant - 1m).ToString("+0.0%;−0.0%", Br), $"vs {MesCurto(b.Mes).ToLowerInvariant()}/{b.Ano - 1}"));
        _dica = new DicaVisivel("lt", b.Chave, (b.X + b.L / 2) / lt.W * 100, Math.Min(b.Y, lt.Zero) / lt.H * 100, $"{NomeDoMes(b.Mes)} {b.Ano}", linhas);
    }

    private void DicaDaProposta(BarraProposta b, LinhaPropostas lp, double w)
    {
        var vendas = _meses.FirstOrDefault(m => m.Ano == b.Ano && m.Mes == b.Mes)?.Vendas;
        var linhas = new List<(string, string, string)>();
        if (b.Qtd is int q)
        {
            linhas.Add((CorPropostas, q.ToString("#,##0", Br), q == 1 ? "proposta enviada" : "propostas enviadas"));
            if (b.Valor is decimal v) linhas.Add(("", Mi(v), "propostos"));
            linhas.Add(("", b.Fonte == "informado" ? "informado à mão" : "contado das planilhas", ""));
        }
        else linhas.Add(("", "—", "sem propostas registradas"));
        if (vendas is decimal vd) linhas.Add((CorFoco, Mi(vd), "vendido no mês"));
        var y = b.Qtd is int qq ? lp.Y(qq) : lp.Base;
        _dica = new DicaVisivel("lp", $"lp{b.Ano}-{b.Mes}", (b.X + b.L / 2) / w * 100, y / lp.H * 100, $"{NomeDoMes(b.Mes)} {b.Ano}", linhas);
    }

    private void DicaDoAcumulado(int mes, GraficoAcumulado ac, int foco)
    {
        var linhas = ac.Valores.OrderByDescending(kv => kv.Key == foco).ThenByDescending(kv => kv.Key)
            .Where(kv => kv.Value[mes - 1] >= 0)
            .Select(kv => (kv.Key == foco ? CorFoco : kv.Key == foco - 1 ? CorAnterior : CorOutros, Mi(kv.Value[mes - 1]), kv.Key.ToString()))
            .ToList();
        var topo = ac.Valores.Values.Where(v => v[mes - 1] >= 0).Select(v => v[mes - 1]).DefaultIfEmpty(0m).Max();
        _dica = new DicaVisivel("ac", $"ac{mes}", ac.Xm(mes) / ac.W * 100, ac.Y(topo) / ac.H * 100, $"Acumulado até {NomeDoMes(mes).ToLowerInvariant()}", linhas, mes);
    }

    private void DicaDoAno(LinhaAno l, GraficoAnos aa)
    {
        var a = l.Ano;
        var linhas = new List<(string, string, string)> { (a.Ano == _foco ? CorFoco : CorContexto, Cheio(a.Vendas), a.UltimoMes is > 0 and < 12 ? $"vendido (jan–{MesCurto(a.UltimoMes).ToLowerInvariant()})" : "vendido no ano") };
        if (a.BudgetHsa is decimal h) linhas.Add(("#1c2a3a", Cheio(h), $"budget HSA · {Pct(a.Vendas / h)}"));
        if (a.BudgetGrupo is decimal g) linhas.Add(("#8a94a6", Cheio(g), $"budget Grupo · {Pct(a.Vendas / g)}"));
        _dica = new DicaVisivel("aa", $"aa{a.Ano}", l.Fim / aa.W * 100, (l.Y - 12) / aa.H * 100, a.Ano.ToString(), linhas);
    }

    private RenderFragment Dica(string grafico) => __builder =>
    {
        if (_dica is { } d && d.Grafico == grafico)
        {
            var lado = d.XPct > 78 ? "dir" : d.XPct < 18 ? "esq" : "";
            <div class="vp-dica @lado" style="left:@F(d.XPct)%;top:@F(d.YPct)%" role="status">
                <div class="vp-dica-tit">@d.Titulo</div>
                @foreach (var (cor, valor, rotulo) in d.Linhas)
                {
                    <div class="vp-dica-lin">
                        @if (cor.Length > 0) { <i style="background:@cor"></i> } else { <i class="sem"></i> }
                        <strong>@valor</strong><span>@rotulo</span>
                    </div>
                }
            </div>
        }
    };

    // ================= indicadores =================

    private RenderFragment Medidor(string rotulo, decimal vendas, decimal? budget) => __builder =>
    {
        <div class="vp-kpi">
            <span class="vp-kpi-rot">@rotulo</span>
            @if (budget is decimal b && b > 0)
            {
                var p = vendas / b;
                <span class="vp-kpi-valor">@Pct(p)</span>
                <div class="vp-medidor" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(p * 100))" aria-label="@rotulo">
                    <i style="width:@F((double)Math.Min(p, 1m) * 100)%"></i>
                </div>
                <span class="vp-kpi-sub">@Mi(vendas) de @Mi(b)@(b > vendas ? $" · faltam {Mi(b - vendas)}" : " · atingido ✓")</span>
            }
            else
            {
                <span class="vp-kpi-valor vp-vazio">—</span>
                <span class="vp-kpi-sub">sem budget para o ano</span>
            }
        </div>
    };

    private RenderFragment MedidorFino(decimal? p) => __builder =>
    {
        if (p is decimal v)
        {
            <span class="vp-pct">@Pct(v)</span>
            <span class="vp-medidor fino"><i style="width:@F((double)Math.Min(v, 1m) * 100)%"></i></span>
        }
        else { <span>—</span> }
    };

    // ================= edição e arquivos =================

    private void MudarMes(int ano, int mes, ChangeEventArgs e)
    {
        var texto = (e.Value?.ToString() ?? "").Trim();
        var v = texto.Length == 0 ? null : VendasMensaisRepository.Numero(texto);
        if (texto.Length > 0 && v is null) { _msgOk = false; _msg = $"\"{texto}\" não é um número."; return; }
        var reg = _brutos.FirstOrDefault(x => x.Ano == ano && x.Mes == mes) ?? new MesDeVendas { Ano = ano, Mes = mes };
        switch (_aba)
        {
            case "vendas": reg.Vendas = v; break;
            case "propostas": reg.Propostas = v is decimal q ? (int)Math.Round(q) : null; break;
            default: reg.ValorProposto = v; break;
        }
        VendasRepo.GravarMeses(new[] { reg });
        Carregar();
        _msgOk = true;
        _msg = $"{NomeDoMes(mes)} {ano} gravado.";
    }

    private void MudarBudget(int ano, bool hsa, ChangeEventArgs e)
    {
        var texto = (e.Value?.ToString() ?? "").Trim();
        var v = texto.Length == 0 ? null : VendasMensaisRepository.Numero(texto);
        if (texto.Length > 0 && v is null) { _msgOk = false; _msg = $"\"{texto}\" não é um número."; return; }
        var b = _budgets.FirstOrDefault(x => x.Ano == ano) ?? new BudgetDoAno { Ano = ano };
        if (hsa) b.Hsa = v; else b.Grupo = v;
        VendasRepo.GravarBudgets(new[] { b });
        Carregar();
        _msgOk = true;
        _msg = $"Budget {(hsa ? "HSA" : "Grupo")} {ano} gravado.";
    }

    private void AcrescentarAno()
    {
        var proximo = _anosEditor.DefaultIfEmpty(DateTime.Today.Year - 1).Max() + 1;
        _anosEditor.Add(proximo);
    }

    private async Task Importar(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(ms);
            var tipo = _aba switch
            {
                "propostas" => VendasMensaisRepository.TipoDeImportacao.Propostas,
                "valor" => VendasMensaisRepository.TipoDeImportacao.ValorProposto,
                _ => VendasMensaisRepository.TipoDeImportacao.Vendas,
            };
            var (meses, budgets, avisos) = VendasRepo.Importar(ms.ToArray(), e.File.Name, tipo);
            Carregar();
            _msgOk = meses + budgets > 0;
            _msg = _msgOk
                ? $"{e.File.Name}: {meses} mês(es)" + (budgets > 0 ? $" e {budgets} budget(s)" : "") + " gravado(s)." + (avisos.Count > 0 ? " " + string.Join(" ", avisos.Take(3)) : "")
                : $"Nada importado de {e.File.Name}. {string.Join(" ", avisos.Take(3))}";
        }
        catch (Exception ex) { _msgOk = false; _msg = "Não deu para ler a planilha: " + ex.Message; }
    }

    private async Task Exportar()
    {
        var bytes = VendasMensaisRepository.Planilha(_brutos, _budgets, _meses);
        await JS.InvokeVoidAsync("appDownload", "vendas_e_propostas.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
