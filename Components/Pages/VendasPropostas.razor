    {
        "valor" => T($"Valor das propostas enviadas por mês ({Sim}), comparando os anos", $"Value of proposals sent per month ({Sim}), comparing years"),
        "vendas" => T($"Vendas por mês ({Sim}), comparando os anos", $"Sales per month ({Sim}), comparing years"),
        "taxa" => T("Taxa de conversão por mês, comparando os anos", "Conversion rate per month, comparing years"),
