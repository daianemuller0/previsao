    // ================= gráfico 2: vendas totais × metas, ano a ano =================


    /// <summary>
    /// Vendas × metas, ano a ano, no mesmo padrão das barras da guia Conversão (taxa por unidade): uma linha por
    /// ano com os números em cima (vendido, Meta Grupo e Meta HSA com o atingido) e a barra grossa em degradê
    /// embaixo; as metas são marcas sobre a barra. O ano em foco fica destacado. Clique num ano para focá-lo.
    /// </summary>
    private RenderFragment MetasExecutivo(int focoAno) => __builder =>
    {
        var anos = _anos.Where(a => a.Ano >= AnoIni && AnoVisivel(a.Ano) && (a.MesesComVendas > 0 || a.BudgetHsa is not null || a.BudgetGrupo is not null)).OrderBy(a => a.Ano).ToList();
        if (anos.Count == 0) { <div class="empty">Sem vendas nem metas cadastradas.</div> return; }
        string cV = CorMeta("vendas"), cG = CorMeta("grupo"), cH = CorMeta("hsa");
        var max = anos.Select(a => new[] { a.Vendas, a.BudgetGrupo ?? 0m, a.BudgetHsa ?? 0m }.Max()).DefaultIfEmpty(1m).Max();
        var passo = Passo(Math.Max(max, 1m));
        var escala = Math.Ceiling(Math.Max(max, 1m) * 1.04m / passo) * passo;
        double Pc(decimal v) => (double)(Math.Max(0m, v) / escala * 100m);
        <div class="vp-bul-leg">
            <span><i class="vp-b vp-grad" style="--c:@cV"></i>Vendas totais</span>
            <span><i class="vp-m" style="background:@cG"></i>Meta Grupo</span>
            <span><i class="vp-m" style="background:@cH"></i>Meta HSA</span>
        </div>
        <div class="ibar cvx-ibar vp-metas-ibar">
            @foreach (var a in anos)
            {
                var ano = a.Ano;
                var periodo = a.UltimoMes is > 0 and < 12 ? $"jan–{MesCurto(a.UltimoMes).ToLowerInvariant()}" : "";
                <div class="ibar-item @(a.Ano == focoAno ? "xf-on" : "")" @onclick="() => { _foco = ano; _dica = null; }"
                     title="@($"{a.Ano}{(periodo != "" ? $" ({periodo})" : "")} · Vendas {(a.MesesComVendas > 0 ? Cheio(a.Vendas) : "—")} · Meta Grupo {(a.BudgetGrupo is decimal g0 ? Cheio(g0) : "—")} · Meta HSA {(a.BudgetHsa is decimal h0 ? Cheio(h0) : "—")}")">
                    <div class="ibar-head">
                        <span class="ibar-num vp-mt-ano">@a.Ano</span>
                        @if (periodo != "") { <span class="vp-mt-per">@periodo</span> }
                        <div class="ibar-metrics">
                            <span class="vp-mt-v"><small>Vendido</small><b class="ibar-val">@(a.MesesComVendas > 0 ? Mi(a.Vendas) : "—")</b></span>
                            <span class="ibar-sep"></span>
                            <span class="vp-mt-m"><i style="background:@cG"></i><small>Meta Grupo</small><b>@(a.BudgetGrupo is decimal g ? Mi(g) : "—")</b><em>@(a.PctGrupo is decimal pg ? Pct(pg) : "—")</em></span>
                            <span class="ibar-sep"></span>
                            <span class="vp-mt-m"><i style="background:@cH"></i><small>Meta HSA</small><b>@(a.BudgetHsa is decimal h ? Mi(h) : "—")</b><em>@(a.PctHsa is decimal ph ? Pct(ph) : "—")</em></span>
                        </div>
                    </div>
                    <div class="vp-mt-barra">
                        <div class="ibar-track"><span class="ibar-fill" style="width:@F(a.MesesComVendas > 0 ? Pc(a.Vendas) : 0)%;--c:@cV"></span></div>
                        @if (a.BudgetGrupo is decimal bg) { <em class="vp-mt-mk" style="left:@F(Pc(bg))%;background:@cG" title="Meta Grupo: @Cheio(bg)"></em> }
                        @if (a.BudgetHsa is decimal bh) { <em class="vp-mt-mk" style="left:@F(Pc(bh))%;background:@cH" title="Meta HSA: @Cheio(bh)"></em> }
                    </div>
                </div>
            }
            <div class="vp-mt-eixo">
                @for (var v = 0m; v <= escala; v += passo) { <em style="left:@F(Pc(v))%">@Eixo(v)</em> }
            </div>
        </div>
    };

    // ================= gráficos de vendas × budget =================

    private static (string Fundo, string Tinta) CorDaCelula(decimal v, decimal max)
    {
        if (v < 0) return ("#fdecec", "#b42318");
        var t = (double)Math.Clamp(v / max, 0m, 1m);
        var i = (int)Math.Round(t * (Rampa.Length - 1));
        return (Rampa[i], i >= 6 ? "#ffffff" : "#172B43");
    }

    /// <summary>Um passo "redondo" para o eixo (em R$), para ~4 linhas de grade.</summary>
    private static decimal Passo(decimal max)
    {
        var alvo = max / 4m;
        foreach (var p in new[] { 1e6m, 2e6m, 5e6m, 10e6m, 20e6m, 25e6m, 50e6m, 100e6m, 200e6m, 250e6m, 500e6m })
            if (p >= alvo) return p;
        return 1e9m;
    }

    private sealed record Serie(int Ano, string Pontos, double FimX, double FimY, decimal Fim);
    private sealed record GraficoAcumulado(double W, double H, double X0, double Topo, double Base, double Passo, Func<int, double> Xm, Func<decimal, double> Y,
        List<(decimal V, double Y)> Ticks, List<Serie> Series, Dictionary<int, decimal[]> Valores);

    private GraficoAcumulado Acumulado(ResumoDoAno foco)
    {
        const double W = 1100, H = 320, X0 = 64, Topo = 16, Base = 282;
        var passoX = (W - 110 - X0) / 12;
        double Xm(int m) => X0 + passoX * (m - 0.5);
        var valores = new Dictionary<int, decimal[]>();
        foreach (var a in _anos.Where(a => a.MesesComVendas > 0 && AnoVisivel(a.Ano)))
        {
            var acum = new decimal[12];
            var soma = 0m;
            for (var m = 1; m <= 12; m++)
            {
                var v = _meses.FirstOrDefault(x => x.Ano == a.Ano && x.Mes == m)?.Vendas;
                soma += v ?? 0m;
                acum[m - 1] = m <= a.UltimoMes ? soma : -1m;
            }
            valores[a.Ano] = acum;
        }
        var max = new[] { valores.Values.SelectMany(v => v).DefaultIfEmpty(0m).Max(), foco.BudgetHsa ?? 0m, foco.BudgetGrupo ?? 0m, 1m }.Max();
        var passo = Passo(max);
        var topoV = Math.Ceiling(max / passo) * passo;
        double Y(decimal v) => Base - (double)(v / topoV) * (Base - Topo);
        var ticks = new List<(decimal, double)>();
        for (var v = 0m; v <= topoV; v += passo) ticks.Add((v, Y(v)));
        var series = valores.Where(kv => kv.Value.Any(v => v >= 0)).Select(kv =>
        {
            var pts = kv.Value.Select((v, i) => (v, i)).Where(p => p.v >= 0).Select(p => $"{F(Xm(p.i + 1))},{F(Y(p.v))}").ToList();
            var ultimo = kv.Value.Select((v, i) => (v, i)).Where(p => p.v >= 0).Last();
            return new Serie(kv.Key, string.Join(" ", pts), Xm(ultimo.i + 1), Y(ultimo.v), ultimo.v);
        }).ToList();
        return new GraficoAcumulado(W, H, X0, Topo, Base, passoX, Xm, Y, ticks, series, valores);
    }

