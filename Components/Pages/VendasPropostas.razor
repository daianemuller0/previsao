    // ================= edição e arquivos =================

    private void MudarMes(int ano, int mes, ChangeEventArgs e)
    {
        var texto = (e.Value?.ToString() ?? "").Trim();
        var v = texto.Length == 0 ? null : VendasMensaisRepository.Numero(texto);
        if (texto.Length > 0 && v is null) { _msgOk = false; _msg = T($"\"{texto}\" não é um número.", $"\"{texto}\" is not a number."); return; }
        if (_aba is "vnb" or "vafm")
        {
            var atual = _vSetorBrl.GetValueOrDefault((ano, mes));
            var vs = new VendaPorSetor { Ano = ano, Mes = mes, Nb = atual?.Nb, Afm = atual?.Afm };
            if (_aba == "vnb") vs.Nb = v; else vs.Afm = v;
            VendasRepo.GravarPorSetor(new[] { vs });
            Carregar();
            _msgOk = true;
            _msg = $"{NomeDoMes(mes)} {ano} ({(_aba == "vnb" ? "NB" : "AFM")}) {T("gravado", "saved")}.";
            return;
        }
        var reg = _brutos.FirstOrDefault(x => x.Ano == ano && x.Mes == mes) ?? new MesDeVendas { Ano = ano, Mes = mes };
        switch (_aba)
        {
            case "vendas": reg.Vendas = v; break;
            case "propostas": reg.Propostas = v is decimal q ? (int)Math.Round(q) : null; break;
            default: reg.ValorProposto = v; break;
        }
        VendasRepo.GravarMeses(new[] { reg });
        Carregar();
        _msgOk = true;
        _msg = $"{NomeDoMes(mes)} {ano} {T("gravado", "saved")}.";
    }

    private void MudarBudget(int ano, bool hsa, ChangeEventArgs e)
    {
        var texto = (e.Value?.ToString() ?? "").Trim();
        var v = texto.Length == 0 ? null : VendasMensaisRepository.Numero(texto);
        if (texto.Length > 0 && v is null) { _msgOk = false; _msg = T($"\"{texto}\" não é um número.", $"\"{texto}\" is not a number."); return; }
        var b = _budgets.FirstOrDefault(x => x.Ano == ano) ?? new BudgetDoAno { Ano = ano };
        if (hsa) b.Hsa = v; else b.Grupo = v;
        VendasRepo.GravarBudgets(new[] { b });
        Carregar();
        _msgOk = true;
        _msg = En ? $"{(hsa ? "HSA" : "Group")} budget {ano} saved." : $"Budget {(hsa ? "HSA" : "Grupo")} {ano} gravado.";
    }

    private void AcrescentarAno() => _anosEditor.Add(_anosEditor.DefaultIfEmpty(AnoIni - 1).Max() + 1);

    private async Task Importar(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(ms);
            var tipo = _aba switch
            {
                "propostas" => VendasMensaisRepository.TipoDeImportacao.Propostas,
                "valor" => VendasMensaisRepository.TipoDeImportacao.ValorProposto,
                "vnb" or "vafm" => VendasMensaisRepository.TipoDeImportacao.VendasPorSetor,
                _ => VendasMensaisRepository.TipoDeImportacao.Vendas,
            };
            var (meses, budgets, avisos) = VendasRepo.Importar(ms.ToArray(), e.File.Name, tipo);
            Carregar();
            _msgOk = meses + budgets > 0;
            _msg = _msgOk
                ? (En ? $"{e.File.Name}: {meses} month(s)" + (budgets > 0 ? $" and {budgets} budget(s)" : "") + " saved."
                      : $"{e.File.Name}: {meses} mês(es)" + (budgets > 0 ? $" e {budgets} budget(s)" : "") + " gravado(s).") + (avisos.Count > 0 ? " " + string.Join(" ", avisos.Take(3)) : "")
                : T($"Nada importado de {e.File.Name}. {string.Join(" ", avisos.Take(3))}", $"Nothing imported from {e.File.Name}. {string.Join(" ", avisos.Take(3))}");
        }
        catch (Exception ex) { _msgOk = false; _msg = T("Não deu para ler a planilha: ", "Could not read the spreadsheet: ") + ex.Message; }
    }

    // ================= apresentação (PowerPoint) =================
    // Cada slide leva a foto do quadro da tela (wwwroot/apresentacao.js). Aqui só se
    // passa a página por cada estado (as 4 métricas do gráfico mensal) e se pede a foto.

    private string FiltrosTxt()
    {
        var partes = new List<string>();
        void Add(string rot, HashSet<string> set) { if (set.Count > 0) partes.Add($"{rot}: {string.Join(", ", set.Take(4))}{(set.Count > 4 ? $" +{set.Count - 4}" : "")}"); }
        Add(T("Ano", "Year"), _fil.Anos);
        if (_fil.Meses.Count > 0)   // os valores do filtro Mês são os nomes em português: na tela em inglês, mostra o nome em inglês
            partes.Add($"{T("Mês", "Month")}: {string.Join(", ", _fil.Meses.Take(4).Select(MesDoFiltroTxt))}{(_fil.Meses.Count > 4 ? $" +{_fil.Meses.Count - 4}" : "")}");
        Add(T("Setor", "Sector"), _fil.Origens); Add(T("Vendedor", "Salesperson"), _fil.Vendedores); Add("BU", _fil.Bus);
        Add("BU Intercompany", _fil.BuIcs); Add(T("Mercado", "Market"), _fil.Mercados); Add(T("País", "Country"), _fil.Paises); Add(T("Produto", "Product"), _fil.Produtos);
        return partes.Count == 0 ? T("Sem filtros (todas as propostas)", "No filters (all proposals)") : string.Join(" · ", partes);
    }

    /// <summary>Um valor do filtro Mês (nome em português, Fmt.MonthLong) como aparece na tela: em inglês, o nome em inglês.</summary>
    private string MesDoFiltroTxt(string valor)
    {
        if (!En) return valor;
        var m = Enumerable.Range(1, 12).FirstOrDefault(i => Fmt.MonthLong(i) == valor);
        return m > 0 ? NomeDoMes(m) : valor;
    }

