@page "/vendas-propostas"
@attribute [Authorize(Roles = "admin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Text
@inject VendasMensaisRepository VendasRepo
@inject ConversaoService Conv
@inject CambioAnualRepository Cambio
@inject IJSRuntime JS
@inject ChartPrefsRepository ChartPrefs

@* ===========================================================================
   Vendas × Propostas · mesmo padrão visual da guia Conversão (cvx).
   Primeira informação: propostas enviadas (quantidade e valor) e vendas,
   mês a mês (uma linha por ano, 2022 em diante) e ano a ano.
   As propostas vêm das planilhas da guia Conversão (AFM e NB, data de envio);
   as vendas e os budgets, do histórico da equipe (editável aqui).
   =========================================================================== *@

<PageTitle>Performance Comercial · Howden South America</PageTitle>

<div class="cvx vp-page">
    <div class="breadcrumbs"><span>Executivo</span><span class="sep">/</span><span>Performance Comercial</span></div>
    <div class="page-head">
        <div>
            <h1>Performance Comercial | Howden South America</h1>
            <p class="subtitle">
                Resultados, indicadores e oportunidades de crescimento · @Periodo · valores em R$<br />
                Propostas: planilhas da guia Conversão (AFM e NB), pela data de envio@(Conv.AtualizadoEm is { } quando ? $" · atualizadas em {quando:dd/MM/yyyy 'às' HH:mm}" : "") · Vendas e budgets: histórico da equipe
            </p>
        </div>
        <div class="page-actions">
            <button class="btn-ghost" title="Reler as planilhas de propostas" disabled="@_carregando" @onclick="Reler">@Icons.Svg("import")@(_carregando ? "Atualizando…" : "Atualizar")</button>
            <button class="btn-ghost" @onclick="Exportar">@Icons.Svg("download")Exportar Excel</button>
            <button class="btn-ghost" disabled="@_gerandoPpt" title="Gera uma apresentação com os gráficos e os dados desta tela (com os filtros atuais)" @onclick="ExportarPowerPoint">@Icons.Svg("download")@(_gerandoPpt ? "Gerando…" : "Apresentação (PowerPoint)")</button>
            <button class="btn-primary" @onclick="() => { _editando = !_editando; _msg = null; }">@(_editando ? "✕ Fechar edição" : "✎ Atualizar dados")</button>
        </div>
    </div>

    @if (_gerandoPpt) { <div class="vp-gerando" role="status"><div><b>Gerando a apresentação…</b><span>Fotografando os gráficos da tela. Leva alguns segundos; não feche a página.</span></div></div> }
    @if (_msg is not null) { <div class="cvx-alert @(_msgOk ? "vp-ok" : "erro")">@_msg</div> }

    @* filtros da guia Conversão (mesma barra, congelada no topo): valem para as propostas e as seções de conversão *@
    <Conversao Embutido="true" Parte="filtros" Filtros="_fil" FiltrosMudaram="AoMudarFiltros" />

    @if (_anos.Count == 0)
    {
        <div class="cvx-card"><div class="empty" style="padding:34px 12px">Sem dados de vendas nem de propostas.</div></div>
    }
    else
    {
        var foco = AnoDoFoco;
        var linhaFoco = Linha(foco.Ano);
        var mesLim = MesLimite(foco.Ano);
        var anoAnt = foco.Ano - 1;
        var qtdAnt = AnoIni <= anoAnt ? QtdAte(anoAnt, mesLim) : (int?)null;
        var valAnt = AnoIni <= anoAnt ? ValorAte(anoAnt, mesLim) : null;
        var vendAnt = AnoIni <= anoAnt && foco.UltimoMes > 0 ? ConversaoDeVendas.AteOMes(_meses, anoAnt, foco.UltimoMes) : 0m;
        var periodo = mesLim < 12 ? $"jan–{MesCurto(mesLim).ToLowerInvariant()}" : "ano inteiro";
        var periodoVendas = foco.UltimoMes is > 0 and < 12 ? $"jan–{MesCurto(foco.UltimoMes).ToLowerInvariant()}" : "ano inteiro";

        <div class="cvx-filters vp-foco">
            <div class="flt"><span class="flt-label">Ano em foco</span>
                <div class="cvx-seg-ctl">
                    @foreach (var a in AnosDoPainel)
                    {
                        var ano = a;
                        <button class="@(ano == _foco ? "on" : "")" @onclick="() => { _foco = ano; _dica = null; }">@ano</button>
                    }
                </div>
            </div>
            <span class="cvx-note">O filtro de Ano escolhe os anos da página. Os outros filtros valem para as propostas e as taxas; vendas e metas são da empresa toda. Comparações com o mesmo período de @anoAnt.</span>
        </div>

        @if (_carregando && _enviadas.Count == 0) { <div class="cvx-alert">Lendo as planilhas de propostas…</div> }
        @if (AnosSemTaxa() is { Count: > 0 } semTaxa)
        {
            <div class="cvx-alert">
                <strong>Valor enviado parcial em @string.Join(", ", semTaxa.Select(s => s.Ano)):</strong>
                @string.Join(" · ", semTaxa.Select(s => $"{N0(s.Qtd)} proposta(s) do AFM em {s.Ano} sem taxa de câmbio")).
                Elas contam na quantidade, mas ficam fora do valor. Cadastre a taxa USD/BRL desses anos na guia Conversão (botão “Taxas de câmbio”).
            </div>
        }

        <div class="cvx-page">

        @* ================= 1 · PROPOSTAS ENVIADAS (o principal) ================= *@
        <section id="propostas" class="cvx-sec">
            <div class="xsec lvl1"><span class="xsec-t">Propostas enviadas</span><span class="xsec-s">Quantidade, valor enviado e vendas · mês a mês e ano a ano · @Periodo</span><span class="xsec-line"></span></div>

            <div class="cvx-kpis">
                @Kpi($"Propostas enviadas · {foco.Ano}", linhaFoco.Qtd is int qk ? N0(qk) : "—", $"{periodo}{(_setor == "" ? "" : " · " + _setor)}",
                    "Propostas com data de envio no ano (cada número de proposta conta uma vez)", CorTx, Delta(QtdAte(foco.Ano, mesLim), qtdAnt, anoAnt))
                @Kpi($"Valor enviado · {foco.Ano}", linhaFoco.Valor is decimal vk ? Mi(vk) : "—", linhaFoco.SemTaxa > 0 ? $"{periodo} · parcial: {N0(linhaFoco.SemTaxa)} sem taxa de câmbio" : periodo,
                    "Soma do valor das propostas enviadas no ano, em R$", "#155A96", Delta(ValorAte(foco.Ano, mesLim), valAnt, anoAnt))
                @Kpi($"Vendas · {foco.Ano}", foco.MesesComVendas > 0 ? Mi(foco.Vendas) : "—", $"{periodoVendas}{(foco.BudgetHsa is > 0 ? $" · {Pct(foco.Vendas / foco.BudgetHsa!.Value)} do budget HSA" : "")}",
                    "Vendas da empresa no ano (histórico da equipe)", "#1f9254", Delta(foco.Vendas, vendAnt, anoAnt))
                @Kpi($"Valor médio por proposta · {foco.Ano}", linhaFoco.Qtd is > 0 && linhaFoco.Valor is decimal vm && linhaFoco.ComValor > 0 ? Mi(vm / linhaFoco.ComValor) : "—",
                    $"{periodo} · valor enviado ÷ propostas com valor", "Média do valor das propostas enviadas no ano (R$)", "#2478B8",
                    AnoIni <= anoAnt ? Delta(MedioAte(foco.Ano, mesLim), MedioAte(anoAnt, mesLim), anoAnt) : null)
                @Kpi($"Venda por proposta · {foco.Ano}", linhaFoco.VendaPorProposta is decimal vpp ? Mi(vpp) : "—", $"{periodoVendas} · vendas ÷ propostas enviadas, nos meses com as duas",
                    "Quanto foi vendido (R$) para cada proposta enviada, só nos meses que têm venda e propostas", "#007A9E")
                @{ var txFoco = Taxa(foco.Ano); var txFocoAnt = Taxa(anoAnt, mesLim); var txFocoAte = Taxa(foco.Ano, mesLim); }
                @Kpi($"Taxa de conversão · {foco.Ano}", txFoco.Taxa is double tq ? P1(tq) : "Não calculável",
                    $"{N0(txFoco.G)} ganhas / {N0(txFoco.Base)} {DenRot}{(txFoco.TaxaValor is double tv ? $" · por valor {P1(tv)}" : "")}",
                    BaseTodas ? "Taxa de Conversão = Ganhas ÷ todas as propostas enviadas × 100 (ganhas, perdidas, abertas e não classificadas)."
                              : "Taxa de Conversão = Ganhas ÷ (Ganhas + Perdidas) × 100 — a mesma regra da guia Conversão. Propostas abertas e não classificadas não entram no denominador.",
                    CorTx, DeltaPp(txFocoAte.Taxa, txFocoAnt.Taxa, anoAnt))
            </div>

            @* o mês de relance: vendas e propostas de cada mês, um ano, dois anos comparados ou todos os anos *@
            <div class="panel vp-principal vpm" id="mes-a-mes">
                @SecaoMesAMes(foco.Ano)
            </div>

            <div class="panel vp-principal" id="mensal">
                <div class="panel-head">
                    <div class="panel-title">@TituloGrafico()
                        <span class="hint">uma linha por ano · jan a dez · @(_met switch { "vendas" => "vendas da empresa no mês · R$", "valor" => "mês de envio da proposta · R$", "taxa" => BaseTodas ? "ganhas ÷ todas as propostas enviadas no mês" : "ganhas ÷ decididas do mês", _ => "mês de envio da proposta" })@(_met != "vendas" && _setor != "" ? " · " + _setor : "")</span>
                    </div>
                    <div class="rep-attain-group">
                        <div class="rep-attain-box">
                            <span class="ra-label">Propostas enviadas (@foco.Ano)</span>
                            <span class="ra-value" style="color:@CorDoAno(foco.Ano)">@(linhaFoco.Qtd is int qh ? N0(qh) : "—")</span>
                        </div>
                        <div class="rep-attain-box">
                            <span class="ra-label">Valor enviado (@foco.Ano)</span>
                            <span class="ra-value" style="color:@CorDoAno(foco.Ano)">@(linhaFoco.Valor is decimal vh ? Mi(vh) : "—")</span>
                        </div>
                        <div class="rep-attain-box">
                            <span class="ra-label">Vendas (@foco.Ano)</span>
                            <span class="ra-value" style="color:#1f9254">@(foco.MesesComVendas > 0 ? Mi(foco.Vendas) : "—")</span>
                        </div>
                    </div>
                </div>
                <div class="vp-met">
                    <div class="cvx-seg-ctl">
                        <button class="@(_met == "qtd" ? "on" : "")" @onclick='() => _met = "qtd"'>Quantidade de propostas</button>
                        <button class="@(_met == "valor" ? "on" : "")" @onclick='() => _met = "valor"'>Valor enviado (R$)</button>
                        <button class="@(_met == "vendas" ? "on" : "")" @onclick='() => _met = "vendas"'>Vendas (R$)</button>
                        <button class="@(_met == "taxa" ? "on" : "")" @onclick='() => _met = "taxa"'>Taxa de conversão (%)</button>
                    </div>
                    <div class="vp-cores-wrap">
                        <button class="btn-ghost vp-btn-cores" aria-expanded="@(_editCores ? "true" : "false")" @onclick="() => _editCores = !_editCores">🎨 Cores das linhas</button>
                        @if (_editCores)
                        {
                            <div class="flt-multi-backdrop" @onclick="() => _editCores = false"></div>
                            <div class="vp-cores-pop" role="dialog" aria-label="Cores das linhas">
                                <div class="vp-cores-tit">Cor de cada ano</div>
                                @foreach (var a in AnosDoPainel.OrderByDescending(x => x))
                                {
                                    var ano = a;
                                    <label class="vp-cor-lin" title="Cor da linha de @ano">
                                        <input type="color" value="@CorDoAno(ano)" @onchange="e => MudarCor(ano.ToString(), e.Value?.ToString())" />
                                        <span>@ano</span>
                                    </label>
                                }
                                <div class="vp-cores-pe">
                                    <button class="btn-link" disabled="@(!Editaveis.Keys.Any(k => int.TryParse(k, out _)))" @onclick="() => RestaurarCores(AnosDoPainel.Select(a => a.ToString()))">Restaurar cores padrão</button>
                                    <button class="btn-primary" @onclick="() => _editCores = false">Concluir</button>
                                </div>
                                <div class="vp-cores-nota">@NotaCores</div>
                            </div>
                        }
                    </div>
                    <span class="cvx-note">Ano em foco (@foco.Ano) com área e valores; troque o ano no filtro acima. Passe o mouse num mês para ver todos os anos.</span>
                </div>
                <div class="chart-body">@((MarkupString)SvgAnos(_met, foco.Ano))</div>

                @* ano a ano, embaixo do gráfico: taxa de conversão + valor enviado, valor médio e vendas, um cartão por ano na cor da linha *@
                <div class="vp-anos-tit">Taxa de conversão e resultados, ano a ano <span>@RegraTxt · @(BaseTodas ? "todas as propostas" : "só as decididas") (botão "Taxa sobre" no filtro)@(_setor != "" ? " · " + _setor : "")</span></div>
                <div class="vp-conv-grid">
                    @foreach (var a in AnosDoPainel)
                    {
                        var ano = a;
                        var c = Composicao(a);
                        var limC = MesLimite(a);
                        var dC = a - 1 >= AnoIni ? DeltaPp(Taxa(a, limC).Taxa, Taxa(a - 1, limC).Taxa, null) : null;
                        var baseBarra = Math.Max(1, c.Total);
                        <button type="button" class="vp-conv-card @(a == foco.Ano ? "foco" : "")" style="--ac:@CorDoAno(a)" @onclick="() => { _foco = ano; _dica = null; }">
                            <div class="vp-cc-ano">@a@if (a == DateTime.Today.Year) { <small>até @MesCurto(limC).ToLowerInvariant()</small> }</div>
                            <div class="vp-cc-taxa">
                                <b>@(c.Taxa is double t ? P1(t) : "—")</b>
                                @if (dC is not null) { <em class="@DeltaCls(dC)">@Seta(dC)</em> }
                            </div>
                            <div class="vp-cc-sub">@N0(c.G) ganhas de @N0(c.Base) @DenRot</div>
                            <div class="vp-cc-barra" title="@($"Ganhas {N0(c.G)} · Perdidas {N0(c.P)} · Abertas {N0(c.A)}" + (c.NC > 0 ? $" · Não classificadas {N0(c.NC)}" : ""))">
                                <i style="width:@F(c.G * 100.0 / baseBarra)%;background:#1f9254"></i><i style="width:@F(c.P * 100.0 / baseBarra)%;background:#6FB3DC"></i><i style="width:@F(c.A * 100.0 / baseBarra)%;background:#007A9E"></i><i style="width:@F(c.NC * 100.0 / baseBarra)%;background:#c3ccd8"></i>
                            </div>
                            <div class="vp-cc-linhas">
                                <span>Propostas enviadas</span><b>@N0(c.Total)</b>
                                <span><i style="background:#1f9254"></i>Ganhas</span><b>@N0(c.G)</b>
                                <span><i style="background:#6FB3DC"></i>Perdidas</span><b>@N0(c.P)</b>
                                <span><i style="background:#007A9E"></i>Abertas</span><b>@N0(c.A)</b>
                            </div>
                        </button>
                    }
                </div>
                <div class="vp-cc-leg"><span><i style="background:#1f9254"></i>Ganhas</span><span><i style="background:#6FB3DC"></i>Perdidas</span><span><i style="background:#007A9E"></i>Abertas</span><span>Variação em pontos percentuais contra o mesmo período do ano anterior · clique num ano para colocá-lo em foco</span></div>
                <p class="cvx-note" style="margin-top:8px">Propostas: @_fonte. Cada número de proposta conta uma vez, no mês da data de envio.</p>
            </div>

            @* ano a ano por setor (AFM × NB) e os valores: o que antes ficava embaixo dos cartões da taxa *@
            <div class="panel vp-principal" id="setores">
                <div class="panel-head">
                    <div class="panel-title">AFM × NB e valores, ano a ano
                        <span class="hint">AFM = planilha de Aftermarket · NB = planilha de New Business · valores em R$ · taxa: @RegraTxt@(_setor != "" ? " · " + _setor : "")</span>
                    </div>
                </div>
                <div class="vp-conv-grid vp-setores">
                    @foreach (var a in AnosDoPainel)
                    {
                        var ano = a;
                        var limC = MesLimite(a);
                        var c = Composicao(a);
                        var l = Linha(a);
                        var r = _anos.FirstOrDefault(x => x.Ano == a);
                        var dVal = a - 1 >= AnoIni && l.SemTaxa == 0 ? DeltaCurto(ValorAte(a, limC), ValorAte(a - 1, limC)) : null;
                        var dVen = a - 1 >= AnoIni && r is { MesesComVendas: > 0 } ? DeltaCurto(r.Vendas, ConversaoDeVendas.AteOMes(_meses, a - 1, r.UltimoMes)) : null;
                        var sa = PorSetor(a, ConversaoService.Afm); var sn = PorSetor(a, ConversaoService.Nb); var totSet = Math.Max(1, sa.Total + sn.Total);
                        <button type="button" class="vp-conv-card @(a == foco.Ano ? "foco" : "")" style="--ac:@CorDoAno(a)" @onclick="() => { _foco = ano; _dica = null; }">
                            <div class="vp-cc-ano">@a@if (a == DateTime.Today.Year) { <small>até @MesCurto(limC).ToLowerInvariant()</small> }</div>
                            @{ var pa = sa.Total * 100.0 / totSet; var pn = sn.Total * 100.0 / totSet; }
                            <div class="vp-cc-setor" title="AFM = planilha de Aftermarket · NB = planilha de New Business">
                                <div class="vp-cs-barra grossa">
                                    @if (sa.Total + sn.Total > 0)
                                    {
                                        <i style="width:@F(pa)%;background:@CorAfm" title="AFM: @N0(sa.Total) propostas (@Math.Round(pa)%)">@(pa >= 14 ? Math.Round(pa) + "%" : "")</i><i style="width:@F(pn)%;background:@CorNb" title="NB: @N0(sn.Total) propostas (@Math.Round(pn)%)">@(pn >= 14 ? Math.Round(pn) + "%" : "")</i>
                                    }
                                </div>
                                <div class="vp-cs-grade">
                                    <span></span><b class="cab"><i style="background:@CorAfm"></i>AFM</b><b class="cab"><i style="background:@CorNb"></i>NB</b>
                                    <span>Taxa</span><b class="tx">@(sa.Taxa is double ta ? P1(ta) : "—")</b><b class="tx">@(sn.Taxa is double tn ? P1(tn) : "—")</b>
                                    <span>Propostas</span><b>@N0(sa.Total)</b><b>@N0(sn.Total)</b>
                                    <span>Ganhas</span><b>@N0(sa.G)</b><b>@N0(sn.G)</b>
                                    <span>Valor enviado</span><b title="@(sa.Valor > 0 ? Cheio(sa.Valor) : "")">@(sa.Valor > 0 ? MiEixo(sa.Valor) : "—")@if (sa.SemTaxa > 0) { <em class="vp-parcial" title="@N0(sa.SemTaxa) proposta(s) sem taxa de câmbio do ano">parcial</em> }</b><b title="@(sn.Valor > 0 ? Cheio(sn.Valor) : "")">@(sn.Valor > 0 ? MiEixo(sn.Valor) : "—")</b>
                                </div>
                            </div>
                            <div class="vp-cc-valor">
                                <span>Valor ganho</span><b>@(c.VG > 0 ? Mi((decimal)c.VG) : "—")</b>
                                <span>Por valor</span><b>@(c.TaxaValor is double tvc ? P1(tvc) : "—")</b>
                            </div>
                            <div class="vp-cc-valor">
                                <span>Valor enviado</span><b>@(l.Valor is decimal vv ? Mi(vv) : "—")@if (l.SemTaxa > 0) { <em class="vp-parcial" title="@N0(l.SemTaxa) proposta(s) do AFM sem taxa de câmbio do ano: fora do valor">parcial</em> } else if (dVal is not null) { <em class="@DeltaCls(dVal)">@Seta(dVal)</em> }</b>
                                <span>Valor médio</span><b>@(l.Valor is decimal vm2 && l.ComValor > 0 ? Mi(vm2 / l.ComValor) : "—")</b>
                                <span>Vendas@(r is { UltimoMes: > 0 and < 12 } ? $" (até {MesCurto(r.UltimoMes).ToLowerInvariant()})" : "")</span><b>@(r is { MesesComVendas: > 0 } ? Mi(r.Vendas) : "—")@if (dVen is not null) { <em class="@DeltaCls(dVen)">@Seta(dVen)</em> }</b>
                            </div>
                        </button>
                    }
                </div>
                <div class="vp-cc-leg"><span><i style="background:@CorAfm"></i>AFM</span><span><i style="background:@CorNb"></i>NB</span><span>Barra: divisão das propostas enviadas entre AFM e NB · “parcial” = há propostas do AFM sem taxa de câmbio do ano · variação contra o mesmo período do ano anterior · clique num ano para colocá-lo em foco</span></div>
            </div>

            @{
                var pctGrupo = foco.PctGrupo; var pctHsa = foco.PctHsa;
            }
            <div class="panel vp-principal" id="metas">
                <div class="panel-head">
                    <div class="panel-title">Vendas totais × metas, ano a ano
                        <span class="hint">vendas da empresa × Meta Grupo e Meta HSA · R$ · @Periodo</span>
                    </div>
                    <div class="rep-attain-group">
                        <div class="rep-attain-box">
                            <span class="ra-label">Atend. Meta Grupo (@foco.Ano)</span>
                            <span class="ra-value" style="color:#172B43">@(pctGrupo is decimal pg0 ? Pct(pg0) : "—")</span>
                        </div>
                        <div class="rep-attain-box">
                            <span class="ra-label">Atend. Meta HSA (@foco.Ano)</span>
                            <span class="ra-value" style="color:#172B43">@(pctHsa is decimal ph0 ? Pct(ph0) : "—")</span>
                        </div>
                    </div>
                </div>
                <div class="vp-met">
                    <div class="vp-cores-wrap">
                        <button class="btn-ghost vp-btn-cores" aria-expanded="@(_editCoresMetas ? "true" : "false")" @onclick="() => _editCoresMetas = !_editCoresMetas">🎨 Cores das barras</button>
                        @if (_editCoresMetas)
                        {
                            <div class="flt-multi-backdrop" @onclick="() => _editCoresMetas = false"></div>
                            <div class="vp-cores-pop" role="dialog" aria-label="Cores das barras">
                                <div class="vp-cores-tit">Cor da barra e das metas</div>
                                @foreach (var sm in SeriesMetas)
                                {
                                    var chave = sm.Chave;
                                    <label class="vp-cor-lin"><input type="color" value="@CorMeta(chave)" @onchange="e => MudarCor(chave, e.Value?.ToString())" /><span>@sm.Nome</span></label>
                                }
                                <div class="vp-cores-pe">
                                    <button class="btn-link" disabled="@(!SeriesMetas.Any(x => Editaveis.ContainsKey(x.Chave)))" @onclick="() => RestaurarCores(SeriesMetas.Select(x => x.Chave))">Restaurar cores padrão</button>
                                    <button class="btn-primary" @onclick="() => _editCoresMetas = false">Concluir</button>
                                </div>
                                <div class="vp-cores-nota">@NotaCores</div>
                            </div>
                        }
                    </div>
                    <span class="cvx-note">@(foco.UltimoMes is > 0 and < 12 ? $"{foco.Ano} até {NomeDoMes(foco.UltimoMes).ToLowerInvariant()} (vendas até o último mês fechado). " : "")A barra é o vendido; os traços, onde ficam as metas. Clique num ano para colocá-lo em foco.</span>
                </div>
                @MetasExecutivo(foco.Ano)
            </div>

        </section>

        @* ================= conversão: BU, mercado | produto, país, perdas e base (componente da guia Conversão) ================= *@
        <Conversao Embutido="true" Parte="secoes" Filtros="_fil" FiltrosMudaram="AoMudarFiltros" LinhasVisiveis="5" />

        @* ================= 3 · VENDAS × BUDGET ================= *@
        <section id="budget" class="cvx-sec">
            <div class="xsec"><span class="xsec-t">Vendas × budget</span><span class="xsec-s">O ritmo de @foco.Ano contra os anos anteriores e os budgets HSA e Grupo</span><span class="xsec-line"></span></div>
            <div>
                @{ var ac = Acumulado(foco); }
                <div class="cvx-card">
                    <div class="cvx-ch"><div><h3 class="cvx-h3">Acumulado no ano</h3><p>Vendas somadas mês a mês</p></div></div>
                    <div class="cvx-leg" style="margin:0 0 6px">
                        <span><i class="cvx-ln" style="border-top-color:@CorFoco"></i>@foco.Ano</span>
                        @if (AnoVisivel(anoAnt) && _anos.Any(a => a.Ano == anoAnt && a.MesesComVendas > 0)) { <span><i class="cvx-ln dash" style="border-top-color:@CorAnterior"></i>@anoAnt</span> }
                        <span><i class="cvx-ln" style="border-top-color:@CorOutros"></i>outros anos</span>
                        <span><i class="cvx-ln" style="border-top-color:#172B43;border-top-width:1.5px"></i>budget HSA</span>
                        <span><i class="cvx-ln dash" style="border-top-color:#8493A3;border-top-width:1.5px"></i>budget Grupo</span>
                    </div>
                    <div class="vp-grafico" @onmouseleave='() => SairDe("ac")'>
                        <svg viewBox="0 0 @F(ac.W) @F(ac.H)" role="img" aria-label="Vendas acumuladas por mês, por ano, e os budgets de @foco.Ano">
                            @foreach (var (v, y) in ac.Ticks)
                            {
                                <g>
                                <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(y)" y2="@F(y)" stroke="@(v == 0 ? "#d3dcea" : "#edf1f6")" />
                                <text x="@F(ac.X0 - 8)" y="@F(y + 4)" text-anchor="end" class="vp-eixo">@Eixo(v)</text>
                                </g>
                            }
                            @for (var m = 1; m <= 12; m++)
                            {
                                <g><text x="@F(ac.Xm(m))" y="@F(ac.Base + 18)" text-anchor="middle" class="vp-eixo">@MesCurto(m).ToUpperInvariant()</text></g>
                            }
                            @if (foco.BudgetGrupo is decimal bg)
                            {
                                <g>
                                <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(ac.Y(bg))" y2="@F(ac.Y(bg))" stroke="#8493A3" stroke-dasharray="6 4" />
                                <text x="@F(ac.W - 104)" y="@F(ac.Y(bg) + 4)" class="vp-meta-rot">Grupo @MiEixo(bg)</text>
                                </g>
                            }
                            @if (foco.BudgetHsa is decimal bh)
                            {
                                <g>
                                <line x1="@F(ac.X0)" x2="@F(ac.W - 110)" y1="@F(ac.Y(bh))" y2="@F(ac.Y(bh))" stroke="#172B43" />
                                <text x="@F(ac.W - 104)" y="@F(ac.Y(bh) + 4)" class="vp-meta-rot forte">HSA @MiEixo(bh)</text>
                                </g>
                            }
                            @foreach (var s in ac.Series.OrderBy(s => s.Ano == foco.Ano ? 2 : s.Ano == anoAnt ? 1 : 0))
                            {
                                var cor = s.Ano == foco.Ano ? CorFoco : s.Ano == anoAnt ? CorAnterior : CorOutros;
                                <g>
                                <polyline points="@s.Pontos" fill="none" stroke="@cor" stroke-width="@(s.Ano == foco.Ano ? "3.5" : "2.2")" stroke-dasharray="@(s.Ano == anoAnt ? "6 4" : "")" stroke-linejoin="round" stroke-linecap="round" />
                                @if (s.Ano == foco.Ano || s.Ano == anoAnt)
                                {
                                    <g>
                                    <circle cx="@F(s.FimX)" cy="@F(s.FimY)" r="5" fill="@cor" stroke="#fff" stroke-width="2" />
                                    <text x="@F(s.FimX + 9)" y="@F(s.FimY + (s.Ano == foco.Ano ? 4 : 14))" class="vp-rotulo" fill="@cor">@s.Ano · @MiEixo(s.Fim)</text>
                                    </g>
                                }
                                </g>
                            }
                            @if (_dica?.Grafico == "ac" && _dica.Mes is int mc)
                            {
                                <g><line x1="@F(ac.Xm(mc))" x2="@F(ac.Xm(mc))" y1="@F(ac.Topo)" y2="@F(ac.Base)" stroke="#9aa4b2" /></g>
                            }
                            @for (var m = 1; m <= 12; m++)
                            {
                                var mes = m;
                                <g>
                                <rect x="@F(ac.Xm(m) - ac.Passo / 2)" y="@F(ac.Topo)" width="@F(ac.Passo)" height="@F(ac.Base - ac.Topo)" fill="transparent"
                                      @onmouseenter="() => DicaDoAcumulado(mes, ac, foco.Ano)" />
                                </g>
                            }
                        </svg>
                        @Dica("ac")
                    </div>
                </div>

            </div>

            @{
                var representativos = _anos.Where(a => a.Representativo).ToList();
                var referencia = representativos.Where(a => a.Ano < foco.Ano).OrderByDescending(a => a.Ano).FirstOrDefault()
                                 ?? representativos.FirstOrDefault(a => a.Ano == foco.Ano) ?? representativos.LastOrDefault();
            }
            @if (referencia is not null && referencia.VendaPorProposta is decimal vpr && foco.BudgetHsa is decimal bhs)
            {
                var necessarias = (int)Math.Ceiling(bhs / vpr);
                var faltam = Math.Max(0m, bhs - foco.Vendas);
                <div class="cvx-insight static">
                    <small>Quantas propostas o budget HSA @foco.Ano pede</small>
                    Em <b>@referencia.Ano</b>, cada proposta enviada correspondeu, em média, a <b>@Mi(vpr)</b> em vendas (todas as origens).
                    No mesmo ritmo, o budget HSA de @foco.Ano (@Mi(bhs)) pede <b>≈ @N0(necessarias) propostas</b>@(faltam > 0 ? $"; faltam {Mi(faltam)}, ≈ {N0((int)Math.Ceiling(faltam / vpr))} propostas." : " — budget atingido.")
                </div>
            }
        </section>

        @* ================= 4 · MÊS × ANO ================= *@
        @{
            var anosTabela = _anos.Where(a => AnoVisivel(a.Ano) && (a.MesesComVendas > 0 || a.BudgetHsa is not null)).Select(a => a.Ano).ToList();
            var completos = _anos.Where(a => a.MesesComVendas == 12 && AnoVisivel(a.Ano)).Select(a => a.Ano).ToList();
            var maxMes = _meses.Where(m => m.Vendas is > 0).Select(m => m.Vendas!.Value).DefaultIfEmpty(1m).Max();
        }
        <section id="mes-ano" class="cvx-sec">
            <div class="xsec"><span class="xsec-t">Vendas mês × ano</span><span class="xsec-s">Como a planilha da equipe · quanto mais escuro, maior a venda do mês</span><span class="xsec-line"></span></div>
            <div class="cvx-card">
                <div class="cvx-ch">
                    <div><p>A média é dos anos fechados (@(completos.Count > 0 ? $"{completos.Min()}–{completos.Max()}" : "—")).</p></div>
                    <div class="vp-escala" aria-hidden="true"><span>menor</span>@foreach (var c in Rampa) { <i style="background:@c"></i> }<span>maior</span></div>
                </div>
                <table class="vp-tabela">
                    <thead>
                        <tr>
                            <th>Mês</th>
                            @foreach (var a in anosTabela) { <th class="r @(a == foco.Ano ? "foco" : "")">@a</th> }
                            <th class="r vp-media">Média</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var mes = m;
                            <tr>
                                <th>@NomeDoMes(m)</th>
                                @foreach (var a in anosTabela)
                                {
                                    var v = _meses.FirstOrDefault(x => x.Ano == a && x.Mes == mes)?.Vendas;
                                    @if (v is decimal val)
                                    {
                                        var (fundo, tinta) = CorDaCelula(val, maxMes);
                                        <td class="r vp-cel" style="background:@fundo;color:@tinta" title="@NomeDoMes(mes) @a: @Cheio(val)">@if (val < 0) { <span aria-hidden="true">▼ </span> }@MiEixo(val)</td>
                                    }
                                    else { <td class="r vp-cel vazia">—</td> }
                                }
                                @{ var media = _meses.Where(x => completos.Contains(x.Ano) && x.Mes == mes && x.Vendas is not null).Select(x => x.Vendas!.Value).DefaultIfEmpty().Average(); }
                                <td class="r vp-media">@(completos.Count > 0 ? MiEixo(media) : "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="vp-tot"><th>Total</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@MiEixo(r.Vendas)</td> }<td class="r vp-media">@(completos.Count > 0 ? MiEixo(_anos.Where(x => completos.Contains(x.Ano)).Average(x => x.Vendas)) : "—")</td></tr>
                        <tr><th>Budget HSA</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@(r.BudgetHsa is decimal b ? MiEixo(b) : "—")</td> }<td></td></tr>
                        <tr><th>% do budget HSA</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@MedidorFino(r.PctHsa)</td> }<td></td></tr>
                        <tr><th>Budget Grupo</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@(r.BudgetGrupo is decimal b ? MiEixo(b) : "—")</td> }<td></td></tr>
                        <tr><th>% do budget Grupo</th>@foreach (var a in anosTabela) { var r = _anos.First(x => x.Ano == a); <td class="r">@MedidorFino(r.PctGrupo)</td> }<td></td></tr>
                    </tfoot>
                </table>
            </div>
        </section>

        @if (_editando)
        {
            <section id="editar" class="cvx-sec">
                <div class="xsec"><span class="xsec-t">Atualizar dados</span><span class="xsec-s">Digite os valores por mês (R$ cheios, ex.: 33.253.000) ou importe a planilha no layout da equipe: coluna "Mês" e uma coluna por ano</span><span class="xsec-line"></span></div>
                <div class="cvx-card">
                    <div class="cvx-ch">
                        <div class="cvx-seg-ctl">
                            @foreach (var (cod, nome) in new[] { ("vendas", "Vendas"), ("propostas", "Propostas enviadas"), ("valor", "Valor enviado"), ("budgets", "Budgets") })
                            {
                                var c = cod;
                                <button class="@(_aba == c ? "on" : "")" @onclick="() => _aba = c">@nome</button>
                            }
                        </div>
                    </div>
                    @if (_aba == "budgets")
                    {
                        <table class="cvx-tbl vp-ed">
                            <thead><tr><th>Ano</th><th class="r">Budget HSA (R$)</th><th class="r">Budget Grupo (R$)</th></tr></thead>
                            <tbody>
                                @foreach (var a in _anosEditor)
                                {
                                    var ano = a;
                                    var b = _budgets.FirstOrDefault(x => x.Ano == ano);
                                    <tr>
                                        <td><b>@a</b></td>
                                        <td class="r"><input class="cell num" value="@Campo(b?.Hsa)" @onchange="e => MudarBudget(ano, true, e)" /></td>
                                        <td class="r"><input class="cell num" value="@Campo(b?.Grupo)" @onchange="e => MudarBudget(ano, false, e)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <table class="cvx-tbl vp-ed">
                            <thead><tr><th>Mês</th>@foreach (var a in _anosEditor) { <th class="r">@a</th> }</tr></thead>
                            <tbody>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    var mes = m;
                                    <tr>
                                        <td><b>@NomeDoMes(m)</b></td>
                                        @foreach (var a in _anosEditor)
                                        {
                                            var ano = a;
                                            var reg = _brutos.FirstOrDefault(x => x.Ano == ano && x.Mes == mes);
                                            var sist = _meses.FirstOrDefault(x => x.Ano == ano && x.Mes == mes);
                                            var valor = _aba switch { "vendas" => Campo(reg?.Vendas), "propostas" => reg?.Propostas?.ToString(Br) ?? "", _ => Campo(reg?.ValorProposto) };
                                            var dica = reg?.Propostas is null && sist?.FonteDasPropostas == "sistema"
                                                ? _aba switch { "propostas" => $"planilhas: {sist.Propostas}", "valor" => sist.ValorProposto is decimal vs ? $"planilhas: {Campo(Math.Round(vs))}" : "", _ => "" } : "";
                                            <td class="r"><input class="cell num" value="@valor" placeholder="@dica" @onchange="e => MudarMes(ano, mes, e)" /></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_aba != "vendas") { <p class="cvx-note">Vazio = vale a contagem das planilhas da guia Conversão (o número em cinza). Digitar um valor troca a das planilhas naquele mês.</p> }
                    }
                    <div class="vp-editor-pe">
                        <button class="btn-ghost" @onclick="AcrescentarAno">+ ano @((_anosEditor.LastOrDefault() + 1).ToString())</button>
                        <label class="vp-drop">
                            <InputFile OnChange="Importar" accept=".xlsx,.xlsm,.xls,.csv" />
                            <span>⇪ <strong>Importar planilha</strong> de @(_aba switch { "propostas" => "propostas enviadas", "valor" => "valor enviado", _ => "vendas (com BUDGET HSA e BUDGET GRUPO)" })</span>
                        </label>
                    </div>
                </div>
            </section>
        }
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Br = new("pt-BR");
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    /// <summary>O projeto começa em 2022: nada antes disso entra no painel.</summary>
    private const int AnoIni = 2022;
    private static int AnoFim => DateTime.Today.Year;

    // paleta da guia Conversão: ano atual em azul-marinho, anteriores em azuis/cinzas mais claros
    private const string CorTx = "#12355B", CorFoco = "#12355B", CorAnterior = "#4F7AA8", CorOutros = "#C9D3DE", CorContexto = "#B3C0D1";
    private static readonly string[] Rampa = { "#EEF3F9", "#DCE6F1", "#C9D8EA", "#B3C7DE", "#9BB4D2", "#83A1C5", "#6B8DB7", "#5479A8", "#3F6597", "#2C5283", "#1D416D", "#12355B" };

    private List<MesDeVendas> _brutos = new();
    private List<BudgetDoAno> _budgets = new();
    private List<ResumoDoMes> _meses = new();
    private List<ResumoDoAno> _anos = new();
    private List<ConversaoDeVendas.PropostaEnviada> _enviadas = new();
    private List<ConversaoDeVendas.PropostaEnviada> _enviadasSetor = new();
    private Dictionary<(int Ano, int Mes), PropMes> _porMes = new();
    /// <summary>As linhas das planilhas da guia Conversão (sem juntar números repetidos, como na própria guia), para a taxa de conversão.</summary>
    private sealed record LinhaConv(int Ano, int Mes, string Origem, ClasseProposta Classe, double? Brl);
    private List<LinhaConv> _conv = new(), _convSetor = new();
    private bool _gerandoPpt;
    private string _fonte = "";
    private int _foco;
    private bool _editando, _msgOk, _carregando;
    private string? _msg;
    private string _aba = "vendas", _met = "qtd";
    /// <summary>Filtros da guia Conversão, compartilhados com a barra e as seções embutidas.</summary>
    private readonly FiltrosConversao _fil = new() { AnoMinimo = AnoIni };
    /// <summary>
    /// "" sem filtro; senão um rótulo curto (as vendas não seguem os filtros, então as relações com elas só valem sem filtro).
    /// O filtro de Ano não conta: ele só escolhe quais anos a página mostra, não muda as propostas de cada ano.
    /// </summary>
    private string _setor => _fil.Ativos - (_fil.Anos.Count > 0 ? 1 : 0) > 0 ? "filtrado" : "";
    /// <summary>O ano aparece na página? (filtro de Ano vazio = todos, de 2022 até hoje)</summary>
    private string _anosFiltrados = "";
    private bool AnoVisivel(int ano) => _fil.Anos.Count == 0 || _fil.Anos.Contains(ano.ToString());
    /// <summary>Os anos da página, para os títulos: "2022 → 2026" ou os escolhidos no filtro de Ano.</summary>
    private string Periodo
    {
        get
        {
            var anos = AnosDoPainel;
            if (_fil.Anos.Count == 0 || anos.Count == 0) return $"{AnoIni} → {AnoFim}";
            return anos.Count > 2 && anos[^1] - anos[0] == anos.Count - 1 ? $"{anos[0]} → {anos[^1]}" : string.Join(", ", anos);
        }
    }
    private List<int> _anosEditor = new();
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _login = "", _usuario = "";
    private bool _editCores, _editCoresMetas;

    /// <summary>Cores escolhidas pela pessoa para cada ano (as que faltam seguem o padrão).</summary>
    private Dictionary<string, string> _cores = new();
    /// <summary>Cores-padrão de todos: as que o administrador escolheu (valem para quem não mudou as suas).</summary>
    private Dictionary<string, string> _coresPadrao = new();
    private bool _isAdmin;
    private const string ChaveCores = "vendas_propostas_cores";
    /// <summary>"Login" reservado onde fica o padrão definido pelo administrador.</summary>
    private const string LoginPadrao = "*padrao*";
    /// <summary>O que esta pessoa edita: o administrador mexe no padrão de todos; os outros, nas suas cores.</summary>
    private Dictionary<string, string> Editaveis => _isAdmin ? _coresPadrao : _cores;
    private string NotaCores => _isAdmin
        ? "Como administrador, a cor que você escolhe vira o padrão de todos. Cada pessoa ainda pode mudar a sua."
        : "Guardadas só para o seu login. \"Restaurar\" volta ao padrão definido pelo administrador.";

    /// <summary>As propostas de um mês: quantidade, valor (null = sem valor), quantas sem taxa de câmbio e quantas com valor.</summary>
    private sealed record PropMes(int Qtd, decimal? Valor, int SemTaxa, int ComValor);

    /// <summary>Um ano na tabela e nos indicadores (com o filtro de setor).</summary>
    private sealed record LinhaDoAno(int? Qtd, decimal? Valor, int SemTaxa, int ComValor, decimal? VendaPorProposta, decimal? Conversao);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var u = (await AuthState).User;
            _login = u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? u.Identity?.Name ?? "";
            _usuario = u.Identity?.Name ?? _login;   // o nome que aparece no topo da tela: vai na capa da apresentação
        }
        _isAdmin = AuthState is not null && (await AuthState).User.IsInRole("admin");
        _coresPadrao = LerCores(ChartPrefs.Get(LoginPadrao, ChaveCores).Ordem);
        _cores = LerCores(ChartPrefs.Get(_login, ChaveCores).Ordem);
        if (_isAdmin)
        {
            // o administrador não tem cor própria: o que ele escolhe é o padrão. Cores que ele tinha
            // guardado só para si (antes desta regra) passam a ser o padrão, se o padrão ainda estiver vazio.
            if (_coresPadrao.Count == 0 && _cores.Count > 0) { _coresPadrao = new(_cores); GravarCores(); }
            _cores = new();
        }
        Carregar();
        _foco = AnosDoPainel.DefaultIfEmpty(AnoFim).Max();
        // as propostas vêm das planilhas da guia Conversão (leitura da rede): em segundo plano
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(false)); } catch { /* sem as planilhas, o painel mostra só as vendas */ }
        finally { _carregando = false; }
        Carregar();
        if (!AnosDoPainel.Contains(_foco)) _foco = AnosDoPainel.DefaultIfEmpty(AnoFim).Max();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("vpmAjustar"); } catch { /* página saindo */ }
    }

    private async Task Reler()
    {
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(true)); } catch { }
        finally { _carregando = false; }
        Carregar();
    }

    private void Carregar()
    {
        _brutos = VendasRepo.Meses().Where(m => m.Ano >= AnoIni).ToList();
        _budgets = VendasRepo.Budgets().Where(b => b.Ano >= AnoIni).ToList();
        var enviadas = new List<ConversaoDeVendas.PropostaEnviada>();
        try
        {
            if (Conv.Ok) enviadas = ConversaoDeVendas.PropostasEnviadas(Conv.Atual.Propostas.Where(p => _fil.Passa(p, ignorarAno: true)), Cambio.Todas())
                .Where(p => p.Data.Year >= AnoIni && p.Data.Year <= AnoFim).ToList();
        }
        catch (Exception) { /* sem as propostas, o painel mostra só as vendas */ }
        _enviadas = enviadas;
        try
        {
            // primeiro mês com propostas (sem filtros): antes dele o mês é "n/d", não zero
            var ini = Conv.Ok ? Conv.Atual.Propostas.Where(p => p.Data is DateTime d && d.Year >= AnoIni && d.Year <= AnoFim)
                .Select(p => p.Data!.Value.Year * 100 + p.Data.Value.Month).DefaultIfEmpty(int.MaxValue).Min() : int.MaxValue;
            var manual = _brutos.Where(b => b.Propostas is not null).Select(b => b.Ano * 100 + b.Mes).DefaultIfEmpty(int.MaxValue).Min();
            _mmIniPropostas = Math.Min(ini, manual);
        }
        catch { _mmIniPropostas = int.MaxValue; }
        try
        {
            var taxas = Cambio.Todas();
            _conv = !Conv.Ok ? new() : Conv.Atual.Propostas.Where(p => _fil.Passa(p, ignorarAno: true))
                .Where(p => p.Data is DateTime d && d.Year >= AnoIni && d.Year <= AnoFim)
                .Select(p => new LinhaConv(p.Data!.Value.Year, p.Data.Value.Month, p.Origem, p.Classe,
                    p.ValorBrl ?? (p.ValorUsd is double u && taxas.TryGetValue(p.Data.Value.Year, out var t) ? u * t : null)))
                .ToList();
        }
        catch { _conv = new(); }
        _meses = ConversaoDeVendas.Meses(_brutos, enviadas).Where(m => m.Ano >= AnoIni && m.Ano <= AnoFim).ToList();
        _anos = ConversaoDeVendas.Anos(_meses, _budgets);
        var informados = _brutos.Count(b => b.Propostas is not null);
        _fonte = string.Join("; ", new[]
        {
            enviadas.Count(p => p.Fonte == ConversaoService.Afm) is var s && s > 0 ? $"{N0(s)} da planilha AFM" : "",
            enviadas.Count(p => p.Fonte == ConversaoService.Nb) is var r && r > 0 ? $"{N0(r)} da planilha NB" : "",
            informados > 0 ? $"{informados} mês(es) informado(s) à mão" : "",
        }.Where(x => x.Length > 0)) is { Length: > 0 } t ? t : (_carregando ? "lendo as planilhas…" : "nenhuma registrada ainda");
        var anos = _brutos.Select(b => b.Ano).Concat(_budgets.Select(b => b.Ano)).Append(AnoIni).Distinct().ToList();
        _anosEditor = Enumerable.Range(AnoIni, Math.Max(anos.Max(), _anosEditor.DefaultIfEmpty(AnoIni).Max()) - AnoIni + 1).ToList();
        Montar();
    }

    private void AoMudarFiltros()
    {
        _dica = null;
        Carregar();
        // o filtro de Ano escolhe os anos da página: ao mudar, o ano em foco passa a ser o mais recente deles
        var anos = AnosDoPainel;
        var assinAnos = string.Join(",", _fil.Anos.OrderBy(x => x));
        if (anos.Count > 0 && (assinAnos != _anosFiltrados || !anos.Contains(_foco))) _foco = anos.Max();
        _anosFiltrados = assinAnos;
        StateHasChanged();
    }

    /// <summary>As propostas por mês com o filtro de setor. Em "Ambos", os meses informados à mão valem mais que as planilhas.</summary>
    private void Montar()
    {
        _enviadasSetor = _enviadas;   // já filtradas em Carregar
        _convSetor = _conv;
        var d = _enviadasSetor.GroupBy(p => (p.Data.Year, p.Data.Month))
            .ToDictionary(g => g.Key, g => new PropMes(g.Count(), g.Sum(p => p.ValorReais), g.Count(p => p.SemTaxa), g.Count(p => p.ValorReais > 0)));
        if (_setor == "")
            foreach (var m in _meses.Where(m => m.FonteDasPropostas == "informado" && m.Propostas is int))
                d[(m.Ano, m.Mes)] = new PropMes(m.Propostas!.Value, m.ValorProposto, 0, m.ValorProposto is > 0 ? m.Propostas.Value : 0);
        _porMes = d;
    }

    /// <summary>Todos os anos com dados (2022 em diante), sem o filtro de Ano: fixa a cor de cada ano.</summary>
    private List<int> AnosComDados =>
        Enumerable.Range(AnoIni, AnoFim - AnoIni + 1)
            .Where(a => _anos.Any(x => x.Ano == a && (x.MesesComVendas > 0 || x.Propostas is not null)) || _porMes.Keys.Any(k => k.Ano == a))
            .ToList();

    /// <summary>Os anos que a página mostra: os com dados, restritos ao filtro de Ano quando ele está ligado.</summary>
    private List<int> AnosDoPainel => AnosComDados.Where(AnoVisivel).ToList();

    private ResumoDoAno AnoDoFoco => _anos.FirstOrDefault(a => a.Ano == _foco) ?? _anos.Last();

    /// <summary>O último mês a comparar no ano: no ano corrente, o mês de hoje; nos outros, dezembro.</summary>
    private static int MesLimite(int ano) => ano == DateTime.Today.Year ? DateTime.Today.Month : 12;

    /// <summary>Base da taxa (botão "Taxa sobre" da barra de filtros): false = decididas; true = todas as propostas enviadas.</summary>
    private bool BaseTodas => _fil.BaseTodas;
    private string DenRot => BaseTodas ? "enviadas" : "decididas";
    private string RegraTxt => BaseTodas ? "Ganhas ÷ todas as propostas enviadas × 100" : "Ganhas ÷ (Ganhas + Perdidas) × 100";

    /// <summary>
    /// Taxa de conversão do ano (até o mês dado), com a regra da guia Conversão:
    /// decididas = Ganhas ÷ (Ganhas + Perdidas), por valor ganho ÷ (ganho + perdido);
    /// todas = Ganhas ÷ todas as propostas enviadas, por valor ganho ÷ valor total cotado.
    /// </summary>
    private (int G, int P, int Base, double? Taxa, double? TaxaValor) Taxa(int ano, int ateMes = 12)
    {
        var l = _convSetor.Where(x => x.Ano == ano && x.Mes <= ateMes).ToList();
        int g = l.Count(x => x.Classe == ClasseProposta.Ganha), p = l.Count(x => x.Classe == ClasseProposta.Perdida);
        double vg = l.Where(x => x.Classe == ClasseProposta.Ganha).Sum(x => x.Brl ?? 0), vp = l.Where(x => x.Classe == ClasseProposta.Perdida).Sum(x => x.Brl ?? 0);
        var (b, vb) = BaseTodas ? (l.Count, l.Sum(x => x.Brl ?? 0)) : (g + p, vg + vp);
        return (g, p, b, b > 0 ? g * 100.0 / b : null, vb > 0 ? vg / vb * 100 : null);
    }

    /// <summary>Composição do ano (regra da guia Conversão): ganhas, perdidas, abertas, não classificadas, a taxa e o valor ganho.</summary>
    private (int Total, int G, int P, int A, int NC, int Base, double? Taxa, double VG, double? TaxaValor) Composicao(int ano)
    {
        var l = _convSetor.Where(x => x.Ano == ano).ToList();
        int g = l.Count(x => x.Classe == ClasseProposta.Ganha), p = l.Count(x => x.Classe == ClasseProposta.Perdida),
            a = l.Count(x => x.Classe == ClasseProposta.Aberta), nc = l.Count(x => x.Classe == ClasseProposta.NaoClassificada);
        double vg = l.Where(x => x.Classe == ClasseProposta.Ganha).Sum(x => x.Brl ?? 0), vp = l.Where(x => x.Classe == ClasseProposta.Perdida).Sum(x => x.Brl ?? 0);
        var (b, vb) = BaseTodas ? (l.Count, l.Sum(x => x.Brl ?? 0)) : (g + p, vg + vp);
        return (l.Count, g, p, a, nc, b, b > 0 ? g * 100.0 / b : null, vg, vb > 0 ? vg / vb * 100 : null);
    }

    private const string CorAfm = "#12355B", CorNb = "#2BA59A";

    /// <summary>
    /// O ano dividido por setor (AFM ou NB): propostas, ganhas e a taxa (pela base de "Taxa sobre"),
    /// das linhas da guia Conversão; e o valor enviado, das propostas enviadas (cada número uma vez).
    /// </summary>
    private (int Total, int G, double? Taxa, decimal Valor, int SemTaxa) PorSetor(int ano, string origem)
    {
        var l = _convSetor.Where(x => x.Ano == ano && x.Origem == origem).ToList();
        int g = l.Count(x => x.Classe == ClasseProposta.Ganha), p = l.Count(x => x.Classe == ClasseProposta.Perdida);
        var b = BaseTodas ? l.Count : g + p;
        var env = _enviadasSetor.Where(x => x.Data.Year == ano && x.Fonte == origem).ToList();
        return (l.Count, g, b > 0 ? g * 100.0 / b : null, env.Sum(x => x.ValorReais), env.Count(x => x.SemTaxa));
    }

    /// <summary>Taxa do mês no gráfico, pela base escolhida em "Taxa sobre": ganhas ÷ decididas do mês, ou ganhas ÷ todas as enviadas no mês.</summary>
    private (int Total, int G, double? Taxa) TaxaMes(int ano, int mes)
    {
        var l = _convSetor.Where(x => x.Ano == ano && x.Mes == mes).ToList();
        var g = l.Count(x => x.Classe == ClasseProposta.Ganha);
        var b = BaseTodas ? l.Count : g + l.Count(x => x.Classe == ClasseProposta.Perdida);
        return (b, g, b > 0 ? g * 100.0 / b : null);
    }

    private PropMes? Prop(int a, int m) => _porMes.TryGetValue((a, m), out var p) ? p : null;
    private int QtdAte(int ano, int mes) => Enumerable.Range(1, mes).Sum(m => Prop(ano, m)?.Qtd ?? 0);
    private decimal? ValorAte(int ano, int mes)
    {
        var l = Enumerable.Range(1, mes).Select(m => Prop(ano, m)).Where(p => p is not null).ToList();
        return l.Count == 0 || l.Any(p => p!.SemTaxa > 0) ? null : l.Sum(p => p!.Valor ?? 0m);
    }

    /// <summary>Valor médio por proposta de jan até o mês (valor enviado ÷ propostas com valor), para comparar períodos iguais.</summary>
    private decimal? MedioAte(int ano, int mes)
    {
        var com = Enumerable.Range(1, mes).Sum(m => Prop(ano, m)?.ComValor ?? 0);
        return ValorAte(ano, mes) is decimal v && com > 0 ? v / com : null;
    }

    private LinhaDoAno Linha(int ano)
    {
        var meses = Enumerable.Range(1, 12).Select(m => (Mes: m, P: Prop(ano, m), V: _meses.FirstOrDefault(x => x.Ano == ano && x.Mes == m)?.Vendas)).ToList();
        var com = meses.Where(x => x.P is not null).ToList();
        if (com.Count == 0) return new LinhaDoAno(null, null, 0, 0, null, null);
        var qtd = com.Sum(x => x.P!.Qtd);
        var valor = com.Any(x => x.P!.Valor is not null) ? com.Sum(x => x.P!.Valor ?? 0m) : (decimal?)null;
        var semTaxa = com.Sum(x => x.P!.SemTaxa);
        // relações só nos meses com venda e propostas (a venda de dezembro não se compara com propostas que ainda não existem)
        var ambos = com.Where(x => x.V is not null).ToList();
        var qAmbos = ambos.Sum(x => x.P!.Qtd);
        var vAmbos = ambos.Sum(x => x.V!.Value);
        var valAmbos = ambos.Sum(x => x.P!.Valor ?? 0m);
        decimal? vpp = _setor == "" && qAmbos > 0 && vAmbos > 0 ? vAmbos / qAmbos : null;   // as vendas são da empresa toda
        decimal? conv = _setor == "" && semTaxa == 0 && valAmbos > 0 ? vAmbos / valAmbos : null;
        return new LinhaDoAno(qtd, valor, semTaxa, com.Sum(x => x.P!.ComValor), vpp, conv);
    }

    private List<(int Ano, int Qtd)> AnosSemTaxa() =>
        _enviadasSetor.Where(p => p.SemTaxa).GroupBy(p => p.Data.Year).OrderBy(g => g.Key).Select(g => (g.Key, g.Count())).ToList();

    // ================= formatos =================

    private static string F(double v) => v.ToString("0.##", Inv);
    private static string N0(int v) => v.ToString("#,##0", Br);
    private static string Pct(decimal v) => v.ToString("P1", Br);
    private static string Cheio(decimal v) => (v < 0 ? "−" : "") + "R$ " + Math.Abs(v).ToString("#,##0", Br);
    private static string Mi(decimal v) => (v < 0 ? "−" : "") + "R$ " + Compacto(Math.Abs(v));
    private static string MiEixo(decimal v) => (v < 0 ? "−" : "") + Compacto(Math.Abs(v));
    private static string Compacto(decimal a) =>
        a >= 1_000_000_000m ? (a / 1_000_000_000m).ToString("#,##0.0#", Br) + " bi"
        : a >= 1_000_000m ? (a / 1_000_000m).ToString("#,##0.0", Br) + " mi"
        : a >= 1_000m ? (a / 1_000m).ToString("#,##0", Br) + " mil" : a.ToString("#,##0", Br);
    private static string Eixo(decimal v) => (v < 0 ? "−" : "") +
        (Math.Abs(v) >= 1_000_000_000m ? (Math.Abs(v) / 1_000_000_000m).ToString("#,##0.#", Br) + " bi"
        : Math.Abs(v) >= 1_000_000m ? (Math.Abs(v) / 1_000_000m).ToString("#,##0.#", Br) + " mi" : Math.Abs(v).ToString("#,##0", Br));
    private static string NomeDoMes(int m) => VendasMensaisRepository.NomesDosMeses[m - 1];
    private static string MesCurto(int m) => VendasMensaisRepository.MesesCurtos[m - 1];
    private static string Campo(decimal? v) => v?.ToString("#,##0.##", Br) ?? "";
    private static string Esc(string s) => System.Net.WebUtility.HtmlEncode(s);

    /// <summary>Variação contra o mesmo período do ano anterior (texto começa pelo sinal).</summary>
    private static string? Delta(decimal? atual, decimal? anterior, int anoAnt) =>
        atual is decimal a && anterior is decimal b && b > 0 ? $"{(a - b) / b * 100:+0;-0;0}% vs mesmo período de {anoAnt}" : null;
    private static string? Delta(int atual, int? anterior, int anoAnt) => Delta((decimal)atual, anterior, anoAnt);

    private static string P1(double v) => v.ToString("0.0", Br) + "%";
    /// <summary>Variação da taxa em pontos percentuais ("+2,1 p.p."), contra o mesmo período do ano anterior.</summary>
    private static string? DeltaPp(double? atual, double? anterior, int? anoAnt) =>
        atual is double a && anterior is double b ? $"{(a - b).ToString("+0.0;-0.0;0.0", Br)} p.p.{(anoAnt is int y ? $" vs mesmo período de {y}" : "")}" : null;

    /// <summary>Variação curta para os cartões dos anos ("+12%").</summary>
    private static string? DeltaCurto(decimal? atual, decimal? anterior) =>
        atual is decimal x && anterior is decimal y && y > 0 ? $"{(x - y) / y * 100:+0;-0;0}%" : null;

    private static string DeltaCls(string? d) => d is null || d.StartsWith("+0") || d.StartsWith("0") ? "neu" : d.StartsWith("+") ? "pos" : "neg";
    private static string Seta(string d) => d.StartsWith("+0") || d.StartsWith("0") ? d : (d.StartsWith("+") ? "▲ " : d.StartsWith("-") ? "▼ " : "") + d;

    private RenderFragment Kpi(string rotulo, string valor, string sub, string tip, string cor, string? delta = null) =>
        @<article class="cvx-kpi" style="--kc:@cor" title="@tip">
            <div class="cvx-lab">@rotulo</div>
            <div class="cvx-num">@valor</div>
            <div class="cvx-ksub">@sub</div>
            @if (delta is not null) { <div class="cvx-kdelta @DeltaCls(delta)">@Seta(delta)</div> }
        </article>;

    private string TituloGrafico() => _met switch
    {
        "valor" => "Valor das propostas enviadas por mês (R$), comparando os anos",
        "vendas" => "Vendas por mês (R$), comparando os anos",
        "taxa" => "Taxa de conversão por mês, comparando os anos",
        _ => "Propostas enviadas por mês, comparando os anos",
    };

    // ================= gráfico principal: uma linha por ano, jan–dez =================

    // Mesmo desenho do gráfico "Vendas x Meta" da Visão Executiva: legenda no topo,
    // ano em foco em roxo com área, traço grosso, pontos vazados e o valor escrito
    // acima de cada ponto; os outros anos em linhas mais finas (sólida, tracejada,
    // pontilhada), cada um com a sua cor. Uma linha por ano, janeiro a dezembro.
    private const string CorFocoLinha = "#8b5cf6";
    private static readonly (string Cor, string Traco)[] EstilosAnos =
    {
        ("#007A9E", ""), ("#b7791f", "5 3"), ("#1f9254", "2 3"), ("#64748b", "6 3 2 3"), ("#c2410c", "1 3"),
    };

    /// <summary>"2026=#8b5cf6;vendas=#8b5cf6;hsa=#1f9254" → chave → cor (só cores #rrggbb válidas).</summary>
    private static Dictionary<string, string> LerCores(string? texto)
    {
        var d = new Dictionary<string, string>();
        foreach (var par in (texto ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = par.Split('=');
            if (kv.Length == 2 && System.Text.RegularExpressions.Regex.IsMatch(kv[0].Trim(), "^[a-z0-9]+$")
                && System.Text.RegularExpressions.Regex.IsMatch(kv[1].Trim(), "^#[0-9a-fA-F]{6}$"))
                d[kv[0].Trim()] = kv[1].Trim().ToLowerInvariant();
        }
        return d;
    }

    private void GravarCores()
    {
        var login = _isAdmin ? LoginPadrao : _login;
        var d = Editaveis;
        if (d.Count == 0) ChartPrefs.Reset(login, ChaveCores);
        else ChartPrefs.Save(login, ChaveCores, string.Join(";", d.OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}={kv.Value}")), ChartPrefsRepository.BarraPadrao);
    }

    /// <summary>A cor guardada para a chave: a da pessoa; senão, o padrão do administrador; null = a original do programa.</summary>
    private string? CorSalva(string chave) =>
        _cores.TryGetValue(chave, out var c) ? c : _coresPadrao.TryGetValue(chave, out var p) ? p : null;

    private void MudarCor(string chave, string? cor)
    {
        if (cor is null || !System.Text.RegularExpressions.Regex.IsMatch(cor, "^#[0-9a-fA-F]{6}$")) return;
        Editaveis[chave] = cor.ToLowerInvariant();
        GravarCores();
    }

    private void RestaurarCores(IEnumerable<string> chaves)
    {
        foreach (var k in chaves.ToList()) Editaveis.Remove(k);
        GravarCores();
    }

    // cores padrão do gráfico de metas (as mesmas do Vendas x Meta da Visão Executiva)
    private static readonly (string Chave, string Nome, string Padrao, string Traco)[] SeriesMetas =
    {
        ("vendas", "Vendas totais", "#159bbd", ""), ("grupo", "Meta Grupo", "#B7791F", "5 3"), ("hsa", "Meta HSA", "#2F855A", "2 3"),
    };
    private string CorMeta(string chave) => CorSalva(chave) ?? SeriesMetas.First(x => x.Chave == chave).Padrao;

    /// <summary>A cor do ano: a escolhida pela pessoa; senão, roxo para o ano em foco e a paleta para os outros (mais recente primeiro).</summary>
    private string CorDoAno(int ano)
    {
        if (CorSalva(ano.ToString()) is { } c) return c;
        if (ano == _foco) return CorFocoLinha;
        return EstilosAnos[IndiceDoEstilo(ano)].Cor;
    }

    /// <summary>Posição do ano na paleta (mais recente primeiro, sem o ano em foco), contada sobre todos os anos com dados.</summary>
    private int IndiceDoEstilo(int ano)
    {
        var outros = AnosComDados.Where(a => a != _foco).OrderByDescending(a => a).ToList();
        return Math.Clamp(outros.IndexOf(ano), 0, EstilosAnos.Length - 1);
    }

    private string SvgAnos(string met, int focoAno)
    {
        var anos = AnosDoPainel.OrderBy(a => a).ToList();
        if (anos.Count == 0) return "<div class='empty'>Sem dados.</div>";
        if (!anos.Contains(focoAno)) focoAno = anos[^1];
        double? Val(int a, int m) => met switch
        {
            "qtd" => Prop(a, m)?.Qtd,
            "taxa" => TaxaMes(a, m).Taxa,
            "valor" => Prop(a, m)?.Valor is decimal v && v > 0 ? (double)v : null,
            _ => _meses.FirstOrDefault(x => x.Ano == a && x.Mes == m)?.Vendas is decimal vd ? (double)vd : null,
        };
        string Rot(double v) => met switch { "qtd" => N0((int)Math.Round(v)), "taxa" => P1(v), _ => MiEixo((decimal)v) };
        string Txt(int a, int m)
        {
            var v = Val(a, m);
            if (v is null) return met == "vendas" ? "sem venda registrada" : "sem propostas";
            if (met == "taxa") { var tm = TaxaMes(a, m); return $"{P1(v.Value)} · {N0(tm.G)} ganhas de {N0(tm.Total)} {DenRot}"; }
            var p = Prop(a, m);
            return met switch
            {
                "qtd" => $"{N0(p!.Qtd)} propostas" + (p.Valor is decimal pv && pv > 0 ? $" · {Mi(pv)}" : ""),
                "valor" => $"{Mi((decimal)v.Value)} · {N0(p!.Qtd)} propostas" + (p.SemTaxa > 0 ? $" · parcial: {p.SemTaxa} sem taxa de câmbio" : ""),
                _ => Cheio((decimal)v.Value),
            };
        }

        double Wd = 760, H = 300, top = 58, bot = 250, left = 58, right = 18;
        var colW = (Wd - left - right) / 11.0;
        double max = 1, min = 0;
        foreach (var a in anos) for (var m = 1; m <= 12; m++) if (Val(a, m) is double v) { max = Math.Max(max, v); min = Math.Min(min, v); }
        max *= 1.20;
        if (min < 0) min *= 1.2;
        double X(int m) => left + (m - 1) * colW;
        double Y(double v) => bot - (v - min) / (max - min) * (bot - top);
        string N(double v) => v.ToString("0.#", Inv);

        // estilo de cada ano: o ano em foco é o roxo; os outros pegam a paleta na ordem (mais recente primeiro)
        var outros = anos.Where(a => a != focoAno).OrderByDescending(a => a).ToList();
        (string Cor, string Traco) Estilo(int a) => (CorDoAno(a), a == focoAno ? "" : EstilosAnos[IndiceDoEstilo(a)].Traco);
        var cf = CorDoAno(focoAno);

        var sb = new StringBuilder();
        sb.Append($"<svg viewBox='0 0 {N(Wd)} {N(H)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='{Esc(TituloGrafico())}'>");
        sb.Append($"<defs><linearGradient id='vparea' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='{cf}' stop-opacity='0.24'/><stop offset='100%' stop-color='{cf}' stop-opacity='0.02'/></linearGradient></defs>");

        // legenda: o ano em foco primeiro, depois os outros do mais recente ao mais antigo
        var dx = 0.0;
        foreach (var a in new[] { focoAno }.Concat(outros))
        {
            var (cor, traco) = Estilo(a);
            var risco = traco == "" ? "" : $" stroke-dasharray='{traco}'";
            sb.Append($"<line x1='{N(left + dx)}' y1='21' x2='{N(left + dx + 24)}' y2='21' stroke='{cor}' stroke-width='{(a == focoAno ? 4 : 3.5)}'{risco} stroke-linecap='round'/>");
            sb.Append($"<text x='{N(left + dx + 31)}' y='26' font-size='14' font-weight='{(a == focoAno ? 700 : 600)}' fill='#3b4a61'>{a}</text>");
            dx += 104;
        }

        // grade + eixo Y
        for (var g = 0; g <= 4; g++)
        {
            double gy = top + (bot - top) * g / 4.0, gv = max - (max - min) * g / 4.0;
            sb.Append($"<line x1='{N(left)}' y1='{N(gy)}' x2='{N(Wd - right)}' y2='{N(gy)}' stroke='#eef2f7'/>");
            sb.Append($"<text x='{N(left - 7)}' y='{N(gy + 4)}' text-anchor='end' font-size='11' fill='#7b8798'>{Esc(met switch { "qtd" => N0((int)Math.Round(gv)), "taxa" => Math.Round(gv).ToString("0", Br) + "%", _ => MiEixo((decimal)gv) })}</text>");
        }
        if (min < 0) sb.Append($"<line x1='{N(left)}' y1='{N(Y(0))}' x2='{N(Wd - right)}' y2='{N(Y(0))}' stroke='#d3dcea'/>");

        // destaque do mês atual (no ano corrente)
        var hoje = DateTime.Today;
        var mesAtual = focoAno == hoje.Year ? hoje.Month : 0;
        if (mesAtual > 0)
            sb.Append($"<line x1='{N(X(mesAtual))}' y1='{N(top)}' x2='{N(X(mesAtual))}' y2='{N(bot)}' stroke='{cf}' stroke-width='1' stroke-dasharray='3 3' opacity='0.3'/>");

        List<List<(double X, double Y)>> Trechos(int a)
        {
            var segs = new List<List<(double X, double Y)>>(); var seg = new List<(double X, double Y)>();
            for (var m = 1; m <= 12; m++)
            {
                if (Val(a, m) is not double v) { if (seg.Count > 0) { segs.Add(seg); seg = new(); } continue; }
                seg.Add((X(m), Y(v)));
            }
            if (seg.Count > 0) segs.Add(seg);
            return segs;
        }
        string Pts(List<(double X, double Y)> s) => string.Join(" ", s.Select(p => $"{N(p.X)},{N(p.Y)}"));

        // outros anos: linhas finas, do mais antigo ao mais recente
        foreach (var a in outros.AsEnumerable().Reverse())
        {
            var (cor, traco) = Estilo(a);
            var risco = traco == "" ? "" : $" stroke-dasharray='{traco}'";
            foreach (var s in Trechos(a).Where(s => s.Count > 1))
                sb.Append($"<polyline points='{Pts(s)}' fill='none' stroke='{cor}' stroke-width='2'{risco} stroke-linejoin='round' stroke-linecap='round' opacity='0.9'/>");
            for (var m = 1; m <= 12; m++)
                if (Val(a, m) is double v)
                    sb.Append($"<circle cx='{N(X(m))}' cy='{N(Y(v))}' r='2.5' fill='{cor}'><title>{Esc($"{a} · {NomeDoMes(m).ToLowerInvariant()}: {Txt(a, m)}")}</title></circle>");
        }

        // ano em foco: área + traço grosso + pontos vazados + valores
        foreach (var s in Trechos(focoAno))
        {
            if (s.Count > 1)
            {
                sb.Append($"<polygon points='{N(s[0].X)},{N(Y(Math.Max(0, min)))} {Pts(s)} {N(s[^1].X)},{N(Y(Math.Max(0, min)))}' fill='url(#vparea)'/>");
                sb.Append($"<polyline points='{Pts(s)}' fill='none' stroke='{cf}' stroke-width='2.8' stroke-linejoin='round' stroke-linecap='round'/>");
            }
        }
        for (var m = 1; m <= 12; m++)
        {
            var cur = m == mesAtual;
            if (Val(focoAno, m) is double v)
            {
                var y = Y(v);
                sb.Append($"<circle cx='{N(X(m))}' cy='{N(y)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='{cf}' stroke-width='{(cur ? "3" : "2")}'><title>{Esc($"{focoAno} · {NomeDoMes(m).ToLowerInvariant()}: {Txt(focoAno, m)}")}</title></circle>");
                sb.Append($"<text x='{N(X(m))}' y='{N(y - 10)}' text-anchor='middle' font-size='11.5' font-weight='{(cur ? "800" : "700")}' fill='{(cur ? "#3b0764" : "#3b4a61")}' paint-order='stroke' stroke='#fff' stroke-width='3' stroke-linejoin='round'>{Esc(Rot(v))}</text>");
            }
            sb.Append($"<text x='{N(X(m))}' y='{N(H - 10)}' text-anchor='middle' font-size='12' font-weight='{(cur ? "800" : "600")}' fill='{(cur ? cf : "#64748b")}'>{MesCurto(m).ToUpperInvariant()}</text>");
        }

        // faixa invisível por mês: dica com todos os anos
        for (var m = 1; m <= 12; m++)
        {
            var linhas = string.Join("\n", new[] { focoAno }.Concat(outros).Select(a => $"{a}: {Txt(a, m)}"));
            sb.Append($"<rect x='{N(X(m) - colW / 2)}' y='{N(top)}' width='{N(colW)}' height='{N(bot - top)}' fill='transparent'><title>{Esc(NomeDoMes(m) + "\n" + linhas)}</title></rect>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    // ================= seção "Vendas e propostas, mês a mês" (cálculos em VendasPropostas.MesAMes.cs) =================

    /// <summary>Venda negativa: sempre em vermelho, qualquer que seja a cor do ano.</summary>
    private const string CorNegPri = "#c0392b";

    private RenderFragment SecaoMesAMes(int principal) => __builder =>
    {
        var anosDisp = AnosDoPainel;
        var modo = _mmModo == "comparar" && CompMm(principal) is null ? "ano" : _mmModo;
        var comp = modo == "comparar" ? CompMm(principal) : null;
        var anos = modo == "historico" ? anosDisp.OrderByDescending(a => a).ToList() : comp is int c0 ? new List<int> { principal, c0 } : new List<int> { principal };
        <div class="panel-head">
            <div class="panel-title">Vendas e propostas, mês a mês
                <span class="hint">@(modo switch { "comparar" => $"{principal} × {comp}", "historico" => "todos os anos", _ => principal.ToString() }) · vendas da empresa toda (R$) · propostas enviadas@(_setor != "" ? " (" + _setor + ")" : "")</span>
            </div>
        </div>
        <div class="vpm-ctl">
            <div class="cvx-seg-ctl vpm-modos" role="tablist" aria-label="Modo de visualização">
                <button class="@(modo == "ano" ? "on" : "")" @onclick='() => _mmModo = "ano"'>Um ano</button>
                <button class="@(modo == "comparar" ? "on" : "")" disabled="@(anosDisp.Count < 2)" @onclick='() => _mmModo = "comparar"'>Comparar dois anos</button>
                <button class="@(modo == "historico" ? "on" : "")" @onclick='() => _mmModo = "historico"'>Todos os anos</button>
            </div>
            <div class="vpm-sel vpm-convpor" title="Como a taxa de conversão é calculada neste quadro"><span>Conversão por</span>
                <div class="cvx-seg-ctl">
                    <button class="@(!_mmConvValor ? "on" : "")" @onclick="() => _mmConvValor = false">Quantidade</button>
                    <button class="@(_mmConvValor ? "on" : "")" @onclick="() => _mmConvValor = true">Valor (R$)</button>
                </div>
            </div>
            <button type="button" class="btn-ghost vpm-tela" onclick="vpTelaCheia('mes-a-mes')" title="Mostrar este quadro na tela inteira (Esc para sair)">
                <span class="vpm-tela-on">⛶ Tela cheia</span><span class="vpm-tela-off">✕ Sair da tela cheia</span>
            </button>
            @if (modo != "historico")
            {
                <div class="vpm-sel"><span>Ano principal</span>
                    <div class="cvx-seg-ctl">
                        @foreach (var a in anosDisp)
                        {
                            var ano = a;
                            <button class="@(ano == principal ? "on" : "")" @onclick="() => { _foco = ano; _dica = null; if (_mmComp == ano) _mmComp = null; }">@ano</button>
                        }
                    </div>
                </div>
            }
            @if (modo == "comparar")
            {
                <div class="vpm-sel"><span>Comparar com</span>
                    <div class="cvx-seg-ctl">
                        @foreach (var a in anosDisp.Where(x => x != principal))
                        {
                            var ano = a;
                            <button class="@(ano == comp ? "on" : "")" @onclick="() => _mmComp = ano">@ano</button>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="vpm-status">@StatusMm()</div>

        @if (modo == "historico")
        {
            @MiniGraficosMm(anos.OrderBy(a => a).ToList())
        }
        else
        {
            <div class="vpm-corpo">
                <div class="vpm-graficos chart-body">
                    @ComboMm(anos, principal)
                </div>
                @if (comp is int cc) { @ResumoComparativoMm(principal, cc) } else { @ResumoAnoMm(principal) }
            </div>
        }
        <div class="vpm-leg @(modo == "historico" ? "oculta" : "")">
            <span><i class="sw parcial"></i>listrada = mês em andamento (parcial)</span>
            <span><i class="sw apurar"></i>cinza listrado = a apurar (o mês ainda não tem o dado)</span>
            <span><b>n/d</b> = sem dado registrado (não é zero)</span>
            <span><i class="sw neg"></i>venda negativa</span>
        </div>
        <div class="vpm-detalhe-bar">
            <button class="btn-ghost" aria-expanded="@(_mmDetalhe ? "true" : "false")" @onclick="() => _mmDetalhe = !_mmDetalhe">@(_mmDetalhe ? "▴ Ocultar dados detalhados" : "▾ Ver dados detalhados")</button>
            <span class="cvx-note">Valores completos, em reais e centavos, e as quantidades exatas de cada mês.</span>
        </div>
        @if (_mmDetalhe)
        {
            @if (modo == "historico") { <div class="vpm-mats">@MatrizMm(true, anos)@MatrizMm(false, anos)</div> }
            @TabelaMm(modo, anos, principal, comp)
        }
    };

    /// <summary>
    /// Botão "Cores" de cada modo do mês a mês ("u" um ano, "c" comparar, "t" todos os anos): a cor das colunas de
    /// vendas e de propostas de cada ano, das linhas (valor enviado e conversão) e da venda negativa. Cada modo
    /// guarda as suas; sem escolha, vale o padrão (as cores dos anos). Mesma regra de gravação das outras cores.
    /// </summary>
    private RenderFragment PaletaMm(string modo, List<int> anos) => __builder =>
    {
        var aberto = _mmPaleta == modo;
        var porAno = modo != "t";   // nos mini-gráficos as linhas ligam os anos de um mês: uma cor para cada linha
        var nomeModo = modo switch { "u" => "Um ano", "c" => "Comparar dois anos", _ => "Todos os anos" };
        var prefixo = "m" + modo;
        <div class="vp-cores-wrap vpm-pal-wrap">
            <button class="btn-ghost vp-btn-cores" aria-expanded="@(aberto ? "true" : "false")" @onclick="() => _mmPaleta = aberto ? null : modo">🎨 Cores</button>
            @if (aberto)
            {
                <div class="flt-multi-backdrop" @onclick="() => _mmPaleta = null"></div>
                <div class="vp-cores-pop vpm-pal" role="dialog" aria-label="Cores do gráfico · @nomeModo">
                    <div class="vp-cores-tit">Cores · @nomeModo</div>
                    <table class="vpm-pal-t">
                        <thead><tr><th></th><th>Vendas</th><th>Propostas</th>@if (porAno) { <th>Valor enviado</th><th>Conversão</th> }</tr></thead>
                        <tbody>
                            @foreach (var a in anos.OrderByDescending(x => x))
                            {
                                var ano = a;
                                <tr>
                                    <th>@ano</th>
                                    @foreach (var el in porAno ? new[] { 'v', 'p', 'e', 'x' } : new[] { 'v', 'p' })
                                    {
                                        var chave = ChaveMm(modo, el, ano);
                                        <td><input type="color" value="@CorMm(modo, el, ano)" title="@($"{ano} · {NomeElMm(el)}")" @onchange="e => MudarCor(chave, e.Value?.ToString())" /></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!porAno)
                    {
                        <label class="vp-cor-lin"><input type="color" value="@CorMm(modo, 'e', 0)" @onchange="e => MudarCor(ChaveMm(modo, 'e', 0), e.Value?.ToString())" /><span>Linha do valor enviado</span></label>
                        <label class="vp-cor-lin"><input type="color" value="@CorMm(modo, 'x', 0)" @onchange="e => MudarCor(ChaveMm(modo, 'x', 0), e.Value?.ToString())" /><span>Linha da conversão</span></label>
                    }
                    <label class="vp-cor-lin"><input type="color" value="@CorMm(modo, 'n', 0)" @onchange="e => MudarCor(ChaveMm(modo, 'n', 0), e.Value?.ToString())" /><span>Venda negativa</span></label>
                    <div class="vp-cores-pe">
                        <button class="btn-link" disabled="@(!Editaveis.Keys.Any(k => k.StartsWith(prefixo)))" @onclick="() => RestaurarCores(Editaveis.Keys.Where(k => k.StartsWith(prefixo)).ToList())">Restaurar padrão</button>
                        <button class="btn-primary" @onclick="() => _mmPaleta = null">Concluir</button>
                    </div>
                    <div class="vp-cores-nota">Só para "@nomeModo". Sem escolha, vale a cor do ano (botão de cores do gráfico de linhas). @NotaCores</div>
                </div>
            }
        </div>
    };

    /// <summary>
    /// "Um ano" e "Comparar dois anos": um gráfico só, com a mesma estrutura dos mini-gráficos de "Todos os anos",
    /// de cima para baixo: linha do valor enviado em propostas (R$) → colunas de vendas subindo da linha de base
    /// ("R$ 31,4 mi") → colunas de propostas descendo, espelhadas (quantidade) → linha tracejada da conversão do
    /// mês → meses. Um par de colunas por ano em cada mês, na cor do ano. vpmAjustar (app.js) desenha as linhas
    /// e sobe os números que se encostariam.
    /// </summary>
    private RenderFragment ComboMm(List<int> anos, int principal) => __builder =>
    {
        var dois = anos.Count == 2;
        var comp = dois ? anos[1] : 0;
        var modo = dois ? "c" : "u";
        var cv = anos.ToDictionary(a => a, a => Enumerable.Range(1, 12).Select(m => CelVenda(a, m)).ToArray());
        var cp = anos.ToDictionary(a => a, a => Enumerable.Range(1, 12).Select(m => CelProp(a, m)).ToArray());
        var escV = EscalaMmDe(cv.Values.SelectMany(x => x).Where(x => x.Tem).Select(x => (double)x.Valor), dois ? 0.3 : 0.2);
        var maxP = (double)cp.Values.SelectMany(x => x).Where(x => x.Tem && !x.Parcial).Select(x => x.Valor).DefaultIfEmpty(0m).Max();
        if (maxP <= 0) maxP = (double)cp.Values.SelectMany(x => x).Where(x => x.Tem).Select(x => x.Valor).DefaultIfEmpty(1m).Max();
        if (maxP <= 0) maxP = 1;
        <div class="vpm-graf combo @(dois ? "dois" : "um")">
            <div class="vpm-gtit">
                <b>Vendas, propostas e conversão, mês a mês</b>
                <span>@(dois ? $"{principal} × {comp}" : principal.ToString())@(_setor != "" ? " · propostas e conversão: " + _setor : "")</span>
                <span class="vpm-gleg">@foreach (var a in anos) { <span><i style="background:@CorMm(modo, 'v', a)"></i>@a</span> }</span>
                @PaletaMm(modo, anos)
            </div>
            <div class="vpm-sm-leg sub vpm-combo-leg">
                <span><i class="sw cheia"></i>colunas para cima: vendas (R$, empresa toda)</span>
                <span><i class="sw clara"></i>colunas para baixo: propostas enviadas (qtd)</span>
            </div>
            @if (dois)
            {
                <div class="vpm-var-cap">Variação das vendas, @principal × @comp</div>
                <div class="vpm-var" aria-label="Variação das vendas em cada mês">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var a = cv[principal][m - 1]; var b = cv[comp][m - 1];
                        var pct = a.Tem && b.Tem ? VarMm(a.Valor, b.Valor) : null;
                        var dif = a.Tem && b.Tem ? a.Valor - b.Valor : (decimal?)null;
                        var pa = cp[principal][m - 1]; var pb = cp[comp][m - 1];
                        var difP = pa.Tem && pb.Tem && !pa.Parcial && !pb.Parcial ? (int)(pa.Valor - pb.Valor) : (int?)null;
                        var dica = (dif is decimal d ? $"{NomeDoMes(m)}: vendas {DifReais(d)}" : NomeDoMes(m)) + (difP is int dp ? $" · propostas {DifQtd(dp)}" : "");
                        @if (pct is double p) { <span class="vpm-pill @ClsVar(p, false)" title="@dica">@PctSinal(p)</span> }
                        else if (dif is decimal d2) { <span class="vpm-pill neu" title="@dica">@DifReais(d2)</span> }
                        else { <span class="vpm-pill vazio">—</span> }
                    }
                </div>
            }
            @BandaMm("env", anos, principal)
            <div class="vpm-plot vpm-dc sobe">
                @if (escV.Zero > 0.5) { <div class="vpm-zero neg" style="bottom:@F(escV.Zero)%"></div> }
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <div class="vpm-col">
                        @foreach (var a in anos)
                        {
                            var x = cv[a][mes - 1];
                            <div class="vpm-slot" title="@($"{NomeDoMes(mes)} {a} · vendas: {CelTxt(true, x, true)}")">
                                @if (x.Tem)
                                {
                                    var v = (double)x.Valor; var neg = v < 0;
                                    <i class="vpm-bar" style="bottom:@F(escV.Base(v))%;height:@F(Math.Max(escV.Alt(v), 0.5))%;--c:@(neg ? CorMm(modo, 'n', 0) : CorMm(modo, 'v', a))"></i>
                                    <b class="vpm-val vpm-rot @(a == principal ? "pri" : "cmp") @(neg ? "neg" : "")" style="bottom:calc(@F(neg ? escV.Base(v) : escV.Topo(v))% @(neg ? "- 20px" : "+ 3px"))">@ReaisMi(x.Valor)</b>
                                }
                                else if (x.Sit == SitMes.AApurar)
                                {
                                    <i class="vpm-bar apurar" style="bottom:@F(escV.Zero)%;height:7%"></i>
                                }
                                else
                                {
                                    <b class="vpm-val nd" style="bottom:calc(@F(escV.Zero)% + 3px)">n/d</b>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="vpm-plot desce">
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <div class="vpm-col">
                        @foreach (var a in anos)
                        {
                            var x = cp[a][mes - 1];
                            <div class="vpm-slot" title="@($"{NomeDoMes(mes)} {a} · propostas: {CelTxt(false, x, true)}")">
                                @if (x.Tem)
                                {
                                    var h = Math.Min(100, Math.Max((double)x.Valor / maxP * 70, 0.6));
                                    <i class="vpm-bar @(x.Parcial ? "parcial" : "")" style="height:@F(h)%;--c:@CorMm(modo, 'p', a)"></i>
                                    <b class="vpm-lp @(a == principal ? "pri" : "cmp")" style="top:calc(@F(h)% + 3px)">@N0((int)x.Valor)@(x.Parcial ? "*" : "")</b>
                                }
                                else if (x.Sit == SitMes.AApurar)
                                {
                                    <i class="vpm-bar apurar" style="height:8%"></i>
                                }
                                else
                                {
                                    <b class="vpm-lp nd" style="top:3px">n/d</b>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            @BandaMm("conv", anos, principal)
            <div class="vpm-meses">
                @for (var m = 1; m <= 12; m++)
                {
                    var v = cv[principal][m - 1]; var p = cp[principal][m - 1];
                    <div><b>@MesCurto(m).ToUpperInvariant()</b>@if (p.Parcial) { <small>parcial</small> } else if (v.Sit == SitMes.AApurar && p.Sit == SitMes.AApurar) { <small>a apurar</small> } else if (v.Sit == SitMes.AApurar) { <small>vendas a apurar</small> }</div>
                }
            </div>
        </div>
    };

    /// <summary>
    /// Faixa de linha por ano, alinhada às colunas do gráfico do mês a mês: "env" = valor enviado em propostas (R$);
    /// "conv" = taxa de conversão do mês (regra de "Taxa sobre"). Os pontos e números ficam aqui; a linha que liga
    /// os pontos de cada ano é desenhada em app.js (vpmAjustar), a partir da posição real de cada ponto.
    /// </summary>
    private RenderFragment BandaMm(string tipo, List<int> anos, int principal) => __builder =>
    {
        var env = tipo == "env";
        var modo = anos.Count == 2 ? "c" : "u";
        var el = env ? 'e' : 'x';
        double? Val(int a, int m) => env
            ? (Prop(a, m)?.Valor is decimal v && v > 0 ? (double)v : null)
            : (CelProp(a, m).Tem ? TaxaMm(a, m) : null);
        var pts = anos.SelectMany(a => Enumerable.Range(1, 12).Select(m => (a, m, v: Val(a, m), parc: CelProp(a, m).Parcial))).ToList();
        var base0 = pts.Where(p => p.v is not null && !p.parc).Select(p => p.v!.Value).ToList();
        if (base0.Count == 0) base0 = pts.Where(p => p.v is not null).Select(p => p.v!.Value).ToList();
        double min = env ? 0 : base0.DefaultIfEmpty(0).Min(), max = base0.DefaultIfEmpty(1).Max();
        double Y(double v) => max - min < 1e-9 ? 36 : 9 + Math.Clamp((v - min) / (max - min), 0, 1.05) * 50;   // folga em cima para os números
        <div class="vpm-banda-cap @tipo"><i></i>@(env ? "Valor enviado em propostas (R$)" : $"Taxa de conversão do mês ({RegraCurtaMm})")</div>
        <div class="vpm-banda @tipo vpm-dc">
            <svg class="vpm-banda-svg" aria-hidden="true"></svg>
            <div class="vpm-banda-g">
                @for (var m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <div class="vpm-col">
                        @foreach (var a in anos)
                        {
                            var p = pts.First(x => x.a == a && x.m == mes);
                            <div class="vpm-slot">
                                @if (p.v is double v)
                                {
                                    var y = Y(v);
                                    <i class="vpm-pt @(p.parc ? "parc" : "")" style="bottom:@F(y)%;--c:@CorMm(modo, el, a)" data-ano="@a" data-m="@mes" data-cor="@CorMm(modo, el, a)" data-pri="@(a == principal ? "1" : "")"
                                       title="@($"{NomeDoMes(mes)} {a} · {(env ? "valor enviado " + Mi((decimal)v) : "conversão " + P1(v))}{(p.parc ? " (parcial)" : "")}")"></i>
                                    <b class="vpm-blab vpm-rot @(a == principal ? "pri" : "cmp")" style="bottom:calc(@F(y)% + 6px)">@(env ? ReaisMi((decimal)v) : P1(v))@(p.parc ? "*" : "")</b>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    };

    /// <summary>Resumo lateral de dois anos, no período comparável (meses fechados nos dois).</summary>
    private RenderFragment ResumoComparativoMm(int a1, int a2) => __builder =>
    {
        var (mv, mp, A, B) = ResumoMm(a1, a2);
        var vV = VarMm(A.Vendas, B.Vendas);
        var vP = VarMm(A.Propostas, B.Propostas);
        double? dT = A.Taxa is double ta && B.Taxa is double tb ? ta - tb : null;
        var temV = A.MesesV > 0 && B.MesesV > 0;
        var temP = A.MesesP > 0 && B.MesesP > 0;
        <aside class="vpm-resumo cmp">
            <div class="vpm-rtit">Resumo comparativo</div>
            <div class="vpm-rper">Vendas: @MesesTxt(mv) · propostas e conversão: @MesesTxt(mp)</div>
            <div class="vpm-anos2">
                @foreach (var L in new[] { A, B })
                {
                    <div class="vpm-ano @(L.Ano == a1 ? "pri" : "")" style="--ac:@CorMm("c", 'v', L.Ano)">
                        <div class="vpm-ano-t">@L.Ano</div>
                        <div class="vpm-ano-l"><span>Vendas</span><b title="@(L.MesesV > 0 ? Reais(L.Vendas) : "")">@(L.MesesV > 0 ? Mi(L.Vendas) : "n/d")</b></div>
                        <div class="vpm-ano-l"><span>Propostas</span><b>@(L.MesesP > 0 ? N0(L.Propostas) : "n/d")</b></div>
                        <div class="vpm-ano-l"><span>Conversão@(_mmConvValor ? " (valor)" : "")</span><b title="@(_mmConvValor ? RegraMm : $"{N0(L.G)} ganhas de {N0(L.Base)} {DenRot}")">@(L.Taxa is double t ? P1(t) : "—")</b></div>
                    </div>
                }
            </div>
            <div class="vpm-rtit2">Variação @a1 × @a2</div>
            <div class="vpm-varl">
                <span>Vendas</span>
                <b class="@ClsVar(vV, false)">@(temV && vV is double x1 ? Seta(x1) + PctSinal(x1) : "—")</b>
                <em>@(temV ? DifReais(A.Vendas - B.Vendas) : "")</em>
                <span>Propostas</span>
                <b class="neu">@(temP && vP is double x2 ? Seta(x2) + PctSinal(x2) : "—")</b>
                <em>@(temP ? DifQtd(A.Propostas - B.Propostas) : "")</em>
                <span>Conversão</span>
                <b class="@ClsVar(dT, false)">@(dT is double x3 ? Seta(x3) + PpSinal(x3) : "—")</b>
                <em></em>
            </div>
            <p class="vpm-rnota">
                Mesmos meses nos dois anos@(mp < 12 && a1 == DateTime.Today.Year || a2 == DateTime.Today.Year ? $"; {NomeDoMes(DateTime.Today.Month).ToLowerInvariant()} (em andamento) fica fora" : "").
                Conversão: @RegraMm.
                Mais ou menos propostas não é, por si, melhora ou piora.
            </p>
        </aside>
    };

    /// <summary>
    /// "Todos os anos": 12 mini-gráficos, um por mês. Em cada um, as vendas sobem da linha central
    /// (uma coluna por ano, na cor do ano) e as propostas descem espelhadas, no mesmo tom mais claro.
    /// Todos os números ficam escritos: vendas em cima; propostas e valor enviado embaixo. A escala de
    /// cada metade é a do próprio mês, para comparar os anos dentro dele.
    /// </summary>
    private RenderFragment MiniGraficosMm(List<int> anos) => __builder =>
    {
        var semProp = anos.Where(a => Enumerable.Range(1, 12).All(m => CelProp(a, m).Sit == SitMes.SemDado)).ToList();
        var semVenda = anos.Where(a => Enumerable.Range(1, 12).All(m => CelVenda(a, m).Sit == SitMes.SemDado)).ToList();
        string Curto(int a) => "'" + (a % 100).ToString("00");
        <div class="vpm-sm-leg">
            @foreach (var a in anos) { <span class="ano"><i style="background:@CorMm("t", 'v', a)"></i>@a</span> }
            @PaletaMm("t", anos)
        </div>
        <div class="vpm-sm-leg sub">
            <span><i class="sw linha"></i>linha: valor enviado em propostas (R$)</span>
            <span><i class="sw cheia"></i>colunas de cima: vendas (R$ mi)</span>
            <span><i class="sw clara"></i>colunas de baixo: propostas enviadas (qtd)</span>
            <span><i class="sw conv"></i>linha de baixo: taxa de conversão do mês (@RegraCurtaMm)</span>
            <span><i class="sw parcial"></i>mês em andamento (parcial)</span>
            <span><i class="sw neg"></i>venda negativa</span>
            <span class="txt">— = a apurar · n/d = sem dado registrado</span>
        </div>
        <div class="vpm-sm-grid" style="--cn:@CorMm("t", 'n', 0);--le:@CorMm("t", 'e', 0);--lx:@CorMm("t", 'x', 0)">
            @for (var m = 1; m <= 12; m++)
            {
                var mes = m;
                var cv = anos.Select(a => (a, c: CelVenda(a, mes))).ToList();
                var cp = anos.Select(a => (a, c: CelProp(a, mes))).ToList();
                // escalas do próprio mês; o mês parcial não entra no máximo
                var maxV = (double)cv.Where(x => x.c.Tem && x.c.Valor > 0).Select(x => x.c.Valor).DefaultIfEmpty(0m).Max();
                var minV = (double)cv.Where(x => x.c.Tem && x.c.Valor < 0).Select(x => x.c.Valor).DefaultIfEmpty(0m).Min();
                var maxP = (double)cp.Where(x => x.c.Tem && !x.c.Parcial).Select(x => x.c.Valor).DefaultIfEmpty(0m).Max();
                if (maxP <= 0) maxP = (double)cp.Where(x => x.c.Tem).Select(x => x.c.Valor).DefaultIfEmpty(1m).Max();
                if (maxP <= 0) maxP = 1;
                // linha do valor enviado em propostas (R$): escala do próprio mês; o mês parcial não entra no máximo
                var env = anos.Select((a, i) => (a, i, v: Prop(a, mes)?.Valor is decimal ev && ev > 0 ? ev : (decimal?)null, parc: CelProp(a, mes).Parcial)).ToList();
                var maxE = (double)env.Where(x => x.v is not null && !x.parc).Select(x => x.v!.Value).DefaultIfEmpty(0m).Max();
                if (maxE <= 0) maxE = (double)env.Where(x => x.v is not null).Select(x => x.v!.Value).DefaultIfEmpty(1m).Max();
                double Xe(int i) => (i + 0.5) / anos.Count * 100;
                double Ye(decimal v) => 12 + Math.Min(1, (double)v / maxE) * 58;   // % a partir de baixo da faixa da linha
                var trechos = new List<List<(double X, double Y)>>(); var trecho = new List<(double X, double Y)>();
                foreach (var e in env)
                {
                    if (e.v is not decimal ev2) { if (trecho.Count > 0) { trechos.Add(trecho); trecho = new(); } continue; }
                    trecho.Add((Xe(e.i), 100 - Ye(ev2)));
                }
                if (trecho.Count > 0) trechos.Add(trecho);
                // linha da taxa de conversão do mês (regra de "Taxa sobre"): escala entre a menor e a maior taxa do mês
                var conv = anos.Select((a, i) => (a, i, t: CelProp(a, mes).Tem ? TaxaMm(a, mes) : null, parc: CelProp(a, mes).Parcial)).ToList();
                var tcs = conv.Where(x => x.t is not null).Select(x => x.t!.Value).ToList();
                double tMin = tcs.DefaultIfEmpty(0).Min(), tMax = tcs.DefaultIfEmpty(0).Max();
                double Yc(double t) => tMax - tMin < 0.5 ? 45 : 14 + (t - tMin) / (tMax - tMin) * 52;
                var trechosC = new List<List<(double X, double Y)>>(); var trechoC = new List<(double X, double Y)>();
                foreach (var c in conv)
                {
                    if (c.t is not double tc) { if (trechoC.Count > 0) { trechosC.Add(trechoC); trechoC = new(); } continue; }
                    trechoC.Add((Xe(c.i), 100 - Yc(tc)));
                }
                if (trechoC.Count > 0) trechosC.Add(trechoC);
                var topoV = Math.Max(maxV, 0.0001) * 1.25;          // folga para o número em cima da coluna
                var faixaV = topoV - minV * 1.6;                     // folga para o número da venda negativa
                var zeroV = -minV * 1.6 / faixaV * 100;              // onde fica o zero das vendas (0 = na linha central)
                <div class="vpm-sm" style="--n:@anos.Count">
                    <div class="vpm-sm-t">@NomeDoMes(mes)</div>
                    <div class="vpm-sm-g">
                        <i class="vpm-sm-base"></i>
                        @if (minV < 0) { <i class="vpm-sm-zero" style="top:calc(var(--hl) + var(--hv) * @F(1 - zeroV / 100))"></i> }
                        <div class="vpm-sm-conv" aria-label="Taxa de conversão do mês, por ano">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                @foreach (var t in trechosC.Where(t => t.Count > 1))
                                {
                                    <polyline points="@string.Join(" ", t.Select(q => $"{F(q.X)},{F(q.Y)}"))" />
                                }
                            </svg>
                            @foreach (var c in conv.Where(x => x.t is not null))
                            {
                                var y = Yc(c.t!.Value);
                                <i class="vpm-sm-pt cv @(c.parc ? "parc" : "")" style="left:@F(Xe(c.i))%;bottom:@F(y)%"></i>
                                <b class="vpm-sm-le cv" style="left:@F(Xe(c.i))%;bottom:calc(@F(y)% + 5px)">@P1(c.t!.Value)@(c.parc ? "*" : "")</b>
                            }
                        </div>
                        <div class="vpm-sm-linha" aria-label="Valor enviado em propostas, por ano">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                @foreach (var t in trechos.Where(t => t.Count > 1))
                                {
                                    <polyline points="@string.Join(" ", t.Select(q => $"{F(q.X)},{F(q.Y)}"))" />
                                }
                            </svg>
                            @foreach (var e in env.Where(x => x.v is not null))
                            {
                                var y = Ye(e.v!.Value);
                                <i class="vpm-sm-pt @(e.parc ? "parc" : "")" style="left:@F(Xe(e.i))%;bottom:@F(y)%"></i>
                                <b class="vpm-sm-le" style="left:@F(Xe(e.i))%;bottom:calc(@F(y)% + 5px)">@ReaisMi(e.v!.Value)@(e.parc ? "*" : "")</b>
                            }
                        </div>
                        @foreach (var a in anos)
                        {
                            var v = cv.First(x => x.a == a).c; var p = cp.First(x => x.a == a).c;
                            var pm = Prop(a, mes);
                            var cor = CorMm("t", 'v', a);
                            var txtV = v.Tem ? (v.Valor < 0 ? "−" : "") + "R$ " + (Math.Abs(v.Valor) / 1_000_000m).ToString("#,##0.0", Br) + " mi" : v.Sit == SitMes.AApurar ? "a apurar" : "n/d";
                            var txtP = p.Tem ? N0((int)p.Valor) + (p.Parcial ? " (parcial)" : "") : p.Sit == SitMes.AApurar ? "a apurar" : "n/d";
                            var txtE = pm?.Valor is decimal ve && ve > 0 ? Mi(ve) + (pm.SemTaxa > 0 ? $" (parcial: {pm.SemTaxa} sem câmbio)" : "") : "—";
                            var porProp = v.Tem && p.Tem && !p.Parcial && p.Valor > 0 ? $"\n{(v.Valor < 0 ? "−" : "")}R$ {(Math.Abs(v.Valor) / p.Valor / 1000m).ToString("#,##0", Br)} mil por proposta" : "";
                            <div class="vpm-sm-c" style="--c:@cor;--cp:@CorMm("t", 'p', a)" title="@($"{NomeDoMes(mes)} {a}\nVendas: {txtV}\nPropostas: {txtP}\nValor enviado: {txtE}\nConversão: {(conv.FirstOrDefault(x => x.a == a).t is double tcv ? P1(tcv) : "—")}{porProp}")">
                                <div class="vpm-sm-l"></div>
                                <div class="vpm-sm-v">
                                    @if (v.Tem)
                                    {
                                        var val = (double)v.Valor;
                                        var alt = Math.Abs(val) / faixaV * 100;
                                        @if (val >= 0)
                                        {
                                            <i class="vpm-sm-bar v" style="bottom:@F(zeroV)%;height:@F(Math.Max(alt, 0.8))%"></i>
                                            <b class="vpm-sm-num" style="bottom:calc(@F(zeroV + alt)% + 2px)">@ReaisMi(v.Valor)</b>
                                        }
                                        else
                                        {
                                            <i class="vpm-sm-bar neg" style="bottom:@F(zeroV - alt)%;height:@F(alt)%"></i>
                                            <b class="vpm-sm-num neg" style="bottom:calc(@F(zeroV)% + 2px)">@ReaisMi(v.Valor)</b>
                                        }
                                    }
                                    else
                                    {
                                        <b class="vpm-sm-num vazio" style="bottom:calc(@F(zeroV)% + 2px)">@(v.Sit == SitMes.AApurar ? "—" : "n/d")</b>
                                    }
                                </div>
                                <div class="vpm-sm-p">
                                    @if (p.Tem)
                                    {
                                        var h = Math.Min(60, Math.Max((double)p.Valor / maxP * 60, 0.8));
                                        <i class="vpm-sm-bar p @(p.Parcial ? "parcial" : "")" style="height:@F(h)%"></i>
                                        <span class="vpm-sm-lp" style="top:calc(@F(h)% + 2px)">
                                            <b>@N0((int)p.Valor)@(p.Parcial ? "*" : "")</b>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="vpm-sm-lp vazio" style="top:3px"><b>@(p.Sit == SitMes.AApurar ? "—" : "n/d")</b></span>
                                    }
                                </div>
                                <div class="vpm-sm-cz"></div>
                                <span class="vpm-sm-ano">@Curto(a)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        string TotV(int a)
        {
            var l = Enumerable.Range(1, 12).Select(m => (m, c: CelVenda(a, m))).Where(x => x.c.Tem).ToList();
            if (l.Count == 0) return $"{a} n/d";
            var ult = l.Max(x => x.m);
            return $"{a} {MiCurto(l.Sum(x => x.c.Valor))}" + (ult < 12 ? $" ({MesesTxt(ult)})" : "");
        }
        string TotP(int a)
        {
            var l = Enumerable.Range(1, 12).Select(m => (m, c: CelProp(a, m))).Where(x => x.c.Tem).ToList();
            if (l.Count == 0) return $"{a} n/d";
            var ult = l.Max(x => x.m); var parc = l.FirstOrDefault(x => x.c.Parcial);
            return $"{a} {N0((int)l.Sum(x => x.c.Valor))}" + (ult < 12 ? $" ({MesesTxt(ult)}{(parc.c.Parcial ? $", {MesCurto(parc.m).ToLowerInvariant()} parcial" : "")})" : "");
        }
        string TotE(int a)
        {
            var l = Enumerable.Range(1, 12).Select(m => Prop(a, m)).Where(p => p?.Valor is > 0).ToList();
            return l.Count == 0 ? $"{a} n/d" : $"{a} {MiRot(l.Sum(p => p!.Valor!.Value))}" + (l.Any(p => p!.SemTaxa > 0) ? " (parcial: sem câmbio)" : "");
        }
        <div class="vpm-sm-tot">
            <div><b>Vendas (R$ mi):</b> @string.Join(" · ", anos.Select(TotV))</div>
            <div><b>Propostas:</b> @string.Join(" · ", anos.Select(TotP))@(_setor != "" ? " · " + _setor : "")</div>
            <div><b>Valor enviado (R$ mi):</b> @string.Join(" · ", anos.Select(TotE))</div>
            @if (semProp.Count > 0 || semVenda.Count > 0)
            {
                <div class="nd">@(semVenda.Count > 0 ? $"{string.Join(" e ", semVenda)}: sem vendas registradas. " : "")@(semProp.Count > 0 ? $"{string.Join(" e ", semProp)}: sem propostas registradas (n/d, não é zero)." : "") * = mês parcial ou valor parcial (proposta sem taxa de câmbio).</div>
            }
        </div>
    };

    private string RegraCurtaMm => _mmConvValor
        ? (BaseTodas ? "por valor: R$ ganho ÷ R$ de todas as enviadas no mês" : "por valor: R$ ganho ÷ R$ (ganho + perdido) no mês")
        : (BaseTodas ? "por quantidade: ganhas ÷ todas as enviadas no mês" : "por quantidade: ganhas ÷ decididas no mês");
    /// <summary>A regra da conversão do quadro mês a mês, por extenso (quantidade ou valor; decididas ou todas).</summary>
    private string RegraMm => _mmConvValor
        ? (BaseTodas ? "Valor ganho ÷ valor de todas as propostas enviadas × 100" : "Valor ganho ÷ (valor ganho + valor perdido) × 100")
        : RegraTxt;

    /// <summary>Valor em reais, curto: R$ 39.000.000 → "R$ 39 mi"; R$ 54.400.000 → "R$ 54,4 mi"; "R$ 1,2 bi".</summary>
    private static string ReaisMi(decimal v)
    {
        var mi = Math.Abs(v) / 1_000_000m;
        var t = mi >= 1000 ? (mi / 1000m).ToString("#,##0.#", Br) + " bi" : mi.ToString("#,##0.#", Br) + " mi";
        return (v < 0 ? "−" : "") + "R$ " + t;
    }

    /// <summary>R$ em milhões, curto para caber na coluna: "45,2", "421", "1,2 bi".</summary>
    private static string MiRot(decimal v)
    {
        var mi = Math.Abs(v) / 1_000_000m;
        var t = mi >= 1000 ? (mi / 1000m).ToString("#,##0.0", Br) + " bi" : mi >= 100 ? mi.ToString("#,##0", Br) : mi.ToString("#,##0.0", Br);
        return (v < 0 ? "−" : "") + t;
    }

    /// <summary>Resumo lateral de um ano: totais dos meses fechados, média e os meses mais forte e mais fraco.</summary>
    private RenderFragment ResumoAnoMm(int a) => __builder =>
    {
        var mv = FechadoV(a); var mp = FechadoP(a);
        var (sv, nv) = SomaMm(true, a, mv);
        var (sp, np) = SomaMm(false, a, mp);
        var vendasM = Enumerable.Range(1, mv).Select(m => (m, c: CelVenda(a, m))).Where(x => x.c.Tem).ToList();
        var propsM = Enumerable.Range(1, mp).Select(m => (m, c: CelProp(a, m))).Where(x => x.c.Tem && !x.c.Parcial).ToList();
        var parcial = a == DateTime.Today.Year ? CelProp(a, DateTime.Today.Month) : default;
        var tx = Taxa(a);
        var txMm = _mmConvValor ? tx.TaxaValor : tx.Taxa;
        <aside class="vpm-resumo um">
            <div class="vpm-rtit">Resumo de @a</div>
            <div class="vpm-blk">
                <span class="vpm-blk-t">Vendas · @MesesTxt(mv)</span>
                <b class="vpm-blk-v" title="@(nv > 0 ? Reais(sv) : "")">@(nv > 0 ? Mi(sv) : "n/d")</b>
                @if (nv > 0)
                {
                    var mx = vendasM.MaxBy(x => x.c.Valor); var mn = vendasM.MinBy(x => x.c.Valor);
                    <span>média @Mi(sv / nv) por mês</span>
                    <span>maior: @MesCurto(mx.m).ToLowerInvariant() @Mi(mx.c.Valor) · menor: @MesCurto(mn.m).ToLowerInvariant() @Mi(mn.c.Valor)</span>
                }
            </div>
            <div class="vpm-blk">
                <span class="vpm-blk-t">Propostas enviadas · @MesesTxt(mp)</span>
                <b class="vpm-blk-v">@(np > 0 ? N0((int)sp) : "n/d")</b>
                @if (np > 0)
                {
                    var mx = propsM.MaxBy(x => x.c.Valor); var mn = propsM.MinBy(x => x.c.Valor);
                    <span>média @N0((int)Math.Round(sp / np)) por mês</span>
                    <span>maior: @MesCurto(mx.m).ToLowerInvariant() @N0((int)mx.c.Valor) · menor: @MesCurto(mn.m).ToLowerInvariant() @N0((int)mn.c.Valor)</span>
                }
                @if (parcial.Tem && parcial.Parcial) { <span class="vpm-parc">+ @N0((int)parcial.Valor) em @NomeDoMes(DateTime.Today.Month).ToLowerInvariant() (parcial, fora do total)</span> }
            </div>
            <div class="vpm-blk">
                <span class="vpm-blk-t">Conversão · @(a == DateTime.Today.Year ? $"jan–{MesCurto(DateTime.Today.Month).ToLowerInvariant()}" : "jan–dez")</span>
                <b class="vpm-blk-v">@(txMm is double t ? P1(t) : "—")</b>
                <span>@(_mmConvValor ? "por valor · " + RegraMm : $"{N0(tx.G)} ganhas de {N0(tx.Base)} {DenRot} · {RegraTxt}")</span>
            </div>
        </aside>
    };

    /// <summary>Matriz ano × mês (todos os anos): o número de cada mês, com a cor mais forte onde o valor é maior.</summary>
    private RenderFragment MatrizMm(bool vendas, List<int> anos) => __builder =>
    {
        var cel = anos.ToDictionary(a => a, a => Enumerable.Range(1, 12).Select(m => Cel(vendas, a, m)).ToArray());
        var max = cel.Values.SelectMany(x => x).Where(x => x.Tem && x.Valor > 0).Select(x => x.Valor).DefaultIfEmpty(1m).Max();
        var corForte = vendas ? "#1f8a4c" : "#1d4f91";   // tabela de apoio: verde = vendas, azul = propostas
        var corFraca = vendas ? "#f3faf5" : "#f2f6fc";
        <div class="vpm-mat-card">
            <div class="vpm-gtit">
                <b>@(vendas ? "Vendas por ano e mês" : "Propostas enviadas por ano e mês")</b>
                <span>@(vendas ? "R$ milhões · empresa toda" : "quantidade" + (_setor != "" ? " · " + _setor : ""))</span>
                <span class="vpm-gleg"><span><i class="ol forte"></i>mês mais forte do ano</span><span><i class="ol fraco"></i>mês mais fraco</span></span>
            </div>
            <div class="vpm-mat-wrap">
                <table class="vpm-mat">
                    <thead><tr><th>Ano</th>@for (var m = 1; m <= 12; m++) { <th>@MesCurto(m).ToUpperInvariant()</th> }<th class="tot">Total</th></tr></thead>
                    <tbody>
                        @foreach (var a in anos)
                        {
                            var linha = cel[a];
                            var fechados = linha.Select((x, i) => (x, m: i + 1)).Where(t => t.x.Tem && !t.x.Parcial).ToList();
                            var forte = fechados.Count > 1 ? fechados.MaxBy(t => t.x.Valor).m : 0;
                            var fraco = fechados.Count > 1 ? fechados.MinBy(t => t.x.Valor).m : 0;
                            var total = linha.Where(x => x.Tem).Sum(x => x.Valor);
                            var ultimo = linha.Select((x, i) => (x, m: i + 1)).Where(t => t.x.Tem).Select(t => t.m).DefaultIfEmpty(0).Max();
                            var temParc = linha.Any(x => x.Parcial);
                            <tr class="@(a == _foco ? "foco" : "")">
                                <th>@a</th>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    var x = linha[m - 1];
                                    var cls = (m == forte ? " forte" : "") + (m == fraco ? " fraco" : "");
                                    @if (x.Tem && x.Valor < 0)
                                    {
                                        <td class="neg@(cls)" title="@($"{NomeDoMes(m)} {a}: {CelTxt(vendas, x, true)}")">@CelTxt(vendas, x, false)</td>
                                    }
                                    else if (x.Tem)
                                    {
                                        var pct = (double)Math.Clamp(x.Valor / max, 0m, 1m) * 88 + 4;
                                        var estilo = $"background:color-mix(in srgb, {corForte} {F(pct)}%, {corFraca});color:{(pct > 52 ? "#fff" : "#172B43")}";
                                        <td class="@((x.Parcial ? "parc" : "") + cls)" style="@estilo" title="@($"{NomeDoMes(m)} {a}: {CelTxt(vendas, x, true)}")">@CelTxt(vendas, x, false)@(x.Parcial ? "*" : "")</td>
                                    }
                                    else
                                    {
                                        <td class="@(x.Sit == SitMes.AApurar ? "apurar" : "nd")">@CelTxt(vendas, x, false)</td>
                                    }
                                }
                                <td class="tot" title="@(vendas ? Reais(total) : N0((int)total))">
                                    @(ultimo > 0 ? (vendas ? MiCurto(total) : N0((int)total)) : "n/d")
                                    @if (ultimo is > 0 and < 12 || temParc) { <small>@MesesTxt(ultimo)@(temParc ? " (último parcial)" : "")</small> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    };

    /// <summary>"Ver dados detalhados": os valores completos (R$ com centavos) e as quantidades exatas.</summary>
    private RenderFragment TabelaMm(string modo, List<int> anos, int principal, int? comp) => __builder =>
    {
        <div class="vpm-det-wrap">
            @if (modo == "comparar" && comp is int b)
            {
                var (mv, mp, A, B) = ResumoMm(principal, b);
