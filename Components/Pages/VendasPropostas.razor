    // Cada slide leva a foto do quadro da tela (wwwroot/apresentacao.js). Aqui só se
    // passa a página por cada estado (as 4 métricas do gráfico mensal) e se pede a foto.

    private string FiltrosTxt()
    {
        var partes = new List<string>();
        void Add(string rot, HashSet<string> set) { if (set.Count > 0) partes.Add($"{rot}: {string.Join(", ", set.Take(4))}{(set.Count > 4 ? $" +{set.Count - 4}" : "")}"); }
        Add("Ano", _fil.Anos); Add("Mês", _fil.Meses); Add("Setor", _fil.Origens); Add("Vendedor", _fil.Vendedores); Add("BU", _fil.Bus);
        Add("BU Intercompany", _fil.BuIcs); Add("Mercado", _fil.Mercados); Add("País", _fil.Paises); Add("Produto", _fil.Produtos);
        return partes.Count == 0 ? "Sem filtros (todas as propostas)" : string.Join(" · ", partes);
    }

