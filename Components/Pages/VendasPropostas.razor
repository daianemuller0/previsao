            <span class="cvx-note">@T("Valores completos, em reais e centavos, e as quantidades exatas de cada mês.", "Full values, with cents, and the exact counts for each month.")@(setor ? T(" Vendas por setor: os outros filtros (vendedor, BU, mercado…) valem só para as propostas e a conversão.", " Sales by sector: the other filters (salesperson, BU, market…) apply only to proposals and conversion.") : "")</span>
        </div>
        @if (st.Detalhe)
        {
            @if (modo == "historico") { <div class="vpm-mats">@MatrizMm(true, anos)@MatrizMm(false, anos)</div> }
            @TabelaMm(modo, anos, principal, comp)
        }
        _mmS = false;
