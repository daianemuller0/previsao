@page "/pipeline"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat

<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Pipeline</span></div>

<div class="page-head">
    <div>
        <h1>Pipeline</h1>
        <p class="subtitle">Funil comercial · @_open.Count oportunidade(s) aberta(s) · @Fmt.UsdShort(_open.Sum(o => o.AmountUsd)) em valor</p>
    </div>
    <div class="page-actions">
        <div class="segmented">
            @foreach (var v in _views)
            {
                <button class="@(_view == v.Key ? "active" : "")" @onclick="() => _view = v.Key">@v.Label</button>
            }
        </div>
    </div>
</div>

<div class="exec-grid cols-4">
    <StatCard Label="Pipeline total" Value="@Fmt.UsdShort(_open.Sum(o => o.AmountUsd))" Context="@($"{_open.Count} abertas")" AccentLeft="true" />
    <StatCard Label="Pipeline ponderado" Value="@Fmt.UsdShort(_open.Sum(ForecastCalc.WeightedUsd))" Context="probabilidade aplicada" />
    <StatCard Label="Ticket médio" Value="@Fmt.UsdShort(_avgDeal)" Context="por oportunidade" />
    <StatCard Label="Idade média" Value="@($"{_avgAge} dias")" Context="desde a criação" />
</div>

<div class="grid-2-1">
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Funil por etapa <span class="hint">valor aberto (USD)</span></div></div>
        <div class="funnel">
            @{ var maxVal = _stages.Count > 0 ? Math.Max(_stages.Max(s => s.Value), 1) : 1; }
            @foreach (var s in _stages)
            {
                <div class="funnel-stage">
                    <div class="funnel-meta">
                        <span class="funnel-name">@s.Name</span>
                        <span class="funnel-sub">@s.Count negócio(s) · @Fmt.UsdShort(s.Weighted) ponderado</span>
                    </div>
                    <div class="funnel-bar-wrap">
                        <div class="funnel-bar" style="width:@(Math.Max(s.Value / maxVal * 100, 6))%">@Fmt.UsdShort(s.Value)</div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Distribuição · @CurrentViewLabel</div></div>
        @{ var dist = Dist; var maxDist = dist.Count > 0 ? Math.Max(dist.Max(d => d.Value), 1) : 1; }
        @foreach (var d in dist)
        {
            <div class="bar-row">
                <span class="bar-label">@d.Name</span>
                <span class="bar-track"><span class="bar-fill c-primary" style="width:@(Math.Round(d.Value / maxDist * 100))%"></span></span>
                <span class="bar-value">@Fmt.UsdShort(d.Value)</span>
            </div>
        }
        @if (dist.Count == 0) { <div class="empty">Sem dados.</div> }
    </div>
</div>

<div class="panel">
    <div class="panel-head"><div class="panel-title">Detalhamento por etapa</div></div>
    <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
        <table class="grid-tbl">
            <thead>
                <tr><th>Etapa</th><th class="right">Qtd</th><th class="right">Valor</th><th class="right">Ponderado</th><th class="right">Idade média</th><th class="right">Conversão</th></tr>
            </thead>
            <tbody>
                @foreach (var s in _stages)
                {
                    <tr>
                        <td class="col-strong">@s.Name</td>
                        <td class="right num">@s.Count</td>
                        <td class="right num">@Fmt.Usd(s.Value)</td>
                        <td class="right num">@Fmt.Usd(s.Weighted)</td>
                        <td class="right num">@s.AvgAge d</td>
                        <td class="right num">@Fmt.Pct(s.Conversion)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Opportunity> _open = new();
    private DateTime _today = DateTime.Today;
    private string _view = "kam";
    private double _avgDeal;
    private int _avgAge;

    private record StageAgg(string Name, int Order, int Count, double Value, double Weighted, int AvgAge, double Conversion);
    private record NamedAgg(string Name, double Value);
    private List<StageAgg> _stages = new();

    private record ViewDef(string Key, string Label);
    private readonly ViewDef[] _views = { new("kam", "Por KAM"), new("market", "Por mercado"), new("product", "Por produto"), new("country", "Por país") };
    private string CurrentViewLabel => _views.First(v => v.Key == _view).Label;

    protected override void OnInitialized()
    {
        var all = Repo.All();
        _open = all.Where(o => ForecastCategories.IsOpen(o.Category)).ToList();
        _avgDeal = _open.Count > 0 ? _open.Average(o => o.AmountUsd) : 0;
        _avgAge = _open.Count > 0 ? (int)_open.Average(o => Age(o)) : 0;

        var openStages = Cat.Stages.Where(s => s.Id is not ("st-won" or "st-lost")).OrderBy(s => s.Order).ToList();
        var totalOpen = Math.Max(_open.Count, 1);
        _stages = openStages.Select(s =>
        {
            var items = _open.Where(o => o.PipelineStageId == s.Id).ToList();
            var age = items.Count > 0 ? (int)items.Average(Age) : 0;
            var conv = (double)_open.Count(o => Cat.StageOrder(o.PipelineStageId) >= s.Order) / totalOpen * 100;
            return new StageAgg(s.Name, s.Order, items.Count, items.Sum(o => o.AmountUsd), items.Sum(ForecastCalc.WeightedUsd), age, conv);
        }).ToList();
    }

    private List<NamedAgg> Dist
    {
        get
        {
            Func<Opportunity, string> key = _view switch
            {
                "market" => o => Cat.MarketName(o.MarketId),
                "product" => o => Cat.ProductName(o.ProductId),
                "country" => o => Cat.CountryName(o.CountryId),
                _ => o => Cat.KamName(o.KamId),
            };
            return _open.GroupBy(key).Select(g => new NamedAgg(g.Key, g.Sum(o => o.AmountUsd)))
                .OrderByDescending(x => x.Value).ToList();
        }
    }

    private int Age(Opportunity o)
    {
        var c = DateTime.TryParse(o.CreatedAt, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : _today;
        return Math.Max(0, (int)(_today - c).TotalDays);
    }
}
