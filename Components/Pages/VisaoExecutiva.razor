@page "/executivo"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject ControleRepository ControleRepo
@inject ChartPrefsRepository ChartPrefs
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@{ Build(); }

@* ===================== 1 · CABEÇALHO EXECUTIVO ===================== *@
<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span>Previsão de Vendas</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Visão Executiva</span></div>

<div class="page-head">
    <div>
        <h1>Previsão de Vendas</h1>
        <p class="subtitle">
            @Fmt.MonthLong(_month) de @_year · @(_quarter)º trimestre · Howden Brasil · @_currency<br />
            Última consolidação @_updated.ToString("dd/MM/yyyy 'às' HH:mm")
            &nbsp;·&nbsp; <span class="badge @DqCss">Qualidade dos dados @_dq%</span>
            &nbsp; <span class="badge @ConfCss">Confiança da previsão @_confidence%</span>
        </p>
    </div>
    <div class="page-actions">
        <div class="segmented" style="margin-right:2px">
            <button class="@(_currency == "USD" ? "active" : "")" @onclick='() => _currency = "USD"'>USD</button>
            <button class="@(_currency == "BRL" ? "active" : "")" @onclick='() => _currency = "BRL"'>BRL</button>
        </div>
        <button class="btn-ghost" @onclick='() => JS.InvokeVoidAsync("presentation.start")' title="Modo apresentação — tela cheia + rolagem automática (Esc para sair)">@Icons.Svg("play")Apresentação</button>
        <button class="btn-ghost" title="Exportar as oportunidades do recorte atual (respeita os filtros da página)" @onclick="ExportarFiltradas">@Icons.Svg("download")Exportar</button>
        @* Montar a página: arrastar os painéis e escolher a largura de cada um. *@
        <button class="btn-ghost @(_organizando ? "active" : "")" title="Arrastar os painéis para montar a página do seu jeito" @onclick="AlternarOrganizar">@Icons.Svg("layers")@(_organizando ? "Concluir" : "Organizar")</button>
        @if (_organizando)
        {
            <button class="btn-ghost" title="Voltar à disposição original dos painéis" @onclick="RestaurarLayout">@Icons.Svg("history")Restaurar padrão</button>
        }
        <a class="btn-primary" href="/oportunidades">@Icons.Svg("opportunity")Abrir Oportunidades</a>
    </div>
</div>

@* ---- Filtros globais ---- *@
<div class="filterbar filterbar-sticky">
    <div class="flt"><span class="flt-label">Buscar</span><input class="flt-search" placeholder="oportunidade, cliente, proposta…" @bind="_search" @bind:event="oninput" /></div>
    <MultiFilter Label="Ano" AllText="Todos" Options="YearOptions.Select(y => y.ToString())" Selected="_years" OnChanged="StateHasChanged" />
    <MultiFilter Label="Mês" AllText="Todos" Options="MonthOptions" Selected="_months" OnChanged="StateHasChanged" />
    <div class="flt"><span class="flt-label">De</span><input class="flt-date" type="date" @bind="_dateFrom" /></div>
    <div class="flt"><span class="flt-label">Até</span><input class="flt-date" type="date" @bind="_dateTo" /></div>
    <MultiFilter Label="Mercado" AllText="Todos" Options="MarketOptions" Selected="_markets" OnChanged="StateHasChanged" />
    <MultiFilter Label="KAM" AllText="Todos" EmptyText="Nenhum vendedor nos dados." Options="KamOptions" Selected="_kams" OnChanged="StateHasChanged" />
    <MultiFilter Label="Setor" AllText="Ambos" Options="SetorOptions" Selected="_setores" OnChanged="StateHasChanged" />
    <label class="flt-toggle @(_onlyIndicated ? "on" : "")" title="Mostrar somente as oportunidades indicadas na previsão"><input type="checkbox" @bind="_onlyIndicated" />@Icons.Svg("flag")<span>Somente indicadas</span></label>
    <label class="flt-toggle @(_semOtp ? "on" : "")" title="Tirar do recorte as oportunidades já marcadas como OTP"><input type="checkbox" @bind="_semOtp" />@Icons.Svg("x")<span>Sem OTP</span></label>
    @if (_showMore)
    {
        <MultiFilter Label="País" AllText="Todos" Options="CountryOptions" Selected="_countries" OnChanged="StateHasChanged" />
        <MultiFilter Label="Produto" AllText="Todos" Options="ProductOptions" Selected="_products" OnChanged="StateHasChanged" />
        <MultiFilter Label="Cliente" AllText="Todos" Options="CustomerOptions" Selected="_customers" OnChanged="StateHasChanged" />
        <MultiFilter Label="Unidade de negócio" AllText="Todas" Options="BuOptions" Selected="_bus" OnChanged="StateHasChanged" />
        <div class="flt"><span class="flt-label">Filtrar por</span><select @bind="_valMetric"><option value="total">Valor total</option><option value="conv">Chance de conversão</option></select></div>
        <div class="flt"><span class="flt-label">Mínimo R$</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="0" @bind="_valMin" /></div>
        <div class="flt"><span class="flt-label">Máximo R$</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="—" @bind="_valMax" /></div>
    }
    <button class="btn-link" @onclick="() => _showMore = !_showMore">@(_showMore ? "Menos filtros" : "Mais filtros")</button>
    <div class="filterbar-spacer"></div>
    <div class="fb-summary">
        <div class="fb-sum"><span class="fb-sum-k">Vendido@(_monthFilter is >= 1 and <= 12 ? " · " + Fmt.MonthName(_monthFilter) : "")</span><span class="fb-sum-v pos">@MoneyBrl(_heroReal)</span></div>
        <div class="fb-sum"><span class="fb-sum-k">Previsão</span><span class="fb-sum-v">@Money(_fcYear)</span></div>
    </div>
    @if (_activeFilters > 0)
    {
        <span class="tag">@_activeFilters ativo(s)</span>
        <button class="btn-link" @onclick="ClearFilters">Limpar</button>
    }
    <button class="btn-link" @onclick="SaveView">Salvar visualização</button>
    @if (_savedMsg) { <span class="saved-flag">@Icons.Svg("check")Salvo</span> }
</div>

@* ===========================================================================
   PAINEL MONTÁVEL: daqui até o fim, cada bloco marcado com data-pnl é uma peça
   que a pessoa pode arrastar para onde quiser e deixar com meia largura ou
   inteira. Os agrupamentos internos (.g12, #xf-charts) viram "display: contents"
   pelo CSS, então todas as peças ficam na MESMA grade — é isso que permite um
   gráfico sair de uma linha e ir para outra.
   =========================================================================== *@
<div class="g12 exec-board" id="exec-board">
@* ===================== EXECUTIVE OVERVIEW (KPIs) ===================== *@
@{
    var _fcBrl = _fcYear * Rate;   // sempre em R$ (Amount converted), independe do toggle
    var _fcAtt = _metaYear > 0 ? _fcBrl / _metaYear * 100 : 0;
    var _wonAtt = _heroMeta > 0 ? _heroReal / _heroMeta * 100 : 0;
    var _gapTgt = Math.Max(_metaYear - _fcBrl, 0);
    var _gmPp = _gmAvg - 30.0;
}
<div class="xsec lvl1" data-pnl="sec-visao">
    <span class="xsec-t">Visão Geral Executiva</span>
    <span class="xsec-s">how are we performing · @_year · @_currency</span>
    <span class="xsec-line"></span>
</div>
<div class="kpi-row" data-pnl="kpis">
    <div class="kpi">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("trend")</span><span class="kpi-label">Previsão</span></div>
        <div class="kpi-value">@Money(_fcYear)</div>
        <div class="kpi-delta @(_fcAtt >= 100 ? "pos" : "neutral")"><span class="arw">@(_fcAtt >= 100 ? "▲" : "•")</span> @Fmt.Pct(_fcAtt) <span class="ctx">da meta</span></div>
        <div class="kpi-spark"><Sparkline Values="@_monthAmt" Stroke="#17a2c0" /></div>
    </div>
    <div class="kpi accent-pos">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("check")</span><span class="kpi-label">Ganho / Fechado</span></div>
        <div class="kpi-value">@MoneyBrl(_heroReal)</div>
        <div class="kpi-delta @(_wonAtt >= 100 ? "pos" : "neutral")"><span class="arw">@(_wonAtt >= 100 ? "▲" : "•")</span> @Fmt.Pct(_wonAtt) <span class="ctx">da meta</span></div>
        <div class="kpi-spark"><Sparkline Values="@_mReal" Stroke="#1f9254" /></div>
    </div>
    <div class="kpi @(_gmAvg >= 30 ? "accent-pos" : "accent-warn")">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("executive")</span><span class="kpi-label">Margem Bruta</span></div>
        <div class="kpi-value">@Fmt.Pct(_gmAvg)</div>
        <div class="kpi-delta @(_gmPp >= 0 ? "pos" : "warn")"><span class="arw">@(_gmPp >= 0 ? "▲" : "▼")</span> @Math.Abs(_gmPp).ToString("0.0", _pt) pp <span class="ctx">vs meta de 30%</span></div>
        <div class="kpi-bar"><i style="width:@Share(_gmAvg, 40)%"></i></div>
    </div>
</div>

@* ===================== 2 · HERO EXECUTIVO ===================== *@
<div class="hero" data-pnl="hero">
    <div class="hero-main">
        <div class="hero-eyebrow">Realizado × Meta · REPORT HSA · @(_monthFilter is >= 1 and <= 12 ? Fmt.MonthLong(_monthFilter) + " " + _repYear : "Ano " + _repYear)</div>
        <div class="hero-value"><span class="cur">@_sym</span>@Fmt.Compact(CvBrl(_heroReal))</div>
        <div class="hero-target-line">
            Meta NB+AFM @MoneyBrl(_heroMeta) · @Fmt.Pct(_heroAttain) da meta · gap @MoneyBrl(Math.Max(_heroMeta - _heroReal, 0))<br />
            Meta Vendas HSA @MoneyBrl(_heroMetaHsa) · @Fmt.Pct(_heroAttainHsa) da meta · gap @MoneyBrl(Math.Max(_heroMetaHsa - _heroReal, 0))
        </div>
        <div class="hero-chips">
            <div class="hero-chip"><div class="k">Meta NB+AFM</div><div class="v">@MoneyBrl(_heroMeta)</div></div>
            <div class="hero-chip"><div class="k">Meta Vendas HSA</div><div class="v">@MoneyBrl(_heroMetaHsa)</div></div>
            <div class="hero-chip"><div class="k">Realizado</div><div class="v">@MoneyBrl(_heroReal)</div></div>
        </div>
        <div class="hero-gauge">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttain)%"></div></div>
            <div class="gl"><span>Atingimento · Meta NB+AFM</span><span>@Fmt.Pct(_heroAttain)</span></div>
        </div>
        <div class="hero-gauge" style="margin-top:8px">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttainHsa)%"></div></div>
            <div class="gl"><span>Atingimento · Meta Vendas HSA</span><span>@Fmt.Pct(_heroAttainHsa)</span></div>
        </div>
    </div>
</div>

@* ---- Vendas x Meta (NB+AFM) · fonte: Controle · REPORT HSA ---- *@
<div class="panel" style="margin-top:16px" data-pnl="vendas-meta">
    <div class="panel-head">
        <div class="panel-title">Vendas x Meta · NB+AFM
            <span class="hint">realizado x budget mensal · fonte: Controle · REPORT HSA · R$ · @_repYear</span>
        </div>
        <div class="rep-attain-group">
            <div class="rep-attain-box">
                <span class="ra-label">Atend. Meta NB+AFM (ano)</span>
                <span class="ra-value" style="color:@AtColor(_repAttain)">@Fmt.Pct(_repAttain)</span>
            </div>
            <div class="rep-attain-box">
                <span class="ra-label">Atend. Meta Vendas HSA (ano)</span>
                <span class="ra-value" style="color:@AtColor(_repAttainHsa)">@Fmt.Pct(_repAttainHsa)</span>
            </div>
        </div>
        <TelaCheia />
    </div>
    @if (_repReal.Any(v => v > 0) || _repMeta.Any(v => v > 0) || _repMetaHsa.Any(v => v > 0))
    {
        <div class="chart-body">@RenderReportLine()</div>
    }
    else
    {
        <div class="empty">Sem dados no Controle (REPORT HSA) para @_repYear. Preencha os valores na guia <a href="/controle">Controle</a>.</div>
    }
</div>

@* ============ SALES FUNNEL + PREVISÃO INDICADA (lado a lado) ============ *@
<div class="xsec" data-pnl="sec-funil">
    <span class="xsec-t">Funil de Vendas por Etapa</span>
    <span class="xsec-s">sequência do funil · @_currency</span>
    <span class="xsec-line"></span>
    @if (_indicadas.Count > 0) { <span class="ind-badge">@Icons.Svg("flag")@_indicadas.Count indicadas · @MoneyBrl(_indTotal)</span> }
    @if (_stage != "") { <button class="btn-link" @onclick='() => CrossFilter("stage", _stage)'>Limpar Etapa</button> }
</div>
<div class="g12">
    <div class="c6" data-pnl="funil"><div class="xcard pf-card">
    @if (_funnel.Count == 0)
    {
        <div class="empty">Sem dados no recorte. Importe a base do Funil de Vendas HSA na guia <a href="/oportunidades">Oportunidades</a>.</div>
    }
    else
    {
        var _fnOpps = _funnel.Sum(x => x.Count);
        var _fnTop2 = _funnel.Count >= 2 ? _funnel.Take(2).Sum(x => x.Value) / _funnelTotal * 100 : 100;
        <div class="pf-head">
            <div>
                <div class="xcard-title">@Icons.Svg("pipeline", "pf-ico")Funil de Vendas por Etapa</div>
                <div class="xcard-sub">Valor · @_currency · @_funnel.Count etapas · sequência do funil</div>
            </div>
            <div class="pf-totals">
                <div class="pf-tot"><div class="pf-tot-l">Total do Funil</div><div class="pf-tot-v">@MoneyBrl(_funnelTotal)</div></div>
                <div class="pf-tot"><div class="pf-tot-l">Total de Oportunidades</div><div class="pf-tot-v">@_fnOpps</div></div>
                <TelaCheia />
            </div>
        </div>
        <div class="pf-insight">@Icons.Svg("trend")<span><strong>@Fmt.Pct(_fnTop2)</strong> do valor do funil está concentrado @(_funnel.Count >= 2 ? "nas duas primeiras etapas" : "na primeira etapa").</span></div>
        <div class="fn5 @(DimActive("stage") ? "has-active" : "")">
            @for (var i = 0; i < _funnel.Count; i++)
            {
                var f = _funnel[i];
                var sh = f.Value / _funnelTotal * 100;
                var conv = i < _funnel.Count - 1 && f.Value > 0 ? _funnel[i + 1].Value / f.Value * 100 : (double?)null;
                // Geometria por posição: sempre afunilando (largura decrescente).
                var dw = FnW(i, _funnel.Count);
                var dwN = i < _funnel.Count - 1 ? FnW(i + 1, _funnel.Count) : dw * 0.86;
                var frac = dwN / dw;
                var inset = (1 - frac) / 2 * 100;
                <div class="fn5-seg @(IsActive("stage", f.Stage) ? "xf-on" : "")" style="width:@F(dw)%" @onclick='() => CrossFilter("stage", f.Stage)' title="@f.Stage — @MoneyBrl(f.Value) · @Fmt.Pct(sh) do funil · @f.Count oportunidades@(conv is { } cv ? " · " + Fmt.Pct(cv) + " para a próxima" : "")">
                    <div class="fn5-shape" style="clip-path:polygon(0 0, 100% 0, @F(100 - inset)% 100%, @F(inset)% 100%);background:@FunnelBar(i, _funnel.Count)"></div>
                    <div class="fn5-text @(FunnelDark(i, _funnel.Count) ? "dark" : "")">
                        <div class="fn5-name">@f.Stage</div>
                        <div class="fn5-amt">@MoneyBrl(f.Value)</div>
                        <div class="fn5-sub">@Fmt.Pct(sh) do funil · @f.Count oport.@(conv is { } c ? " · ↓ " + Fmt.Pct(c) + " para a próxima" : "")</div>
                    </div>
                </div>
            }
        </div>
        @* Base do funil: valor efetivamente vendido (Realizado · REPORT HSA). *@
        <div class="fn5-bottom">
            <span class="fn5-bottom-l">@Icons.Svg("check")Vendas totais · Realizado@(_monthFilter is >= 1 and <= 12 ? " · " + Fmt.MonthName(_monthFilter) : "")</span>
            <span class="fn5-bottom-v">@MoneyBrl(_heroReal)</span>
        </div>
    }
    </div></div>
    <div class="c6" data-pnl="funil-indicadas">
    @if (_indicadas.Count == 0)
    {
        <div class="xcard ind-card"><div class="ind-empty">
            <span class="ind-empty-ico">@Icons.Svg("flag")</span>
            <div><strong>Nenhuma oportunidade indicada ainda.</strong><br />
                Use o botão <span class="ind-hint">@Icons.Svg("flag")Indicar na Previsão</span> na aba <a href="/oportunidades">Oportunidades</a> ou no Top 10 — as indicadas aparecem aqui com funil, gráfico e lista próprios.</div>
        </div></div>
    }
    else
    {
        @* Funil só das indicadas *@
        @* Mesma estrutura do funil ao lado (cabeçalho, aviso, etapas e base):
           são leituras que se comparam, então qualquer diferença de formato
           vira ruído na hora de olhar os dois juntos. *@
        <div class="xcard pf-card ind-card">
            @{
                var _ifOpps = _indFunnel.Sum(x => x.Count);
                var _ifTop2 = _indFunnel.Count >= 2 ? _indFunnel.Take(2).Sum(x => x.Value) / Math.Max(_indTotal, 1) * 100 : 100;
            }
            <div class="pf-head">
                <div>
                    <div class="xcard-title">@Icons.Svg("flag", "pf-ico")Funil das Indicadas por Etapa</div>
                    <div class="xcard-sub">Valor · @_currency · @_indFunnel.Count etapas · @Fmt.Pct(_indTotal / Math.Max(_funnelTotal, 1) * 100) do pipeline</div>
                </div>
                <div class="pf-totals">
                    <div class="pf-tot"><div class="pf-tot-l">Total do Funil</div><div class="pf-tot-v">@MoneyBrl(_indTotal)</div></div>
                    <div class="pf-tot"><div class="pf-tot-l">Total de Oportunidades</div><div class="pf-tot-v">@_ifOpps</div></div>
                    <TelaCheia />
                </div>
            </div>
            <div class="pf-insight">@Icons.Svg("trend")<span><strong>@Fmt.Pct(_ifTop2)</strong> do valor do funil está concentrado @(_indFunnel.Count >= 2 ? "nas duas primeiras etapas" : "na primeira etapa").</span></div>
            <div class="fn5 @(DimActive("stage") ? "has-active" : "")">
                @for (var i = 0; i < _indFunnel.Count; i++)
                {
                    var f = _indFunnel[i];
                    var sh = f.Value / Math.Max(_indTotal, 1) * 100;
                    var conv = i < _indFunnel.Count - 1 && f.Value > 0 ? _indFunnel[i + 1].Value / f.Value * 100 : (double?)null;
                    var dw = FnW(i, _indFunnel.Count);
                    var dwN = i < _indFunnel.Count - 1 ? FnW(i + 1, _indFunnel.Count) : dw * 0.86;
                    var frac = dwN / dw;
                    var inset = (1 - frac) / 2 * 100;
                    <div class="fn5-seg @(IsActive("stage", f.Stage) ? "xf-on" : "")" style="width:@F(dw)%" @onclick='() => CrossFilter("stage", f.Stage)' title="@f.Stage — @MoneyBrl(f.Value) · @Fmt.Pct(sh) do funil · @f.Count oportunidades@(conv is { } cv ? " · " + Fmt.Pct(cv) + " para a próxima" : "")">
                        <div class="fn5-shape" style="clip-path:polygon(0 0, 100% 0, @F(100 - inset)% 100%, @F(inset)% 100%);background:@FunnelBar(i, _indFunnel.Count)"></div>
                        <div class="fn5-text @(FunnelDark(i, _indFunnel.Count) ? "dark" : "")">
                            <div class="fn5-name">@f.Stage</div>
                            <div class="fn5-amt">@MoneyBrl(f.Value)</div>
                            <div class="fn5-sub">@Fmt.Pct(sh) do funil · @f.Count oport.@(conv is { } c ? " · ↓ " + Fmt.Pct(c) + " para a próxima" : "")</div>
                        </div>
                    </div>
                }
            </div>
            @* Mesma base do outro funil: o valor efetivamente vendido. *@
            <div class="fn5-bottom">
                <span class="fn5-bottom-l">@Icons.Svg("check")Vendas totais · Realizado@(_monthFilter is >= 1 and <= 12 ? " · " + Fmt.MonthName(_monthFilter) : "")</span>
                <span class="fn5-bottom-v">@MoneyBrl(_heroReal)</span>
            </div>
        </div>

        @* Indicadas por vendedor *@
        <div class="xcard ind-card" style="margin-top:16px">
            <div class="xcard-head"><span class="xcard-ico ind-ico">@Icons.Svg("opportunity")</span><div><div class="xcard-title">Indicadas por Vendedor</div><div class="xcard-sub">@_indByRep.Count vendedor(es) · valor indicado</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_indByRep.Sum(x => x.Value))</b></span><TelaCheia /></div>
            @{ var _indRepMax = _indByRep.Count > 0 ? _indByRep.Max(x => x.Value) : 1; }
            <div class="ibar scroll-y" style="max-height:300px">
                @foreach (var s in _indByRep)
                {
                    var sh = s.Value / Math.Max(_indTotal, 1) * 100;
                    <div class="ibar-item @(IsActive("kam", s.Label) ? "xf-on" : "")" @onclick='() => CrossFilter("kam", s.Label)' title="@s.Label — @MoneyBrl(s.Value) · @Fmt.Pct(sh)">
                        <div class="ibar-head">
                            <span class="ibar-name">@s.Label</span>
                            <span class="ibar-metrics"><span class="ibar-val">@MoneyBrl(s.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                        </div>
                        <div class="ibar-track"><span class="ibar-fill" style="width:@Share(s.Value, _indRepMax)%;background:linear-gradient(90deg,#c98a12,#e6a72a)"></span></div>
                    </div>
                }
            </div>
        </div>
    }
    </div>
</div>

@* Lista das indicadas (linha inteira) *@
@if (_indicadas.Count > 0)
{
    <div class="g12" style="margin-top:16px">
        <div class="c12" data-pnl="lista-indicadas"><div class="xcard ind-card">
            <div class="xcard-head">
                <span class="xcard-ico ind-ico">@Icons.Svg("flag")</span>
                <div><div class="xcard-title">Oportunidades indicadas</div><div class="xcard-sub">@_indicadas.Count · clique para abrir a oportunidade</div></div>
                <span class="xcard-total"><span>Total</span><b>@MoneyBrl(_indTotal)</b></span>
                <button class="btn-ghost" style="padding:4px 10px;margin-left:12px" title="Exportar só as oportunidades indicadas (.xlsx)" @onclick="ExportarIndicadas">
                    @Icons.Svg("download")Exportar
                </button>
                <TelaCheia />
            </div>
            <OpportunityTable Rows="_indicadas" CssClass="tbl-compact" Style="max-height:380px;overflow:auto"
                              EmptyText="Nenhuma oportunidade indicada no recorte." OnChanged="ReloadOpps"
                              ShowColumnPicker="false" />
        </div></div>
    </div>
}

@* ===================== REVENUE DISTRIBUTION & PERFORMANCE ===================== *@
@{
    var _segTot = Math.Max(_bySegment.Sum(x => x.Value), 1);
    var _repTot = Math.Max(_byRep.Sum(x => x.Value), 1);
    var _repMax = _byRep.Count > 0 ? _byRep.Max(x => x.Value) : 1;
    var _buTot = Math.Max(_byBu2.Sum(x => x.Value), 1);
    var _smMax = _bySubMarket.Count > 0 ? _bySubMarket.Max(x => x.Value) : 1;
}
<div class="xsec" data-pnl="sec-distribuicao">
    <span class="xsec-t">Distribuição de Receita &amp; Desempenho</span>
    <span class="xsec-s">de onde vem a receita · quem está gerando · @_currency</span>
    <span class="xsec-line"></span>
    <span class="xsec-s">clique em qualquer elemento para filtrar</span>
</div>
<div id="xf-charts">
    <div class="g12">
        @* ---- Commercial Segment (donut + lista) ---- *@
        <div class="c6" data-pnl="segmento"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Segmento Comercial</div><div class="xcard-sub">@_bySegment.Count segmentos · arraste para reordenar</div></div>@ChartToolsFor("segment")<TelaCheia /></div>
            @if (_bySegment.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="seg-wrap">
                    <div class="seg-donut">
                        @RenderDonutRing(_bySegment, "segment")
                        <div class="seg-center"><div><div class="lab">Total</div><div class="val">@MoneyBrl(_bySegment.Sum(x => x.Value))</div></div></div>
                    </div>
                    <div class="seg-list scroll-y ch-drag" id="ch-segment" style="max-height:230px;@BarStyle("segment")">
                        @{ var si = 0; }
                        @foreach (var s in Ord("segment", _bySegment, x => x.Label))
                        {
                            var c = SegColors[si++ % SegColors.Length];
                            <div class="seg-row @(IsActive("segment", s.Label) ? "xf-on" : "")" draggable="true" data-key="@s.Label" @onclick='() => CrossFilter("segment", s.Label)' title="@s.Label">
                                <span class="seg-dot" style="background:@c"></span>
                                <span class="seg-name">@s.Label</span>
                                <span class="seg-val">@MoneyBrl(s.Value)</span>
                                <span class="seg-share">@Fmt.Pct(s.Value / _segTot * 100)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div></div>

        @* ---- Forecast by Market (ranking) ---- *@
        <div class="c6" data-pnl="mercado"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("bar-chart")</span><div><div class="xcard-title">Previsão por Mercado</div><div class="xcard-sub">@_byMarket.Count mercados · arraste para reordenar</div></div><span class="xcard-total"><span>Total</span><b>@Money(_byMarket.Sum(x => x.Value))</b></span>@ChartToolsFor("market")<TelaCheia /></div>
            @if (_byMarket.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="ibar @(DimActive("market") ? "has-active" : "") scroll-y ch-drag" id="ch-market" style="max-height:340px;@BarStyle("market")">
                    @foreach (var m in Ord("market", _byMarket, x => x.Name))
                    {
                        var sh = m.Value / _marketTotal * 100;
                        <div class="ibar-item @(IsActive("market", m.Name) ? "xf-on" : "")" draggable="true" data-key="@m.Name" @onclick='() => CrossFilter("market", m.Name)' title="@m.Name — Previsão @Money(m.Value) · Participação @Fmt.Pct(sh)">
                            <div class="ibar-head">
                                <span class="ibar-name">@m.Name</span>
                                <span class="ibar-metrics"><span class="ibar-val">@Money(m.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(m.Value, _maxMarket)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    @* ---- Sales Rep Performance | Forecast by Product (lado a lado) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c6" data-pnl="vendedor"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("opportunity")</span><div><div class="xcard-title">Desempenho por Vendedor</div><div class="xcard-sub">@_byRep.Count vendedores · NB + AFM · arraste para reordenar</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_byRep.Sum(x => x.Value))</b></span>@ChartToolsFor("kam")<TelaCheia /></div>
            @if (_byRep.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="ibar @(DimActive("kam") ? "has-active" : "") scroll-y ch-drag" id="ch-kam" style="max-height:460px;@BarStyle("kam")">
                    @{ var ri = 0; }
                    @foreach (var s in Ord("kam", _byRep, x => x.Label))
                    {
                        ri++;
                        var sh = s.Value / _repTot * 100;
                        <div class="ibar-item @(ri <= 3 ? $"top{ri}" : "") @(IsActive("kam", s.Label) ? "xf-on" : "")" draggable="true" data-key="@s.Label" @onclick='() => CrossFilter("kam", s.Label)' title="#@ri @s.Label — Previsão @MoneyBrl(s.Value) · Participação @Fmt.Pct(sh)">
                            <div class="ibar-head">
                                <span class="ibar-num">@ri</span>
                                <span class="ibar-name">@s.Label</span>
                                <span class="ibar-metrics"><span class="ibar-val">@MoneyBrl(s.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(s.Value, _repMax)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
        <div class="c6" data-pnl="produto"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("layers")</span><div><div class="xcard-title">Previsão por Produto</div><div class="xcard-sub">@_byProduct.Count produtos · arraste para reordenar</div></div><span class="xcard-total"><span>Total</span><b>@Money(_byProduct.Sum(x => x.Value))</b></span>@ChartToolsFor("product")<TelaCheia /></div>
            @if (_byProduct.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="ibar @(DimActive("product") ? "has-active" : "") scroll-y ch-drag" id="ch-product" style="max-height:400px;@BarStyle("product")">
                    @foreach (var p in Ord("product", _byProduct, x => x.Name))
                    {
                        var gmCls = p.Margin >= 28 ? "hi" : (p.Margin <= 18 ? "lo" : "");
                        var sh = p.Value / _productTotal * 100;
                        <div class="ibar-item @(IsActive("product", p.Name) ? "xf-on" : "")" draggable="true" data-key="@p.Name" @onclick='() => CrossFilter("product", p.Name)' title="@p.Name — Previsão @Money(p.Value) · Participação @Fmt.Pct(sh) · Margem @Fmt.Pct(p.Margin)">
                            <div class="ibar-head">
                                <span class="ibar-name">@p.Name</span>
                                <span class="ibar-metrics"><span class="ibar-val">@Money(p.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span><span class="gm-pill @gmCls">GM @Fmt.Pct(p.Margin)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(p.Value, _maxProduct)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    <div class="g12">
        @* ---- Sub-Market Performance (lollipop) ---- *@
        <div class="c6" data-pnl="submercado"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("trend")</span><div><div class="xcard-title">Desempenho por Sub-Mercado</div><div class="xcard-sub">@_bySubMarket.Count sub-mercados · arraste para reordenar</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_bySubMarket.Sum(x => x.Value))</b></span>@ChartToolsFor("submarket")<TelaCheia /></div>
            @if (_bySubMarket.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="lolli scroll-y ch-drag" id="ch-submarket" style="max-height:380px;@BarStyle("submarket")">
                    @foreach (var s in Ord("submarket", _bySubMarket, x => x.Label))
                    {
                        <div class="lolli-row @(IsActive("submarket", s.Label) ? "xf-on" : "")" draggable="true" data-key="@s.Label" @onclick='() => CrossFilter("submarket", s.Label)' title="@s.Label">
                            <span class="lolli-name">@s.Label</span>
                            <span class="lolli-track"><span class="lolli-line" style="width:calc(@Share(s.Value, _smMax)% - 12px)"></span><span class="lolli-dot"></span></span>
                            <span class="lolli-val">@MoneyBrl(s.Value)</span>
                        </div>
                    }
                </div>
            }
        </div></div>

        @* ---- Business Unit Performance (donut + lista) ---- *@
        <div class="c6" data-pnl="unidade"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Desempenho por Unidade de Negócio</div><div class="xcard-sub">@_byBu2.Count unidades · arraste para reordenar</div></div>@ChartToolsFor("bu")<TelaCheia /></div>
            @if (_byBu2.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="seg-wrap">
                    <div class="seg-donut">
                        @RenderDonutRing(_byBu2, "bu")
                        <div class="seg-center"><div><div class="lab">Total</div><div class="val">@MoneyBrl(_byBu2.Sum(x => x.Value))</div></div></div>
                    </div>
                    <div class="seg-list scroll-y ch-drag" id="ch-bu" style="max-height:230px;@BarStyle("bu")">
                        @{ var bi = 0; }
                        @foreach (var b in Ord("bu", _byBu2, x => x.Label))
                        {
                            var c = SegColors[bi++ % SegColors.Length];
                            <div class="seg-row @(IsActive("bu", b.Label) ? "xf-on" : "")" draggable="true" data-key="@b.Label" @onclick='() => CrossFilter("bu", b.Label)' title="@b.Label">
                                <span class="seg-dot" style="background:@c"></span>
                                <span class="seg-name">@b.Label</span>
                                <span class="seg-val">@MoneyBrl(b.Value)</span>
                                <span class="seg-share">@Fmt.Pct(b.Value / _buTot * 100)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div></div>
    </div>

    @* ---- Valor por trimestre + Aftermarket × New Business (lado a lado) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c6" data-pnl="trimestre"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Valor por trimestre</div><div class="xcard-sub">1º a 4º tri · @_currency</div></div><TelaCheia /></div>
            @{ var qData = Enumerable.Range(0, 4).Select(q => new SliceRow($"{q + 1}º tri", _byQuarter[q])).Where(x => x.Value > 0).ToList(); }
            @if (qData.Count > 0) { <div class="chart-body donut">@RenderDonut(qData)</div> } else { <div class="empty">Sem dados no recorte.</div> }
        </div></div>
        <div class="c6" data-pnl="afm-nb"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Aftermarket × New Business</div><div class="xcard-sub">participação no pipeline · por setor</div></div><TelaCheia /></div>
            @if (_bySetor.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else { <div class="chart-body donut">@RenderDonut(_bySetor)</div> }
            <div class="muted" style="font-size:11px;margin-top:8px">Divisão do pipeline entre Aftermarket e New Business (origem da oferta).</div>
        </div></div>
    </div>

    @* ---- Forecast by Month (timing) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c12" data-pnl="previsao-mensal"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("trend")</span><div><div class="xcard-title">Previsão por Mês</div><div class="xcard-sub">Data de fechamento · clique num mês para filtrar</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_monthAmt.Sum())</b></span><TelaCheia /></div>
            <div class="chart-body">@RenderXfColumns(_monthAmt)</div>
        </div></div>
    </div>
</div>

@* ===================== EXECUTIVE INSIGHTS ===================== *@
<div class="xsec" data-pnl="sec-insights">
    <span class="xsec-t">Análises Executivas</span>
    <span class="xsec-s">calculado a partir dos dados reais do recorte</span>
    <span class="xsec-line"></span>
</div>
<div class="exi-grid" data-pnl="insights">
    @{
        var _topMkt = _byMarket.Take(2).Select(m => m.Name).ToList();
        var _mktTxt = _topMkt.Count > 0 ? string.Join(" & ", _topMkt) : "—";
        var _topSeg = _bySegment.Count > 0 ? _bySegment[0] : null;
    }
    <div class="exi">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("trend")</span><span class="exi-label">Previsão vs Meta</span></div>
        <div class="exi-value @(_fcAtt >= 100 ? "pos" : "")">@Fmt.Pct(_fcAtt)</div>
        <div class="exi-text">Previsão de @Money(_fcYear) frente à meta de @MoneyBrl(_metaYear). @_mktTxt lideram a contribuição da previsão.</div>
    </div>
    <div class="exi warn">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("target")</span><span class="exi-label">Distância da Meta</span></div>
        <div class="exi-value warn">@MoneyBrl(_gapTgt)</div>
        <div class="exi-text">Distância da meta anual. Priorizar a conversão das maiores oportunidades do funil (@_openCount abertas).</div>
    </div>
    <div class="exi @(_gmAvg >= 30 ? "pos" : "warn")">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("executive")</span><span class="exi-label">Margem Bruta</span></div>
        <div class="exi-value @(_gmAvg >= 30 ? "pos" : "warn")">@Fmt.Pct(_gmAvg)</div>
        <div class="exi-text">Margem bruta média do recorte (@(_gmPp >= 0 ? "+" : "")@_gmPp.ToString("0.0", _pt) pp vs meta de 30%), sustentada pelo mix de produtos.</div>
    </div>
</div>

@* ---- Top 10 oportunidades mais quentes (linha completa) ---- *@
<div class="section-head" data-pnl="sec-top10">
    <span class="st-title">Oportunidades mais quentes</span>
    <span class="st-sub">indicadas na previsão + marcadas como TOP 10 · @_top10Opps.Count oport. · @MoneyBrl(_top10Opps.Sum(o => o.AmountBrl))</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">Ver todas</a>
</div>
<div class="c12" data-pnl="top10">
    <OpportunityTable Rows="_top10Opps" CssClass="tbl-compact" Style="max-height:340px;overflow:auto"
                      EmptyText="Nenhuma oportunidade indicada na previsão ou marcada como TOP 10 no recorte." OnChanged="ReloadOpps"
                      ShowColumnPicker="false" />
</div>

@* ===================== 4 · COMPOSIÇÃO E PERFORMANCE ===================== *@
<div class="section-head" data-pnl="sec-composicao"><span class="st-title">Composição e desempenho</span><span class="st-line"></span></div>
<div class="g12">
    <div class="c12" data-pnl="composicao">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Composição da previsão <span class="hint">por % de ganho</span></div><TelaCheia /></div>
            <div class="comp-bar">
                @foreach (var c in _comp.Where(x => x.Value > 0))
                {
                    <div class="comp-seg" style="width:@Share(c.Value, _compTotal)%;background:@c.Color" title="@c.Band · @Money(c.Value)">@(c.Share >= 16 ? c.Band : "")</div>
                }
            </div>
            <div class="comp-list">
                @foreach (var c in _comp)
                {
                    <div class="comp-row">
                        <span class="comp-dot" style="background:@c.Color"></span>
                        <span><span class="comp-name">@c.Band</span> <span class="comp-sub">· @c.Count op.</span></span>
                        <span class="comp-share">@Fmt.Pct(c.Share)</span>
                        <span class="comp-num">@Money(c.Value)</span>
                        <span class="delta @(c.Trend >= 0 ? "up" : "down")" style="font-size:11px">@Fmt.Signed(c.Trend)</span>
                    </div>
                }
            </div>
            <div class="comp-summary">
                <div class="cs"><div class="cs-l">Pipeline elegível</div><div class="cs-v">@Money(_eligiblePipeline)</div></div>
                <div class="cs"><div class="cs-l">Meta restante</div><div class="cs-v">@Money(_remainingTarget)</div></div>
                <div class="cs"><div class="cs-l">Índice de cobertura</div><div class="cs-v">@_coverageLabel</div></div>
            </div>
        </div>
    </div>
</div>

@* ---- Distribuição da carteira: país · GM ---- *@
<div class="section-head" data-pnl="sec-carteira"><span class="st-title">Distribuição da carteira</span><span class="st-sub">@MetricLabel · @_year · @_currency</span><span class="st-line"></span></div>
<div class="g12 top">
    <div class="c12" data-pnl="mapa">
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">Por país <span class="hint">clique num país p/ filtrar a página · duplo clique no oceano p/ limpar · roda p/ zoom · arraste p/ mover</span></div>
                <div class="map-zoom">
                    <button class="icon-btn" title="Diminuir" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapId, 1/1.3)'>@Icons.Svg("down")</button>
                    <button class="icon-btn" title="Aumentar" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapId, 1.3)'>@Icons.Svg("up")</button>
                    <button class="icon-btn" title="Redefinir" @onclick='() => JS.InvokeVoidAsync("worldMap.reset", MapId)'>@Icons.Svg("target")</button>
                </div>
                <TelaCheia />
            </div>
            @if (_byCountry.Count > 0)
            {
                <div class="worldmap" id="@MapId">
                    <div class="worldmap-inner">@RenderWorldMap()</div>
                </div>
                <div class="map-legend cols">
                    @foreach (var c in _byCountry.OrderByDescending(x => x.Value))
                    {
                        <div class="ml-row @XfCss("country", c.Label)" @onclick='() => CrossFilter("country", c.Label)' title="Filtrar por @c.Label"><span class="ml-dot"></span><span class="ml-name">@c.Label</span><span class="ml-val">@Money(c.Value)</span><span class="ml-pct">@Fmt.Pct(c.Value / _countryTotal * 100)</span></div>
                    }
                </div>
            }
            else { <div class="empty">Sem dados no recorte.</div> }
        </div>
    </div>
</div>
<div class="g12" style="margin-top:14px">
    <div class="c12" data-pnl="gm-mensal">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">GM médio mensal <span class="hint">margem bruta média das oportunidades por mês · meta 30%</span></div><TelaCheia /></div>
            <div class="chart-body" style="min-height:200px">@RenderGmColumns()</div>
        </div>
    </div>
</div>

@* ===================== 4c · ESTÚDIO DE GRÁFICOS (Power BI) ===================== *@
<div class="c12" data-pnl="estudio">
    <ChartStudio Data="_filtered" Currency="_currency" Rate="Rate" Sym="_sym" />
</div>

@* ===================== 4b · OPORTUNIDADES ===================== *@
<div class="section-head" data-pnl="sec-oportunidades">
    <span class="st-title">Oportunidades</span>
    <span class="st-sub">@_filtered.Count no recorte · @MoneyBrl(_filtered.Sum(o => o.AmountBrl)) em valor</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">Abrir listagem completa</a>
</div>
<div class="c12" data-pnl="tabela-oportunidades">
    <OpportunityTable Rows="_filteredSorted" CssClass="tbl-compact" Style="max-height:780px;overflow:auto" OnChanged="ReloadOpps" />
</div>

@* ===================== 5 · EXECUTIVE ATTENTION ===================== *@
<div class="section-head" data-pnl="sec-atencao"><span class="st-title">@Icons.Svg("alert", "nav-ico") Atenção executiva</span><span class="st-sub">sinais que exigem decisão da liderança</span><span class="st-line"></span></div>
<div class="attn2" data-pnl="atencao">
    @foreach (var a in _attn)
    {
        <div class="attn-card sev-@a.Sev">
            <div class="attn-top">
                <span class="attn-cat sev-@a.Sev">@Icons.Svg(a.Icon)@a.Category</span>
                <details class="ctx">
                    <summary title="Mais ações">@Icons.Svg("more")</summary>
                    <div class="ctx-menu">
                        @if (!string.IsNullOrEmpty(a.OppId)) { <a href="@($"/oportunidades/{a.OppId}")">Ver oportunidade</a> }
                        <a href="/oportunidades">Abrir oportunidades</a>
                    </div>
                </details>
            </div>
            <span class="attn-name">@a.Title</span>
            <span class="attn-meta">@a.Meta</span>
            @if (!string.IsNullOrEmpty(a.Value)) { <span class="attn-val">@a.Value</span> }
            <span class="attn-reason">@a.Reason</span>
            <div class="attn-actions">
                @if (!string.IsNullOrEmpty(a.OppId))
                {
                    <a class="btn-ghost" href="@($"/oportunidades/{a.OppId}")">Ver oportunidade</a>
                }
                else
                {
                    <a class="btn-ghost" href="/oportunidades">Ver oportunidades</a>
                }
            </div>
        </div>
    }
</div>
</div>

@code {
    // ---- estado / filtros ----
    private List<Opportunity> _opps = new();
    private List<Opportunity> _filtered = new();
    private List<Opportunity> _filteredSorted => _filtered.OrderByDescending(o => o.AmountBrl).ToList();
    private DateTime _today = DateTime.Today;
    private DateTime _updated = DateTime.Now;
    private int _year, _month, _quarter;
    // Filtros por NOME resolvido (mesmo rótulo mostrado nos gráficos), para que o
    // clique num elemento (cross-filter estilo Power BI) case com o agrupamento.
    private string _commercial = "", _stage = "", _segment = "", _submarket = "";
    // Filtros da barra: TODOS multi-seleção (vazio = todos).
    private static HashSet<string> NewSet() => new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _kams = NewSet();        // KAM (vendedor)
    private HashSet<string> _markets = NewSet();
    private HashSet<string> _setores = NewSet();     // "New Business" · "Aftermarket"
    private HashSet<string> _countries = NewSet();
    private HashSet<string> _products = NewSet();
    private HashSet<string> _customers = NewSet();
    private HashSet<string> _bus = NewSet();
    private HashSet<string> _years = NewSet();       // anos como texto ("2026")
    private HashSet<string> _months = NewSet();      // meses por nome ("Janeiro")
    private IEnumerable<HashSet<string>> AllSets =>
        new[] { _kams, _markets, _setores, _countries, _products, _customers, _bus, _years, _months };
