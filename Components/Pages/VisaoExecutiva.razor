    <div class="c7">
        <div class="panel" style="height:100%">
            <div class="panel-head">
                <div class="panel-title">Previsão mensal <span class="hint">realizado + @MetricLabel por mês · @_currency</span></div>
                <div class="total-box">
                    <span class="tb-l">Valor total</span>
                    <span class="tb-v">@Money(Enumerable.Range(0, 12).Sum(m => _mReal[m] + _mForecast[m]))</span>
                </div>
            </div>
            <div class="chart-body">@RenderMonthlyLine()</div>
        </div>
    </div>
</div>

@* ---- Distribuição da carteira: unidade · trimestre · país · GM ---- *@
<div class="section-head"><span class="st-title">Distribuição da carteira</span><span class="st-sub">@MetricLabel · @_year · @_currency</span><span class="st-line"></span></div>
<div class="g12 top">
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Por unidade <span class="hint">BU do PV</span></div></div>
            @if (_byBu.Count > 0) { <div class="chart-body donut">@RenderDonut(_byBu)</div> } else { <div class="empty">Sem dados no recorte.</div> }
        </div>
    </div>
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Valor por trimestre <span class="hint">1º a 4º tri</span></div></div>
            @{ var qData = Enumerable.Range(0, 4).Select(q => new SliceRow($"{q + 1}º tri", _byQuarter[q])).Where(x => x.Value > 0).ToList(); }
            @if (qData.Count > 0) { <div class="chart-body donut">@RenderDonut(qData)</div> } else { <div class="empty">Sem dados no recorte.</div> }
        </div>
    </div>
</div>
<div class="g12" style="margin-top:14px">
    <div class="c12">
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">Por país <span class="hint">mapa-múndi · role o mouse · roda p/ zoom · arraste p/ mover</span></div>
                <div class="map-zoom">
                    <button class="icon-btn" title="Diminuir" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapId, 1/1.3)'>@Icons.Svg("down")</button>
                    <button class="icon-btn" title="Aumentar" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapId, 1.3)'>@Icons.Svg("up")</button>
                    <button class="icon-btn" title="Redefinir" @onclick='() => JS.InvokeVoidAsync("worldMap.reset", MapId)'>@Icons.Svg("target")</button>
                </div>
