    <div class="c12" data-pnl="gm-mensal">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">@T("GM médio mensal", "Monthly average GM") <span class="hint">@T("margem bruta média das oportunidades por mês · meta 30%", "average gross margin of the opportunities per month · 30% target")</span></div><TelaCheia Ingles="_en" /></div>
            <div class="chart-body" style="min-height:200px">@RenderGmColumns()</div>
        </div>
    </div>
</div>

@* ===================== 4c · ESTÚDIO DE GRÁFICOS (Power BI) ===================== *@
<div class="c12" data-pnl="estudio">
