           .Select(g => new SliceRow(g.Key, g.Sum(o => o.AmountBrl)))
           .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();

    private static bool Eq(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    // Campo marcado como "Sim" (ex.: TOP 10 preenchido pelo KAM).
    private static bool Sim(string? s) => string.Equals((s ?? "").Trim(), "Sim", StringComparison.OrdinalIgnoreCase);

    // Cross-filter: alterna o filtro da dimensão (clicar de novo no mesmo valor limpa).
    private void CrossFilter(string dim, string? val)
    {
        var v = (val ?? "").Trim();
        if (v == "" || v == "—") return;
        string Tog(string cur) => Eq(cur, v) ? "" : v;
        // Nos filtros multi-seleção, o clique alterna o valor dentro do conjunto.
        static void TogSet(HashSet<string> set, string val) { if (!set.Remove(val)) set.Add(val); }
        switch (dim)
        {
            case "market":     TogSet(_markets, v); break;
            case "country":    TogSet(_countries, v); break;
            case "product":    TogSet(_products, v); break;
            case "customer":   TogSet(_customers, v); break;
            case "bu":         TogSet(_bus, v); break;
            case "commercial": _commercial = Tog(_commercial); break;
            case "stage":      _stage = Tog(_stage); break;
            case "segment":    _segment = Tog(_segment); break;
            case "submarket":  _submarket = Tog(_submarket); break;
            case "month":      if (int.TryParse(v, out var mm) && mm is >= 1 and <= 12) TogSet(_months, Fmt.MonthLong(mm)); break;
            case "kam":        TogSet(_kams, v); break;
        }
    }

    // Marca visualmente o elemento ativo no cross-filter.
    private bool IsActive(string dim, string val) => dim switch
    {
        "market" => _markets.Contains(val),
        "country" => _countries.Contains(val),
        "product" => _products.Contains(val),
        "customer" => _customers.Contains(val),
        "bu" => _bus.Contains(val),
        "commercial" => Eq(_commercial, val),
        "stage" => Eq(_stage, val),
        "segment" => Eq(_segment, val),
        "submarket" => Eq(_submarket, val),
        "month" => int.TryParse(val, out var mm) && mm is >= 1 and <= 12 && _months.Contains(Fmt.MonthLong(mm)),
        "kam" => _kams.Contains(val),
        _ => false,
    };
    // Classe utilitária p/ marcar o elemento clicável e o estado ativo.
    private string XfCss(string dim, string val) => "xf" + (IsActive(dim, val) ? " xf-on" : "");

    // Há algum filtro ativo nessa dimensão? (para desaturar os não-selecionados)
    private bool DimActive(string dim) => dim switch
    {
        "market" => _markets.Count > 0,
        "product" => _products.Count > 0,
        "kam" => _kams.Count > 0,
        "segment" => _segment != "",
        "bu" => _bus.Count > 0,
        "submarket" => _submarket != "",
        "stage" => _stage != "",
        _ => false,
    };

    // Tonalidade da barra do funil: teal escuro no topo → teal médio na base
    // (variação MUITO sutil, sempre dentro da identidade — não é cor por stage).
    private static int Lerp(int a, int b, double t) => (int)Math.Round(a + (b - a) * t);
    // Ordem canônica das etapas do pipeline (sequência do funil, não por valor).
    private static readonly string[] StageOrder =
    {
        "Qualification", "Arrived at Agreement on Need", "Proposal Pending/Waiting",
        "Outstanding Quote--No Formal Negotiation", "Negotiation Phase/Review",
        "Verbal Commitment", "Letter of Intent", "T&C's stage", "E1 Order Entry",
    };
    private static int StageRank(string s)
    {
        var t = (s ?? "").Trim();
        for (var i = 0; i < StageOrder.Length; i++)
            if (string.Equals(StageOrder[i], t, StringComparison.OrdinalIgnoreCase)) return i;
        return 999;
    }

    private static int Darker(int c) => (int)Math.Round(c * 0.84);

    // Gradiente do funil por POSIÇÃO: topo azul-royal → base azul-marinho profundo.
    // Look coeso e premium (fluxo contínuo); o valor de cada etapa fica no rótulo.
    private static string FunnelBar(int i, int n)
    {
        double t = n <= 1 ? 0 : (double)i / (n - 1);
        // #2f74e0 (royal) → #071d40 (marinho profundo).
        int r = Lerp(0x2f, 0x07, t), g = Lerp(0x74, 0x1d, t), b = Lerp(0xe0, 0x40, t);
        var top = $"#{r:x2}{g:x2}{b:x2}";
        var bot = $"#{Darker(r):x2}{Darker(g):x2}{Darker(b):x2}";
        return $"linear-gradient(180deg,{top} 0%,{bot} 100%)";
    }

    // Paleta escura o bastante para texto branco em todas as faixas.
    private static bool FunnelDark(int i, int n) => false;

    // Largura da faixa do funil por POSIÇÃO (não pelo valor): estreita de forma
    // uniforme do topo à base, sempre afunilando — geometria limpa e simétrica.
    // O valor de cada etapa é lido no rótulo, não na largura.
    private static double FnW(int i, int n) => n <= 1 ? 90 : 96 - (96 - 46) * i / (double)(n - 1);

    // Largura da faixa do funil (% do maior valor), com mínimo p/ legibilidade.
    private string FunnelWidth(double v) =>
        Math.Max(_funnelMax > 0 ? v / _funnelMax * 100 : 0, 14).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    // Gradiente do funil: tons da marca, do mais forte (topo) ao mais claro.
    private static readonly string[] FunnelColors =
        { "#0b4f6f", "#0a6285", "#007A9E", "#1092b0", "#2aa5c0", "#5bb0c9", "#86c4d8", "#aed7e5" };
    private static string FunnelColor(int i) => FunnelColors[Math.Min(i, FunnelColors.Length - 1)];

