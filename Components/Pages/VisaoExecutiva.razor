@page "/executivo"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject ControleRepository ControleRepo
@inject NavigationManager Nav
@inject IJSRuntime JS

@{ Build(); }

@* ===================== 1 · CABEÇALHO EXECUTIVO ===================== *@
<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span>Previsão de Vendas</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Visão Executiva</span></div>

<div class="page-head">
    <div>
        <h1>Previsão de Vendas</h1>
        <p class="subtitle">
            @Fmt.MonthLong(_month) de @_year · @(_quarter)º trimestre · Howden Brasil · @_currency<br />
            Última consolidação @_updated.ToString("dd/MM/yyyy 'às' HH:mm")
            &nbsp;·&nbsp; <span class="badge @DqCss">Qualidade dos dados @_dq%</span>
            &nbsp; <span class="badge @ConfCss">Confiança da previsão @_confidence%</span>
        </p>
    </div>
    <div class="page-actions">
        <div class="segmented" style="margin-right:2px">
            <button class="@(_currency == "USD" ? "active" : "")" @onclick='() => _currency = "USD"'>USD</button>
            <button class="@(_currency == "BRL" ? "active" : "")" @onclick='() => _currency = "BRL"'>BRL</button>
        </div>
        <a class="btn-ghost" href="/forecast/export" target="_blank" title="Exportar CSV">@Icons.Svg("download")Exportar</a>
        <a class="btn-primary" href="/oportunidades">@Icons.Svg("opportunity")Abrir Oportunidades</a>
    </div>
</div>

@* ---- Filtros globais ---- *@
<div class="filterbar filterbar-sticky">
    <div class="flt"><span class="flt-label">Ano</span><select><option>@_year</option></select></div>
    <div class="flt"><span class="flt-label">Mês</span><select @bind="_monthFilter"><option value="0">Todos</option>@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select></div>
    <div class="flt"><span class="flt-label">De</span><input class="flt-date" type="date" @bind="_dateFrom" /></div>
    <div class="flt"><span class="flt-label">Até</span><input class="flt-date" type="date" @bind="_dateTo" /></div>
    <div class="flt"><span class="flt-label">Mercado</span><select @bind="_market"><option value="">Todos</option>@foreach (var id in MarketOptions){<option value="@id">@Cat.MarketName(id)</option>}</select></div>
    <div class="flt flt-multi">
        <span class="flt-label">KAM</span>
        <button type="button" class="flt-multi-btn" @onclick="() => _kamOpen = !_kamOpen">
            @(_kams.Count == 0 ? "Todos" : _kams.Count + " selec.")<span class="flt-caret">▾</span>
        </button>
        @if (_kamOpen)
        {
            <div class="flt-multi-panel">
                <div class="flt-multi-head">
                    <span>@(_kams.Count) selecionado(s)</span>
                    @if (_kams.Count > 0) { <button class="btn-link" @onclick="() => _kams.Clear()">Limpar</button> }
                    <button class="btn-link" @onclick="() => _kamOpen = false">Fechar</button>
                </div>
                @foreach (var id in KamOptions)
                {
                    var kid = id;
                    <label class="flt-check"><input type="checkbox" checked="@_kams.Contains(kid)" @onchange="() => ToggleKam(kid)" /> <span>@Cat.KamName(kid)</span></label>
                }
                @if (!KamOptions.Any()) { <div class="flt-multi-empty">Nenhum KAM nos dados.</div> }
            </div>
        }
    </div>
    <div class="flt"><span class="flt-label">Categoria</span><select @bind="_catFilter"><option value="">Todas</option>@foreach (var c in Enum.GetValues<ForecastCategory>()){<option value="@c.ToString()">@ForecastCategories.Label(c)</option>}</select></div>
    @if (_showMore)
    {
        <div class="flt"><span class="flt-label">País</span><select @bind="_country"><option value="">Todos</option>@foreach (var id in CountryOptions){<option value="@id">@Cat.CountryName(id)</option>}</select></div>
        <div class="flt"><span class="flt-label">Produto</span><select @bind="_product"><option value="">Todos</option>@foreach (var id in ProductOptions){<option value="@id">@Cat.ProductName(id)</option>}</select></div>
        <div class="flt"><span class="flt-label">Cliente</span><select @bind="_customer"><option value="">Todos</option>@foreach (var id in CustomerOptions){<option value="@id">@Cat.CustomerName(id)</option>}</select></div>
        <div class="flt"><span class="flt-label">Unidade de negócio</span><select @bind="_bu"><option value="">Todas</option>@foreach (var id in BuOptions){<option value="@id">@Cat.BuCode(id)</option>}</select></div>
        <div class="flt"><span class="flt-label">Filtrar por</span><select @bind="_valMetric"><option value="total">Valor total</option><option value="conv">Chance de conversão</option></select></div>
        <div class="flt"><span class="flt-label">Mínimo R$</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="0" @bind="_valMin" /></div>
        <div class="flt"><span class="flt-label">Máximo R$</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="—" @bind="_valMax" /></div>
    }
    <button class="btn-link" @onclick="() => _showMore = !_showMore">@(_showMore ? "Menos filtros" : "Mais filtros")</button>
    <div class="filterbar-spacer"></div>
    @if (_activeFilters > 0)
    {
        <span class="tag">@_activeFilters ativo(s)</span>
        <button class="btn-link" @onclick="ClearFilters">Limpar</button>
    }
    <button class="btn-link" @onclick="SaveView">Salvar visualização</button>
    @if (_savedMsg) { <span class="saved-flag">@Icons.Svg("check")Salvo</span> }
</div>

@* ===================== 2 · HERO EXECUTIVO ===================== *@
<div class="hero">
    <div class="hero-main">
        <div class="hero-eyebrow">Realizado × Meta · REPORT HSA · @(_monthFilter is >= 1 and <= 12 ? Fmt.MonthLong(_monthFilter) + " " + _repYear : "Ano " + _repYear)</div>
        <div class="hero-value"><span class="cur">@_sym</span>@Fmt.Compact(CvBrl(_heroReal))</div>
        <div class="hero-target-line">
            Meta NB+AFM @MoneyBrl(_heroMeta) · @Fmt.Pct(_heroAttain) da meta · gap @MoneyBrl(Math.Max(_heroMeta - _heroReal, 0))<br />
            Meta Vendas HSA @MoneyBrl(_heroMetaHsa) · @Fmt.Pct(_heroAttainHsa) da meta · gap @MoneyBrl(Math.Max(_heroMetaHsa - _heroReal, 0))
        </div>
        <div class="hero-chips">
            <div class="hero-chip"><div class="k">Meta NB+AFM</div><div class="v">@MoneyBrl(_heroMeta)</div></div>
            <div class="hero-chip"><div class="k">Meta Vendas HSA</div><div class="v">@MoneyBrl(_heroMetaHsa)</div></div>
            <div class="hero-chip"><div class="k">Realizado</div><div class="v">@MoneyBrl(_heroReal)</div></div>
        </div>
        <div class="hero-gauge">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttain)%"></div></div>
            <div class="gl"><span>Atingimento · Meta NB+AFM</span><span>@Fmt.Pct(_heroAttain)</span></div>
        </div>
        <div class="hero-gauge" style="margin-top:8px">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttainHsa)%"></div></div>
            <div class="gl"><span>Atingimento · Meta Vendas HSA</span><span>@Fmt.Pct(_heroAttainHsa)</span></div>
        </div>
    </div>
</div>

@* ---- Vendas x Meta (NB+AFM) · fonte: Controle · REPORT HSA ---- *@
<div class="panel" style="margin-top:16px">
    <div class="panel-head">
        <div class="panel-title">Vendas x Meta · NB+AFM
            <span class="hint">realizado x budget mensal · fonte: Controle · REPORT HSA · R$ · @_repYear</span>
        </div>
        <div class="rep-attain-group">
            <div class="rep-attain-box">
                <span class="ra-label">Atend. Meta NB+AFM (ano)</span>
                <span class="ra-value" style="color:@AtColor(_repAttain)">@Fmt.Pct(_repAttain)</span>
            </div>
            <div class="rep-attain-box">
                <span class="ra-label">Atend. Meta Vendas HSA (ano)</span>
                <span class="ra-value" style="color:@AtColor(_repAttainHsa)">@Fmt.Pct(_repAttainHsa)</span>
            </div>
        </div>
    </div>
    @if (_repReal.Any(v => v > 0) || _repMeta.Any(v => v > 0) || _repMetaHsa.Any(v => v > 0))
    {
        <div class="chart-body">@RenderReportLine()</div>
    }
    else
    {
        <div class="empty">Sem dados no Controle (REPORT HSA) para @_repYear. Preencha os valores na guia <a href="/controle">Controle</a>.</div>
    }
</div>

@* ---- Top 10 oportunidades mais quentes (linha completa) ---- *@
<div class="section-head">
    <span class="st-title">Top 10 oportunidades mais quentes</span>
    <span class="st-sub">confiança + peso do valor · acima de R$ 1 mi</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">Ver todas</a>
</div>
<OpportunityTable Rows="_top10Opps" CssClass="tbl-compact" Style="max-height:340px;overflow:auto"
                  EmptyText="Sem oportunidades acima de R$ 1 mi no recorte." OnChanged="ReloadOpps" />

@* ===================== KPIs SECUNDÁRIOS (2 níveis) ===================== *@
<div class="section-head"><span class="st-title">Indicadores estratégicos</span><span class="st-line"></span></div>
<div class="exec-grid cols-2">
    <StatCard Label="Previsão do trimestre" Value="@Money(_fcQuarter)" Delta="@_fcQuarterDelta" Context="@($"Meta {Money(_tgtQuarter)}")" AccentLeft="true">
        <div class="spark"><Sparkline Values="@_evoQuarter" Stroke="#007A9E" /></div>
    </StatCard>
    <StatCard Label="Previsão anual" Value="@Money(_fcYear)" Delta="@_fcYearDelta" Context="@($"Meta {Money(_tgtYear)}")" AccentLeft="true">
        <div class="spark"><Sparkline Values="@_evoYear" Stroke="#009496" /></div>
    </StatCard>
</div>

@* ===================== 3 · INSIGHTS EXECUTIVOS ===================== *@
<div class="section-head">
    <span class="st-title">@Icons.Svg("trend", "nav-ico") Insights executivos</span>
    <span class="st-sub">principais sinais</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">Ver todas</a>
</div>
<div class="panel">
    <div class="insights insights-grid">
        @foreach (var i in _insights.Take(6))
        {
            <div class="insight sev-@i.Sev">
                <div class="insight-head"><span class="insight-cat">@i.Category</span><span class="insight-val" style="color:@SevColor(i.Sev)">@i.Value</span></div>
                <div class="insight-title">@i.Title</div>
                <div class="insight-detail">@i.Detail</div>
                <div class="insight-foot">
                    <span class="insight-action">@Icons.Svg("arrow-right")@i.Action</span>
                    <a class="insight-link" href="@i.Link">Detalhes</a>
                </div>
            </div>
        }
    </div>
</div>

@* ===================== 4 · COMPOSIÇÃO E PERFORMANCE ===================== *@
<div class="section-head"><span class="st-title">Composição e desempenho</span><span class="st-line"></span></div>
<div class="g12">
    <div class="c5">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Composição da previsão <span class="hint">por confiança · (% ganho + % período) ÷ 2</span></div></div>
            <div class="comp-bar">
                @foreach (var c in _comp.Where(x => x.Value > 0))
                {
                    <div class="comp-seg" style="width:@Share(c.Value, _compTotal)%;background:@c.Color" title="@c.Band · @Money(c.Value)">@(c.Share >= 16 ? c.Band : "")</div>
                }
            </div>
            <div class="comp-list">
                @foreach (var c in _comp)
                {
                    <div class="comp-row">
                        <span class="comp-dot" style="background:@c.Color"></span>
                        <span><span class="comp-name">@c.Band</span> <span class="comp-sub">· @c.Count op.</span></span>
                        <span class="comp-share">@Fmt.Pct(c.Share)</span>
                        <span class="comp-num">@Money(c.Value)</span>
                        <span class="delta @(c.Trend >= 0 ? "up" : "down")" style="font-size:11px">@Fmt.Signed(c.Trend)</span>
                    </div>
                }
            </div>
            <div class="comp-summary">
                <div class="cs"><div class="cs-l">Pipeline elegível</div><div class="cs-v">@Money(_eligiblePipeline)</div></div>
                <div class="cs"><div class="cs-l">Meta restante</div><div class="cs-v">@Money(_remainingTarget)</div></div>
                <div class="cs"><div class="cs-l">Índice de cobertura</div><div class="cs-v">@_coverageLabel</div></div>
            </div>
        </div>
    </div>
    <div class="c7">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão x Meta por KAM</div><a class="btn-link" href="/oportunidades">Ver oportunidades</a></div>
            <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
                <table class="grid-tbl">
                    <thead><tr><th>KAM</th><th class="right">Previsão</th><th class="right">Meta</th><th class="right">Gap</th><th class="right">Cobertura</th><th class="center">Status</th></tr></thead>
                    <tbody>
                        @foreach (var k in _byKam)
                        {
                            <tr class="clickable" @onclick='() => Nav.NavigateTo("/oportunidades")'>
                                <td class="col-strong">@k.Name</td>
                                <td class="right num">@Money(k.Forecast)</td>
                                <td class="right num">@Money(k.Target)</td>
                                <td class="right num" style="color:@(k.Gap > 0 ? "var(--neg)" : "var(--pos)")">@Money(k.Gap)</td>
                                <td class="right num">@k.Coverage.ToString("0.0", _pt)x</td>
                                <td class="center"><span class="badge @k.StatusCss">@k.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="g12" style="margin-top:14px">
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão por mercado <span class="hint">participação · tendência</span></div></div>
            @foreach (var m in _byMarket)
            {
                <div class="bar-row">
                    <span class="bar-label">@m.Name
                        @if (m.Name == _marketTopRise) { <span class="tag" style="background:var(--pos-bg);color:var(--pos);margin-left:4px">▲ maior alta</span> }
                        else if (m.Name == _marketTopFall) { <span class="tag neg" style="margin-left:4px">▼ maior queda</span> }
                    </span>
                    <span class="bar-track"><span class="bar-fill c-primary" style="width:@Share(m.Value, _maxMarket)%"></span></span>
                    <span class="bar-value">@Money(m.Value) <span class="muted" style="font-weight:400">· @Fmt.Pct(m.Value / _marketTotal * 100)</span> <span class="delta @(m.Trend >= 0 ? "up" : "down")" style="font-size:10.5px">@Fmt.Signed(m.Trend)</span></span>
                </div>
            }
        </div>
    </div>
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão por produto <span class="hint">participação · margem · tendência</span></div></div>
            @foreach (var p in _byProduct)
            {
                <div class="bar-row">
                    <span class="bar-label">@p.Name</span>
                    <span class="bar-track"><span class="bar-fill" style="width:@Share(p.Value, _maxProduct)%"></span></span>
                    <span class="bar-value">@Money(p.Value) <span class="muted" style="font-weight:400">· @Fmt.Pct(p.Value / _productTotal * 100) · GM @Fmt.Pct(p.Margin)</span> <span class="delta @(p.Trend >= 0 ? "up" : "down")" style="font-size:10.5px">@Fmt.Signed(p.Trend)</span></span>
                </div>
            }
        </div>
    </div>
</div>

@* ---- Comparativo AFM × NB + Previsão mensal ---- *@
<div class="g12" style="margin-top:14px">
    <div class="c5">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Aftermarket × New Business <span class="hint">por categoria comercial</span></div></div>
            @foreach (var cc in _byCommercial)
            {
                var destaque = cc.Code is "AFM" or "NB" ? "strong" : "";
                <div class="bar-row">
                    <span class="bar-label @destaque">@cc.Name <span class="muted" style="font-weight:400">· @cc.Code</span></span>
                    <span class="bar-track"><span class="bar-fill @(cc.Code == "AFM" ? "afm" : "c-primary")" style="width:@Share(cc.Value, _maxComm)%"></span></span>
                    <span class="bar-value">@Money(cc.Value)</span>
                </div>
            }
            <div class="muted" style="font-size:11px;margin-top:8px">Comparativo do forecast ponderado por categoria comercial (NB · RT · AFM · SV).</div>
        </div>
    </div>
    <div class="c7">
        <div class="panel" style="height:100%">
            <div class="panel-head">
                <div class="panel-title">Previsão mensal <span class="hint">realizado + @MetricLabel por mês · @_currency</span></div>
                <div class="total-box">
                    <span class="tb-l">Valor total</span>
                    <span class="tb-v">@Money(Enumerable.Range(0, 12).Sum(m => _mReal[m] + _mForecast[m]))</span>
                </div>
            </div>
            <div class="chart-body">@RenderMonthlyLine()</div>
        </div>
    </div>
</div>

@* ---- Distribuição da carteira: unidade · trimestre · país · GM ---- *@
<div class="section-head"><span class="st-title">Distribuição da carteira</span><span class="st-sub">@MetricLabel · @_year · @_currency</span><span class="st-line"></span></div>
<div class="g12 top">
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Por unidade <span class="hint">BU do PV</span></div></div>
            @if (_byBu.Count > 0) { <div class="chart-body donut">@RenderDonut(_byBu)</div> } else { <div class="empty">Sem dados no recorte.</div> }
        </div>
    </div>
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Valor por trimestre <span class="hint">1º a 4º tri</span></div></div>
            @{ var qData = Enumerable.Range(0, 4).Select(q => new SliceRow($"{q + 1}º tri", _byQuarter[q])).Where(x => x.Value > 0).ToList(); }
            @if (qData.Count > 0) { <div class="chart-body donut">@RenderDonut(qData)</div> } else { <div class="empty">Sem dados no recorte.</div> }
        </div>
    </div>
</div>
<div class="g12" style="margin-top:14px">
    <div class="c12">
        <div class="panel">
            <div class="panel-head">
                <div class="panel-title">Por país <span class="hint">mapa-múndi · role o mouse · roda p/ zoom · arraste p/ mover</span></div>
                <div class="map-zoom">
                    <button class="icon-btn" title="Diminuir" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapId, 1/1.3)'>@Icons.Svg("down")</button>
                    <button class="icon-btn" title="Aumentar" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapId, 1.3)'>@Icons.Svg("up")</button>
                    <button class="icon-btn" title="Redefinir" @onclick='() => JS.InvokeVoidAsync("worldMap.reset", MapId)'>@Icons.Svg("target")</button>
                </div>
            </div>
            @if (_byCountry.Count > 0)
            {
                <div class="worldmap" id="@MapId">
                    <div class="worldmap-inner">@RenderWorldMap()</div>
                </div>
                <div class="map-legend cols">
                    @foreach (var c in _byCountry.OrderByDescending(x => x.Value))
                    {
                        <div class="ml-row"><span class="ml-dot"></span><span class="ml-name">@c.Label</span><span class="ml-val">@Money(c.Value)</span><span class="ml-pct">@Fmt.Pct(c.Value / _countryTotal * 100)</span></div>
                    }
                </div>
            }
            else { <div class="empty">Sem dados no recorte.</div> }
        </div>
    </div>
</div>
<div class="g12" style="margin-top:14px">
    <div class="c12">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">GM médio mensal <span class="hint">margem bruta média das oportunidades por mês · meta 30%</span></div></div>
            <div class="chart-body" style="min-height:200px">@RenderGmColumns()</div>
        </div>
    </div>
</div>

@* ===================== 4c · ESTÚDIO DE GRÁFICOS (Power BI) ===================== *@
<ChartStudio Data="_filtered" Currency="_currency" Rate="Rate" Sym="_sym" />

@* ===================== 4b · OPORTUNIDADES ===================== *@
<div class="section-head">
    <span class="st-title">Oportunidades</span>
    <span class="st-sub">@_filtered.Count no recorte · @Money(_filtered.Sum(o => o.AmountUsd)) em valor</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">Abrir listagem completa</a>
</div>
<OpportunityTable Rows="_filteredSorted" OnChanged="ReloadOpps" />

@* ===================== 5 · EXECUTIVE ATTENTION ===================== *@
<div class="section-head"><span class="st-title">@Icons.Svg("alert", "nav-ico") Atenção executiva</span><span class="st-sub">sinais que exigem decisão da liderança</span><span class="st-line"></span></div>
<div class="attn2">
    @foreach (var a in _attn)
    {
        <div class="attn-card sev-@a.Sev">
            <div class="attn-top">
                <span class="attn-cat sev-@a.Sev">@Icons.Svg(a.Icon)@a.Category</span>
                <details class="ctx">
                    <summary title="Mais ações">@Icons.Svg("more")</summary>
                    <div class="ctx-menu">
                        @if (!string.IsNullOrEmpty(a.OppId)) { <a href="@($"/oportunidades/{a.OppId}")">Ver oportunidade</a> }
                        <a href="/oportunidades">Abrir oportunidades</a>
                    </div>
                </details>
            </div>
            <span class="attn-name">@a.Title</span>
            <span class="attn-meta">@a.Meta</span>
            @if (!string.IsNullOrEmpty(a.Value)) { <span class="attn-val">@a.Value</span> }
            <span class="attn-reason">@a.Reason</span>
            <div class="attn-actions">
                @if (!string.IsNullOrEmpty(a.OppId))
                {
                    <a class="btn-ghost" href="@($"/oportunidades/{a.OppId}")">Ver oportunidade</a>
                }
                else
                {
                    <a class="btn-ghost" href="/oportunidades">Ver oportunidades</a>
                }
            </div>
        </div>
    }
</div>

@code {
    // ---- estado / filtros ----
    private List<Opportunity> _opps = new();
    private List<Opportunity> _filtered = new();
    private List<Opportunity> _filteredSorted => _filtered.OrderByDescending(o => o.AmountBrl).ToList();
    private DateTime _today = DateTime.Today;
    private DateTime _updated = DateTime.Now;
    private int _year, _month, _quarter;
    private string _market = "", _catFilter = "", _country = "", _product = "", _customer = "", _bu = "";
    private HashSet<string> _kams = new();   // KAM é multi-seleção
    private bool _kamOpen;
