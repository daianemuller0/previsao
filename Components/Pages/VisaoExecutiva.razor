                        }
                    </div>
                </div>
            }
        </div></div>
    </div>

    @* ---- Valor por trimestre + Aftermarket × New Business (lado a lado) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c6" data-pnl="trimestre"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">@T("Valor por trimestre", "Value by quarter")</div><div class="xcard-sub">@T("1º a 4º tri", "Q1 to Q4") · @_currency</div></div><TelaCheia Ingles="_en" /></div>
            @{ var qData = Enumerable.Range(0, 4).Select(q => new SliceRow(_en ? $"Q{q + 1}" : $"{q + 1}º tri", _byQuarter[q])).Where(x => x.Value > 0).ToList(); }
            @if (qData.Count > 0) { <div class="chart-body donut">@RenderDonut(qData)</div> } else { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
        </div></div>
        <div class="c6" data-pnl="afm-nb"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Aftermarket × New Business</div><div class="xcard-sub">@T("participação no pipeline · por setor", "share of pipeline · by sector")</div></div><TelaCheia Ingles="_en" /></div>
            @if (_bySetor.Count == 0) { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
            else { <div class="chart-body donut">@RenderDonut(_bySetor)</div> }
            <div class="muted" style="font-size:11px;margin-top:8px">@T("Divisão do pipeline entre Aftermarket e New Business (origem da oferta).", "Pipeline split between Aftermarket and New Business (offer origin).")</div>
        </div></div>
    </div>

    @* ---- Forecast by Month (timing) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c12" data-pnl="previsao-mensal"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("trend")</span><div><div class="xcard-title">@T("Previsão por Mês", "Forecast by Month")</div><div class="xcard-sub">@T("Data de fechamento · clique num mês para filtrar", "Close date · click a month to filter")</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_monthAmt.Sum())</b></span><TelaCheia Ingles="_en" /></div>
            <div class="chart-body">@RenderXfColumns(_monthAmt)</div>
        </div></div>
    </div>
</div>

@* ===================== EXECUTIVE INSIGHTS ===================== *@
<div class="xsec" data-pnl="sec-insights">
    <span class="xsec-t">@T("Análises Executivas", "Executive Insights")</span>
    <span class="xsec-s">@T("calculado a partir dos dados reais do recorte", "calculated from the actual data in the selection")</span>
    <span class="xsec-line"></span>
</div>
<div class="exi-grid" data-pnl="insights">
    @{
        var _topMkt = _byMarket.Take(2).Select(m => m.Name).ToList();
        var _mktTxt = _topMkt.Count > 0 ? string.Join(" & ", _topMkt) : "—";
        var _topSeg = _bySegment.Count > 0 ? _bySegment[0] : null;
    }
    <div class="exi">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("trend")</span><span class="exi-label">@T("Previsão vs Meta", "Forecast vs Target")</span></div>
        <div class="exi-value @(_fcAtt >= 100 ? "pos" : "")">@Fmt.Pct(_fcAtt)</div>
        <div class="exi-text">@if (_en) { <text>Forecast of @Money(_fcYear) against a target of @MoneyBrl(_metaYear). @_mktTxt lead the contribution to the forecast.</text> } else { <text>Previsão de @Money(_fcYear) frente à meta de @MoneyBrl(_metaYear). @_mktTxt lideram a contribuição da previsão.</text> }</div>
    </div>
    <div class="exi warn">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("target")</span><span class="exi-label">@T("Distância da Meta", "Gap to Target")</span></div>
        <div class="exi-value warn">@MoneyBrl(_gapTgt)</div>
        <div class="exi-text">@if (_en) { <text>Gap to the annual target. Prioritize converting the largest opportunities in the funnel (@_openCount open).</text> } else { <text>Distância da meta anual. Priorizar a conversão das maiores oportunidades do funil (@_openCount abertas).</text> }</div>
    </div>
    <div class="exi @(_gmAvg >= 30 ? "pos" : "warn")">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("executive")</span><span class="exi-label">@T("Margem Bruta", "Gross Margin")</span></div>
        <div class="exi-value @(_gmAvg >= 30 ? "pos" : "warn")">@Fmt.Pct(_gmAvg)</div>
        <div class="exi-text">@if (_en) { <text>Average gross margin of the selection (@(_gmPp >= 0 ? "+" : "")@XDec1(_gmPp) pp vs 30% target), supported by the product mix.</text> } else { <text>Margem bruta média do recorte (@(_gmPp >= 0 ? "+" : "")@_gmPp.ToString("0.0", _pt) pp vs meta de 30%), sustentada pelo mix de produtos.</text> }</div>
    </div>
</div>

@* ---- Top 10 oportunidades mais quentes (linha completa) ---- *@
<div class="section-head" data-pnl="sec-top10">
    <span class="st-title">@T("Oportunidades mais quentes", "Hottest opportunities")</span>
    <span class="st-sub">@T("indicadas na previsão + marcadas como TOP 10", "referred to the forecast + marked as TOP 10") · @_top10Opps.Count @T("oport.", "opp.") · @MoneyBrl(_top10Opps.Sum(o => o.AmountBrl))</span>
