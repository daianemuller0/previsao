    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private AccessScope _scope = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _scope = AccessScope.Resolve(user);
            _login = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                     ?? user.Identity?.Name ?? "";
            _chart.Clear();          // o 1º render acontece antes daqui: recarrega já com o login
        }
        _opps = LoadScoped();
        LoadReport();
    }

    // Oportunidades recortadas pela carteira permitida do login (controle de acesso).
    // Exclui as que viraram "venda indicada" (movidas para o Controle).
    private List<Opportunity> LoadScoped() =>
        Repo.All().Where(o => !o.MovidaControleValue).Where(o => _scope.CanSeeVendedor(KeyKam(o))).ToList();

    // Inicializa (idempotente) o mapa interativo depois de renderizar. Passa a
    // referência do componente para o mapa poder disparar o cross-filter ao clicar.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("worldMap.init", MapId, _ref); } catch { }
        try { await JS.InvokeVoidAsync("xfilter.init", "xf-charts", _ref); } catch { }
        foreach (var chave in ChartKeys)
            try { await JS.InvokeVoidAsync("chartOrder.init", "ch-" + chave, _ref, chave); } catch { }
        // A disposição é reaplicada a cada render: o Blazor redesenha os painéis
        // e levaria junto o "order" que o navegador tinha posto neles.
        try { await JS.InvokeVoidAsync("appLayout.ligar", _ref, LayoutSalvo); } catch { }
    }

    public void Dispose() => _ref?.Dispose();

    private void LoadReport()
    {
        var (real, meta, metaHsa) = ControleRepo.ReportSeries(_repYear);
        _repReal = real; _repMeta = meta; _repMetaHsa = metaHsa;
        double tr = real.Sum(), tm = meta.Sum(), tmh = metaHsa.Sum();
        _repAttain = tm > 0 ? tr / tm * 100 : 0;
        _repAttainHsa = tmh > 0 ? tr / tmh * 100 : 0;
    }

    private static string AtColor(double p) => p >= 100 ? "var(--pos)" : p >= 85 ? "#b7791f" : "var(--neg)";

