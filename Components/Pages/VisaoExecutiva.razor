    private List<T> Ord<T>(string chave, List<T> itens, Func<T, string> rótulo) =>
        ChartPrefsRepository.Aplicar(Pref(chave).Ordem, itens, rótulo);

    private RenderFragment ChartToolsFor(string chave) => builder =>
    {
        builder.OpenComponent<ChartTools>(0);
        builder.AddAttribute(1, "Barra", Pref(chave).Barra);
        builder.AddAttribute(2, "OnBarra", EventCallback.Factory.Create<int>(this, px => AjustarBarra(chave, px)));
        builder.AddAttribute(3, "OnReset", EventCallback.Factory.Create(this, () => ResetChart(chave)));
        builder.CloseComponent();
    };

    private void AjustarBarra(string chave, int px)
    {
        var p = Pref(chave);
        ChartPrefs.Save(_login, chave, p.Ordem, px);
        RecarregarChartPrefs();
