    private void LoadReport()
    {
        var (real, meta, metaHsa) = ControleRepo.ReportSeries(_repYear);
        _repReal = real; _repMeta = meta; _repMetaHsa = metaHsa;
        double tr = real.Sum(), tm = meta.Sum(), tmh = metaHsa.Sum();
        _repAttain = tm > 0 ? tr / tm * 100 : 0;
        _repAttainHsa = tmh > 0 ? tr / tmh * 100 : 0;
    }

    private static string AtColor(double p) => p >= 100 ? "var(--pos)" : p >= 85 ? "#b7791f" : "var(--neg)";

    // Recarrega as oportunidades após editar/duplicar/excluir na tabela.
    // Build() é chamado no topo do render e recomputa Top 10 e listagem.
    private void ReloadOpps() => _opps = Repo.All();

    // Opções dos filtros vindas dos DADOS reais (não do catálogo demo): valores
    // distintos presentes nas oportunidades, exibidos pelo nome do catálogo
    // (com fallback ao texto cru para dados importados).
    private IEnumerable<string> DistinctField(Func<Opportunity, string> sel, Func<string, string> name) =>
        _opps.Select(sel).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(name, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<string> KamOptions => DistinctField(o => o.KamId, Cat.KamName);
    private IEnumerable<string> MarketOptions => DistinctField(o => o.MarketId, Cat.MarketName);
    private IEnumerable<string> CountryOptions => DistinctField(o => o.CountryId, Cat.CountryName);
    private IEnumerable<string> ProductOptions => DistinctField(o => o.ProductId, Cat.ProductName);
    private IEnumerable<string> CustomerOptions => DistinctField(o => o.CustomerId, Cat.CustomerName);
    private IEnumerable<string> BuOptions => DistinctField(o => o.PvBusinessUnitId, Cat.BuCode);

    private IEnumerable<Opportunity> Filtered()
    {
        IEnumerable<Opportunity> q = _opps;
        if (_market != "") q = q.Where(o => o.MarketId == _market);
        if (_kams.Count > 0) q = q.Where(o => _kams.Contains(o.KamId));
        if (_catFilter != "") q = q.Where(o => o.ForecastCategory == _catFilter);
        if (_country != "") q = q.Where(o => o.CountryId == _country);
        if (_product != "") q = q.Where(o => o.ProductId == _product);
        if (_customer != "") q = q.Where(o => o.CustomerId == _customer);
        if (_bu != "") q = q.Where(o => o.PvBusinessUnitId == _bu);
        if (_monthFilter is >= 1 and <= 12) q = q.Where(o => o.ExpectedDateValue?.Month == _monthFilter);
        if (_dateFrom is { } df) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date >= df.Date);
        if (_dateTo is { } dt) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date <= dt.Date);
        if (_valMin is { } vmin) q = q.Where(o => MetricBrl(o, _valMetric) >= vmin);
        if (_valMax is { } vmax) q = q.Where(o => MetricBrl(o, _valMetric) <= vmax);
        return q;
    }

    private void ClearFilters()
    {
        _market = _catFilter = _country = _product = _customer = _bu = "";
        _kams.Clear();
        _monthFilter = 0; _dateFrom = _dateTo = null;
        _valMin = _valMax = null; _valMetric = "total";
    }
    private void SaveView() { _savedMsg = true; }

    private void Build()
    {
        _sym = _currency == "BRL" ? "R$" : "US$";
        _year = _today.Year; _month = _today.Month; _quarter = Fmt.QuarterOf(_month);
        _activeFilters = new[] { _market, _catFilter, _country, _product, _customer, _bu }.Count(s => s != "")
            + (_kams.Count > 0 ? 1 : 0)
            + (_monthFilter is >= 1 and <= 12 ? 1 : 0) + (_dateFrom is not null ? 1 : 0) + (_dateTo is not null ? 1 : 0)
            + (_valMin is not null || _valMax is not null ? 1 : 0);

        var opps = Filtered().ToList();
        _filtered = opps;

        // Hero: Meta × Realizado do REPORT HSA (guia Controle). Sem filtro de mês
        // mostra o total do ano; com filtro de mês mostra o mês selecionado.
        if (_monthFilter is >= 1 and <= 12)
        {
            _heroReal = _repReal[_monthFilter - 1];
            _heroMeta = _repMeta[_monthFilter - 1];
            _heroMetaHsa = _repMetaHsa[_monthFilter - 1];
        }
        else
        {
            _heroReal = _repReal.Sum();
            _heroMeta = _repMeta.Sum();
            _heroMetaHsa = _repMetaHsa.Sum();
        }
        _heroAttain = _heroMeta > 0 ? _heroReal / _heroMeta * 100 : 0;
        _heroAttainHsa = _heroMetaHsa > 0 ? _heroReal / _heroMetaHsa * 100 : 0;

        bool InYear(Opportunity o) => (o.ExpectedDateValue?.Year ?? 0) == _year;
        bool InMonth(Opportunity o) => InYear(o) && o.ExpectedDateValue!.Value.Month == _month;
        bool InQuarter(Opportunity o) => InYear(o) && Fmt.QuarterOf(o.ExpectedDateValue!.Value.Month) == _quarter;
        // Elegível ao forecast = toda oportunidade ABERTA (inclui Pipeline, que é
        // como a base importada chega). Antes só contava Commit/BestCase/Risk, o
        // que zerava os gráficos com dados reais.
        bool Eligible(Opportunity o) => ForecastCategories.IsOpen(o.Category);
        bool Open(Opportunity o) => ForecastCategories.IsOpen(o.Category);
        bool Won(Opportunity o) => o.Category == ForecastCategory.ClosedWon;
        double W(Opportunity o) => ForecastCalc.WeightedUsd(o);

        _fcMonth = opps.Where(o => InMonth(o) && Eligible(o)).Sum(W);
        _fcQuarter = opps.Where(o => InQuarter(o) && Eligible(o)).Sum(W);
        _fcYear = opps.Where(o => InYear(o) && Eligible(o)).Sum(W);
        _committedMonth = opps.Where(o => InMonth(o) && o.Category == ForecastCategory.Commit).Sum(W);
        _tgtMonth = Cat.TargetMonth(_year, _month);
        _tgtQuarter = Cat.TargetQuarter(_year, _quarter);
        _tgtYear = Cat.TargetYear(_year);
        _attainMonth = _tgtMonth > 0 ? _fcMonth / _tgtMonth * 100 : 0;

        _realizedYtd = opps.Where(o => Won(o) && InYear(o) && o.ExpectedDateValue!.Value.Month <= _month).Sum(o => o.AmountUsd);
        var tgtYtd = Enumerable.Range(1, _month).Sum(m => Cat.TargetMonth(_year, m));
        _attainYtd = tgtYtd > 0 ? _realizedYtd / tgtYtd * 100 : 0;
        var realizedYear = opps.Where(o => Won(o) && InYear(o)).Sum(o => o.AmountUsd);
        _attainYear = _tgtYear > 0 ? (realizedYear + _fcYear) / _tgtYear * 100 : 0;

        var open = opps.Where(Open).ToList();
        _openCount = open.Count;
        _pipelineTotal = open.Sum(o => o.AmountUsd);
        _pipelineWeighted = open.Sum(W);

        // Top 10 oportunidades mais quentes: só entram valores ≥ R$ 1 mi; o
        // ranking combina a confiança (%) com o peso do valor (HeatScore).
        var hotElegiveis = open.Where(o => o.AmountBrl >= ForecastCalc.HotMinAmountBrl).ToList();
        var maxHotBrl = hotElegiveis.Count > 0 ? hotElegiveis.Max(o => o.AmountBrl) : 0;
        _top10Opps = hotElegiveis
            .OrderByDescending(o => ForecastCalc.HeatScore(o, maxHotBrl))
            .ThenByDescending(o => o.AmountBrl)
            .Take(10).ToList();
        var eligibleForecast = opps.Where(o => InYear(o) && Eligible(o)).ToList();
        _marginForecast = eligibleForecast.Sum(ForecastCalc.MarginUsd);
        _gmAvg = eligibleForecast.Count > 0 ? eligibleForecast.Average(o => o.GmPercentValue) : 0;

        _remainingTarget = Math.Max(_tgtYear - realizedYear, 1);
        _eligiblePipeline = open.Where(o => o.Category is ForecastCategory.Commit or ForecastCategory.BestCase or ForecastCategory.Pipeline).Sum(W);
        _coverage = ForecastCalc.Coverage(_eligiblePipeline, _remainingTarget);
        _coverageLabel = _coverage.ToString("0.0", _pt) + "x";
        _gapYear = ForecastCalc.Gap(_tgtYear, realizedYear, _fcYear);

        var risky = open.Where(o => ForecastCalc.Level(o, _today) is RiskLevel.Alto or RiskLevel.Critico).ToList();
        _atRisk = risky.Sum(W); _atRiskCount = risky.Count;
        _concentration = ForecastCalc.Concentration(open, o => o.CustomerId);
        var topC = open.GroupBy(o => o.CustomerId).OrderByDescending(g => g.Sum(o => o.AmountUsd)).FirstOrDefault();
        _topCustomer = topC != null ? Cat.CustomerName(topC.Key) : "—";
        _dq = (int)Math.Round(open.Count == 0 ? 100 : open.Average(DataQuality));

        // Evolução sintética (demonstração) e deltas.
        double[] Evo(double v) => new[] { v * 0.86, v * 0.91, v * 0.97, v };
        _evoMonth = Evo(_fcMonth); _evoQuarter = Evo(_fcQuarter); _evoYear = Evo(_fcYear);
        _fcMonthDelta = Delta(_evoMonth); _fcQuarterDelta = Delta(_evoQuarter); _fcYearDelta = Delta(_evoYear);

        BuildHealth(open);

        // Composição por FAIXA DE CONFIANÇA = (% ganho + % período) / 2.
        var bands = new (string Band, string Color, double Lo, double Hi)[]
        {
            ("Muito alta", "#1f9254", 85, 101),
            ("Alta", "#1665a8", 70, 85),
            ("Média", "#b7791f", 45, 70),
            ("Baixa", "#64748b", 0, 45),
        };
        var compRaw = bands.Select(b =>
        {
            var items = open.Where(o => { var c = ForecastCalc.Confidence(o); return c >= b.Lo && c < b.Hi; }).ToList();
            return (b.Band, b.Color, Value: items.Sum(Metric), Count: items.Count);
        }).ToList();
        _compTotal = Math.Max(compRaw.Sum(x => x.Value), 1);
        _comp = compRaw.Select(x => new CompRow(x.Band, x.Color, x.Value, x.Count, x.Value / _compTotal * 100, PseudoTrend(x.Band, 6))).ToList();

        // Aftermarket × New Business — agrupa pela categoria comercial real (NB/AFM/…).
        _byCommercial = opps.Where(o => InYear(o) && Eligible(o))
            .GroupBy(o => string.IsNullOrWhiteSpace(o.CommercialCategory) ? "—" : o.CommercialCategory.Trim())
            .Select(g => new CommRow(g.Key, CommName(g.Key), g.Sum(Metric)))
            .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();
        _maxComm = Math.Max(_byCommercial.Count > 0 ? _byCommercial.Max(x => x.Value) : 1, 1);

        // Distribuição da carteira — agrupa pelos VALORES reais dos campos das
        // oportunidades (com nome do catálogo quando houver), não iterando o
        // catálogo demo por Id. Assim funciona com a base importada.
        var eligYear = opps.Where(o => InYear(o) && Eligible(o)).ToList();
        _byBu = GroupSlices(eligYear, o => o.PvBusinessUnitId, Cat.BuCode);

        _byQuarter = new double[4];
        foreach (var o in eligYear) _byQuarter[(o.ExpectedDateValue!.Value.Month - 1) / 3] += Metric(o);

        _byCountry = GroupSlices(eligYear, o => o.CountryId, Cat.CountryName);
        _maxCountry = Math.Max(_byCountry.Count > 0 ? _byCountry.Max(x => x.Value) : 1, 1);
        _countryTotal = Math.Max(_byCountry.Sum(x => x.Value), 1);

        var gmSum = new double[12]; var gmCnt = new int[12];
        foreach (var o in eligYear)
        {
            var mi = o.ExpectedDateValue!.Value.Month - 1;
            gmSum[mi] += o.GmPercentValue; gmCnt[mi]++;
        }
        _gmMonthly = new double[12];
        for (var m = 0; m < 12; m++) _gmMonthly[m] = gmCnt[m] > 0 ? gmSum[m] / gmCnt[m] : 0;

        // Mercado / produto — agrupados pelos valores reais.
        _byMarket = eligYear.GroupBy(o => o.MarketId ?? "")
            .Select(g => new MarketRow(g.Key == "" ? "—" : Cat.MarketName(g.Key), g.Sum(Metric), PseudoTrend(g.Key, 14)))
            .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();
        _marketTotal = Math.Max(_byMarket.Sum(x => x.Value), 1);
        _maxMarket = Math.Max(_byMarket.Count > 0 ? _byMarket.Max(x => x.Value) : 1, 1);
        _marketTopRise = _byMarket.Count > 0 ? _byMarket.OrderByDescending(x => x.Trend).First().Name : "";
        _marketTopFall = _byMarket.Count > 0 ? _byMarket.OrderBy(x => x.Trend).First().Name : "";

        _byProduct = eligYear.GroupBy(o => o.ProductId ?? "")
            .Select(g =>
            {
                var items = g.ToList();
                return new ProductRow(g.Key == "" ? "—" : Cat.ProductName(g.Key), items.Sum(Metric),
                    items.Average(o => o.GmPercentValue), PseudoTrend(g.Key, 12));
            })
            .Where(x => x.Value > 0).OrderByDescending(x => x.Value).Take(6).ToList();
        _maxProduct = Math.Max(_byProduct.Count > 0 ? _byProduct.Max(x => x.Value) : 1, 1);
        _productTotal = Math.Max(_byProduct.Sum(x => x.Value), 1);

        // KAM com coverage e status — agrupado pelos KAMs reais das oportunidades.
        _byKam = eligYear.GroupBy(o => o.KamId ?? "")
            .Select(g =>
            {
                var name = g.Key == "" ? "—" : Cat.KamName(g.Key);
                var f = g.Sum(Metric);
                var t = Cat.TargetYear(_year, "kam", g.Key);
                var cov = t > 0 ? f / t : 0;
                var (st, css) = t <= 0 ? ("Sem meta", "st-neutral")
                    : cov >= 1 ? ("Dentro da meta", "st-pos")
                    : cov >= 0.75 ? ("Atenção", "st-warn")
                    : ("Abaixo da meta", "st-neg");
                return new KamRow(name, f, t, t - f, cov, st, css);
            })
            .Where(x => x.Forecast > 0).OrderByDescending(x => x.Forecast).ToList();

        BuildWaterfall();
        BuildInsights(opps, open, eligibleForecast);
        BuildAttention(opps, open, risky);

        // Combo chart (12 meses).
        _mTarget = new double[12]; _mReal = new double[12]; _mForecast = new double[12]; _mCumul = new double[12];
        for (var m = 0; m < 12; m++) _mTarget[m] = Cat.TargetMonth(_year, m + 1);
        foreach (var o in opps.Where(InYear))
        {
            var mi = o.ExpectedDateValue!.Value.Month - 1;
            if (Won(o)) _mReal[mi] += o.AmountUsd;
            else if (Eligible(o)) _mForecast[mi] += Metric(o);
        }
        double run = 0;
        for (var m = 0; m < 12; m++) { run += _mReal[m] + _mForecast[m]; _mCumul[m] = run; }
    }

    private static double Delta(double[] s) => s.Length > 1 && s[0] > 0 ? (s[^1] - s[0]) / s[0] * 100 : 0;
    private static double PseudoTrend(string s, int span) => ((s.Length * 7 + (s.Length > 0 ? s[0] : 0)) % (span * 2 + 1)) - span;

    private void BuildHealth(List<Opportunity> open)
    {
        var withMgr = open.Where(o => o.ManagerProbabilityValue is not null).ToList();
        var biasAbs = withMgr.Count > 0 ? withMgr.Average(o => Math.Abs(o.WinProbabilityValue - o.ManagerProbabilityValue!.Value)) : 8;
        int accuracy = (int)Math.Clamp(95 - biasAbs, 50, 96);
        int coverageScore = (int)Math.Clamp(_coverage / 3.5 * 100, 10, 100);
        int marginScore = (int)Math.Clamp(_gmAvg / 25.0 * 100, 10, 100);
        int riskScore = (int)Math.Clamp(100 - _atRisk / Math.Max(_pipelineWeighted, 1) * 100, 10, 100);
        int discipline = open.Count > 0 ? (int)Math.Round((double)open.Count(o => ForecastCalc.DaysSinceUpdate(o, _today) <= 21) / open.Count * 100) : 100;

        _healthMetrics = new()
        {
            new("Precisão da previsão", accuracy),
            new("Qualidade dos dados", _dq),
            new("Cobertura de pipeline", coverageScore),
            new("Saúde da margem", marginScore),
            new("Exposição ao risco", riskScore),
            new("Disciplina de atualização", discipline),
        };
        _health = (int)Math.Round(accuracy * 0.2 + _dq * 0.15 + coverageScore * 0.2 + marginScore * 0.15 + riskScore * 0.15 + discipline * 0.15);
        _healthLabel = _health >= 85 ? "Saudável" : _health >= 70 ? "Atenção" : "Em risco";
        _confidence = (accuracy + discipline) / 2;
    }

    private double DataQuality(Opportunity o)
    {
        double s = 0; const double each = 100.0 / 8;
        if (!string.IsNullOrWhiteSpace(o.CustomerId)) s += each;
        if (!string.IsNullOrWhiteSpace(o.ProductId)) s += each;
        if (o.ExpectedDateValue is not null) s += each;
        if (o.AmountUsd > 0) s += each;
        if (o.WinProbabilityValue is > 0 and <= 100) s += each;
        if (!string.IsNullOrWhiteSpace(o.NextAction)) s += each;
        if (ForecastCalc.DaysSinceUpdate(o, _today) <= 21) s += each;
        if (!string.IsNullOrWhiteSpace(o.PipelineStageId)) s += each;
        return s;
    }

    private void BuildWaterfall()
    {
        var b = _pipelineWeighted;
        _waterfall = new()
        {
            new("Anterior", b * 0.94, true),
            new("Novas oport.", b * 0.10, false),
            new("+ Valor", b * 0.05, false),
            new("+ Prob.", b * 0.04, false),
            new("− Prob.", -b * 0.04, false),
            new("Postergadas", -b * 0.05, false),
            new("Perdidas", -b * 0.04, false),
            new("Atual", b, true),
        };
        _moveNet = b - b * 0.94;
        var deltas = _waterfall.Where(x => !x.Total).ToList();
        _movePosName = deltas.Count > 0 ? deltas.OrderByDescending(x => x.Value).First().Label : "—";
        _moveNegName = deltas.Count > 0 ? deltas.OrderBy(x => x.Value).First().Label : "—";
    }

    private void BuildInsights(List<Opportunity> opps, List<Opportunity> open, List<Opportunity> eligible)
    {
        _insights = new();

        var marginGap = 30 - _gmAvg;
        if (marginGap > 0)
            _insights.Add(new("Margem", "warn",
                "Margem prevista abaixo da meta",
                $"A margem estimada está {marginGap.ToString("0.0", _pt)} p.p. abaixo do objetivo de 30%.",
                $"-{marginGap.ToString("0.0", _pt)} p.p.", "Revisar preços e condições comerciais", "/oportunidades"));

        var staleCommit = opps.Count(o => o.Category == ForecastCategory.Commit && ForecastCalc.DaysSinceUpdate(o, _today) > 30);
        if (staleCommit > 0)
            _insights.Add(new("Risco", "neg",
                "Comprometido sem atualização recente",
                $"{staleCommit} oportunidade(s) em Comprometido sem atualização há mais de 30 dias.",
                staleCommit.ToString(), "Validar na revisão comercial", "/oportunidades"));

        if (_coverage < 3.5)
            _insights.Add(new("Pipeline", "warn",
                "Cobertura de pipeline abaixo do ideal",
                $"A cobertura ({_coverageLabel}) está abaixo do nível ideal de 3,5x para o próximo trimestre.",
                _coverageLabel, "Gerar novo pipeline", "/oportunidades"));
    }

    private void BuildAttention(List<Opportunity> opps, List<Opportunity> open, List<Opportunity> risky)
    {
        _attn = new();
        string Meta(Opportunity o) => $"{Cat.CustomerName(o.CustomerId)} · {Cat.KamName(o.KamId)}";

        var bigRisk = risky.OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (bigRisk != null)
            _attn.Add(new("Risco crítico", "neg", "alert", bigRisk.Name, Meta(bigRisk), Money(bigRisk.AmountUsd),
                $"Sem interação recente e com probabilidade em {bigRisk.WinProbabilityValue:0}% · risco {RiskLevels.Label(ForecastCalc.Level(bigRisk, _today))}.",
                "Agendar acompanhamento executivo.", bigRisk.Id));

        var upside = open.Where(o => o.Category is ForecastCategory.Upside or ForecastCategory.BestCase && o.WinProbabilityValue < 60)
            .OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (upside != null)
            _attn.Add(new("Maior oportunidade adicional", "pos", "trend", upside.Name, Meta(upside), Money(upside.AmountUsd),
                $"Potencial adicional relevante com probabilidade em {upside.WinProbabilityValue:0}%.",
                "Priorizar recursos técnicos e comerciais.", upside.Id));

        var stale = open.Where(o => ForecastCalc.DaysSinceUpdate(o, _today) >= 30).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (stale != null)
            _attn.Add(new("Sem atualização", "warn", "clock", stale.Name, Meta(stale), Money(stale.AmountUsd),
                $"Sem atualização há {ForecastCalc.DaysSinceUpdate(stale, _today)} dias.",
                "Solicitar atualização de status ao KAM.", stale.Id));

        var noAction = open.Where(o => string.IsNullOrWhiteSpace(o.NextAction)).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (noAction != null)
            _attn.Add(new("Sem próxima ação", "info", "flag", noAction.Name, Meta(noAction), Money(noAction.AmountUsd),
                "Oportunidade prevista sem próxima ação definida.",
                "Definir e agendar a próxima ação comercial.", noAction.Id));

        var lowMargin = open.Where(o => o.GmPercentValue < 18).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (lowMargin != null)
            _attn.Add(new("Margem baixa", "neg", "dollar", lowMargin.Name, Meta(lowMargin), Money(lowMargin.AmountUsd),
                $"Margem em {lowMargin.GmPercentValue:0}%, abaixo do limite mínimo.",
                "Revisar escopo e precificação antes de avançar.", lowMargin.Id));

        if (_concentration > 0.30)
            _attn.Add(new("Concentração", "warn", "layers", "Concentração excessiva de pipeline", $"Maior cliente: {_topCustomer}", Fmt.Pct(_concentration * 100),
                $"{Fmt.Pct(_concentration * 100)} do pipeline aberto está em um único cliente.",
                "Ampliar cobertura para outros clientes/mercados.", ""));
    }

    private static string SevColor(string sev) => sev switch
    {
        "neg" => "var(--neg)", "warn" => "var(--warn)", "pos" => "var(--pos)", _ => "var(--info)",
    };
    private static string CatColor(ForecastCategory c) => c switch
    {
        ForecastCategory.Commit => "#1f9254",
        ForecastCategory.BestCase => "#1665a8",
        ForecastCategory.Pipeline => "#5b6b82",
        ForecastCategory.Upside => "#0f766e",
        ForecastCategory.Risk => "#b4590a",
        _ => "#5b6b82",
    };

    // Combo chart em SVG: barras (realizado + forecast), meta em traço, acumulado/projeção
    // em linha, mês atual destacado, tooltips nativos. Respeita moeda e modo selecionados.
    private RenderFragment RenderComboChart() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 240, top = 12, bot = 210, left = 8, colW = (Wd - left) / 12.0;
        bool cumul = _chartMode == "cumulative";

        double[] real = new double[12], fc = new double[12];
        double rr = 0, ff = 0;
        for (var m = 0; m < 12; m++)
        {
            if (cumul) { rr += _mReal[m]; ff += _mForecast[m]; real[m] = Cv(rr); fc[m] = Cv(ff); }
            else { real[m] = Cv(_mReal[m]); fc[m] = Cv(_mForecast[m]); }
        }
        double[] tgt = new double[12]; double trun = 0;
        for (var m = 0; m < 12; m++) { trun += _mTarget[m]; tgt[m] = cumul ? Cv(trun) : Cv(_mTarget[m]); }

        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, Math.Max(tgt[m], real[m] + fc[m]));
        max *= 1.06;
        double Y(double v) => bot - v / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Previsão x Meta x Realizado'>");
        for (var g = 1; g <= 3; g++) { var gy = top + (bot - top) * g / 4.0; sb.Append($"<line x1='{left}' y1='{gy.ToString("0.#", inv)}' x2='{Wd}' y2='{gy.ToString("0.#", inv)}' stroke='#f0f3f8'/>"); }
        sb.Append($"<line x1='{left}' y1='{bot.ToString(inv)}' x2='{Wd}' y2='{bot.ToString(inv)}' stroke='#e3e9f2'/>");

        // destaque do mês atual
        double hx = left + (_month - 1) * colW;
        sb.Append($"<rect x='{hx.ToString("0.#", inv)}' y='{top.ToString(inv)}' width='{colW.ToString("0.#", inv)}' height='{(bot - top).ToString("0.#", inv)}' fill='#0b4f8a' opacity='0.05'/>");

        var cumPts = new List<string>();
        for (var m = 0; m < 12; m++)
        {
            double cx = left + m * colW + colW / 2;
            double bw = colW * 0.58;
            double realTop = Y(real[m]); double fcTop = Y(real[m] + fc[m]);
            var tip = $"{Fmt.MonthName(m + 1)} · Realizado {_sym} {Fmt.Compact(real[m])} · Previsão {_sym} {Fmt.Compact(fc[m])} · Meta {_sym} {Fmt.Compact(tgt[m])}";
            sb.Append($"<g><title>{tip}</title>");
            if (real[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{realTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(bot - realTop).ToString("0.#", inv)}' fill='#0b4f8a' rx='1.5'/>");
            if (fc[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{fcTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(realTop - fcTop).ToString("0.#", inv)}' fill='#6ba7d6' rx='1.5'/>");
            double ty = Y(tgt[m]);
            sb.Append($"<line x1='{(cx - bw / 2 - 3).ToString("0.#", inv)}' y1='{ty.ToString("0.#", inv)}' x2='{(cx + bw / 2 + 3).ToString("0.#", inv)}' y2='{ty.ToString("0.#", inv)}' stroke='#009496' stroke-width='2.5' stroke-linecap='round'/>");
            sb.Append("</g>");
            cumPts.Add($"{cx.ToString("0.#", inv)},{Y(Cv(_mCumul[m])).ToString("0.#", inv)}");
            var lblColor = (m + 1) == _month ? "#0b4f8a" : "#93a1b5";
            var lblWeight = (m + 1) == _month ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 6).ToString(inv)}' text-anchor='middle' font-size='9' font-weight='{lblWeight}' fill='{lblColor}'>{Fmt.MonthName(m + 1)}</text>");
        }
        // acumulado (linha cheia até o mês atual, pontilhada na projeção futura)
        var past = cumPts.Take(_month).ToList();
        var future = cumPts.Skip(Math.Max(_month - 1, 0)).ToList();
        sb.Append($"<polyline points='{string.Join(' ', past)}' fill='none' stroke='#c0392b' stroke-width='1.7' opacity='0.85'/>");
        sb.Append($"<polyline points='{string.Join(' ', future)}' fill='none' stroke='#c0392b' stroke-width='1.6' stroke-dasharray='3 3' opacity='0.6'/>");
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Gráfico de linha da previsão mensal: linha + área preenchida + rótulos de
    // valor acima de cada ponto e nomes dos meses no eixo. Mês atual destacado.
    // Construído como string SVG (evita o erro RZ1023 de <text> em Razor).
    private RenderFragment RenderMonthlyLine() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 260, top = 34, bot = 214, left = 40, right = 20;
        double plotW = Wd - left - right;
        double colW = plotW / 11.0; // 12 pontos → 11 intervalos

        // Valores por mês (realizado + forecast ponderado), na moeda ativa.
        double[] v = new double[12];
        for (var m = 0; m < 12; m++) v[m] = Cv(_mReal[m] + _mForecast[m]);
        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, v[m]);
        max *= 1.18; // respiro para os rótulos acima dos pontos
        double X(int m) => left + m * colW;
        double Y(double val) => bot - val / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Previsão mensal'>");

        // gradiente da área
        sb.Append("<defs><linearGradient id='mlarea' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append("<stop offset='0%' stop-color='#007A9E' stop-opacity='0.28'/>");
        sb.Append("<stop offset='100%' stop-color='#007A9E' stop-opacity='0.02'/>");
        sb.Append("</linearGradient></defs>");

        // linhas de grade horizontais
        for (var g = 0; g <= 4; g++)
        {
            var gy = top + (bot - top) * g / 4.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
        }

        // destaque do mês atual (faixa vertical)
        double hx = X(_month - 1);
        sb.Append($"<line x1='{hx.ToString("0.#", inv)}' y1='{top.ToString(inv)}' x2='{hx.ToString("0.#", inv)}' y2='{bot.ToString(inv)}' stroke='#007A9E' stroke-width='1' stroke-dasharray='3 3' opacity='0.35'/>");

        // área preenchida
        var line = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++)
            line.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(v[m]).ToString("0.#", inv)}");
        var area = $"{left.ToString(inv)},{bot.ToString(inv)} {line} {(Wd - right).ToString(inv)},{bot.ToString(inv)}";
        sb.Append($"<polygon points='{area}' fill='url(#mlarea)'/>");

        // linha principal
        sb.Append($"<polyline points='{line}' fill='none' stroke='#007A9E' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>");

        // pontos + rótulos de valor + meses
        for (var m = 0; m < 12; m++)
        {
            double cx = X(m), cy = Y(v[m]);
            bool cur = (m + 1) == _month;
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{cy.ToString("0.#", inv)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='#007A9E' stroke-width='{(cur ? "3" : "2")}'/>");
            var lblColor = cur ? "#0b4f6f" : "#5b6b82";
            var lblWeight = cur ? "700" : "500";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(cy - 10).ToString("0.#", inv)}' text-anchor='middle' font-size='9.5' font-weight='{lblWeight}' fill='{lblColor}'>{Fmt.Compact(v[m])}</text>");
            var mColor = cur ? "#007A9E" : "#93a1b5";
            var mWeight = cur ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 8).ToString(inv)}' text-anchor='middle' font-size='9.5' font-weight='{mWeight}' fill='{mColor}'>{Fmt.MonthName(m + 1)}</text>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Gráfico de linhas Vendas x Meta (NB+AFM), puxando o REPORT HSA do Controle.
    // Duas linhas: Realizado (área + linha cheia) e Meta/Budget (linha tracejada).
    // Valores em R$ (moeda nativa do Controle). Construído como string SVG.
    private RenderFragment RenderReportLine() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 760, H = 280, top = 46, bot = 236, left = 46, right = 18;
        double plotW = Wd - left - right, colW = plotW / 11.0;
        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, Math.Max(Math.Max(_repReal[m], _repMeta[m]), _repMetaHsa[m]));
        max *= 1.20;
        double X(int m) => left + m * colW;
        double Y(double val) => bot - val / max * (bot - top);
        const string cReal = "#007A9E", cMeta = "#b7791f", cMhsa = "#1f9254";

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Vendas x Meta NB+AFM'>");

        sb.Append("<defs><linearGradient id='rlarea' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append($"<stop offset='0%' stop-color='{cReal}' stop-opacity='0.24'/><stop offset='100%' stop-color='{cReal}' stop-opacity='0.02'/>");
        sb.Append("</linearGradient></defs>");

        // legenda
        sb.Append($"<line x1='{left.ToString(inv)}' y1='20' x2='{(left + 22).ToString(inv)}' y2='20' stroke='{cReal}' stroke-width='3' stroke-linecap='round'/>");
        sb.Append($"<text x='{(left + 28).ToString(inv)}' y='23.5' font-size='11' font-weight='600' fill='#3b4a61'>Vendas NB+AFM (Realizado)</text>");
        sb.Append($"<line x1='{(left + 205).ToString(inv)}' y1='20' x2='{(left + 227).ToString(inv)}' y2='20' stroke='{cMeta}' stroke-width='3' stroke-dasharray='5 3' stroke-linecap='round'/>");
        sb.Append($"<text x='{(left + 233).ToString(inv)}' y='23.5' font-size='11' font-weight='600' fill='#3b4a61'>Meta NB+AFM (Budget)</text>");
        sb.Append($"<line x1='{(left + 400).ToString(inv)}' y1='20' x2='{(left + 422).ToString(inv)}' y2='20' stroke='{cMhsa}' stroke-width='3' stroke-dasharray='2 3' stroke-linecap='round'/>");
        sb.Append($"<text x='{(left + 428).ToString(inv)}' y='23.5' font-size='11' font-weight='600' fill='#3b4a61'>Meta Vendas HSA</text>");

        // grade + rótulos do eixo Y
        for (var g = 0; g <= 4; g++)
        {
            double gy = top + (bot - top) * g / 4.0, gv = max * (4 - g) / 4.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
            sb.Append($"<text x='{(left - 6).ToString(inv)}' y='{(gy + 3).ToString("0.#", inv)}' text-anchor='end' font-size='8.5' fill='#93a1b5'>{Esc(Fmt.Compact(gv))}</text>");
        }

        // destaque do mês atual
        double hx = X(_month - 1);
        sb.Append($"<line x1='{hx.ToString("0.#", inv)}' y1='{top.ToString(inv)}' x2='{hx.ToString("0.#", inv)}' y2='{bot.ToString(inv)}' stroke='{cReal}' stroke-width='1' stroke-dasharray='3 3' opacity='0.3'/>");

        // linha Realizado (área + linha)
        var lr = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lr.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repReal[m]).ToString("0.#", inv)}");
        sb.Append($"<polygon points='{left.ToString(inv)},{bot.ToString(inv)} {lr} {(Wd - right).ToString(inv)},{bot.ToString(inv)}' fill='url(#rlarea)'/>");
        sb.Append($"<polyline points='{lr}' fill='none' stroke='{cReal}' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>");

        // linha Meta (tracejada)
        var lm = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lm.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repMeta[m]).ToString("0.#", inv)}");
        sb.Append($"<polyline points='{lm}' fill='none' stroke='{cMeta}' stroke-width='2' stroke-dasharray='5 3' stroke-linejoin='round' stroke-linecap='round'/>");

        // linha Meta Vendas HSA (pontilhada)
        var lh = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lh.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repMetaHsa[m]).ToString("0.#", inv)}");
        sb.Append($"<polyline points='{lh}' fill='none' stroke='{cMhsa}' stroke-width='2' stroke-dasharray='2 3' stroke-linejoin='round' stroke-linecap='round'/>");

        // pontos + rótulos + meses
        for (var m = 0; m < 12; m++)
        {
            double cx = X(m), yr = Y(_repReal[m]), ym = Y(_repMeta[m]), yh = Y(_repMetaHsa[m]);
            bool cur = (m + 1) == _month;
            double att = _repMeta[m] > 0 && _repReal[m] > 0 ? _repReal[m] / _repMeta[m] * 100 : 0;
            var tip = $"{Fmt.MonthName(m + 1)} · Realizado R$ {Fmt.Compact(_repReal[m])} · Meta R$ {Fmt.Compact(_repMeta[m])} · Meta HSA R$ {Fmt.Compact(_repMetaHsa[m])}" + (att > 0 ? $" · {Fmt.Pct(att)}" : "");

            if (_repMetaHsa[m] > 0) sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yh.ToString("0.#", inv)}' r='2.5' fill='{cMhsa}'><title>{Esc(tip)}</title></circle>");
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{ym.ToString("0.#", inv)}' r='2.5' fill='{cMeta}'><title>{Esc(tip)}</title></circle>");
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yr.ToString("0.#", inv)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='{cReal}' stroke-width='{(cur ? "3" : "2")}'><title>{Esc(tip)}</title></circle>");
            if (_repReal[m] > 0)
                sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(yr - 9).ToString("0.#", inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "500")}' fill='{(cur ? "#0b4f6f" : "#5b6b82")}'>{Esc(Fmt.Compact(_repReal[m]))}</text>");
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 7).ToString(inv)}' text-anchor='middle' font-size='9.5' font-weight='{(cur ? "700" : "400")}' fill='{(cur ? cReal : "#93a1b5")}'>{Fmt.MonthName(m + 1)}</text>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Nome do país nos dados (PT / variações) -> nome no mapa-múndi (inglês).
    private static readonly Dictionary<string, string> CountryToMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["brasil"] = "Brazil", ["chile"] = "Chile", ["peru"] = "Peru", ["perú"] = "Peru",
        ["argentina"] = "Argentina", ["colombia"] = "Colombia", ["colômbia"] = "Colombia",
        ["bolivia"] = "Bolivia", ["bolívia"] = "Bolivia", ["venezuela"] = "Venezuela",
        ["equador"] = "Ecuador", ["paraguai"] = "Paraguay", ["uruguai"] = "Uruguay",
        ["guiana"] = "Guyana", ["méxico"] = "Mexico", ["mexico"] = "Mexico",
        ["estados unidos"] = "United States of America", ["eua"] = "United States of America",
        ["espanha"] = "Spain", ["alemanha"] = "Germany", ["frança"] = "France", ["itália"] = "Italy",
        ["reino unido"] = "United Kingdom", ["china"] = "China", ["índia"] = "India", ["japão"] = "Japan",
        ["áfrica do sul"] = "South Africa", ["austrália"] = "Australia", ["canadá"] = "Canada",
    };

    // Resolve o rótulo do país dos dados para a chave do mapa (com fallback ao nome em inglês).
    private static string? MapKey(string label)
    {
        var l = label.Trim();
        if (CountryToMap.TryGetValue(l, out var en) && WorldMap.Paths.ContainsKey(en)) return en;
        return WorldMap.Paths.ContainsKey(l) ? l : null;
    }

    // Interpolação de cor (claro -> teal) para o choropleth, t em [0,1].
    private static string Shade(double t)
    {
        t = Math.Clamp(t, 0, 1);
        int r = (int)(238 + (0 - 238) * t), g = (int)(244 + (122 - 244) * t), b = (int)(248 + (158 - 248) * t);
        return $"rgb({r},{g},{b})";
    }

    private const string MapId = "worldmap";

    // Mapa-múndi (choropleth) com fronteiras reais dos países.
    private RenderFragment RenderWorldMap() => builder =>
    {
        // valor por país no nome do mapa (soma variações)
        var byName = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in _byCountry)
            if (MapKey(c.Label) is { } key)
                byName[key] = byName.GetValueOrDefault(key) + c.Value;
        double maxV = byName.Count > 0 ? byName.Values.Max() : 1;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {F(WorldMap.ViewW)} {F(WorldMap.ViewH)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Distribuição por país'>");
        sb.Append($"<rect x='0' y='0' width='{F(WorldMap.ViewW)}' height='{F(WorldMap.ViewH)}' fill='#f7fafc'/>");
        foreach (var (name, d) in WorldMap.Paths)
        {
            var has = byName.TryGetValue(name, out var v);
            var fill = has ? Shade(maxV > 0 ? v / maxV : 0) : "#e7edf3";
            var data = has
                ? $" data-value='{Esc(Money(v))}' data-pct='{Esc(Fmt.Pct(v / Math.Max(_countryTotal, 1) * 100))}' data-metric='{Esc(MetricLabel)}'"
                : "";
            sb.Append($"<path d='{d}' fill='{fill}' stroke='#cdd8e4' stroke-width='0.4' data-country='{Esc(name)}'{data} class='wm-path'/>");
        }
        // rótulo de valor no país (centroide gerado) com contraste conforme o tom
        foreach (var kv in byName)
        {
            if (!WorldMap.Centroids.TryGetValue(kv.Key, out var pos)) continue;
            bool dark = (maxV > 0 ? kv.Value / maxV : 0) > 0.5;
            sb.Append($"<text x='{F(pos.X)}' y='{F(pos.Y + 3)}' text-anchor='middle' font-size='9' font-weight='700' fill='{(dark ? "#fff" : "#1e2836")}'>{Esc(Fmt.Compact(Cv(kv.Value)))}</text>");
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Paleta dos gráficos de pizza/rosca.
    private static readonly string[] PieColors =
        { "#007A9E", "#009496", "#0b4f6f", "#5bb0c9", "#b7791f", "#1f9254", "#64748b", "#c0392b" };

    private static string Esc(string s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    // Gráfico de rosca (donut) + legenda. Valores em USD, convertidos p/ a moeda ativa.
    private RenderFragment RenderDonut(IReadOnlyList<SliceRow> data) => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double total = Math.Max(data.Sum(d => Cv(d.Value)), 1);
        double cx = 64, cy = 64, r = 50, sw = 20, C = 2 * Math.PI * r;

        var sb = new System.Text.StringBuilder();
        sb.Append("<div class='donut-wrap'>");
        sb.Append("<svg viewBox='0 0 128 128' class='donut-svg' role='img' aria-label='Distribuição'>");
        sb.Append($"<circle cx='{cx}' cy='{cy}' r='{r.ToString(inv)}' fill='none' stroke='#eef2f7' stroke-width='{sw.ToString(inv)}'/>");
        double off = 0;
        for (var i = 0; i < data.Count; i++)
        {
            double val = Cv(data[i].Value);
            if (val <= 0) continue;
            double dash = val / total * C;
            var col = PieColors[i % PieColors.Length];
            sb.Append($"<circle cx='{cx}' cy='{cy}' r='{r.ToString(inv)}' fill='none' stroke='{col}' stroke-width='{sw.ToString(inv)}' stroke-dasharray='{dash.ToString("0.##", inv)} {(C - dash).ToString("0.##", inv)}' stroke-dashoffset='{(-off).ToString("0.##", inv)}' transform='rotate(-90 {cx} {cy})'/>");
            off += dash;
        }
        sb.Append($"<text x='{cx}' y='{(cy - 3).ToString(inv)}' text-anchor='middle' font-size='8.5' fill='#93a1b5'>Total</text>");
        sb.Append($"<text x='{cx}' y='{(cy + 11).ToString(inv)}' text-anchor='middle' font-size='13' font-weight='700' fill='#1e2836'>{_sym} {Fmt.Compact(total)}</text>");
        sb.Append("</svg>");

        sb.Append("<ul class='donut-legend'>");
        for (var i = 0; i < data.Count; i++)
        {
            double val = Cv(data[i].Value);
            var col = PieColors[i % PieColors.Length];
            sb.Append($"<li><span class='dl-dot' style='background:{col}'></span><span class='dl-name'>{Esc(data[i].Label)}</span><span class='dl-val'>{_sym} {Fmt.Compact(val)}</span><span class='dl-pct'>{Fmt.Pct(val / total * 100)}</span></li>");
        }
        sb.Append("</ul></div>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Colunas do GM médio por mês (%), com linha-alvo em 30% e mês atual destacado.
    private RenderFragment RenderGmColumns() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 220, top = 24, bot = 180, left = 30, right = 12;
        double plotW = Wd - left - right, colW = plotW / 12.0;
        double max = Math.Max(_gmMonthly.DefaultIfEmpty(0).Max(), 30) * 1.15;
        double Y(double v) => bot - v / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='GM médio mensal'>");
        for (var g = 0; g <= 3; g++)
        {
            var gy = top + (bot - top) * g / 3.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
        }
        // linha-alvo em 30%
        double ty = Y(30);
        sb.Append($"<line x1='{left.ToString(inv)}' y1='{ty.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{ty.ToString("0.#", inv)}' stroke='#b7791f' stroke-width='1' stroke-dasharray='4 3' opacity='0.7'/>");
        sb.Append($"<text x='{(Wd - right).ToString(inv)}' y='{(ty - 4).ToString("0.#", inv)}' text-anchor='end' font-size='8.5' fill='#b7791f'>meta 30%</text>");

        for (var m = 0; m < 12; m++)
        {
            double val = _gmMonthly[m];
            double bw = colW * 0.56;
            double cxc = left + m * colW + colW / 2;
            double yTop = Y(val);
            bool cur = (m + 1) == _month;
            var col = cur ? "#007A9E" : val >= 30 ? "#1f9254" : val >= 20 ? "#5bb0c9" : "#c98a3a";
            if (val > 0)
                sb.Append($"<rect x='{(cxc - bw / 2).ToString("0.#", inv)}' y='{yTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(bot - yTop).ToString("0.#", inv)}' rx='2' fill='{col}'/>");
            sb.Append($"<text x='{cxc.ToString("0.#", inv)}' y='{(yTop - 5).ToString("0.#", inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "500")}' fill='#5b6b82'>{val.ToString("0", inv)}%</text>");
            sb.Append($"<text x='{cxc.ToString("0.#", inv)}' y='{(H - 6).ToString(inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "400")}' fill='{(cur ? "#007A9E" : "#93a1b5")}'>{Fmt.MonthName(m + 1)}</text>");
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };
}
