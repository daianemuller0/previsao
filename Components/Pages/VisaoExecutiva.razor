@* ===================== 5 · EXECUTIVE ATTENTION ===================== *@
<div class="section-head" data-pnl="sec-atencao"><span class="st-title">@Icons.Svg("alert", "nav-ico") @T("Atenção executiva", "Executive attention")</span><span class="st-sub">@T("sinais que exigem decisão da liderança", "signals that require a leadership decision")</span><span class="st-line"></span></div>
<div class="attn2" data-pnl="atencao">
    @foreach (var a in _attn)
    {
        <div class="attn-card sev-@a.Sev">
            <div class="attn-top">
                <span class="attn-cat sev-@a.Sev">@Icons.Svg(a.Icon)@a.Category</span>
                <details class="ctx">
                    <summary title="@T("Mais ações", "More actions")">@Icons.Svg("more")</summary>
                    <div class="ctx-menu">
                        @if (!string.IsNullOrEmpty(a.OppId)) { <a href="@($"/oportunidades/{a.OppId}")">@T("Ver oportunidade", "View opportunity")</a> }
                        <a href="/oportunidades">@T("Abrir oportunidades", "Open opportunities")</a>
                    </div>
                </details>
            </div>
            <span class="attn-name">@a.Title</span>
            <span class="attn-meta">@a.Meta</span>
            @if (!string.IsNullOrEmpty(a.Value)) { <span class="attn-val">@a.Value</span> }
            <span class="attn-reason">@a.Reason</span>
            <div class="attn-actions">
                @if (!string.IsNullOrEmpty(a.OppId))
                {
                    <a class="btn-ghost" href="@($"/oportunidades/{a.OppId}")">@T("Ver oportunidade", "View opportunity")</a>
                }
                else
                {
                    <a class="btn-ghost" href="/oportunidades">@T("Ver oportunidades", "View opportunities")</a>
                }
            </div>
        </div>
    }
</div>
</div>

@code {
    // ---- estado / filtros ----
    private List<Opportunity> _opps = new();
    private List<Opportunity> _filtered = new();
    // Campo, não propriedade: como propriedade ela reordenava a lista inteira a
    // cada render — e um render acontece a cada tecla, clique e abertura de menu.
    // A lista é limitada: este painel é panorama, e mandar milhares de linhas
    // para o navegador a cada mudança de filtro é o que travava a tela. A
    // listagem completa está a um clique, na aba Oportunidades.
    private const int TetoTabela = 200;
    private List<Opportunity> _filteredSorted = new();
    private DateTime _today = DateTime.Today;
    private DateTime _updated = DateTime.Now;
    private int _year, _month, _quarter;
    // Filtros por NOME resolvido (mesmo rótulo mostrado nos gráficos), para que o
    // clique num elemento (cross-filter estilo Power BI) case com o agrupamento.
    private string _commercial = "", _stage = "", _segment = "", _submarket = "";
    // Filtros da barra: TODOS multi-seleção (vazio = todos).
    private static HashSet<string> NewSet() => new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _kams = NewSet();        // KAM (vendedor)
    private HashSet<string> _markets = NewSet();
    private HashSet<string> _setores = NewSet();     // "New Business" · "Aftermarket"
    private HashSet<string> _countries = NewSet();
    private HashSet<string> _products = NewSet();
    private HashSet<string> _customers = NewSet();
    private HashSet<string> _bus = NewSet();
    private HashSet<string> _buIcs = NewSet();       // BU IC de origem (BU de origem da planilha do AFM)
    private HashSet<string> _years = NewSet();       // anos como texto ("2026")
    private HashSet<string> _months = NewSet();      // meses por nome ("Janeiro")
    private IEnumerable<HashSet<string>> AllSets =>
        new[] { _kams, _markets, _setores, _countries, _products, _customers, _bus, _years, _months, _buIcs };

    // ---- recorte guardado durante a sessão ---------------------------------
    // Abrir uma proposta recria esta tela do zero na volta. Sem guardar, o recorte
    // some a cada ida e vinda — e aqui ele costuma ter vários filtros somados.
    private const string Tela = "executivo";

    private sealed record Recorte(string Commercial, string Stage, string Segment, string Submarket,
        HashSet<string> Kams, HashSet<string> Markets, HashSet<string> Setores, HashSet<string> Countries,
        HashSet<string> Products, HashSet<string> Customers, HashSet<string> Bus,
        HashSet<string> Years, HashSet<string> Months,
        string Search, bool OnlyIndicated, bool SemOtp, bool ShowMore,
        string Currency, string ValMetric, double? ValMin, double? ValMax, bool OnlyLost, bool OnlyAltered,
        HashSet<string>? BuIcs = null, bool Overdue = false);

    private void GuardarFiltros() => Filtros.Guardar(Tela,
        new Recorte(_commercial, _stage, _segment, _submarket,
            _kams, _markets, _setores, _countries, _products, _customers, _bus, _years, _months,
            _search, _onlyIndicated, _semOtp, _showMore, _currency, _valMetric, _valMin, _valMax, _onlyLost, _onlyAltered, _buIcs, _overdue));

    private void RestaurarFiltros()
    {
        if (Filtros.Ler<Recorte>(Tela) is not { } r) return;
        _commercial = r.Commercial; _stage = r.Stage; _segment = r.Segment; _submarket = r.Submarket;
        _kams = r.Kams; _markets = r.Markets; _setores = r.Setores; _countries = r.Countries;
        _products = r.Products; _customers = r.Customers; _bus = r.Bus;
        _buIcs = r.BuIcs ?? NewSet();
        _years = r.Years; _months = r.Months;
        _search = r.Search; _onlyIndicated = r.OnlyIndicated; _semOtp = r.SemOtp; _showMore = r.ShowMore;
        _onlyLost = r.OnlyLost; _onlyAltered = r.OnlyAltered; _overdue = r.Overdue;
        _currency = r.Currency; _valMetric = r.ValMetric; _valMin = r.ValMin; _valMax = r.ValMax;
    }

    private DotNetObjectReference<VisaoExecutiva>? _ref;
    private string _currency = "BRL", _chartMode = "monthly"; // R$ é o padrão da plataforma
    // Derivados (rótulos e REPORT usam um único mês/ano quando há exatamente um).
    private int _monthFilter => _months.Count == 1 ? MonthNum(_months.First()) : 0;
    private int _yearFilter => _years.Count == 1 && int.TryParse(_years.First(), out var y) ? y : 0;
    private bool _onlyIndicated;           // mostrar só as oportunidades indicadas na previsão
    private string _search = "";           // busca livre: oportunidade, cliente, proposta
    private bool _semOtp;                  // tirar do recorte o que já é OTP
    private bool _overdue;                 // só as vencidas: data de fechamento até ontem (hoje - 1 dia)
    private bool _onlyLost;                // só as indicadas como perdidas
    private bool _onlyAltered;             // só as com valor alterado no sistema (≠ CRM)
    private IEnumerable<int> YearOptions => _opps.Select(o => o.ExpectedDateValue?.Year ?? 0).Where(y => y > 0).Distinct().OrderByDescending(y => y);
    private static IEnumerable<string> MonthOptions => Enumerable.Range(1, 12).Select(Fmt.MonthLong);
    private static readonly string[] SetorOptions = { "New Business", "Aftermarket" };
    private static int MonthNum(string nome)
    {
        for (var m = 1; m <= 12; m++) if (string.Equals(Fmt.MonthLong(m), nome, StringComparison.OrdinalIgnoreCase)) return m;
        return 0;
    }
    // Meses selecionados (1..12); vazio = todos.
    private List<int> SelectedMonths => _months.Select(MonthNum).Where(m => m is >= 1 and <= 12).ToList();
    private static string SetorCode(string label) => label.StartsWith("After", StringComparison.OrdinalIgnoreCase) ? "AFM" : "NB";
    private string _valMetric = "total";   // total (Net Value) | conv (Chance de conversão)
    private double? _valMin, _valMax;      // faixa de valor (R$) do métrico escolhido

    // Valor do métrico escolhido, em R$ (Net Value ou Chance de conversão).
    private static double MetricBrl(Opportunity o, string metric) =>
        metric == "conv" ? ForecastCalc.ConversionBrl(o) : o.AmountBrl;
    private bool _showMore, _savedMsg;
    private static readonly System.Globalization.CultureInfo _pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    // ---- valores calculados ----
    private double _fcMonth, _fcQuarter, _fcYear, _tgtMonth, _tgtQuarter, _tgtYear;
    private double _metaQuarter, _metaYear;   // metas do trimestre/ano (REPORT HSA)
    private double _realizedYtd, _attainYtd, _attainYear, _attainMonth, _committedMonth;
    private double _pipelineTotal, _pipelineWeighted, _marginForecast, _gmAvg;
    private double _coverage, _gapYear, _concentration, _atRisk, _eligiblePipeline, _remainingTarget;
    private int _openCount, _atRiskCount, _dq, _confidence, _health;
    private string _topCustomer = "—", _healthLabel = "", _coverageLabel = "", _sym = "US$";
    private double _fcMonthDelta, _fcQuarterDelta, _fcYearDelta, _moveNet;
    private double[] _evoMonth = Array.Empty<double>(), _evoQuarter = Array.Empty<double>(), _evoYear = Array.Empty<double>();
    private double[] _mTarget = new double[12], _mReal = new double[12], _mForecast = new double[12], _mCumul = new double[12];
    private int _activeFilters;

    private List<HealthScore.Metric> _healthMetrics = new();
    private record CompRow(string Band, string Color, double Value, int Count, double Share, double Trend);
    private record MarketRow(string Name, double Value, double Trend);
    private record ProductRow(string Name, double Value, double Margin, double Trend);
    private record KamRow(string Name, double Forecast, double Target, double Gap, double Coverage, string Status, string StatusCss);
    private record Insight(string Category, string Sev, string Title, string Detail, string Value, string Action, string Link);
    private record Attn(string Category, string Sev, string Icon, string Title, string Meta, string Value, string Reason, string Rec, string OppId);
    private List<Opportunity> _top10Opps = new();
    private record CommRow(string Code, string Name, double Value);
    private record SliceRow(string Label, double Value);
    // Funil de Vendas (por Stage), ordenado decrescente por valor.
    private record FunnelRow(string Stage, double Value, int Count);
    private List<FunnelRow> _funnel = new();
    private double _funnelMax = 1, _funnelTotal = 1;
    // Previsão Indicada (oportunidades sinalizadas pelos vendedores).
    private List<Opportunity> _indicadas = new();
    private double _indTotal;
    private List<FunnelRow> _indFunnel = new();
    private List<SliceRow> _indByRep = new();
    // Gráficos do funil (base nova). Valores em R$ nativo (Amount converted).
    private List<SliceRow> _byRep = new(), _bySegment = new(), _byMarketH = new(), _bySubMarket = new(), _byBu2 = new();
    private List<SliceRow> _bySetor = new();   // pizza AFM × NB (por setor de origem)
    private double[] _monthAmt = new double[12];
    private List<SliceRow> _byBu = new();
    private List<SliceRow> _byCountry = new();
    private double[] _byQuarter = new double[4];
    private double[] _gmMonthly = new double[12];
    private double _maxCountry = 1, _countryTotal = 1;
    private List<CompRow> _comp = new();
    private List<MarketRow> _byMarket = new();
    private List<ProductRow> _byProduct = new();
    private List<KamRow> _byKam = new();
    private List<Insight> _insights = new();
    private List<Attn> _attn = new();
    private List<Waterfall.WaterItem> _waterfall = new();
    private double _maxMarket = 1, _maxProduct = 1, _marketTotal = 1, _productTotal = 1, _compTotal = 1;
    private string _marketTopRise = "", _marketTopFall = "";
    private string _movePosName = "", _moveNegName = "";

    private double Rate => Cat.RateToUsd("USD");
    // taxa R$/US$ digitada ao lado de USD: em dólar, o valor que a página mostraria em R$ dividido por ela
    private double? _taxaTela;
    private double? TaxaTelaAtiva => _currency == "USD" && _taxaTela is > 0 ? _taxaTela : null;
    /// <summary>Em USD com a taxa da tela: o US$ canônico (R$ ÷ taxa cadastrada) passa a R$ ÷ taxa da tela.</summary>
    private double FatorTela => TaxaTelaAtiva is double t ? Rate / t : 1.0;
    private void MudarTaxaTela(ChangeEventArgs e)
    {
        var t = (e.Value?.ToString() ?? "").Trim().Replace(",", ".");
        _taxaTela = double.TryParse(t, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0 ? v : null;
    }
    private double Cv(double usd) => _currency == "BRL" ? usd * Rate : usd * FatorTela;
    private string Money(double usd) => _sym + " " + Compacto(Cv(usd));
    private static string Clamp(double v) => Math.Clamp(v, 3, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    private static string Share(double v, double total) => (total <= 0 ? 0 : Math.Round(v / total * 100)).ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Série do REPORT HSA (Controle): realizado x meta mensal + atendimento anual.
    private double[] _repReal = new double[12], _repRealizada = new double[12],
                     _repMeta = new double[12], _repMetaHsa = new double[12];
    private double _repAttain, _repAttainHsa;
    private int _repYear = DateTime.Today.Year;

    // Hero (Meta × Realizado do REPORT HSA), sensível ao filtro de mês.
    private double _heroReal, _heroRealizada, _heroMeta, _heroMetaHsa, _heroAttain, _heroAttainHsa;

    // ---- foco da Visão Executiva: as vendas REALIZADAS ---------------------
    // O número que se lê primeiro aqui é o que de fato se concretizou; as
    // reportadas continuam à vista, um degrau abaixo. Enquanto o Controle não
    // tiver a linha das realizadas, o foco cai nas reportadas — e o rótulo
    // sempre diz qual dos dois está na tela, para ninguém ler um pelo outro.
    private bool TemRealizada => _repRealizada.Any(v => v > 0);
    private double FocoValor => TemRealizada ? _heroRealizada : _heroReal;
    private double OutroValor => TemRealizada ? _heroReal : _heroRealizada;
    private string FocoNome => TemRealizada ? T("Vendas realizadas", "Actual sales") : T("Vendas reportadas", "Reported sales");
    private string OutroNome => TemRealizada ? T("Vendas reportadas", "Reported sales") : T("Vendas realizadas", "Actual sales");

    // Conversão de valores em R$ (REPORT HSA é nativo em R$) respeitando o toggle.
    private double CvBrl(double brl) => _currency == "BRL" ? brl : brl / Math.Max(TaxaTelaAtiva ?? Rate, 0.0001);
    private string MoneyBrl(double brl) => _sym + " " + Compacto(CvBrl(brl));

    // Métrica exibida nos gráficos, conforme o seletor "Filtrar por":
    // "conv" = Chance de conversão (Net Value × %ganho × %sair); senão Valor total.
    // Canônico em US$ derivado SEMPRE do Net Value (R$) pela taxa global — assim o
    // total em R$ (Money → × Rate) reproduz exatamente o Net Value somado na aba
    // Oportunidades, sem a distorção do câmbio por linha (Net Value ÷ taxa da linha).
    private double Metric(Opportunity o) => MetricBrl(o, _valMetric) / Math.Max(Rate, 0.0001);
    private string MetricLabel => _valMetric == "conv" ? T("chance de conversão", "conversion likelihood") : T("valor total", "total value");

    // Agrupa oportunidades pelo VALOR real de um campo (não pelo catálogo),
    // somando a métrica ativa; rótulo via função de nome (com fallback ao texto cru).
    // Agrupa pelo NOME RESOLVIDO (não pelo id cru): na importação um mesmo item
    // pode chegar ora como id do catálogo, ora como texto — se agrupasse pelo id,
    // o mesmo mercado/país viraria barras separadas e cada valor ficaria menor.
    private List<SliceRow> GroupSlices(IEnumerable<Opportunity> src, Func<Opportunity, string> key, Func<string, string> name) =>
        src.GroupBy(o => DisplayKey(key(o), name), StringComparer.OrdinalIgnoreCase)
           .Select(g => new SliceRow(g.Key, g.Sum(Metric)))
           .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();

    // Rótulo de agrupamento: nome do catálogo quando o id casa; senão o texto cru
    // aparado; vazio vira "—". Usado para consolidar barras equivalentes.
    private static string DisplayKey(string? id, Func<string, string> name)
    {
        var raw = (id ?? "").Trim();
        return raw == "" ? "—" : name(raw).Trim();
    }

    private static string CommName(string code) => CommercialCategory.Name(code);

    // ---- Chaves por dimensão (nome resolvido) — usadas no agrupamento E no filtro,
    // garantindo que o valor clicado no gráfico bata exatamente com Filtered(). ----
    private string KeyMarket(Opportunity o)   => DisplayKey(o.MarketId, Cat.MarketName);
    private string KeyCountry(Opportunity o)  => DisplayKey(o.CountryId, Cat.CountryName);
    private string KeyProduct(Opportunity o)  => DisplayKey(o.ProductId, Cat.ProductName);
    private string KeyCustomer(Opportunity o) => DisplayKey(o.CustomerId, Cat.CustomerName);
    private string KeyBu(Opportunity o)       => NormBu(DisplayKey(o.PvBusinessUnitId, Cat.BuCode));
    private string KeyKam(Opportunity o)      => OpportunityImporter.CanonicalVendedor(DisplayKey(o.KamId, Cat.KamName));
    private static string KeyCommercial(Opportunity o) => string.IsNullOrWhiteSpace(o.CommercialCategory) ? "—" : o.CommercialCategory.Trim();

    // Une variações da mesma unidade ("HSA: Howden South America" e "HSA") pelo
    // código (parte antes do ":"), para não virarem fatias separadas no gráfico.
    private static string NormBu(string label)
    {
        if (string.IsNullOrWhiteSpace(label)) return "—";
        var i = label.IndexOf(':');
        var code = (i >= 0 ? label.Substring(0, i) : label).Trim();
        return code == "" ? label.Trim() : code;
    }

    // Setor de origem: Aftermarket (id "afm-" ou Setor="AFM") vs. New Business.
    private static string KeySetor(Opportunity o) =>
        string.Equals(o.Setor, "AFM", StringComparison.OrdinalIgnoreCase)
        || o.Id.StartsWith("afm-", StringComparison.OrdinalIgnoreCase)
            ? "Aftermarket" : "New Business";
    private static string KeyStage(Opportunity o)
    {
        // Ofertas de Aftermarket têm a etapa alocada na etapa equivalente do nosso
        // funil (NB) — aplicado também aqui para valer mesmo em dados já importados.
        // Detecta AFM pelo Setor OU pelo id "afm-" (dados antigos ficaram sem Setor).
        var isAfm = string.Equals(o.Setor, "AFM", StringComparison.OrdinalIgnoreCase)
                 || o.Id.StartsWith("afm-", StringComparison.OrdinalIgnoreCase);
        var stage = isAfm ? OpportunityImporter.MapAfmStage(o.Stage, o.StatusDescription) : o.Stage;
        return string.IsNullOrWhiteSpace(stage) ? "—" : stage.Trim();
    }
    private static string KeySegment(Opportunity o) => string.IsNullOrWhiteSpace(o.CommercialSegment) ? "—" : o.CommercialSegment.Trim();
    private string KeySubMarket(Opportunity o) => DisplayKey(o.SubMarketId, Cat.SubMarketName);

    // Valor em R$ nativo (Amount converted) para os gráficos do funil.
    private List<SliceRow> GroupBrl(IEnumerable<Opportunity> src, Func<Opportunity, string> key) =>
        src.GroupBy(key, StringComparer.OrdinalIgnoreCase)
           .Select(g => new SliceRow(g.Key, g.Sum(o => o.AmountBrl)))
           .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();

    private static bool Eq(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    // Campo marcado como "Sim" (ex.: TOP 10 preenchido pelo KAM).
    private static bool Sim(string? s) => string.Equals((s ?? "").Trim(), "Sim", StringComparison.OrdinalIgnoreCase);

    // Cross-filter: alterna o filtro da dimensão (clicar de novo no mesmo valor limpa).
    private void CrossFilter(string dim, string? val)
    {
        var v = (val ?? "").Trim();
        if (v == "" || v == "—") return;
        string Tog(string cur) => Eq(cur, v) ? "" : v;
        // Nos filtros multi-seleção, o clique alterna o valor dentro do conjunto.
        static void TogSet(HashSet<string> set, string val) { if (!set.Remove(val)) set.Add(val); }
        switch (dim)
        {
            case "market":     TogSet(_markets, v); break;
            case "country":    TogSet(_countries, v); break;
            case "product":    TogSet(_products, v); break;
            case "customer":   TogSet(_customers, v); break;
            case "bu":         TogSet(_bus, v); break;
            case "commercial": _commercial = Tog(_commercial); break;
            case "stage":      _stage = Tog(_stage); break;
            case "segment":    _segment = Tog(_segment); break;
            case "submarket":  _submarket = Tog(_submarket); break;
            case "month":      if (int.TryParse(v, out var mm) && mm is >= 1 and <= 12) TogSet(_months, Fmt.MonthLong(mm)); break;
            case "kam":        TogSet(_kams, v); break;
        }
    }

    // Marca visualmente o elemento ativo no cross-filter.
    private bool IsActive(string dim, string val) => dim switch
    {
        "market" => _markets.Contains(val),
        "country" => _countries.Contains(val),
        "product" => _products.Contains(val),
        "customer" => _customers.Contains(val),
        "bu" => _bus.Contains(val),
        "commercial" => Eq(_commercial, val),
        "stage" => Eq(_stage, val),
        "segment" => Eq(_segment, val),
        "submarket" => Eq(_submarket, val),
        "month" => int.TryParse(val, out var mm) && mm is >= 1 and <= 12 && _months.Contains(Fmt.MonthLong(mm)),
        "kam" => _kams.Contains(val),
        _ => false,
    };
    // Classe utilitária p/ marcar o elemento clicável e o estado ativo.
    private string XfCss(string dim, string val) => "xf" + (IsActive(dim, val) ? " xf-on" : "");

    // Há algum filtro ativo nessa dimensão? (para desaturar os não-selecionados)
    private bool DimActive(string dim) => dim switch
    {
        "market" => _markets.Count > 0,
        "product" => _products.Count > 0,
        "kam" => _kams.Count > 0,
        "segment" => _segment != "",
        "bu" => _bus.Count > 0,
        "submarket" => _submarket != "",
        "stage" => _stage != "",
        _ => false,
    };

    // Tonalidade da barra do funil: teal escuro no topo → teal médio na base
    // (variação MUITO sutil, sempre dentro da identidade — não é cor por stage).
    private static int Lerp(int a, int b, double t) => (int)Math.Round(a + (b - a) * t);
    // Ordem canônica das etapas do pipeline (sequência do funil, não por valor).
    private static readonly string[] StageOrder =
    {
        "Qualification", "Arrived at Agreement on Need", "Proposal Pending/Waiting",
        "Outstanding Quote--No Formal Negotiation", "Negotiation Phase/Review",
        "Verbal Commitment", "Letter of Intent", "T&C's stage", "E1 Order Entry",
    };
    private static int StageRank(string s)
    {
        var t = (s ?? "").Trim();
        for (var i = 0; i < StageOrder.Length; i++)
            if (string.Equals(StageOrder[i], t, StringComparison.OrdinalIgnoreCase)) return i;
        return 999;
    }

    private static int Darker(int c) => (int)Math.Round(c * 0.84);

    // Gradiente do funil por POSIÇÃO: topo azul-royal → base azul-marinho profundo.
    // Look coeso e premium (fluxo contínuo); o valor de cada etapa fica no rótulo.
    private static string FunnelBar(int i, int n)
    {
        double t = n <= 1 ? 0 : (double)i / (n - 1);
        // #2f74e0 (royal) → #071d40 (marinho profundo).
        int r = Lerp(0x2f, 0x07, t), g = Lerp(0x74, 0x1d, t), b = Lerp(0xe0, 0x40, t);
        var top = $"#{r:x2}{g:x2}{b:x2}";
        var bot = $"#{Darker(r):x2}{Darker(g):x2}{Darker(b):x2}";
        return $"linear-gradient(180deg,{top} 0%,{bot} 100%)";
    }

    // Paleta escura o bastante para texto branco em todas as faixas.
    private static bool FunnelDark(int i, int n) => false;

    // Largura da faixa do funil por POSIÇÃO (não pelo valor): estreita de forma
    // uniforme do topo à base, sempre afunilando — geometria limpa e simétrica.
    // O valor de cada etapa é lido no rótulo, não na largura.
    private static double FnW(int i, int n) => n <= 1 ? 90 : 96 - (96 - 46) * i / (double)(n - 1);

    // Largura da faixa do funil (% do maior valor), com mínimo p/ legibilidade.
    private string FunnelWidth(double v) =>
        Math.Max(_funnelMax > 0 ? v / _funnelMax * 100 : 0, 14).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    // Gradiente do funil: tons da marca, do mais forte (topo) ao mais claro.
    private static readonly string[] FunnelColors =
        { "#0b4f6f", "#0a6285", "#007A9E", "#1092b0", "#2aa5c0", "#5bb0c9", "#86c4d8", "#aed7e5" };
    private static string FunnelColor(int i) => FunnelColors[Math.Min(i, FunnelColors.Length - 1)];

