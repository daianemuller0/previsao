@page "/executivo"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject ControleRepository ControleRepo
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@{ Build(); }

@* ===================== 1 · CABEÇALHO EXECUTIVO ===================== *@
<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span>Previsão de Vendas</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Visão Executiva</span></div>

<div class="page-head">
    <div>
        <h1>Previsão de Vendas</h1>
        <p class="subtitle">
            @Fmt.MonthLong(_month) de @_year · @(_quarter)º trimestre · Howden Brasil · @_currency<br />
            Última consolidação @_updated.ToString("dd/MM/yyyy 'às' HH:mm")
            &nbsp;·&nbsp; <span class="badge @DqCss">Qualidade dos dados @_dq%</span>
            &nbsp; <span class="badge @ConfCss">Confiança da previsão @_confidence%</span>
        </p>
    </div>
    <div class="page-actions">
        <div class="segmented" style="margin-right:2px">
            <button class="@(_currency == "USD" ? "active" : "")" @onclick='() => _currency = "USD"'>USD</button>
            <button class="@(_currency == "BRL" ? "active" : "")" @onclick='() => _currency = "BRL"'>BRL</button>
        </div>
        <a class="btn-ghost" href="/forecast/export" target="_blank" title="Exportar CSV">@Icons.Svg("download")Exportar</a>
        <a class="btn-primary" href="/oportunidades">@Icons.Svg("opportunity")Abrir Oportunidades</a>
    </div>
</div>

@* ---- Filtros globais ---- *@
<div class="filterbar filterbar-sticky">
    <div class="flt"><span class="flt-label">Ano</span><select><option>@_year</option></select></div>
    <div class="flt"><span class="flt-label">Mês</span><select @bind="_monthFilter"><option value="0">Todos</option>@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select></div>
    <div class="flt"><span class="flt-label">De</span><input class="flt-date" type="date" @bind="_dateFrom" /></div>
    <div class="flt"><span class="flt-label">Até</span><input class="flt-date" type="date" @bind="_dateTo" /></div>
    <div class="flt"><span class="flt-label">Mercado</span><select @bind="_market"><option value="">Todos</option>@foreach (var nm in MarketOptions){<option value="@nm">@nm</option>}</select></div>
    <div class="flt flt-multi">
        <span class="flt-label">Vendedor</span>
        <button type="button" class="flt-multi-btn" @onclick="() => _kamOpen = !_kamOpen">
            @(_kams.Count == 0 ? "Todos" : _kams.Count + " selec.")<span class="flt-caret">▾</span>
        </button>
        @if (_kamOpen)
        {
            <div class="flt-multi-panel">
                <div class="flt-multi-head">
                    <span>@(_kams.Count) selecionado(s)</span>
                    @if (_kams.Count > 0) { <button class="btn-link" @onclick="() => _kams.Clear()">Limpar</button> }
                    <button class="btn-link" @onclick="() => _kamOpen = false">Fechar</button>
                </div>
                @foreach (var nm in KamOptions)
                {
                    var kid = nm;
                    <label class="flt-check"><input type="checkbox" checked="@_kams.Contains(kid)" @onchange="() => ToggleKam(kid)" /> <span>@kid</span></label>
                }
                @if (!KamOptions.Any()) { <div class="flt-multi-empty">Nenhum vendedor nos dados.</div> }
            </div>
        }
    </div>
    <div class="flt"><span class="flt-label">Categoria</span><select @bind="_catFilter"><option value="">Todas</option>@foreach (var c in Enum.GetValues<ForecastCategory>()){<option value="@c.ToString()">@ForecastCategories.Label(c)</option>}</select></div>
    @if (_showMore)
    {
        <div class="flt"><span class="flt-label">País</span><select @bind="_country"><option value="">Todos</option>@foreach (var nm in CountryOptions){<option value="@nm">@nm</option>}</select></div>
        <div class="flt"><span class="flt-label">Produto</span><select @bind="_product"><option value="">Todos</option>@foreach (var nm in ProductOptions){<option value="@nm">@nm</option>}</select></div>
        <div class="flt"><span class="flt-label">Cliente</span><select @bind="_customer"><option value="">Todos</option>@foreach (var nm in CustomerOptions){<option value="@nm">@nm</option>}</select></div>
        <div class="flt"><span class="flt-label">Unidade de negócio</span><select @bind="_bu"><option value="">Todas</option>@foreach (var nm in BuOptions){<option value="@nm">@nm</option>}</select></div>
        <div class="flt"><span class="flt-label">Filtrar por</span><select @bind="_valMetric"><option value="total">Valor total</option><option value="conv">Chance de conversão</option></select></div>
        <div class="flt"><span class="flt-label">Mínimo R$</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="0" @bind="_valMin" /></div>
        <div class="flt"><span class="flt-label">Máximo R$</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="—" @bind="_valMax" /></div>
    }
    <button class="btn-link" @onclick="() => _showMore = !_showMore">@(_showMore ? "Menos filtros" : "Mais filtros")</button>
    <div class="filterbar-spacer"></div>
    <div class="fb-summary">
        <div class="fb-sum"><span class="fb-sum-k">Vendido@(_monthFilter is >= 1 and <= 12 ? " · " + Fmt.MonthName(_monthFilter) : "")</span><span class="fb-sum-v pos">@MoneyBrl(_heroReal)</span></div>
        <div class="fb-sum"><span class="fb-sum-k">Previsão</span><span class="fb-sum-v">@Money(_fcYear)</span></div>
    </div>
    @if (_activeFilters > 0)
    {
        <span class="tag">@_activeFilters ativo(s)</span>
        <button class="btn-link" @onclick="ClearFilters">Limpar</button>
    }
    <button class="btn-link" @onclick="SaveView">Salvar visualização</button>
    @if (_savedMsg) { <span class="saved-flag">@Icons.Svg("check")Salvo</span> }
</div>

@* ===================== EXECUTIVE OVERVIEW (KPIs) ===================== *@
@{
    var _fcBrl = _fcYear * Rate;   // sempre em R$ (Amount converted), independe do toggle
    var _fcAtt = _metaYear > 0 ? _fcBrl / _metaYear * 100 : 0;
    var _wonAtt = _heroMeta > 0 ? _heroReal / _heroMeta * 100 : 0;
    var _gapTgt = Math.Max(_metaYear - _fcBrl, 0);
    var _gmPp = _gmAvg - 30.0;
}
<div class="xsec lvl1">
    <span class="xsec-t">Executive Overview</span>
    <span class="xsec-s">how are we performing · @_year · @_currency</span>
    <span class="xsec-line"></span>
</div>
<div class="kpi-row">
    <div class="kpi">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("trend")</span><span class="kpi-label">Forecast</span></div>
        <div class="kpi-value">@Money(_fcYear)</div>
        <div class="kpi-delta @(_fcAtt >= 100 ? "pos" : "neutral")"><span class="arw">@(_fcAtt >= 100 ? "▲" : "•")</span> @Fmt.Pct(_fcAtt) <span class="ctx">of target</span></div>
        <div class="kpi-spark"><Sparkline Values="@_monthAmt" Stroke="#17a2c0" /></div>
    </div>
    <div class="kpi accent-pos">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("check")</span><span class="kpi-label">Won / Booked</span></div>
        <div class="kpi-value">@MoneyBrl(_heroReal)</div>
        <div class="kpi-delta @(_wonAtt >= 100 ? "pos" : "neutral")"><span class="arw">@(_wonAtt >= 100 ? "▲" : "•")</span> @Fmt.Pct(_wonAtt) <span class="ctx">of target</span></div>
        <div class="kpi-spark"><Sparkline Values="@_mReal" Stroke="#1f9254" /></div>
    </div>
    <div class="kpi accent-warn">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("target")</span><span class="kpi-label">Gap vs Target</span></div>
        <div class="kpi-value">@MoneyBrl(_gapTgt)</div>
        <div class="kpi-delta warn"><span class="ctx">target @MoneyBrl(_metaYear)</span></div>
        <div class="kpi-bar"><i style="width:@Share(_fcBrl, Math.Max(_metaYear, 1))%"></i></div>
    </div>
    <div class="kpi @(_gmAvg >= 30 ? "accent-pos" : "accent-warn")">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("executive")</span><span class="kpi-label">Gross Margin</span></div>
        <div class="kpi-value">@Fmt.Pct(_gmAvg)</div>
        <div class="kpi-delta @(_gmPp >= 0 ? "pos" : "warn")"><span class="arw">@(_gmPp >= 0 ? "▲" : "▼")</span> @Math.Abs(_gmPp).ToString("0.0", _pt) pp <span class="ctx">vs 30% target</span></div>
        <div class="kpi-bar"><i style="width:@Share(_gmAvg, 40)%"></i></div>
    </div>
    <div class="kpi">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("layers")</span><span class="kpi-label">Pipeline Coverage</span></div>
        <div class="kpi-value">@_coverage.ToString("0.0", _pt)x</div>
        <div class="kpi-delta @(_coverage >= 1 ? "pos" : "neg")"><span class="arw">@(_coverage >= 1 ? "▲" : "▼")</span> <span class="ctx">weighted pipeline vs remaining target</span></div>
        <div class="kpi-bar"><i style="width:@Share(Math.Min(_coverage, 2), 2)%"></i></div>
    </div>
</div>

@* ===================== 2 · HERO EXECUTIVO ===================== *@
<div class="hero">
    <div class="hero-main">
        <div class="hero-eyebrow">Realizado × Meta · REPORT HSA · @(_monthFilter is >= 1 and <= 12 ? Fmt.MonthLong(_monthFilter) + " " + _repYear : "Ano " + _repYear)</div>
        <div class="hero-value"><span class="cur">@_sym</span>@Fmt.Compact(CvBrl(_heroReal))</div>
        <div class="hero-target-line">
            Meta NB+AFM @MoneyBrl(_heroMeta) · @Fmt.Pct(_heroAttain) da meta · gap @MoneyBrl(Math.Max(_heroMeta - _heroReal, 0))<br />
            Meta Vendas HSA @MoneyBrl(_heroMetaHsa) · @Fmt.Pct(_heroAttainHsa) da meta · gap @MoneyBrl(Math.Max(_heroMetaHsa - _heroReal, 0))
        </div>
        <div class="hero-chips">
            <div class="hero-chip"><div class="k">Meta NB+AFM</div><div class="v">@MoneyBrl(_heroMeta)</div></div>
            <div class="hero-chip"><div class="k">Meta Vendas HSA</div><div class="v">@MoneyBrl(_heroMetaHsa)</div></div>
            <div class="hero-chip"><div class="k">Realizado</div><div class="v">@MoneyBrl(_heroReal)</div></div>
        </div>
        <div class="hero-gauge">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttain)%"></div></div>
            <div class="gl"><span>Atingimento · Meta NB+AFM</span><span>@Fmt.Pct(_heroAttain)</span></div>
        </div>
        <div class="hero-gauge" style="margin-top:8px">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttainHsa)%"></div></div>
            <div class="gl"><span>Atingimento · Meta Vendas HSA</span><span>@Fmt.Pct(_heroAttainHsa)</span></div>
        </div>
    </div>
</div>

@* ---- Vendas x Meta (NB+AFM) · fonte: Controle · REPORT HSA ---- *@
<div class="panel" style="margin-top:16px">
    <div class="panel-head">
        <div class="panel-title">Vendas x Meta · NB+AFM
            <span class="hint">realizado x budget mensal · fonte: Controle · REPORT HSA · R$ · @_repYear</span>
        </div>
        <div class="rep-attain-group">
            <div class="rep-attain-box">
                <span class="ra-label">Atend. Meta NB+AFM (ano)</span>
                <span class="ra-value" style="color:@AtColor(_repAttain)">@Fmt.Pct(_repAttain)</span>
            </div>
            <div class="rep-attain-box">
                <span class="ra-label">Atend. Meta Vendas HSA (ano)</span>
                <span class="ra-value" style="color:@AtColor(_repAttainHsa)">@Fmt.Pct(_repAttainHsa)</span>
            </div>
        </div>
    </div>
    @if (_repReal.Any(v => v > 0) || _repMeta.Any(v => v > 0) || _repMetaHsa.Any(v => v > 0))
    {
        <div class="chart-body">@RenderReportLine()</div>
    }
    else
    {
        <div class="empty">Sem dados no Controle (REPORT HSA) para @_repYear. Preencha os valores na guia <a href="/controle">Controle</a>.</div>
    }
</div>

@* ===================== SALES FUNNEL BY STAGE (pipeline horizontal) ===================== *@
<div class="xsec">
    <span class="xsec-t">Sales Funnel by Stage</span>
    <span class="xsec-s">how the pipeline concentrates · @_currency</span>
    <span class="xsec-line"></span>
    @if (_stage != "") { <button class="btn-link" @onclick='() => CrossFilter("stage", _stage)'>Limpar Stage</button> }
</div>
<div class="xcard pf-card">
    @if (_funnel.Count == 0)
    {
        <div class="empty">Sem dados no recorte. Importe a base do Funil de Vendas HSA na guia <a href="/oportunidades">Oportunidades</a>.</div>
    }
    else
    {
        var _fnOpps = _funnel.Sum(x => x.Count);
        var _fnTop2 = _funnel.Count >= 2 ? _funnel.Take(2).Sum(x => x.Value) / _funnelTotal * 100 : 100;
        <div class="pf-head">
            <div>
                <div class="xcard-title">Sales Funnel by Stage</div>
                <div class="xcard-sub">Amount · @_currency · @_funnel.Count stages · maior → menor</div>
            </div>
            <div class="pf-totals">
                <div class="pf-tot"><div class="pf-tot-l">Total Pipeline</div><div class="pf-tot-v">@MoneyBrl(_funnelTotal)</div></div>
                <div class="pf-tot"><div class="pf-tot-l">Total Opportunities</div><div class="pf-tot-v">@_fnOpps</div></div>
            </div>
        </div>
        <div class="pf-insight">@Icons.Svg("trend")<span><strong>@Fmt.Pct(_fnTop2)</strong> of pipeline value is concentrated in the first @(_funnel.Count >= 2 ? "two stages" : "stage").</span></div>
        <div class="fn @(DimActive("stage") ? "has-active" : "")">
            @for (var i = 0; i < _funnel.Count; i++)
            {
                var f = _funnel[i];
                var sh = f.Value / _funnelTotal * 100;
                var conv = i < _funnel.Count - 1 && f.Value > 0 ? _funnel[i + 1].Value / f.Value * 100 : (double?)null;
                // Largura de EXIBIÇÃO com correção estética: piso de 44% para as
                // etapas pequenas não virarem agulhas (mantém a ordem/relação).
                var dw = 44 + 56 * (f.Value / _funnelMax);
                var dwN = i < _funnel.Count - 1 ? 44 + 56 * (_funnel[i + 1].Value / _funnelMax) : dw * 0.84;
                var frac = Math.Clamp(dwN / dw, 0.55, 1.0);
                var inset = (1 - frac) / 2 * 100;
                <div class="fn-stage @(IsActive("stage", f.Stage) ? "xf-on" : "")" @onclick='() => CrossFilter("stage", f.Stage)' title="@f.Stage — @MoneyBrl(f.Value) · @Fmt.Pct(sh) of pipeline · @f.Count opportunities@(conv is { } cv ? " · " + Fmt.Pct(cv) + " to next" : "")">
                    <div class="fn-seg" style="width:@F(dw)%">
                        <div class="fn-shape" style="clip-path:polygon(0 0, 100% 0, @F(100 - inset)% 100%, @F(inset)% 100%);background:@FunnelBar(i, _funnel.Count)"></div>
                        <div class="fn-text">
                            <div class="fn-name">@f.Stage</div>
                            <div class="fn-metrics">@MoneyBrl(f.Value) · @Fmt.Pct(sh) · @f.Count opps</div>
                        </div>
                    </div>
                </div>
                @if (conv is { } c)
                {
                    <div class="fn-conv">↓ <b>@Fmt.Pct(c)</b> conversion</div>
                }
            }
        </div>
    }
</div>

@* ===================== REVENUE DISTRIBUTION & PERFORMANCE ===================== *@
@{
    var _segTot = Math.Max(_bySegment.Sum(x => x.Value), 1);
    var _repTot = Math.Max(_byRep.Sum(x => x.Value), 1);
    var _repMax = _byRep.Count > 0 ? _byRep.Max(x => x.Value) : 1;
    var _buTot = Math.Max(_byBu2.Sum(x => x.Value), 1);
    var _smMax = _bySubMarket.Count > 0 ? _bySubMarket.Max(x => x.Value) : 1;
}
<div class="xsec">
    <span class="xsec-t">Revenue Distribution &amp; Performance</span>
    <span class="xsec-s">where is the revenue coming from · who is driving it · @_currency</span>
    <span class="xsec-line"></span>
    <span class="xsec-s">click any element to filter</span>
</div>
<div id="xf-charts">
    <div class="g12">
        @* ---- Commercial Segment (donut + lista) ---- *@
        <div class="c6"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Commercial Segment</div><div class="xcard-sub">@_bySegment.Count segmentos · participação</div></div></div>
            @if (_bySegment.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="seg-wrap">
                    <div class="seg-donut">
                        @RenderDonutRing(_bySegment, "segment")
                        <div class="seg-center"><div><div class="lab">Total</div><div class="val">@MoneyBrl(_bySegment.Sum(x => x.Value))</div></div></div>
                    </div>
                    <div class="seg-list scroll-y" style="max-height:230px">
                        @{ var si = 0; }
                        @foreach (var s in _bySegment)
                        {
                            var c = SegColors[si++ % SegColors.Length];
                            <div class="seg-row @(IsActive("segment", s.Label) ? "xf-on" : "")" @onclick='() => CrossFilter("segment", s.Label)' title="@s.Label">
                                <span class="seg-dot" style="background:@c"></span>
                                <span class="seg-name">@s.Label</span>
                                <span class="seg-val">@MoneyBrl(s.Value)</span>
                                <span class="seg-share">@Fmt.Pct(s.Value / _segTot * 100)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div></div>

        @* ---- Forecast by Market (ranking) ---- *@
        <div class="c6"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("bar-chart")</span><div><div class="xcard-title">Forecast by Market</div><div class="xcard-sub">@_byMarket.Count mercados · maior → menor</div></div></div>
            @if (_byMarket.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="ibar @(DimActive("market") ? "has-active" : "") scroll-y" style="max-height:340px">
                    @foreach (var m in _byMarket)
                    {
                        var sh = m.Value / _marketTotal * 100;
                        <div class="ibar-item @(IsActive("market", m.Name) ? "xf-on" : "")" @onclick='() => CrossFilter("market", m.Name)' title="@m.Name — Forecast @Money(m.Value) · Share @Fmt.Pct(sh)">
                            <div class="ibar-head">
                                <span class="ibar-name">@m.Name</span>
                                <span class="ibar-metrics"><span class="ibar-val">@Money(m.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(m.Value, _maxMarket)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    @* ---- Sales Rep Performance (barras interativas, todos, scroll) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c12"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("opportunity")</span><div><div class="xcard-title">Sales Rep Performance</div><div class="xcard-sub">@_byRep.Count vendedores · todos exibidos · maior → menor</div></div></div>
            @if (_byRep.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="ibar @(DimActive("kam") ? "has-active" : "") scroll-y" style="max-height:460px">
                    @{ var ri = 0; }
                    @foreach (var s in _byRep)
                    {
                        ri++;
                        var sh = s.Value / _repTot * 100;
                        <div class="ibar-item @(ri <= 3 ? $"top{ri}" : "") @(IsActive("kam", s.Label) ? "xf-on" : "")" @onclick='() => CrossFilter("kam", s.Label)' title="#@ri @s.Label — Forecast @MoneyBrl(s.Value) · Share @Fmt.Pct(sh)">
                            <div class="ibar-head">
                                <span class="ibar-num">@ri</span>
                                <span class="ibar-name">@s.Label</span>
                                <span class="ibar-metrics"><span class="ibar-val">@MoneyBrl(s.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(s.Value, _repMax)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    @* ---- Forecast by Product (ranking + GM) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c12"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("layers")</span><div><div class="xcard-title">Forecast by Product</div><div class="xcard-sub">@_byProduct.Count produtos · Gross Margin em destaque</div></div></div>
            @if (_byProduct.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="ibar @(DimActive("product") ? "has-active" : "") scroll-y" style="max-height:400px">
                    @foreach (var p in _byProduct)
                    {
                        var gmCls = p.Margin >= 28 ? "hi" : (p.Margin <= 18 ? "lo" : "");
                        var sh = p.Value / _productTotal * 100;
                        <div class="ibar-item @(IsActive("product", p.Name) ? "xf-on" : "")" @onclick='() => CrossFilter("product", p.Name)' title="@p.Name — Forecast @Money(p.Value) · Share @Fmt.Pct(sh) · GM @Fmt.Pct(p.Margin)">
                            <div class="ibar-head">
                                <span class="ibar-name">@p.Name</span>
                                <span class="ibar-metrics"><span class="ibar-val">@Money(p.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span><span class="gm-pill @gmCls">GM @Fmt.Pct(p.Margin)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(p.Value, _maxProduct)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    @* ===================== DETAIL (nível 3) ===================== *@
    <div class="xsec lvl3">
        <span class="xsec-t">Detail</span>
        <span class="xsec-s">sub-markets · business units · timing</span>
        <span class="xsec-line"></span>
    </div>
    <div class="g12">
        @* ---- Sub-Market Performance (lollipop) ---- *@
        <div class="c6"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("trend")</span><div><div class="xcard-title">Sub-Market Performance</div><div class="xcard-sub">@_bySubMarket.Count sub-markets · todos exibidos</div></div></div>
            @if (_bySubMarket.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="lolli scroll-y" style="max-height:380px">
                    @foreach (var s in _bySubMarket)
                    {
                        <div class="lolli-row @(IsActive("submarket", s.Label) ? "xf-on" : "")" @onclick='() => CrossFilter("submarket", s.Label)' title="@s.Label">
                            <span class="lolli-name">@s.Label</span>
                            <span class="lolli-track"><span class="lolli-line" style="width:calc(@Share(s.Value, _smMax)% - 12px)"></span><span class="lolli-dot"></span></span>
                            <span class="lolli-val">@MoneyBrl(s.Value)</span>
                        </div>
                    }
                </div>
            }
        </div></div>

        @* ---- Business Unit Performance (donut + lista) ---- *@
        <div class="c6"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">Business Unit Performance</div><div class="xcard-sub">@_byBu2.Count unidades · participação</div></div></div>
            @if (_byBu2.Count == 0) { <div class="empty">Sem dados no recorte.</div> }
            else
            {
                <div class="seg-wrap">
                    <div class="seg-donut">
                        @RenderDonutRing(_byBu2, "bu")
                        <div class="seg-center"><div><div class="lab">Total</div><div class="val">@MoneyBrl(_byBu2.Sum(x => x.Value))</div></div></div>
                    </div>
                    <div class="seg-list scroll-y" style="max-height:230px">
                        @{ var bi = 0; }
                        @foreach (var b in _byBu2)
                        {
                            var c = SegColors[bi++ % SegColors.Length];
                            <div class="seg-row @(IsActive("bu", b.Label) ? "xf-on" : "")" @onclick='() => CrossFilter("bu", b.Label)' title="@b.Label">
                                <span class="seg-dot" style="background:@c"></span>
                                <span class="seg-name">@b.Label</span>
                                <span class="seg-val">@MoneyBrl(b.Value)</span>
                                <span class="seg-share">@Fmt.Pct(b.Value / _buTot * 100)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div></div>
    </div>

    @* ---- Forecast by Month (timing) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c12"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("trend")</span><div><div class="xcard-title">Forecast by Month</div><div class="xcard-sub">Close Date · clique num mês para filtrar</div></div></div>
            <div class="chart-body">@RenderXfColumns(_monthAmt)</div>
        </div></div>
    </div>
</div>

@* ===================== EXECUTIVE INSIGHTS ===================== *@
<div class="xsec">
    <span class="xsec-t">Executive Insights</span>
    <span class="xsec-s">calculado a partir dos dados reais do recorte</span>
    <span class="xsec-line"></span>
</div>
<div class="exi-grid">
    @{
        var _topMkt = _byMarket.Take(2).Select(m => m.Name).ToList();
        var _mktTxt = _topMkt.Count > 0 ? string.Join(" & ", _topMkt) : "—";
        var _topSeg = _bySegment.Count > 0 ? _bySegment[0] : null;
    }
    <div class="exi">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("trend")</span><span class="exi-label">Forecast vs Target</span></div>
        <div class="exi-value @(_fcAtt >= 100 ? "pos" : "")">@Fmt.Pct(_fcAtt)</div>
        <div class="exi-text">Previsão de @Money(_fcYear) frente à meta de @MoneyBrl(_metaYear). @_mktTxt lideram a contribuição do forecast.</div>
    </div>
    <div class="exi warn">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("target")</span><span class="exi-label">Gap to Target</span></div>
        <div class="exi-value warn">@MoneyBrl(_gapTgt)</div>
        <div class="exi-text">Distância da meta anual. Priorizar a conversão das maiores oportunidades do pipeline (@_openCount abertas).</div>
    </div>
    <div class="exi @(_gmAvg >= 30 ? "pos" : "warn")">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("executive")</span><span class="exi-label">Gross Margin</span></div>
        <div class="exi-value @(_gmAvg >= 30 ? "pos" : "warn")">@Fmt.Pct(_gmAvg)</div>
        <div class="exi-text">Margem bruta média do recorte (@(_gmPp >= 0 ? "+" : "")@_gmPp.ToString("0.0", _pt) pp vs meta de 30%), sustentada pelo mix de produtos.</div>
    </div>
    <div class="exi @(_coverage >= 1 ? "pos" : "warn")">
        <div class="exi-top"><span class="exi-ico">@Icons.Svg("layers")</span><span class="exi-label">Pipeline Coverage</span></div>
        <div class="exi-value">@_coverage.ToString("0.0", _pt)x</div>
        <div class="exi-text">Pipeline ponderado sobre a meta restante. @(_coverage >= 1 ? "Cobertura suporta a entrega do ano." : "Cobertura abaixo de 1x — reforçar geração de pipeline.")</div>
    </div>
</div>

@* ---- Top 10 oportunidades mais quentes (linha completa) ---- *@
<div class="section-head">
    <span class="st-title">Top 10 oportunidades mais quentes</span>
    <span class="st-sub">confiança + peso do valor · acima de R$ 1 mi</span>
    <span class="st-line"></span>
