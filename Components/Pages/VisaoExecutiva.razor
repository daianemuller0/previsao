@* ===================== 4 · COMPOSIÇÃO E PERFORMANCE ===================== *@
<div class="section-head"><span class="st-title">Composição e desempenho</span><span class="st-line"></span></div>
<div class="g12">
    <div class="c5">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Composição da previsão <span class="hint">por confiança · (% ganho + % período) ÷ 2</span></div></div>
            <div class="comp-bar">
                @foreach (var c in _comp.Where(x => x.Value > 0))
                {
                    <div class="comp-seg" style="width:@Share(c.Value, _compTotal)%;background:@c.Color" title="@c.Band · @Money(c.Value)">@(c.Share >= 16 ? c.Band : "")</div>
                }
            </div>
            <div class="comp-list">
                @foreach (var c in _comp)
                {
                    <div class="comp-row">
                        <span class="comp-dot" style="background:@c.Color"></span>
                        <span><span class="comp-name">@c.Band</span> <span class="comp-sub">· @c.Count op.</span></span>
                        <span class="comp-share">@Fmt.Pct(c.Share)</span>
                        <span class="comp-num">@Money(c.Value)</span>
                        <span class="delta @(c.Trend >= 0 ? "up" : "down")" style="font-size:11px">@Fmt.Signed(c.Trend)</span>
                    </div>
                }
            </div>
            <div class="comp-summary">
                <div class="cs"><div class="cs-l">Pipeline elegível</div><div class="cs-v">@Money(_eligiblePipeline)</div></div>
                <div class="cs"><div class="cs-l">Meta restante</div><div class="cs-v">@Money(_remainingTarget)</div></div>
                <div class="cs"><div class="cs-l">Índice de cobertura</div><div class="cs-v">@_coverageLabel</div></div>
            </div>
        </div>
    </div>
    <div class="c7">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão x Meta por Vendedor</div><a class="btn-link" href="/oportunidades">Ver oportunidades</a></div>
            <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
                <table class="grid-tbl">
                    <thead><tr><th>Vendedor</th><th class="right">Previsão</th><th class="right">Meta</th><th class="right">Gap</th><th class="right">Cobertura</th><th class="center">Status</th></tr></thead>
                    <tbody>
                        @foreach (var k in _byKam)
                        {
                            <tr class="clickable @(IsActive("kam", k.Name) ? "xf-on" : "")" @onclick='() => CrossFilter("kam", k.Name)' title="Filtrar por @k.Name">
                                <td class="col-strong">@k.Name</td>
                                <td class="right num">@Money(k.Forecast)</td>
                                <td class="right num">@Money(k.Target)</td>
                                <td class="right num" style="color:@(k.Gap > 0 ? "var(--neg)" : "var(--pos)")">@Money(k.Gap)</td>
                                <td class="right num">@k.Coverage.ToString("0.0", _pt)x</td>
                                <td class="center"><span class="badge @k.StatusCss">@k.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="g12" style="margin-top:14px">
    <div class="c6"><div class="xcard">
        <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("bar-chart")</span><div><div class="xcard-title">Previsão por mercado</div><div class="xcard-sub">@_byMarket.Count mercados · participação · tendência</div></div></div>
        <div class="ibar @(DimActive("market") ? "has-active" : "") scroll-y" style="max-height:340px">
            @foreach (var m in _byMarket)
            {
                var sh = m.Value / _marketTotal * 100;
                <div class="ibar-item @(IsActive("market", m.Name) ? "xf-on" : "")" @onclick='() => CrossFilter("market", m.Name)' title="@m.Name — Forecast @Money(m.Value) · Share @Fmt.Pct(sh) · Trend @Fmt.Signed(m.Trend)">
                    <div class="ibar-head">
                        <span class="ibar-name">@m.Name</span>
                        <span class="ibar-metrics"><span class="ibar-val">@Money(m.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span><span class="trend-pill @(m.Trend >= 0 ? "pos" : "neg")">@(m.Trend >= 0 ? "▲" : "▼") @Fmt.Pct(Math.Abs(m.Trend))</span></span>
                    </div>
                    <div class="ibar-track"><span class="ibar-fill" style="width:@Share(m.Value, _maxMarket)%"></span></div>
                </div>
            }
        </div>
    </div></div>
    <div class="c6"><div class="xcard">
        <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("layers")</span><div><div class="xcard-title">Previsão por produto</div><div class="xcard-sub">@_byProduct.Count produtos · participação · margem · tendência</div></div></div>
        <div class="ibar @(DimActive("product") ? "has-active" : "") scroll-y" style="max-height:340px">
            @foreach (var p in _byProduct)
            {
                var gmCls = p.Margin >= 28 ? "hi" : (p.Margin <= 18 ? "lo" : "");
                var sh = p.Value / _productTotal * 100;
                <div class="ibar-item @(IsActive("product", p.Name) ? "xf-on" : "")" @onclick='() => CrossFilter("product", p.Name)' title="@p.Name — Forecast @Money(p.Value) · Share @Fmt.Pct(sh) · GM @Fmt.Pct(p.Margin) · Trend @Fmt.Signed(p.Trend)">
                    <div class="ibar-head">
                        <span class="ibar-name">@p.Name</span>
                        <span class="ibar-metrics"><span class="ibar-val">@Money(p.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span><span class="gm-pill @gmCls">GM @Fmt.Pct(p.Margin)</span><span class="trend-pill @(p.Trend >= 0 ? "pos" : "neg")">@(p.Trend >= 0 ? "▲" : "▼") @Fmt.Pct(Math.Abs(p.Trend))</span></span>
                    </div>
                    <div class="ibar-track"><span class="ibar-fill" style="width:@Share(p.Value, _maxProduct)%"></span></div>
                </div>
            }
        </div>
    </div></div>
</div>

@* ---- Comparativo AFM × NB + Previsão mensal ---- *@
<div class="g12" style="margin-top:14px">
    <div class="c5">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Aftermarket × New Business <span class="hint">por categoria comercial</span></div></div>
            @foreach (var cc in _byCommercial)
            {
                var destaque = cc.Code is "AFM" or "NB" ? "strong" : "";
                <div class="bar-row @XfCss("commercial", cc.Code)" @onclick='() => CrossFilter("commercial", cc.Code)' title="Filtrar por @cc.Name">
                    <span class="bar-label @destaque">@cc.Name <span class="muted" style="font-weight:400">· @cc.Code</span></span>
                    <span class="bar-track"><span class="bar-fill @(cc.Code == "AFM" ? "afm" : "c-primary")" style="width:@Share(cc.Value, _maxComm)%"></span></span>
                    <span class="bar-value">@Money(cc.Value)</span>
                </div>
            }
            <div class="muted" style="font-size:11px;margin-top:8px">Comparativo do forecast ponderado por categoria comercial (NB · RT · AFM · SV).</div>
        </div>
