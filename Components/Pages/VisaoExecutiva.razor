    // Combo chart em SVG: barras (realizado + forecast), meta em traço, acumulado/projeção
    // em linha, mês atual destacado, tooltips nativos. Respeita moeda e modo selecionados.
    private RenderFragment RenderComboChart() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 240, top = 12, bot = 210, left = 8, colW = (Wd - left) / 12.0;
        bool cumul = _chartMode == "cumulative";

        double[] real = new double[12], fc = new double[12];
        double rr = 0, ff = 0;
        for (var m = 0; m < 12; m++)
        {
            if (cumul) { rr += _mReal[m]; ff += _mForecast[m]; real[m] = Cv(rr); fc[m] = Cv(ff); }
            else { real[m] = Cv(_mReal[m]); fc[m] = Cv(_mForecast[m]); }
        }
        double[] tgt = new double[12]; double trun = 0;
        for (var m = 0; m < 12; m++) { trun += _mTarget[m]; tgt[m] = cumul ? Cv(trun) : Cv(_mTarget[m]); }

        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, Math.Max(tgt[m], real[m] + fc[m]));
        max *= 1.06;
        double Y(double v) => bot - v / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Previsão x Meta x Realizado'>");
        for (var g = 1; g <= 3; g++) { var gy = top + (bot - top) * g / 4.0; sb.Append($"<line x1='{left}' y1='{gy.ToString("0.#", inv)}' x2='{Wd}' y2='{gy.ToString("0.#", inv)}' stroke='#f0f3f8'/>"); }
        sb.Append($"<line x1='{left}' y1='{bot.ToString(inv)}' x2='{Wd}' y2='{bot.ToString(inv)}' stroke='#e3e9f2'/>");

        // destaque do mês atual
        double hx = left + (_month - 1) * colW;
        sb.Append($"<rect x='{hx.ToString("0.#", inv)}' y='{top.ToString(inv)}' width='{colW.ToString("0.#", inv)}' height='{(bot - top).ToString("0.#", inv)}' fill='#0b4f8a' opacity='0.05'/>");

        var cumPts = new List<string>();
        for (var m = 0; m < 12; m++)
        {
            double cx = left + m * colW + colW / 2;
            double bw = colW * 0.58;
            double realTop = Y(real[m]); double fcTop = Y(real[m] + fc[m]);
            var tip = $"{Fmt.MonthName(m + 1)} · Realizado {_sym} {Fmt.Compact(real[m])} · Previsão {_sym} {Fmt.Compact(fc[m])} · Meta {_sym} {Fmt.Compact(tgt[m])}";
            sb.Append($"<g><title>{tip}</title>");
            if (real[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{realTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(bot - realTop).ToString("0.#", inv)}' fill='#0b4f8a' rx='1.5'/>");
            if (fc[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{fcTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(realTop - fcTop).ToString("0.#", inv)}' fill='#6ba7d6' rx='1.5'/>");
            double ty = Y(tgt[m]);
            sb.Append($"<line x1='{(cx - bw / 2 - 3).ToString("0.#", inv)}' y1='{ty.ToString("0.#", inv)}' x2='{(cx + bw / 2 + 3).ToString("0.#", inv)}' y2='{ty.ToString("0.#", inv)}' stroke='#009496' stroke-width='2.5' stroke-linecap='round'/>");
            sb.Append("</g>");
            cumPts.Add($"{cx.ToString("0.#", inv)},{Y(Cv(_mCumul[m])).ToString("0.#", inv)}");
            var lblColor = (m + 1) == _month ? "#0b4f8a" : "#93a1b5";
            var lblWeight = (m + 1) == _month ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 6).ToString(inv)}' text-anchor='middle' font-size='9' font-weight='{lblWeight}' fill='{lblColor}'>{Fmt.MonthName(m + 1)}</text>");
        }
        // acumulado (linha cheia até o mês atual, pontilhada na projeção futura)
        var past = cumPts.Take(_month).ToList();
        var future = cumPts.Skip(Math.Max(_month - 1, 0)).ToList();
        sb.Append($"<polyline points='{string.Join(' ', past)}' fill='none' stroke='#c0392b' stroke-width='1.7' opacity='0.85'/>");
        sb.Append($"<polyline points='{string.Join(' ', future)}' fill='none' stroke='#c0392b' stroke-width='1.6' stroke-dasharray='3 3' opacity='0.6'/>");
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Gráfico de linha da previsão mensal: linha + área preenchida + rótulos de
    // valor acima de cada ponto e nomes dos meses no eixo. Mês atual destacado.
    // Construído como string SVG (evita o erro RZ1023 de <text> em Razor).
    private RenderFragment RenderMonthlyLine() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 260, top = 34, bot = 214, left = 40, right = 20;
        double plotW = Wd - left - right;
        double colW = plotW / 11.0; // 12 pontos → 11 intervalos

        // Valores por mês (realizado + forecast ponderado), na moeda ativa.
        double[] v = new double[12];
        for (var m = 0; m < 12; m++) v[m] = Cv(_mReal[m] + _mForecast[m]);
        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, v[m]);
        max *= 1.18; // respiro para os rótulos acima dos pontos
        double X(int m) => left + m * colW;
        double Y(double val) => bot - val / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Previsão mensal'>");

        // gradiente da área
        sb.Append("<defs><linearGradient id='mlarea' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append("<stop offset='0%' stop-color='#007A9E' stop-opacity='0.28'/>");
        sb.Append("<stop offset='100%' stop-color='#007A9E' stop-opacity='0.02'/>");
        sb.Append("</linearGradient></defs>");

        // linhas de grade horizontais
        for (var g = 0; g <= 4; g++)
        {
            var gy = top + (bot - top) * g / 4.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
        }

        // destaque do mês atual (faixa vertical)
        double hx = X(_month - 1);
        sb.Append($"<line x1='{hx.ToString("0.#", inv)}' y1='{top.ToString(inv)}' x2='{hx.ToString("0.#", inv)}' y2='{bot.ToString(inv)}' stroke='#007A9E' stroke-width='1' stroke-dasharray='3 3' opacity='0.35'/>");

        // área preenchida
        var line = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++)
            line.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(v[m]).ToString("0.#", inv)}");
        var area = $"{left.ToString(inv)},{bot.ToString(inv)} {line} {(Wd - right).ToString(inv)},{bot.ToString(inv)}";
        sb.Append($"<polygon points='{area}' fill='url(#mlarea)'/>");

        // linha principal
        sb.Append($"<polyline points='{line}' fill='none' stroke='#007A9E' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>");

        // pontos + rótulos de valor + meses
        for (var m = 0; m < 12; m++)
        {
            double cx = X(m), cy = Y(v[m]);
            bool cur = (m + 1) == _month;
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{cy.ToString("0.#", inv)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='#007A9E' stroke-width='{(cur ? "3" : "2")}'/>");
            var lblColor = cur ? "#0b4f6f" : "#5b6b82";
            var lblWeight = cur ? "700" : "500";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(cy - 10).ToString("0.#", inv)}' text-anchor='middle' font-size='9.5' font-weight='{lblWeight}' fill='{lblColor}'>{Fmt.Compact(v[m])}</text>");
            var mColor = cur ? "#007A9E" : "#93a1b5";
            var mWeight = cur ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 8).ToString(inv)}' text-anchor='middle' font-size='9.5' font-weight='{mWeight}' fill='{mColor}'>{Fmt.MonthName(m + 1)}</text>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Gráfico de linhas Vendas x Meta (NB+AFM), puxando o REPORT HSA do Controle.
    // Duas linhas: Realizado (área + linha cheia) e Meta/Budget (linha tracejada).
    // Valores em R$ (moeda nativa do Controle). Construído como string SVG.
    private RenderFragment RenderReportLine() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 760, H = 280, top = 46, bot = 236, left = 46, right = 18;
        double plotW = Wd - left - right, colW = plotW / 11.0;
        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, Math.Max(Math.Max(_repReal[m], _repMeta[m]), _repMetaHsa[m]));
        max *= 1.20;
        double X(int m) => left + m * colW;
        double Y(double val) => bot - val / max * (bot - top);
        const string cReal = "#007A9E", cMeta = "#b7791f", cMhsa = "#1f9254";

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Vendas x Meta NB+AFM'>");

        sb.Append("<defs><linearGradient id='rlarea' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append($"<stop offset='0%' stop-color='{cReal}' stop-opacity='0.24'/><stop offset='100%' stop-color='{cReal}' stop-opacity='0.02'/>");
        sb.Append("</linearGradient></defs>");

        // legenda
        sb.Append($"<line x1='{left.ToString(inv)}' y1='20' x2='{(left + 22).ToString(inv)}' y2='20' stroke='{cReal}' stroke-width='3' stroke-linecap='round'/>");
        sb.Append($"<text x='{(left + 28).ToString(inv)}' y='23.5' font-size='11' font-weight='600' fill='#3b4a61'>Vendas NB+AFM (Realizado)</text>");
        sb.Append($"<line x1='{(left + 205).ToString(inv)}' y1='20' x2='{(left + 227).ToString(inv)}' y2='20' stroke='{cMeta}' stroke-width='3' stroke-dasharray='5 3' stroke-linecap='round'/>");
        sb.Append($"<text x='{(left + 233).ToString(inv)}' y='23.5' font-size='11' font-weight='600' fill='#3b4a61'>Meta NB+AFM (Budget)</text>");
        sb.Append($"<line x1='{(left + 400).ToString(inv)}' y1='20' x2='{(left + 422).ToString(inv)}' y2='20' stroke='{cMhsa}' stroke-width='3' stroke-dasharray='2 3' stroke-linecap='round'/>");
        sb.Append($"<text x='{(left + 428).ToString(inv)}' y='23.5' font-size='11' font-weight='600' fill='#3b4a61'>Meta Vendas HSA</text>");

        // grade + rótulos do eixo Y
        for (var g = 0; g <= 4; g++)
        {
            double gy = top + (bot - top) * g / 4.0, gv = max * (4 - g) / 4.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
            sb.Append($"<text x='{(left - 6).ToString(inv)}' y='{(gy + 3).ToString("0.#", inv)}' text-anchor='end' font-size='8.5' fill='#93a1b5'>{Esc(Fmt.Compact(gv))}</text>");
        }

        // destaque do mês atual
        double hx = X(_month - 1);
        sb.Append($"<line x1='{hx.ToString("0.#", inv)}' y1='{top.ToString(inv)}' x2='{hx.ToString("0.#", inv)}' y2='{bot.ToString(inv)}' stroke='{cReal}' stroke-width='1' stroke-dasharray='3 3' opacity='0.3'/>");

        // linha Realizado (área + linha)
        var lr = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lr.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repReal[m]).ToString("0.#", inv)}");
        sb.Append($"<polygon points='{left.ToString(inv)},{bot.ToString(inv)} {lr} {(Wd - right).ToString(inv)},{bot.ToString(inv)}' fill='url(#rlarea)'/>");
        sb.Append($"<polyline points='{lr}' fill='none' stroke='{cReal}' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>");

        // linha Meta (tracejada)
        var lm = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lm.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repMeta[m]).ToString("0.#", inv)}");
        sb.Append($"<polyline points='{lm}' fill='none' stroke='{cMeta}' stroke-width='2' stroke-dasharray='5 3' stroke-linejoin='round' stroke-linecap='round'/>");

        // linha Meta Vendas HSA (pontilhada)
        var lh = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lh.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repMetaHsa[m]).ToString("0.#", inv)}");
        sb.Append($"<polyline points='{lh}' fill='none' stroke='{cMhsa}' stroke-width='2' stroke-dasharray='2 3' stroke-linejoin='round' stroke-linecap='round'/>");

        // pontos + rótulos + meses
        for (var m = 0; m < 12; m++)
        {
            double cx = X(m), yr = Y(_repReal[m]), ym = Y(_repMeta[m]), yh = Y(_repMetaHsa[m]);
            bool cur = (m + 1) == _month;
            double att = _repMeta[m] > 0 && _repReal[m] > 0 ? _repReal[m] / _repMeta[m] * 100 : 0;
            var tip = $"{Fmt.MonthName(m + 1)} · Realizado R$ {Fmt.Compact(_repReal[m])} · Meta R$ {Fmt.Compact(_repMeta[m])} · Meta HSA R$ {Fmt.Compact(_repMetaHsa[m])}" + (att > 0 ? $" · {Fmt.Pct(att)}" : "");

            if (_repMetaHsa[m] > 0) sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yh.ToString("0.#", inv)}' r='2.5' fill='{cMhsa}'><title>{Esc(tip)}</title></circle>");
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{ym.ToString("0.#", inv)}' r='2.5' fill='{cMeta}'><title>{Esc(tip)}</title></circle>");
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yr.ToString("0.#", inv)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='{cReal}' stroke-width='{(cur ? "3" : "2")}'><title>{Esc(tip)}</title></circle>");
            if (_repReal[m] > 0)
                sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(yr - 9).ToString("0.#", inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "500")}' fill='{(cur ? "#0b4f6f" : "#5b6b82")}'>{Esc(Fmt.Compact(_repReal[m]))}</text>");
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 7).ToString(inv)}' text-anchor='middle' font-size='9.5' font-weight='{(cur ? "700" : "400")}' fill='{(cur ? cReal : "#93a1b5")}'>{Fmt.MonthName(m + 1)}</text>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Nome do país nos dados (PT / variações) -> nome no mapa-múndi (inglês).
    private static readonly Dictionary<string, string> CountryToMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["brasil"] = "Brazil", ["chile"] = "Chile", ["peru"] = "Peru", ["perú"] = "Peru",
        ["argentina"] = "Argentina", ["colombia"] = "Colombia", ["colômbia"] = "Colombia",
        ["bolivia"] = "Bolivia", ["bolívia"] = "Bolivia", ["venezuela"] = "Venezuela",
        ["equador"] = "Ecuador", ["paraguai"] = "Paraguay", ["uruguai"] = "Uruguay",
        ["guiana"] = "Guyana", ["méxico"] = "Mexico", ["mexico"] = "Mexico",
        ["estados unidos"] = "United States of America", ["eua"] = "United States of America",
        ["espanha"] = "Spain", ["alemanha"] = "Germany", ["frança"] = "France", ["itália"] = "Italy",
        ["reino unido"] = "United Kingdom", ["china"] = "China", ["índia"] = "India", ["japão"] = "Japan",
        ["áfrica do sul"] = "South Africa", ["austrália"] = "Australia", ["canadá"] = "Canada",
    };

    // Resolve o rótulo do país dos dados para a chave do mapa (com fallback ao nome em inglês).
    private static string? MapKey(string label)
    {
        var l = label.Trim();
        if (CountryToMap.TryGetValue(l, out var en) && WorldMap.Paths.ContainsKey(en)) return en;
        return WorldMap.Paths.ContainsKey(l) ? l : null;
    }

    // Interpolação de cor (claro -> teal) para o choropleth, t em [0,1].
    private static string Shade(double t)
    {
        t = Math.Clamp(t, 0, 1);
        int r = (int)(238 + (0 - 238) * t), g = (int)(244 + (122 - 244) * t), b = (int)(248 + (158 - 248) * t);
        return $"rgb({r},{g},{b})";
    }

    private const string MapId = "worldmap";

    // Mapa-múndi (choropleth) com fronteiras reais dos países.
    private RenderFragment RenderWorldMap() => builder =>
    {
        // valor por país no nome do mapa (soma variações)
        var byName = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        // nome do mapa (inglês) -> rótulo PT usado no filtro (para o clique cruzado)
        var mapToLabel = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var c in _byCountry)
            if (MapKey(c.Label) is { } key)
            {
                byName[key] = byName.GetValueOrDefault(key) + c.Value;
                mapToLabel[key] = c.Label;
            }
        double maxV = byName.Count > 0 ? byName.Values.Max() : 1;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {F(WorldMap.ViewW)} {F(WorldMap.ViewH)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Distribuição por país'>");
        sb.Append($"<rect x='0' y='0' width='{F(WorldMap.ViewW)}' height='{F(WorldMap.ViewH)}' fill='#f7fafc'/>");
        foreach (var (name, d) in WorldMap.Paths)
        {
            var has = byName.TryGetValue(name, out var v);
            var fill = has ? Shade(maxV > 0 ? v / maxV : 0) : "#e7edf3";
            var label = mapToLabel.TryGetValue(name, out var lb) ? lb : "";
            var active = label != "" && _countries.Contains(label);
            var data = has
                ? $" data-value='{Esc(Money(v))}' data-pct='{Esc(Fmt.Pct(v / Math.Max(_countryTotal, 1) * 100))}' data-metric='{Esc(MetricLabel)}' data-xf-val='{Esc(label)}'"
                : "";
            var cls = "wm-path" + (active ? " wm-active" : "");
            sb.Append($"<path d='{d}' fill='{fill}' stroke='{(active ? "#0b4f6f" : "#cdd8e4")}' stroke-width='{(active ? "1.1" : "0.4")}' data-country='{Esc(name)}'{data} class='{cls}'/>");
        }
        // rótulo de valor no país (centroide gerado) com contraste conforme o tom
        foreach (var kv in byName)
        {
            if (!WorldMap.Centroids.TryGetValue(kv.Key, out var pos)) continue;
            bool dark = (maxV > 0 ? kv.Value / maxV : 0) > 0.5;
            sb.Append($"<text x='{F(pos.X)}' y='{F(pos.Y + 3)}' text-anchor='middle' font-size='9' font-weight='700' fill='{(dark ? "#fff" : "#1e2836")}'>{Esc(Fmt.Compact(Cv(kv.Value)))}</text>");
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Paleta dos gráficos de pizza/rosca.
    private static readonly string[] PieColors =
        { "#1b5fa9", "#14a8a0", "#f2a63c", "#e2664e", "#6c5ce0", "#2fae6b", "#d15fa6", "#3f9bd6", "#a0705a", "#7a8794" };

    private static string Esc(string s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    // Gráfico de rosca (donut) + legenda. Valores em USD, convertidos p/ a moeda ativa.
    private RenderFragment RenderDonut(IReadOnlyList<SliceRow> data) => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double total = Math.Max(data.Sum(d => Cv(d.Value)), 1);
        double cx = 64, cy = 64, r = 51, sw = 15, C = 2 * Math.PI * r;

        var sb = new System.Text.StringBuilder();
        sb.Append("<div class='donut-wrap'>");
        sb.Append("<svg viewBox='0 0 128 128' class='donut-svg' role='img' aria-label='Distribuição'>");
        sb.Append($"<circle cx='{cx}' cy='{cy}' r='{r.ToString(inv)}' fill='none' stroke='#eef2f7' stroke-width='{sw.ToString(inv)}'/>");
        double off = 0;
        for (var i = 0; i < data.Count; i++)
        {
            double val = Cv(data[i].Value);
            if (val <= 0) continue;
            double dash = val / total * C;
            var col = PieColors[i % PieColors.Length];
            sb.Append($"<circle cx='{cx}' cy='{cy}' r='{r.ToString(inv)}' fill='none' stroke='{col}' stroke-width='{sw.ToString(inv)}' stroke-dasharray='{dash.ToString("0.##", inv)} {(C - dash).ToString("0.##", inv)}' stroke-dashoffset='{(-off).ToString("0.##", inv)}' transform='rotate(-90 {cx} {cy})'/>");
            off += dash;
        }
        sb.Append($"<text x='{cx}' y='{(cy - 6).ToString(inv)}' text-anchor='middle' font-size='7.5' letter-spacing='.4' fill='#8a97a8'>TOTAL</text>");
        sb.Append($"<text x='{cx}' y='{(cy + 5).ToString(inv)}' text-anchor='middle' font-size='13.5' font-weight='800' fill='#0f2038'>{Fmt.Compact(total)}</text>");
        sb.Append($"<text x='{cx}' y='{(cy + 15).ToString(inv)}' text-anchor='middle' font-size='7.5' font-weight='700' fill='#5b6b82'>{_sym}</text>");
        sb.Append("</svg>");

        sb.Append("<ul class='donut-legend'>");
        for (var i = 0; i < data.Count; i++)
        {
            double val = Cv(data[i].Value);
            var col = PieColors[i % PieColors.Length];
            sb.Append($"<li><span class='dl-dot' style='background:{col}'></span><span class='dl-name'>{Esc(data[i].Label)}</span><span class='dl-val'>{_sym} {Fmt.Compact(val)}</span><span class='dl-pct'>{Fmt.Pct(val / total * 100)}</span></li>");
        }
        sb.Append("</ul></div>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    private static string Trunc(string s, int n) => string.IsNullOrEmpty(s) ? "" : (s.Length <= n ? s : s.Substring(0, n - 1) + "…");
    private string CompactBrl(double brl) => Fmt.Compact(CvBrl(brl));

    // ---- Gráficos do funil (base nova) · todos com cross-filter (data-xf-*) ----

    // Linha categórica: dimensão no eixo X, valor (R$) no Y. Pontos clicáveis.
    private RenderFragment RenderXfLine(IReadOnlyList<SliceRow> data, string dim, int topN) => builder =>
    {
        var d = (topN > 0 ? data.Take(topN) : data).ToList();
        if (d.Count == 0) { builder.AddMarkupContent(0, "<div class='empty'>Sem dados no recorte.</div>"); return; }
        double W = 720, H = 250, top = 24, bot = 205, left = 20, right = 16;
        double plotW = W - left - right, colW = d.Count > 1 ? plotW / (d.Count - 1) : plotW;
        double max = Math.Max(d.Max(x => CvBrl(x.Value)), 1) * 1.18;
        double X(int i) => left + i * colW; double Y(double v) => bot - v / max * (bot - top);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {F(W)} {F(H)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img'>");
        sb.Append("<defs><linearGradient id='xfarea-" + dim + "' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='#007A9E' stop-opacity='.24'/><stop offset='100%' stop-color='#007A9E' stop-opacity='.02'/></linearGradient></defs>");
        for (var g = 0; g <= 4; g++) { var gy = top + (bot - top) * g / 4.0; sb.Append($"<line x1='{F(left)}' y1='{F(gy)}' x2='{F(W - right)}' y2='{F(gy)}' stroke='#eef2f7'/>"); }
        var line = new System.Text.StringBuilder();
        for (var i = 0; i < d.Count; i++) line.Append($"{(i == 0 ? "" : " ")}{F(X(i))},{F(Y(CvBrl(d[i].Value)))}");
        sb.Append($"<polygon points='{F(left)},{F(bot)} {line} {F(W - right)},{F(bot)}' fill='url(#xfarea-{dim})'/>");
        sb.Append($"<polyline points='{line}' fill='none' stroke='#007A9E' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>");
        for (var i = 0; i < d.Count; i++)
        {
            double cx = X(i), cy = Y(CvBrl(d[i].Value));
            var on = IsActive(dim, d[i].Label);
            sb.Append($"<circle cx='{F(cx)}' cy='{F(cy)}' r='{(on ? "5.5" : "3.5")}' fill='{(on ? "#0b4f6f" : "#fff")}' stroke='#007A9E' stroke-width='2' class='xf-mark' data-xf-dim='{dim}' data-xf-val='{Esc(d[i].Label)}'><title>{Esc(d[i].Label)} · {Esc(MoneyBrl(d[i].Value))}</title></circle>");
            sb.Append($"<text x='{F(cx)}' y='{F(cy - 9)}' text-anchor='middle' font-size='8.5' font-weight='600' fill='#5b6b82'>{Esc(CompactBrl(d[i].Value))}</text>");
            sb.Append($"<text x='{F(cx)}' y='{F(H - 6)}' text-anchor='middle' font-size='8.5' fill='#93a1b5'>{Esc(Trunc(d[i].Label, 11))}</text>");
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Paleta CATEGÓRICA (fatias distinguíveis) — profissional, sem virar arco-íris.
    private static readonly string[] SegColors =
        { "#1b5fa9", "#14a8a0", "#f2a63c", "#e2664e", "#6c5ce0", "#2fae6b", "#d15fa6", "#3f9bd6", "#a0705a", "#7a8794" };

    // Anel do donut (Commercial Segment / Business Unit) — fatias clicáveis.
    private RenderFragment RenderDonutRing(IReadOnlyList<SliceRow> data, string dim) => builder =>
    {
        var d = data.Where(x => x.Value > 0).ToList();
        if (d.Count == 0) { builder.AddMarkupContent(0, "<div class='empty'>Sem dados</div>"); return; }
        double total = Math.Max(d.Sum(x => x.Value), 1);
        double cx = 80, cy = 80, r = 62, sw = 22, C = 2 * Math.PI * r, off = 0;
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox='0 0 160 160' role='img'>");
        sb.Append($"<circle cx='{cx}' cy='{cy}' r='{F(r)}' fill='none' stroke='#eef2f7' stroke-width='{F(sw)}'/>");
        for (var i = 0; i < d.Count; i++)
        {
            double val = d[i].Value, dash = val / total * C; var col = SegColors[i % SegColors.Length];
            var on = IsActive(dim, d[i].Label);
            sb.Append($"<circle cx='{cx}' cy='{cy}' r='{F(r)}' fill='none' stroke='{col}' stroke-width='{F(on ? sw + 3 : sw)}' stroke-dasharray='{F(dash)} {F(C - dash)}' stroke-dashoffset='{F(-off)}' transform='rotate(-90 {cx} {cy})' class='xf-mark' data-xf-dim='{dim}' data-xf-val='{Esc(d[i].Label)}'><title>{Esc(d[i].Label)} · {Esc(MoneyBrl(d[i].Value))}</title></circle>");
            off += dash;
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Colunas por mês (Close Date). Cada coluna é clicável (filtra o mês).
    private RenderFragment RenderXfColumns(double[] m) => builder =>
    {
        if (m.All(v => v <= 0)) { builder.AddMarkupContent(0, "<div class='empty'>Sem dados no recorte.</div>"); return; }
        double W = 720, H = 250, top = 22, bot = 205, left = 14, right = 14;
        double plotW = W - left - right, colW = plotW / 12.0;
        double max = Math.Max(m.Select(CvBrl).Max(), 1) * 1.16;
        double Y(double v) => bot - v / max * (bot - top);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {F(W)} {F(H)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img'>");
        for (var g = 0; g <= 3; g++) { var gy = top + (bot - top) * g / 3.0; sb.Append($"<line x1='{F(left)}' y1='{F(gy)}' x2='{F(W - right)}' y2='{F(gy)}' stroke='#eef2f7'/>"); }
        for (var i = 0; i < 12; i++)
        {
            double v = CvBrl(m[i]), bw = colW * 0.6, cx = left + i * colW + colW / 2, yTop = Y(v);
            var on = _monthFilter == i + 1;
            var col = on ? "#0b4f6f" : "#007A9E";
            sb.Append($"<g class='xf-mark' data-xf-dim='month' data-xf-val='{i + 1}'><title>{Esc(Fmt.MonthName(i + 1))} · {_sym} {Esc(Fmt.Compact(v))}</title>");
            sb.Append($"<rect x='{F(cx - bw / 2)}' y='{F(yTop)}' width='{F(bw)}' height='{F(bot - yTop)}' rx='3' fill='{col}'/></g>");
            if (v > 0) sb.Append($"<text x='{F(cx)}' y='{F(yTop - 5)}' text-anchor='middle' font-size='8.5' font-weight='600' fill='#5b6b82'>{Esc(Fmt.Compact(v))}</text>");
            sb.Append($"<text x='{F(cx)}' y='{F(H - 6)}' text-anchor='middle' font-size='8.5' fill='#93a1b5'>{Esc(Fmt.MonthName(i + 1))}</text>");
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Rosca (pizza) com fatias e legenda clicáveis.
    private RenderFragment RenderXfPie(IReadOnlyList<SliceRow> data, string dim) => builder =>
    {
        var d = data.Where(x => CvBrl(x.Value) > 0).Take(8).ToList();
        if (d.Count == 0) { builder.AddMarkupContent(0, "<div class='empty'>Sem dados no recorte.</div>"); return; }
        double total = Math.Max(d.Sum(x => CvBrl(x.Value)), 1);
        double cx = 64, cy = 64, r = 50, sw = 20, C = 2 * Math.PI * r, off = 0;
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class='donut-wrap'><svg viewBox='0 0 128 128' class='donut-svg' role='img'>");
        sb.Append($"<circle cx='{cx}' cy='{cy}' r='{F(r)}' fill='none' stroke='#eef2f7' stroke-width='{F(sw)}'/>");
        for (var i = 0; i < d.Count; i++)
        {
            double val = CvBrl(d[i].Value), dash = val / total * C;
            var col = PieColors[i % PieColors.Length];
            sb.Append($"<circle cx='{cx}' cy='{cy}' r='{F(r)}' fill='none' stroke='{col}' stroke-width='{F(sw)}' stroke-dasharray='{F(dash)} {F(C - dash)}' stroke-dashoffset='{F(-off)}' transform='rotate(-90 {cx} {cy})' class='xf-mark' data-xf-dim='{dim}' data-xf-val='{Esc(d[i].Label)}'><title>{Esc(d[i].Label)} · {Esc(MoneyBrl(d[i].Value))}</title></circle>");
            off += dash;
        }
        sb.Append($"<text x='{cx}' y='{F(cy - 3)}' text-anchor='middle' font-size='8.5' fill='#93a1b5'>Total</text>");
        sb.Append($"<text x='{cx}' y='{F(cy + 11)}' text-anchor='middle' font-size='12' font-weight='700' fill='#1e2836'>{_sym} {Esc(Fmt.Compact(total))}</text>");
        sb.Append("</svg><ul class='donut-legend'>");
        for (var i = 0; i < d.Count; i++)
        {
            double val = CvBrl(d[i].Value);
            var col = PieColors[i % PieColors.Length];
            var on = IsActive(dim, d[i].Label) ? " xf-on" : "";
            sb.Append($"<li class='xf-mark{on}' data-xf-dim='{dim}' data-xf-val='{Esc(d[i].Label)}'><span class='dl-dot' style='background:{col}'></span><span class='dl-name'>{Esc(d[i].Label)}</span><span class='dl-val'>{_sym} {Esc(Fmt.Compact(val))}</span><span class='dl-pct'>{Esc(Fmt.Pct(val / total * 100))}</span></li>");
        }
        sb.Append("</ul></div>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Barras horizontais clicáveis (participação sobre o total exibido).
    private RenderFragment RenderXfHBars(IReadOnlyList<SliceRow> data, string dim, int topN) => builder =>
    {
        var d = (topN > 0 ? data.Take(topN) : data).ToList();
        if (d.Count == 0) { builder.AddMarkupContent(0, "<div class='empty'>Sem dados no recorte.</div>"); return; }
        double max = Math.Max(d.Max(x => CvBrl(x.Value)), 1), total = Math.Max(d.Sum(x => CvBrl(x.Value)), 1);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < d.Count; i++)
        {
            double v = CvBrl(d[i].Value);
            var on = IsActive(dim, d[i].Label) ? " xf-on" : "";
            var col = PieColors[i % PieColors.Length];
            sb.Append($"<div class='bar-row xf{on}' data-xf-dim='{dim}' data-xf-val='{Esc(d[i].Label)}' title='{Esc(d[i].Label)}'>");
            sb.Append($"<span class='bar-label'>{Esc(d[i].Label)}</span>");
            sb.Append($"<span class='bar-track'><span class='bar-fill' style='width:{F(v / max * 100)}%;background:{col}'></span></span>");
            sb.Append($"<span class='bar-value'>{_sym} {Esc(Fmt.Compact(v))} <span class='muted' style='font-weight:400'>· {Esc(Fmt.Pct(v / total * 100))}</span></span>");
            sb.Append("</div>");
        }
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Colunas do GM médio por mês (%), com linha-alvo em 30% e mês atual destacado.
    private RenderFragment RenderGmColumns() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 220, top = 24, bot = 180, left = 30, right = 12;
        double plotW = Wd - left - right, colW = plotW / 12.0;
        double max = Math.Max(_gmMonthly.DefaultIfEmpty(0).Max(), 30) * 1.15;
        double Y(double v) => bot - v / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='GM médio mensal'>");
        for (var g = 0; g <= 3; g++)
        {
            var gy = top + (bot - top) * g / 3.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
        }
        // linha-alvo em 30%
        double ty = Y(30);
        sb.Append($"<line x1='{left.ToString(inv)}' y1='{ty.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{ty.ToString("0.#", inv)}' stroke='#b7791f' stroke-width='1' stroke-dasharray='4 3' opacity='0.7'/>");
        sb.Append($"<text x='{(Wd - right).ToString(inv)}' y='{(ty - 4).ToString("0.#", inv)}' text-anchor='end' font-size='8.5' fill='#b7791f'>meta 30%</text>");

        for (var m = 0; m < 12; m++)
        {
            double val = _gmMonthly[m];
            double bw = colW * 0.56;
            double cxc = left + m * colW + colW / 2;
            double yTop = Y(val);
            bool cur = (m + 1) == _month;
            var col = cur ? "#007A9E" : val >= 30 ? "#1f9254" : val >= 20 ? "#5bb0c9" : "#c98a3a";
            if (val > 0)
                sb.Append($"<rect x='{(cxc - bw / 2).ToString("0.#", inv)}' y='{yTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(bot - yTop).ToString("0.#", inv)}' rx='2' fill='{col}'/>");
            sb.Append($"<text x='{cxc.ToString("0.#", inv)}' y='{(yTop - 5).ToString("0.#", inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "500")}' fill='#5b6b82'>{val.ToString("0", inv)}%</text>");
            sb.Append($"<text x='{cxc.ToString("0.#", inv)}' y='{(H - 6).ToString(inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "400")}' fill='{(cur ? "#007A9E" : "#93a1b5")}'>{Fmt.MonthName(m + 1)}</text>");
        }
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };
}
