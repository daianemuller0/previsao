    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private AccessScope _scope = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _scope = AccessScope.Resolve(user);
            _login = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                     ?? user.Identity?.Name ?? "";
            _chart.Clear();          // o 1º render acontece antes daqui: recarrega já com o login
        }
        _en = _login != "" && ChartPrefs.Get(_login, ChaveIdioma).Ordem == "en";   // idioma guardado por login
        RestaurarFiltros();
        _opps = LoadScoped();
        LoadReport();
    }

    // Oportunidades recortadas pela carteira permitida do login (controle de acesso).
    // Exclui as que viraram "venda indicada" (movidas para o Controle).
    private List<Opportunity> LoadScoped() =>
        Repo.All().Where(o => !o.MovidaControleValue).Where(o => _scope.CanSee(o, KeyKam(o))).ToList();

    // Inicializa (idempotente) o mapa interativo depois de renderizar. Passa a
    // referência do componente para o mapa poder disparar o cross-filter ao clicar.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _ref ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("worldMap.init", MapId, _ref); } catch { }
        try { await JS.InvokeVoidAsync("xfilter.init", "xf-charts", _ref); } catch { }
        foreach (var chave in ChartKeys)
            try { await JS.InvokeVoidAsync("chartOrder.init", "ch-" + chave, _ref, chave); } catch { }
        // A disposição é reaplicada a cada render: o Blazor redesenha os painéis
        // e levaria junto o "order" que o navegador tinha posto neles.
        try { await JS.InvokeVoidAsync("appLayout.ligar", _ref, LayoutSalvo); } catch { }
    }

    // ---- busca com espera -------------------------------------------------
    // Filtrar é caro: refaz funis, rankings, mapa e tabela sobre todo o recorte.
    // Fazer isso a cada tecla engasgava a tela letra a letra. Aqui a última tecla
    // cancela a espera da anterior, e o recorte só é refeito quando a digitação
    // para — o texto na caixa continua aparecendo na hora, é a página que aguarda.
    private CancellationTokenSource? _buscaCts;

    private async Task BuscarDigitando(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString() ?? "";
        // Só cancela: descartar aqui correria com a espera que acabou de acordar.
        _buscaCts?.Cancel();
        var cts = new CancellationTokenSource();
        _buscaCts = cts;

        try { await Task.Delay(350, cts.Token); }
        catch (OperationCanceledException) { return; }   // veio outra tecla

        _search = texto;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _ref?.Dispose();
        _buscaCts?.Cancel();
    }

    private void LoadReport()
    {
        var (reportado, realizada, meta, metaHsa) = ControleRepo.ReportSeries(_repYear);
        _repReal = reportado; _repRealizada = realizada; _repMeta = meta; _repMetaHsa = metaHsa;
        // Atendimento anual medido pelo número em foco (realizadas, quando houver).
        var foco = realizada.Any(v => v > 0) ? realizada : reportado;
        double tr = foco.Sum(), tm = meta.Sum(), tmh = metaHsa.Sum();
        _repAttain = tm > 0 ? tr / tm * 100 : 0;
        _repAttainHsa = tmh > 0 ? tr / tmh * 100 : 0;
    }

    private static string AtColor(double p) => p >= 100 ? "var(--pos)" : p >= 85 ? "#b7791f" : "var(--neg)";

    // Recarrega as oportunidades após editar/duplicar/excluir na tabela.
    // Build() é chamado no topo do render e recomputa Top 10 e listagem.
    private void ReloadOpps()
    {
        _opps = LoadScoped();
        // Editar uma linha muda o conteúdo sem mudar a contagem nem a hora da
        // última leitura — a assinatura não perceberia. Zerar aqui obriga o
        // recálculo, senão os gráficos ficariam mostrando o valor antigo.
        _assinaturaBuild = "";
    }

