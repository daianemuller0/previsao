    <span class="st-sub">@_filtered.Count @T("no recorte", "in the selection") · @MoneyBrl(_filtered.Sum(o => o.AmountBrl)) @T("em valor", "in value")@(_filtered.Count > TetoTabela ? (_en ? $" · showing the {TetoTabela} largest" : $" · mostrando as {TetoTabela} maiores") : "")</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">@T("Abrir listagem completa", "Open full list")</a>
