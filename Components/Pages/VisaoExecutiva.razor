                {
                    var sh = s.Value / Math.Max(_indTotal, 1) * 100;
                    <div class="ibar-item @(IsActive("kam", s.Label) ? "xf-on" : "")" @onclick='() => CrossFilter("kam", s.Label)' title="@s.Label — @MoneyBrl(s.Value) · @Fmt.Pct(sh)">
                        <div class="ibar-head">
                            <span class="ibar-name">@s.Label</span>
                            <span class="ibar-metrics"><span class="ibar-val">@MoneyBrl(s.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                        </div>
                        <div class="ibar-track"><span class="ibar-fill" style="width:@Share(s.Value, _indRepMax)%;background:linear-gradient(90deg,#c98a12,#e6a72a)"></span></div>
                    </div>
                }
            </div>
        </div></div>
        <div class="c12" data-pnl="lista-indicadas"><div class="xcard ind-card">
            <div class="xcard-head">
                <span class="xcard-ico ind-ico">@Icons.Svg("flag")</span>
                <div><div class="xcard-title">@T("Oportunidades indicadas", "Referred opportunities")</div><div class="xcard-sub">@_indicadas.Count · @T("clique para abrir a oportunidade", "click to open the opportunity")</div></div>
                <span class="xcard-total"><span>Total</span><b>@MoneyBrl(_indTotal)</b></span>
                <button class="btn-ghost" style="padding:4px 10px;margin-left:12px" title="@T("Exportar só as oportunidades indicadas (.xlsx)", "Export only the referred opportunities (.xlsx)")" @onclick="ExportarIndicadas">
                    @Icons.Svg("download")@T("Exportar", "Export")
                </button>
                <TelaCheia Ingles="_en" />
            </div>
            <OpportunityTable Ingles="_en" Rows="_indicadas" CssClass="tbl-compact" Style="max-height:380px;overflow:auto"
                              EmptyText="@T("Nenhuma oportunidade indicada no recorte.", "No referred opportunity in the selection.")" OnChanged="ReloadOpps"
                              OnAbrirDetalhe="GuardarFiltros" ShowColumnPicker="false" />
        </div></div>
    </div>
}

@* ===================== REVENUE DISTRIBUTION & PERFORMANCE ===================== *@
@{
    var _segTot = Math.Max(_bySegment.Sum(x => x.Value), 1);
    var _repTot = Math.Max(_byRep.Sum(x => x.Value), 1);
    var _repMax = _byRep.Count > 0 ? _byRep.Max(x => x.Value) : 1;
    var _buTot = Math.Max(_byBu2.Sum(x => x.Value), 1);
    var _smMax = _bySubMarket.Count > 0 ? _bySubMarket.Max(x => x.Value) : 1;
}
<div class="xsec" data-pnl="sec-distribuicao">
    <span class="xsec-t">@T("Distribuição de Receita & Desempenho", "Revenue Distribution & Performance")</span>
    <span class="xsec-s">@T("de onde vem a receita · quem está gerando", "where revenue comes from · who is generating it") · @_currency</span>
    <span class="xsec-line"></span>
    <span class="xsec-s">@T("clique em qualquer elemento para filtrar", "click any element to filter")</span>
</div>
<div id="xf-charts">
    <div class="g12">
        @* ---- Commercial Segment (donut + lista) ---- *@
        <div class="c6" data-pnl="segmento"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("pie")</span><div><div class="xcard-title">@T("Segmento Comercial", "Commercial Segment")</div><div class="xcard-sub">@_bySegment.Count @T("segmentos · arraste para reordenar", "segments · drag to reorder")</div></div>@ChartToolsFor("segment")<TelaCheia Ingles="_en" /></div>
            @if (_bySegment.Count == 0) { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
            else
            {
                <div class="seg-wrap">
                    <div class="seg-donut">
                        @RenderDonutRing(_bySegment, "segment")
                        <div class="seg-center"><div><div class="lab">Total</div><div class="val">@MoneyBrl(_bySegment.Sum(x => x.Value))</div></div></div>
                    </div>
                    <div class="seg-list scroll-y ch-drag" id="ch-segment" style="max-height:230px;@BarStyle("segment")">
                        @{ var si = 0; }
                        @foreach (var s in Ord("segment", _bySegment, x => x.Label))
                        {
                            var c = SegColors[si++ % SegColors.Length];
                            <div class="seg-row @(IsActive("segment", s.Label) ? "xf-on" : "")" draggable="true" data-key="@s.Label" @onclick='() => CrossFilter("segment", s.Label)' title="@s.Label">
                                <span class="seg-dot" style="background:@c"></span>
                                <span class="seg-name">@s.Label</span>
                                <span class="seg-val">@MoneyBrl(s.Value)</span>
                                <span class="seg-share">@Fmt.Pct(s.Value / _segTot * 100)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div></div>

        @* ---- Forecast by Market (ranking) ---- *@
        <div class="c6" data-pnl="mercado"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("bar-chart")</span><div><div class="xcard-title">@T("Previsão por Mercado", "Forecast by Market")</div><div class="xcard-sub">@_byMarket.Count @T("mercados · arraste para reordenar", "markets · drag to reorder")</div></div><span class="xcard-total"><span>Total</span><b>@Money(_byMarket.Sum(x => x.Value))</b></span>@ChartToolsFor("market")<TelaCheia Ingles="_en" /></div>
            @if (_byMarket.Count == 0) { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
            else
            {
                <div class="ibar @(DimActive("market") ? "has-active" : "") scroll-y ch-drag" id="ch-market" style="max-height:340px;@BarStyle("market")">
                    @foreach (var m in Ord("market", _byMarket, x => x.Name))
                    {
                        var sh = m.Value / _marketTotal * 100;
                        <div class="ibar-item @(IsActive("market", m.Name) ? "xf-on" : "")" draggable="true" data-key="@m.Name" @onclick='() => CrossFilter("market", m.Name)' title="@m.Name — @T("Previsão", "Forecast") @Money(m.Value) · @T("Participação", "Share") @Fmt.Pct(sh)">
                            <div class="ibar-head">
                                <span class="ibar-name">@m.Name</span>
                                <span class="ibar-metrics"><span class="ibar-val">@Money(m.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(m.Value, _maxMarket)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    @* ---- Sales Rep Performance | Forecast by Product (lado a lado) ---- *@
    <div class="g12" style="margin-top:16px">
        <div class="c6" data-pnl="vendedor"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("opportunity")</span><div><div class="xcard-title">@T("Desempenho por Vendedor", "Performance by Salesperson")</div><div class="xcard-sub">@_byRep.Count @T("vendedores", "salespeople") · NB + AFM · @T("arraste para reordenar", "drag to reorder")</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_byRep.Sum(x => x.Value))</b></span>@ChartToolsFor("kam")<TelaCheia Ingles="_en" /></div>
            @if (_byRep.Count == 0) { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
            else
            {
                <div class="ibar @(DimActive("kam") ? "has-active" : "") scroll-y ch-drag" id="ch-kam" style="max-height:460px;@BarStyle("kam")">
                    @{ var ri = 0; }
                    @foreach (var s in Ord("kam", _byRep, x => x.Label))
                    {
                        ri++;
                        var sh = s.Value / _repTot * 100;
                        <div class="ibar-item @(ri <= 3 ? $"top{ri}" : "") @(IsActive("kam", s.Label) ? "xf-on" : "")" draggable="true" data-key="@s.Label" @onclick='() => CrossFilter("kam", s.Label)' title="#@ri @s.Label — @T("Previsão", "Forecast") @MoneyBrl(s.Value) · @T("Participação", "Share") @Fmt.Pct(sh)">
                            <div class="ibar-head">
                                <span class="ibar-num">@ri</span>
                                <span class="ibar-name">@s.Label</span>
                                <span class="ibar-metrics"><span class="ibar-val">@MoneyBrl(s.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(s.Value, _repMax)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
        <div class="c6" data-pnl="produto"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("layers")</span><div><div class="xcard-title">@T("Previsão por Produto", "Forecast by Product")</div><div class="xcard-sub">@_byProduct.Count @T("produtos · arraste para reordenar", "products · drag to reorder")</div></div><span class="xcard-total"><span>Total</span><b>@Money(_byProduct.Sum(x => x.Value))</b></span>@ChartToolsFor("product")<TelaCheia Ingles="_en" /></div>
            @if (_byProduct.Count == 0) { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
            else
            {
                <div class="ibar @(DimActive("product") ? "has-active" : "") scroll-y ch-drag" id="ch-product" style="max-height:400px;@BarStyle("product")">
                    @foreach (var p in Ord("product", _byProduct, x => x.Name))
                    {
                        var gmCls = p.Margin >= 28 ? "hi" : (p.Margin <= 18 ? "lo" : "");
                        var sh = p.Value / _productTotal * 100;
                        <div class="ibar-item @(IsActive("product", p.Name) ? "xf-on" : "")" draggable="true" data-key="@p.Name" @onclick='() => CrossFilter("product", p.Name)' title="@p.Name — @T("Previsão", "Forecast") @Money(p.Value) · @T("Participação", "Share") @Fmt.Pct(sh) · @T("Margem", "Margin") @Fmt.Pct(p.Margin)">
                            <div class="ibar-head">
                                <span class="ibar-name">@p.Name</span>
                                <span class="ibar-metrics"><span class="ibar-val">@Money(p.Value)</span><span class="ibar-share">@Fmt.Pct(sh)</span><span class="gm-pill @gmCls">GM @Fmt.Pct(p.Margin)</span></span>
                            </div>
                            <div class="ibar-track"><span class="ibar-fill" style="width:@Share(p.Value, _maxProduct)%"></span></div>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>

    <div class="g12">
        @* ---- Sub-Market Performance (lollipop) ---- *@
        <div class="c6" data-pnl="submercado"><div class="xcard">
            <div class="xcard-head"><span class="xcard-ico">@Icons.Svg("trend")</span><div><div class="xcard-title">@T("Desempenho por Sub-Mercado", "Performance by Sub-market")</div><div class="xcard-sub">@_bySubMarket.Count @T("sub-mercados · arraste para reordenar", "sub-markets · drag to reorder")</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_bySubMarket.Sum(x => x.Value))</b></span>@ChartToolsFor("submarket")<TelaCheia Ingles="_en" /></div>
            @if (_bySubMarket.Count == 0) { <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div> }
            else
            {
                <div class="lolli scroll-y ch-drag" id="ch-submarket" style="max-height:380px;@BarStyle("submarket")">
