    // ---- idioma da tela (botão PT/EN ao lado da moeda; guardado por login) ----
    private bool _en;
    private const string ChaveIdioma = "visao_executiva_idioma";
    /// <summary>O texto no idioma da tela: T("Vendas realizadas", "Actual sales").</summary>
    private string T(string pt, string en) => _en ? en : pt;
    private static readonly System.Globalization.CultureInfo EnUs = new("en-US");
    // Formatação no idioma da tela: em português delega ao Fmt (saída idêntica à de
    // sempre); em inglês usa en-US e as unidades M/B/K.
    private System.Globalization.CultureInfo CulturaTela => _en ? EnUs : _pt;
    /// <summary>Número compacto sem símbolo: "212,9 mi" / "212.9M", "850 mil" / "850K", "1.06B".</summary>
    private string Compacto(double v)
    {
        if (!_en) return Fmt.Compact(v);
        var a = Math.Abs(v);
        if (a >= 1_000_000_000) return (v / 1_000_000_000).ToString("#,##0.0#", EnUs) + "B";
        if (a >= 1_000_000) return (v / 1_000_000).ToString("0.0", EnUs) + "M";
        if (a >= 1_000) return Math.Round(v / 1_000).ToString("#,##0", EnUs) + "K";
        return v.ToString("#,##0", EnUs);
    }
    /// <summary>Percentual: "43,6%" / "43.6%".</summary>
    private string PctTxt(double v, int dec = 0) =>
        _en ? v.ToString("0." + new string('0', dec), EnUs) + "%" : Fmt.Pct(v, dec);
    /// <summary>Variação com sinal: "+4,2%" / "+4.2%".</summary>
    private string SinalTxt(double v) =>
        _en ? (v >= 0 ? "+" : "") + v.ToString("0.0", EnUs) + "%" : Fmt.Signed(v);
    /// <summary>Mês abreviado dos eixos: "FEV" / "FEB".</summary>
    private string MesNome(int m) => !_en ? Fmt.MonthName(m)
        : m is >= 1 and <= 12 ? EnUs.DateTimeFormat.GetAbbreviatedMonthName(m).ToUpperInvariant().TrimEnd('.') : "—";
    /// <summary>Mês por extenso (só exibição; os valores do filtro de mês seguem em português): "Fevereiro" / "February".</summary>
    private string MesLongo(int m) => !_en ? Fmt.MonthLong(m)
        : m is >= 1 and <= 12 ? EnUs.DateTimeFormat.GetMonthName(m) : "—";
