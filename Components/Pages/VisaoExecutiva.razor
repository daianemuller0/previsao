@page "/executivo"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject ControleRepository ControleRepo
@inject ChartPrefsRepository ChartPrefs
@inject FiltroMemoria Filtros
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@{
    Build();
    // Exibição PT/EN só da marcação: em português, exatamente os mesmos helpers de antes.
    string XCompact(double v)
    {
        if (!_en) return Fmt.Compact(v);
        var a = Math.Abs(v);
        if (a >= 1_000_000_000) return (v / 1_000_000_000).ToString("0.00", EnUs) + "B";
        if (a >= 1_000_000) return (v / 1_000_000).ToString("0.0", EnUs) + "M";
        if (a >= 1_000) return Math.Round(v / 1_000).ToString("#,##0", EnUs) + "K";
        return v.ToString("#,##0", EnUs);
    }
    string XMes(int m) => !_en ? Fmt.MonthName(m) : m is >= 1 and <= 12 ? EnUs.DateTimeFormat.GetAbbreviatedMonthName(m).ToUpperInvariant() : "—";
    string XMesLongo(int m) => !_en ? Fmt.MonthLong(m) : m is >= 1 and <= 12 ? EnUs.DateTimeFormat.GetMonthName(m) : "—";
    // Opção do filtro de Mês: o valor guardado continua em português; só o rótulo muda.
    string XMesFiltro(string v) { var m = Enumerable.Range(1, 12).FirstOrDefault(i => Fmt.MonthLong(i) == v); return m > 0 ? XMesLongo(m) : v; }
    string XDec1(double v) => v.ToString("0.0", _en ? EnUs : _pt);
    string XDec4(double v) => v.ToString("0.0000", _en ? EnUs : System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    string XSigned(double v) => !_en ? Fmt.Signed(v) : (v >= 0 ? "+" : "") + v.ToString("0.0", EnUs) + "%";
}

@* ===================== 1 · CABEÇALHO EXECUTIVO ===================== *@
<div class="breadcrumbs"><span>@T("Comercial", "Commercial")</span><span class="sep">/</span><span>@T("Previsão de Vendas", "Sales Forecast")</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">@T("Visão Executiva", "Executive View")</span></div>

<div class="page-head">
    <div>
        <h1>@T("Previsão de Vendas", "Sales Forecast")</h1>
        <p class="subtitle">
            @XMesLongo(_month) @T("de ", "")@_year · @(_en ? $"Q{_quarter}" : $"{_quarter}º trimestre") · Howden Brasil · @_currency@(TaxaTelaAtiva is double tt ? $" (R$ ÷ {XDec4(tt)}, {T("taxa digitada na tela", "rate entered on screen")})" : "")<br />
            @T("Última consolidação", "Last consolidation") @(_en ? _updated.ToString("MM/dd/yyyy 'at' HH:mm", EnUs) : _updated.ToString("dd/MM/yyyy 'às' HH:mm"))
        </p>
    </div>
    <div class="page-actions">
        <div class="segmented" style="margin-right:2px">
            <button class="@(_currency == "USD" ? "active" : "")" @onclick='() => _currency = "USD"'>USD</button>
            <button class="@(_currency == "BRL" ? "active" : "")" @onclick='() => _currency = "BRL"'>BRL</button>
        </div>
        <div class="segmented" style="margin-right:2px" title="Idioma da tela · Screen language">
            <button class="@(!_en ? "active" : "")" @onclick="() => MudarIdioma(false)">PT</button>
            <button class="@(_en ? "active" : "")" @onclick="() => MudarIdioma(true)">EN</button>
        </div>
        @if (_currency == "USD")
        {
            @* taxa R$/US$ só para esta tela: tudo o que a página mostraria em R$ é dividido por ela (não grava nada) *@
            <label class="cvx-taxa-tela" title="@(T("Taxa R$/US$ só para esta tela: os valores que a página mostraria em R$ são divididos por ela. Não muda a base de dados nem a taxa cadastrada. Vazio = a taxa cadastrada", "R$/US$ rate for this screen only: the values the page would show in R$ are divided by it. It does not change the database or the registered rate. Empty = the registered rate") + " (" + XDec4(Rate) + ").")">
                <span>@T("Taxa", "Rate")</span>
                <input type="text" inputmode="decimal" placeholder="@Rate.ToString("0.00", _en ? EnUs : System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" value="@(_taxaTela is double tv ? tv.ToString("0.####", _en ? EnUs : System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) : "")" @onchange="MudarTaxaTela" />
            </label>
        }
        <button class="btn-ghost" @onclick='() => JS.InvokeVoidAsync("presentation.start")' title="@T("Modo apresentação — tela cheia + rolagem automática (espaço pausa, Esc sai)", "Presentation mode — full screen + auto scroll (space pauses, Esc exits)")">@Icons.Svg("play")@T("Apresentação", "Presentation")</button>
        <button class="btn-ghost" title="@T("Exportar as oportunidades do recorte atual (respeita os filtros da página)", "Export the opportunities in the current selection (follows the page filters)")" @onclick="ExportarFiltradas">@Icons.Svg("download")@T("Exportar", "Export")</button>
        @* Montar a página: arrastar os painéis e escolher a largura de cada um. *@
        <button class="btn-ghost @(_organizando ? "active" : "")" title="@T("Arrastar os painéis para montar a página do seu jeito", "Drag the panels to arrange the page your way")" @onclick="AlternarOrganizar">@Icons.Svg("layers")@(_organizando ? T("Concluir", "Done") : T("Organizar", "Arrange"))</button>
        @if (_organizando)
        {
            <button class="btn-ghost" title="@T("Voltar à disposição original dos painéis", "Go back to the original panel layout")" @onclick="RestaurarLayout">@Icons.Svg("history")@T("Restaurar padrão", "Restore default")</button>
        }
        <a class="btn-primary" href="/oportunidades">@Icons.Svg("opportunity")@T("Abrir Oportunidades", "Open Opportunities")</a>
    </div>
</div>

@* ---- Filtros globais ---- *@
<div class="filterbar filterbar-sticky">
    @* A busca espera a pessoa parar de digitar (ver BuscarDigitando): a cada tecla
       a página inteira era refeita sobre milhares de oportunidades. *@
    <div class="flt"><span class="flt-label">@T("Buscar", "Search")</span><input class="flt-search" placeholder="@T("oportunidade, cliente, proposta…", "opportunity, customer, proposal…")" value="@_search" @oninput="BuscarDigitando" /></div>
    @* Ordem pedida: quem usa procura primeiro pelo vendedor, depois estreita o
       período. O intervalo "de tal dia a tal dia" saiu — a previsão é mensal, e
       os filtros de Mês e Ano já dão o recorte que se usa no dia a dia. *@
    <MultiFilter Ingles="_en" Label="KAM" AllText="@T("Todos", "All")" EmptyText="@T("Nenhum vendedor nos dados.", "No salesperson in the data.")" Options="KamOptions" Selected="_kams" OnChanged="StateHasChanged" />
    <MultiFilter Ingles="_en" Label="@T("Mês", "Month")" AllText="@T("Todos", "All")" Rotulo="@(_en ? XMesFiltro : null)" Options="MonthOptions" Selected="_months" OnChanged="StateHasChanged" />
    <MultiFilter Ingles="_en" Label="@T("Ano", "Year")" AllText="@T("Todos", "All")" Options="YearOptions.Select(y => y.ToString())" Selected="_years" OnChanged="StateHasChanged" />
    <MultiFilter Ingles="_en" Label="@T("Mercado", "Market")" AllText="@T("Todos", "All")" Options="MarketOptions" Selected="_markets" OnChanged="StateHasChanged" />
    @if (_scope.Setor == "")
    {
        <MultiFilter Ingles="_en" Label="@T("Setor", "Sector")" AllText="@T("Ambos", "Both")" Options="SetorOptions" Selected="_setores" OnChanged="StateHasChanged" />
    }
    <label class="flt-toggle @(_onlyIndicated ? "on" : "")" title="@T("Mostrar somente as oportunidades indicadas na previsão", "Show only the opportunities referred to the forecast")"><input type="checkbox" @bind="_onlyIndicated" />@Icons.Svg("flag")<span>@T("Somente indicadas", "Referred only")</span></label>
    <label class="flt-toggle @(_overdue ? "on" : "")" title="@T("Somente as oportunidades com data de fechamento até ontem (já vencidas)", "Only the opportunities with a close date up to yesterday (already overdue)")"><input type="checkbox" @bind="_overdue" />@Icons.Svg("clock")<span>Overdue</span></label>
    <label class="flt-toggle @(_semOtp ? "on" : "")" title="@T("Tirar do recorte as oportunidades já marcadas como OTP", "Remove from the selection the opportunities already marked as OTP")"><input type="checkbox" @bind="_semOtp" />@Icons.Svg("x")<span>@T("Sem OTP", "No OTP")</span></label>
    <label class="flt-toggle @(_onlyLost ? "on" : "")" title="@T("Mostrar somente as oportunidades indicadas como perdidas", "Show only the opportunities marked as lost")"><input type="checkbox" @bind="_onlyLost" />@Icons.Svg("x")<span>@T("Perdidas", "Lost")</span></label>
    <label class="flt-toggle @(_onlyAltered ? "on" : "")" title="@T("Mostrar somente as oportunidades com algum valor alterado no sistema (diferente do que o CRM trouxe)", "Show only the opportunities with some value changed in the system (different from what the CRM brought)")"><input type="checkbox" @bind="_onlyAltered" />@Icons.Svg("edit")<span>@T("Alteradas no sistema", "Changed in the system")</span></label>
    @if (_showMore)
    {
        <MultiFilter Ingles="_en" Label="@T("País", "Country")" AllText="@T("Todos", "All")" Options="CountryOptions" Selected="_countries" OnChanged="StateHasChanged" />
        <MultiFilter Ingles="_en" Label="@T("Produto", "Product")" AllText="@T("Todos", "All")" Options="ProductOptions" Selected="_products" OnChanged="StateHasChanged" />
        <MultiFilter Ingles="_en" Label="@T("Cliente", "Customer")" AllText="@T("Todos", "All")" Options="CustomerOptions" Selected="_customers" OnChanged="StateHasChanged" />
        <MultiFilter Ingles="_en" Label="BU IC" AllText="@T("Todas", "All")" EmptyText="@T("Nenhuma oferta com BU de origem no recorte.", "No offer with a source BU in the selection.")" Options="BuIcOptions" Selected="_buIcs" OnChanged="StateHasChanged" />
        <MultiFilter Ingles="_en" Label="@T("Unidade de negócio", "Business unit")" AllText="@T("Todas", "All")" Options="BuOptions" Selected="_bus" OnChanged="StateHasChanged" />
        <div class="flt"><span class="flt-label">@T("Filtrar por", "Filter by")</span><select @bind="_valMetric"><option value="total">@T("Valor total", "Total value")</option><option value="conv">@T("Chance de conversão", "Conversion likelihood")</option></select></div>
        <div class="flt"><span class="flt-label">@T("Mínimo R$", "Minimum R$")</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="0" @bind="_valMin" /></div>
        <div class="flt"><span class="flt-label">@T("Máximo R$", "Maximum R$")</span><input class="flt-date" style="min-width:90px" type="number" min="0" step="1000" placeholder="—" @bind="_valMax" /></div>
    }
    <button class="btn-link" @onclick="() => _showMore = !_showMore">@(_showMore ? T("Menos filtros", "Fewer filters") : T("Mais filtros", "More filters"))</button>
    <div class="filterbar-spacer"></div>
    <div class="fb-summary">
        <div class="fb-sum"><span class="fb-sum-k">@T("Vendido", "Sold")@(_monthFilter is >= 1 and <= 12 ? " · " + XMes(_monthFilter) : "")</span><span class="fb-sum-v pos">@MoneyBrl(FocoValor)</span></div>
        <div class="fb-sum"><span class="fb-sum-k">@T("Previsão", "Forecast")</span><span class="fb-sum-v">@Money(_fcYear)</span></div>
    </div>
    @if (_activeFilters > 0)
    {
        <span class="tag">@_activeFilters @T("ativo(s)", "active")</span>
        <button class="btn-link" @onclick="ClearFilters">@T("Limpar", "Clear")</button>
    }
    <button class="btn-link" @onclick="SaveView">@T("Salvar visualização", "Save view")</button>
    @if (_savedMsg) { <span class="saved-flag">@Icons.Svg("check")@T("Salvo", "Saved")</span> }

    @* ---- Controle da apresentação ----
       Mora DENTRO da barra de filtros de propósito: ela congela abaixo do
       topbar, então o controle congela junto e continua ao alcance enquanto a
       página passa. Fica escondido fora do modo apresentação — o app.js marca a
       página com "apresentando".

       Os dois botões de pausa são sempre desenhados e o CSS mostra um de cada
       vez: o estado mora no JS, que é quem manda na rolagem, sem sincronizar
       nada com o Blazor. *@
    <div class="apres-controle">
        <button type="button" class="apres-btn apres-pausar" title="@T("Pausar a rolagem (espaço)", "Pause scrolling (space)")"
                onclick="presentation.alternarPausa()">@Icons.Svg("pause")<span>@T("Pausar", "Pause")</span></button>
        <button type="button" class="apres-btn apres-continuar" title="@T("Continuar a rolagem (espaço)", "Resume scrolling (space)")"
                onclick="presentation.alternarPausa()">@Icons.Svg("play")<span>@T("Continuar", "Resume")</span></button>
        <button type="button" class="apres-btn apres-sair" title="@T("Sair da apresentação (Esc)", "Exit presentation (Esc)")"
                onclick="presentation.stop()">@Icons.Svg("x")<span>@T("Sair", "Exit")</span></button>
    </div>
</div>

@* ===========================================================================
   PAINEL MONTÁVEL: daqui até o fim, cada bloco marcado com data-pnl é uma peça
   que a pessoa pode arrastar para onde quiser e deixar com meia largura ou
   inteira. Os agrupamentos internos (.g12, #xf-charts) viram "display: contents"
   pelo CSS, então todas as peças ficam na MESMA grade — é isso que permite um
   gráfico sair de uma linha e ir para outra.
   =========================================================================== *@
<div class="g12 exec-board" id="exec-board">
@* ===================== EXECUTIVE OVERVIEW (KPIs) ===================== *@
@{
    var _fcBrl = _fcYear * Rate;   // sempre em R$ (Amount converted), independe do toggle
    var _fcAtt = _metaYear > 0 ? _fcBrl / _metaYear * 100 : 0;
    var _wonAtt = _heroMeta > 0 ? FocoValor / _heroMeta * 100 : 0;
    var _gapTgt = Math.Max(_metaYear - _fcBrl, 0);
    var _gmPp = _gmAvg - 30.0;
}
<div class="xsec lvl1" data-pnl="sec-visao">
    <span class="xsec-t">@T("Visão Geral Executiva", "Executive Overview")</span>
    <span class="xsec-s">how are we performing · @_year · @_currency</span>
    <span class="xsec-line"></span>
</div>
<div class="kpi-row" data-pnl="kpis">
    <div class="kpi">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("trend")</span><span class="kpi-label">@T("Previsão", "Forecast")</span></div>
        <div class="kpi-value">@Money(_fcYear)</div>
        <div class="kpi-delta @(_fcAtt >= 100 ? "pos" : "neutral")"><span class="arw">@(_fcAtt >= 100 ? "▲" : "•")</span> @Fmt.Pct(_fcAtt) <span class="ctx">@T("da meta", "of target")</span></div>
        <div class="kpi-spark"><Sparkline Values="@_monthAmt" Stroke="#17a2c0" /></div>
    </div>
    <div class="kpi accent-pos">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("check")</span><span class="kpi-label">@FocoNome</span></div>
        <div class="kpi-value">@MoneyBrl(FocoValor)</div>
        <div class="kpi-delta @(_wonAtt >= 100 ? "pos" : "neutral")"><span class="arw">@(_wonAtt >= 100 ? "▲" : "•")</span> @Fmt.Pct(_wonAtt) <span class="ctx">@T("da meta", "of target")</span></div>
        <div class="kpi-spark"><Sparkline Values="@_mReal" Stroke="#1f9254" /></div>
    </div>
    <div class="kpi @(_gmAvg >= 30 ? "accent-pos" : "accent-warn")">
        <div class="kpi-top"><span class="kpi-ico">@Icons.Svg("executive")</span><span class="kpi-label">@T("Margem Bruta", "Gross Margin")</span></div>
        <div class="kpi-value">@Fmt.Pct(_gmAvg)</div>
        <div class="kpi-delta @(_gmPp >= 0 ? "pos" : "warn")"><span class="arw">@(_gmPp >= 0 ? "▲" : "▼")</span> @XDec1(Math.Abs(_gmPp)) pp <span class="ctx">@T("vs meta de 30%", "vs 30% target")</span></div>
        <div class="kpi-bar"><i style="width:@Share(_gmAvg, 40)%"></i></div>
    </div>
</div>

@* ===================== 2 · HERO EXECUTIVO ===================== *@
<div class="hero" data-pnl="hero">
    <div class="hero-main">
        <div class="hero-eyebrow">@FocoNome × @T("Meta", "Target") · REPORT HSA · @(_monthFilter is >= 1 and <= 12 ? XMesLongo(_monthFilter) + " " + _repYear : T("Ano ", "Year ") + _repYear)</div>
        <div class="hero-value"><span class="cur">@_sym</span>@XCompact(CvBrl(FocoValor))</div>
        <div class="hero-target-line">
            @T("Meta NB+AFM", "NB+AFM target") @MoneyBrl(_heroMeta) · @Fmt.Pct(_heroAttain) @T("da meta", "of target") · gap @MoneyBrl(Math.Max(_heroMeta - FocoValor, 0))<br />
            @T("Meta Vendas HSA", "HSA sales target") @MoneyBrl(_heroMetaHsa) · @Fmt.Pct(_heroAttainHsa) @T("da meta", "of target") · gap @MoneyBrl(Math.Max(_heroMetaHsa - FocoValor, 0))
            @* O outro número fica na linha de baixo, para comparação. Só aparece
               quando existe: uma cifra zerada ali só confundiria a leitura. *@
            @if (OutroValor > 0)
            {
                <br />
                <span>@OutroNome @MoneyBrl(OutroValor) · @Fmt.Pct(_heroMeta > 0 ? OutroValor / _heroMeta * 100 : 0) @T("da meta NB+AFM", "of the NB+AFM target")</span>
            }
        </div>
        @* O foco vem primeiro. O que o CRM reporta e o que de fato se
           concretizou são números diferentes, e ler os dois juntos é o ponto. *@
        <div class="hero-chips">
            <div class="hero-chip destaque"><div class="k">@FocoNome</div><div class="v">@MoneyBrl(FocoValor)</div></div>
            <div class="hero-chip"><div class="k">@OutroNome</div><div class="v">@(OutroValor > 0 ? MoneyBrl(OutroValor) : "—")</div></div>
            <div class="hero-chip"><div class="k">@T("Meta NB+AFM", "NB+AFM target")</div><div class="v">@MoneyBrl(_heroMeta)</div></div>
            <div class="hero-chip"><div class="k">@T("Meta Vendas HSA", "HSA sales target")</div><div class="v">@MoneyBrl(_heroMetaHsa)</div></div>
        </div>
        <div class="hero-gauge">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttain)%"></div></div>
            <div class="gl"><span>@T("Atingimento · Meta NB+AFM", "Attainment · NB+AFM target")</span><span>@Fmt.Pct(_heroAttain)</span></div>
        </div>
        <div class="hero-gauge" style="margin-top:8px">
            <div class="gt"><div class="gf" style="width:@Clamp(_heroAttainHsa)%"></div></div>
            <div class="gl"><span>@T("Atingimento · Meta Vendas HSA", "Attainment · HSA sales target")</span><span>@Fmt.Pct(_heroAttainHsa)</span></div>
        </div>
    </div>
</div>

@* ---- Vendas x Meta (NB+AFM) · fonte: Controle · REPORT HSA ---- *@
<div class="panel" style="margin-top:16px" data-pnl="vendas-meta">
    <div class="panel-head">
        <div class="panel-title">@T("Vendas x Meta · NB+AFM", "Sales x Target · NB+AFM")
            <span class="hint">@T("realizado x budget mensal · fonte: Controle · REPORT HSA · R$", "actual x monthly budget · source: Control · REPORT HSA · R$") · @_repYear</span>
        </div>
        <div class="rep-attain-group">
            <div class="rep-attain-box">
                <span class="ra-label">@T("Atend. Meta NB+AFM (ano)", "NB+AFM target attainment (year)")</span>
                <span class="ra-value" style="color:@AtColor(_repAttain)">@Fmt.Pct(_repAttain)</span>
            </div>
            <div class="rep-attain-box">
                <span class="ra-label">@T("Atend. Meta Vendas HSA (ano)", "HSA sales target attainment (year)")</span>
                <span class="ra-value" style="color:@AtColor(_repAttainHsa)">@Fmt.Pct(_repAttainHsa)</span>
            </div>
        </div>
        <TelaCheia Ingles="_en" />
    </div>
    @if (_repReal.Any(v => v > 0) || _repRealizada.Any(v => v > 0) || _repMeta.Any(v => v > 0) || _repMetaHsa.Any(v => v > 0))
    {
        <div class="chart-body">@RenderReportLine()</div>
    }
    else
    {
        <div class="empty">@if (_en) { <text>No data in Control (REPORT HSA) for @_repYear. Fill in the values on the <a href="/controle">Control</a> tab.</text> } else { <text>Sem dados no Controle (REPORT HSA) para @_repYear. Preencha os valores na guia <a href="/controle">Controle</a>.</text> }</div>
    }
</div>

@* ============ SALES FUNNEL + PREVISÃO INDICADA (lado a lado) ============ *@
<div class="xsec" data-pnl="sec-funil">
    <span class="xsec-t">@T("Funil de Vendas por Etapa", "Sales Funnel by Stage")</span>
    <span class="xsec-s">@T("sequência do funil", "funnel sequence") · @_currency</span>
    <span class="xsec-line"></span>
    @if (_indicadas.Count > 0) { <span class="ind-badge">@Icons.Svg("flag")@_indicadas.Count @T("indicadas", "referred") · @MoneyBrl(_indTotal)</span> }
    @if (_stage != "") { <button class="btn-link" @onclick='() => CrossFilter("stage", _stage)'>@T("Limpar Etapa", "Clear Stage")</button> }
</div>
<div class="g12">
    <div class="c6" data-pnl="funil"><div class="xcard pf-card">
    @if (_funnel.Count == 0)
    {
        <div class="empty">@if (_en) { <text>No data in the selection. Import the HSA Sales Funnel data on the <a href="/oportunidades">Opportunities</a> tab.</text> } else { <text>Sem dados no recorte. Importe a base do Funil de Vendas HSA na guia <a href="/oportunidades">Oportunidades</a>.</text> }</div>
    }
    else
    {
        var _fnOpps = _funnel.Sum(x => x.Count);
        var _fnTop2 = _funnel.Count >= 2 ? _funnel.Take(2).Sum(x => x.Value) / _funnelTotal * 100 : 100;
        <div class="pf-head">
            <div>
                <div class="xcard-title">@Icons.Svg("pipeline", "pf-ico")@T("Funil de Vendas por Etapa", "Sales Funnel by Stage")</div>
                <div class="xcard-sub">@T("Valor", "Value") · @_currency · @_funnel.Count @T("etapas", "stages") · @T("sequência do funil", "funnel sequence")</div>
            </div>
            <div class="pf-totals">
                <div class="pf-tot"><div class="pf-tot-l">@T("Total do Funil", "Funnel Total")</div><div class="pf-tot-v">@MoneyBrl(_funnelTotal)</div></div>
                <div class="pf-tot"><div class="pf-tot-l">@T("Total de Oportunidades", "Total Opportunities")</div><div class="pf-tot-v">@_fnOpps</div></div>
                <TelaCheia Ingles="_en" />
            </div>
        </div>
        <div class="pf-insight">@Icons.Svg("trend")<span><strong>@Fmt.Pct(_fnTop2)</strong> @(_en ? (_funnel.Count >= 2 ? "of the funnel value is concentrated in the first two stages" : "of the funnel value is concentrated in the first stage") : "do valor do funil está concentrado " + (_funnel.Count >= 2 ? "nas duas primeiras etapas" : "na primeira etapa")).</span></div>
        <div class="fn5 @(DimActive("stage") ? "has-active" : "")">
            @for (var i = 0; i < _funnel.Count; i++)
            {
                var f = _funnel[i];
                var sh = f.Value / _funnelTotal * 100;
                var conv = i < _funnel.Count - 1 && f.Value > 0 ? _funnel[i + 1].Value / f.Value * 100 : (double?)null;
                // Geometria por posição: sempre afunilando (largura decrescente).
                var dw = FnW(i, _funnel.Count);
                var dwN = i < _funnel.Count - 1 ? FnW(i + 1, _funnel.Count) : dw * 0.86;
                var frac = dwN / dw;
                var inset = (1 - frac) / 2 * 100;
                <div class="fn5-seg @(IsActive("stage", f.Stage) ? "xf-on" : "")" style="width:@F(dw)%" @onclick='() => CrossFilter("stage", f.Stage)' title="@(f.Stage + " — " + MoneyBrl(f.Value) + " · " + Fmt.Pct(sh) + T(" do funil · ", " of the funnel · ") + f.Count + T(" oportunidades", " opportunities") + (conv is { } cv ? " · " + Fmt.Pct(cv) + T(" para a próxima", " to the next") : ""))">
                    <div class="fn5-shape" style="clip-path:polygon(0 0, 100% 0, @F(100 - inset)% 100%, @F(inset)% 100%);background:@FunnelBar(i, _funnel.Count)"></div>
                    <div class="fn5-text @(FunnelDark(i, _funnel.Count) ? "dark" : "")">
                        <div class="fn5-name">@f.Stage</div>
                        <div class="fn5-amt">@MoneyBrl(f.Value)</div>
                        <div class="fn5-sub">@Fmt.Pct(sh) @T("do funil", "of the funnel") · @f.Count @T("oport.", "opp.")@(conv is { } c ? " · ↓ " + Fmt.Pct(c) + (_en ? " to the next" : " para a próxima") : "")</div>
                    </div>
                </div>
            }
        </div>
        @* Base do funil: valor efetivamente vendido (Realizado · REPORT HSA). *@
        <div class="fn5-bottom">
            <span class="fn5-bottom-l">@Icons.Svg("check")@FocoNome@(_monthFilter is >= 1 and <= 12 ? " · " + XMes(_monthFilter) : "")</span>
            <span class="fn5-bottom-v">@MoneyBrl(FocoValor)</span>
        </div>
    }
    </div></div>
    <div class="c6" data-pnl="funil-indicadas">
    @if (_indicadas.Count == 0)
    {
        <div class="xcard ind-card"><div class="ind-empty">
            <span class="ind-empty-ico">@Icons.Svg("flag")</span>
            @if (_en)
            {
                <div><strong>No opportunity referred yet.</strong><br />
                Use the <span class="ind-hint">@Icons.Svg("flag")Refer to Forecast</span> button on the <a href="/oportunidades">Opportunities</a> tab or in the Top 10 — referred ones show up here with their own funnel, chart and list.</div>
            }
            else
            {
            <div><strong>Nenhuma oportunidade indicada ainda.</strong><br />
                Use o botão <span class="ind-hint">@Icons.Svg("flag")Indicar na Previsão</span> na aba <a href="/oportunidades">Oportunidades</a> ou no Top 10 — as indicadas aparecem aqui com funil, gráfico e lista próprios.</div>
            }
        </div></div>
    }
    else
    {
        @* Funil só das indicadas *@
        @* Mesma estrutura do funil ao lado (cabeçalho, aviso, etapas e base):
           são leituras que se comparam, então qualquer diferença de formato
           vira ruído na hora de olhar os dois juntos. *@
        <div class="xcard pf-card ind-card">
            @{
                var _ifOpps = _indFunnel.Sum(x => x.Count);
                var _ifTop2 = _indFunnel.Count >= 2 ? _indFunnel.Take(2).Sum(x => x.Value) / Math.Max(_indTotal, 1) * 100 : 100;
            }
            <div class="pf-head">
                <div>
                    <div class="xcard-title">@Icons.Svg("flag", "pf-ico")@T("Funil das Indicadas por Etapa", "Referred Funnel by Stage")</div>
                    <div class="xcard-sub">@T("Valor", "Value") · @_currency · @_indFunnel.Count @T("etapas", "stages") · @Fmt.Pct(_indTotal / Math.Max(_funnelTotal, 1) * 100) @T("do pipeline", "of the pipeline")</div>
                </div>
                <div class="pf-totals">
                    <div class="pf-tot"><div class="pf-tot-l">@T("Total do Funil", "Funnel Total")</div><div class="pf-tot-v">@MoneyBrl(_indTotal)</div></div>
                    <div class="pf-tot"><div class="pf-tot-l">@T("Total de Oportunidades", "Total Opportunities")</div><div class="pf-tot-v">@_ifOpps</div></div>
                    <TelaCheia Ingles="_en" />
                </div>
            </div>
            <div class="pf-insight">@Icons.Svg("trend")<span><strong>@Fmt.Pct(_ifTop2)</strong> @(_en ? (_indFunnel.Count >= 2 ? "of the funnel value is concentrated in the first two stages" : "of the funnel value is concentrated in the first stage") : "do valor do funil está concentrado " + (_indFunnel.Count >= 2 ? "nas duas primeiras etapas" : "na primeira etapa")).</span></div>
            <div class="fn5 @(DimActive("stage") ? "has-active" : "")">
                @for (var i = 0; i < _indFunnel.Count; i++)
                {
                    var f = _indFunnel[i];
                    var sh = f.Value / Math.Max(_indTotal, 1) * 100;
                    var conv = i < _indFunnel.Count - 1 && f.Value > 0 ? _indFunnel[i + 1].Value / f.Value * 100 : (double?)null;
                    var dw = FnW(i, _indFunnel.Count);
                    var dwN = i < _indFunnel.Count - 1 ? FnW(i + 1, _indFunnel.Count) : dw * 0.86;
                    var frac = dwN / dw;
                    var inset = (1 - frac) / 2 * 100;
                    <div class="fn5-seg @(IsActive("stage", f.Stage) ? "xf-on" : "")" style="width:@F(dw)%" @onclick='() => CrossFilter("stage", f.Stage)' title="@(f.Stage + " — " + MoneyBrl(f.Value) + " · " + Fmt.Pct(sh) + T(" do funil · ", " of the funnel · ") + f.Count + T(" oportunidades", " opportunities") + (conv is { } cv ? " · " + Fmt.Pct(cv) + T(" para a próxima", " to the next") : ""))">
                        <div class="fn5-shape" style="clip-path:polygon(0 0, 100% 0, @F(100 - inset)% 100%, @F(inset)% 100%);background:@FunnelBar(i, _indFunnel.Count)"></div>
                        <div class="fn5-text @(FunnelDark(i, _indFunnel.Count) ? "dark" : "")">
                            <div class="fn5-name">@f.Stage</div>
                            <div class="fn5-amt">@MoneyBrl(f.Value)</div>
                            <div class="fn5-sub">@Fmt.Pct(sh) @T("do funil", "of the funnel") · @f.Count @T("oport.", "opp.")@(conv is { } c ? " · ↓ " + Fmt.Pct(c) + (_en ? " to the next" : " para a próxima") : "")</div>
                        </div>
                    </div>
                }
            </div>
            @* Mesma base do outro funil: o valor efetivamente vendido. *@
            <div class="fn5-bottom">
                <span class="fn5-bottom-l">@Icons.Svg("check")@FocoNome@(_monthFilter is >= 1 and <= 12 ? " · " + XMes(_monthFilter) : "")</span>
                <span class="fn5-bottom-v">@MoneyBrl(FocoValor)</span>
            </div>
        </div>

    }
    </div>
</div>

@* Indicadas por vendedor + lista (linha inteira cada) *@
@if (_indicadas.Count > 0)
{
    <div class="g12" style="margin-top:16px">
        @* Estava embaixo do funil, na meia coluna: as barras ficavam curtas e
           sobrava a metade esquerda vazia. Linha inteira aproveita o espaço. *@
        <div class="c12" data-pnl="indicadas-vendedor"><div class="xcard ind-card">
            <div class="xcard-head"><span class="xcard-ico ind-ico">@Icons.Svg("opportunity")</span><div><div class="xcard-title">@T("Indicadas por Vendedor", "Referred by Salesperson")</div><div class="xcard-sub">@_indByRep.Count @T("vendedor(es) · valor indicado", "salesperson(s) · referred value")</div></div><span class="xcard-total"><span>Total</span><b>@MoneyBrl(_indByRep.Sum(x => x.Value))</b></span><TelaCheia Ingles="_en" /></div>
            @{ var _indRepMax = _indByRep.Count > 0 ? _indByRep.Max(x => x.Value) : 1; }
            <div class="ibar scroll-y" style="max-height:300px">
