    private double _repAttain, _repAttainHsa;
    private int _repYear = DateTime.Today.Year;

    // Hero (Meta × Realizado do REPORT HSA), sensível ao filtro de mês.
    private double _heroReal, _heroMeta, _heroMetaHsa, _heroAttain, _heroAttainHsa;

    // Conversão de valores em R$ (REPORT HSA é nativo em R$) respeitando o toggle.
    private double CvBrl(double brl) => _currency == "BRL" ? brl : brl / Math.Max(Rate, 0.0001);
    private string MoneyBrl(double brl) => _sym + " " + Fmt.Compact(CvBrl(brl));

    // Métrica exibida nos gráficos, conforme o seletor "Filtrar por":
    // "conv" = Chance de conversão (Net Value × %ganho × %sair); senão Valor total.
    private double Metric(Opportunity o) => _valMetric == "conv" ? ForecastCalc.ConversionUsd(o) : o.AmountUsd;
    private string MetricLabel => _valMetric == "conv" ? "chance de conversão" : "valor total";

    // Agrupa oportunidades pelo VALOR real de um campo (não pelo catálogo),
    // somando a métrica ativa; rótulo via função de nome (com fallback ao texto cru).
    private List<SliceRow> GroupSlices(IEnumerable<Opportunity> src, Func<Opportunity, string> key, Func<string, string> name) =>
        src.GroupBy(o => key(o) ?? "")
           .Select(g => new SliceRow(g.Key == "" ? "—" : name(g.Key), g.Sum(Metric)))
           .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();

