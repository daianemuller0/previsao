    <a class="btn-link" href="/oportunidades">@T("Ver todas", "See all")</a>
</div>
<div class="c12" data-pnl="top10">
    <OpportunityTable Ingles="_en" Rows="_top10Opps" CssClass="tbl-compact" Style="max-height:340px;overflow:auto"
                      EmptyText="@T("Nenhuma oportunidade indicada na previsão ou marcada como TOP 10 no recorte.", "No opportunity referred to the forecast or marked as TOP 10 in the selection.")" OnChanged="ReloadOpps"
                      OnAbrirDetalhe="GuardarFiltros" ShowColumnPicker="false" />
</div>

@* ===================== 4 · COMPOSIÇÃO E PERFORMANCE ===================== *@
<div class="section-head" data-pnl="sec-composicao"><span class="st-title">@T("Composição e desempenho", "Composition and performance")</span><span class="st-line"></span></div>
<div class="g12">
    <div class="c12" data-pnl="composicao">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">@T("Composição da previsão", "Forecast composition") <span class="hint">@T("por % de ganho", "by win %")</span></div><TelaCheia Ingles="_en" /></div>
            <div class="comp-bar">
                @foreach (var c in _comp.Where(x => x.Value > 0))
                {
                    <div class="comp-seg" style="width:@Share(c.Value, _compTotal)%;background:@c.Color" title="@c.Band · @Money(c.Value)">@(c.Share >= 16 ? c.Band : "")</div>
                }
            </div>
            <div class="comp-list">
                @foreach (var c in _comp)
                {
                    <div class="comp-row">
                        <span class="comp-dot" style="background:@c.Color"></span>
                        <span><span class="comp-name">@c.Band</span> <span class="comp-sub">· @c.Count @T("op.", "opp.")</span></span>
                        <span class="comp-share">@Fmt.Pct(c.Share)</span>
                        <span class="comp-num">@Money(c.Value)</span>
                        <span class="delta @(c.Trend >= 0 ? "up" : "down")" style="font-size:11px">@XSigned(c.Trend)</span>
                    </div>
                }
            </div>
            <div class="comp-summary">
                <div class="cs"><div class="cs-l">@T("Pipeline elegível", "Eligible pipeline")</div><div class="cs-v">@Money(_eligiblePipeline)</div></div>
                <div class="cs"><div class="cs-l">@T("Meta restante", "Remaining target")</div><div class="cs-v">@Money(_remainingTarget)</div></div>
                <div class="cs"><div class="cs-l">@T("Índice de cobertura", "Coverage ratio")</div><div class="cs-v">@_coverageLabel</div></div>
            </div>
        </div>
    </div>
