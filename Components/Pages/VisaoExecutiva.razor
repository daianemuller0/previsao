    // Gera o .xlsx de uma lista de oportunidades (planilha completa, a mesma da
    // guia Oportunidades: todas as colunas da tabela e os demais campos) e entrega o download.
    private async Task ExportarXlsx(List<Opportunity> lista, string nome, string aba)
    {
        if (lista.Count == 0) return;
        var bytes = await Task.Run(() => OpportunityExcel.Gerar(lista, Cat, aba, _today));
        try
        {
            await JS.InvokeVoidAsync("appDownload", nome,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch { /* download indisponível: ignora */ }
    }

    // Opções dos filtros vindas dos DADOS reais (não do catálogo demo): valores
    // distintos presentes nas oportunidades, exibidos pelo nome do catálogo
    // (com fallback ao texto cru para dados importados).
    // Opções dos filtros = nomes resolvidos distintos presentes nos dados (o valor
    // do <option> é o próprio nome, igual ao rótulo dos gráficos e ao cross-filter).
    private IEnumerable<string> NameOptions(Func<Opportunity, string> key) =>
        _opps.Select(key).Where(s => !string.IsNullOrWhiteSpace(s) && s != "—")
             .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<string> KamOptions => NameOptions(KeyKam);
    private IEnumerable<string> MarketOptions => NameOptions(KeyMarket);
    private IEnumerable<string> CountryOptions => NameOptions(KeyCountry);
    private IEnumerable<string> ProductOptions => NameOptions(KeyProduct);
    private IEnumerable<string> CustomerOptions => NameOptions(KeyCustomer);
    private IEnumerable<string> BuIcOptions => NameOptions(o => o.BuOrigem);
    private IEnumerable<string> BuOptions => NameOptions(KeyBu);
    private IEnumerable<string> SegmentOptions => NameOptions(KeySegment);
    private IEnumerable<string> SubMarketOptions => NameOptions(KeySubMarket);
    private IEnumerable<string> StageOptions => NameOptions(KeyStage);

    private IEnumerable<Opportunity> Filtered()
    {
        IEnumerable<Opportunity> q = _opps;
        if (_markets.Count > 0) q = q.Where(o => _markets.Contains(KeyMarket(o)));
        if (_kams.Count > 0) q = q.Where(o => _kams.Contains(KeyKam(o)));
        if (_setores.Count > 0)
        {
            var cods = _setores.Select(SetorCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
            q = q.Where(o => cods.Contains(o.Setor ?? ""));
        }
        if (_countries.Count > 0) q = q.Where(o => _countries.Contains(KeyCountry(o)));
        if (_products.Count > 0) q = q.Where(o => _products.Contains(KeyProduct(o)));
        if (_customers.Count > 0) q = q.Where(o => _customers.Contains(KeyCustomer(o)));
        if (_buIcs.Count > 0) q = q.Where(o => _buIcs.Contains(o.BuOrigem));
        if (_bus.Count > 0) q = q.Where(o => _bus.Contains(KeyBu(o)));
        if (_commercial != "") q = q.Where(o => Eq(KeyCommercial(o), _commercial));
        if (_stage != "") q = q.Where(o => Eq(KeyStage(o), _stage));
        if (_segment != "") q = q.Where(o => Eq(KeySegment(o), _segment));
        if (_submarket != "") q = q.Where(o => Eq(KeySubMarket(o), _submarket));
        if (_years.Count > 0) q = q.Where(o => _years.Contains((o.ExpectedDateValue?.Year ?? 0).ToString()));
        if (_onlyIndicated) q = q.Where(o => o.IndicadaValue);
        if (_semOtp) q = q.Where(o => !Sim(o.Otp));
        if (_overdue) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date <= DateTime.Today.AddDays(-1));
        if (_onlyLost) q = q.Where(o => o.PerdidaValue);
        if (_onlyAltered) q = q.Where(AlteracoesCrm.Alterada);
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var b = _search.Trim().ToLowerInvariant();
            q = q.Where(o => (o.Name + o.ProposalNumber + Cat.CustomerName(o.CustomerId)).ToLowerInvariant().Contains(b));
        }
        if (SelectedMonths is { Count: > 0 } ms) q = q.Where(o => o.ExpectedDateValue is { } d && ms.Contains(d.Month));
        if (_valMin is { } vmin) q = q.Where(o => MetricBrl(o, _valMetric) >= vmin);
        if (_valMax is { } vmax) q = q.Where(o => MetricBrl(o, _valMetric) <= vmax);
        return q;
    }

    private void ClearFilters()
    {
        _commercial = _stage = _segment = _submarket = "";
        foreach (var s in AllSets) s.Clear();
        _onlyIndicated = false;
        _semOtp = false;
        _overdue = false;
        _onlyLost = false;
        _onlyAltered = false;
        _search = "";
        _valMin = _valMax = null; _valMetric = "total";
        GuardarFiltros();     // limpou de propósito: a memória acompanha
    }
    private void SaveView() { _savedMsg = true; }

    // Assinatura do que Build() consome. O Blazor redesenha a página por muitos
    // motivos — abrir um menu de filtro, o mouse num gráfico, a tabela mexendo no
    // próprio estado — e refazer 200 linhas de agrupamento em cima de milhares de
    // oportunidades em cada um desses renders é o que faz a tela travar.
    private string AssinaturaRecorte()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(_commercial).Append('|').Append(_stage).Append('|')
          .Append(_segment).Append('|').Append(_submarket).Append('|');
        foreach (var conj in AllSets)
        {
            foreach (var v in conj.OrderBy(x => x, StringComparer.Ordinal)) sb.Append(v).Append(',');
            sb.Append('|');
        }
        sb.Append(_search).Append('|').Append(_onlyIndicated).Append('|').Append(_semOtp).Append('|').Append(_overdue).Append('|')
          .Append(_onlyLost).Append('|').Append(_onlyAltered).Append('|')
          .Append(_en ? "en" : "pt").Append('|')   // os gráficos montados em texto (SVG/HTML) são refeitos no idioma novo
          .Append(_currency).Append('|').Append(TaxaTelaAtiva?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "").Append('|').Append(_chartMode).Append('|').Append(_valMetric).Append('|')
          .Append(_valMin).Append('|').Append(_valMax).Append('|')
          // Identidade dos dados: recarga da base ou edição numa linha invalidam.
          .Append(_opps.Count).Append('|').Append(Repo.LoadedAt.Ticks);
        return sb.ToString();
    }

    private string _assinaturaBuild = "";

    private void Build()
    {
        RecarregarChartPrefs();      // alguém ajustou um gráfico: relê antes de desenhar

        // Nada do que interessa mudou desde o último cálculo: a tela já está certa.
        var assinatura = AssinaturaRecorte();
        if (assinatura == _assinaturaBuild) return;
        _assinaturaBuild = assinatura;

        _sym = _currency == "BRL" ? "R$" : "US$";
        // Ano de referência: o selecionado no filtro, ou o ano atual quando "Todos".
        _year = _yearFilter > 0 ? _yearFilter : _today.Year;
        _month = _today.Month; _quarter = Fmt.QuarterOf(_month);
        _activeFilters = new[] { _commercial, _stage, _segment, _submarket }.Count(s => s != "")
            + AllSets.Count(s => s.Count > 0)
            + (_onlyIndicated ? 1 : 0)
            + (_semOtp ? 1 : 0)
            + (_overdue ? 1 : 0)
            + (_onlyLost ? 1 : 0)
            + (_onlyAltered ? 1 : 0)
            + (_search != "" ? 1 : 0)
            + (_valMin is not null || _valMax is not null ? 1 : 0);

        var opps = Filtered().ToList();
        _filtered = opps;
        _filteredSorted = opps.OrderByDescending(o => o.AmountBrl).Take(TetoTabela).ToList();

        // Funil de Vendas por Stage — valor = Amount (converted) em R$ (AmountBrl),
        // sobre TODO o recorte filtrado, em ordem decrescente de valor.
        _funnel = opps.GroupBy(KeyStage, StringComparer.OrdinalIgnoreCase)
            .Select(g => new FunnelRow(g.Key, g.Sum(o => o.AmountBrl), g.Count()))
            .Where(x => x.Value > 0).OrderBy(x => StageRank(x.Stage)).ThenByDescending(x => x.Value).ToList();
        _funnelTotal = Math.Max(_funnel.Sum(x => x.Value), 1);
        _funnelMax = Math.Max(_funnel.Count > 0 ? _funnel.Max(x => x.Value) : 1, 1);

        // Previsão Indicada — só as oportunidades marcadas pelo vendedor (no recorte).
        _indicadas = opps.Where(o => o.IndicadaValue).OrderByDescending(o => o.AmountBrl).ToList();
        _indTotal = _indicadas.Sum(o => o.AmountBrl);
        _indFunnel = _indicadas.GroupBy(KeyStage, StringComparer.OrdinalIgnoreCase)
            .Select(g => new FunnelRow(g.Key, g.Sum(o => o.AmountBrl), g.Count()))
            .Where(x => x.Value > 0).OrderBy(x => StageRank(x.Stage)).ThenByDescending(x => x.Value).ToList();
        _indByRep = GroupBrl(_indicadas, KeyKam);

        // Gráficos do funil (todos sobre o recorte filtrado, valor = Amount converted):
        _byRep = GroupBrl(opps, KeyKam);                 // linha por Vendedor (Outside Sales Rep)
        _bySegment = GroupBrl(opps, KeySegment);         // pizza por Commercial Segment
        _byMarketH = GroupBrl(opps, KeyMarket);          // barras horizontais por Market
        _bySubMarket = GroupBrl(opps, KeySubMarket);     // linha por Sub-Market
        _byBu2 = GroupBrl(opps, KeyBu);                  // pizza por Business Unit
        _bySetor = opps.GroupBy(KeySetor)                // pizza AFM × NB (por setor)
            .Select(g => new SliceRow(g.Key, g.Sum(Metric)))
            .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();
        _monthAmt = new double[12];                       // colunas por mês (Close Date)
        foreach (var o in opps)
            if (o.ExpectedDateValue is { } d && d.Month is >= 1 and <= 12)
                _monthAmt[d.Month - 1] += o.AmountBrl;

        // Hero: Meta × Realizado do REPORT HSA (guia Controle). Sem filtro de mês
        // mostra o total do ano; com filtro de mês mostra o mês selecionado.
        var hm = SelectedMonths;
        if (hm.Count > 0)
        {
            _heroReal = hm.Sum(m => _repReal[m - 1]);
            _heroRealizada = hm.Sum(m => _repRealizada[m - 1]);
            _heroMeta = hm.Sum(m => _repMeta[m - 1]);
            _heroMetaHsa = hm.Sum(m => _repMetaHsa[m - 1]);
        }
        else
        {
            _heroReal = _repReal.Sum();
            _heroRealizada = _repRealizada.Sum();
            _heroMeta = _repMeta.Sum();
            _heroMetaHsa = _repMetaHsa.Sum();
        }
        // Atingimento medido pelo número em foco (realizadas, quando houver).
        _heroAttain = _heroMeta > 0 ? FocoValor / _heroMeta * 100 : 0;
        _heroAttainHsa = _heroMetaHsa > 0 ? FocoValor / _heroMetaHsa * 100 : 0;

        // "Todos os anos" (_yearFilter == 0): considera qualquer oportunidade com
        // data; senão, restringe ao ano selecionado.
        bool InYear(Opportunity o) => _yearFilter == 0 ? o.ExpectedDateValue is not null : (o.ExpectedDateValue?.Year ?? 0) == _yearFilter;
        bool InMonth(Opportunity o) => InYear(o) && o.ExpectedDateValue!.Value.Month == _month;
        bool InQuarter(Opportunity o) => InYear(o) && Fmt.QuarterOf(o.ExpectedDateValue!.Value.Month) == _quarter;
        // Elegível ao forecast = toda oportunidade ABERTA (inclui Pipeline, que é
        // como a base importada chega). Antes só contava Commit/BestCase/Risk, o
        // que zerava os gráficos com dados reais.
        bool Eligible(Opportunity o) => ForecastCategories.IsOpen(o.Category);
        bool Open(Opportunity o) => ForecastCategories.IsOpen(o.Category);
        bool Won(Opportunity o) => o.Category == ForecastCategory.ClosedWon;
        double W(Opportunity o) => ForecastCalc.WeightedUsd(o);

        _fcMonth = opps.Where(o => InMonth(o) && Eligible(o)).Sum(W);
        // Previsão = somatória das oportunidades abertas (métrico ativo: valor total
        // ou chance de conversão) no trimestre / ano.
        _fcQuarter = opps.Where(o => InQuarter(o) && Eligible(o)).Sum(Metric);
        _fcYear = opps.Where(o => InYear(o) && Eligible(o)).Sum(Metric);
        // Meta do trimestre / ano puxada do REPORT HSA (Controle), não do catálogo demo.
        _metaQuarter = 0; for (var mi = (_quarter - 1) * 3; mi < _quarter * 3 && mi < 12; mi++) _metaQuarter += _repMeta[mi];
        _metaYear = _repMeta.Sum();
        _committedMonth = opps.Where(o => InMonth(o) && o.Category == ForecastCategory.Commit).Sum(W);
        _tgtMonth = Cat.TargetMonth(_year, _month);
        _tgtQuarter = Cat.TargetQuarter(_year, _quarter);
        _tgtYear = Cat.TargetYear(_year);
        _attainMonth = _tgtMonth > 0 ? _fcMonth / _tgtMonth * 100 : 0;

        _realizedYtd = opps.Where(o => Won(o) && InYear(o) && o.ExpectedDateValue!.Value.Month <= _month).Sum(o => o.AmountUsd);
        var tgtYtd = Enumerable.Range(1, _month).Sum(m => Cat.TargetMonth(_year, m));
        _attainYtd = tgtYtd > 0 ? _realizedYtd / tgtYtd * 100 : 0;
        var realizedYear = opps.Where(o => Won(o) && InYear(o)).Sum(o => o.AmountUsd);
        _attainYear = _tgtYear > 0 ? (realizedYear + _fcYear) / _tgtYear * 100 : 0;

        var open = opps.Where(Open).ToList();
        _openCount = open.Count;
        _pipelineTotal = open.Sum(o => o.AmountUsd);
        _pipelineWeighted = open.Sum(W);

        // Oportunidades mais quentes: entram APENAS as sinalizadas pelo vendedor —
        // indicadas na previsão OU marcadas com TOP 10 = "Sim". A ordem segue o
        // HeatScore (confiança + peso do valor). Todas as marcadas aparecem.
        var hotElegiveis = open.Where(o => o.IndicadaValue || Sim(o.Top10)).ToList();
        var maxHotBrl = hotElegiveis.Count > 0 ? hotElegiveis.Max(o => o.AmountBrl) : 0;
        _top10Opps = hotElegiveis
            .OrderByDescending(o => ForecastCalc.HeatScore(o, maxHotBrl))
            .ThenByDescending(o => o.AmountBrl)
            .ToList();
        var eligibleForecast = opps.Where(o => InYear(o) && Eligible(o)).ToList();
        _marginForecast = eligibleForecast.Sum(ForecastCalc.MarginUsd);
        _gmAvg = eligibleForecast.Count > 0 ? eligibleForecast.Average(o => o.GmPercentValue) : 0;

        _remainingTarget = Math.Max(_tgtYear - realizedYear, 1);
        _eligiblePipeline = open.Where(o => o.Category is ForecastCategory.Commit or ForecastCategory.BestCase or ForecastCategory.Pipeline).Sum(W);
        _coverage = ForecastCalc.Coverage(_eligiblePipeline, _remainingTarget);
        _coverageLabel = _coverage.ToString("0.0", CulturaTela) + "x";
        _gapYear = ForecastCalc.Gap(_tgtYear, realizedYear, _fcYear);

        var risky = open.Where(o => ForecastCalc.Level(o, _today) is RiskLevel.Alto or RiskLevel.Critico).ToList();
        _atRisk = risky.Sum(W); _atRiskCount = risky.Count;
        _concentration = ForecastCalc.Concentration(open, o => o.CustomerId);
        var topC = open.GroupBy(o => o.CustomerId).OrderByDescending(g => g.Sum(o => o.AmountUsd)).FirstOrDefault();
        _topCustomer = topC != null ? Cat.CustomerName(topC.Key) : "—";
        _dq = (int)Math.Round(open.Count == 0 ? 100 : open.Average(DataQuality));

        // Evolução sintética (demonstração) e deltas.
        double[] Evo(double v) => new[] { v * 0.86, v * 0.91, v * 0.97, v };
        _evoMonth = Evo(_fcMonth); _evoQuarter = Evo(_fcQuarter); _evoYear = Evo(_fcYear);
        _fcMonthDelta = Delta(_evoMonth); _fcQuarterDelta = Delta(_evoQuarter); _fcYearDelta = Delta(_evoYear);

        BuildHealth(open);

        // Composição por FAIXA DE % DE GANHO (win probability).
        var bands = new (string Band, string BandEn, string Color, double Lo, double Hi)[]
        {
            ("Muito alta", "Very high", "#1f9254", 85, 101),
            ("Alta", "High", "#1665a8", 70, 85),
            ("Média", "Medium", "#b7791f", 45, 70),
            ("Baixa", "Low", "#64748b", 0, 45),
        };
        var compRaw = bands.Select(b =>
        {
            var items = open.Where(o => { var c = o.WinProbabilityValue; return c >= b.Lo && c < b.Hi; }).ToList();
            return (b.Band, b.BandEn, b.Color, Value: items.Sum(Metric), Count: items.Count);
        }).ToList();
        _compTotal = Math.Max(compRaw.Sum(x => x.Value), 1);
        // A tendência segue calculada sobre o nome em português (mesmo número nos dois idiomas).
        _comp = compRaw.Select(x => new CompRow(T(x.Band, x.BandEn), x.Color, x.Value, x.Count, x.Value / _compTotal * 100, PseudoTrend(x.Band, 6))).ToList();

        // Distribuição da carteira — agrupa pelos VALORES reais dos campos das
        // oportunidades (com nome do catálogo quando houver), não iterando o
        // catálogo demo por Id. Assim funciona com a base importada.
        var eligYear = opps.Where(o => InYear(o) && Eligible(o)).ToList();
        _byBu = GroupSlices(eligYear, o => o.PvBusinessUnitId, Cat.BuCode);

        _byQuarter = new double[4];
        foreach (var o in eligYear) _byQuarter[(o.ExpectedDateValue!.Value.Month - 1) / 3] += Metric(o);

        _byCountry = GroupSlices(eligYear, o => o.CountryId, Cat.CountryName);
        _maxCountry = Math.Max(_byCountry.Count > 0 ? _byCountry.Max(x => x.Value) : 1, 1);
        _countryTotal = Math.Max(_byCountry.Sum(x => x.Value), 1);

        var gmSum = new double[12]; var gmCnt = new int[12];
        foreach (var o in eligYear)
        {
            var mi = o.ExpectedDateValue!.Value.Month - 1;
            gmSum[mi] += o.GmPercentValue; gmCnt[mi]++;
        }
        _gmMonthly = new double[12];
        for (var m = 0; m < 12; m++) _gmMonthly[m] = gmCnt[m] > 0 ? gmSum[m] / gmCnt[m] : 0;

        // Mercado / produto — agrupados pelo NOME resolvido (consolida id do
        // catálogo + texto cru do mesmo mercado numa única barra).
        _byMarket = eligYear.GroupBy(o => DisplayKey(o.MarketId, Cat.MarketName), StringComparer.OrdinalIgnoreCase)
            .Select(g => new MarketRow(g.Key, g.Sum(Metric), PseudoTrend(g.Key, 14)))
            .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();
        _marketTotal = Math.Max(_byMarket.Sum(x => x.Value), 1);
        _maxMarket = Math.Max(_byMarket.Count > 0 ? _byMarket.Max(x => x.Value) : 1, 1);
        _marketTopRise = _byMarket.Count > 0 ? _byMarket.OrderByDescending(x => x.Trend).First().Name : "";
        _marketTopFall = _byMarket.Count > 0 ? _byMarket.OrderBy(x => x.Trend).First().Name : "";

        _byProduct = eligYear.GroupBy(o => DisplayKey(o.ProductId, Cat.ProductName), StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var items = g.ToList();
                return new ProductRow(g.Key, items.Sum(Metric),
                    items.Average(o => o.GmPercentValue), PseudoTrend(g.Key, 12));
            })
            .Where(x => x.Value > 0).OrderByDescending(x => x.Value).ToList();
        _maxProduct = Math.Max(_byProduct.Count > 0 ? _byProduct.Max(x => x.Value) : 1, 1);
        _productTotal = Math.Max(_byProduct.Sum(x => x.Value), 1);

        // KAM com coverage e status — agrupado pelos KAMs reais das oportunidades.
        _byKam = eligYear.GroupBy(KeyKam, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var name = g.Key;
                var f = g.Sum(Metric);
                var t = Cat.TargetYear(_year, "kam", g.First().KamId ?? "");
                var cov = t > 0 ? f / t : 0;
                var (st, css) = t <= 0 ? (T("Sem meta", "No target"), "st-neutral")
                    : cov >= 1 ? (T("Dentro da meta", "On target"), "st-pos")
                    : cov >= 0.75 ? (T("Atenção", "Attention"), "st-warn")
                    : (T("Abaixo da meta", "Below target"), "st-neg");
                return new KamRow(name, f, t, t - f, cov, st, css);
            })
            .Where(x => x.Forecast > 0).OrderByDescending(x => x.Forecast).ToList();

        BuildWaterfall();
        BuildInsights(opps, open, eligibleForecast);
        BuildAttention(opps, open, risky);

        // Combo chart (12 meses).
        _mTarget = new double[12]; _mReal = new double[12]; _mForecast = new double[12]; _mCumul = new double[12];
        for (var m = 0; m < 12; m++) _mTarget[m] = Cat.TargetMonth(_year, m + 1);
        foreach (var o in opps.Where(InYear))
        {
            var mi = o.ExpectedDateValue!.Value.Month - 1;
            if (Won(o)) _mReal[mi] += o.AmountUsd;
            else if (Eligible(o)) _mForecast[mi] += Metric(o);
        }
        double run = 0;
        for (var m = 0; m < 12; m++) { run += _mReal[m] + _mForecast[m]; _mCumul[m] = run; }
    }

    private static double Delta(double[] s) => s.Length > 1 && s[0] > 0 ? (s[^1] - s[0]) / s[0] * 100 : 0;
    private static double PseudoTrend(string s, int span) => ((s.Length * 7 + (s.Length > 0 ? s[0] : 0)) % (span * 2 + 1)) - span;

    private void BuildHealth(List<Opportunity> open)
    {
        var withMgr = open.Where(o => o.ManagerProbabilityValue is not null).ToList();
        var biasAbs = withMgr.Count > 0 ? withMgr.Average(o => Math.Abs(o.WinProbabilityValue - o.ManagerProbabilityValue!.Value)) : 8;
        int accuracy = (int)Math.Clamp(95 - biasAbs, 50, 96);
        int coverageScore = (int)Math.Clamp(_coverage / 3.5 * 100, 10, 100);
        int marginScore = (int)Math.Clamp(_gmAvg / 25.0 * 100, 10, 100);
        int riskScore = (int)Math.Clamp(100 - _atRisk / Math.Max(_pipelineWeighted, 1) * 100, 10, 100);
        int discipline = open.Count > 0 ? (int)Math.Round((double)open.Count(o => ForecastCalc.DaysSinceUpdate(o, _today) <= 21) / open.Count * 100) : 100;

        _healthMetrics = new()
        {
            new(T("Precisão da previsão", "Forecast accuracy"), accuracy),
            new(T("Qualidade dos dados", "Data quality"), _dq),
            new(T("Cobertura de pipeline", "Pipeline coverage"), coverageScore),
            new(T("Saúde da margem", "Margin health"), marginScore),
            new(T("Exposição ao risco", "Risk exposure"), riskScore),
            new(T("Disciplina de atualização", "Update discipline"), discipline),
        };
        _health = (int)Math.Round(accuracy * 0.2 + _dq * 0.15 + coverageScore * 0.2 + marginScore * 0.15 + riskScore * 0.15 + discipline * 0.15);
        _healthLabel = _health >= 85 ? T("Saudável", "Healthy") : _health >= 70 ? T("Atenção", "Attention") : T("Em risco", "At risk");
        _confidence = (accuracy + discipline) / 2;
    }

    private double DataQuality(Opportunity o)
    {
        double s = 0; const double each = 100.0 / 8;
        if (!string.IsNullOrWhiteSpace(o.CustomerId)) s += each;
        if (!string.IsNullOrWhiteSpace(o.ProductId)) s += each;
        if (o.ExpectedDateValue is not null) s += each;
        if (o.AmountUsd > 0) s += each;
        if (o.WinProbabilityValue is > 0 and <= 100) s += each;
        if (!string.IsNullOrWhiteSpace(o.NextAction)) s += each;
        if (ForecastCalc.DaysSinceUpdate(o, _today) <= 21) s += each;
        if (!string.IsNullOrWhiteSpace(o.PipelineStageId)) s += each;
        return s;
    }

    private void BuildWaterfall()
    {
        var b = _pipelineWeighted;
        _waterfall = new()
        {
            new(T("Anterior", "Previous"), b * 0.94, true),
            new(T("Novas oport.", "New opps."), b * 0.10, false),
            new(T("+ Valor", "+ Value"), b * 0.05, false),
            new("+ Prob.", b * 0.04, false),
            new("− Prob.", -b * 0.04, false),
            new(T("Postergadas", "Postponed"), -b * 0.05, false),
            new(T("Perdidas", "Lost"), -b * 0.04, false),
            new(T("Atual", "Current"), b, true),
        };
        _moveNet = b - b * 0.94;
        var deltas = _waterfall.Where(x => !x.Total).ToList();
        _movePosName = deltas.Count > 0 ? deltas.OrderByDescending(x => x.Value).First().Label : "—";
        _moveNegName = deltas.Count > 0 ? deltas.OrderBy(x => x.Value).First().Label : "—";
    }

    private void BuildInsights(List<Opportunity> opps, List<Opportunity> open, List<Opportunity> eligible)
    {
        _insights = new();

        var marginGap = 30 - _gmAvg;
        if (marginGap > 0)
            _insights.Add(new(T("Margem", "Margin"), "warn",
                T("Margem prevista abaixo da meta", "Forecast margin below target"),
                T($"A margem estimada está {marginGap.ToString("0.0", _pt)} p.p. abaixo do objetivo de 30%.",
                  $"The estimated margin is {marginGap.ToString("0.0", EnUs)} pp below the 30% goal."),
                T($"-{marginGap.ToString("0.0", _pt)} p.p.", $"-{marginGap.ToString("0.0", EnUs)} pp"),
                T("Revisar preços e condições comerciais", "Review pricing and commercial terms"), "/oportunidades"));

        var staleCommit = opps.Count(o => o.Category == ForecastCategory.Commit && ForecastCalc.DaysSinceUpdate(o, _today) > 30);
        if (staleCommit > 0)
            _insights.Add(new(T("Risco", "Risk"), "neg",
                T("Comprometido sem atualização recente", "Commit with no recent update"),
                T($"{staleCommit} oportunidade(s) em Comprometido sem atualização há mais de 30 dias.",
                  $"{staleCommit} opportunity(ies) in Commit with no update for more than 30 days."),
                staleCommit.ToString(), T("Validar na revisão comercial", "Validate in the commercial review"), "/oportunidades"));

        if (_coverage < 3.5)
            _insights.Add(new("Pipeline", "warn",
                T("Cobertura de pipeline abaixo do ideal", "Pipeline coverage below ideal"),
                T($"A cobertura ({_coverageLabel}) está abaixo do nível ideal de 3,5x para o próximo trimestre.",
                  $"Coverage ({_coverageLabel}) is below the ideal level of 3.5x for the next quarter."),
                _coverageLabel, T("Gerar novo pipeline", "Generate new pipeline"), "/oportunidades"));
    }

    private void BuildAttention(List<Opportunity> opps, List<Opportunity> open, List<Opportunity> risky)
    {
        _attn = new();
        string Meta(Opportunity o) => $"{Cat.CustomerName(o.CustomerId)} · {Cat.KamName(o.KamId)}";

        var bigRisk = risky.OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (bigRisk != null)
            _attn.Add(new(T("Risco crítico", "Critical risk"), "neg", "alert", bigRisk.Name, Meta(bigRisk), Money(bigRisk.AmountUsd),
                T($"Sem interação recente e com probabilidade em {bigRisk.WinProbabilityValue:0}% · risco {RiskLevels.Label(ForecastCalc.Level(bigRisk, _today))}.",
                  $"No recent interaction and probability at {bigRisk.WinProbabilityValue:0}% · {RiscoEn(ForecastCalc.Level(bigRisk, _today))} risk."),
                T("Agendar acompanhamento executivo.", "Schedule an executive follow-up."), bigRisk.Id));

        var upside = open.Where(o => o.Category is ForecastCategory.Upside or ForecastCategory.BestCase && o.WinProbabilityValue < 60)
            .OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (upside != null)
            _attn.Add(new(T("Maior oportunidade adicional", "Largest upside opportunity"), "pos", "trend", upside.Name, Meta(upside), Money(upside.AmountUsd),
                T($"Potencial adicional relevante com probabilidade em {upside.WinProbabilityValue:0}%.",
                  $"Relevant additional potential with probability at {upside.WinProbabilityValue:0}%."),
                T("Priorizar recursos técnicos e comerciais.", "Prioritize technical and commercial resources."), upside.Id));

        var stale = open.Where(o => ForecastCalc.DaysSinceUpdate(o, _today) >= 30).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (stale != null)
            _attn.Add(new(T("Sem atualização", "No update"), "warn", "clock", stale.Name, Meta(stale), Money(stale.AmountUsd),
                T($"Sem atualização há {ForecastCalc.DaysSinceUpdate(stale, _today)} dias.",
                  $"No update for {ForecastCalc.DaysSinceUpdate(stale, _today)} days."),
                T("Solicitar atualização de status ao KAM.", "Ask the KAM for a status update."), stale.Id));

        var noAction = open.Where(o => string.IsNullOrWhiteSpace(o.NextAction)).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (noAction != null)
            _attn.Add(new(T("Sem próxima ação", "No next action"), "info", "flag", noAction.Name, Meta(noAction), Money(noAction.AmountUsd),
                T("Oportunidade prevista sem próxima ação definida.", "Forecast opportunity with no next action defined."),
                T("Definir e agendar a próxima ação comercial.", "Define and schedule the next commercial action."), noAction.Id));

        var lowMargin = open.Where(o => o.GmPercentValue < 18).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (lowMargin != null)
            _attn.Add(new(T("Margem baixa", "Low margin"), "neg", "dollar", lowMargin.Name, Meta(lowMargin), Money(lowMargin.AmountUsd),
                T($"Margem em {lowMargin.GmPercentValue:0}%, abaixo do limite mínimo.",
                  $"Margin at {lowMargin.GmPercentValue:0}%, below the minimum threshold."),
                T("Revisar escopo e precificação antes de avançar.", "Review scope and pricing before moving forward."), lowMargin.Id));

        if (_concentration > 0.30)
            _attn.Add(new(T("Concentração", "Concentration"), "warn", "layers", T("Concentração excessiva de pipeline", "Excessive pipeline concentration"),
                T($"Maior cliente: {_topCustomer}", $"Largest customer: {_topCustomer}"), PctTxt(_concentration * 100),
                T($"{PctTxt(_concentration * 100)} do pipeline aberto está em um único cliente.",
                  $"{PctTxt(_concentration * 100)} of the open pipeline is in a single customer."),
                T("Ampliar cobertura para outros clientes/mercados.", "Expand coverage to other customers/markets."), ""));
    }

    // Nível de risco em inglês (RiskLevels.Label é só português).
    private static string RiscoEn(RiskLevel r) => r switch
    {
        RiskLevel.Baixo => "low", RiskLevel.Moderado => "moderate", RiskLevel.Alto => "high", RiskLevel.Critico => "critical",
        _ => r.ToString(),
    };

    private static string SevColor(string sev) => sev switch
    {
        "neg" => "var(--neg)", "warn" => "var(--warn)", "pos" => "var(--pos)", _ => "var(--info)",
    };
    private static string CatColor(ForecastCategory c) => c switch
    {
        ForecastCategory.Commit => "#1f9254",
        ForecastCategory.BestCase => "#1665a8",
        ForecastCategory.Pipeline => "#5b6b82",
        ForecastCategory.Upside => "#0f766e",
        ForecastCategory.Risk => "#b4590a",
        _ => "#5b6b82",
    };

    // Combo chart em SVG: barras (realizado + forecast), meta em traço, acumulado/projeção
    // em linha, mês atual destacado, tooltips nativos. Respeita moeda e modo selecionados.
    private RenderFragment RenderComboChart() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 240, top = 12, bot = 210, left = 8, colW = (Wd - left) / 12.0;
        bool cumul = _chartMode == "cumulative";

        double[] real = new double[12], fc = new double[12];
        double rr = 0, ff = 0;
        for (var m = 0; m < 12; m++)
        {
            if (cumul) { rr += _mReal[m]; ff += _mForecast[m]; real[m] = Cv(rr); fc[m] = Cv(ff); }
            else { real[m] = Cv(_mReal[m]); fc[m] = Cv(_mForecast[m]); }
        }
        double[] tgt = new double[12]; double trun = 0;
        for (var m = 0; m < 12; m++) { trun += _mTarget[m]; tgt[m] = cumul ? Cv(trun) : Cv(_mTarget[m]); }

        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, Math.Max(tgt[m], real[m] + fc[m]));
        max *= 1.06;
        double Y(double v) => bot - v / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='{T("Previsão x Meta x Realizado", "Forecast x Target x Actual")}'>");
        for (var g = 1; g <= 3; g++) { var gy = top + (bot - top) * g / 4.0; sb.Append($"<line x1='{left}' y1='{gy.ToString("0.#", inv)}' x2='{Wd}' y2='{gy.ToString("0.#", inv)}' stroke='#f0f3f8'/>"); }
        sb.Append($"<line x1='{left}' y1='{bot.ToString(inv)}' x2='{Wd}' y2='{bot.ToString(inv)}' stroke='#e3e9f2'/>");

        // destaque do mês atual
        double hx = left + (_month - 1) * colW;
        sb.Append($"<rect x='{hx.ToString("0.#", inv)}' y='{top.ToString(inv)}' width='{colW.ToString("0.#", inv)}' height='{(bot - top).ToString("0.#", inv)}' fill='#0b4f8a' opacity='0.05'/>");

        var cumPts = new List<string>();
        for (var m = 0; m < 12; m++)
        {
            double cx = left + m * colW + colW / 2;
            double bw = colW * 0.58;
            double realTop = Y(real[m]); double fcTop = Y(real[m] + fc[m]);
            var tip = $"{MesNome(m + 1)} · {T("Realizado", "Actual")} {_sym} {Compacto(real[m])} · {T("Previsão", "Forecast")} {_sym} {Compacto(fc[m])} · {T("Meta", "Target")} {_sym} {Compacto(tgt[m])}";
            sb.Append($"<g><title>{tip}</title>");
            if (real[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{realTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(bot - realTop).ToString("0.#", inv)}' fill='#0b4f8a' rx='1.5'/>");
            if (fc[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{fcTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(realTop - fcTop).ToString("0.#", inv)}' fill='#6ba7d6' rx='1.5'/>");
            double ty = Y(tgt[m]);
            sb.Append($"<line x1='{(cx - bw / 2 - 3).ToString("0.#", inv)}' y1='{ty.ToString("0.#", inv)}' x2='{(cx + bw / 2 + 3).ToString("0.#", inv)}' y2='{ty.ToString("0.#", inv)}' stroke='#009496' stroke-width='2.5' stroke-linecap='round'/>");
            sb.Append("</g>");
            cumPts.Add($"{cx.ToString("0.#", inv)},{Y(Cv(_mCumul[m])).ToString("0.#", inv)}");
            var lblColor = (m + 1) == _month ? "#0b4f8a" : "#93a1b5";
            var lblWeight = (m + 1) == _month ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 6).ToString(inv)}' text-anchor='middle' font-size='9' font-weight='{lblWeight}' fill='{lblColor}'>{MesNome(m + 1)}</text>");
        }
        // acumulado (linha cheia até o mês atual, pontilhada na projeção futura)
        var past = cumPts.Take(_month).ToList();
        var future = cumPts.Skip(Math.Max(_month - 1, 0)).ToList();
        sb.Append($"<polyline points='{string.Join(' ', past)}' fill='none' stroke='#c0392b' stroke-width='1.7' opacity='0.85'/>");
        sb.Append($"<polyline points='{string.Join(' ', future)}' fill='none' stroke='#c0392b' stroke-width='1.6' stroke-dasharray='3 3' opacity='0.6'/>");
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Gráfico de linha da previsão mensal: linha + área preenchida + rótulos de
    // valor acima de cada ponto e nomes dos meses no eixo. Mês atual destacado.
    // Construído como string SVG (evita o erro RZ1023 de <text> em Razor).
    private RenderFragment RenderMonthlyLine() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 260, top = 34, bot = 214, left = 40, right = 20;
        double plotW = Wd - left - right;
        double colW = plotW / 11.0; // 12 pontos → 11 intervalos

        // Valores por mês (realizado + forecast ponderado), na moeda ativa.
        double[] v = new double[12];
        for (var m = 0; m < 12; m++) v[m] = Cv(_mReal[m] + _mForecast[m]);
        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, v[m]);
        max *= 1.18; // respiro para os rótulos acima dos pontos
        double X(int m) => left + m * colW;
        double Y(double val) => bot - val / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='{T("Previsão mensal", "Monthly forecast")}'>");

        // gradiente da área
        sb.Append("<defs><linearGradient id='mlarea' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append("<stop offset='0%' stop-color='#007A9E' stop-opacity='0.28'/>");
        sb.Append("<stop offset='100%' stop-color='#007A9E' stop-opacity='0.02'/>");
        sb.Append("</linearGradient></defs>");

        // linhas de grade horizontais
        for (var g = 0; g <= 4; g++)
        {
            var gy = top + (bot - top) * g / 4.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
        }

        // destaque do mês atual (faixa vertical)
        double hx = X(_month - 1);
        sb.Append($"<line x1='{hx.ToString("0.#", inv)}' y1='{top.ToString(inv)}' x2='{hx.ToString("0.#", inv)}' y2='{bot.ToString(inv)}' stroke='#007A9E' stroke-width='1' stroke-dasharray='3 3' opacity='0.35'/>");

        // área preenchida
        var line = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++)
            line.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(v[m]).ToString("0.#", inv)}");
        var area = $"{left.ToString(inv)},{bot.ToString(inv)} {line} {(Wd - right).ToString(inv)},{bot.ToString(inv)}";
        sb.Append($"<polygon points='{area}' fill='url(#mlarea)'/>");

        // linha principal
        sb.Append($"<polyline points='{line}' fill='none' stroke='#007A9E' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>");

        // pontos + rótulos de valor + meses
        for (var m = 0; m < 12; m++)
        {
            double cx = X(m), cy = Y(v[m]);
            bool cur = (m + 1) == _month;
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{cy.ToString("0.#", inv)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='#007A9E' stroke-width='{(cur ? "3" : "2")}'/>");
            var lblColor = cur ? "#0b4f6f" : "#5b6b82";
            var lblWeight = cur ? "700" : "500";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(cy - 10).ToString("0.#", inv)}' text-anchor='middle' font-size='9.5' font-weight='{lblWeight}' fill='{lblColor}'>{Compacto(v[m])}</text>");
            var mColor = cur ? "#007A9E" : "#93a1b5";
            var mWeight = cur ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 8).ToString(inv)}' text-anchor='middle' font-size='9.5' font-weight='{mWeight}' fill='{mColor}'>{MesNome(m + 1)}</text>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Gráfico de linhas Vendas x Meta (NB+AFM), puxando o REPORT HSA do Controle.
    // Quatro linhas: vendas realizadas, vendas reportadas, Meta/Budget
    // (tracejada) e Meta Vendas HSA (pontilhada). A ÊNFASE — área sob a curva,
    // traço mais grosso e os valores escritos acima dos pontos — fica com as
    // realizadas; sem elas lançadas no Controle, volta para as reportadas.
    // Valores em R$ (moeda nativa do Controle), construído como string SVG.
    private RenderFragment RenderReportLine() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 760, H = 280, top = 46, bot = 236, left = 46, right = 18;
        double plotW = Wd - left - right, colW = plotW / 11.0;
        double max = 1;
        for (var m = 0; m < 12; m++)
            max = Math.Max(max, Math.Max(Math.Max(_repReal[m], _repRealizada[m]), Math.Max(_repMeta[m], _repMetaHsa[m])));
        max *= 1.20;
        double X(int m) => left + m * colW;
        double Y(double val) => bot - val / max * (bot - top);
        const string cReal = "#007A9E", cVreal = "#8b5cf6", cMeta = "#b7791f", cMhsa = "#1f9254";

        // Quem manda no gráfico são as realizadas; sem elas, as reportadas.
        var foco = TemRealizada;
        var focoSerie = foco ? _repRealizada : _repReal;
        var outraSerie = foco ? _repReal : _repRealizada;
        var cFoco = foco ? cVreal : cReal;
        var cOutra = foco ? cReal : cVreal;
        var nomeFoco = foco ? T("Vendas realizadas", "Actual sales") : T("Vendas reportadas", "Reported sales");
        var nomeOutra = foco ? T("Vendas reportadas", "Reported sales") : T("Vendas realizadas", "Actual sales");

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='{T("Vendas x Meta NB+AFM", "Sales x Target NB+AFM")}'>");

        sb.Append("<defs><linearGradient id='rlarea' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append($"<stop offset='0%' stop-color='{cFoco}' stop-opacity='0.24'/><stop offset='100%' stop-color='{cFoco}' stop-opacity='0.02'/>");
        sb.Append("</linearGradient></defs>");

        // legenda
        void Legenda(double dx, string cor, string traco, string texto)
        {
            var risco = traco == "" ? "" : $" stroke-dasharray='{traco}'";
            sb.Append($"<line x1='{(left + dx).ToString(inv)}' y1='20' x2='{(left + dx + 20).ToString(inv)}' y2='20' stroke='{cor}' stroke-width='3'{risco} stroke-linecap='round'/>");
            sb.Append($"<text x='{(left + dx + 26).ToString(inv)}' y='23.5' font-size='10.5' font-weight='600' fill='#3b4a61'>{Esc(texto)}</text>");
        }
        Legenda(0, cFoco, "", nomeFoco);
        Legenda(160, cOutra, "", nomeOutra);
        Legenda(325, cMeta, "5 3", T("Meta NB+AFM", "Target NB+AFM"));
        Legenda(460, cMhsa, "2 3", T("Meta Vendas HSA", "HSA Sales Target"));

        // grade + rótulos do eixo Y
        for (var g = 0; g <= 4; g++)
        {
            double gy = top + (bot - top) * g / 4.0, gv = max * (4 - g) / 4.0;
            sb.Append($"<line x1='{left.ToString(inv)}' y1='{gy.ToString("0.#", inv)}' x2='{(Wd - right).ToString(inv)}' y2='{gy.ToString("0.#", inv)}' stroke='#eef2f7'/>");
            sb.Append($"<text x='{(left - 6).ToString(inv)}' y='{(gy + 3).ToString("0.#", inv)}' text-anchor='end' font-size='8.5' fill='#93a1b5'>{Esc(Compacto(gv))}</text>");
        }

        // destaque do mês atual
        double hx = X(_month - 1);
        sb.Append($"<line x1='{hx.ToString("0.#", inv)}' y1='{top.ToString(inv)}' x2='{hx.ToString("0.#", inv)}' y2='{bot.ToString(inv)}' stroke='{cFoco}' stroke-width='1' stroke-dasharray='3 3' opacity='0.3'/>");

        // Série em foco: área preenchida + traço grosso. A outra vai de linha fina.
        string Pontos(double[] serie)
        {
            var sbp = new System.Text.StringBuilder();
            for (var m = 0; m < 12; m++) sbp.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(serie[m]).ToString("0.#", inv)}");
            return sbp.ToString();
        }
        var lr = Pontos(focoSerie);
        sb.Append($"<polygon points='{left.ToString(inv)},{bot.ToString(inv)} {lr} {(Wd - right).ToString(inv)},{bot.ToString(inv)}' fill='url(#rlarea)'/>");
        sb.Append($"<polyline points='{lr}' fill='none' stroke='{cFoco}' stroke-width='2.8' stroke-linejoin='round' stroke-linecap='round'/>");

        if (outraSerie.Any(v => v > 0))
            sb.Append($"<polyline points='{Pontos(outraSerie)}' fill='none' stroke='{cOutra}' stroke-width='1.6' stroke-linejoin='round' stroke-linecap='round' opacity='0.85'/>");

        // linha Meta (tracejada)
        var lm = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lm.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repMeta[m]).ToString("0.#", inv)}");
        sb.Append($"<polyline points='{lm}' fill='none' stroke='{cMeta}' stroke-width='2' stroke-dasharray='5 3' stroke-linejoin='round' stroke-linecap='round'/>");

        // linha Meta Vendas HSA (pontilhada)
        var lh = new System.Text.StringBuilder();
        for (var m = 0; m < 12; m++) lh.Append($"{(m == 0 ? "" : " ")}{X(m).ToString("0.#", inv)},{Y(_repMetaHsa[m]).ToString("0.#", inv)}");
        sb.Append($"<polyline points='{lh}' fill='none' stroke='{cMhsa}' stroke-width='2' stroke-dasharray='2 3' stroke-linejoin='round' stroke-linecap='round'/>");

        // pontos + rótulos + meses
        for (var m = 0; m < 12; m++)
        {
            double cx = X(m), yf = Y(focoSerie[m]), yo = Y(outraSerie[m]), ym = Y(_repMeta[m]), yh = Y(_repMetaHsa[m]);
            bool cur = (m + 1) == _month;
            double att = _repMeta[m] > 0 && focoSerie[m] > 0 ? focoSerie[m] / _repMeta[m] * 100 : 0;
            var tip = $"{MesNome(m + 1)} · {nomeFoco} R$ {Compacto(focoSerie[m])}"
                    + (outraSerie[m] > 0 ? $" · {nomeOutra} R$ {Compacto(outraSerie[m])}" : "")
                    + $" · {T("Meta", "Target")} R$ {Compacto(_repMeta[m])} · {T("Meta HSA", "HSA target")} R$ {Compacto(_repMetaHsa[m])}"
                    + (att > 0 ? $" · {PctTxt(att)}" : "");

            if (_repMetaHsa[m] > 0) sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yh.ToString("0.#", inv)}' r='2.5' fill='{cMhsa}'><title>{Esc(tip)}</title></circle>");
            if (outraSerie[m] > 0) sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yo.ToString("0.#", inv)}' r='2.5' fill='{cOutra}'><title>{Esc(tip)}</title></circle>");
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{ym.ToString("0.#", inv)}' r='2.5' fill='{cMeta}'><title>{Esc(tip)}</title></circle>");
            sb.Append($"<circle cx='{cx.ToString("0.#", inv)}' cy='{yf.ToString("0.#", inv)}' r='{(cur ? "4.5" : "3")}' fill='#fff' stroke='{cFoco}' stroke-width='{(cur ? "3" : "2")}'><title>{Esc(tip)}</title></circle>");
            // O valor escrito acima do ponto é o do número em foco.
            if (focoSerie[m] > 0)
                sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(yf - 9).ToString("0.#", inv)}' text-anchor='middle' font-size='9' font-weight='{(cur ? "700" : "500")}' fill='{(cur ? "#0b4f6f" : "#5b6b82")}'>{Esc(Compacto(focoSerie[m]))}</text>");
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 7).ToString(inv)}' text-anchor='middle' font-size='9.5' font-weight='{(cur ? "700" : "400")}' fill='{(cur ? cFoco : "#93a1b5")}'>{MesNome(m + 1)}</text>");
        }

        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // Nome do país nos dados (PT / variações) -> nome no mapa-múndi (inglês).
    private static readonly Dictionary<string, string> CountryToMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["brasil"] = "Brazil", ["chile"] = "Chile", ["peru"] = "Peru", ["perú"] = "Peru",
        ["argentina"] = "Argentina", ["colombia"] = "Colombia", ["colômbia"] = "Colombia",
        ["bolivia"] = "Bolivia", ["bolívia"] = "Bolivia", ["venezuela"] = "Venezuela",
