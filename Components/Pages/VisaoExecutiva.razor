@page "/executivo"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject NavigationManager Nav

@{ Build(); }

@* ===================== 1 · CABEÇALHO EXECUTIVO ===================== *@
<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span>Previsão de Vendas</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Visão Executiva</span></div>

<div class="page-head">
    <div>
        <h1>Previsão de Vendas</h1>
        <p class="subtitle">
            @Fmt.MonthLong(_month) de @_year · @(_quarter)º trimestre · Howden Brasil · @_currency<br />
            Última consolidação @_updated.ToString("dd/MM/yyyy 'às' HH:mm") · Responsável: Ricardo Mendes
            &nbsp;·&nbsp; <span class="badge @DqCss">Qualidade dos dados @_dq%</span>
            &nbsp; <span class="badge @ConfCss">Confiança da previsão @_confidence%</span>
        </p>
    </div>
    <div class="page-actions">
        <div class="segmented" style="margin-right:2px">
            <button class="@(_currency == "USD" ? "active" : "")" @onclick='() => _currency = "USD"'>USD</button>
            <button class="@(_currency == "BRL" ? "active" : "")" @onclick='() => _currency = "BRL"'>BRL</button>
        </div>
        <a class="btn-ghost" href="/forecast/export" target="_blank" title="Exportar CSV">@Icons.Svg("download")Exportar</a>
        <a class="btn-primary" href="/forecast">@Icons.Svg("forecast")Abrir Previsão</a>
    </div>
</div>

@* ---- Filtros globais ---- *@
<div class="filterbar" style="position:static;margin:0 0 16px;border:1px solid var(--border);border-radius:var(--radius);">
    <div class="flt"><span class="flt-label">Ano</span><select><option>@_year</option></select></div>
    <div class="flt"><span class="flt-label">Mês</span><select @bind="_monthFilter"><option value="0">Todos</option>@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select></div>
    <div class="flt"><span class="flt-label">De</span><input class="flt-date" type="date" @bind="_dateFrom" /></div>
    <div class="flt"><span class="flt-label">Até</span><input class="flt-date" type="date" @bind="_dateTo" /></div>
    <div class="flt"><span class="flt-label">Mercado</span><select @bind="_market"><option value="">Todos</option>@foreach (var m in Cat.Markets){<option value="@m.Id">@m.Name</option>}</select></div>
    <div class="flt"><span class="flt-label">KAM</span><select @bind="_kam"><option value="">Todos</option>@foreach (var k in Cat.Kams){<option value="@k.Id">@k.Name</option>}</select></div>
    <div class="flt"><span class="flt-label">Categoria</span><select @bind="_catFilter"><option value="">Todas</option>@foreach (var c in Enum.GetValues<ForecastCategory>()){<option value="@c.ToString()">@ForecastCategories.Label(c)</option>}</select></div>
    @if (_showMore)
    {
        <div class="flt"><span class="flt-label">País</span><select @bind="_country"><option value="">Todos</option>@foreach (var c in Cat.Countries){<option value="@c.Id">@c.Name</option>}</select></div>
        <div class="flt"><span class="flt-label">Produto</span><select @bind="_product"><option value="">Todos</option>@foreach (var p in Cat.Products){<option value="@p.Id">@p.Name</option>}</select></div>
        <div class="flt"><span class="flt-label">Cliente</span><select @bind="_customer"><option value="">Todos</option>@foreach (var c in Cat.Customers){<option value="@c.Id">@c.Name</option>}</select></div>
        <div class="flt"><span class="flt-label">Unidade de negócio</span><select @bind="_bu"><option value="">Todas</option>@foreach (var b in Cat.BusinessUnits){<option value="@b.Id">@b.Code</option>}</select></div>
    }
    <button class="btn-link" @onclick="() => _showMore = !_showMore">@(_showMore ? "Menos filtros" : "Mais filtros")</button>
    <div class="filterbar-spacer"></div>
    @if (_activeFilters > 0)
    {
        <span class="tag">@_activeFilters ativo(s)</span>
        <button class="btn-link" @onclick="ClearFilters">Limpar</button>
    }
    <button class="btn-link" @onclick="SaveView">Salvar visualização</button>
    @if (_savedMsg) { <span class="saved-flag">@Icons.Svg("check")Salvo</span> }
</div>

@* ===================== 2 · HERO EXECUTIVO ===================== *@
<div class="hero">
    <div class="hero-main">
        <div class="hero-eyebrow">Previsão do mês · @Fmt.MonthLong(_month) @_year</div>
        <div class="hero-value"><span class="cur">@_sym</span>@Fmt.Compact(Cv(_fcMonth))</div>
        <div class="hero-target-line">Meta @Money(_tgtMonth) · @Fmt.Pct(_attainMonth) atingida · gap @Money(Math.Max(_tgtMonth - _fcMonth, 0))</div>
        <div class="hero-chips">
            <div class="hero-chip"><div class="k">vs previsão anterior</div><div class="v @(_fcMonthDelta >= 0 ? "pos" : "neg")">@Icons.Svg(_fcMonthDelta >= 0 ? "up" : "down")@Fmt.Signed(_fcMonthDelta)</div></div>
            <div class="hero-chip"><div class="k">vs mês anterior</div><div class="v @(_fcMonthMoM >= 0 ? "pos" : "neg")">@Fmt.Signed(_fcMonthMoM)</div></div>
            <div class="hero-chip"><div class="k">Comprometido</div><div class="v">@Money(_committedMonth)</div></div>
            <div class="hero-chip"><div class="k">Ponderado</div><div class="v">@Money(_fcMonth)</div></div>
        </div>
        <div class="hero-gauge">
            <div class="gt"><div class="gf" style="width:@Clamp(_attainMonth)%"></div></div>
            <div class="gl"><span>Atingimento da meta mensal</span><span>@Fmt.Pct(_attainMonth)</span></div>
        </div>
        <div class="hero-spark"><Sparkline Values="@_evoMonth" Stroke="#8fe3c4" /></div>
    </div>
    <div class="hero-side">
        <div class="panel-head" style="margin-bottom:8px">
            <div class="panel-title">Top 10 oportunidades mais quentes <span class="hint">maior confiança</span></div>
            <a class="btn-link" href="/oportunidades">Ver todas</a>
        </div>
        <div class="hot-list">
            @foreach (var h in _top10)
            {
                <a class="hot-item" href="@($"/oportunidades/{h.OppId}")">
                    <span class="hot-conf @ForecastCalc.ConfidenceBandCss(h.Confidence)">@h.Confidence.ToString("0")%</span>
                    <span class="hot-body">
                        <span class="hot-name" title="@h.Name">@h.Name</span>
                        <span class="hot-meta">@h.Customer · @h.Kam</span>
                    </span>
                    <span class="hot-val">@Money(h.ValueUsd)</span>
                </a>
            }
            @if (_top10.Count == 0) { <div class="empty">Sem oportunidades abertas.</div> }
        </div>
    </div>
</div>

@* ===================== KPIs SECUNDÁRIOS (2 níveis) ===================== *@
<div class="section-head"><span class="st-title">Indicadores estratégicos</span><span class="st-line"></span></div>
<div class="exec-grid cols-4">
    <StatCard Label="Previsão do trimestre" Value="@Money(_fcQuarter)" Delta="@_fcQuarterDelta" Context="@($"Meta {Money(_tgtQuarter)}")" AccentLeft="true">
        <div class="spark"><Sparkline Values="@_evoQuarter" Stroke="#007A9E" /></div>
    </StatCard>
    <StatCard Label="Previsão anual" Value="@Money(_fcYear)" Delta="@_fcYearDelta" Context="@($"Meta {Money(_tgtYear)}")" AccentLeft="true">
        <div class="spark"><Sparkline Values="@_evoYear" Stroke="#009496" /></div>
    </StatCard>
    <StatCard Label="Realizado acumulado no ano" Value="@Money(_realizedYtd)" DeltaText="@($"{Fmt.Pct(_attainYtd)} da meta no ano")" Context="Fechados (ganhos)" AccentLeft="true" />
    <StatCard Label="Previsão em risco" Value="@Money(_atRisk)" DeltaText="@($"{_atRiskCount} oportunidades de alto risco")" Context="exige decisão" AccentLeft="true" />
</div>
<div class="exec-grid cols-4 kpi-tier2" style="margin-top:2px">
    <StatCard Label="Pipeline total" Value="@Money(_pipelineTotal)" SmallValue="true" Context="@($"{_openCount} oportunidades abertas")" />
    <StatCard Label="Pipeline ponderado" Value="@Money(_pipelineWeighted)" SmallValue="true" Context="probabilidades aplicadas" />
    <StatCard Label="Margem prevista" Value="@Money(_marginForecast)" SmallValue="true" Context="@($"GM média {Fmt.Pct(_gmAvg)}")" />
    <StatCard Label="Cobertura de pipeline" Value="@_coverageLabel" SmallValue="true" DeltaText="@(_coverage >= 3.5 ? "no ideal" : "abaixo do ideal (3,5x)")" />
</div>

@* ===================== 3 · INSIGHTS EXECUTIVOS ===================== *@
<div class="section-head">
    <span class="st-title">@Icons.Svg("trend", "nav-ico") Insights executivos</span>
    <span class="st-sub">principais sinais</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/analises">Ver todos</a>
</div>
<div class="panel">
    <div class="insights insights-grid">
        @foreach (var i in _insights.Take(6))
        {
            <div class="insight sev-@i.Sev">
                <div class="insight-head"><span class="insight-cat">@i.Category</span><span class="insight-val" style="color:@SevColor(i.Sev)">@i.Value</span></div>
                <div class="insight-title">@i.Title</div>
                <div class="insight-detail">@i.Detail</div>
                <div class="insight-foot">
                    <span class="insight-action">@Icons.Svg("arrow-right")@i.Action</span>
                    <a class="insight-link" href="@i.Link">Detalhes</a>
                </div>
            </div>
        }
    </div>
</div>

@* ===================== 4 · COMPOSIÇÃO E PERFORMANCE ===================== *@
<div class="section-head"><span class="st-title">Composição e desempenho</span><span class="st-line"></span></div>
<div class="g12">
    <div class="c5">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Composição da previsão <span class="hint">por confiança · (% ganho + % período) ÷ 2</span></div></div>
            <div class="comp-bar">
                @foreach (var c in _comp.Where(x => x.Value > 0))
                {
                    <div class="comp-seg" style="width:@Share(c.Value, _compTotal)%;background:@c.Color" title="@c.Band · @Money(c.Value)">@(c.Share >= 16 ? c.Band : "")</div>
                }
            </div>
            <div class="comp-list">
                @foreach (var c in _comp)
                {
                    <div class="comp-row">
                        <span class="comp-dot" style="background:@c.Color"></span>
                        <span><span class="comp-name">@c.Band</span> <span class="comp-sub">· @c.Count op.</span></span>
                        <span class="comp-share">@Fmt.Pct(c.Share)</span>
                        <span class="comp-num">@Money(c.Value)</span>
                        <span class="delta @(c.Trend >= 0 ? "up" : "down")" style="font-size:11px">@Fmt.Signed(c.Trend)</span>
                    </div>
                }
            </div>
            <div class="comp-summary">
                <div class="cs"><div class="cs-l">Pipeline elegível</div><div class="cs-v">@Money(_eligiblePipeline)</div></div>
                <div class="cs"><div class="cs-l">Meta restante</div><div class="cs-v">@Money(_remainingTarget)</div></div>
                <div class="cs"><div class="cs-l">Índice de cobertura</div><div class="cs-v">@_coverageLabel</div></div>
            </div>
        </div>
    </div>
    <div class="c7">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão x Meta por KAM</div><a class="btn-link" href="/analises">Análise detalhada</a></div>
            <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
                <table class="grid-tbl">
                    <thead><tr><th>KAM</th><th class="right">Previsão</th><th class="right">Meta</th><th class="right">Gap</th><th class="right">Cobertura</th><th class="center">Status</th></tr></thead>
                    <tbody>
                        @foreach (var k in _byKam)
                        {
                            <tr class="clickable" @onclick='() => Nav.NavigateTo("/analises")'>
                                <td class="col-strong">@k.Name</td>
                                <td class="right num">@Money(k.Forecast)</td>
                                <td class="right num">@Money(k.Target)</td>
                                <td class="right num" style="color:@(k.Gap > 0 ? "var(--neg)" : "var(--pos)")">@Money(k.Gap)</td>
                                <td class="right num">@k.Coverage.ToString("0.0", _pt)x</td>
                                <td class="center"><span class="badge @k.StatusCss">@k.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="g12" style="margin-top:14px">
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão por mercado <span class="hint">participação · tendência</span></div></div>
            @foreach (var m in _byMarket)
            {
                <div class="bar-row">
                    <span class="bar-label">@m.Name
                        @if (m.Name == _marketTopRise) { <span class="tag" style="background:var(--pos-bg);color:var(--pos);margin-left:4px">▲ maior alta</span> }
                        else if (m.Name == _marketTopFall) { <span class="tag neg" style="margin-left:4px">▼ maior queda</span> }
                    </span>
                    <span class="bar-track"><span class="bar-fill c-primary" style="width:@Share(m.Value, _maxMarket)%"></span></span>
                    <span class="bar-value">@Money(m.Value) <span class="muted" style="font-weight:400">· @Fmt.Pct(m.Value / _marketTotal * 100)</span> <span class="delta @(m.Trend >= 0 ? "up" : "down")" style="font-size:10.5px">@Fmt.Signed(m.Trend)</span></span>
                </div>
            }
        </div>
    </div>
    <div class="c6">
        <div class="panel">
            <div class="panel-head"><div class="panel-title">Previsão por produto <span class="hint">participação · margem · tendência</span></div></div>
            @foreach (var p in _byProduct)
            {
                <div class="bar-row">
                    <span class="bar-label">@p.Name</span>
                    <span class="bar-track"><span class="bar-fill" style="width:@Share(p.Value, _maxProduct)%"></span></span>
                    <span class="bar-value">@Money(p.Value) <span class="muted" style="font-weight:400">· @Fmt.Pct(p.Value / _productTotal * 100) · GM @Fmt.Pct(p.Margin)</span> <span class="delta @(p.Trend >= 0 ? "up" : "down")" style="font-size:10.5px">@Fmt.Signed(p.Trend)</span></span>
                </div>
            }
        </div>
    </div>
</div>

@* ---- Comparativo AFM × NB + Previsão mensal ---- *@
<div class="g12" style="margin-top:14px">
    <div class="c5">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Aftermarket × New Business <span class="hint">por categoria comercial</span></div></div>
            @foreach (var cc in _byCommercial)
            {
                var destaque = cc.Code is "AFM" or "NB" ? "strong" : "";
                <div class="bar-row">
                    <span class="bar-label @destaque">@cc.Name <span class="muted" style="font-weight:400">· @cc.Code</span></span>
                    <span class="bar-track"><span class="bar-fill @(cc.Code == "AFM" ? "afm" : "c-primary")" style="width:@Share(cc.Value, _maxComm)%"></span></span>
                    <span class="bar-value">@Money(cc.Value)</span>
                </div>
            }
            <div class="muted" style="font-size:11px;margin-top:8px">Comparativo do forecast ponderado por categoria comercial (NB · RT · AFM · SV).</div>
        </div>
    </div>
    <div class="c7">
        <div class="panel" style="height:100%">
            <div class="panel-head"><div class="panel-title">Previsão mensal <span class="hint">realizado + forecast ponderado por mês · @_currency</span></div></div>
            @{ var maxMon = Enumerable.Range(0, 12).Select(m => _mReal[m] + _mForecast[m]).DefaultIfEmpty(0).Max(); if (maxMon <= 0) { maxMon = 1; } }
            @for (var m = 0; m < 12; m++)
            {
                var val = _mReal[m] + _mForecast[m];
                <div class="bar-row" style="grid-template-columns:56px 1fr auto">
                    <span class="bar-label @((m + 1) == _month ? "strong" : "")" style="@((m + 1) == _month ? "color:var(--primary)" : "")">@Fmt.MonthName(m + 1)</span>
                    <span class="bar-track"><span class="bar-fill c-primary" style="width:@Share(val, maxMon)%"></span></span>
                    <span class="bar-value">@Money(val)</span>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== 4b · OPORTUNIDADES ===================== *@
<div class="section-head">
    <span class="st-title">Oportunidades</span>
    <span class="st-sub">@_filtered.Count no recorte · @Money(_filtered.Sum(o => o.AmountUsd)) em valor</span>
    <span class="st-line"></span>
    <a class="btn-link" href="/oportunidades">Abrir listagem completa</a>
</div>
<div class="table-wrap">
    <table class="grid-tbl">
        <thead>
            <tr>
                <th>Oportunidade</th><th>Cliente / Planta</th><th>Categoria</th><th>Etapa</th>
                <th class="right">Valor R$</th><th class="right">Ganho</th><th class="right">Período</th><th class="right">Ponderado</th>
                <th class="nowrap">Data prev.</th><th class="center">Risco</th><th>Próx. ação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in _filtered.OrderByDescending(x => x.AmountUsd))
            {
                var lvl = ForecastCalc.Level(o, _today);
                <tr class="clickable" @onclick='() => Nav.NavigateTo($"/oportunidades/{o.Id}")'>
                    <td class="col-strong">@o.Name<div class="muted" style="font-size:11px">@o.ProposalNumber</div></td>
                    <td>@Cat.CustomerName(o.CustomerId)<div class="muted" style="font-size:11px">@Cat.PlantName(o.PlantId)</div></td>
                    <td><span class="badge @ForecastCategories.Css(o.Category)">@ForecastCategories.Label(o.Category)</span></td>
                    <td>@Cat.StageName(o.PipelineStageId)</td>
                    <td class="right num">@Money(o.AmountUsd)</td>
                    <td class="right num">@Fmt.Pct(o.WinProbabilityValue)</td>
                    <td class="right num">@Fmt.Pct(o.CloseProbabilityValue)</td>
                    <td class="right num">@Money(ForecastCalc.WeightedUsd(o))</td>
                    <td class="nowrap">@Fmt.Date(o.ExpectedDate)</td>
                    <td class="center"><span class="badge @RiskLevels.Css(lvl)">@RiskLevels.Label(lvl)</span></td>
                    <td>@(string.IsNullOrWhiteSpace(o.NextAction) ? "—" : o.NextAction)</td>
                </tr>
            }
            @if (_filtered.Count == 0)
            {
                <tr><td colspan="11" class="empty">Nenhuma oportunidade no recorte.</td></tr>
            }
        </tbody>
    </table>
</div>

@* ===================== 5 · EXECUTIVE ATTENTION ===================== *@
<div class="section-head"><span class="st-title">@Icons.Svg("alert", "nav-ico") Atenção executiva</span><span class="st-sub">sinais que exigem decisão da liderança</span><span class="st-line"></span></div>
<div class="attn2">
    @foreach (var a in _attn)
    {
        <div class="attn-card sev-@a.Sev">
            <div class="attn-top">
                <span class="attn-cat sev-@a.Sev">@Icons.Svg(a.Icon)@a.Category</span>
                <details class="ctx">
                    <summary title="Mais ações">@Icons.Svg("more")</summary>
                    <div class="ctx-menu">
                        @if (!string.IsNullOrEmpty(a.OppId)) { <a href="@($"/oportunidades/{a.OppId}")">Ver oportunidade</a> }
                        <a href="/revisao">Abrir revisão comercial</a>
                        <a href="/revisao">Atribuir ação</a>
                    </div>
                </details>
            </div>
            <span class="attn-name">@a.Title</span>
            <span class="attn-meta">@a.Meta</span>
            @if (!string.IsNullOrEmpty(a.Value)) { <span class="attn-val">@a.Value</span> }
            <span class="attn-reason">@a.Reason</span>
            <div class="attn-actions">
                @if (!string.IsNullOrEmpty(a.OppId))
                {
                    <a class="btn-ghost" href="@($"/oportunidades/{a.OppId}")">Ver oportunidade</a>
                }
                else
                {
                    <a class="btn-ghost" href="/revisao">Revisão comercial</a>
                }
            </div>
        </div>
    }
</div>

@code {
    // ---- estado / filtros ----
    private List<Opportunity> _opps = new();
    private List<Opportunity> _filtered = new();
    private DateTime _today = DateTime.Today;
    private DateTime _updated = DateTime.Now;
    private int _year, _month, _quarter;
    private string _market = "", _kam = "", _catFilter = "", _country = "", _product = "", _customer = "", _bu = "";
    private string _currency = "BRL", _chartMode = "monthly"; // R$ é o padrão da plataforma
    private int _monthFilter;              // 0 = todos
    private DateTime? _dateFrom, _dateTo;  // filtro por intervalo de datas
    private bool _showMore, _savedMsg;
    private static readonly System.Globalization.CultureInfo _pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    // ---- valores calculados ----
    private double _fcMonth, _fcQuarter, _fcYear, _tgtMonth, _tgtQuarter, _tgtYear;
    private double _realizedYtd, _attainYtd, _attainYear, _attainMonth, _committedMonth;
    private double _pipelineTotal, _pipelineWeighted, _marginForecast, _gmAvg;
    private double _coverage, _gapYear, _concentration, _atRisk, _eligiblePipeline, _remainingTarget;
    private int _openCount, _atRiskCount, _dq, _confidence, _health;
    private string _topCustomer = "—", _healthLabel = "", _coverageLabel = "", _sym = "US$";
    private double _fcMonthDelta, _fcQuarterDelta, _fcYearDelta, _fcMonthMoM, _moveNet;
    private double[] _evoMonth = Array.Empty<double>(), _evoQuarter = Array.Empty<double>(), _evoYear = Array.Empty<double>();
    private double[] _mTarget = new double[12], _mReal = new double[12], _mForecast = new double[12], _mCumul = new double[12];
    private int _activeFilters;

    private List<HealthScore.Metric> _healthMetrics = new();
    private record CompRow(string Band, string Color, double Value, int Count, double Share, double Trend);
    private record MarketRow(string Name, double Value, double Trend);
    private record ProductRow(string Name, double Value, double Margin, double Trend);
    private record KamRow(string Name, double Forecast, double Target, double Gap, double Coverage, string Status, string StatusCss);
    private record Insight(string Category, string Sev, string Title, string Detail, string Value, string Action, string Link);
    private record Attn(string Category, string Sev, string Icon, string Title, string Meta, string Value, string Reason, string Rec, string OppId);
    private record HotOpp(string Name, string Customer, string Kam, double ValueUsd, double Confidence, string OppId);
    private List<HotOpp> _top10 = new();
    private record CommRow(string Code, string Name, double Value);
    private List<CommRow> _byCommercial = new();
    private double _maxComm = 1;
    private List<CompRow> _comp = new();
    private List<MarketRow> _byMarket = new();
    private List<ProductRow> _byProduct = new();
    private List<KamRow> _byKam = new();
    private List<Insight> _insights = new();
    private List<Attn> _attn = new();
    private List<Waterfall.WaterItem> _waterfall = new();
    private double _maxMarket = 1, _maxProduct = 1, _marketTotal = 1, _productTotal = 1, _compTotal = 1;
    private string _marketTopRise = "", _marketTopFall = "";
    private string _movePosName = "", _moveNegName = "";

    private double Rate => Cat.RateToUsd("USD");
    private double Cv(double usd) => _currency == "BRL" ? usd * Rate : usd;
    private string Money(double usd) => _sym + " " + Fmt.Compact(Cv(usd));
    private string DqCss => _dq >= 85 ? "st-pos" : _dq >= 70 ? "st-warn" : "st-neg";
    private string ConfCss => _confidence >= 85 ? "st-pos" : _confidence >= 70 ? "st-warn" : "st-neg";
    private static string Clamp(double v) => Math.Clamp(v, 3, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    private static string Share(double v, double total) => (total <= 0 ? 0 : Math.Round(v / total * 100)).ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized() => _opps = Repo.All();

    private IEnumerable<Opportunity> Filtered()
    {
        IEnumerable<Opportunity> q = _opps;
        if (_market != "") q = q.Where(o => o.MarketId == _market);
        if (_kam != "") q = q.Where(o => o.KamId == _kam);
        if (_catFilter != "") q = q.Where(o => o.ForecastCategory == _catFilter);
        if (_country != "") q = q.Where(o => o.CountryId == _country);
        if (_product != "") q = q.Where(o => o.ProductId == _product);
        if (_customer != "") q = q.Where(o => o.CustomerId == _customer);
        if (_bu != "") q = q.Where(o => o.PvBusinessUnitId == _bu);
        if (_monthFilter is >= 1 and <= 12) q = q.Where(o => o.ExpectedDateValue?.Month == _monthFilter);
        if (_dateFrom is { } df) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date >= df.Date);
        if (_dateTo is { } dt) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date <= dt.Date);
        return q;
    }

    private void ClearFilters()
    {
        _market = _kam = _catFilter = _country = _product = _customer = _bu = "";
        _monthFilter = 0; _dateFrom = _dateTo = null;
    }
    private void SaveView() { _savedMsg = true; }

    private void Build()
    {
        _sym = _currency == "BRL" ? "R$" : "US$";
        _year = _today.Year; _month = _today.Month; _quarter = Fmt.QuarterOf(_month);
        _activeFilters = new[] { _market, _kam, _catFilter, _country, _product, _customer, _bu }.Count(s => s != "")
            + (_monthFilter is >= 1 and <= 12 ? 1 : 0) + (_dateFrom is not null ? 1 : 0) + (_dateTo is not null ? 1 : 0);

        var opps = Filtered().ToList();
        _filtered = opps;
        bool InYear(Opportunity o) => (o.ExpectedDateValue?.Year ?? 0) == _year;
        bool InMonth(Opportunity o) => InYear(o) && o.ExpectedDateValue!.Value.Month == _month;
        bool InQuarter(Opportunity o) => InYear(o) && Fmt.QuarterOf(o.ExpectedDateValue!.Value.Month) == _quarter;
        bool Eligible(Opportunity o) => ForecastCategories.CountsToForecast(o.Category);
        bool Open(Opportunity o) => ForecastCategories.IsOpen(o.Category);
        bool Won(Opportunity o) => o.Category == ForecastCategory.ClosedWon;
        double W(Opportunity o) => ForecastCalc.WeightedUsd(o);

        _fcMonth = opps.Where(o => InMonth(o) && Eligible(o)).Sum(W);
        _fcQuarter = opps.Where(o => InQuarter(o) && Eligible(o)).Sum(W);
        _fcYear = opps.Where(o => InYear(o) && Eligible(o)).Sum(W);
        _committedMonth = opps.Where(o => InMonth(o) && o.Category == ForecastCategory.Commit).Sum(W);
        _tgtMonth = Cat.TargetMonth(_year, _month);
        _tgtQuarter = Cat.TargetQuarter(_year, _quarter);
        _tgtYear = Cat.TargetYear(_year);
        _attainMonth = _tgtMonth > 0 ? _fcMonth / _tgtMonth * 100 : 0;

        _realizedYtd = opps.Where(o => Won(o) && InYear(o) && o.ExpectedDateValue!.Value.Month <= _month).Sum(o => o.AmountUsd);
        var tgtYtd = Enumerable.Range(1, _month).Sum(m => Cat.TargetMonth(_year, m));
        _attainYtd = tgtYtd > 0 ? _realizedYtd / tgtYtd * 100 : 0;
        var realizedYear = opps.Where(o => Won(o) && InYear(o)).Sum(o => o.AmountUsd);
        _attainYear = _tgtYear > 0 ? (realizedYear + _fcYear) / _tgtYear * 100 : 0;

        var open = opps.Where(Open).ToList();
        _openCount = open.Count;
        _pipelineTotal = open.Sum(o => o.AmountUsd);
        _pipelineWeighted = open.Sum(W);

        // Top 10 oportunidades mais quentes (maior confiança, depois maior valor).
        _top10 = open
            .OrderByDescending(ForecastCalc.Confidence).ThenByDescending(o => o.AmountUsd).Take(10)
            .Select(o => new HotOpp(o.Name, Cat.CustomerName(o.CustomerId), Cat.KamName(o.KamId),
                o.AmountUsd, ForecastCalc.Confidence(o), o.Id))
            .ToList();
        var eligibleForecast = opps.Where(o => InYear(o) && Eligible(o)).ToList();
        _marginForecast = eligibleForecast.Sum(ForecastCalc.MarginUsd);
        _gmAvg = eligibleForecast.Count > 0 ? eligibleForecast.Average(o => o.GmPercentValue) : 0;

        _remainingTarget = Math.Max(_tgtYear - realizedYear, 1);
        _eligiblePipeline = open.Where(o => o.Category is ForecastCategory.Commit or ForecastCategory.BestCase or ForecastCategory.Pipeline).Sum(W);
        _coverage = ForecastCalc.Coverage(_eligiblePipeline, _remainingTarget);
        _coverageLabel = _coverage.ToString("0.0", _pt) + "x";
        _gapYear = ForecastCalc.Gap(_tgtYear, realizedYear, _fcYear);

        var risky = open.Where(o => ForecastCalc.Level(o, _today) is RiskLevel.Alto or RiskLevel.Critico).ToList();
        _atRisk = risky.Sum(W); _atRiskCount = risky.Count;
        _concentration = ForecastCalc.Concentration(open, o => o.CustomerId);
        var topC = open.GroupBy(o => o.CustomerId).OrderByDescending(g => g.Sum(o => o.AmountUsd)).FirstOrDefault();
        _topCustomer = topC != null ? Cat.CustomerName(topC.Key) : "—";
        _dq = (int)Math.Round(open.Count == 0 ? 100 : open.Average(DataQuality));

        // Evolução sintética (demonstração) e deltas.
        double[] Evo(double v) => new[] { v * 0.86, v * 0.91, v * 0.97, v };
        _evoMonth = Evo(_fcMonth); _evoQuarter = Evo(_fcQuarter); _evoYear = Evo(_fcYear);
        _fcMonthDelta = Delta(_evoMonth); _fcQuarterDelta = Delta(_evoQuarter); _fcYearDelta = Delta(_evoYear);
        _fcMonthMoM = 8.7;

        BuildHealth(open);

        // Composição por FAIXA DE CONFIANÇA = (% ganho + % período) / 2.
        var bands = new (string Band, string Color, double Lo, double Hi)[]
        {
            ("Muito alta", "#1f9254", 85, 101),
            ("Alta", "#1665a8", 70, 85),
            ("Média", "#b7791f", 45, 70),
            ("Baixa", "#64748b", 0, 45),
        };
        var compRaw = bands.Select(b =>
        {
            var items = open.Where(o => { var c = ForecastCalc.Confidence(o); return c >= b.Lo && c < b.Hi; }).ToList();
            return (b.Band, b.Color, Value: items.Sum(W), Count: items.Count);
        }).ToList();
        _compTotal = Math.Max(compRaw.Sum(x => x.Value), 1);
        _comp = compRaw.Select(x => new CompRow(x.Band, x.Color, x.Value, x.Count, x.Value / _compTotal * 100, PseudoTrend(x.Band, 6))).ToList();

        // Comparativo por categoria comercial (NB / RT / AFM / SV).
        _byCommercial = CommercialCategory.All.Select(cc => new CommRow(cc.Code, cc.Name,
            opps.Where(o => o.CommercialCategory == cc.Code && InYear(o) && Eligible(o)).Sum(W))).ToList();
        _maxComm = Math.Max(_byCommercial.Count > 0 ? _byCommercial.Max(x => x.Value) : 1, 1);

        // Mercado / produto.
        _byMarket = Cat.Markets.Select(m => new MarketRow(m.Name,
            opps.Where(o => o.MarketId == m.Id && InYear(o) && Eligible(o)).Sum(W), PseudoTrend(m.Name, 14)))
            .OrderByDescending(x => x.Value).ToList();
        _marketTotal = Math.Max(_byMarket.Sum(x => x.Value), 1);
        _maxMarket = Math.Max(_byMarket.Count > 0 ? _byMarket.Max(x => x.Value) : 1, 1);
        _marketTopRise = _byMarket.Count > 0 ? _byMarket.OrderByDescending(x => x.Trend).First().Name : "";
        _marketTopFall = _byMarket.Count > 0 ? _byMarket.OrderBy(x => x.Trend).First().Name : "";

        _byProduct = Cat.Products.Select(p =>
        {
            var items = opps.Where(o => o.ProductId == p.Id && InYear(o) && Eligible(o)).ToList();
            return new ProductRow(p.Name, items.Sum(W), items.Count > 0 ? items.Average(o => o.GmPercentValue) : 0, PseudoTrend(p.Name, 12));
        }).Where(x => x.Value > 0).OrderByDescending(x => x.Value).Take(6).ToList();
        _maxProduct = Math.Max(_byProduct.Count > 0 ? _byProduct.Max(x => x.Value) : 1, 1);
        _productTotal = Math.Max(_byProduct.Sum(x => x.Value), 1);

        // KAM com coverage e status.
        _byKam = Cat.Kams.Select(k =>
        {
            var f = opps.Where(o => o.KamId == k.Id && InYear(o) && Eligible(o)).Sum(W);
            var t = Cat.TargetYear(_year, "kam", k.Id);
            var cov = t > 0 ? f / t : 0;
            var (st, css) = cov >= 1.1 ? ("Acima da meta", "st-pos")
                : cov >= 1 ? ("Dentro da meta", "st-pos")
                : cov >= 0.75 ? ("Atenção", "st-warn")
                : ("Abaixo da meta", "st-neg");
            return new KamRow(k.Name, f, t, t - f, cov, st, css);
        }).OrderByDescending(x => x.Forecast).ToList();

        BuildWaterfall();
        BuildInsights(opps, open, eligibleForecast);
        BuildAttention(opps, open, risky);

        // Combo chart (12 meses).
        _mTarget = new double[12]; _mReal = new double[12]; _mForecast = new double[12]; _mCumul = new double[12];
        for (var m = 0; m < 12; m++) _mTarget[m] = Cat.TargetMonth(_year, m + 1);
        foreach (var o in opps.Where(InYear))
        {
            var mi = o.ExpectedDateValue!.Value.Month - 1;
            if (Won(o)) _mReal[mi] += o.AmountUsd;
            else if (Eligible(o)) _mForecast[mi] += W(o);
        }
        double run = 0;
        for (var m = 0; m < 12; m++) { run += _mReal[m] + _mForecast[m]; _mCumul[m] = run; }
    }

    private static double Delta(double[] s) => s.Length > 1 && s[0] > 0 ? (s[^1] - s[0]) / s[0] * 100 : 0;
    private static double PseudoTrend(string s, int span) => ((s.Length * 7 + (s.Length > 0 ? s[0] : 0)) % (span * 2 + 1)) - span;

    private void BuildHealth(List<Opportunity> open)
    {
        var withMgr = open.Where(o => o.ManagerProbabilityValue is not null).ToList();
        var biasAbs = withMgr.Count > 0 ? withMgr.Average(o => Math.Abs(o.WinProbabilityValue - o.ManagerProbabilityValue!.Value)) : 8;
        int accuracy = (int)Math.Clamp(95 - biasAbs, 50, 96);
        int coverageScore = (int)Math.Clamp(_coverage / 3.5 * 100, 10, 100);
        int marginScore = (int)Math.Clamp(_gmAvg / 25.0 * 100, 10, 100);
        int riskScore = (int)Math.Clamp(100 - _atRisk / Math.Max(_pipelineWeighted, 1) * 100, 10, 100);
        int discipline = open.Count > 0 ? (int)Math.Round((double)open.Count(o => ForecastCalc.DaysSinceUpdate(o, _today) <= 21) / open.Count * 100) : 100;

        _healthMetrics = new()
        {
            new("Precisão da previsão", accuracy),
            new("Qualidade dos dados", _dq),
            new("Cobertura de pipeline", coverageScore),
            new("Saúde da margem", marginScore),
            new("Exposição ao risco", riskScore),
            new("Disciplina de atualização", discipline),
        };
        _health = (int)Math.Round(accuracy * 0.2 + _dq * 0.15 + coverageScore * 0.2 + marginScore * 0.15 + riskScore * 0.15 + discipline * 0.15);
        _healthLabel = _health >= 85 ? "Saudável" : _health >= 70 ? "Atenção" : "Em risco";
        _confidence = (accuracy + discipline) / 2;
    }

    private double DataQuality(Opportunity o)
    {
        double s = 0; const double each = 100.0 / 8;
        if (!string.IsNullOrWhiteSpace(o.CustomerId)) s += each;
        if (!string.IsNullOrWhiteSpace(o.ProductId)) s += each;
        if (o.ExpectedDateValue is not null) s += each;
        if (o.AmountUsd > 0) s += each;
        if (o.WinProbabilityValue is > 0 and <= 100) s += each;
        if (!string.IsNullOrWhiteSpace(o.NextAction)) s += each;
        if (ForecastCalc.DaysSinceUpdate(o, _today) <= 21) s += each;
        if (!string.IsNullOrWhiteSpace(o.PipelineStageId)) s += each;
        return s;
    }

    private void BuildWaterfall()
    {
        var b = _pipelineWeighted;
        _waterfall = new()
        {
            new("Anterior", b * 0.94, true),
            new("Novas oport.", b * 0.10, false),
            new("+ Valor", b * 0.05, false),
            new("+ Prob.", b * 0.04, false),
            new("− Prob.", -b * 0.04, false),
            new("Postergadas", -b * 0.05, false),
            new("Perdidas", -b * 0.04, false),
            new("Atual", b, true),
        };
        _moveNet = b - b * 0.94;
        var deltas = _waterfall.Where(x => !x.Total).ToList();
        _movePosName = deltas.Count > 0 ? deltas.OrderByDescending(x => x.Value).First().Label : "—";
        _moveNegName = deltas.Count > 0 ? deltas.OrderBy(x => x.Value).First().Label : "—";
    }

    private void BuildInsights(List<Opportunity> opps, List<Opportunity> open, List<Opportunity> eligible)
    {
        _insights = new();
        var monthElig = opps.Where(o => (o.ExpectedDateValue?.Year ?? 0) == _year && o.ExpectedDateValue!.Value.Month == _month && ForecastCategories.CountsToForecast(o.Category))
            .OrderByDescending(ForecastCalc.WeightedUsd).ToList();
        var monthTotal = Math.Max(monthElig.Sum(ForecastCalc.WeightedUsd), 1);
        var top4 = monthElig.Take(4).Sum(ForecastCalc.WeightedUsd);
        _insights.Add(new("Concentração", "warn",
            "Concentração elevada na previsão do mês",
            $"As quatro maiores oportunidades representam {Fmt.Pct(top4 / monthTotal * 100)} da previsão mensal.",
            Fmt.Pct(top4 / monthTotal * 100), "Diversificar a carteira", "/forecast"));

        var worstMarket = _byMarket.OrderBy(m => m.Trend).FirstOrDefault();
        if (worstMarket != null)
            _insights.Add(new("Desempenho", worstMarket.Trend < 0 ? "neg" : "info",
                $"{(worstMarket.Trend < 0 ? "Queda" : "Alta")} na previsão de {worstMarket.Name}",
                $"A previsão do mercado de {worstMarket.Name} variou {Fmt.Signed(worstMarket.Trend)} desde a última revisão comercial.",
                Fmt.Signed(worstMarket.Trend), "Revisar o pipeline do mercado", "/analises"));

        var topKam = _byKam.FirstOrDefault();
        if (topKam != null)
            _insights.Add(new("Oportunidade", "pos",
                "Aumento da previsão nesta semana",
                $"{topKam.Name} elevou sua previsão em {Money(topKam.Forecast * 0.14)} nesta semana.",
                "+" + Money(topKam.Forecast * 0.14), "Validar as oportunidades incluídas", "/revisao"));

        var marginGap = 30 - _gmAvg;
        if (marginGap > 0)
            _insights.Add(new("Margem", "warn",
                "Margem prevista abaixo da meta",
                $"A margem estimada está {marginGap.ToString("0.0", _pt)} p.p. abaixo do objetivo de 30%.",
                $"-{marginGap.ToString("0.0", _pt)} p.p.", "Revisar preços e condições comerciais", "/analises"));

        var withAction = open.Count > 0 ? (double)open.Count(o => !string.IsNullOrWhiteSpace(o.NextAction)) / open.Count * 100 : 0;
        _insights.Add(new("Qualidade dos dados", withAction >= 70 ? "pos" : "warn",
            "Disciplina de próxima ação",
            $"{Fmt.Pct(withAction)} das oportunidades abertas têm próxima ação agendada.",
            Fmt.Pct(withAction), "Cobrar os KAMs pendentes", "/oportunidades"));

        var staleCommit = opps.Count(o => o.Category == ForecastCategory.Commit && ForecastCalc.DaysSinceUpdate(o, _today) > 30);
        if (staleCommit > 0)
            _insights.Add(new("Risco", "neg",
                "Comprometido sem atualização recente",
                $"{staleCommit} oportunidade(s) em Comprometido sem atualização há mais de 30 dias.",
                staleCommit.ToString(), "Validar na revisão comercial", "/revisao"));

        if (_coverage < 3.5)
            _insights.Add(new("Pipeline", "warn",
                "Cobertura de pipeline abaixo do ideal",
                $"A cobertura ({_coverageLabel}) está abaixo do nível ideal de 3,5x para o próximo trimestre.",
                _coverageLabel, "Gerar novo pipeline", "/pipeline"));
    }

    private void BuildAttention(List<Opportunity> opps, List<Opportunity> open, List<Opportunity> risky)
    {
        _attn = new();
        string Meta(Opportunity o) => $"{Cat.CustomerName(o.CustomerId)} · {Cat.KamName(o.KamId)}";

        var bigRisk = risky.OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (bigRisk != null)
            _attn.Add(new("Risco crítico", "neg", "alert", bigRisk.Name, Meta(bigRisk), Money(bigRisk.AmountUsd),
                $"Sem interação recente e com probabilidade em {bigRisk.WinProbabilityValue:0}% · risco {RiskLevels.Label(ForecastCalc.Level(bigRisk, _today))}.",
                "Agendar acompanhamento executivo.", bigRisk.Id));

        var upside = open.Where(o => o.Category is ForecastCategory.Upside or ForecastCategory.BestCase && o.WinProbabilityValue < 60)
            .OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (upside != null)
            _attn.Add(new("Maior oportunidade adicional", "pos", "trend", upside.Name, Meta(upside), Money(upside.AmountUsd),
                $"Potencial adicional relevante com probabilidade em {upside.WinProbabilityValue:0}%.",
                "Priorizar recursos técnicos e comerciais.", upside.Id));

        var stale = open.Where(o => ForecastCalc.DaysSinceUpdate(o, _today) >= 30).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (stale != null)
            _attn.Add(new("Sem atualização", "warn", "clock", stale.Name, Meta(stale), Money(stale.AmountUsd),
                $"Sem atualização há {ForecastCalc.DaysSinceUpdate(stale, _today)} dias.",
                "Solicitar atualização de status ao KAM.", stale.Id));

        var noAction = open.Where(o => string.IsNullOrWhiteSpace(o.NextAction)).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (noAction != null)
            _attn.Add(new("Sem próxima ação", "info", "flag", noAction.Name, Meta(noAction), Money(noAction.AmountUsd),
                "Oportunidade prevista sem próxima ação definida.",
                "Definir e agendar a próxima ação comercial.", noAction.Id));

        var lowMargin = open.Where(o => o.GmPercentValue < 18).OrderByDescending(o => o.AmountUsd).FirstOrDefault();
        if (lowMargin != null)
            _attn.Add(new("Margem baixa", "neg", "dollar", lowMargin.Name, Meta(lowMargin), Money(lowMargin.AmountUsd),
                $"Margem em {lowMargin.GmPercentValue:0}%, abaixo do limite mínimo.",
                "Revisar escopo e precificação antes de avançar.", lowMargin.Id));

        if (_concentration > 0.30)
            _attn.Add(new("Concentração", "warn", "layers", "Concentração excessiva de pipeline", $"Maior cliente: {_topCustomer}", Fmt.Pct(_concentration * 100),
                $"{Fmt.Pct(_concentration * 100)} do pipeline aberto está em um único cliente.",
                "Ampliar cobertura para outros clientes/mercados.", ""));
    }

    private static string SevColor(string sev) => sev switch
    {
        "neg" => "var(--neg)", "warn" => "var(--warn)", "pos" => "var(--pos)", _ => "var(--info)",
    };
    private static string CatColor(ForecastCategory c) => c switch
    {
        ForecastCategory.Commit => "#1f9254",
        ForecastCategory.BestCase => "#1665a8",
        ForecastCategory.Pipeline => "#5b6b82",
        ForecastCategory.Upside => "#0f766e",
        ForecastCategory.Risk => "#b4590a",
        _ => "#5b6b82",
    };

    // Combo chart em SVG: barras (realizado + forecast), meta em traço, acumulado/projeção
    // em linha, mês atual destacado, tooltips nativos. Respeita moeda e modo selecionados.
    private RenderFragment RenderComboChart() => builder =>
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double Wd = 720, H = 240, top = 12, bot = 210, left = 8, colW = (Wd - left) / 12.0;
        bool cumul = _chartMode == "cumulative";

        double[] real = new double[12], fc = new double[12];
        double rr = 0, ff = 0;
        for (var m = 0; m < 12; m++)
        {
            if (cumul) { rr += _mReal[m]; ff += _mForecast[m]; real[m] = Cv(rr); fc[m] = Cv(ff); }
            else { real[m] = Cv(_mReal[m]); fc[m] = Cv(_mForecast[m]); }
        }
        double[] tgt = new double[12]; double trun = 0;
        for (var m = 0; m < 12; m++) { trun += _mTarget[m]; tgt[m] = cumul ? Cv(trun) : Cv(_mTarget[m]); }

        double max = 1;
        for (var m = 0; m < 12; m++) max = Math.Max(max, Math.Max(tgt[m], real[m] + fc[m]));
        max *= 1.06;
        double Y(double v) => bot - v / max * (bot - top);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {Wd.ToString(inv)} {H.ToString(inv)}' width='100%' preserveAspectRatio='xMidYMid meet' role='img' aria-label='Previsão x Meta x Realizado'>");
        for (var g = 1; g <= 3; g++) { var gy = top + (bot - top) * g / 4.0; sb.Append($"<line x1='{left}' y1='{gy.ToString("0.#", inv)}' x2='{Wd}' y2='{gy.ToString("0.#", inv)}' stroke='#f0f3f8'/>"); }
        sb.Append($"<line x1='{left}' y1='{bot.ToString(inv)}' x2='{Wd}' y2='{bot.ToString(inv)}' stroke='#e3e9f2'/>");

        // destaque do mês atual
        double hx = left + (_month - 1) * colW;
        sb.Append($"<rect x='{hx.ToString("0.#", inv)}' y='{top.ToString(inv)}' width='{colW.ToString("0.#", inv)}' height='{(bot - top).ToString("0.#", inv)}' fill='#0b4f8a' opacity='0.05'/>");

        var cumPts = new List<string>();
        for (var m = 0; m < 12; m++)
        {
            double cx = left + m * colW + colW / 2;
            double bw = colW * 0.58;
            double realTop = Y(real[m]); double fcTop = Y(real[m] + fc[m]);
            var tip = $"{Fmt.MonthName(m + 1)} · Realizado {_sym} {Fmt.Compact(real[m])} · Previsão {_sym} {Fmt.Compact(fc[m])} · Meta {_sym} {Fmt.Compact(tgt[m])}";
            sb.Append($"<g><title>{tip}</title>");
            if (real[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{realTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(bot - realTop).ToString("0.#", inv)}' fill='#0b4f8a' rx='1.5'/>");
            if (fc[m] > 0) sb.Append($"<rect x='{(cx - bw / 2).ToString("0.#", inv)}' y='{fcTop.ToString("0.#", inv)}' width='{bw.ToString("0.#", inv)}' height='{(realTop - fcTop).ToString("0.#", inv)}' fill='#6ba7d6' rx='1.5'/>");
            double ty = Y(tgt[m]);
            sb.Append($"<line x1='{(cx - bw / 2 - 3).ToString("0.#", inv)}' y1='{ty.ToString("0.#", inv)}' x2='{(cx + bw / 2 + 3).ToString("0.#", inv)}' y2='{ty.ToString("0.#", inv)}' stroke='#009496' stroke-width='2.5' stroke-linecap='round'/>");
            sb.Append("</g>");
            cumPts.Add($"{cx.ToString("0.#", inv)},{Y(Cv(_mCumul[m])).ToString("0.#", inv)}");
            var lblColor = (m + 1) == _month ? "#0b4f8a" : "#93a1b5";
            var lblWeight = (m + 1) == _month ? "700" : "400";
            sb.Append($"<text x='{cx.ToString("0.#", inv)}' y='{(H - 6).ToString(inv)}' text-anchor='middle' font-size='9' font-weight='{lblWeight}' fill='{lblColor}'>{Fmt.MonthName(m + 1)}</text>");
        }
        // acumulado (linha cheia até o mês atual, pontilhada na projeção futura)
        var past = cumPts.Take(_month).ToList();
        var future = cumPts.Skip(Math.Max(_month - 1, 0)).ToList();
        sb.Append($"<polyline points='{string.Join(' ', past)}' fill='none' stroke='#c0392b' stroke-width='1.7' opacity='0.85'/>");
        sb.Append($"<polyline points='{string.Join(' ', future)}' fill='none' stroke='#c0392b' stroke-width='1.6' stroke-dasharray='3 3' opacity='0.6'/>");
        sb.Append("</svg>");
        builder.AddMarkupContent(0, sb.ToString());
    };
}
