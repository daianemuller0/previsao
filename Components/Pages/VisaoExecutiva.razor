    private static readonly string[] ChartKeys = { "segment", "market", "kam", "product", "submarket", "bu" };

    private ChartPrefsRepository.Pref Pref(string chave)
    {
        if (_chart.TryGetValue(chave, out var p)) return p;
        p = ChartPrefs.Get(_login, chave);
        _chart[chave] = p;
        return p;
    }

    private void RecarregarChartPrefs()
    {
        if (_chartVersion == ChartPrefs.Version) return;
        _chart.Clear();
        _chartVersion = ChartPrefs.Version;
    }

