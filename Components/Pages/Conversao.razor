    // ---- gráfico 7: status de perda ----
    private static readonly string[] StatusPerda = { "Cancelled", "Closed - Customer Lost", "Closed - Lost", "Closed - No Bid", "Closed - Unknown" };

    private RenderFragment Perdas() => builder =>
    {
        bool qtd = _metPerda == "qtd";
        var perdidas = _f.Where(i => i.P.Classe == ClasseProposta.Perdida).ToList();
        // os cinco status esperados sempre aparecem (mesmo zerados), na grafia combinada
        var linhas = StatusPerda.Select(s =>
        {
            var chave = ConversaoService.NormalizarStatus(s);
            var itens = perdidas.Where(i => ConversaoService.NormalizarStatus(i.P.StatusOriginal) == chave).ToList();
            return (Nome: s, Qtd: itens.Count, Valor: itens.Sum(i => i.Brl ?? 0));
        }).OrderByDescending(x => qtd ? x.Qtd : x.Valor).ToList();
        var max = Math.Max(linhas.Max(x => qtd ? x.Qtd : x.Valor), 1);
        var totQ = linhas.Sum(x => x.Qtd); var totV = linhas.Sum(x => x.Valor);
        var sb = new StringBuilder($"<div class='apl-resumo'><span>{perdidas.Count.ToString("N0", _pt)} proposta(s) perdida(s)</span><span class='apl-total'><small>TOTAL</small>{Esc(qtd ? totQ.ToString("N0", _pt) : R(totV))}</span></div>");
        sb.Append("<div class='cv-vals'>");
        foreach (var l in linhas)
        {
            var v = qtd ? l.Qtd : l.Valor;
            sb.Append($"<div class='cv-val' title='{Esc(l.Nome)}: {l.Qtd} proposta(s) · {Esc(Fmt.Brl(l.Valor))}'>");
            sb.Append($"<div class='cv-val-top'><span><i class='cv-dot' style='background:{CorP}'></i>{Esc(l.Nome)}</span><b>{Esc(qtd ? l.Qtd.ToString("N0", _pt) : R(l.Valor))}</b><em>{Esc(qtd ? PctDe(l.Qtd, totQ) : PctDe(l.Valor, totV))}</em></div>");
            sb.Append($"<div class='cv-track'><div class='cv-fill' style='width:{F(v / max * 100)}%;background:linear-gradient(90deg,#e2664e,{CorP})'></div></div></div>");
        }
        sb.Append("</div>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // ---- reconciliação e qualidade ----
    private RenderFragment Verificacoes() => @<details class="panel cv-det">
        <summary>Verificações dos dados</summary>
        @{
            var total = Conv.Atual.Propostas.Count;
            var geral = Somar(_itens);
            var somaCat = geral.G + geral.P + geral.A + geral.NC;
            var okQtd = total == somaCat && total == _itens.Count;
            var okFiltro = _f.Count == _r.G + _r.P + _r.A + _r.NC;
            var indep = _itens.Sum(i => i.Brl ?? 0);
            var okValor = Math.Abs(indep - geral.VTotal) < 0.01 && Math.Abs(_f.Sum(i => i.Brl ?? 0) - _r.VTotal) < 0.01;
        }
        <ul class="cv-checks">
            <li class="@(okQtd ? "ok" : "bad")">@(okQtd ? "✔" : "✖") Total de registros (@total.ToString("N0", _pt)) = ganhas (@geral.G) + perdidas (@geral.P) + abertas (@geral.A) + não classificadas (@geral.NC)</li>
            <li class="@(okFiltro ? "ok" : "bad")">@(okFiltro ? "✔" : "✖") No recorte atual: @_f.Count.ToString("N0", _pt) = @_r.G + @_r.P + @_r.A + @_r.NC</li>
            <li class="@(okValor ? "ok" : "bad")">@(okValor ? "✔" : "✖") Soma dos valores das categorias = valor total das propostas com conversão válida (@Fmt.Brl(geral.VTotal) na base toda)</li>
            <li class="@(geral.SemTaxa == 0 ? "ok" : "bad")">@(geral.SemTaxa == 0 ? "✔" : "✖") Propostas com valor mas sem taxa de câmbio: @geral.SemTaxa.ToString("N0", _pt)@(geral.SemTaxa > 0 ? $" (US$ {geral.UsdSemTaxa.ToString("N0", _pt)} fora dos valores em R$)" : "")</li>
            <li class="info">ℹ Propostas sem valor em US$ na planilha: @geral.SemValor.ToString("N0", _pt) — contam nas quantidades, não nos valores</li>
        </ul>
        @if (Conv.Atual.Avisos.Count > 0)
        {
            <div class="cv-sub-h">Avisos da leitura</div>
            <ul class="cv-checks">@foreach (var a in Conv.Atual.Avisos) { <li class="bad">⚠ @a</li> }</ul>
        }
        <div class="cv-sub-h">Colunas lidas da planilha</div>
        <ul class="cv-checks">@foreach (var m in Conv.Atual.Mapeamento) { <li class="info">@m</li> }</ul>
    </details>;

    // ======================================================================
    //  ABA 2 · BASE DE PROPOSTAS
    // ======================================================================
    private string _busca = "";
    private readonly HashSet<string> _classes = Novo();
    private string _ordCol = "data"; private bool _ordAsc = false;
    private int _pag; private const int PorPagina = 50;
    private HashSet<string>? _ocultas;
    private const string TabelaPref = "conversao_base";

    private sealed record Col(string Key, string Titulo, string Align, Func<Item, string> Texto, Func<Item, object?> Chave);

    private static string NomeClasse(ClasseProposta c) => c switch
    {
        ClasseProposta.Ganha => "Ganha", ClasseProposta.Perdida => "Perdida", ClasseProposta.Aberta => "Aberta", _ => "Não classificada",
    };
    private static readonly string[] NomesClasse = { "Ganha", "Perdida", "Aberta", "Não classificada" };

    private List<Col> Colunas()
    {
        var cols = new List<Col>
        {
            new("data", "Data de envio", "nowrap", i => i.P.Data?.ToString("dd/MM/yyyy") ?? (i.P.DataTexto == "" ? "—" : i.P.DataTexto + " (inválida)"), i => i.P.Data),
            new("ano", "Ano", "center", i => i.Ano?.ToString() ?? "—", i => i.Ano),
            new("mes", "Mês", "center", i => i.Mes is { } m ? Fmt.MonthLong(m) : "—", i => i.Mes),
            new("vend", "Vendedor", "", i => i.P.Vendedor, i => i.P.Vendedor),
            new("bu", "BU", "", i => i.P.Bu, i => i.P.Bu),
            new("buic", "BU Intercompany", "", i => i.P.BuIc, i => i.P.BuIc),
            new("status", "Status original", "", i => i.P.StatusOriginal == "" ? "—" : i.P.StatusOriginal, i => i.P.StatusOriginal),
            new("classe", "Classificação", "center", i => NomeClasse(i.P.Classe), i => (int)i.P.Classe),
            new("usd", "Valor original (US$)", "right", i => i.P.ValorUsd is { } v ? v.ToString("#,##0.00", _pt) : (i.P.ValorTexto == "" ? "—" : i.P.ValorTexto + " (ilegível)"), i => i.P.ValorUsd),
            new("taxa", "Taxa aplicada", "right", i => i.Taxa is { } t ? t.ToString("0.0000", _pt) : "sem taxa", i => i.Taxa),
            new("brl", "Valor convertido (R$)", "right", i => i.Brl is { } b ? b.ToString("#,##0.00", _pt) : "—", i => i.Brl),
            new("linha", "Linha na planilha", "center", i => i.P.Linha.ToString(), i => i.P.Linha),
        };
        foreach (var c in Conv.Atual.Colunas)
        {
            var idx = c.Indice;
            cols.Add(new Col("o" + idx, $"{c.Letra} · {c.Titulo}", "", i => idx < i.P.Celulas.Length && i.P.Celulas[idx] != "" ? i.P.Celulas[idx] : "—",
                i => idx < i.P.Celulas.Length ? i.P.Celulas[idx] : ""));
        }
        return cols;
    }

    // colunas originais da planilha começam ocultas; o usuário escolhe e a escolha fica guardada
    private void CarregarOcultas()
    {
        var pref = ColPrefs.Get(_login, TabelaPref);
        _ocultas = pref.StartsWith("v1:", StringComparison.Ordinal)
            ? new HashSet<string>(pref[3..].Split(',', StringSplitOptions.RemoveEmptyEntries), StringComparer.Ordinal)
            : new HashSet<string>(Conv.Atual.Colunas.Select(c => "o" + c.Indice), StringComparer.Ordinal);
    }
    private void AlternarColuna(string key)
    {
        _ocultas ??= new HashSet<string>(StringComparer.Ordinal);
        if (!_ocultas.Remove(key)) _ocultas.Add(key);
        ColPrefs.Save(_login, TabelaPref, "v1:" + string.Join(",", _ocultas));
    }

    private static int Cmp(object? a, object? b)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;      // vazio sempre no fim
        if (b is null) return -1;
        return (a, b) switch
        {
            (double x, double y) => x.CompareTo(y),
            (int x, int y) => x.CompareTo(y),
            (DateTime x, DateTime y) => x.CompareTo(y),
            _ => string.Compare(a.ToString(), b.ToString(), StringComparison.CurrentCultureIgnoreCase),
        };
    }

    private void Ordenar(string key)
    {
        if (_ordCol == key) _ordAsc = !_ordAsc; else { _ordCol = key; _ordAsc = true; }
        _pag = 0;
    }

    private List<Item> LinhasTabela(List<Col> cols)
    {
        IEnumerable<Item> q = _f;                                         // o MESMO recorte do dashboard
        if (_classes.Count > 0) q = q.Where(i => _classes.Contains(NomeClasse(i.P.Classe)));
        if (!string.IsNullOrWhiteSpace(_busca))
        {
            var b = _busca.Trim();
            q = q.Where(i => cols.Any(c => c.Texto(i).Contains(b, StringComparison.CurrentCultureIgnoreCase)));
        }
        var col = cols.FirstOrDefault(c => c.Key == _ordCol) ?? cols[0];
        q = _ordAsc ? q.OrderBy(col.Chave, Comparer<object?>.Create(Cmp)) : q.OrderByDescending(col.Chave, Comparer<object?>.Create(Cmp));
        return q.ToList();
    }

    private RenderFragment Base() => @<div>
        @{
            if (_ocultas is null) CarregarOcultas();
            var todas = Colunas();
            var visiveis = todas.Where(c => _ocultas is null || !_ocultas.Contains(c.Key)).ToList();
            var linhas = LinhasTabela(todas);
            var paginas = Math.Max(1, (linhas.Count + PorPagina - 1) / PorPagina);
            if (_pag >= paginas) _pag = paginas - 1;
            var pagina = linhas.Skip(_pag * PorPagina).Take(PorPagina).ToList();
            var rt = Somar(linhas);
        }
        <div class="cv-tools">
            <input class="flt-search" style="min-width:240px" placeholder="Pesquisar em qualquer coluna…" value="@_busca" @oninput="Buscar" />
            <MultiFilter Label="Classificação" AllText="Todas" Options="NomesClasse" Selected="_classes" OnChanged="StateHasChanged" />
            <details class="cv-cols">
                <summary class="btn-ghost sm">@Icons.Svg("layers")Colunas</summary>
                <div class="cv-cols-panel">
                    @foreach (var c in todas)
                    {
                        var k = c.Key;
                        <label class="flt-check"><input type="checkbox" checked="@(_ocultas is null || !_ocultas.Contains(k))" @onchange="() => AlternarColuna(k)" /><span>@c.Titulo</span></label>
                    }
                </div>
            </details>
            <div class="filterbar-spacer"></div>
            <span class="muted" style="font-size:12px">@linhas.Count.ToString("N0", _pt) registro(s) · valor @Fmt.Brl(rt.VTotal)</span>
            <button class="btn-primary sm" disabled="@(linhas.Count == 0)" @onclick="() => Exportar(linhas, todas)">@Icons.Svg("download")Exportar Excel</button>
        </div>
        <div class="table-wrap tbl-compact" style="max-height:68vh;overflow:auto">
            <table class="grid-tbl">
                <thead>
                    <tr>
                        @foreach (var c in visiveis)
                        {
                            var k = c.Key;
                            <th class="@c.Align cv-sort" title="Ordenar" @onclick="() => Ordenar(k)">@c.Titulo@(_ordCol == k ? (_ordAsc ? " ▲" : " ▼") : "")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in pagina)
                    {
                        <tr>
                            @foreach (var c in visiveis)
                            {
                                if (c.Key == "classe")
                                {
                                    <td class="center"><span class="cv-badge @ClasseCss(i.P.Classe)">@NomeClasse(i.P.Classe)</span></td>
                                }
                                else if (c.Key is "taxa" && i.Taxa is null)
                                {
                                    <td class="right" style="color:var(--neg)" title="Sem taxa de câmbio para este ano">sem taxa</td>
                                }
                                else
                                {
                                    <td class="@c.Align">@c.Texto(i)</td>
                                }
                            }
                        </tr>
                    }
                    @if (linhas.Count == 0)
                    {
                        <tr><td colspan="@Math.Max(visiveis.Count, 1)" class="empty">Nenhum registro com os filtros atuais.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cv-pager">
            <span class="muted">Mostrando @(linhas.Count == 0 ? 0 : _pag * PorPagina + 1)–@Math.Min((_pag + 1) * PorPagina, linhas.Count) de @linhas.Count.ToString("N0", _pt)</span>
            <button class="btn-ghost sm" disabled="@(_pag == 0)" @onclick="() => _pag = 0">«</button>
            <button class="btn-ghost sm" disabled="@(_pag == 0)" @onclick="() => _pag--">‹</button>
            <span>página @(_pag + 1) de @paginas</span>
            <button class="btn-ghost sm" disabled="@(_pag >= paginas - 1)" @onclick="() => _pag++">›</button>
            <button class="btn-ghost sm" disabled="@(_pag >= paginas - 1)" @onclick="() => _pag = paginas - 1">»</button>
        </div>
    </div>;

    private static string ClasseCss(ClasseProposta c) => c switch
    {
        ClasseProposta.Ganha => "g", ClasseProposta.Perdida => "p", ClasseProposta.Aberta => "a", _ => "n",
    };

    private async Task Exportar(List<Item> linhas, List<Col> todas)
    {
        if (linhas.Count == 0) return;
        using var wb = new ClosedXML.Excel.XLWorkbook();
        var ws = wb.Worksheets.Add("Base de Propostas");
        for (var c = 0; c < todas.Count; c++) ws.Cell(1, c + 1).Value = todas[c].Titulo;
        ws.Row(1).Style.Font.Bold = true;
        for (var r = 0; r < linhas.Count; r++)
        {
            var i = linhas[r];
            for (var c = 0; c < todas.Count; c++)
            {
                var cel = ws.Cell(r + 2, c + 1);
                switch (todas[c].Key)
                {
                    case "usd": if (i.P.ValorUsd is { } u) { cel.Value = u; cel.Style.NumberFormat.Format = "#,##0.00"; } break;
                    case "taxa": if (i.Taxa is { } t) { cel.Value = t; cel.Style.NumberFormat.Format = "0.0000"; } else cel.Value = "sem taxa"; break;
                    case "brl": if (i.Brl is { } b) { cel.Value = b; cel.Style.NumberFormat.Format = "#,##0.00"; } break;
                    case "ano": if (i.Ano is { } a) cel.Value = a; break;
                    case "linha": cel.Value = i.P.Linha; break;
                    case "data": if (i.P.Data is { } d) { cel.Value = d; cel.Style.DateFormat.Format = "dd/MM/yyyy"; } break;
                    default: cel.Value = todas[c].Texto(i) == "—" ? "" : todas[c].Texto(i); break;
                }
            }
        }
        ws.SheetView.FreezeRows(1);
        ws.RangeUsed()?.SetAutoFilter();
        ws.Columns(1, Math.Min(todas.Count, 12)).AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        await JS.InvokeVoidAsync("appDownload", $"base_de_propostas_{DateTime.Today:yyyy-MM-dd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(ms.ToArray()));
    }

    // ======================================================================
    //  TAXAS DE CÂMBIO (administrador)
    // ======================================================================
    private bool _taxasAberto;
    private string _taxasErro = "", _novoAno = "";
    private readonly Dictionary<int, string> _taxasTxt = new();
    private List<int> _taxasAnos = new();

    private void AbrirTaxas()
    {
        if (!_isAdmin) return;
        _taxasErro = ""; _novoAno = "";
        var salvas = Cambio.Todas();
        var maximo = new[] { DateTime.Today.Year, salvas.Count > 0 ? salvas.Keys.Max() : 0, Conv.Atual.Propostas.Where(p => p.Data is not null).Select(p => p.Data!.Value.Year).DefaultIfEmpty(0).Max() }.Max();
        _taxasAnos = Enumerable.Range(2024, Math.Max(maximo - 2024 + 1, 1)).Union(salvas.Keys).Distinct().OrderBy(x => x).ToList();
        _taxasTxt.Clear();
        foreach (var a in _taxasAnos) _taxasTxt[a] = salvas.TryGetValue(a, out var t) ? t.ToString("0.0000", _pt) : "";
        _taxasAberto = true;
    }

    private void AdicionarAno()
    {
        if (int.TryParse(_novoAno.Trim(), out var a) && a is >= 2000 and <= 2100)
        {
            if (!_taxasAnos.Contains(a)) { _taxasAnos.Add(a); _taxasAnos.Sort(); _taxasTxt[a] = ""; }
            _novoAno = ""; _taxasErro = "";
        }
        else _taxasErro = "Informe um ano válido (ex.: 2027).";
    }

    // "5,20" ou "5.20": o separador decimal é o último; nunca "5.20" lido como 520.
    private static double? LerTaxa(string txt)
    {
        var t = (txt ?? "").Trim().Replace(" ", "");
        if (t == "") return null;
        if (t.Contains(',')) t = t.Replace(".", "").Replace(',', '.');
        return double.TryParse(t, System.Globalization.NumberStyles.Float, Inv, out var v) ? v : double.NaN;
    }

    private void SalvarTaxas()
    {
        if (!_isAdmin) return;
        var ok = new Dictionary<int, double?>();
        foreach (var a in _taxasAnos)
        {
            var v = LerTaxa(_taxasTxt.GetValueOrDefault(a, ""));
            if (v is { } x && (double.IsNaN(x) || x <= 0 || x >= 100)) { _taxasErro = $"Taxa inválida em {a}. Use um número entre 0 e 100 (ex.: 5,2000)."; return; }
            ok[a] = v;
        }
        foreach (var (a, v) in ok)
        {
            if (v is { } t) { if (Cambio.Taxa(a) != t) Cambio.Salvar(a, t, _user); }
            else if (Cambio.Taxa(a) is not null) Cambio.Remover(a);
        }
        _taxasErro = ""; _taxasAberto = false;
    }
}
