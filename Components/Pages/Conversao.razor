    // ---- perdas ---------------------------------------------------------------
    private RenderFragment Perdas() => @<section class="cvx-card">
        <div class="cvx-ch">
            <div class="cvx-xh"><span class="xcard-ico">@Icons.Svg("pie")</span><div><h2>Status das perdidas por impacto</h2><p>O status é a classificação no CRM, não a causa comercial · barras partem do zero</p></div></div>
            <span class="xcard-total cvx-xt-mid"><span>Perdidas</span><b>@(_metPerda == "qtd" ? N0(_rx.P) : Din(_rx, ClasseProposta.Perdida))</b></span>
