@page "/conversao"
@attribute [Authorize(Roles = "admin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ConversaoService Conv
@inject CambioAnualRepository Cambio
@inject ColumnPrefsRepository ColPrefs
@inject IJSRuntime JS

@* ===========================================================================
   Conversão · Commercial Performance Intelligence
   Página única de rolagem contínua: resumo, evolução, vendedores, BU, BU Intercompany,
   receita, perdas, qualidade dos dados e base de propostas (índice com âncoras).
   Toda a lógica e os números vêm de Conversao.razor.cs (Recalcular/Somar).
   =========================================================================== *@

@{ Recalcular(); }

@if (Embutido)
{
    <div class="cvx cvx-embed @(Parte == "filtros" ? "cvx-embed-barra" : "")">@Embutida()</div>
}
else if (_relatorio)
{
    @Relatorio()
}
else
{
<div class="cvx">

    <div class="breadcrumbs"><span>@T("Comercial", "Commercial")</span><span class="sep">/</span><span>@T("Conversão de Propostas", "Proposal Conversion")</span></div>
    <div class="page-head">
        <div>
            <h1>@T("Conversão de Propostas", "Proposal Conversion")</h1>
            <p class="subtitle">
                @PeriodoTxt() · Howden Brasil · @T("valores em", "values in") @Sim<br />
                @T("Última atualização", "Last updated") @(Conv.AtualizadoEm is { } quando ? (_emIngles ? quando.ToString("MM/dd/yyyy 'at' HH:mm", _enRz) : quando.ToString("dd/MM/yyyy 'às' HH:mm")) : "—") · @T("CRM, planilha de propostas", "CRM, proposals spreadsheet") · @N0(Conv.Atual.Propostas.Count) @T("registros", "records")
            </p>
        </div>
        <div class="page-actions">
            @if (_isAdmin)
            {
                <button class="btn-ghost" title="@T("Taxa USD/BRL de cada ano", "USD/BRL rate for each year")" @onclick="AbrirTaxas">@Icons.Svg("layers")@T("Taxas de câmbio", "Exchange rates")</button>
            }
            <button class="btn-ghost" title="@T("Reler a planilha agora", "Reload the spreadsheet now")" disabled="@_carregando" @onclick="Atualizar">@Icons.Svg("import")@(_carregando ? T("Atualizando…", "Refreshing…") : T("Atualizar", "Refresh"))</button>
            <div class="cvx-menu">
                <button type="button" class="btn-primary" aria-expanded="@(_menuExp ? "true" : "false")" @onclick="() => _menuExp = !_menuExp">@Icons.Svg("download")@T("Exportar", "Export")</button>
                @if (_menuExp)
                {
                    <div class="flt-multi-backdrop" @onclick="() => _menuExp = false"></div>
                    <div class="cvx-menu-p">
                        <button type="button" disabled="@(!_temDados)" @onclick="() => { _menuExp = false; return AbrirRelatorio(); }">@T("Relatório executivo (PDF)", "Executive report (PDF)")</button>
                        <button type="button" disabled="@(!_temDados)" @onclick="() => { _menuExp = false; return ExportarBase(); }">@T("Base de propostas (Excel)", "Proposals data (Excel)")</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!Conv.Ok && _temDados)
    {
        <div class="cvx-alert erro"><strong>@T("Dados possivelmente desatualizados.", "Data possibly out of date.")</strong> @Conv.Mensagem <button class="btn-link" disabled="@_carregando" @onclick="Atualizar">@T("Tentar de novo", "Try again")</button></div>
    }

    @if (_carregando && !_temDados)
    {
        <div class="cvx-skel"><div class="skel" style="height:190px"></div><div class="skel" style="height:110px"></div><div class="skel" style="height:300px"></div></div>
    }
    else if (!_temDados)
    {
        <div class="cvx-card"><div class="empty" style="padding:34px 12px">@Conv.Mensagem</div></div>
    }
    else
    {
        @BarraFiltros(Ancoras.Where(a => _isAdmin || a.Id != "qualidade"))

        @if (_r.SemTaxa > 0)
        {
            <div class="cvx-alert">
                <strong>@N0(_r.SemTaxa) @T("proposta(s)", "proposal(s)") (US$ @_r.UsdSemTaxa.ToString("N0", CulRz)) @T("sem taxa de câmbio", "without an exchange rate")</strong> @T("para", "for") @string.Join(", ", AnosSemTaxa()).
                @T("Esses valores ficam", "These values are") <strong>@T("fora dos totais em R$", "left out of the R$ totals")</strong> @T("— as quantidades estão completas.", "— the counts are complete.")
                @if (_isAdmin) { <span> <button class="btn-link" @onclick="AbrirTaxas">@T("Cadastrar taxas", "Register rates")</button></span> }
                else { <span> @T("Peça ao administrador para cadastrar a taxa.", "Ask the administrator to register the rate.")</span> }
            </div>
        }
        @if (_r.SemData > 0)
        {
            <div class="cvx-alert">
                <strong>@N0(_r.SemData) @T("proposta(s) sem data de envio", "proposal(s) without a sent date") (US$ @_r.UsdSemData.ToString("N0", CulRz))</strong> @T("não entram nos valores em R$: sem data não há ano, logo não há taxa de câmbio. As quantidades estão completas.", "are not included in the R$ values: without a date there is no year, so there is no exchange rate. The counts are complete.")
            </div>
        }

        @if (_f.Count == 0)
        {
            <div class="cvx-card"><div class="empty" style="padding:34px 12px">@T("Nenhuma proposta com os filtros atuais.", "No proposals match the current filters.") <button class="btn-link" @onclick="Limpar">@T("Limpar filtros", "Clear filters")</button></div></div>
        }
        else { @Pagina() }
    }
</div>
}

@* ---- painel lateral do vendedor ---- *@
@if (_vendSel is not null && !_relatorio && (!Embutido || Parte != "filtros"))
{
    @PainelVendedor(_vendSel)
}

@* ---- taxas de câmbio (administrador) ---- *@
@if (_taxasAberto && !_relatorio)
{
    <div class="drawer-backdrop" @onclick="() => _taxasAberto = false"></div>
    <div class="drawer">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">@T("Taxas de câmbio", "Exchange rates")</h2>
                <p class="subtitle">@T("USD/BRL de cada ano · aplicada nas propostas enviadas naquele ano", "USD/BRL for each year · applied to the proposals sent in that year")</p>
            </div>
            <button class="icon-btn" @onclick="() => _taxasAberto = false">@Icons.Svg("x")</button>
        </div>
        <p class="muted" style="font-size:12px">@T("Valor em R$ = valor em US$ × taxa do ano da data de envio. Sem taxa cadastrada, a proposta", "Value in R$ = value in US$ × rate for the year of the sent date. Without a registered rate, the proposal") <strong>@T("não é convertida", "is not converted")</strong> @T("e a tela avisa. As taxas ficam guardadas e não precisam ser digitadas de novo.", "and the screen warns you. Rates are saved and don't need to be typed again.")</p>
        <table class="grid-tbl tbl-compact">
            <thead><tr><th>@T("Ano", "Year")</th><th class="right">@T("Taxa USD/BRL", "USD/BRL rate")</th><th>@T("Situação", "Status")</th></tr></thead>
            <tbody>
                @foreach (var ano in _taxasAnos)
                {
                    var a = ano;
                    <tr>
                        <td class="col-strong">@a</td>
                        <td class="right"><input class="field num" style="max-width:120px;text-align:right" placeholder="@T("ex.: 5,2000", "e.g. 5.2000")" value="@_taxasTxt.GetValueOrDefault(a, "")" @onchange="e => SetTaxa(a, e)" /></td>
                        @if (Cambio.Taxa(a) is { } t) { <td class="muted" style="font-size:12px">@T("salva:", "saved:") @t.ToString("0.0000", CulRz)</td> }
                        else if (TaxaPendente(a)) { <td style="font-size:12px;color:var(--neg);font-weight:700" title="@T("Há propostas deste ano com valor em US$ que não estão sendo convertidas", "There are proposals from this year with a US$ value that are not being converted")">@T("pendente", "pending")</td> }
                        else { <td class="muted" style="font-size:12px">@T("sem taxa", "no rate")</td> }
                    </tr>
                }
            </tbody>
        </table>
        <div style="display:flex;gap:8px;align-items:center;margin-top:12px">
            <input class="field num" style="max-width:110px" placeholder="@T("novo ano", "new year")" @bind="_novoAno" />
            <button class="btn-ghost sm" @onclick="AdicionarAno">@T("Adicionar ano", "Add year")</button>
        </div>
        @if (_taxasErro != "") { <div class="confirm-err">@_taxasErro</div> }
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _taxasAberto = false">@T("Cancelar", "Cancel")</button>
            <button class="btn-primary" @onclick="SalvarTaxas">@Icons.Svg("check")@T("Salvar taxas", "Save rates")</button>
        </div>
    </div>
}

@code {
    // Exportar do topo: o recorte global inteiro, sem a busca e a classificação da Base (essas valem no botão da própria Base).
    private Task ExportarBase() { var t = Colunas(); return Exportar(_f.OrderByDescending(i => i.P.Data).ToList(), t); }

    // ---- idioma da tela: cultura dos números escritos nesta marcação, mês e rótulos traduzidos ----
    private static readonly System.Globalization.CultureInfo _enRz = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    private System.Globalization.CultureInfo CulRz => _emIngles ? _enRz : _pt;
    /// <summary>Formato de data e hora do relatório no idioma da tela.</summary>
    private string FmtQuando => _emIngles ? "MM/dd/yyyy 'at' HH:mm" : "dd/MM/yyyy 'às' HH:mm";

    /// <summary>Rótulo do mês no filtro: o valor guardado continua em português ("Janeiro"); em inglês mostra "January".</summary>
    private string MesRotulo(string v)
    {
        if (!_emIngles) return v;
        for (var m = 1; m <= 12; m++)
            if (Fmt.MonthLong(m) == v) return _enRz.DateTimeFormat.GetMonthName(m);
        return v;
    }

    /// <summary>Rótulo da classificação no filtro da Base: o valor guardado continua em português.</summary>
    private string ClasseRotulo(string v) => !_emIngles ? v : v switch
    {
        "Ganha" => "Won", "Perdida" => "Lost", "Aberta" => "Open", "Não classificada" => "Unclassified", _ => v,
    };

    /// <summary>Nome de um filtro (chips) no idioma da tela.</summary>
    private string FiltroRot(string rot) => !_emIngles ? rot : rot switch
    {
        "Ano" => "Year", "Mês" => "Month", "Setor" => "Sector", "Vendedor" => "Salesperson", "Mercado" => "Market",
        "País" => "Country", "Produto" => "Product", _ => rot,
    };

    /// <summary>Atalho do índice no idioma da tela (as listas de âncoras ficam em português).</summary>
    private string AncoraRot(string t) => !_emIngles ? t : t switch
    {
        "Resumo" => "Summary", "Evolução" => "Trend", "Vendedores" => "Sales team", "Mercado" => "Market", "Produto" => "Product",
        "País" => "Country", "Valor por unidade" => "Value by unit", "Valor mensal" => "Monthly value", "Perdas" => "Losses",
        "Base" => "Data", "Qualidade" => "Quality", "Mês a mês" => "Month by month", "Ano × ano" => "Year × year",
        "Vendas × metas" => "Sales × targets", "Acumulado" => "Year to date", "Mês × ano" => "Month × year", _ => t,
    };

    private string TaxasTexto()
    {
        var l = RastroCambio().Where(x => x.Taxa is not null).Select(x => "(" + x.Ano + ": " + x.Taxa!.Value.ToString("0.0000", CulRz) + ")").ToList();
        return l.Count == 0 ? T("(nenhuma taxa cadastrada)", "(no rate registered)") : string.Join(" ", l);
    }

    // =====================================================================
    //  MODO EMBUTIDO · seções usadas na guia Performance Comercial
    // =====================================================================
    /// <summary>A barra de filtros (congelada no topo), com os atalhos para as seções.</summary>
    private RenderFragment BarraFiltros(IEnumerable<(string Id, string Titulo)> ancoras) => __builder =>
    {
        <div class="filterbar filterbar-sticky cvx-fb">
            <MultiFilter Label="@T("Ano", "Year")" AllText="@T("Todos", "All")" Ingles="_emIngles" Options="OpAnos" Selected="_anos" OnChanged="StateHasChanged" />
            <MultiFilter Label="@T("Mês", "Month")" AllText="@T("Todos", "All")" Ingles="_emIngles" Rotulo="MesRotulo" Options="OpMeses" Selected="_meses" OnChanged="StateHasChanged" />
            <MultiFilter Label="@T("Setor", "Sector")" AllText="@T("Ambos", "Both")" Ingles="_emIngles" Options="OpOrigens" Selected="_origens" OnChanged="StateHasChanged" />
            <MultiFilter Label="@T("Vendedor", "Salesperson")" AllText="@T("Todos", "All")" Ingles="_emIngles" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Searchable="true" Options="OpVendedores" Selected="_vend" OnChanged="StateHasChanged" />
            <MultiFilter Label="BU" AllText="@T("Todas", "All")" Ingles="_emIngles" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Options="OpBus" Selected="_bus" OnChanged="StateHasChanged" />
            <MultiFilter Label="BU Intercompany" AllText="@T("Todas", "All")" Ingles="_emIngles" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Options="OpBuIcs" Rotulo="RotuloValor" Selected="_buIcs" OnChanged="StateHasChanged" />
            <MultiFilter Label="@T("Mercado", "Market")" AllText="@T("Todos", "All")" Ingles="_emIngles" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Searchable="true" Options="OpMercados" Selected="_mercados" OnChanged="StateHasChanged" />
            <MultiFilter Label="@T("País", "Country")" AllText="@T("Todos", "All")" Ingles="_emIngles" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Searchable="true" Options="OpPaises" Selected="_paises" OnChanged="StateHasChanged" />
            <MultiFilter Label="@T("Produto", "Product")" AllText="@T("Todos", "All")" Ingles="_emIngles" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Searchable="true" Options="OpProdutos" Selected="_produtos" OnChanged="StateHasChanged" />
            <div class="cvx-base-taxa" title="@T("Base da taxa de conversão. Decididas: ganhas ÷ (ganhas + perdidas). Todas as propostas: ganhas ÷ tudo o que foi enviado, abertas inclusive.", "Conversion rate base. Decided: won ÷ (won + lost). All proposals: won ÷ everything sent, open included.")">
                <span class="flt-label">@T("Taxa sobre", "Rate base")</span>
                <div class="cvx-seg-ctl">
                    <button type="button" class="@(!_baseTodas ? "on" : "")" @onclick="() => _baseTodas = false">@T("Decididas", "Decided")</button>
                    <button type="button" class="@(_baseTodas ? "on" : "")" @onclick="() => _baseTodas = true">@T("Todas as propostas", "All proposals")</button>
                </div>
            </div>
            <div class="cvx-base-taxa" title="@T("Como a taxa de conversão é calculada. Quantidade: número de propostas ganhas ÷ base. Valor (R$): valor ganho ÷ valor da base. A base é a do botão \"Taxa sobre\".", "How the conversion rate is calculated. Count: number of won proposals ÷ base. Value (R$): won value ÷ base value. The base is set by the \"Rate base\" button.")">
                <span class="flt-label">@T("Conversão por", "Conversion by")</span>
                <div class="cvx-seg-ctl">
                    <button type="button" class="@(!_porValor ? "on" : "")" @onclick="() => _porValor = false">@T("Quantidade", "Count")</button>
                    <button type="button" class="@(_porValor ? "on" : "")" @onclick="() => _porValor = true">@T("Valor", "Value") (@Sim)</button>
                </div>
            </div>
            <div class="cvx-base-taxa" title="Idioma da tela · Screen language">
                <span class="flt-label">@T("Idioma", "Language")</span>
                <div class="cvx-seg-ctl">
                    <button type="button" class="@(!_emIngles ? "on" : "")" @onclick="() => _emIngles = false">PT</button>
                    <button type="button" class="@(_emIngles ? "on" : "")" @onclick="() => _emIngles = true">EN</button>
                </div>
            </div>
            <div class="cvx-base-taxa" title="@T("Moeda de todos os valores da tela. US$: o AFM usa o valor original da planilha; o NB, as vendas e os budgets (em R$) são divididos pela taxa USD/BRL do ano (guia Conversão → Taxas de câmbio).", "Currency for all values on screen. US$: AFM uses the original spreadsheet value; NB, sales and budgets (in R$) are divided by the year's USD/BRL rate (Conversion tab → Exchange rates).")">
                <span class="flt-label">@T("Moeda", "Currency")</span>
                <div class="cvx-seg-ctl">
                    <button type="button" class="@(!_emDolar ? "on" : "")" @onclick="() => _emDolar = false">R$</button>
                    <button type="button" class="@(_emDolar ? "on" : "")" @onclick="() => _emDolar = true">US$</button>
                </div>
                @if (_emDolar)
                {
                    <label class="cvx-taxa-tela" title="@T("Taxa R$/US$ só para esta tela: os valores que a tela mostra em R$ são divididos por ela. Não muda a base de dados nem as taxas cadastradas. Vazio = as taxas de cada ano (Taxas de câmbio).", "R$/US$ rate for this screen only: the values shown in R$ are divided by it. It does not change the data or the registered rates. Empty = each year's rate (Exchange rates).")">
                        <span>@T("Taxa", "Rate")</span>
                        <input type="text" inputmode="decimal" placeholder="@T("ex.: 5,40", "e.g. 5.40")" value="@(_taxaTela is double tv ? tv.ToString("0.####", _emIngles ? System.Globalization.CultureInfo.GetCultureInfo("en-US") : _pt) : _taxaTelaTexto)" @onchange="MudarTaxaTela" />
                    </label>
                }
            </div>
            <div class="cvx-chips" style="@(Ativos > 0 ? $"min-width:min(100%, {ChipsMin()}px)" : "")">
            @if (Ativos > 0)
            {
                @foreach (var (rot, set) in ConjuntosAtivos())
                {
                    <span class="cvx-chip" style="@ChipStyle(rot, set)" title="@FiltroRot(rot): @string.Join(", ", rot == "Mês" ? set.Select(MesRotulo) : set)"><b>@FiltroRot(ChipRot(rot))</b><span class="t">@(rot == "Mês" && _emIngles ? ChipTxt(new HashSet<string>(set.Select(MesRotulo))) : ChipTxt(set))</span><button title="@T("Remover filtro", "Remove filter") @FiltroRot(rot)" @onclick="() => { set.Clear(); _pag = 0; }">✕</button></span>
                }
                @if (_seg is { } sg)
                {
                    <span class="cvx-chip seg" style="--sc:@Cor(sg)"><b>@T("Segmento", "Segment")</b> @NomeEn(sg) <button title="@T("Remover o segmento", "Remove the segment")" @onclick="() => _seg = null">✕</button></span>
                }
                <button class="btn-link" @onclick="Limpar">@Icons.Svg("x")@T("Limpar filtros", "Clear filters")</button>
            }
            </div>
            @if (_f.Count > 0)
            {
                <nav class="cvx-index" aria-label="@T("Índice da página", "Page index")">
                    @foreach (var (id, t) in ancoras)
                    {
                        var ii = id;
                        <button type="button" @onclick="() => Ir(ii)">@AncoraRot(t)</button>
                    }
                </nav>
            }
        </div>

    };

    private RenderFragment Embutida() => __builder =>
    {
        if (_carregando && !_temDados)
        {
            <div class="cvx-skel"><div class="skel" style="height:@(Parte == "filtros" ? "54px" : "300px")"></div></div>
            return;
        }
        if (!_temDados) { if (Parte != "filtros") { <div class="cvx-card"><div class="empty" style="padding:34px 12px">@Conv.Mensagem</div></div> } return; }
        if (Parte == "filtros") { @BarraFiltros(AncorasEmbutido) return; }
        if (_f.Count == 0)
        {
            <div class="cvx-card"><div class="empty" style="padding:34px 12px">@T("Nenhuma proposta com os filtros atuais.", "No proposals match the current filters.") <button class="btn-link" @onclick="Limpar">@T("Limpar filtros", "Clear filters")</button></div></div>
            return;
        }
        <div class="cvx-page">
            @Secao("unidades", T("Conversão por Business Unit", "Conversion by Business Unit"), T("Taxa e valores por unidade de negócio · clique numa linha para filtrar", "Rate and values by business unit · click a row to filter"), BlocoUnidades(i => i.P.Bu, _bus, "bu"))
            <div class="cvx-lado-a-lado">
                @Secao("mercado", T("Conversão por mercado", "Conversion by market"), T("Clique numa linha para filtrar", "Click a row to filter"), BlocoUnidades(i => i.P.Mercado, _mercados, "merc", T("mercado", "market"), T("mercados", "markets")))
                @Secao("produto", T("Conversão por produto", "Conversion by product"), T("Clique numa linha para filtrar", "Click a row to filter"), BlocoUnidades(i => i.P.Produto, _produtos, "prod", T("produto", "product"), T("produtos", "products")))
            </div>
            @Secao("vendedores", T("Desempenho dos vendedores", "Sales team performance"), T("Ranking por taxa de conversão · clique num vendedor para ver o detalhe", "Ranking by conversion rate · click a salesperson to see the details"), Vendedores())
            @Secao("pais", T("Conversão por país", "Conversion by country"), T("Taxa de conversão por país · clique num país para filtrar · roda p/ zoom · arraste p/ mover", "Conversion rate by country · click a country to filter · scroll to zoom · drag to move"), Paises())
            @Secao("perdas", T("Análise das propostas perdidas", "Lost proposals analysis"), T("Pareto por status no CRM", "Pareto by CRM status"), Perdas())
            @Secao("base", T("Base de propostas", "Proposals data"), T("Todas as propostas do recorte, com colunas e exportação", "All proposals in the current selection, with columns and export"), Base())
        </div>
    };

    // =====================================================================
    //  NÍVEL 1 · EXECUTIVE OVERVIEW
    // =====================================================================
    // maiorEhMelhor: true = subir é bom (verde), false = subir é ruim (laranja), null = só informativo (neutro)
    private RenderFragment Kpi(string rotulo, string valor, string sub, string tip, string cor, string? delta = null, string? valorTip = null, bool? maiorEhMelhor = true) =>
        @<article class="cvx-kpi" style="--kc:@cor" title="@tip">
            <div class="cvx-lab">@rotulo</div>
            <div class="cvx-num" title="@valorTip">@valor</div>
            <div class="cvx-ksub">@sub</div>
            @if (delta is not null) { <div class="cvx-kdelta @DeltaCls(delta, maiorEhMelhor)">@Seta(delta)</div> }
        </article>;

    private string? DeltaVal(ClasseProposta c) =>
        _prev is not null && _r.Conv[(int)c] > 0 && _prev.Conv[(int)c] > 0 ? DeltaPct(_r.Val(c), _prev.Val(c)) : null;

    private string TituloTendencia() => _metTrend switch
    {
        "volume" => T("Propostas enviadas por mês, comparando os anos", "Proposals sent per month, comparing years"),
        "valor" => T($"Valor das propostas enviadas por mês ({Sim}), comparando os anos", $"Value of proposals sent per month ({Sim}), comparing years"),
        _ => T("Taxa de conversão mensal, comparando os anos", "Monthly conversion rate, comparing years"),
    };

    private static readonly (string Id, string Titulo)[] Ancoras =
    {
        ("resumo", "Resumo"), ("evolucao", "Evolução"), ("vendedores", "Vendedores"), ("unidades", "BU"),
        ("unidades-ic", "BU Intercompany"), ("mercado", "Mercado"), ("produto", "Produto"), ("pais", "País"), ("valor-unidades", "Valor por unidade"), ("valor-mensal", "Valor mensal"),
        ("perdas", "Perdas"), ("base", "Base"), ("qualidade", "Qualidade"),
    };

    private Task Ir(string id) => JS.InvokeVoidAsync("cvIr", id).AsTask();

    private RenderFragment Secao(string id, string titulo, string sub, RenderFragment corpo) => @<section id="@id" class="cvx-sec">
        <div class="xsec @(id == "resumo" ? "lvl1" : "")"><span class="xsec-t">@titulo</span><span class="xsec-s">@sub</span><span class="xsec-line"></span></div>
        @corpo
    </section>;

    private RenderFragment Pagina() => @<div class="cvx-page">
        @if (_seg is { } sg) { <div class="cvx-note" style="margin:0 2px 10px">@T("Segmento", "Segment") <b>@NomeEn(sg)</b> @T("ativo: ranking, unidades, evolução de volume e valor, valor mensal e perdas seguem o segmento; o Resumo mostra o total do recorte e as taxas de conversão não se aplicam.", "active: ranking, units, count and value trend, monthly value and losses follow the segment; the Summary shows the total of the selection and conversion rates do not apply.")</div> }
        @Secao("resumo", T("Resumo executivo", "Executive summary"), T("Indicadores principais e composição das propostas", "Key indicators and proposal breakdown"), ResumoGeral())
        @Secao("evolucao", T("Evolução mensal", "Monthly trend"), T("Tendência por mês de envio, um ano contra o outro", "Trend by month sent, one year against another"), Evolucao())
        @Secao("vendedores", T("Desempenho dos vendedores", "Sales team performance"), T("Ranking por taxa de conversão, com o denominador de cada linha", "Ranking by conversion rate, with each row's denominator"), Vendedores())
        @Secao("unidades", T("Conversão por Business Unit", "Conversion by Business Unit"), T("Taxa e valores por unidade de negócio · clique numa linha para filtrar", "Rate and values by business unit · click a row to filter"), BlocoUnidades(i => i.P.Bu, _bus, "bu"))
        @Secao("unidades-ic", T("Conversão por BU Intercompany", "Conversion by BU Intercompany"), T("Só AFM · taxa e valores por unidade intercompany · independente da BU", "AFM only · rate and values by intercompany unit · independent of BU"), BlocoUnidades(i => i.P.BuIc, _buIcs, "buic"))
        @Secao("mercado", T("Conversão por mercado", "Conversion by market"), T("Taxa de conversão e valores por mercado · clique numa linha para filtrar", "Conversion rate and values by market · click a row to filter"), BlocoUnidades(i => i.P.Mercado, _mercados, "merc", T("mercado", "market"), T("mercados", "markets")))
        @Secao("produto", T("Conversão por produto", "Conversion by product"), T("Taxa de conversão e valores por produto · clique numa linha para filtrar", "Conversion rate and values by product · click a row to filter"), BlocoUnidades(i => i.P.Produto, _produtos, "prod", T("produto", "product"), T("produtos", "products")))
        @Secao("pais", T("Conversão por país", "Conversion by country"), T("Taxa de conversão por país · clique num país para filtrar · roda p/ zoom · arraste p/ mover", "Conversion rate by country · click a country to filter · scroll to zoom · drag to move"), Paises())
        @Secao("valor-unidades", T("Valor por unidade", "Value by unit"), T($"Ganho, perdido e aberto em {Sim}, por BU e por BU Intercompany", $"Won, lost and open in {Sim}, by BU and by BU Intercompany"), ValorUnidades())
        @Secao("valor-mensal", T("Valor mensal das propostas", "Monthly value of proposals"), T($"Janeiro a dezembro · por status · {Sim}", $"January to December · by status · {Sim}"), ValorMensal())
        @Secao("perdas", T("Análise das propostas perdidas", "Lost proposals analysis"), T("Pareto por status no CRM", "Pareto by CRM status"), Perdas())
        @Secao("base", T("Base de propostas", "Proposals data"), T("Todas as propostas do recorte, com colunas e exportação", "All proposals in the current selection, with columns and export"), Base())
        @if (_isAdmin)
        {
            @Secao("qualidade", T("Qualidade e validação dos dados", "Data quality and validation"), T("Verificações de integridade, câmbio e classificação", "Integrity, exchange-rate and classification checks"), Qualidade())
        }
    </div>;

    /// <summary>Os 6 indicadores e a faixa secundária do Resumo — usados na tela e no relatório (mesmos números).</summary>
    private RenderFragment KpisResumo() => @<div>
        <div class="cvx-kpis">
            <article class="cvx-kpi main" style="--kc:@CorTx" title="@TituloRegra">
                <div class="cvx-lab">@T("Taxa de Conversão", "Conversion Rate")</div>
                <div class="cvx-num big">@TxQtdGlobal(_r)</div>
                <div class="cvx-ksub">@N0(_r.G) @T("ganhas", "won") / @N0(_r.Base) @DenRot</div>
                @{ var dw = DeltaWin(); }
                @if (dw.Texto != "") { <div class="cvx-delta @dw.Css">@dw.Texto</div> }
                <div class="cvx-ksub" title="@TituloValor">@(_porValor ? T("Por quantidade", "By count") : T("Por valor", "By value")): <b>@TxOutraGlobal(_r)</b></div>
            </article>
            @Kpi(T("Valor Ganho", "Won Value"), Din(_r, ClasseProposta.Ganha), T($"Propostas ganhas, em {Sim}", $"Won proposals, in {Sim}"),
                 (_emDolar ? T("Soma em US$ das propostas ganhas. O NB (em R$) é dividido pela taxa do ano de envio.", "Sum in US$ of won proposals. NB (in R$) is divided by the rate of the year sent.") : T("Soma em R$ das propostas ganhas. Cada valor em US$ é convertido pela taxa do ano de envio.", "Sum in R$ of won proposals. Each US$ value is converted at the rate of the year sent.")), CorG, DeltaVal(ClasseProposta.Ganha), DinTip(_r, ClasseProposta.Ganha))
            @Kpi(T("Valor em Aberto", "Open Value"), Din(_r, ClasseProposta.Aberta), T($"{N0(_r.A)} propostas abertas", $"{N0(_r.A)} open proposals"),
                 T($"Soma em {Sim} das propostas com status Open, convertida pela taxa do ano de envio.", $"Sum in {Sim} of proposals with status Open, converted at the rate of the year sent."), CorA, null /* aberto do ano anterior já foi decidido: variação não é comparável */, DinTip(_r, ClasseProposta.Aberta), null)
            @Kpi(T("Propostas Ganhas", "Won Proposals"), N0(_r.G), T($"{PctDe(_r.G, _r.Total)} do total enviado", $"{PctDe(_r.G, _r.Total)} of total sent"),
                 T("Propostas com status Closed - Won ou OTP. A participação no total não é a taxa de conversão.", "Proposals with status Closed - Won or OTP. The share of the total is not the conversion rate."), CorG, DeltaPct(_r.G, _prev?.G))
            @Kpi(T("Propostas Perdidas", "Lost Proposals"), N0(_r.P), T($"{PctDe(_r.P, _r.Total)} do total enviado", $"{PctDe(_r.P, _r.Total)} of total sent"),
                 T("Cancelled, Closed - Customer Lost, Closed - Lost, Closed - No Bid e Closed - Unknown.", "Cancelled, Closed - Customer Lost, Closed - Lost, Closed - No Bid and Closed - Unknown."), CorP, DeltaPct(_r.P, _prev?.P), null, false)
            @Kpi(T("Total de Propostas", "Total Proposals"), N0(_r.Total), T($"{N0(_r.Decididas)} decididas · {N0(_r.A)} abertas", $"{N0(_r.Decididas)} decided · {N0(_r.A)} open"),
                 T("Total no recorte = ganhas + perdidas + abertas + não classificadas.", "Total in the selection = won + lost + open + unclassified."), "#64748b", DeltaPct(_r.Total, _prev?.Total))
        </div>

        <div class="cvx-second">
            <span title="@DinTip(_r, ClasseProposta.Perdida)">@T("Valor perdido", "Lost value") <b>@Din(_r, ClasseProposta.Perdida)</b></span>
            <span title="@DinTotalTip(_r)">@T("Valor total cotado", "Total quoted value") <b>@DinTotal(_r)</b></span>
        </div>
    </div>;

    private RenderFragment ResumoGeral() => @<div>
        @KpisResumo()

        <section class="cvx-card cvx-comp">
            <div class="cvx-ch">
                <div>
                    <h3 class="cvx-h3">@T("Composição das propostas", "Proposal breakdown")</h3>
                    <p>@T("Participação de cada status no total · clique num segmento para destacá-lo no ranking, nas unidades, nos valores e nas perdas", "Share of each status in the total · click a segment to highlight it in the ranking, units, values and losses")</p>
                </div>
                <div class="cvx-total" title="@(_r.NC > 0 ? T($"Inclui {N0(_r.NC)} proposta(s) com status fora da lista (não classificadas), detalhadas em Qualidade dos dados.", $"Includes {N0(_r.NC)} proposal(s) with a status outside the list (unclassified), detailed in Data quality.") : T("Ganhas + perdidas + abertas", "Won + lost + open"))"><small>@T("TOTAL DE PROPOSTAS", "TOTAL PROPOSALS")</small><b>@N0(_r.Total)</b></div>
            </div>
            @{ var baseBarra = Math.Max(_r.G + _r.P + _r.A, 1); }
            <div class="cvx-stackbar tall">
                @foreach (var c in ClassesBarra)
                {
                    var n = _r.Qtd(c);
                    if (n == 0) { continue; }
                    var pct = Largura(n, _r.Total);
                    <button type="button" class="cvx-seg @ClasseCss(c) @(_seg == c ? "on" : "") @(_seg is not null && _seg != c ? "dim" : "")" style="width:@F(n * 100.0 / baseBarra)%;background:@Cor(c)"
                            title="@($"{NomeEn(c)}: {N0(n)} ({PctDe(n, _r.Total)}) · {Din(_r, c)}\n{DefClasse(c)}")" @onclick="() => AlternarSeg(c)">
                        @if (pct >= 9) { <span class="t">@P1(pct)</span><span class="v">@Din(_r, c)</span> }
                    </button>
                }
            </div>
            <div class="cvx-lgd">
                @foreach (var c in ClassesBarra)
                {
                    <button type="button" class="cvx-lg @(_seg == c ? "on" : "")" style="--lc:@Cor(c)" title="@DinTip(_r, c)" @onclick="() => AlternarSeg(c)">
                        <i></i>
                        <span class="n">@NomeEn(c)</span>
                        <b>@N0(_r.Qtd(c))</b>
                        <span class="p">@PctDe(_r.Qtd(c), _r.Total) @T("das propostas", "of proposals")</span>
                        <span class="m">@Din(_r, c)</span>
                    </button>
                }
            </div>
        </section>
    </div>;

    private RenderFragment Evolucao() => @<div class="cvx-card cvx-trend">
        <div class="cvx-ch">
            <div>
                <h3 class="cvx-h3">@TituloTendencia()</h3>
                <p>@T("Uma linha por ano · mês de ENVIO da proposta, com o status atual — não é a data de fechamento.", "One line per year · month the proposal was SENT, with its current status — not the closing date.")</p>
            </div>
            <div class="cvx-ctrl">
                <div class="cvx-seg-ctl">
                    <button class="@(_metTrend == "winrate" ? "on" : "")" @onclick='() => _metTrend = "winrate"'>@T("Taxa de conversão", "Conversion rate")</button>
                    <button class="@(_metTrend == "volume" ? "on" : "")" @onclick='() => _metTrend = "volume"'>@T("Quantidade", "Count")</button>
                    <button class="@(_metTrend == "valor" ? "on" : "")" @onclick='() => _metTrend = "valor"'>@T("Valor", "Value") (@Sim)</button>
                </div>
            </div>
        </div>
        @Tendencia(0)
        <p class="cvx-note">@(_metTrend == "winrate" ? T("Taxa do mês = propostas ganhas ÷ todas as propostas enviadas naquele mês. Meses recentes têm mais propostas ainda abertas: a taxa deles tende a subir quando forem decididas.", "Monthly rate = won proposals ÷ all proposals sent that month. Recent months have more proposals still open: their rate tends to rise as they are decided.") : T("O mês em andamento ainda recebe propostas: o número dele pode mudar.", "The month in progress is still receiving proposals: its figure may change.")) @T("Para comparar anos, deixe o filtro de Ano em \"Todos\".", "To compare years, leave the Year filter on \"All\".")</p>
    </div>;

    // ---- vendedores -------------------------------------------------------
    private RenderFragment Vendedores() => @<section class="cvx-card">
        @{ var lista = VendLista(out var ocultos); }
        <div class="cvx-ch">
            <div class="cvx-xh">
                <span class="xcard-ico">@Icons.Svg("users")</span>
                <div>
                    <h2>@(_taxaOk ? T("Taxa de conversão por vendedor", "Conversion rate by salesperson") : T("Propostas por vendedor no segmento selecionado", "Proposals by salesperson in the selected segment"))</h2>
                    <p>@lista.Count @T("vendedores", "salespeople") · @RegraCurta · @T("role para ver todos · a marca vertical é a média do grupo", "scroll to see all · the vertical mark is the group average")</p>
                </div>
            </div>
            @if (_taxaOk) { <span class="xcard-total"><span>@T("Média do grupo", "Group average")</span><b>@TxQtdGlobal(_rx)</b></span> }
            <div class="cvx-ctrl">
                <label class="cvx-fld">@T("Ordenar por", "Sort by")
                    <select @bind="_ordVend">
                        <option value="wr">@T("Taxa de conversão", "Conversion rate")</option>
                        <option value="valor">@T("Valor ganho", "Won value")</option>
                        <option value="ganhas">@T("Propostas ganhas", "Won proposals")</option>
                        <option value="decididas">@T("Propostas decididas", "Decided proposals")</option>
                        <option value="perdidas">@T("Propostas perdidas", "Lost proposals")</option>
                    </select>
                </label>
                <label class="cvx-fld" title="@T("Esconde vendedores com poucas propostas decididas: uma única venda não pode virar 100% de conversão no topo.", "Hides salespeople with few decided proposals: a single sale can't become 100% conversion at the top.")">@T("Mínimo de decididas", "Minimum decided")
                    <input type="number" min="0" value="@_minDec" @onchange="SetMinDec" />
                </label>
            </div>
        </div>
        @if (lista.Count == 0)
        {
            <div class="empty" style="padding:24px">@T($"Nenhum vendedor com {_minDec} ou mais propostas decididas. Reduza o mínimo.", $"No salesperson with {_minDec} or more decided proposals. Lower the minimum.")</div>
        }
        else
        {
            <div class="ibar cvx-ibar scroll-y @(_vendSel is not null ? "has-active" : "")">
                @for (var i = 0; i < lista.Count; i++)
                {
                    var (nome, r) = lista[i];
                    var vn = nome;
                    <div class="ibar-item @(i < 3 ? $"top{i + 1}" : "") @(_vendSel == nome ? "xf-on" : "")" title="@T("Clique para ver o detalhe de", "Click to see the details for") @nome" @onclick="() => AbrirVendedor(vn)">
                        <div class="ibar-head">
                            <span class="ibar-num">@(i + 1)</span>
                            <span class="ibar-name">@nome</span>
                            @if (_taxaOk && r.Decididas < AmostraMinima) { <span class="cv-amostra" title="@T($"Menos de {AmostraMinima} decididas: a taxa oscila muito", $"Fewer than {AmostraMinima} decided: the rate swings a lot")">@T("amostra pequena", "small sample")</span> }
                            <span class="ibar-metrics">
                                <span class="cvx-ibm g" title="@T("Propostas ganhas", "Won proposals")">@N0(r.G) <small>@T("ganhas", "won")</small></span>
                                <span class="cvx-ibm p" title="@T("Propostas perdidas", "Lost proposals")">@N0(r.P) <small>@T("perdidas", "lost")</small></span>
                                <span class="cvx-ibm a" title="@T("Propostas abertas", "Open proposals")">@N0(r.A) <small>@T("abertas", "open")</small></span>
                                <span class="ibar-sep"></span>
                                <span class="cvx-ibm" title="@DinTip(r, ClasseProposta.Ganha)">@Din(r, ClasseProposta.Ganha) <small>@T("ganho", "won")</small></span>
                                <span class="ibar-sep"></span>
                                <span class="ibar-val">@TxQtd(r)</span>
                                <span class="ibar-share" title="@T("Ganhas de decididas", "Won of decided")">@N0(r.G)/@N0(r.Decididas)</span>
                            </span>
                        </div>
                        <div class="ibar-track cvx-ib-track"><span class="ibar-fill" style="width:@F(_taxaOk ? r.TaxaQtd ?? 0 : 0)%"></span>@if (_taxaOk && _rx.TaxaQtd is { } gm) { <em class="cvx-ib-mk" style="left:@F(gm)%" title="@T("Média do grupo", "Group average"): @P1(gm)"></em> }</div>
                    </div>
                }
            </div>
            @if (ocultos > 0) { <p class="cvx-note">@T($"{ocultos} vendedor(es) com menos de {_minDec} propostas decididas estão ocultos do ranking (continuam nos totais).", $"{ocultos} salesperson(s) with fewer than {_minDec} decided proposals are hidden from the ranking (still counted in the totals).")</p> }
        }
    </section>;

    private RenderFragment PainelVendedor(string nome) => @<div>
        @{
            var itens = _f.Where(i => i.P.Vendedor == nome).ToList();
            var rv = Somar(itens);
            var grp = _r;
            var cmp = rv.TaxaQtd is { } vr && grp.TaxaQtd is { } gr && rv.Decididas > 0 ? vr - gr : (double?)null;
        }
        <div class="drawer-backdrop" @onclick="() => _vendSel = null"></div>
        <div class="drawer cvx-drawer">
            <div class="page-head">
                <div><h2 style="color:var(--primary)">@nome</h2><p class="subtitle">@(_seg is null ? T("Mesmos filtros e período do painel", "Same filters and period as the dashboard") : T("Mesmos filtros e período, sem o segmento", "Same filters and period, without the segment")) · @N0(rv.Total) @T("propostas", "proposals")</p></div>
                <button class="icon-btn" @onclick="() => _vendSel = null">@Icons.Svg("x")</button>
            </div>
            @if (_seg is { } sgv) { <div class="cvx-note">@T("Segmento", "Segment") @NomeEn(sgv) @T("ignorado neste detalhamento: a taxa de conversão considera todas as classes.", "ignored in this breakdown: the conversion rate considers all classes.")</div> }
            <div class="cvx-dkpis">
                <div><small>@T("TAXA DE CONVERSÃO", "CONVERSION RATE")</small><b>@TxQtdGlobal(rv)</b><span>@N0(rv.G) @T("de", "of") @N0(rv.Base) @DenRot</span></div>
                <div><small>@T("VALOR GANHO", "WON VALUE")</small><b title="@DinTip(rv, ClasseProposta.Ganha)">@Din(rv, ClasseProposta.Ganha)</b><span>@T("Conversão", "Conversion") @(_porValor ? T("por quantidade", "by count") : T("por valor", "by value")) @TxOutraGlobal(rv)</span></div>
            </div>
            <div class="cvx-dcmp">
                @if (cmp is { } c && rv.Decididas < AmostraMinima)
                {
                    <span>@T($"Amostra pequena ({N0(rv.Decididas)} decididas): comparação com o grupo ({TxQtdGlobal(grp)}) apenas indicativa.", $"Small sample ({N0(rv.Decididas)} decided): comparison with the group ({TxQtdGlobal(grp)}) is only indicative.")</span>
                }
                else if (cmp is { } c2)
                {
                    <span>@T("Taxa de conversão", "Conversion rate") <b>@(c2 >= 0 ? T("acima", "above") : T("abaixo", "below"))</b> @T("da média do grupo em", "the group average by") <b>@Pp(c2)</b> (@T("grupo", "group"): @TxQtdGlobal(grp), @N0(grp.Decididas) @T("decididas", "decided"))</span>
                }
                else { <span>@T("Comparação com o grupo indisponível: sem propostas decididas.", "Comparison with the group unavailable: no decided proposals.")</span> }
            </div>
            <h3 class="cvx-dh">@T("Composição das propostas", "Proposal breakdown")</h3>
            @Html(HtmlComposicao(rv))
            <h3 class="cvx-dh">@T("Histórico mensal da taxa de conversão", "Monthly conversion rate history")</h3>
            @Html(SvgWinRate(itens, 0, true, false, 600))
            <h3 class="cvx-dh">@T("Distribuição por BU", "Breakdown by BU")</h3>
            <table class="cvx-mini-tbl">
                <thead><tr><th>BU</th><th class="r">@T("Propostas", "Proposals")</th><th class="r">@T("Decididas", "Decided")</th><th class="r">@T("Conversão", "Conversion")</th><th class="r">@T("Valor ganho", "Won value")</th></tr></thead>
                <tbody>
                    @foreach (var (bn, br) in Grupos(itens, i => i.P.Bu))
                    {
                        <tr><td><b>@bn</b></td><td class="r">@N0(br.Total)</td><td class="r">@N0(br.Decididas)</td><td class="r">@TxQtdGlobal(br)</td><td class="r" title="@DinTip(br, ClasseProposta.Ganha)">@Din(br, ClasseProposta.Ganha)</td></tr>
                    }
                </tbody>
            </table>
            <h3 class="cvx-dh">@T("Distribuição das perdas (status no CRM)", "Breakdown of losses (CRM status)")</h3>
            @{
                var perdas = itens.Where(i => i.P.Classe == ClasseProposta.Perdida)
                    .GroupBy(i => ConversaoService.NormalizarStatus(i.P.StatusOriginal))
                    .Select(g => (Nome: g.First().P.StatusOriginal, Qtd: g.Count(), Valor: g.Sum(i => i.Brl ?? 0), ComUsd: g.Count(i => i.P.ValorUsd is not null), Conv: g.Count(i => i.Brl is not null)))
                    .OrderByDescending(x => x.Qtd).ToList();
            }
            @if (perdas.Count == 0) { <div class="cvx-note">@T("Nenhuma proposta perdida deste vendedor no recorte.", "No lost proposals for this salesperson in the selection.")</div> }
            else
            {
                <table class="cvx-mini-tbl">
                    <thead><tr><th>Status</th><th class="r">@T("Propostas", "Proposals")</th><th class="r">@T("Participação", "Share")</th><th class="r">@T("Valor", "Value")</th></tr></thead>
                    <tbody>
                        @foreach (var p in perdas)
                        {
                            <tr><td><b>@p.Nome</b></td><td class="r">@N0(p.Qtd)</td><td class="r">@PctDe(p.Qtd, rv.P)</td><td class="r" title="@EstadoTip(p.ComUsd, p.Conv, p.Valor)">@Estado(p.ComUsd, p.Conv, p.Valor)</td></tr>
                        }
                    </tbody>
                </table>
            }
            <div class="modal-actions"><button class="btn-ghost" @onclick="() => _vendSel = null">@T("Fechar", "Close")</button></div>
        </div>
    </div>;

    // ---- unidades -----------------------------------------------------------
    private string RelCss(Resumo r) =>
        !_taxaOk || r.Decididas < AmostraMinima || r.TaxaQtd is not { } t || _rx.TaxaQtd is not { } m ? "" : t >= m + 5 ? "pos" : t <= m - 5 ? "neg" : "";

    private RenderFragment BlocoUnidades(Func<Item, string> sel, HashSet<string> filtro, string exceto, string singular = "unidade", string plural = "unidades") => @<div class="cvx-card">
        @{
            var lista = UnidadesOrdenadas(sel, exceto);
            var sing = singular == "unidade" ? T("unidade", "unit") : singular;
            var plu = plural == "unidades" ? T("unidades", "units") : plural;
        }
        <div class="cvx-ch">
            <div class="cvx-xh">
                <span class="xcard-ico">@Icons.Svg("bar-chart")</span>
                <div><h2>@T("Taxa de conversão por", "Conversion rate by") @sing</h2><p>@lista.Count @plu · @RegraCurta · @T("clique para filtrar o painel · a marca vertical é a média do recorte", "click to filter the dashboard · the vertical mark is the selection average")</p></div>
            </div>
            @if (_taxaOk) { <span class="xcard-total"><span>@T("Média do recorte", "Selection average")</span><b>@TxQtdGlobal(_rx)</b></span> }
        </div>
        <div class="ibar cvx-ibar scroll-y @(filtro.Count > 0 ? "has-active" : "")">
            @{ var pos = 0; }
            @foreach (var (nome, r) in lista)
            {
                pos++;
                var un = nome;
                <div class="ibar-item @(pos <= 3 ? $"top{pos}" : "") @(filtro.Contains(nome) ? "xf-on" : "")" title="@T("Clique para filtrar por", "Click to filter by") @nome" @onclick="() => Alternar(filtro, un)">
                    <div class="ibar-head">
                        <span class="ibar-num">@pos</span>
                        <span class="ibar-name">@nome</span>
                        <span class="ibar-metrics">
                            <span class="cvx-ibm" title="@T("Propostas enviadas", "Proposals sent")">@N0(r.Total) <small>@T("propostas", "proposals")</small></span>
                            <span class="cvx-ibm" title="@T("Ganhas + perdidas", "Won + lost")">@N0(r.Decididas) <small>@T("decididas", "decided")</small></span>
                            <span class="ibar-sep"></span>
                            <span class="cvx-ibm g" title="@DinTip(r, ClasseProposta.Ganha)">@Din(r, ClasseProposta.Ganha) <small>@T("ganho", "won")</small></span>
                            <span class="cvx-ibm p" title="@DinTip(r, ClasseProposta.Perdida)">@Din(r, ClasseProposta.Perdida) <small>@T("perdido", "lost")</small></span>
                            <span class="cvx-ibm a" title="@DinTip(r, ClasseProposta.Aberta)">@Din(r, ClasseProposta.Aberta) <small>@T("aberto", "open")</small></span>
                            <span class="ibar-sep"></span>
                            <span class="cvx-ibm" title="@TituloValor">@TxOutra(r) <small>@OutraRot</small></span>
                            <span class="ibar-val @RelCss(r) @(r.Base == 0 ? "cvx-na" : "")">@TxQtd(r)</span>
                        </span>
                    </div>
                    <div class="ibar-track cvx-ib-track"><span class="ibar-fill" style="width:@F(_taxaOk ? r.TaxaQtd ?? 0 : 0)%"></span>@if (_taxaOk && _rx.TaxaQtd is { } gm) { <em class="cvx-ib-mk" style="left:@F(gm)%" title="@T("Média do recorte", "Selection average"): @P1(gm)"></em> }</div>
                </div>
            }
        </div>
        <p class="cvx-note">@T($"Taxa em verde: pelo menos 5 p.p. acima da média do recorte; em vermelho: 5 p.p. abaixo (só com {AmostraMinima}+ decididas). As barras partem do zero e vão até 100%.", $"Rate in green: at least 5 pp above the selection average; in red: 5 pp below (only with {AmostraMinima}+ decided). Bars start at zero and go up to 100%.")</p>
    </div>;

    // ---- países: mapa (cor = taxa de conversão) + lista; clique filtra o painel
    private RenderFragment Paises() => @<div class="cvx-card">
        @{
            var lista = UnidadesOrdenadas(i => i.P.Pais, "pais");
            var noMapa = lista.Count(x => WorldMap.Chave(x.Nome) is not null);
            var txs = lista.Select(x => x.R.TaxaQtd).Where(x => x is not null).Select(x => x!.Value).ToList();
            (_txMin, _txMax) = txs.Count == 0 ? (0d, 100d) : (txs.Min(), txs.Max());
        }
        <div class="cvx-ch">
            <div class="cvx-xh">
                <span class="xcard-ico">@Icons.Svg("target")</span>
                <div><h2>@T("Taxa de conversão por país", "Conversion rate by country")</h2><p>@lista.Count @T("países", "countries") · @RegraCurta · @T($"cor mais escura = taxa maior (escala de {P1(_txMin)} a {P1(_txMax)})", $"darker color = higher rate (scale from {P1(_txMin)} to {P1(_txMax)})")@(noMapa < lista.Count ? T($" · {lista.Count - noMapa} sem posição no mapa (aparecem só na lista)", $" · {lista.Count - noMapa} with no position on the map (shown only in the list)") : "")</p></div>
            </div>
            <div class="map-zoom">
                <button class="icon-btn" title="@T("Diminuir", "Zoom out")" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapaId, 1/1.3)'>@Icons.Svg("down")</button>
                <button class="icon-btn" title="@T("Aumentar", "Zoom in")" @onclick='() => JS.InvokeVoidAsync("worldMap.zoom", MapaId, 1.3)'>@Icons.Svg("up")</button>
                <button class="icon-btn" title="@T("Redefinir", "Reset")" @onclick='() => JS.InvokeVoidAsync("worldMap.reset", MapaId)'>@Icons.Svg("target")</button>
            </div>
        </div>
        @if (lista.Count == 0)
        {
            <div class="empty">@T("Sem dados no recorte.", "No data in the selection.")</div>
        }
        else
        {
            <div class="worldmap" id="@MapaId">
                <div class="worldmap-inner">@Html(SvgMapaPaises(lista))</div>
            </div>
            <div class="map-legend cols cvx-maplist">
                @foreach (var (nome, r) in lista)
                {
                    var pn = nome;
                    <div class="ml-row @(_paises.Contains(nome) ? "xf-on" : "")" @onclick="() => Alternar(_paises, pn)" title="@nome: @N0(r.G) @T("ganhas de", "won of") @N0(r.Base) @DenRot · @N0(r.Total) @T("propostas · clique para filtrar", "proposals · click to filter")">
                        <span class="ml-dot" style="background:@CorTaxa(r)"></span><span class="ml-name">@nome</span><span class="ml-val">@TxQtd(r)</span><span class="ml-pct">@N0(r.G)/@N0(r.Decididas)</span>
                    </div>
                }
            </div>
        }
    </div>;

