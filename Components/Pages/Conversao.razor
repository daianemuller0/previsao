            sb.Append($"<span class='rank-num'>{i + 1}</span><span class='cv-name'>{Esc(nome)}</span>");
            sb.Append($"<span class='cv-k'><small>Valor ganho</small><b title='{Esc(Fmt.Brl(r.VG))}'>{Esc(R(r.VG))}</b></span>");
            sb.Append($"<span class='cv-k'><small>Taxa (qtd.)</small><b>{Esc(r.TaxaQtd is { } tq ? P1(tq) : "—")}</b></span>");
            sb.Append($"<span class='cv-k'><small>Taxa (valor)</small><b>{Esc(r.TaxaValor is { } tv ? P1(tv) : "—")}</b></span>");
            sb.Append($"<div class='cv-stack' style='width:{F(r.Total / (double)maxTotal * 100)}%'>");
            if (r.G > 0) sb.Append($"<i style='flex:{r.G};background:{CorG}' title='Ganhas: {r.G}'></i>");
            if (r.P > 0) sb.Append($"<i style='flex:{r.P};background:{CorP}' title='Perdidas: {r.P}'></i>");
            if (r.A > 0) sb.Append($"<i style='flex:{r.A};background:{CorA}' title='Abertas: {r.A}'></i>");
            if (r.NC > 0) sb.Append($"<i style='flex:{r.NC};background:{CorN}' title='Não classificadas: {r.NC}'></i>");
            sb.Append("</div>");
            sb.Append($"<span class='cv-sub'>{r.Total} propostas · <b style='color:{CorG}'>{r.G} ganhas</b> · <b style='color:{CorP}'>{r.P} perdidas</b> · <b style='color:{CorA}'>{r.A} abertas</b> · {r.Decididas} decididas");
            if (pequena) sb.Append(" · <span class='cv-amostra' title='Poucas propostas decididas: a taxa varia muito com uma única venda'>amostra pequena</span>");
            sb.Append("</span></div>");
        }
        sb.Append("</div></div>");
        builder.AddMarkupContent(0, sb.ToString());
    };

