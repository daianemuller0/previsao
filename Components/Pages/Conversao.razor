    // ---- qualidade e validação ------------------------------------------------
    private RenderFragment Qualidade() => @<section class="cvx-card">
        @{
            var total = Conv.Atual.Propostas.Count;
            var geral = Somar(_itens);
            var somaCat = geral.G + geral.P + geral.A + geral.NC;
            var okQtd = total == somaCat && total == _itens.Count;
            var okFiltro = _f.Count == _r.G + _r.P + _r.A + _r.NC;
            var okDec = _r.Decididas == _r.G + _r.P;
            var indep = _itens.Sum(i => i.Brl ?? 0);
            var okValor = Math.Abs(indep - geral.VTotal) < 0.01 && Math.Abs(_f.Sum(i => i.Brl ?? 0) - _r.VTotal) < 0.01;
            var okTabela = _f.Count == _r.Total;
        }
        <h2 class="cvx-h2s">@T("Verificações de integridade", "Integrity checks")</h2>
        <ul class="cv-checks cvx-checks">
            <li class="@(okQtd ? "ok" : "bad")">@(okQtd ? "✔" : "✖") @T($"Total de registros ({N0(total)}) = ganhas ({N0(geral.G)}) + perdidas ({N0(geral.P)}) + abertas ({N0(geral.A)}) + não classificadas ({N0(geral.NC)})", $"Total records ({N0(total)}) = won ({N0(geral.G)}) + lost ({N0(geral.P)}) + open ({N0(geral.A)}) + unclassified ({N0(geral.NC)})")</li>
            <li class="@(okFiltro ? "ok" : "bad")">@(okFiltro ? "✔" : "✖") @T("No recorte atual:", "In the current selection:") @N0(_f.Count) = @N0(_r.G) + @N0(_r.P) + @N0(_r.A) + @N0(_r.NC)</li>
            <li class="@(okDec ? "ok" : "bad")">@(okDec ? "✔" : "✖") @T($"Decididas ({N0(_r.Decididas)}) = ganhas + perdidas · abertas e não classificadas fora do denominador da Taxa de conversão", $"Decided ({N0(_r.Decididas)}) = won + lost · open and unclassified excluded from the Conversion rate denominator")</li>
            <li class="@(okValor ? "ok" : "bad")">@(okValor ? "✔" : "✖") @T("Soma dos valores das categorias = valor total das propostas com conversão válida", "Sum of category values = total value of proposals with a valid conversion") (@(Sim + " " + geral.VTotal.ToString("#,##0", CulRz)) @T("na base toda", "in the whole data set"))</li>
            <li class="@(okTabela ? "ok" : "bad")">@(okTabela ? "✔" : "✖") @T("Base de Propostas e dashboard usam o mesmo recorte:", "Proposals data and dashboard use the same selection:") @N0(_f.Count) @T("registros", "records")</li>
            <li class="@(geral.SemTaxa == 0 ? "ok" : "bad")">@(geral.SemTaxa == 0 ? "✔" : "✖") @T("Propostas com valor mas sem taxa de câmbio:", "Proposals with a value but no exchange rate:") @N0(geral.SemTaxa)@(geral.SemTaxa > 0 ? T($" (US$ {geral.UsdSemTaxa.ToString("N0", CulRz)} fora dos valores em R$)", $" (US$ {geral.UsdSemTaxa.ToString("N0", CulRz)} excluded from the R$ values)") : "")</li>
            @if (geral.SemData > 0)
            {
                <li class="bad">✖ @T($"Propostas com valor mas sem data de envio: {N0(geral.SemData)} (US$ {geral.UsdSemData.ToString("N0", CulRz)} fora dos valores em R$)", $"Proposals with a value but no sent date: {N0(geral.SemData)} (US$ {geral.UsdSemData.ToString("N0", CulRz)} excluded from the R$ values)")</li>
            }
            <li class="info">ℹ @T($"Propostas sem valor na planilha (US$ no AFM, R$ no NB): {N0(geral.SemValor)} — contam nas quantidades, não nos valores", $"Proposals without a value in the spreadsheet (US$ in AFM, R$ in NB): {N0(geral.SemValor)} — included in the counts, not in the values")</li>
        </ul>

        <h2 class="cvx-h2s" style="margin-top:18px">@T("Conversão cambial rastreável (recorte atual · só AFM, o NB já vem em R$)", "Traceable currency conversion (current selection · AFM only, NB is already in R$)")</h2>
        <table class="cvx-mini-tbl">
            <thead><tr><th>@T("Ano de envio", "Year sent")</th><th class="r">@T("Taxa USD/BRL", "USD/BRL rate")</th><th class="r">@T("Propostas", "Proposals")</th><th class="r">@T("Valor original (US$)", "Original value (US$)")</th><th class="r">@T("Valor convertido (R$)", "Converted value (R$)")</th><th class="r">@T("Sem taxa", "No rate")</th></tr></thead>
            <tbody>
                @foreach (var l in RastroCambio())
                {
                    <tr>
                        <td><b>@(l.Ano == "Sem data" ? T("Sem data", "No date") : l.Ano)</b></td>
                        <td class="r">@(l.Taxa is { } tx ? tx.ToString("0.0000", CulRz) : l.Ano == "Sem data" ? T("sem data de envio", "no sent date") : T("não cadastrada", "not registered"))</td>
                        <td class="r">@N0(l.Propostas)</td>
                        <td class="r">@l.Usd.ToString("N0", CulRz)</td>
                        <td class="r">@(l.Taxa is null ? (l.Ano == "Sem data" ? "—" : T("Não convertido", "Not converted")) : _emIngles ? "R$ " + l.Brl.ToString("#,##0", _enRz) : Fmt.Brl(l.Brl))</td>
                        <td class="r" style="@(l.SemTaxa > 0 ? "color:var(--neg);font-weight:700" : "")">@N0(l.SemTaxa)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="cvx-note">@T("Valor em R$ = valor em US$ × taxa do ano da data de envio da proposta. O estado do valor é sempre explícito: R$ 0 (zero real), — (sem informação), Não convertido (sem taxa) e Não calculável (sem denominador).", "Value in R$ = value in US$ × rate for the year of the proposal's sent date. The value state is always explicit: R$ 0 (zero), — (no information), Not converted (no rate) and Not calculable (no denominator).")</p>

        @if (Conv.Atual.Avisos.Count > 0)
        {
            <h2 class="cvx-h2s" style="margin-top:18px">@T("Avisos da leitura da planilha", "Spreadsheet reading warnings")</h2>
            <ul class="cv-checks cvx-checks">@foreach (var a in Conv.Atual.Avisos) { <li class="warn">⚠ @a</li> }</ul>
        }
        @if (_r.NC > 0)
        {
            <h2 class="cvx-h2s" style="margin-top:18px">@T("Status não classificados (aguardando validação)", "Unclassified statuses (pending validation)")</h2>
            <table class="cvx-mini-tbl">
                <thead><tr><th>@T("Status na planilha", "Status in the spreadsheet")</th><th class="r">@T("Propostas", "Proposals")</th></tr></thead>
                <tbody>
                    @foreach (var g in _f.Where(i => i.P.Classe == ClasseProposta.NaoClassificada).GroupBy(i => ConversaoService.NormalizarStatus(i.P.StatusOriginal)).Select(x => (Nome: x.First().P.StatusOriginal == "" ? T("(vazio)", "(empty)") : x.First().P.StatusOriginal, Qtd: x.Count())).OrderByDescending(x => x.Qtd))
                    {
                        <tr><td><b>@g.Nome</b></td><td class="r">@N0(g.Qtd)</td></tr>
                    }
                </tbody>
            </table>
        }
        <h2 class="cvx-h2s" style="margin-top:18px">@T("Colunas lidas da planilha", "Columns read from the spreadsheet")</h2>
        <ul class="cv-checks cvx-checks">@foreach (var m in Conv.Atual.Mapeamento) { <li class="info">@m</li> }</ul>
    </section>;

    // =====================================================================
    //  BASE DE PROPOSTAS
    // =====================================================================
    private RenderFragment Base() => @<div class="cvx-card">
        @{
            if (_ocultas is null) CarregarOcultas();
            var todas = Colunas();
            var visiveis = todas.Where(c => _ocultas is null || !_ocultas.Contains(c.Key)).ToList();
            var linhas = LinhasTabela(todas);
            var paginas = Math.Max(1, (linhas.Count + PorPagina - 1) / PorPagina);
            if (_pag >= paginas) _pag = paginas - 1;
            var pagina = linhas.Skip(_pag * PorPagina).Take(PorPagina).ToList();
            var rt = Somar(linhas);
        }
        <div class="cv-tools filterbar cvx-basebar">
            <BuscaAdiada Value="@_busca" Geracao="_limpezas" OnBuscar="t => { _busca = t; _pag = 0; }" />
            <MultiFilter Label="@T("Classificação", "Classification")" AllText="@T("Todas", "All")" Ingles="_emIngles" Rotulo="ClasseRotulo" EmptyText="@T("Sem opções no recorte.", "No options in the current selection.")" Options="NomesClasse" Selected="_classes" OnChanged="StateHasChanged" />
            <details class="cv-cols">
                <summary class="btn-ghost sm">@Icons.Svg("layers")@T("Colunas", "Columns")</summary>
                <div class="cv-cols-panel">
                    <button type="button" class="btn-link" style="margin:2px 8px 6px" @onclick="RestaurarOrdem">@T("Restaurar a ordem original", "Restore the original order")</button>
                    @foreach (var c in todas)
                    {
                        var k = c.Key;
                        <label class="flt-check"><input type="checkbox" checked="@(_ocultas is null || !_ocultas.Contains(k))" @onchange="() => AlternarColuna(k)" /><span>@TituloCol(c)</span></label>
                    }
                </div>
            </details>
            <div class="filterbar-spacer"></div>
            <span class="muted" style="font-size:12px" title="@T($"Registros na tabela · soma do valor convertido em {Sim}", $"Records in the table · sum of the converted value in {Sim}")">@N0(linhas.Count) @(linhas.Count == 1 ? T("registro", "record") : T("registros", "records")) · <b style="color:var(--text)">@DinTotal(rt)</b></span>
            <button class="btn-primary sm" disabled="@(linhas.Count == 0)" @onclick="() => Exportar(linhas, todas)">@Icons.Svg("download")@T("Exportar Excel", "Export Excel")</button>
        </div>
        <div class="table-wrap tbl-compact" style="max-height:62vh;overflow:auto">
            <table class="grid-tbl">
                <thead>
                    <tr id="cv-th-base" class="th-drag">
                        @foreach (var c in visiveis)
                        {
                            var k = c.Key;
                            <th class="@c.Align cv-sort" draggable="true" data-key="@k" title="@T("Clique para ordenar · arraste para mudar a coluna de lugar", "Click to sort · drag to move the column")" @onclick="() => Ordenar(k)">@TituloCol(c)@(_ordCol == k ? (_ordAsc ? " ▲" : " ▼") : "")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in pagina)
                    {
                        <tr>
                            @foreach (var c in visiveis)
                            {
                                if (c.Key == "classe")
                                {
                                    <td class="center"><span class="cv-badge @ClasseCss(i.P.Classe)">@NomeClasse(i.P.Classe)</span></td>
                                }
                                else if (c.Key == "taxa" && i.Taxa is null)
                                {
                                    <td class="right" style="color:var(--neg)" title="@T("Sem taxa de câmbio para este ano", "No exchange rate for this year")">@T("sem taxa", "no rate")</td>
                                }
                                else
                                {
                                    <td class="@c.Align">@TextoCol(c, i)</td>
                                }
                            }
                        </tr>
                    }
                    @if (linhas.Count == 0)
                    {
                        <tr><td colspan="@Math.Max(visiveis.Count, 1)" class="empty">@T("Nenhum registro com os filtros atuais.", "No records match the current filters.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cv-pager">
            <span class="muted">@T("Mostrando", "Showing") @(linhas.Count == 0 ? 0 : _pag * PorPagina + 1)–@Math.Min((_pag + 1) * PorPagina, linhas.Count) @T("de", "of") @N0(linhas.Count)</span>
            <button class="btn-ghost sm" disabled="@(_pag == 0)" @onclick="() => _pag = 0">«</button>
            <button class="btn-ghost sm" disabled="@(_pag == 0)" @onclick="() => _pag--">‹</button>
            <span>@T("página", "page") @(_pag + 1) @T("de", "of") @paginas</span>
            <button class="btn-ghost sm" disabled="@(_pag >= paginas - 1)" @onclick="() => _pag++">›</button>
            <button class="btn-ghost sm" disabled="@(_pag >= paginas - 1)" @onclick="() => _pag = paginas - 1">»</button>
        </div>
    </div>;

    // =====================================================================
    //  RELATÓRIO EXECUTIVO · 2 páginas A4 horizontais (imprimir / salvar PDF)
