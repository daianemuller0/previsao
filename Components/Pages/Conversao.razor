@page "/conversao"
@attribute [Authorize(Roles = "admin,diretor")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ConversaoService Conv
@inject CambioAnualRepository Cambio
@inject ColumnPrefsRepository ColPrefs
@inject IJSRuntime JS
@using System.Text

@* ===========================================================================
   Conversão de propostas · dashboard executivo + base de propostas.
   UMA fonte de números: Recalcular() monta _itens (planilha + câmbio do ano) e
   _f (itens depois dos filtros globais). Cards, gráficos, rankings e a tabela
   da Base leem _f e Somar() — nenhuma aba tem conta própria.
   =========================================================================== *@

@{ Recalcular(); }

<div class="breadcrumbs"><span>Executivo</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Conversão</span></div>

<div class="page-head">
    <div>
        <h1>Conversão de Propostas</h1>
        <p class="subtitle">
            Ganhas, perdidas e abertas · mês e ano pela data de envio da proposta · valores em R$ pela taxa de câmbio do ano da proposta<br />
            @if (Conv.AtualizadoEm is { } quando)
            {
                <span>Atualizado em @quando.ToString("dd/MM/yyyy 'às' HH:mm") · @Conv.Atual.Propostas.Count.ToString("N0", _pt) registros</span>
                @if (!Conv.Ok) { <span style="color:var(--neg)"> · @Conv.Mensagem</span> }
            }
            else { <span>@Conv.Mensagem</span> }
        </p>
    </div>
    <div class="page-actions">
        @if (_isAdmin)
        {
            <button class="btn-ghost" title="Taxa USD/BRL de cada ano" @onclick="AbrirTaxas">@Icons.Svg("layers")Taxas de câmbio</button>
        }
        <button class="btn-ghost" title="Reler a planilha agora" disabled="@_carregando" @onclick="Atualizar">@Icons.Svg("import")@(_carregando ? "Atualizando…" : "Atualizar")</button>
    </div>
</div>

<div class="tabs">
    <button class="tab @(_aba == "dash" ? "active" : "")" @onclick='() => _aba = "dash"'>Dashboard de Conversão</button>
    <button class="tab @(_aba == "base" ? "active" : "")" @onclick='() => _aba = "base"'>Base de Propostas @if (_temDados) { <span class="tab-badge">@_f.Count.ToString("N0", _pt)</span> }</button>
</div>

@if (_carregando && !_temDados)
{
    <div class="info-banner">Lendo a planilha de propostas…</div>
}
else if (!_temDados)
{
    <div class="panel"><div class="empty" style="padding:28px 12px">@Conv.Mensagem</div></div>
}
else
{
    @* ---- filtros globais (valem para as duas abas) ---- *@
    <div class="filterbar filterbar-sticky">
        <MultiFilter Label="Ano" AllText="Todos" Options="OpAnos" Selected="_anos" OnChanged="StateHasChanged" />
        <MultiFilter Label="Mês" AllText="Todos" Options="OpMeses" Selected="_meses" OnChanged="StateHasChanged" />
        <MultiFilter Label="Vendedor" AllText="Todos" Searchable="true" Options="OpVendedores" Selected="_vend" OnChanged="StateHasChanged" />
        <MultiFilter Label="BU" AllText="Todas" Options="OpBus" Selected="_bus" OnChanged="StateHasChanged" />
        <MultiFilter Label="BU Intercompany" AllText="Todas" Options="OpBuIcs" Selected="_buIcs" OnChanged="StateHasChanged" />
        <div class="filterbar-spacer"></div>
        @if (Ativos > 0)
        {
            <span class="tag">@Ativos filtro(s) ativo(s)</span>
            <button class="btn-link" @onclick="Limpar">@Icons.Svg("x")Limpar filtros</button>
        }
    </div>
    @if (Ativos > 0)
    {
        <div class="cv-chips">
            @foreach (var (rot, set) in ConjuntosAtivos())
            {
                <span class="cv-chip"><b>@rot</b> @string.Join(", ", set.Take(4))@(set.Count > 4 ? $" +{set.Count - 4}" : "")</span>
            }
        </div>
    }

    @* ---- avisos que afetam números ---- *@
    @if (_r.SemTaxa > 0)
    {
        <div class="cv-alert">
            <strong>@_r.SemTaxa.ToString("N0", _pt) proposta(s) (@Fmt.Usd(_r.UsdSemTaxa)) sem taxa de câmbio</strong> para @string.Join(", ", AnosSemTaxa()).
            Esses valores <strong>não entram</strong> nos totais em R$ — as quantidades continuam completas.
            @if (_isAdmin) { <span> Cadastre em <a href="javascript:void(0)" @onclick="AbrirTaxas">Taxas de câmbio</a>.</span> }
            else { <span> Peça ao administrador para cadastrar a taxa.</span> }
        </div>
    }
    @if (_r.NC > 0)
    {
        <div class="cv-alert warn">
            <strong>@_r.NC.ToString("N0", _pt) proposta(s) com status não classificado</strong> — ficam fora de ganhas, perdidas e abertas e das taxas de ganho. Veja o detalhe no fim do dashboard.
        </div>
    }

    @if (_aba == "dash") { @Dashboard() } else { @Base() }
}

@* ---- taxas de câmbio (administrador) ---- *@
@if (_taxasAberto)
{
    <div class="drawer-backdrop" @onclick="() => _taxasAberto = false"></div>
    <div class="drawer">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">Taxas de câmbio</h2>
                <p class="subtitle">USD/BRL de cada ano · usada nas propostas enviadas naquele ano</p>
            </div>
            <button class="icon-btn" @onclick="() => _taxasAberto = false">@Icons.Svg("x")</button>
        </div>
        <p class="muted" style="font-size:12px">Valor em R$ = valor em US$ × taxa do ano da data de envio. Sem taxa cadastrada, a proposta <strong>não é convertida</strong> (e a tela avisa). As taxas ficam guardadas e não precisam ser digitadas de novo.</p>
        <table class="grid-tbl tbl-compact">
            <thead><tr><th>Ano</th><th class="right">Taxa USD/BRL</th><th>Situação</th></tr></thead>
            <tbody>
                @foreach (var ano in _taxasAnos)
                {
                    var a = ano;
                    <tr>
                        <td class="col-strong">@a</td>
                        <td class="right"><input class="field num" style="max-width:120px;text-align:right" placeholder="ex.: 5,2000" value="@_taxasTxt.GetValueOrDefault(a, "")" @onchange="e => SetTaxa(a, e)" /></td>
                        <td class="muted" style="font-size:12px">@(Cambio.Taxa(a) is { } t ? $"salva: {t.ToString("0.0000", _pt)}" : "sem taxa")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="display:flex;gap:8px;align-items:center;margin-top:12px">
            <input class="field num" style="max-width:110px" placeholder="novo ano" @bind="_novoAno" />
            <button class="btn-ghost sm" @onclick="AdicionarAno">Adicionar ano</button>
        </div>
        @if (_taxasErro != "") { <div class="confirm-err">@_taxasErro</div> }
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _taxasAberto = false">Cancelar</button>
            <button class="btn-primary" @onclick="SalvarTaxas">@Icons.Svg("check")Salvar taxas</button>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private const string CorG = "#1f9254", CorP = "#c0392b", CorA = "#1b5fa9", CorN = "#94a3b8";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _isAdmin, _carregando;
    private string _login = "", _user = "—";
    private string _aba = "dash";
    private bool _temDados => Conv.Atual.Propostas.Count > 0;

    // ---- filtros globais ----
    private static HashSet<string> Novo() => new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _anos = Novo(), _meses = Novo(), _vend = Novo(), _bus = Novo(), _buIcs = Novo();
    private int Ativos => new[] { _anos, _meses, _vend, _bus, _buIcs }.Count(s => s.Count > 0);
    private IEnumerable<(string, HashSet<string>)> ConjuntosAtivos() =>
        new[] { ("Ano", _anos), ("Mês", _meses), ("Vendedor", _vend), ("BU", _bus), ("BU Intercompany", _buIcs) }.Where(x => x.Item2.Count > 0);
    private void Limpar() { _anos.Clear(); _meses.Clear(); _vend.Clear(); _bus.Clear(); _buIcs.Clear(); _pag = 0; }

    // ---- modelo calculado: UMA vez por renderização ----
    private sealed record Item(PropostaConv P, int? Ano, int? Mes, double? Taxa, double? Brl);

    private sealed class Resumo
    {
        public int Total, G, P, A, NC, SemTaxa, SemValor;
        public double VG, VP, VA, VNC, UsdSemTaxa;
        public int Decididas => G + P;
        public double VTotal => VG + VP + VA + VNC;
        public double? TaxaQtd => Decididas > 0 ? (double)G / Decididas * 100 : null;
        public double? TaxaValor => (VG + VP) > 0 ? VG / (VG + VP) * 100 : null;
    }

    private List<Item> _itens = new();
    private List<Item> _f = new();
    private Resumo _r = new();
    private Resumo? _prev;
    private (int, int) _chave = (-1, -1);

    private void Recalcular()
    {
        var chave = (Conv.Version, Cambio.Version);
        if (chave != _chave) { Reconstruir(); _chave = chave; }
        _f = Aplicar().ToList();
        _r = Somar(_f);
        _prev = null;
        // Comparação com o período anterior: só quando há UM ano escolhido — mesmos meses e filtros, ano anterior.
        if (_anos.Count == 1 && int.TryParse(_anos.First(), out var a))
            _prev = Somar(Aplicar("ano").Where(i => i.Ano == a - 1));
    }

    private void Reconstruir()
    {
        var taxas = Cambio.Todas();
        _itens = Conv.Atual.Propostas.Select(p =>
        {
            int? ano = p.Data?.Year, mes = p.Data?.Month;
            double? tx = ano is { } y && taxas.TryGetValue(y, out var t) ? t : null;
            double? brl = p.ValorUsd is { } v && tx is { } t2 ? v * t2 : null;
            return new Item(p, ano, mes, tx, brl);
        }).ToList();
    }

    private static string AnoTxt(Item i) => i.Ano?.ToString() ?? "Sem data";

    private IEnumerable<Item> Aplicar(string? exceto = null)
    {
        IEnumerable<Item> q = _itens;
        if (exceto != "ano" && _anos.Count > 0) q = q.Where(i => _anos.Contains(AnoTxt(i)));
        if (exceto != "mes" && _meses.Count > 0) q = q.Where(i => i.Mes is { } m && _meses.Contains(Fmt.MonthLong(m)));
        if (exceto != "vend" && _vend.Count > 0) q = q.Where(i => _vend.Contains(i.P.Vendedor));
        if (exceto != "bu" && _bus.Count > 0) q = q.Where(i => _bus.Contains(i.P.Bu));
        if (exceto != "buic" && _buIcs.Count > 0) q = q.Where(i => _buIcs.Contains(i.P.BuIc));
        return q;
    }

    private static Resumo Somar(IEnumerable<Item> itens)
    {
        var r = new Resumo();
        foreach (var i in itens)
        {
            r.Total++;
            var tem = i.Brl is not null; var b = i.Brl ?? 0;
            switch (i.P.Classe)
            {
                case ClasseProposta.Ganha: r.G++; if (tem) r.VG += b; break;
                case ClasseProposta.Perdida: r.P++; if (tem) r.VP += b; break;
                case ClasseProposta.Aberta: r.A++; if (tem) r.VA += b; break;
                default: r.NC++; if (tem) r.VNC += b; break;
            }
            if (i.P.ValorUsd is null) r.SemValor++;
            else if (i.Brl is null) { r.SemTaxa++; r.UsdSemTaxa += i.P.ValorUsd.Value; }
        }
        return r;
    }

    private List<(string Nome, Resumo R)> Grupos(Func<Item, string> chave) =>
        _f.GroupBy(chave, StringComparer.OrdinalIgnoreCase)
          .Select(g => (Nome: g.Key, R: Somar(g)))
          .OrderByDescending(x => x.R.VTotal).ThenByDescending(x => x.R.Total).ToList();

    // opções em cascata: cada filtro mostra só o que existe com os OUTROS filtros aplicados
    private IEnumerable<string> OpAnos => Aplicar("ano").Select(AnoTxt).Distinct().OrderByDescending(x => x == "Sem data" ? "0" : x);
    private IEnumerable<string> OpMeses => Enumerable.Range(1, 12).Select(Fmt.MonthLong);
    private IEnumerable<string> OpVendedores => Aplicar("vend").Select(i => i.P.Vendedor).Distinct().OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<string> OpBus => Aplicar("bu").Select(i => i.P.Bu).Distinct().OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<string> OpBuIcs => Aplicar("buic").Select(i => i.P.BuIc).Distinct().OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<string> AnosSemTaxa() =>
        _f.Where(i => i.P.ValorUsd is not null && i.Brl is null).Select(AnoTxt).Distinct().OrderBy(x => x);

    // ---- ciclo de vida ----
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var u = (await AuthState).User;
            _isAdmin = u.IsInRole("admin");
            _user = u.Identity?.Name ?? "—";
            _login = u.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? _user;
        }
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(false)); } finally { _carregando = false; }
        if (_temDados) CarregarOcultas();
    }

    private async Task Atualizar()
    {
        if (_carregando) return;
        _carregando = true;
        try { await Task.Run(() => Conv.Carregar(true)); } finally { _carregando = false; }
    }

    private static string R(double v) => "R$ " + Fmt.Compact(v);
    private static string P1(double v) => Fmt.Pct(v, 1);
    private static string PctDe(double parte, double todo) => todo > 0 ? Fmt.Pct(parte / todo * 100, 1) : "—";
    private static string Esc(string s) => System.Net.WebUtility.HtmlEncode(s ?? "");
    private static string F(double v) => v.ToString("0.##", Inv);
    private static double? Delta(double atual, double? anterior) => anterior is > 0 ? (atual - anterior.Value) / anterior.Value * 100 : null;

    // ======================================================================
    //  ABA 1 · DASHBOARD
    // ======================================================================
    private RenderFragment Dashboard() => @<div>
        @if (_f.Count == 0)
        {
            <div class="panel"><div class="empty" style="padding:30px 12px">Nenhuma proposta com os filtros atuais. <button class="btn-link" @onclick="Limpar">Limpar filtros</button></div></div>
        }
        else
        {
            @* ---- KPIs ---- *@
            <div class="exec-grid cols-3 cv-kpis">
                <StatCard Label="Total de propostas" Value="@_r.Total.ToString("N0", _pt)" AccentLeft="true" Context="@(Descricao())"
                          Delta="@Delta(_r.Total, _prev?.Total)" Info="@InfoTotal()" />
                <StatCard Label="Propostas ganhas" Value="@_r.G.ToString("N0", _pt)" AccentLeft="true" Context="@($"{PctDe(_r.G, _r.Total)} do total")"
                          Delta="@Delta(_r.G, _prev?.G)">
                    <div class="cv-mini"><i style="width:@F(Largura(_r.G, _r.Total))%;background:@CorG"></i></div>
                </StatCard>
                <StatCard Label="Propostas perdidas" Value="@_r.P.ToString("N0", _pt)" AccentLeft="true" Context="@($"{PctDe(_r.P, _r.Total)} do total")"
                          Delta="@Delta(_r.P, _prev?.P)">
                    <div class="cv-mini"><i style="width:@F(Largura(_r.P, _r.Total))%;background:@CorP"></i></div>
                </StatCard>
                <StatCard Label="Propostas abertas" Value="@_r.A.ToString("N0", _pt)" AccentLeft="true" Context="@($"{PctDe(_r.A, _r.Total)} do total")"
                          Delta="@Delta(_r.A, _prev?.A)">
                    <div class="cv-mini"><i style="width:@F(Largura(_r.A, _r.Total))%;background:@CorA"></i></div>
                </StatCard>
                <StatCard Label="Valor total em propostas" Value="@R(_r.VTotal)" AccentLeft="true"
                          Context="@(_r.NC > 0 && _r.VNC > 0 ? $"inclui {R(_r.VNC)} não classificados" : "soma em R$ das propostas convertidas")"
                          Info="@($"{Fmt.Brl(_r.VTotal)}")" Delta="@Delta(_r.VTotal, _prev?.VTotal)" />
                <StatCard Label="Valor convertido em vendas" Value="@R(_r.VG)" AccentLeft="true"
                          Context="@(_r.TaxaValor is { } tv ? $"{P1(tv)} de taxa de ganho por valor" : "sem propostas decididas")"
                          Info="@($"{Fmt.Brl(_r.VG)}")" Delta="@Delta(_r.VG, _prev?.VG)" />
            </div>

            @* ---- quantidade × valor ---- *@
            <div class="g12">
                <div class="c6"><div class="panel">
                    <div class="panel-head"><div class="panel-title">Conversão por quantidade <span class="hint">ganhas · perdidas · abertas</span></div><TelaCheia /></div>
                    @Donut()
                </div></div>
                <div class="c6"><div class="panel">
                    <div class="panel-head"><div class="panel-title">Conversão por valor <span class="hint">R$ por categoria · passe o mouse para o valor completo</span></div><TelaCheia /></div>
                    @BarrasValor()
                </div></div>
            </div>

            @* ---- evolução ---- *@
            <div class="panel">
                <div class="panel-head">
                    <div class="panel-title">Evolução mensal <span class="hint">por mês de ENVIO da proposta, com o status atual — não é a data de fechamento</span></div>
                    <div class="segmented">
                        <button class="@(_metMes == "qtd" ? "active" : "")" @onclick='() => _metMes = "qtd"'>Quantidade</button>
                        <button class="@(_metMes == "valor" ? "active" : "")" @onclick='() => _metMes = "valor"'>Valor (R$)</button>
                    </div>
                    <TelaCheia />
                </div>
                @Mensal()
            </div>

            @* ---- vendedores ---- *@
            <div class="panel">
                <div class="panel-head">
                    <div class="panel-title">Conversão por vendedor <span class="hint">taxas só sobre propostas decididas (ganhas + perdidas)</span></div>
                    <div class="segmented">
                        <button class="@(_ordVend == "valor" ? "active" : "")" @onclick='() => _ordVend = "valor"'>Valor ganho</button>
                        <button class="@(_ordVend == "qtd" ? "active" : "")" @onclick='() => _ordVend = "qtd"'>Qtd. ganha</button>
                        <button class="@(_ordVend == "taxa" ? "active" : "")" @onclick='() => _ordVend = "taxa"'>Taxa de ganho</button>
                    </div>
                    <TelaCheia />
                </div>
                @Vendedores()
            </div>

            @* ---- BU e BU intercompany ---- *@
            <div class="panel">
                <div class="panel-head"><div class="panel-title">Conversão por BU <span class="hint">coluna V · barra = composição do valor</span></div><TelaCheia /></div>
                @TabelaGrupo(Grupos(i => i.P.Bu))
            </div>
            <div class="panel">
                <div class="panel-head"><div class="panel-title">Conversão por BU Intercompany <span class="hint">AG; se vazia, AF · independente da BU acima</span></div><TelaCheia /></div>
                @TabelaGrupo(Grupos(i => i.P.BuIc))
            </div>

            @* ---- perdas ---- *@
            <div class="panel">
                <div class="panel-head">
                    <div class="panel-title">Status das propostas perdidas <span class="hint">onde mais perdemos e o impacto financeiro</span></div>
                    <div class="segmented">
                        <button class="@(_metPerda == "qtd" ? "active" : "")" @onclick='() => _metPerda = "qtd"'>Quantidade</button>
                        <button class="@(_metPerda == "valor" ? "active" : "")" @onclick='() => _metPerda = "valor"'>Valor (R$)</button>
                    </div>
                    <TelaCheia />
                </div>
                @Perdas()
            </div>

            @if (_r.NC > 0)
            {
                <div class="panel">
                    <div class="panel-head"><div class="panel-title">Status não classificados <span class="hint">revisão — fora de ganhas, perdidas e abertas</span></div></div>
                    <table class="grid-tbl tbl-compact">
                        <thead><tr><th>Status na planilha</th><th class="right">Propostas</th><th class="right">Valor (R$)</th></tr></thead>
                        <tbody>
                            @foreach (var nc in StatusNaoClassificados())
                            {
                                <tr><td class="col-strong">@nc.Nome</td><td class="right num">@nc.Qtd.ToString("N0", _pt)</td><td class="right num" title="@Fmt.Brl(nc.Valor)">@R(nc.Valor)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @Verificacoes()
        }
    </div>;

    private string InfoTotal() => _prev is null
        ? "Quantidade de propostas no recorte"
        : $"Variação sobre {int.Parse(_anos.First()) - 1}: mesmos filtros e meses";

    private void SetTaxa(int ano, ChangeEventArgs e) => _taxasTxt[ano] = e.Value?.ToString() ?? "";
    private void Buscar(ChangeEventArgs e) { _busca = e.Value?.ToString() ?? ""; _pag = 0; }

    private string Descricao() => _prev is null ? "no recorte selecionado" : $"vs. {int.Parse(_anos.First()) - 1}";
    private List<(string Nome, int Qtd, double Valor)> StatusNaoClassificados() =>
        _f.Where(i => i.P.Classe == ClasseProposta.NaoClassificada)
          .GroupBy(i => ConversaoService.NormalizarStatus(i.P.StatusOriginal))
          .Select(x => (Nome: x.First().P.StatusOriginal == "" ? "(vazio)" : x.First().P.StatusOriginal, Qtd: x.Count(), Valor: x.Sum(i => i.Brl ?? 0)))
          .OrderByDescending(x => x.Qtd).ToList();

    private static double Largura(double parte, double todo) => todo > 0 ? parte / todo * 100 : 0;

    // ---- gráfico 1: rosca ----
    private RenderFragment Donut() => builder =>
    {
        var fatias = new List<(string Nome, int Qtd, string Cor)> { ("Ganhas", _r.G, CorG), ("Perdidas", _r.P, CorP), ("Abertas", _r.A, CorA) };
        if (_r.NC > 0) fatias.Add(("Não classificadas", _r.NC, CorN));
        double total = Math.Max(_r.Total, 1), raio = 51, C = 2 * Math.PI * raio, acum = 0;
        var sb = new StringBuilder("<div class='donut-wrap cv-donut'>");
        sb.Append("<svg viewBox='0 0 128 128' class='donut-svg' role='img' aria-label='Conversão por quantidade'>");
        sb.Append($"<circle cx='64' cy='64' r='{F(raio)}' fill='none' stroke='#eef2f7' stroke-width='15'/>");
        foreach (var f in fatias)
        {
            if (f.Qtd == 0) continue;
            var len = f.Qtd / total * C;
            sb.Append($"<circle class='cv-arc' cx='64' cy='64' r='{F(raio)}' fill='none' stroke='{f.Cor}' stroke-width='15' stroke-dasharray='{F(len)} {F(C - len)}' stroke-dashoffset='{F(C / 4 - acum)}'><title>{Esc(f.Nome)}: {f.Qtd.ToString("N0", _pt)} ({Esc(PctDe(f.Qtd, _r.Total))})</title></circle>");
            acum += len;
        }
        sb.Append($"<text x='64' y='63' text-anchor='middle' font-size='21' font-weight='800' fill='#12304f'>{Esc(_r.Total.ToString("N0", _pt))}</text>");
        sb.Append("<text x='64' y='78' text-anchor='middle' font-size='9' fill='#6b7a90'>propostas</text></svg>");
        sb.Append("<ul class='donut-legend'>");
