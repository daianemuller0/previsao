    // ---- gráfico 3: evolução mensal (colunas empilhadas) ----
    private string _metMes = "qtd", _metPerda = "qtd", _ordVend = "valor";

    private RenderFragment Mensal() => builder =>
    {
        var comData = _f.Where(i => i.Ano is not null).ToList();
        if (comData.Count == 0) { builder.AddMarkupContent(0, "<div class='empty'>Nenhuma proposta com data de envio no recorte.</div>"); return; }
        var porMes = comData.GroupBy(i => new DateTime(i.Ano!.Value, i.Mes!.Value, 1)).ToDictionary(g => g.Key, g => Somar(g));
        var ini = porMes.Keys.Min(); var fim = porMes.Keys.Max();
        var meses = new List<DateTime>();
        for (var m = ini; m <= fim; m = m.AddMonths(1)) meses.Add(m);

        bool qtd = _metMes == "qtd";
        double Val(Resumo r, int c) => qtd ? c switch { 0 => r.G, 1 => r.P, 2 => r.A, _ => r.NC } : c switch { 0 => r.VG, 1 => r.VP, 2 => r.VA, _ => r.VNC };
        var temNc = comData.Any(i => i.P.Classe == ClasseProposta.NaoClassificada);
        var cats = temNc ? 4 : 3;
        var cores = new[] { CorG, CorP, CorA, CorN };
        var nomes = new[] { "Ganhas", "Perdidas", "Abertas", "Não classificadas" };
        double maxY = 1;
        foreach (var m in meses) if (porMes.TryGetValue(m, out var r0)) maxY = Math.Max(maxY, Enumerable.Range(0, cats).Sum(c => Val(r0, c)));

        const double W = 1000, H = 300, L = 54, Rr = 12, T = 14, B = 38;
        var passo = (W - L - Rr) / meses.Count; var larg = Math.Min(passo * 0.62, 46);
        double Y(double v) => T + (H - T - B) * (1 - v / maxY);
        string Rot(double v) => qtd ? F(Math.Round(v)) : R(v);

        var sb = new StringBuilder("<div class='chart-body'>");
        sb.Append($"<svg viewBox='0 0 {F(W)} {F(H)}' role='img' aria-label='Evolução mensal'>");
        for (var k = 0; k <= 4; k++)
        {
            var v = maxY * k / 4;
            sb.Append($"<line x1='{F(L)}' y1='{F(Y(v))}' x2='{F(W - Rr)}' y2='{F(Y(v))}' stroke='#e3e9f2'/>");
            sb.Append($"<text x='{F(L - 6)}' y='{F(Y(v) + 3)}' text-anchor='end' font-size='10' fill='#6b7a90'>{Esc(Rot(v))}</text>");
        }
        var salto = meses.Count > 24 ? 3 : meses.Count > 12 ? 2 : 1;
        for (var i = 0; i < meses.Count; i++)
        {
            var x = L + passo * i + (passo - larg) / 2;
            porMes.TryGetValue(meses[i], out var r);
            if (r is not null)
            {
                double acum = 0;
                for (var c = 0; c < cats; c++)
                {
                    var v = Val(r, c); if (v <= 0) continue;
                    sb.Append($"<rect class='cv-seg' x='{F(x)}' y='{F(Y(acum + v))}' width='{F(larg)}' height='{F(Y(acum) - Y(acum + v))}' fill='{cores[c]}' rx='2'><title>{Esc(nomes[c])} em {Esc(meses[i].ToString("MMM/yy", _pt))}: {Esc(qtd ? F(v) + " proposta(s)" : Fmt.Brl(v))}</title></rect>");
                    acum += v;
                }
            }
            if (i % salto == 0)
                sb.Append($"<text x='{F(x + larg / 2)}' y='{F(H - B + 16)}' text-anchor='middle' font-size='10' fill='#3b4a61'>{Esc(meses[i].ToString("MMM/yy", _pt))}</text>");
        }
        sb.Append("</svg><div class='cv-leg'>");
        for (var c = 0; c < cats; c++) sb.Append($"<span><i class='cv-dot' style='background:{cores[c]}'></i>{nomes[c]}</span>");
        sb.Append("</div>");
        var semData = _f.Count - comData.Count;
        if (semData > 0) sb.Append($"<p class='cv-nota'>{semData.ToString("N0", _pt)} proposta(s) sem data de envio válida não aparecem neste gráfico (continuam nos totais).</p>");
        sb.Append("</div>");
        builder.AddMarkupContent(0, sb.ToString());
    };

    // ---- gráfico 4: vendedores ----
