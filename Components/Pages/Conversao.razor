            <div><button class="btn-primary sm" @onclick="Imprimir">@Icons.Svg("download")@T("Imprimir / Salvar PDF", "Print / Save PDF")</button> <button class="btn-ghost sm" @onclick="FecharRelatorio">@T("Voltar ao painel", "Back to the dashboard")</button></div>
        </div>

        <section class="rpt-page">
            <header class="rpt-head">
                <div><div class="cvx-title"><span class="cvx-mark">HOWDEN</span><span class="cvx-dash">|</span>@T("Inteligência Comercial", "Commercial Intelligence")</div><div class="cvx-sub">@T("Conversão de Propostas · Howden Brasil · valores em", "Proposal Conversion · Howden Brasil · values in") @Sim</div></div>
                <div class="rpt-meta"><span><b>@T("Período", "Period")</b> @PeriodoTxt()</span><span><b>@T("Dados lidos em", "Data read on")</b> @(Conv.AtualizadoEm is { } q ? q.ToString(FmtQuando, CulRz) : "—")</span><span><b>@T("Emitido em", "Issued on")</b> @DateTime.Now.ToString(FmtQuando, CulRz) · @_user</span><span><b>@T("Filtros", "Filters")</b> @NotasFiltros()</span></div>
            </header>
            @if (!Conv.Ok) { <p class="rpt-alert">@Conv.Mensagem</p> }
            @if (_seg is not null) { <p class="rpt-small" style="margin:0">@T("O segmento selecionado na tela não se aplica ao relatório.", "The segment selected on screen does not apply to the report.")</p> }
            @KpisResumo()
            @if (_r.SemTaxa > 0) { <p class="rpt-alert">@T($"* Valor parcial: {N0(_r.SemTaxa)} proposta(s) (US$ {_r.UsdSemTaxa.ToString("N0", CulRz)}) de {string.Join(", ", AnosSemTaxa())} sem taxa de câmbio ficaram fora dos totais em R$. As quantidades estão completas.", $"* Partial value: {N0(_r.SemTaxa)} proposal(s) (US$ {_r.UsdSemTaxa.ToString("N0", CulRz)}) from {string.Join(", ", AnosSemTaxa())} without an exchange rate were left out of the R$ totals. The counts are complete.")</p> }
            <div class="rpt-row2">
                <div class="rpt-box">
                    <h3>@T($"Composição das {N0(_r.Total)} propostas enviadas", $"Breakdown of the {N0(_r.Total)} proposals sent")</h3>
                    @Html(HtmlComposicao(_r))
                    <h3 style="margin-top:12px">@T("Composição por valor", "Breakdown by value") (@Sim)</h3>
                    @Html(HtmlComposicaoValor(_r))
                </div>
                <div class="rpt-box">
                    <h3>@T("Taxa de conversão mensal — mês de envio, status atual", "Monthly conversion rate — month sent, current status")</h3>
                    @Html(SvgWinRate(_f, 0, true, true, 640))
                </div>
            </div>
            <div class="rpt-box">
                <h3>@T($"Taxa de conversão por Business Unit (mínimo de {AmostraMinima} decididas)", $"Conversion rate by Business Unit (minimum of {AmostraMinima} decided)")</h3>
                @Html(HtmlBuBars(Grupos(_f, i => i.P.Bu), 6, AmostraMinima))
            </div>
            <footer class="rpt-foot">@T("Howden Brasil · Conversão de Propostas · uso interno · página 1 de 2", "Howden Brasil · Proposal Conversion · internal use · page 1 of 2")</footer>
        </section>

        <section class="rpt-page">
            <header class="rpt-head slim"><div class="cvx-title"><span class="cvx-mark">HOWDEN</span><span class="cvx-dash">|</span>@T("Inteligência Comercial", "Commercial Intelligence")</div><div class="rpt-meta"><span><b>@T("Período", "Period")</b> @PeriodoTxt()</span></div></header>
            <div class="rpt-row2 rev">
                <div class="rpt-box">
                    <h3>@T("Vendedores com maior taxa de conversão (mínimo de 10 propostas decididas)", "Salespeople with the highest conversion rate (minimum of 10 decided proposals)")</h3>
                    @Html(HtmlVendTop(8, 10))
                </div>
                <div class="rpt-box">
                    <h3>@T("Concentração das perdas", "Loss concentration")</h3>
                    @Html(HtmlPareto(true, false))
                    <p class="rpt-small">@TextoInsightPerda(false)</p>
                </div>
            </div>
            <div class="rpt-box">
                <h3>@T("Definições e notas metodológicas", "Definitions and methodology notes")</h3>
                @if (_emIngles)
                {
                <ul class="rpt-notes">
                    <li>@if (_baseTodas) { <span><b>Conversion rate</b> = won ÷ all proposals sent (won, lost, open and unclassified). <b>Conversion by value</b> = won value ÷ total quoted value, in R$.</span> } else { <span><b>Conversion rate</b> = won ÷ (won + lost). Open and unclassified proposals are not in the denominator. <b>Conversion by value</b> = won value ÷ (won value + lost value), in R$.</span> }</li>
                    <li><b>Classification</b> by CRM status — Won: Closed - Won, OTP · Lost: Cancelled, Closed - Customer Lost, Closed - Lost, Closed - No Bid, Closed - Unknown · Open: Open · others: unclassified, outside the three categories.</li>
                    <li><b>Sent cohort</b>: the time axis is the month the proposal was sent and shows its current status — not the closing date. Recent months have more open proposals, and their rate may change.</li>
                    <li><b>Values</b> in R$ = value in US$ × USD/BRL rate for the year of the sent date @TaxasTexto(). Proposals without a rate are left out of the values and flagged.</li>
                    <li><b>BU</b> and <b>BU Intercompany</b> are separate fields; BU Intercompany uses column AG and, if empty, AF. Rate comparisons consider samples of at least @AmostraMinima decided proposals; the report rankings require at least 10 decided per salesperson and @AmostraMinima per BU.</li>
                    <li><b>Data quality</b>: @N0(_r.SemTaxa) proposal(s) without an exchange rate · @N0(_r.NC) unclassified · @N0(_r.SemValor) without a US$ value · @N0(Conv.Atual.Propostas.Count) records in the data set. Data from the CRM proposals spreadsheet, updated on @(Conv.AtualizadoEm is { } q3 ? q3.ToString(FmtQuando, CulRz) : "—").</li>
                </ul>
                }
                else
                {
                <ul class="rpt-notes">
                    <li>@if (_baseTodas) { <span><b>Taxa de conversão</b> = ganhas ÷ todas as propostas enviadas (ganhas, perdidas, abertas e não classificadas). <b>Conversão por valor</b> = valor ganho ÷ valor total cotado, em R$.</span> } else { <span><b>Taxa de conversão</b> = ganhas ÷ (ganhas + perdidas). Abertas e não classificadas não entram no denominador. <b>Conversão por valor</b> = valor ganho ÷ (valor ganho + valor perdido), em R$.</span> }</li>
                    <li><b>Classificação</b> pelo status do CRM — Ganhas: Closed - Won, OTP · Perdidas: Cancelled, Closed - Customer Lost, Closed - Lost, Closed - No Bid, Closed - Unknown · Abertas: Open · demais: não classificadas, fora das três categorias.</li>
                    <li><b>Coorte de envio</b>: o eixo de tempo é o mês de envio da proposta e mostra o status atual dela — não a data de fechamento. Meses recentes têm mais propostas abertas, e a taxa deles pode mudar.</li>
                    <li><b>Valores</b> em R$ = valor em US$ × taxa USD/BRL do ano da data de envio @TaxasTexto(). Propostas sem taxa ficam fora dos valores e são sinalizadas.</li>
                    <li><b>BU</b> e <b>BU Intercompany</b> são campos distintos; a BU Intercompany usa a coluna AG e, se vazia, a AF. Comparações de taxa consideram amostras de pelo menos @AmostraMinima propostas decididas; os rankings do relatório exigem no mínimo 10 decididas por vendedor e @AmostraMinima por BU.</li>
                    <li><b>Qualidade dos dados</b>: @N0(_r.SemTaxa) proposta(s) sem taxa de câmbio · @N0(_r.NC) não classificada(s) · @N0(_r.SemValor) sem valor em US$ · @N0(Conv.Atual.Propostas.Count) registros na base. Dados da planilha de propostas do CRM, atualizados em @(Conv.AtualizadoEm is { } q2 ? q2.ToString("dd/MM/yyyy 'às' HH:mm", _pt) : "—").</li>
                </ul>
                }
            </div>
            <footer class="rpt-foot">@T("Howden Brasil · Conversão de Propostas · uso interno · página 2 de 2", "Howden Brasil · Proposal Conversion · internal use · page 2 of 2")</footer>
        </section>
    </div>;
}
