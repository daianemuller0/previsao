@page "/oportunidades"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject OpportunityImporter Importer
@inject IJSRuntime JS

<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Oportunidades</span></div>

<div class="page-head">
    <div>
        <h1>Oportunidades</h1>
        <p class="subtitle">Carteira comercial · @Rows.Count de @_all.Count oportunidade(s) · valor total @Fmt.Brl(Rows.Sum(o => o.AmountBrl))</p>
    </div>
    <div class="page-actions">
        @* Manutenção da base: só o administrador. *@
        @if (_isAdmin)
        {
            <button class="icon-btn danger" title="Excluir base inteira" @onclick="() => _wipe = true">@Icons.Svg("trash")</button>
            <button class="btn-ghost" @onclick="OpenBulk">@Icons.Svg("flag")Indicar em massa</button>
            <button class="btn-ghost" @onclick="OpenUnindicate">@Icons.Svg("x")Desindicar todas</button>
            <button class="btn-ghost" @onclick="OpenImport">@Icons.Svg("import")Importar base</button>
        }
        <button class="btn-primary" @onclick="NewOpp">@Icons.Svg("edit")Nova oportunidade</button>
    </div>
</div>

<div class="exec-grid cols-2">
    <StatCard Label="Abertas" Value="@_openCount.ToString()" Context="no funil" />
    <StatCard Label="Valor total" Value="@("R$ " + Fmt.Compact(Rows.Sum(o => o.AmountBrl)))" Context="carteira no recorte" />
</div>

<div class="filterbar filterbar-sticky">
    <div class="flt"><span class="flt-label">Buscar</span><input class="flt-search" placeholder="oportunidade, cliente, proposta…" @bind="_search" @bind:event="oninput" /></div>
    <MultiFilter Label="Ano" AllText="Todos" Options="Years.Select(y => y.ToString())" Selected="_years" OnChanged="StateHasChanged" />
    <MultiFilter Label="Mês" AllText="Todos" Options="MonthOptions" Selected="_months" OnChanged="StateHasChanged" />
    <div class="flt"><span class="flt-label">De</span><input class="flt-date" type="date" @bind="_dateFrom" /></div>
    <div class="flt"><span class="flt-label">Até</span><input class="flt-date" type="date" @bind="_dateTo" /></div>
    <MultiFilter Label="Mercado" AllText="Todos" Options="MarketOptions" Selected="_markets" OnChanged="StateHasChanged" />
    <MultiFilter Label="KAM" AllText="Todos" EmptyText="Nenhum vendedor nos dados." Options="KamOptions" Selected="_kams" OnChanged="StateHasChanged" />
    <MultiFilter Label="Categoria" AllText="Todas" Options="CategoriaOptions" Selected="_cats" OnChanged="StateHasChanged" />
    <MultiFilter Label="Risco" AllText="Todos" Options="RiscoOptions" Selected="_risks" OnChanged="StateHasChanged" />
    <label class="flt-toggle @(_onlyIndicated ? "on" : "")" title="Mostrar somente as oportunidades indicadas na previsão"><input type="checkbox" @bind="_onlyIndicated" />@Icons.Svg("flag")<span>Somente indicadas</span></label>
    <div class="filterbar-spacer"></div>
    @if (_activeFilters > 0) { <span class="tag">@_activeFilters ativo(s)</span> }
    <button class="btn-link" @onclick="ClearFilters">@Icons.Svg("x")Limpar filtros</button>
</div>

@* Tabela compartilhada com a Visão Executiva: mesmas colunas, mesmas ações e a
   configuração de colunas por usuário (ordem + o que fica visível). *@
<OpportunityTable Rows="Rows" EmptyText="Nenhuma oportunidade encontrada." OnChanged="Reload" />

@* ---- Desindicar em massa: limpa a flag "Indicada" de todas ---- *@
@if (_unind)
{
    <div class="drawer-backdrop" @onclick="() => _unind = false"></div>
    <div class="confirm-box">
        <div class="confirm-head">@Icons.Svg("flag")<span>Desindicar todas</span></div>
        <p class="confirm-text">Remover a marcação <strong>Indicada na Previsão</strong> de <strong>@_indCount</strong> oportunidade(s)? As oportunidades continuam na base — só a indicação é limpa.</p>
        @if (!string.IsNullOrEmpty(_unindMsg)) { <div class="import-summary">@_unindMsg</div> }
        <div class="modal-actions">
            <button class="btn-ghost" disabled="@_unindBusy" @onclick="() => _unind = false">Cancelar</button>
            <button class="btn-primary" disabled="@(_unindBusy || _indCount == 0)" @onclick="ConfirmUnindicate">
                @if (_unindBusy) { <span class="spinner-sm"></span><text>Desindicando…</text> } else { @Icons.Svg("check") <text>Desindicar @_indCount</text> }
            </button>
        </div>
    </div>
}


@* ---- Excluir base inteira (exige a senha "Excluir") ---- *@
@if (_wipe)
{
    <div class="drawer-backdrop" @onclick="CancelWipe"></div>
    <div class="confirm-box">
        <div class="confirm-head">@Icons.Svg("alert")<span>Excluir base inteira</span></div>
        <p class="confirm-text">
            Isso remove <strong>todas as @_all.Count oportunidades</strong> da base, de forma permanente.
            Para confirmar, digite a senha <strong>Excluir</strong> abaixo.
        </p>
        <input class="field" placeholder="Digite: Excluir" @bind="_wipePwd" @bind:event="oninput" @onkeydown="WipeKey" />
        @if (_wipeError) { <div class="confirm-err">Senha incorreta. Digite exatamente <strong>Excluir</strong>.</div> }
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="CancelWipe">Cancelar</button>
            <button class="btn-danger" disabled="@(_wipePwd != WipePassword)" @onclick="ConfirmWipe">@Icons.Svg("trash")Excluir base</button>
        </div>
    </div>
}

@* ---- Importar base a partir de planilha (.xlsx / .xlsm / .xls / .csv) ---- *@
@if (_import)
{
    <div class="drawer-backdrop" @onclick="CancelImport"></div>
    <div class="confirm-box" style="width:min(540px,calc(100vw - 32px))">
        <div class="confirm-head" style="color:var(--primary)">@Icons.Svg("import")<span>Importar base</span></div>
        <p class="confirm-text">
            Envie a planilha do forecast (<strong>.xlsx</strong>, <strong>.xls</strong> ou <strong>.csv</strong>) com as colunas padrão.
            País, mercado, produto, cliente e KAM são casados automaticamente com o catálogo; valores sem correspondência são preservados como texto.
        </p>
        <label class="fld">Arquivo (.xlsx, .xls ou .csv)
            <InputFile class="field" OnChange="OnImportFile" accept=".xlsx,.xlsm,.xls,.csv" />
        </label>
        @if (_importing) { <div class="info-banner mt-16">Lendo o arquivo…</div> }
        @if (!string.IsNullOrEmpty(_importErr)) { <div class="confirm-err">@_importErr</div> }
        @if (_importResult is not null)
        {
            <div class="import-summary mt-16">
                <strong>@_importResult.Read</strong> linha(s) lida(s) ·
                <strong>@_importResult.Rows.Count</strong> pronta(s) para importar
                @if (_importResult.Warnings.Count > 0) { <span> · @_importResult.Warnings.Count aviso(s)</span> }
            </div>
            @if (_importResult.Warnings.Count > 0)
            {
                <details class="import-warns">
                    <summary>Ver avisos (@_importResult.Warnings.Count)</summary>
                    <ul>@foreach (var w in _importResult.Warnings.Take(60)) { <li>@w</li> }</ul>
                </details>
            }
            <div class="fld mt-16">Modo de importação
                <div class="seg-radio">
                    <label><input type="radio" name="impmode" checked="@(_importMode == "add")" @onchange='() => _importMode = "add"' /> Adicionar à base</label>
                    <label><input type="radio" name="impmode" checked="@(_importMode == "replace")" @onchange='() => _importMode = "replace"' /> Substituir base inteira</label>
                </div>
            </div>
        }
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="CancelImport">Cancelar</button>
            <button class="btn-primary" disabled="@(_importResult is null || _importResult.Rows.Count == 0)" @onclick="ConfirmImport">@Icons.Svg("check")Importar @(_importResult?.Rows.Count ?? 0)</button>
        </div>
    </div>
}

@* ---- Indicação em massa (planilha de propostas) ---- *@
@if (_bulk)
{
    <div class="drawer-backdrop" @onclick="() => _bulk = false"></div>
    <div class="confirm-box" style="width:min(560px,calc(100vw - 32px))">
        <div class="confirm-head" style="color:var(--primary)">@Icons.Svg("flag")<span>Indicar na Previsão em massa</span></div>
        <p class="confirm-text">
            Envie uma planilha (<strong>.xlsx</strong>, <strong>.xls</strong> ou <strong>.csv</strong>) com <strong>uma coluna</strong> contendo os
            <strong>códigos de proposta</strong>. As propostas encontradas na base serão marcadas como
            <strong>indicadas na previsão</strong>. Os códigos não encontrados voltam num Excel para você conferir.
        </p>
        <label class="fld">Arquivo (.xlsx, .xls ou .csv)
            <InputFile class="field" OnChange="OnBulkFile" accept=".xlsx,.xlsm,.xls,.csv" />
        </label>
        @if (!string.IsNullOrEmpty(_bulkErr)) { <div class="confirm-err">@_bulkErr</div> }
        @if (_bulkCodes.Count > 0 && _bulkFound is null)
        {
            <div class="import-summary mt-16"><strong>@_bulkCodes.Count</strong> código(s) único(s) a indicar.@(_bulkRawCount > _bulkCodes.Count ? $" ({_bulkRawCount} linhas lidas · {_bulkRawCount - _bulkCodes.Count} repetidas/cabeçalho removidas)" : "")</div>
        }
        @if (_bulkFound is not null)
        {
            <div class="import-summary mt-16">
                <strong>@_bulkFound</strong> proposta(s) indicada(s) ·
                <strong>@(_bulkNotFound?.Count ?? 0)</strong> código(s) não encontrado(s)
            </div>
            @if (_bulkNotFound is { Count: > 0 })
            {
                <div class="mt-16">
                    <button class="btn-ghost" @onclick="DownloadNotFound">@Icons.Svg("download")Baixar não encontrados (.xlsx)</button>
                </div>
            }
        }
        @if (_bulkBusy)
        {
            <div class="import-summary mt-16"><span class="spinner-sm"></span> Indicando @_bulkCodes.Count proposta(s)… aguarde, não feche a janela.</div>
        }
        <div class="modal-actions">
            <button class="btn-ghost" disabled="@_bulkBusy" @onclick="() => _bulk = false">Fechar</button>
            @if (_bulkFound is null)
            {
                <button class="btn-primary" disabled="@(_bulkCodes.Count == 0 || _bulkBusy)" @onclick="ConfirmBulk">
                    @if (_bulkBusy) { <span class="spinner-sm"></span><text>Indicando…</text> }
                    else { @Icons.Svg("check") <text>Indicar @_bulkCodes.Count</text> }
                </button>
            }
        </div>
    </div>
}

@if (_new is not null)
{
    <div class="drawer-backdrop" @onclick="() => _new = null"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div><h2 style="color:var(--primary)">Nova oportunidade</h2><p class="subtitle">Mesmos campos da listagem</p></div>
            <button class="icon-btn" @onclick="() => _new = null">@Icons.Svg("x")</button>
        </div>
        <div class="form-grid">
            <label class="fld">Quarter<input class="field" value="@NewQuarter()" readonly /></label>
            <label class="fld">Date (mês)
                <select class="field" @bind="_newMonthNum">@for (var m = 1; m <= 12; m++){<option value="@m">@m · @Fmt.MonthLong(m)</option>}</select>
            </label>
            <label class="fld">Ano
                <select class="field" @bind="_newYear">@for (var y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++){<option value="@y">@y</option>}</select>
            </label>
            <label class="fld">País<input class="field" list="dl-pais" @bind="_new.CountryId" /></label>
            <label class="fld">Market Variável<input class="field" list="dl-market_var" @bind="_new.SubMarketId" /></label>
            <label class="fld">Market<input class="field" list="dl-market" @bind="_new.MarketId" /></label>
            <label class="fld">Product<input class="field" list="dl-product" @bind="_new.ProductId" /></label>
            <label class="fld">Key Account<input class="field" list="dl-key_account" @bind="_new.KamId" /></label>
            <label class="fld">Customer<input class="field" list="dl-customer" @bind="_new.CustomerId" /></label>
            <label class="fld">Proposta<input class="field" @bind="_new.ProposalNumber" /></label>
            <label class="fld">Net Value<input class="field num" @bind="_new.AmountOriginal" /></label>
            <label class="fld">PM %<input class="field num" @bind="_new.GmPercent" /></label>
            <label class="fld">% de Ganho<input class="field num" @bind="_new.WinProbability" /></label>
            <label class="fld">% de Sair no Mês<input class="field num" @bind="_new.CloseInPeriodProbability" /></label>
            <label class="fld">Chance Conversão<input class="field num" value="@Conf(_new)" readonly /></label>
            @* Oportunidade criada à mão não tem planilha por trás: quem diz o
               setor é a pessoa, e é essa escolha que aparece na coluna Setor. *@
            <label class="fld">Categoria (NB/AFM) <span class="hint">define a coluna Setor</span>
                <select class="field" @bind="_new.Setor">
                    <option value="">—</option>
                    @foreach (var st in Opportunity.SetoresManuais){<option value="@st">@st</option>}
                </select>
            </label>
            <label class="fld">Serviço previsto<input class="field" list="dl-servico" @bind="_new.ServicoPrevisto" /></label>
            <label class="fld">Market onestream<input class="field" list="dl-onestream" @bind="_new.MarketOnestream" /></label>
            <label class="fld">Unidade de Venda<input class="field" list="dl-unidade" @bind="_new.PvBusinessUnitId" /></label>
            <label class="fld">BU Intercompany<input class="field" list="dl-bu_inter" @bind="_new.IntercompanyBu" /></label>
            <label class="fld">Observação<input class="field" @bind="_new.Notes" /></label>
            <label class="fld">PV<input class="field" @bind="_new.PvNumber" /></label>
            <label class="fld">RAMP<input class="field" @bind="_new.Ramp" /></label>
            <label class="fld">VALOR USD<input class="field num" value="@Fmt.Usd(_new.AmountUsd)" readonly /></label>
            <label class="fld">Taxa<input class="field num" @bind="_new.ExchangeRate" /></label>
            <label class="fld">Coluna1<input class="field" @bind="_new.Coluna1" /></label>
            <label class="fld">OTP<select class="field" @bind="_new.Otp"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">TOP 10<select class="field" @bind="_new.Top10"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">KYC<select class="field" @bind="_new.Kyc"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
        </div>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _new = null">Cancelar</button>
            <button class="btn-primary" @onclick="SaveNew">@Icons.Svg("check")Criar</button>
        </div>
    </div>
}


@code {
    private List<Opportunity> _all = new();
    private DateTime _today = DateTime.Today;
    private string _search = "";
    // Filtros multi-seleção (vazio = todos). Guardam os RÓTULOS exibidos.
    private static HashSet<string> NewSet() => new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _cats = NewSet(), _kams = NewSet(), _markets = NewSet(),
                            _risks = NewSet(), _years = NewSet(), _months = NewSet();
    private bool _onlyIndicated;
    private DateTime? _dateFrom, _dateTo;
    private int _openCount;
    private bool _isAdmin;                            // manutenção da base só p/ admin

    // Indicação em massa (planilha de propostas).
    private bool _bulk;
    private string _bulkErr = "";
    private List<string> _bulkCodes = new();
    private int _bulkRawCount;
    private bool _bulkBusy;
    private int? _bulkFound;
    private List<string>? _bulkNotFound;

    // Opções dos filtros vindas dos próprios dados (funciona com listas de texto).
    private IEnumerable<int> Years => _all.Select(o => o.ExpectedDateValue?.Year ?? 0).Where(y => y > 0).Distinct().OrderByDescending(y => y);
    private static IEnumerable<string> MonthOptions => Enumerable.Range(1, 12).Select(Fmt.MonthLong);
    // Opções por RÓTULO (o que aparece na tela), para casar com a seleção múltipla.
    private IEnumerable<string> MarketOptions => _all.Select(o => Cat.MarketName(o.MarketId))
        .Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<string> KamOptions => _all.Select(KamName)
        .Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase);
    private static IEnumerable<string> CategoriaOptions => Enum.GetValues<ForecastCategory>().Select(ForecastCategories.Label);
    private static IEnumerable<string> RiscoOptions => Enum.GetValues<RiskLevel>().Select(RiskLevels.Label);
    private string KamName(Opportunity o) => OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId));

    private IEnumerable<HashSet<string>> AllSets => new[] { _cats, _kams, _markets, _risks, _years, _months };
    private int _activeFilters => (_search != "" ? 1 : 0)
        + AllSets.Count(s => s.Count > 0)
        + (_dateFrom is not null ? 1 : 0) + (_dateTo is not null ? 1 : 0)
        + (_onlyIndicated ? 1 : 0);

    private void ClearFilters()
    {
        _search = "";
        foreach (var s in AllSets) s.Clear();
        _dateFrom = _dateTo = null;
        _onlyIndicated = false;
    }
    private Opportunity? _new;
    private int _newMonthNum = DateTime.Today.Month, _newYear = DateTime.Today.Year;

    // Exclusão da base inteira
    private bool _wipe, _wipeError;
    private string _wipePwd = "";
    private const string WipePassword = "Excluir";

    // Importação
    private bool _import, _importing;
    private string _importFileName = "", _importErr = "", _importMode = "add"; // add | replace
    private OpportunityImporter.Result? _importResult;

    // Rótulos derivados do formulário de nova oportunidade.
    private string NewQuarter() => $"Q{Fmt.QuarterOf(_newMonthNum)} {_newYear}";
    private static string Conf(Opportunity o) => Fmt.Brl(ForecastCalc.ConversionBrl(o));

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private AccessScope _scope = new();
    private string _user = "—";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var st = await AuthState;
            _scope = AccessScope.Resolve(st.User);
            _user = st.User.Identity?.Name ?? "—";
            _isAdmin = _scope.Role == AccessRoles.Admin;
        }
        _all = LoadScoped();
        Recompute();
    }

    // Carrega as oportunidades já recortadas pela carteira permitida do login.
    // Exclui as que viraram "venda indicada" (movidas para o Controle).
    private List<Opportunity> LoadScoped() =>
        Repo.All()
            .Where(o => !o.MovidaControleValue)
            .Where(o => _scope.CanSeeVendedor(OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId))))
            .ToList();

    private void Recompute()
    {
        var open = _all.Where(o => ForecastCategories.IsOpen(o.Category)).ToList();
        _openCount = open.Count;
    }

    // Recarrega depois de qualquer alteração feita na tabela compartilhada
    // (indicar/desindicar, editar, duplicar, excluir, indicar venda).
    private void Reload()
    {
        _all = LoadScoped();
        Recompute();
    }

    // ---- Indicação em massa por planilha de propostas ----
    private void OpenBulk()
    {
        _bulk = true; _bulkErr = "";
        _bulkCodes = new(); _bulkFound = null; _bulkNotFound = null;
    }

    // ---- Desindicar em massa: limpa a flag "Indicada" de todas as oportunidades ----
    private bool _unind;
    private bool _unindBusy;
    private string _unindMsg = "";
    private int _indCount;

    private void OpenUnindicate()
    {
        _indCount = _all.Count(o => o.IndicadaValue);
        _unindMsg = _indCount == 0 ? "Nenhuma oportunidade indicada no momento." : "";
        _unind = true; _unindBusy = false;
    }

    private async Task ConfirmUnindicate()
    {
        if (_unindBusy) return;
        _unindBusy = true; _unindMsg = ""; StateHasChanged();
        var all = _all;
        var cleared = await Task.Run(() =>
        {
            var toSave = new List<Opportunity>();
            foreach (var o in all.Where(x => x.IndicadaValue))
            {
                var full = Repo.Get(o.Id);
                if (full is null || !full.IndicadaValue) continue;
                full.Indicada = "";
                full.UpdatedAt = _today.ToString("yyyy-MM-dd");
                full.UpdatedBy = _user;
                toSave.Add(full);
            }
            if (toSave.Count > 0) Repo.SaveMany(toSave);
            return toSave.Count;
        });
        _all = LoadScoped();
        Recompute();
        _unindBusy = false; _unind = false;
    }

    private async Task OnBulkFile(InputFileChangeEventArgs e)
    {
        _bulkErr = ""; _bulkFound = null; _bulkNotFound = null; _bulkCodes = new(); _bulkRawCount = 0;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            _bulkCodes = ReadBulkCodes(e.File.Name, ms, out _bulkRawCount);
            if (_bulkCodes.Count == 0) _bulkErr = "Nenhum código encontrado na primeira coluna da planilha.";
        }
        catch (Exception ex) { _bulkErr = "Falha ao ler o arquivo: " + ex.Message; }
    }

    // Lê os códigos da 1ª coluna (ignora cabeçalho tipo "proposta"/"código").
    private static List<string> ReadBulkCodes(string fileName, Stream stream, out int rawCount)
    {
        var list = new List<string>();
        if (fileName.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8, true);
            var text = reader.ReadToEnd();
            foreach (var line in text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
            {
                var first = line.Split(';', ',')[0].Trim().Trim('"').Trim();
                if (first != "") list.Add(first);
            }
        }
        else if (fileName.EndsWith(".xls", StringComparison.OrdinalIgnoreCase))
        {
            // .xls (binário antigo): o ClosedXML só lê OpenXML.
            using var reader = ExcelDataReader.ExcelReaderFactory.CreateReader(stream);
            while (reader.Read())
            {
                if (reader.FieldCount == 0 || reader.IsDBNull(0)) continue;
                var v = reader.GetValue(0)?.ToString()?.Trim() ?? "";
                if (v != "") list.Add(v);
            }
        }
        else
        {
            using var wb = new ClosedXML.Excel.XLWorkbook(stream);
            var ws = wb.Worksheets.FirstOrDefault();
            if (ws is not null)
                foreach (var cell in ws.Column(1).CellsUsed())
                {
                    var v = cell.GetString().Trim();
                    if (v != "") list.Add(v);
                }
        }
        // Remove um provável cabeçalho e duplicatas (a mesma proposta costuma
        // repetir em várias linhas — item/produto/parcela). rawCount = linhas lidas.
        rawCount = list.Count;
        return list.Where(c => !IsHeader(c)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static bool IsHeader(string c)
    {
        var n = c.Trim().ToLowerInvariant();
        return n is "proposta" or "propostas" or "codigo" or "código" or "codigos" or "code" or "proposal";
    }

    private async Task ConfirmBulk()
    {
        if (_bulkBusy) return;
        _bulkBusy = true;
        StateHasChanged();          // mostra o "Indicando…" antes do trabalho pesado

        var codes = _bulkCodes;
        var all = _all;
        // Roda fora da thread da UI para o estado "Indicando…" aparecer na hora.
        var (flagged, notFound) = await Task.Run(() =>
        {
            // Índice das oportunidades por número de proposta (pode haver várias por proposta).
            var byProp = all.Where(o => !string.IsNullOrWhiteSpace(o.ProposalNumber))
                .GroupBy(o => o.ProposalNumber.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);

            var nf = new List<string>();
            var toFlag = new List<Opportunity>();
            foreach (var code in codes)
            {
                if (byProp.TryGetValue(code.Trim(), out var opps)) toFlag.AddRange(opps);
                else nf.Add(code);
            }

            // Marca e grava TUDO numa única gravação (SaveMany) — evita centenas
            // de escritas em disco, uma por proposta.
            var toSave = new List<Opportunity>();
            foreach (var o in toFlag)
            {
                var full = Repo.Get(o.Id);
                if (full is null || full.IndicadaValue) continue;
                full.Indicada = "Sim";
                toSave.Add(full);
            }
            if (toSave.Count > 0) Repo.SaveMany(toSave);
            return (toSave.Count, nf);
        });

        _bulkFound = flagged;
        _bulkNotFound = notFound;
        _all = LoadScoped();
        Recompute();
        _bulkBusy = false;
    }

    private async Task DownloadNotFound()
    {
        if (_bulkNotFound is not { Count: > 0 }) return;
        using var wb = new ClosedXML.Excel.XLWorkbook();
        var ws = wb.Worksheets.Add("Não encontrados");
        ws.Cell(1, 1).Value = "Proposta (não encontrada na base)";
        for (var i = 0; i < _bulkNotFound.Count; i++) ws.Cell(i + 2, 1).Value = _bulkNotFound[i];
        ws.Column(1).AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var b64 = Convert.ToBase64String(ms.ToArray());
        await JS.InvokeVoidAsync("appDownload", "propostas_nao_encontradas.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
    }

    // Lista filtrada recomputada a cada render (padrão do projeto de Licenças).
    private List<Opportunity> Rows
    {
        get
        {
            IEnumerable<Opportunity> q = _all;
            if (_onlyIndicated) q = q.Where(o => o.IndicadaValue);
            if (_cats.Count > 0) q = q.Where(o => _cats.Contains(ForecastCategories.Label(o.Category)));
            if (_kams.Count > 0) q = q.Where(o => _kams.Contains(KamName(o)));
            if (_markets.Count > 0) q = q.Where(o => _markets.Contains(Cat.MarketName(o.MarketId)));
            if (_risks.Count > 0) q = q.Where(o => _risks.Contains(RiskLevels.Label(ForecastCalc.Level(o, _today))));
            if (_years.Count > 0) q = q.Where(o => _years.Contains((o.ExpectedDateValue?.Year ?? 0).ToString()));
            if (_months.Count > 0) q = q.Where(o => o.ExpectedDateValue is { } d && _months.Contains(Fmt.MonthLong(d.Month)));
            if (_dateFrom is { } df) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date >= df.Date);
            if (_dateTo is { } dt) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date <= dt.Date);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var b = _search.Trim().ToLowerInvariant();
                q = q.Where(o => (o.Name + o.ProposalNumber + Cat.CustomerName(o.CustomerId)).ToLowerInvariant().Contains(b));
            }
            return q.OrderByDescending(o => o.AmountUsd).ToList();
        }
    }

    // ---- exclusão da base inteira (senha "Excluir") ----
    private void CancelWipe() { _wipe = false; _wipePwd = ""; _wipeError = false; }

    private void WipeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _wipePwd == WipePassword) ConfirmWipe();
    }

    private void ConfirmWipe()
    {
        if (_wipePwd != WipePassword) { _wipeError = true; return; }
        Repo.DeleteAll();
        _all = LoadScoped();
        Recompute();
        CancelWipe();
    }

    // ---- importação de planilha (.xlsx / .xlsm / .xls / .csv) ----
    private void OpenImport()
    {
        _import = true; _importResult = null; _importFileName = ""; _importErr = ""; _importMode = "add";
    }

    private void CancelImport()
    {
        _import = false; _importResult = null; _importFileName = ""; _importErr = "";
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        _importFileName = e.File.Name;
        _importErr = "";
        _importResult = null;
        _importing = true;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            _importResult = Importer.Parse(e.File.Name, ms);
            if (_importResult.Rows.Count == 0 && _importResult.Warnings.Count == 0)
                _importErr = "Nenhuma oportunidade reconhecida no arquivo. Confira o cabeçalho das colunas.";
        }
        catch (Exception ex)
        {
            _importErr = "Falha ao ler o arquivo: " + ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private void ConfirmImport()
    {
        if (_importResult is null || _importResult.Rows.Count == 0) return;
        if (_importMode == "replace") Repo.DeleteAll();
        Repo.SaveMany(_importResult.Rows);
        _all = LoadScoped();
        Recompute();
        CancelImport();
    }

    private void NewOpp()
    {
        // Proposta e PV vêm do Salesforce — preenchidos manualmente, não gerados.
        _new = new Opportunity
        {
            Id = $"opp-{Guid.NewGuid():N}", Name = "", ProposalNumber = "", PvNumber = "",
            CurrencyCode = "BRL", ExchangeRate = Cat.RateToUsd("USD").ToString(System.Globalization.CultureInfo.InvariantCulture),
            AmountOriginal = "0", GmPercent = "25", WinProbability = "40", CloseInPeriodProbability = "40",
            ForecastCategory = "Pipeline", PipelineStageId = "st-qual", CreatedAt = _today.ToString("yyyy-MM-dd"),
        };
        _newMonthNum = _today.AddMonths(2).Month;
        _newYear = _today.AddMonths(2).Year;
    }

    private void SaveNew()
    {
        if (_new is null) return;
        if (_newMonthNum is >= 1 and <= 12 && _newYear >= 2000)
            _new.ExpectedDate = new DateTime(_newYear, _newMonthNum, 1).ToString("yyyy-MM-dd");
        // Nome (para dashboards): usa Product — Customer quando não informado.
        if (string.IsNullOrWhiteSpace(_new.Name))
            _new.Name = string.Join(" — ", new[] { _new.ProductId, _new.CustomerId }.Where(s => !string.IsNullOrWhiteSpace(s)));
        if (string.IsNullOrWhiteSpace(_new.Name))
            _new.Name = string.IsNullOrWhiteSpace(_new.ProposalNumber) ? "Oportunidade" : _new.ProposalNumber;
        _new.UpdatedAt = _today.ToString("yyyy-MM-dd");
        _new.UpdatedBy = _new.KamId;
        Repo.Save(_new);
        _all = LoadScoped();
        Recompute();
        _new = null;
    }
