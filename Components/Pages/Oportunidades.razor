@page "/oportunidades"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject NavigationManager Nav
@inject OpportunityImporter Importer
@inject ListRepository Lists
@inject ControleRepository Controle
@inject IJSRuntime JS

<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Oportunidades</span></div>

<div class="page-head">
    <div>
        <h1>Oportunidades</h1>
        <p class="subtitle">Carteira comercial · @Rows.Count de @_all.Count oportunidade(s) · valor total @Fmt.Brl(Rows.Sum(o => o.AmountBrl))</p>
    </div>
    <div class="page-actions">
        <button class="icon-btn danger" title="Excluir base inteira" @onclick="() => _wipe = true">@Icons.Svg("trash")</button>
        <button class="btn-ghost" @onclick="OpenBulk">@Icons.Svg("flag")Indicar em massa</button>
        <button class="btn-ghost" @onclick="OpenImport">@Icons.Svg("import")Importar base</button>
        <button class="btn-primary" @onclick="NewOpp">@Icons.Svg("edit")Nova oportunidade</button>
    </div>
</div>

<div class="exec-grid cols-2">
    <StatCard Label="Abertas" Value="@_openCount.ToString()" Context="no funil" />
    <StatCard Label="Valor total" Value="@("R$ " + Fmt.Compact(Rows.Sum(o => o.AmountBrl)))" Context="carteira no recorte" />
</div>

<div class="filterbar filterbar-sticky">
    <div class="flt"><span class="flt-label">Buscar</span><input class="flt-search" placeholder="oportunidade, cliente, proposta…" @bind="_search" @bind:event="oninput" /></div>
    <div class="flt"><span class="flt-label">Ano</span><select @bind="_year"><option value="0">Todos</option>@foreach (var y in Years){<option value="@y">@y</option>}</select></div>
    <div class="flt"><span class="flt-label">Mês</span><select @bind="_monthFilter"><option value="0">Todos</option>@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select></div>
    <div class="flt"><span class="flt-label">De</span><input class="flt-date" type="date" @bind="_dateFrom" /></div>
    <div class="flt"><span class="flt-label">Até</span><input class="flt-date" type="date" @bind="_dateTo" /></div>
    <div class="flt"><span class="flt-label">Mercado</span><select @bind="_market"><option value="">Todos</option>@foreach (var m in MarketOptions){<option value="@m">@Cat.MarketName(m)</option>}</select></div>
    <div class="flt"><span class="flt-label">KAM</span><select @bind="_kam"><option value="">Todos</option>@foreach (var k in KamOptions){<option value="@k">@Cat.KamName(k)</option>}</select></div>
    <div class="flt"><span class="flt-label">Categoria</span><select @bind="_cat"><option value="">Todas</option>@foreach (var c in Enum.GetValues<ForecastCategory>()){<option value="@c.ToString()">@ForecastCategories.Label(c)</option>}</select></div>
    <div class="flt"><span class="flt-label">Risco</span><select @bind="_risk"><option value="">Todos</option>@foreach (var r in Enum.GetValues<RiskLevel>()){<option value="@r.ToString()">@RiskLevels.Label(r)</option>}</select></div>
    <label class="flt-toggle @(_onlyIndicated ? "on" : "")" title="Mostrar somente as oportunidades indicadas na previsão"><input type="checkbox" @bind="_onlyIndicated" />@Icons.Svg("flag")<span>Somente indicadas</span></label>
    <div class="filterbar-spacer"></div>
    @if (_activeFilters > 0) { <span class="tag">@_activeFilters ativo(s)</span> <button class="btn-link" @onclick="ClearFilters">Limpar</button> }
</div>

<div class="table-wrap">
    <table class="grid-tbl">
        <thead>
            <tr>
                <th class="center actions-col"></th>
                <th class="nowrap">Quarter</th>
                <th class="nowrap">Date</th>
                <th>País</th>
                <th>Market Variável</th>
                <th>Market</th>
                <th>Product</th>
                <th>Tipo de Equipamento</th>
                <th>Key Account</th>
                <th>Customer</th>
                <th>Proposta</th>
                <th class="right">Net Value</th>
                <th class="right">PM %</th>
                <th class="right">% de Ganho</th>
                <th class="right">% de Sair no Mês</th>
                <th class="right">Chance Conversão</th>
                <th class="center">NB/AFM</th>
                <th>Serviço previsto</th>
                <th>Market onestream</th>
                <th>Unidade de Venda</th>
                <th>BU Intercompany</th>
                <th>Observação</th>
                <th>PV</th>
                <th>RAMP</th>
                <th class="right">VALOR USD</th>
                <th class="right">Taxa</th>
                <th>Coluna1</th>
                <th class="center">OTP</th>
                <th class="center">TOP 10</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Rows)
            {
                var q = o.ExpectedDateValue is { } dt ? $"Q{Fmt.QuarterOf(dt.Month)} {dt.Year}" : "—";
                <tr class="clickable @(o.IndicadaValue ? "row-ind" : "")" @onclick="() => Goto(o.Id)">
                    <td class="center actions-col">
                        <button class="row-act ind-btn @(o.IndicadaValue ? "on" : "")" title="@(o.IndicadaValue ? "Remover da Previsão" : "Indicar na Previsão")" @onclick="() => ToggleIndicada(o)" @onclick:stopPropagation="true">@Icons.Svg("flag")</button>
                        <button class="row-act sell" title="Indicar venda — mover para o Controle (Ofertas e pedidos)" @onclick="() => OpenSell(o)" @onclick:stopPropagation="true">@Icons.Svg("dollar")</button>
                        <button class="row-act" title="Editar oportunidade" @onclick="() => OpenEdit(o)" @onclick:stopPropagation="true">@Icons.Svg("edit")</button>
                        <button class="row-act" title="Duplicar oportunidade" @onclick="() => Duplicate(o)" @onclick:stopPropagation="true">@Icons.Svg("copy")</button>
                        <button class="row-act del" title="Excluir oportunidade" @onclick="() => AskDelete(o)" @onclick:stopPropagation="true">@Icons.Svg("trash")</button>
                    </td>
                    <td class="nowrap">@q</td>
                    <td class="nowrap">@MonthLabel(o)</td>
                    <td>@Cat.CountryName(o.CountryId)</td>
                    <td>@Cat.SubMarketName(o.SubMarketId)</td>
                    <td>@Cat.MarketName(o.MarketId)</td>
                    <td>@Cat.ProductName(o.ProductId)</td>
                    <td>@Cat.EquipmentName(o.EquipmentTypeId)</td>
                    <td>@Cat.KamName(o.KamId)</td>
                    <td class="col-strong">@Cat.CustomerName(o.CustomerId)</td>
                    <td>@o.ProposalNumber</td>
                    <td class="right num">@Fmt.Brl(o.AmountBrl)</td>
                    <td class="right num">@Fmt.Pct(o.GmPercentValue)</td>
                    <td class="right num">@Fmt.Pct(o.WinProbabilityValue)</td>
                    <td class="right num">@Fmt.Pct(o.CloseProbabilityValue)</td>
                    <td class="right num">@Fmt.Brl(ForecastCalc.ConversionBrl(o))</td>
                    <td class="center">@Dash(o.CommercialCategory)</td>
                    <td>@Dash(o.ServicoPrevisto)</td>
                    <td>@Dash(o.MarketOnestream)</td>
                    <td>@Dash(Cat.BuCode(o.PvBusinessUnitId))</td>
                    <td>@Dash(Cat.BuCode(o.IntercompanyBu))</td>
                    <td>@Dash(o.Notes)</td>
                    <td>@Dash(o.PvNumber)</td>
                    <td>@Dash(o.Ramp)</td>
                    <td class="right num">@Fmt.Usd(o.AmountUsd)</td>
                    <td class="right num">@o.ExchangeRateValue.ToString("0.00", _pt)</td>
                    <td>@Dash(o.Coluna1)</td>
                    <td class="center">@Mark(o.Otp)</td>
                    <td class="center">@Mark(o.Top10)</td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="29" class="empty">Nenhuma oportunidade encontrada.</td></tr>
            }
        </tbody>
    </table>
</div>

@* ---- Datalists das listas de preenchimento (sugestões + texto livre) ---- *@
@foreach (var (id, key) in FormLists)
{
    <datalist id="@id">
        @foreach (var v in Lists.Items(key)) { <option value="@v" /> }
    </datalist>
}

@* ---- Confirmar exclusão de uma oportunidade ---- *@
@if (_delTarget is not null)
{
    <div class="drawer-backdrop" @onclick="() => _delTarget = null"></div>
    <div class="confirm-box">
        <div class="confirm-head">@Icons.Svg("alert")<span>Excluir oportunidade</span></div>
        <p class="confirm-text">Tem certeza que deseja excluir <strong>@_delTarget.Name</strong> (@_delTarget.ProposalNumber)? Esta ação não pode ser desfeita.</p>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _delTarget = null">Cancelar</button>
            <button class="btn-danger" @onclick="ConfirmDelete">@Icons.Svg("trash")Excluir</button>
        </div>
    </div>
}

@* ---- Indicar venda: confirmar/editar os dados que vão para o Controle ---- *@
@if (_sell is not null && _sellReg is not null)
{
    <div class="drawer-backdrop" @onclick="() => _sell = null"></div>
    <div class="confirm-box" style="width:min(640px,calc(100vw - 32px))">
        <div class="confirm-head">@Icons.Svg("dollar")<span>Indicar venda</span></div>
        <p class="confirm-text">Confira e, se precisar, <strong>edite</strong> os dados. Ao confirmar, a oferta <strong>sai das Oportunidades</strong> e vai para o <strong>Controle · Ofertas e pedidos</strong>.</p>
        <div class="form-grid">
            <label class="fld">Oferta (proposta)<input class="field" @bind="_sellReg.Oferta" /></label>
            <label class="fld">Pedido (PV)<input class="field" @bind="_sellReg.Pedido" /></label>
            <label class="fld full">Cliente<input class="field" @bind="_sellReg.Cliente" /></label>
            <label class="fld">Mercado<input class="field" @bind="_sellReg.Mercado" /></label>
            <label class="fld">Vendedor (KAM)<input class="field" @bind="_sellReg.Kam" /></label>
            <label class="fld">Valor Líquido (R$)<input class="field num" @bind="_sellReg.ValorLiquido" /></label>
            <label class="fld">POC<input class="field" @bind="_sellReg.Poc" /></label>
            <label class="fld">Semana<input class="field num" @bind="_sellReg.Semana" /></label>
            <label class="fld">Mês
                <select class="field" @bind="_sellReg.Mes"><option value="">—</option>@for (var m = 1; m <= 12; m++){<option value="@Fmt.MonthLong(m)">@Fmt.MonthLong(m)</option>}</select>
            </label>
        </div>
        @if (!string.IsNullOrEmpty(_sellErr)) { <div class="confirm-err">@_sellErr</div> }
        <div class="modal-actions">
            <button class="btn-ghost" disabled="@_sellBusy" @onclick="() => _sell = null">Cancelar</button>
            <button class="btn-primary" disabled="@_sellBusy" @onclick="ConfirmSell">
                @if (_sellBusy) { <span class="spinner-sm"></span><text>Movendo…</text> } else { @Icons.Svg("check") <text>OK, indicar venda</text> }
            </button>
        </div>
    </div>
}

@* ---- Excluir base inteira (exige a senha "Excluir") ---- *@
@if (_wipe)
{
    <div class="drawer-backdrop" @onclick="CancelWipe"></div>
    <div class="confirm-box">
        <div class="confirm-head">@Icons.Svg("alert")<span>Excluir base inteira</span></div>
        <p class="confirm-text">
            Isso remove <strong>todas as @_all.Count oportunidades</strong> da base, de forma permanente.
            Para confirmar, digite a senha <strong>Excluir</strong> abaixo.
        </p>
        <input class="field" placeholder="Digite: Excluir" @bind="_wipePwd" @bind:event="oninput" @onkeydown="WipeKey" />
        @if (_wipeError) { <div class="confirm-err">Senha incorreta. Digite exatamente <strong>Excluir</strong>.</div> }
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="CancelWipe">Cancelar</button>
            <button class="btn-danger" disabled="@(_wipePwd != WipePassword)" @onclick="ConfirmWipe">@Icons.Svg("trash")Excluir base</button>
        </div>
    </div>
}

@* ---- Importar base a partir de planilha (.xlsx / .csv) ---- *@
@if (_import)
{
    <div class="drawer-backdrop" @onclick="CancelImport"></div>
    <div class="confirm-box" style="width:min(540px,calc(100vw - 32px))">
        <div class="confirm-head" style="color:var(--primary)">@Icons.Svg("import")<span>Importar base</span></div>
        <p class="confirm-text">
            Envie a planilha do forecast (<strong>.xlsx</strong> ou <strong>.csv</strong>) com as colunas padrão.
            País, mercado, produto, cliente e KAM são casados automaticamente com o catálogo; valores sem correspondência são preservados como texto.
        </p>
        <label class="fld">Arquivo (.xlsx ou .csv)
            <InputFile class="field" OnChange="OnImportFile" accept=".xlsx,.csv" />
        </label>
        @if (_importing) { <div class="info-banner mt-16">Lendo o arquivo…</div> }
        @if (!string.IsNullOrEmpty(_importErr)) { <div class="confirm-err">@_importErr</div> }
        @if (_importResult is not null)
        {
            <div class="import-summary mt-16">
                <strong>@_importResult.Read</strong> linha(s) lida(s) ·
                <strong>@_importResult.Rows.Count</strong> pronta(s) para importar
                @if (_importResult.Warnings.Count > 0) { <span> · @_importResult.Warnings.Count aviso(s)</span> }
            </div>
            @if (_importResult.Warnings.Count > 0)
            {
                <details class="import-warns">
                    <summary>Ver avisos (@_importResult.Warnings.Count)</summary>
                    <ul>@foreach (var w in _importResult.Warnings.Take(60)) { <li>@w</li> }</ul>
                </details>
            }
            <div class="fld mt-16">Modo de importação
                <div class="seg-radio">
                    <label><input type="radio" name="impmode" checked="@(_importMode == "add")" @onchange='() => _importMode = "add"' /> Adicionar à base</label>
                    <label><input type="radio" name="impmode" checked="@(_importMode == "replace")" @onchange='() => _importMode = "replace"' /> Substituir base inteira</label>
                </div>
            </div>
        }
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="CancelImport">Cancelar</button>
            <button class="btn-primary" disabled="@(_importResult is null || _importResult.Rows.Count == 0)" @onclick="ConfirmImport">@Icons.Svg("check")Importar @(_importResult?.Rows.Count ?? 0)</button>
        </div>
    </div>
}

@* ---- Indicação em massa (planilha de propostas) ---- *@
@if (_bulk)
{
    <div class="drawer-backdrop" @onclick="() => _bulk = false"></div>
    <div class="confirm-box" style="width:min(560px,calc(100vw - 32px))">
        <div class="confirm-head" style="color:var(--primary)">@Icons.Svg("flag")<span>Indicar na Previsão em massa</span></div>
        <p class="confirm-text">
            Envie uma planilha (<strong>.xlsx</strong> ou <strong>.csv</strong>) com <strong>uma coluna</strong> contendo os
            <strong>códigos de proposta</strong>. As propostas encontradas na base serão marcadas como
            <strong>indicadas na previsão</strong>. Os códigos não encontrados voltam num Excel para você conferir.
        </p>
        <label class="fld">Arquivo (.xlsx ou .csv)
            <InputFile class="field" OnChange="OnBulkFile" accept=".xlsx,.csv" />
        </label>
        @if (!string.IsNullOrEmpty(_bulkErr)) { <div class="confirm-err">@_bulkErr</div> }
        @if (_bulkCodes.Count > 0 && _bulkFound is null)
        {
            <div class="import-summary mt-16"><strong>@_bulkCodes.Count</strong> código(s) único(s) a indicar.@(_bulkRawCount > _bulkCodes.Count ? $" ({_bulkRawCount} linhas lidas · {_bulkRawCount - _bulkCodes.Count} repetidas/cabeçalho removidas)" : "")</div>
        }
        @if (_bulkFound is not null)
        {
            <div class="import-summary mt-16">
                <strong>@_bulkFound</strong> proposta(s) indicada(s) ·
                <strong>@(_bulkNotFound?.Count ?? 0)</strong> código(s) não encontrado(s)
            </div>
            @if (_bulkNotFound is { Count: > 0 })
            {
                <div class="mt-16">
                    <button class="btn-ghost" @onclick="DownloadNotFound">@Icons.Svg("download")Baixar não encontrados (.xlsx)</button>
                </div>
            }
        }
        @if (_bulkBusy)
        {
            <div class="import-summary mt-16"><span class="spinner-sm"></span> Indicando @_bulkCodes.Count proposta(s)… aguarde, não feche a janela.</div>
        }
        <div class="modal-actions">
            <button class="btn-ghost" disabled="@_bulkBusy" @onclick="() => _bulk = false">Fechar</button>
            @if (_bulkFound is null)
            {
                <button class="btn-primary" disabled="@(_bulkCodes.Count == 0 || _bulkBusy)" @onclick="ConfirmBulk">
                    @if (_bulkBusy) { <span class="spinner-sm"></span><text>Indicando…</text> }
                    else { @Icons.Svg("check") <text>Indicar @_bulkCodes.Count</text> }
                </button>
            }
        </div>
    </div>
}

@if (_new is not null)
{
    <div class="drawer-backdrop" @onclick="() => _new = null"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div><h2 style="color:var(--primary)">Nova oportunidade</h2><p class="subtitle">Mesmos campos da listagem</p></div>
            <button class="icon-btn" @onclick="() => _new = null">@Icons.Svg("x")</button>
        </div>
        <div class="form-grid">
            <label class="fld">Quarter<input class="field" value="@NewQuarter()" readonly /></label>
            <label class="fld">Date (mês)
                <select class="field" @bind="_newMonthNum">@for (var m = 1; m <= 12; m++){<option value="@m">@m · @Fmt.MonthLong(m)</option>}</select>
            </label>
            <label class="fld">Ano
                <select class="field" @bind="_newYear">@for (var y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++){<option value="@y">@y</option>}</select>
            </label>
            <label class="fld">País<input class="field" list="dl-pais" @bind="_new.CountryId" /></label>
            <label class="fld">Market Variável<input class="field" list="dl-market_var" @bind="_new.SubMarketId" /></label>
            <label class="fld">Market<input class="field" list="dl-market" @bind="_new.MarketId" /></label>
            <label class="fld">Product<input class="field" list="dl-product" @bind="_new.ProductId" /></label>
            <label class="fld">Tipo de Equipamento<input class="field" list="dl-tipo_equip" @bind="_new.EquipmentTypeId" /></label>
            <label class="fld">Key Account<input class="field" list="dl-key_account" @bind="_new.KamId" /></label>
            <label class="fld">Customer<input class="field" list="dl-customer" @bind="_new.CustomerId" /></label>
            <label class="fld">Proposta<input class="field" @bind="_new.ProposalNumber" /></label>
            <label class="fld">Net Value<input class="field num" @bind="_new.AmountOriginal" /></label>
            <label class="fld">PM %<input class="field num" @bind="_new.GmPercent" /></label>
            <label class="fld">% de Ganho<input class="field num" @bind="_new.WinProbability" /></label>
            <label class="fld">% de Sair no Mês<input class="field num" @bind="_new.CloseInPeriodProbability" /></label>
            <label class="fld">Chance Conversão<input class="field num" value="@Conf(_new)" readonly /></label>
            <label class="fld">NB/AFM<input class="field" list="dl-nb_afm" @bind="_new.CommercialCategory" /></label>
            <label class="fld">Serviço previsto<input class="field" list="dl-servico" @bind="_new.ServicoPrevisto" /></label>
            <label class="fld">Market onestream<input class="field" list="dl-onestream" @bind="_new.MarketOnestream" /></label>
            <label class="fld">Unidade de Venda<input class="field" list="dl-unidade" @bind="_new.PvBusinessUnitId" /></label>
            <label class="fld">BU Intercompany<input class="field" list="dl-bu_inter" @bind="_new.IntercompanyBu" /></label>
            <label class="fld">Observação<input class="field" @bind="_new.Notes" /></label>
            <label class="fld">PV<input class="field" @bind="_new.PvNumber" /></label>
            <label class="fld">RAMP<input class="field" @bind="_new.Ramp" /></label>
            <label class="fld">VALOR USD<input class="field num" value="@Fmt.Usd(_new.AmountUsd)" readonly /></label>
            <label class="fld">Taxa<input class="field num" @bind="_new.ExchangeRate" /></label>
            <label class="fld">Coluna1<input class="field" @bind="_new.Coluna1" /></label>
            <label class="fld">OTP<select class="field" @bind="_new.Otp"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">TOP 10<select class="field" @bind="_new.Top10"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
        </div>
        <div class="modal-actions">
            <button class="btn-ghost" @onclick="() => _new = null">Cancelar</button>
            <button class="btn-primary" @onclick="SaveNew">@Icons.Svg("check")Criar</button>
        </div>
    </div>
}

@* ---- Editar oportunidade (todos os campos) ---- *@
@if (_edit is not null)
{
    <div class="drawer-backdrop" @onclick="() => _edit = null"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">@(_editDup ? "Duplicar oportunidade" : "Editar oportunidade")</h2>
                <p class="subtitle">@(_editDup ? "Cópia — ajuste só o que muda e salve como nova" : $"{_edit.ProposalNumber} · altere qualquer campo")</p>
            </div>
            <button class="icon-btn" @onclick="() => _edit = null">@Icons.Svg("x")</button>
        </div>
        <div class="form-grid">
            <label class="fld full">Nome da oportunidade<input class="field" @bind="_edit.Name" /></label>

            <label class="fld">Mês da previsão
                <select class="field" @bind="_editMonthNum">@for (var m = 1; m <= 12; m++){<option value="@m">@Fmt.MonthLong(m)</option>}</select>
            </label>
            <label class="fld">Ano da previsão
                <select class="field" @bind="_editYear">@for (var y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 3; y++){<option value="@y">@y</option>}</select>
            </label>
            <label class="fld">Proposta<input class="field" @bind="_edit.ProposalNumber" /></label>
            <label class="fld">PV<input class="field" @bind="_edit.PvNumber" /></label>

            <label class="fld">País<input class="field" list="dl-pais" @bind="_edit.CountryId" /></label>
            <label class="fld">Market<input class="field" list="dl-market" @bind="_edit.MarketId" /></label>
            <label class="fld">Market Variável<input class="field" list="dl-market_var" @bind="_edit.SubMarketId" /></label>
            <label class="fld">Product<input class="field" list="dl-product" @bind="_edit.ProductId" /></label>
            <label class="fld">Tipo de Equipamento<input class="field" list="dl-tipo_equip" @bind="_edit.EquipmentTypeId" /></label>
            <label class="fld">Key Account<input class="field" list="dl-key_account" @bind="_edit.KamId" /></label>
            <label class="fld">Customer<input class="field" list="dl-customer" @bind="_edit.CustomerId" /></label>
            <label class="fld">Planta
                <select class="field" @bind="_edit.PlantId">
                    <option value="">—</option>
                    @if (Unknown(_edit.PlantId, Cat.Plants.Select(x => x.Id))) { <option value="@_edit.PlantId" selected>@_edit.PlantId</option> }
                    @foreach (var p in Cat.Plants) { <option value="@p.Id">@p.Name</option> }
                </select>
            </label>

            <label class="fld">Categoria (NB/AFM)<input class="field" list="dl-nb_afm" @bind="_edit.CommercialCategory" /></label>
            <label class="fld">Serviço previsto<input class="field" list="dl-servico" @bind="_edit.ServicoPrevisto" /></label>
            <label class="fld">Market onestream<input class="field" list="dl-onestream" @bind="_edit.MarketOnestream" /></label>
            <label class="fld">Forecast Category
                <select class="field" @bind="_edit.ForecastCategory">@foreach (var c in Enum.GetValues<ForecastCategory>()) { <option value="@c.ToString()">@ForecastCategories.Label(c)</option> }</select>
            </label>
            <label class="fld">Etapa
                <select class="field" @bind="_edit.PipelineStageId">
                    <option value="">—</option>
                    @foreach (var s in Cat.Stages) { <option value="@s.Id">@s.Name</option> }
                </select>
            </label>

            <label class="fld">Moeda
                <select class="field" @bind="_edit.CurrencyCode">@foreach (var c in Cat.Currencies) { <option value="@c.Code">@c.Code</option> }</select>
            </label>
            <label class="fld">Net Value (valor)<input class="field num" @bind="_edit.AmountOriginal" /></label>
            <label class="fld">Taxa (BRL/USD)<input class="field num" @bind="_edit.ExchangeRate" /></label>
            <label class="fld">Valor USD (calculado)<input class="field num" value="@Fmt.Usd(_edit.AmountUsd)" readonly /></label>

            <label class="fld">PM % (GM)<input class="field num" @bind="_edit.GmPercent" /></label>
            <label class="fld">% de Ganho<input class="field num" @bind="_edit.WinProbability" /></label>
            <label class="fld">% de Sair no Mês<input class="field num" @bind="_edit.CloseInPeriodProbability" /></label>

            <label class="fld">Unidade de Venda<input class="field" list="dl-unidade" @bind="_edit.PvBusinessUnitId" /></label>
            <label class="fld">BU Intercompany<input class="field" list="dl-bu_inter" @bind="_edit.IntercompanyBu" /></label>

            <label class="fld">RAMP<input class="field" @bind="_edit.Ramp" /></label>
            <label class="fld">Coluna1<input class="field" @bind="_edit.Coluna1" /></label>
            <label class="fld">OTP<select class="field" @bind="_edit.Otp"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld">TOP 10<select class="field" @bind="_edit.Top10"><option value="">—</option><option value="Sim">Sim</option><option value="Não">Não</option></select></label>
            <label class="fld full">Observação<input class="field" @bind="_edit.Notes" /></label>
            <label class="fld full">Próxima ação<input class="field" @bind="_edit.NextAction" /></label>
        </div>
        <div class="modal-actions">
            @if (!_editDup) { <button class="btn-danger-ghost" @onclick="DeleteFromEdit">@Icons.Svg("trash")Excluir</button> }
            <div class="filterbar-spacer"></div>
            <button class="btn-ghost" @onclick="() => _edit = null">Cancelar</button>
            <button class="btn-primary" @onclick="SaveEdit">@Icons.Svg("check")@(_editDup ? "Criar cópia" : "Salvar alterações")</button>
        </div>
    </div>
}

@code {
    private List<Opportunity> _all = new();
    private DateTime _today = DateTime.Today;
    private string _search = "", _cat = "", _kam = "", _market = "", _risk = "";
    private bool _onlyIndicated;
    private int _year, _monthFilter;                 // 0 = todos
    private DateTime? _dateFrom, _dateTo;
    private int _openCount;

    // Indicação em massa (planilha de propostas).
    private bool _bulk;
    private string _bulkErr = "";
    private List<string> _bulkCodes = new();
    private int _bulkRawCount;
    private bool _bulkBusy;
    private int? _bulkFound;
    private List<string>? _bulkNotFound;

    // Opções dos filtros vindas dos próprios dados (funciona com listas de texto).
    private IEnumerable<int> Years => _all.Select(o => o.ExpectedDateValue?.Year ?? 0).Where(y => y > 0).Distinct().OrderByDescending(y => y);
    private IEnumerable<string> MarketOptions => _all.Select(o => o.MarketId).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(Cat.MarketName);
    private IEnumerable<string> KamOptions => _all.Select(o => o.KamId).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(Cat.KamName);
    private int _activeFilters => new[] { _search, _cat, _kam, _market, _risk }.Count(s => s != "")
        + (_year > 0 ? 1 : 0) + (_monthFilter is >= 1 and <= 12 ? 1 : 0) + (_dateFrom is not null ? 1 : 0) + (_dateTo is not null ? 1 : 0)
        + (_onlyIndicated ? 1 : 0);

    private void ClearFilters()
    {
        _search = _cat = _kam = _market = _risk = "";
        _year = _monthFilter = 0; _dateFrom = _dateTo = null;
        _onlyIndicated = false;
    }
    private Opportunity? _new;
    private int _newMonthNum = DateTime.Today.Month, _newYear = DateTime.Today.Year;

    // Edição
    private Opportunity? _edit;
    private bool _editDup; // true quando o drawer está duplicando (cria um novo registro)
    private int _editMonthNum = 1, _editYear = DateTime.Today.Year; // mês/ano da previsão

    // Exclusão
    private Opportunity? _delTarget;
    private bool _wipe, _wipeError;
    private string _wipePwd = "";
    private const string WipePassword = "Excluir";

    // Importação
    private bool _import, _importing;
    private string _importFileName = "", _importErr = "", _importMode = "add"; // add | replace
    private OpportunityImporter.Result? _importResult;

    private static readonly System.Globalization.CultureInfo _pt = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) || s == "—" ? "—" : s!;
    private static MarkupString Mark(string? s) =>
        string.Equals(s, "Sim", StringComparison.OrdinalIgnoreCase) ? new("<span class='mk yes'>Sim</span>")
        : (string.Equals(s, "Não", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "Nao", StringComparison.OrdinalIgnoreCase)) ? new MarkupString("<span class='mk no'>Não</span>")
        : new MarkupString("—");

    // Rótulos derivados do formulário de nova oportunidade.
    private string NewQuarter() => $"Q{Fmt.QuarterOf(_newMonthNum)} {_newYear}";
    private static string Conf(Opportunity o) => Fmt.Brl(ForecastCalc.ConversionBrl(o));

    // Rótulo do mês da previsão (a "Date" é uma referência de mês, não um dia).
    private static string MonthLabel(Opportunity o) =>
        o.ExpectedDateValue is { } d ? $"{Fmt.MonthName(d.Month)}/{d.Year}" : "—";

    // Valor guardado que não corresponde a nenhum Id do catálogo (dado importado).
    private static bool Unknown(string id, IEnumerable<string> knownIds) =>
        !string.IsNullOrEmpty(id) && !knownIds.Contains(id);

    // Datalists (id do <datalist> → chave da lista) usados no preenchimento.
    private static readonly (string Id, string Key)[] FormLists =
    {
        ("dl-pais", "pais"), ("dl-market_var", "market_var"), ("dl-market", "market"),
        ("dl-product", "product"), ("dl-tipo_equip", "tipo_equip"), ("dl-key_account", "key_account"),
        ("dl-customer", "customer"), ("dl-nb_afm", "nb_afm"), ("dl-servico", "servico_previsto"),
        ("dl-onestream", "market_onestream"), ("dl-unidade", "unidade_venda"), ("dl-bu_inter", "bu_intercompany"),
    };

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private AccessScope _scope = new();
    private string _user = "—";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) { var st = await AuthState; _scope = AccessScope.Resolve(st.User); _user = st.User.Identity?.Name ?? "—"; }
        _all = LoadScoped();
        Recompute();
    }

    // Carrega as oportunidades já recortadas pela carteira permitida do login.
    // Exclui as que viraram "venda indicada" (movidas para o Controle).
    private List<Opportunity> LoadScoped() =>
        Repo.All()
            .Where(o => !o.MovidaControleValue)
            .Where(o => _scope.CanSeeVendedor(OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId))))
            .ToList();

    private void Recompute()
    {
        var open = _all.Where(o => ForecastCategories.IsOpen(o.Category)).ToList();
        _openCount = open.Count;
    }

    // ---- Indicação em massa por planilha de propostas ----
    private void OpenBulk()
    {
        _bulk = true; _bulkErr = "";
        _bulkCodes = new(); _bulkFound = null; _bulkNotFound = null;
    }

    private async Task OnBulkFile(InputFileChangeEventArgs e)
    {
        _bulkErr = ""; _bulkFound = null; _bulkNotFound = null; _bulkCodes = new(); _bulkRawCount = 0;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            _bulkCodes = ReadBulkCodes(e.File.Name, ms, out _bulkRawCount);
            if (_bulkCodes.Count == 0) _bulkErr = "Nenhum código encontrado na primeira coluna da planilha.";
        }
        catch (Exception ex) { _bulkErr = "Falha ao ler o arquivo: " + ex.Message; }
    }

    // Lê os códigos da 1ª coluna (ignora cabeçalho tipo "proposta"/"código").
    private static List<string> ReadBulkCodes(string fileName, Stream stream, out int rawCount)
    {
        var list = new List<string>();
        if (fileName.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8, true);
            var text = reader.ReadToEnd();
            foreach (var line in text.Replace("\r\n", "\n").Replace('\r', '\n').Split('\n'))
            {
                var first = line.Split(';', ',')[0].Trim().Trim('"').Trim();
                if (first != "") list.Add(first);
            }
        }
        else
        {
            using var wb = new ClosedXML.Excel.XLWorkbook(stream);
            var ws = wb.Worksheets.FirstOrDefault();
            if (ws is not null)
                foreach (var cell in ws.Column(1).CellsUsed())
                {
                    var v = cell.GetString().Trim();
                    if (v != "") list.Add(v);
                }
        }
        // Remove um provável cabeçalho e duplicatas (a mesma proposta costuma
        // repetir em várias linhas — item/produto/parcela). rawCount = linhas lidas.
        rawCount = list.Count;
        return list.Where(c => !IsHeader(c)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static bool IsHeader(string c)
    {
        var n = c.Trim().ToLowerInvariant();
        return n is "proposta" or "propostas" or "codigo" or "código" or "codigos" or "code" or "proposal";
    }

    private async Task ConfirmBulk()
    {
        if (_bulkBusy) return;
        _bulkBusy = true;
        StateHasChanged();          // mostra o "Indicando…" antes do trabalho pesado

        var codes = _bulkCodes;
        var all = _all;
        // Roda fora da thread da UI para o estado "Indicando…" aparecer na hora.
        var (flagged, notFound) = await Task.Run(() =>
        {
            // Índice das oportunidades por número de proposta (pode haver várias por proposta).
            var byProp = all.Where(o => !string.IsNullOrWhiteSpace(o.ProposalNumber))
                .GroupBy(o => o.ProposalNumber.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);

            var nf = new List<string>();
            var toFlag = new List<Opportunity>();
            foreach (var code in codes)
            {
                if (byProp.TryGetValue(code.Trim(), out var opps)) toFlag.AddRange(opps);
                else nf.Add(code);
            }

            // Marca e grava TUDO numa única gravação (SaveMany) — evita centenas
            // de escritas em disco, uma por proposta.
            var toSave = new List<Opportunity>();
            foreach (var o in toFlag)
            {
                var full = Repo.Get(o.Id);
                if (full is null || full.IndicadaValue) continue;
                full.Indicada = "Sim";
                toSave.Add(full);
            }
            if (toSave.Count > 0) Repo.SaveMany(toSave);
            return (toSave.Count, nf);
        });

        _bulkFound = flagged;
        _bulkNotFound = notFound;
        _all = LoadScoped();
        Recompute();
        _bulkBusy = false;
    }

    private async Task DownloadNotFound()
    {
        if (_bulkNotFound is not { Count: > 0 }) return;
        using var wb = new ClosedXML.Excel.XLWorkbook();
        var ws = wb.Worksheets.Add("Não encontrados");
        ws.Cell(1, 1).Value = "Proposta (não encontrada na base)";
        for (var i = 0; i < _bulkNotFound.Count; i++) ws.Cell(i + 2, 1).Value = _bulkNotFound[i];
        ws.Column(1).AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var b64 = Convert.ToBase64String(ms.ToArray());
        await JS.InvokeVoidAsync("appDownload", "propostas_nao_encontradas.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
    }

    // Lista filtrada recomputada a cada render (padrão do projeto de Licenças).
    private List<Opportunity> Rows
    {
        get
        {
            IEnumerable<Opportunity> q = _all;
            if (_onlyIndicated) q = q.Where(o => o.IndicadaValue);
            if (!string.IsNullOrWhiteSpace(_cat)) q = q.Where(o => o.ForecastCategory == _cat);
            if (!string.IsNullOrWhiteSpace(_kam)) q = q.Where(o => o.KamId == _kam);
            if (!string.IsNullOrWhiteSpace(_market)) q = q.Where(o => o.MarketId == _market);
            if (!string.IsNullOrWhiteSpace(_risk)) q = q.Where(o => ForecastCalc.Level(o, _today).ToString() == _risk);
            if (_year > 0) q = q.Where(o => o.ExpectedDateValue?.Year == _year);
            if (_monthFilter is >= 1 and <= 12) q = q.Where(o => o.ExpectedDateValue?.Month == _monthFilter);
            if (_dateFrom is { } df) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date >= df.Date);
            if (_dateTo is { } dt) q = q.Where(o => o.ExpectedDateValue is { } d && d.Date <= dt.Date);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var b = _search.Trim().ToLowerInvariant();
                q = q.Where(o => (o.Name + o.ProposalNumber + Cat.CustomerName(o.CustomerId)).ToLowerInvariant().Contains(b));
            }
            return q.OrderByDescending(o => o.AmountUsd).ToList();
        }
    }

    private void Goto(string id) => Nav.NavigateTo($"/oportunidades/{id}");

    // ---- edição completa ----
    private void OpenEdit(Opportunity o)
    {
        _editDup = false;
        _edit = Repo.Get(o.Id) ?? o;                       // cópia isolada do cache
        var d = _edit.ExpectedDateValue ?? _today;
        _editMonthNum = d.Month;
        _editYear = d.Year;

        // Dados de demonstração guardam Ids do catálogo; para os campos agora
        // baseados em listas de texto, exibe o nome legível em vez do Id.
        _edit.CountryId = Cat.Countries.FirstOrDefault(x => x.Id == _edit.CountryId)?.Name ?? _edit.CountryId;
        _edit.MarketId = Cat.Markets.FirstOrDefault(x => x.Id == _edit.MarketId)?.Name ?? _edit.MarketId;
        _edit.SubMarketId = Cat.SubMarkets.FirstOrDefault(x => x.Id == _edit.SubMarketId)?.Name ?? _edit.SubMarketId;
        _edit.ProductId = Cat.Products.FirstOrDefault(x => x.Id == _edit.ProductId)?.Name ?? _edit.ProductId;
        _edit.EquipmentTypeId = Cat.EquipmentTypes.FirstOrDefault(x => x.Id == _edit.EquipmentTypeId)?.Name ?? _edit.EquipmentTypeId;
        _edit.KamId = Cat.Kams.FirstOrDefault(x => x.Id == _edit.KamId)?.Name ?? _edit.KamId;
        _edit.CustomerId = Cat.Customers.FirstOrDefault(x => x.Id == _edit.CustomerId)?.Name ?? _edit.CustomerId;
        _edit.PvBusinessUnitId = Cat.BusinessUnits.FirstOrDefault(x => x.Id == _edit.PvBusinessUnitId)?.Code ?? _edit.PvBusinessUnitId;
        _edit.IntercompanyBu = Cat.BusinessUnits.FirstOrDefault(x => x.Id == _edit.IntercompanyBu)?.Code ?? _edit.IntercompanyBu;
    }

    // Duplica: abre o mesmo formulário já preenchido, mas como um NOVO registro.
    private void Duplicate(Opportunity o)
    {
        OpenEdit(o);                                   // reusa tradução + mês/ano
        if (_edit is null) return;
        _edit.Id = "opp-" + Guid.NewGuid().ToString("N");
        _edit.ProposalNumber = "";   // Proposta e PV vêm do Salesforce: preencher manual na cópia
        _edit.PvNumber = "";
        _edit.CreatedAt = _today.ToString("yyyy-MM-dd");
        _editDup = true;
    }

    private void SaveEdit()
    {
        if (_edit is null) return;
        // O mês/ano da previsão viram uma data real no 1º dia do mês escolhido.
        if (_editMonthNum is >= 1 and <= 12 && _editYear >= 2000)
            _edit.ExpectedDate = new DateTime(_editYear, _editMonthNum, 1).ToString("yyyy-MM-dd");
        _edit.UpdatedAt = _today.ToString("yyyy-MM-dd");
        _edit.UpdatedBy = Cat.KamName(_edit.KamId);
        Repo.Save(_edit);
        _all = LoadScoped();
        Recompute();
        _edit = null;
    }

    private void DeleteFromEdit()
    {
        if (_edit is null) return;
        _delTarget = _edit;
        _edit = null;
    }

    // ---- exclusão de uma oportunidade ----
    private void AskDelete(Opportunity o) => _delTarget = o;

    // Indicar / remover da Previsão (marcador do vendedor), persiste e recarrega.
    private void ToggleIndicada(Opportunity o)
    {
        var full = Repo.Get(o.Id) ?? o;
        full.Indicada = full.IndicadaValue ? "" : "Sim";
        full.UpdatedAt = _today.ToString("yyyy-MM-dd");
        Repo.Save(full);
        _all = LoadScoped();
        Recompute();
    }

    private void ConfirmDelete()
    {
        if (_delTarget is null) return;
        Repo.Delete(_delTarget.Id);
        _all = LoadScoped();
        Recompute();
        _delTarget = null;
    }

    // ---- Indicar venda: move a oportunidade para o Controle (Ofertas e pedidos) ----
    private Opportunity? _sell;
    private ControleRegistro? _sellReg;
    private string _sellErr = "";
    private bool _sellBusy;

    // Monta um rascunho editável do registro (Ofertas e pedidos) a partir da proposta.
    private void OpenSell(Opportunity o)
    {
        _sell = o; _sellErr = ""; _sellBusy = false;
        var d = o.ExpectedDateValue;
        _sellReg = new ControleRegistro
        {
            Oferta = string.IsNullOrWhiteSpace(o.ProposalNumber) ? o.Name : o.ProposalNumber,
            Pedido = o.PvNumber,
            Cliente = Cat.CustomerName(o.CustomerId),
            Mercado = Cat.MarketName(o.MarketId),
            Kam = OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId)),
            ValorLiquido = o.AmountBrl.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
            Semana = d is { } dd ? System.Globalization.ISOWeek.GetWeekOfYear(dd).ToString() : "",
            Mes = d is { } dm ? Fmt.MonthLong(dm.Month) : "",
            Poc = Fmt.Pct(o.WinProbabilityValue),
        };
    }

    private async Task ConfirmSell()
    {
        if (_sell is null || _sellReg is null || _sellBusy) return;
        _sellBusy = true; _sellErr = "";
        var o = _sell;
        var reg = _sellReg;
        try
        {
            await Task.Run(() =>
            {
                Controle.SaveRegistro(reg, _user);   // usa os valores (possivelmente editados)

                // Marca a oportunidade como movida (sai das Oportunidades, preservado no sync).
                var full = Repo.Get(o.Id) ?? o;
                full.MovidaControle = "Sim";
                full.UpdatedAt = _today.ToString("yyyy-MM-dd");
                full.UpdatedBy = _user;
                Repo.Save(full);
            });
            _sell = null; _sellReg = null;
            _all = LoadScoped();
            Recompute();
        }
        catch (Exception ex) { _sellErr = "Falha ao indicar a venda: " + ex.Message; }
        finally { _sellBusy = false; }
    }

    // ---- exclusão da base inteira (senha "Excluir") ----
    private void CancelWipe() { _wipe = false; _wipePwd = ""; _wipeError = false; }

    private void WipeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _wipePwd == WipePassword) ConfirmWipe();
    }

    private void ConfirmWipe()
    {
        if (_wipePwd != WipePassword) { _wipeError = true; return; }
        Repo.DeleteAll();
        _all = LoadScoped();
        Recompute();
        CancelWipe();
    }

    // ---- importação de planilha (.xlsx / .csv) ----
    private void OpenImport()
    {
        _import = true; _importResult = null; _importFileName = ""; _importErr = ""; _importMode = "add";
    }

    private void CancelImport()
    {
        _import = false; _importResult = null; _importFileName = ""; _importErr = "";
    }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        _importFileName = e.File.Name;
        _importErr = "";
        _importResult = null;
        _importing = true;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            _importResult = Importer.Parse(e.File.Name, ms);
            if (_importResult.Rows.Count == 0 && _importResult.Warnings.Count == 0)
                _importErr = "Nenhuma oportunidade reconhecida no arquivo. Confira o cabeçalho das colunas.";
        }
        catch (Exception ex)
        {
            _importErr = "Falha ao ler o arquivo: " + ex.Message;
        }
        finally
        {
            _importing = false;
        }
    }

    private void ConfirmImport()
    {
        if (_importResult is null || _importResult.Rows.Count == 0) return;
        if (_importMode == "replace") Repo.DeleteAll();
        Repo.SaveMany(_importResult.Rows);
        _all = LoadScoped();
        Recompute();
        CancelImport();
    }

    private void NewOpp()
    {
        // Proposta e PV vêm do Salesforce — preenchidos manualmente, não gerados.
        _new = new Opportunity
        {
            Id = $"opp-{Guid.NewGuid():N}", Name = "", ProposalNumber = "", PvNumber = "",
            CurrencyCode = "BRL", ExchangeRate = Cat.RateToUsd("USD").ToString(System.Globalization.CultureInfo.InvariantCulture),
            AmountOriginal = "0", GmPercent = "25", WinProbability = "40", CloseInPeriodProbability = "40",
            ForecastCategory = "Pipeline", PipelineStageId = "st-qual", CreatedAt = _today.ToString("yyyy-MM-dd"),
        };
        _newMonthNum = _today.AddMonths(2).Month;
        _newYear = _today.AddMonths(2).Year;
    }

    private void SaveNew()
    {
        if (_new is null) return;
        if (_newMonthNum is >= 1 and <= 12 && _newYear >= 2000)
            _new.ExpectedDate = new DateTime(_newYear, _newMonthNum, 1).ToString("yyyy-MM-dd");
        // Nome (para dashboards): usa Product — Customer quando não informado.
        if (string.IsNullOrWhiteSpace(_new.Name))
            _new.Name = string.Join(" — ", new[] { _new.ProductId, _new.CustomerId }.Where(s => !string.IsNullOrWhiteSpace(s)));
        if (string.IsNullOrWhiteSpace(_new.Name))
            _new.Name = string.IsNullOrWhiteSpace(_new.ProposalNumber) ? "Oportunidade" : _new.ProposalNumber;
        _new.UpdatedAt = _today.ToString("yyyy-MM-dd");
        _new.UpdatedBy = _new.KamId;
        Repo.Save(_new);
        _all = LoadScoped();
        Recompute();
        _new = null;
    }
}
