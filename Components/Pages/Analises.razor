@page "/analises"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat

<div class="breadcrumbs"><span>Inteligência</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Análises</span></div>

<div class="page-head">
    <div>
        <h1>Análises</h1>
        <p class="subtitle">Central de indicadores comerciais · win rate, accuracy, bias, ciclo e performance</p>
    </div>
    <div class="page-actions"><a class="btn-ghost" href="/forecast/export" target="_blank">@Icons.Svg("download")Exportar base</a></div>
</div>

<div class="exec-grid cols-6">
    <StatCard Label="Win rate" Value="@Fmt.Pct(_winRate)" Context="@($"{_won} ganhas / {_lost} perdidas")" AccentLeft="true" />
    <StatCard Label="Loss rate" Value="@Fmt.Pct(100 - _winRate)" Context="oportunidades perdidas" />
    <StatCard Label="Ticket médio" Value="@Fmt.UsdShort(_ticket)" Context="negócios ganhos" />
    <StatCard Label="Margem média" Value="@Fmt.Pct(_gmAvg)" Context="GM% da carteira" />
    <StatCard Label="Ciclo médio" Value="@($"{_cycle} dias")" Context="criação → fechamento" />
    <StatCard Label="Aging médio" Value="@($"{_aging} dias")" Context="oportunidades abertas" />
</div>

<div class="grid-2">
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Performance por KAM</div></div>
        <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
            <table class="grid-tbl">
                <thead><tr><th>KAM</th><th class="right">Forecast</th><th class="right">Realizado</th><th class="right">Win rate</th><th class="right">GM médio</th></tr></thead>
                <tbody>
                    @foreach (var k in _byKam)
                    {
                        <tr><td class="col-strong">@k.Name</td><td class="right num">@Fmt.UsdShort(k.Forecast)</td><td class="right num">@Fmt.UsdShort(k.Realized)</td><td class="right num">@Fmt.Pct(k.WinRate)</td><td class="right num">@Fmt.Pct(k.Gm)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Forecast bias por KAM <span class="hint">vendedor − gestor</span></div></div>
        @{ var maxBias = _bias.Count > 0 ? Math.Max(_bias.Max(b => Math.Abs(b.Bias)), 1) : 1; }
        @foreach (var b in _bias)
        {
            <div class="bar-row">
                <span class="bar-label">@b.Name</span>
                <span class="bar-track"><span class="bar-fill" style="width:@(Math.Round(Math.Abs(b.Bias) / maxBias * 100))%;background:@(b.Bias >= 0 ? "#b4590a" : "#1665a8")"></span></span>
                <span class="bar-value">@(b.Bias >= 0 ? "+" : "")@b.Bias.ToString("0")pp</span>
            </div>
        }
        <div class="muted" style="font-size:11.5px;margin-top:8px">Valores positivos indicam tendência a superestimar (vendedor acima do gestor).</div>
    </div>
</div>

<div class="grid-2">
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Performance por mercado</div></div>
        @{ var maxM = _byMarket.Count > 0 ? Math.Max(_byMarket.Max(m => m.Value), 1) : 1; }
        @foreach (var m in _byMarket)
        {
            <div class="bar-row"><span class="bar-label">@m.Name</span><span class="bar-track"><span class="bar-fill c-primary" style="width:@(Math.Round(m.Value / maxM * 100))%"></span></span><span class="bar-value">@Fmt.UsdShort(m.Value)</span></div>
        }
    </div>
    <div class="panel">
        <div class="panel-head"><div class="panel-title">Forecast accuracy <span class="hint">realizado ÷ previsto (indicativo)</span></div></div>
        <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
            <table class="grid-tbl">
                <thead><tr><th>Quarter</th><th class="right">Previsto</th><th class="right">Realizado</th><th class="right">Accuracy</th></tr></thead>
                <tbody>
                    @foreach (var a in _accuracy)
                    {
                        <tr><td class="col-strong">@a.Label</td><td class="right num">@Fmt.UsdShort(a.Forecast)</td><td class="right num">@Fmt.UsdShort(a.Realized)</td><td class="right num"><span class="badge @(a.Accuracy >= 90 ? "st-pos" : a.Accuracy >= 75 ? "st-warn" : "st-neg")">@Fmt.Pct(a.Accuracy)</span></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private DateTime _today = DateTime.Today;
    private int _won, _lost, _cycle, _aging;
    private double _winRate, _ticket, _gmAvg;

    private record KamPerf(string Name, double Forecast, double Realized, double WinRate, double Gm);
    private record BiasRow(string Name, double Bias);
    private record NamedAgg(string Name, double Value);
    private record Acc(string Label, double Forecast, double Realized, double Accuracy);
    private List<KamPerf> _byKam = new();
    private List<BiasRow> _bias = new();
    private List<NamedAgg> _byMarket = new();
    private List<Acc> _accuracy = new();

    protected override void OnInitialized()
    {
        var opps = Repo.All();
        var won = opps.Where(o => o.Category == ForecastCategory.ClosedWon).ToList();
        var lost = opps.Where(o => o.Category == ForecastCategory.ClosedLost).ToList();
        _won = won.Count; _lost = lost.Count;
        _winRate = (_won + _lost) > 0 ? (double)_won / (_won + _lost) * 100 : 0;
        _ticket = won.Count > 0 ? won.Average(o => o.AmountUsd) : 0;
        _gmAvg = opps.Count > 0 ? opps.Average(o => o.GmPercentValue) : 0;
        _cycle = won.Count > 0 ? (int)won.Average(CycleDays) : 0;
        var open = opps.Where(o => ForecastCategories.IsOpen(o.Category)).ToList();
        _aging = open.Count > 0 ? (int)open.Average(AgeDays) : 0;

        _byKam = Cat.Kams.Select(k =>
        {
            var mine = opps.Where(o => o.KamId == k.Id).ToList();
            var w = mine.Count(o => o.Category == ForecastCategory.ClosedWon);
            var l = mine.Count(o => o.Category == ForecastCategory.ClosedLost);
            return new KamPerf(k.Name,
                mine.Where(o => ForecastCategories.CountsToForecast(o.Category)).Sum(ForecastCalc.WeightedUsd),
                mine.Where(o => o.Category == ForecastCategory.ClosedWon).Sum(o => o.AmountUsd),
                (w + l) > 0 ? (double)w / (w + l) * 100 : 0,
                mine.Count > 0 ? mine.Average(o => o.GmPercentValue) : 0);
        }).OrderByDescending(x => x.Forecast).ToList();

        _bias = Cat.Kams.Select(k =>
        {
            var withMgr = opps.Where(o => o.KamId == k.Id && o.ManagerProbabilityValue is not null).ToList();
            var bias = withMgr.Count > 0 ? withMgr.Average(o => o.WinProbabilityValue - o.ManagerProbabilityValue!.Value) : 0;
            return new BiasRow(k.Name, bias);
        }).OrderByDescending(x => Math.Abs(x.Bias)).ToList();

        _byMarket = Cat.Markets.Select(m => new NamedAgg(m.Name,
            opps.Where(o => o.MarketId == m.Id && ForecastCategories.CountsToForecast(o.Category)).Sum(ForecastCalc.WeightedUsd)))
            .OrderByDescending(x => x.Value).ToList();

        // Accuracy por quarter (indicativo): previsto = ponderado elegível do quarter;
        // realizado = ganho no quarter; accuracy = min(realizado/previsto, previsto/realizado).
        var year = _today.Year;
        _accuracy = Enumerable.Range(1, 4).Select(q =>
        {
            var inQ = opps.Where(o => (o.ExpectedDateValue?.Year ?? 0) == year && Fmt.QuarterOf(o.ExpectedDateValue!.Value.Month) == q).ToList();
            var fc = inQ.Where(o => ForecastCategories.CountsToForecast(o.Category)).Sum(ForecastCalc.WeightedUsd);
            var re = inQ.Where(o => o.Category == ForecastCategory.ClosedWon).Sum(o => o.AmountUsd);
            double acc = fc > 0 && re > 0 ? Math.Min(re / fc, fc / re) * 100 : (re > 0 || fc > 0 ? 60 : 0);
            return new Acc($"Q{q} {year}", fc, re, acc);
        }).ToList();
    }

    private int CycleDays(Opportunity o)
    {
        var c = DateTime.TryParse(o.CreatedAt, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var cr) ? cr : _today;
        var e = o.ExpectedDateValue ?? _today;
        return Math.Max(0, (int)(e - c).TotalDays);
    }
    private int AgeDays(Opportunity o)
    {
        var c = DateTime.TryParse(o.CreatedAt, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var cr) ? cr : _today;
        return Math.Max(0, (int)(_today - c).TotalDays);
    }
}
