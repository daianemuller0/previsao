@page "/clientes"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat

<div class="breadcrumbs"><span>Dados</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Clientes e Plantas</span></div>

<div class="page-head">
    <div>
        <h1>Clientes e Plantas</h1>
        <p class="subtitle">@Cat.Customers.Count clientes · @Cat.Plants.Count plantas · base instalada industrial</p>
    </div>
</div>

<div class="table-wrap">
    <table class="grid-tbl">
        <thead>
            <tr><th>Cliente</th><th>Mercado</th><th>País</th><th class="right">Plantas</th><th class="right">Oportunidades</th><th class="right">Pipeline USD</th><th class="right">Ponderado</th></tr>
        </thead>
        <tbody>
            @foreach (var c in _rows)
            {
                <tr>
                    <td class="col-strong">@c.Name</td>
                    <td>@Cat.MarketName(c.MarketId)</td>
                    <td>@Cat.CountryName(c.CountryId)</td>
                    <td class="right num">@c.Plants</td>
                    <td class="right num">@c.Opps</td>
                    <td class="right num">@Fmt.Usd(c.Pipeline)</td>
                    <td class="right num">@Fmt.Usd(c.Weighted)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td colspan="5">Total</td><td class="right">@Fmt.Usd(_rows.Sum(r => r.Pipeline))</td><td class="right">@Fmt.Usd(_rows.Sum(r => r.Weighted))</td></tr>
        </tfoot>
    </table>
</div>

<div class="panel mt-16">
    <div class="panel-head"><div class="panel-title">Plantas por cliente</div></div>
    <div class="table-wrap" style="box-shadow:none;border:1px solid var(--border)">
        <table class="grid-tbl">
            <thead><tr><th>Planta</th><th>Cliente</th><th>Localização</th></tr></thead>
            <tbody>
                @foreach (var p in Cat.Plants)
                {
                    <tr><td class="col-strong">@p.Name</td><td>@Cat.CustomerName(p.CustomerId)</td><td>@p.Location</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private record Row(string Name, string MarketId, string CountryId, int Plants, int Opps, double Pipeline, double Weighted);
    private List<Row> _rows = new();

    protected override void OnInitialized()
    {
        var opps = Repo.All();
        _rows = Cat.Customers.Select(c =>
        {
            var items = opps.Where(o => o.CustomerId == c.Id && ForecastCategories.IsOpen(o.Category)).ToList();
            return new Row(c.Name, c.MarketId, c.CountryId,
                Cat.Plants.Count(p => p.CustomerId == c.Id), items.Count,
                items.Sum(o => o.AmountUsd), items.Sum(ForecastCalc.WeightedUsd));
        }).OrderByDescending(r => r.Pipeline).ToList();
    }
}
