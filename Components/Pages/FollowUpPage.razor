@page "/followup"
@attribute [Authorize]
@rendermode InteractiveServer
@inject OpportunityRepository Repo
@inject Catalog Cat
@inject FollowUpRepository FUp
@inject ContactLookupService Contacts
@inject IJSRuntime JS

@* ===========================================================================
   Follow-up das propostas em aberto. Puxa as oportunidades em aberto do forecast
   e organiza a ROTINA de acompanhamento em 4 marcos de contato (pós-envio, 15
   dias antes, 1 semana antes e no fechamento), com modelos de e-mail em 3 idiomas.
   =========================================================================== *@

<div class="breadcrumbs"><span>Comercial</span><span class="sep">/</span><span class="strong" style="color:var(--text-2)">Follow-up</span></div>

<div class="page-head">
    <div>
        <h1>Follow-up de propostas</h1>
        <p class="subtitle">Rotina de acompanhamento das propostas em aberto · @_rows.Count proposta(s) · @Fmt.Brl(_rows.Sum(r => r.Opp.AmountBrl)) em pipeline</p>
    </div>
    <div class="page-actions">
        <button class="btn-ghost" disabled="@_searching" @onclick="BuscarContatos" title="Busca o nome e o e-mail do contato do cliente nos arquivos de proposta da rede (para as propostas do filtro que ainda não têm contato)">
            @if (_searching) { <span class="spinner-sm"></span><text>Buscando contatos…</text> }
            else { @Icons.Svg("users") <text>Buscar contatos</text> }
        </button>
        <button class="btn-ghost" @onclick="() => _showTpl = true">@Icons.Svg("edit")Modelo de e-mail</button>
        <button class="btn-ghost" @onclick="IniciarEnvioMassa">@Icons.Svg("mail")Enviar em massa</button>
        <button class="btn-primary" @onclick="IniciarRotina">@Icons.Svg("play")Iniciar rotina</button>
    </div>
</div>
@if (!string.IsNullOrEmpty(_contactMsg))
{
    <div class="import-summary" style="margin-top:10px">@Icons.Svg("users") @_contactMsg</div>
}

@* ---- Rotina de Follow-up (marcos) ---- *@
<div class="fu-routine">
    <div class="fu-routine-top">
        <div class="fu-routine-title">Rotina de Follow-up <span class="fu-routine-tag">@_rows.Count(r => r.Rank == 0) em atraso</span></div>
    </div>
    <p class="fu-routine-sub">Cobre os clientes por e-mail, na ordem de prioridade (mais atrasado primeiro). Marcos: <strong>3 dias úteis após o envio</strong>, <strong>15 dias</strong> e <strong>1 semana antes do fechamento</strong>, e <strong>no dia do fechamento</strong>.</p>
    <div class="fu-chips">
        <span class="fu-chip late">@_rows.Count(r => r.Rank == 0) em atraso</span>
        <span class="fu-chip">@_rows.Count(r => r.Cur?.Num == 1) · 1º pós-envio</span>
        <span class="fu-chip">@_rows.Count(r => r.Cur?.Num == 2) · 2º −15 dias</span>
        <span class="fu-chip">@_rows.Count(r => r.Cur?.Num == 3) · 3º −7 dias</span>
        <span class="fu-chip">@_rows.Count(r => r.Cur?.Num == 4) · 4º fechamento</span>
        <span class="fu-chip done">@_rows.Count(r => r.Cur is null) · concluídas</span>
    </div>
</div>

@* ---- Filtros ---- *@
<div class="filterbar" style="margin-top:14px">
    <div class="flt"><span class="flt-label">Vendedor</span><select @bind="_kam"><option value="">Todos</option>@foreach (var v in _kamOptions){<option value="@v">@v</option>}</select></div>
    <div class="flt"><span class="flt-label">Status</span><select @bind="_status"><option value="">Todos</option>@foreach (var s in FollowUpStatus.All){<option value="@s">@s</option>}</select></div>
    <label class="flt-toggle @(_onlyDue ? "on" : "")" title="Só os que precisam de contato agora (em atraso ou hoje)"><input type="checkbox" @bind="_onlyDue" />@Icons.Svg("clock")<span>Só pendentes de contato</span></label>
    <div class="filterbar-spacer"></div>
    <span class="tag">@Filtered().Count() proposta(s)</span>
</div>

@* ---- Lista ---- *@
<div class="table-wrap tbl-compact" style="max-height:700px;overflow:auto;margin-top:12px">
    <table class="grid-tbl">
        <thead>
            <tr>
                <th class="no-sort">Marco / prazo</th>
                <th class="no-sort">Cliente / Proposta</th>
                <th class="no-sort">Contato</th>
                <th class="no-sort">Vendedor</th>
                <th class="no-sort right">Valor</th>
                <th class="no-sort">Fechamento</th>
                <th class="no-sort">Último contato</th>
                <th class="no-sort">Status</th>
                <th class="no-sort center">Ação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Filtered())
            {
                <tr class="@(r.Rank == 0 ? "fu-urgent" : "")">
                    <td>
                        <span class="fu-due @DueCss(r)">@DueLabel(r)</span>
                        <div class="fu-sub">@(r.Cur?.Label ?? "rotina concluída")</div>
                    </td>
                    <td class="col-strong">@Cat.CustomerName(r.Opp.CustomerId)<div class="fu-sub">@Proposta(r.Opp)</div></td>
                    <td>
                        @if (r.Fu.HasContact)
                        {
                            @if (!string.IsNullOrWhiteSpace(r.Fu.ContactName)) { <div>@r.Fu.ContactName</div> }
                            @if (!string.IsNullOrWhiteSpace(r.Fu.ContactEmail)) { <div class="fu-sub">@Icons.Svg("mail") @r.Fu.ContactEmail</div> }
                        }
                        else { <span class="muted">—</span> }
                    </td>
                    <td>@Vendedor(r.Opp)</td>
                    <td class="right num">@Fmt.Brl(r.Opp.AmountBrl)</td>
                    <td class="nowrap">@Fmt.Date(r.Opp.ExpectedDate)</td>
                    <td class="nowrap">@(r.Fu.LastContactValue is { } lc ? lc.ToString("dd/MM/yy") : "—")</td>
                    <td><span class="badge @StatusCss(r.Fu.Status)">@r.Fu.Status</span></td>
                    <td class="center nowrap">
                        <button class="btn-ghost" style="padding:3px 9px" @onclick="() => OpenRegister(r, false)">@Icons.Svg("check")Contatar</button>
                    </td>
                </tr>
            }
            @if (!Filtered().Any())
            {
                <tr><td colspan="9" class="empty">Nenhuma proposta em aberto no filtro.</td></tr>
            }
        </tbody>
    </table>
</div>

@* ---- Registrar contato (drawer) ---- *@
@if (_edit is not null && _editOpp is not null && _editRow is not null)
{
    <div class="drawer-backdrop" @onclick="CloseDrawer"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">Registrar contato@(_routineMode ? $" · {_queueIdx + 1} de {_queue.Count}" : "")</h2>
                <p class="subtitle">@Cat.CustomerName(_editOpp.CustomerId) · @Proposta(_editOpp) · marco: @(_editRow.Cur?.Label ?? "concluído")</p>
            </div>
            <button class="icon-btn" @onclick="CloseDrawer">@Icons.Svg("x")</button>
        </div>

        @* Contato do cliente (buscado nos arquivos de proposta) *@
        <div class="fu-contact">
            <span class="fu-contact-ico">@Icons.Svg("mail")</span>
            @if (_editRow.Fu.HasContact)
            {
                <div class="fu-contact-info">
                    @if (!string.IsNullOrWhiteSpace(_editRow.Fu.ContactName)) { <strong>@_editRow.Fu.ContactName</strong> }
                    @if (!string.IsNullOrWhiteSpace(_editRow.Fu.ContactEmail)) { <span class="fu-contact-mail">@_editRow.Fu.ContactEmail</span> }
                </div>
                @if (!string.IsNullOrWhiteSpace(_editRow.Fu.ContactEmail))
                {
                    <button class="btn-ghost" style="padding:3px 9px" @onclick="async () => await CopyText(_editRow!.Fu.ContactEmail)">@Icons.Svg("copy")Copiar e-mail</button>
                }
            }
            else
            {
                <span class="muted">Sem contato do cliente.</span>
                <button class="btn-ghost" style="padding:3px 9px" disabled="@_searching" @onclick="() => BuscarContatoDaLinha(_editRow)">
                    @if (_searching) { <span class="spinner-sm"></span><text>Buscando…</text> } else { @Icons.Svg("users")<text>Buscar contato</text> }
                </button>
            }
        </div>

        @* Modelo de e-mail do marco atual, nos 3 idiomas *@
        <div class="fu-mail">
            <div class="fu-mail-head">
                <span class="fu-mail-t">Modelo de e-mail — @(_editRow.Cur?.Label ?? "—")</span>
                <div class="seg-tabs">
                    @for (var i = 0; i < FollowUpRoutine.Langs.Length; i++)
                    {
                        var li = i;
                        <button class="seg-tab @(_lang == li ? "on" : "")" @onclick="() => _lang = li">@FollowUpRoutine.Langs[li]</button>
                    }
                </div>
            </div>
            <textarea class="field fu-mail-body" rows="9" readonly>@CurrentEmail()</textarea>
            <div class="fu-mail-actions">
                <button class="btn-ghost" @onclick="CopyEmail">@Icons.Svg("copy")Copiar e-mail</button>
                @if (_copyOk) { <span class="fu-copied">Copiado!</span> }
            </div>
        </div>

        <div class="form-grid">
            <label class="fld">Data de envio da proposta<input class="field" type="date" @bind="_regSent" /></label>
            <label class="fld">Data do contato<input class="field" type="date" @bind="_regDate" /></label>
            <label class="fld">Canal<select class="field" @bind="_regChannel">@foreach (var c in FollowUpChannel.All){<option value="@c">@c</option>}</select></label>
            <label class="fld">Resultado / Status<select class="field" @bind="_regStatus">@foreach (var s in FollowUpStatus.All){<option value="@s">@s</option>}</select></label>
            <label class="fld full">Observação<textarea class="field" rows="2" @bind="_regNote" placeholder="O que foi tratado, próximos passos…"></textarea></label>
        </div>

        <div class="fu-hist">
            <div class="fu-hist-h">Histórico</div>
            @if (_editLogs.Count == 0) { <div class="muted" style="font-size:12px">Nenhuma interação registrada ainda.</div> }
            else
            {
                @foreach (var l in _editLogs)
                {
                    <div class="fu-hist-row">
                        <span class="fu-hist-date">@(l.TsValue?.ToString("dd/MM/yy") ?? "—")</span>
                        <span class="fu-hist-body"><strong>@l.Channel</strong> · @l.Outcome@(string.IsNullOrWhiteSpace(l.Note) ? "" : " — " + l.Note)</span>
                    </div>
                }
            }
        </div>

        <div class="modal-actions">
            <button class="btn-ghost" @onclick="CloseDrawer">Fechar</button>
            @if (_routineMode && _queueIdx < _queue.Count - 1)
            {
                <button class="btn-ghost" @onclick="() => SaveRegister(true)">Registrar e próximo</button>
            }
            <button class="btn-primary" @onclick="() => SaveRegister(false)">@Icons.Svg("check")Registrar contato</button>
        </div>
    </div>
}

@* ---- Modelos de e-mail (referência) ---- *@
@if (_showTpl)
{
    <div class="drawer-backdrop" @onclick="() => _showTpl = false"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">Modelos de e-mail</h2>
                <p class="subtitle">Um modelo por marco de contato · três idiomas · use {cliente} {proposta} {valor} {fechamento} {vendedor}</p>
            </div>
            <button class="icon-btn" @onclick="() => _showTpl = false">@Icons.Svg("x")</button>
        </div>
        <div class="seg-tabs" style="margin-bottom:12px">
            @for (var i = 0; i < FollowUpRoutine.Langs.Length; i++)
            {
                var li = i;
                <button class="seg-tab @(_tplLang == li ? "on" : "")" @onclick="() => _tplLang = li">@FollowUpRoutine.Langs[li]</button>
            }
        </div>
        @for (var m = 1; m <= 4; m++)
        {
            var mm = m;
            <div class="fu-tpl">
                <div class="fu-tpl-h">@MarcoNome(mm)</div>
                <textarea class="field fu-mail-body" rows="8" readonly>@FollowUpRoutine.Email(mm, _tplLang, _sampleCtx)</textarea>
                <button class="btn-ghost" style="margin-top:6px" @onclick="async () => await CopyText(FollowUpRoutine.Email(mm, _tplLang, _sampleCtx))">@Icons.Svg("copy")Copiar</button>
            </div>
        }
    </div>
}

@* ---- Envio em massa (rascunhos revisáveis, em fila) ---- *@
@if (_massMode)
{
    var mr = MassCurrentRow();
    <div class="drawer-backdrop" @onclick="CloseMass"></div>
    <div class="drawer drawer-wide">
        <div class="page-head">
            <div>
                <h2 style="color:var(--primary)">Envio em massa · @(_massIdx + 1) de @_massQueue.Count</h2>
                <p class="subtitle">Abre um rascunho por proposta no seu e-mail · você revisa e envia · o contato do dia é registrado e a rotina avança</p>
            </div>
            <button class="icon-btn" @onclick="CloseMass">@Icons.Svg("x")</button>
        </div>

        @if (_massSkipped > 0)
        {
            <div class="import-summary" style="margin-bottom:12px">@_massSkipped proposta(s) do filtro ficaram de fora por não ter e-mail de contato — use <strong>Buscar contatos</strong> antes.</div>
        }

        @if (mr is null)
        {
            <div class="empty">Nada para enviar.</div>
        }
        else
        {
            <div class="fu-contact">
                <span class="fu-contact-ico">@Icons.Svg("mail")</span>
                <div class="fu-contact-info">
                    <strong>@Cat.CustomerName(mr.Opp.CustomerId)</strong>
                    <span class="fu-contact-mail">@Proposta(mr.Opp) · @(mr.Cur?.Label ?? "concluído") · para: @mr.Fu.ContactEmail</span>
                </div>
            </div>

            <div class="fu-mail">
                <div class="fu-mail-head">
                    <span class="fu-mail-t">Rascunho — @(mr.Cur?.Label ?? "—")</span>
                    <div class="seg-tabs">
                        @for (var i = 0; i < FollowUpRoutine.Langs.Length; i++)
                        {
                            var li = i;
                            <button class="seg-tab @(_massLang == li ? "on" : "")" @onclick="() => _massLang = li">@FollowUpRoutine.Langs[li]</button>
                        }
                    </div>
                </div>
                <textarea class="field fu-mail-body" rows="9" readonly>@MassEmailPreview(mr)</textarea>
                <div class="fu-mail-actions">
                    <button class="btn-ghost" @onclick="() => MassAbrirRascunho(mr)">@Icons.Svg("mail")Abrir rascunho de e-mail</button>
                </div>
            </div>
        }

        <div class="modal-actions">
            <button class="btn-ghost" @onclick="CloseMass">Fechar</button>
            <button class="btn-ghost" @onclick="MassPular">Pular</button>
            @if (mr is not null)
            {
                <button class="btn-primary" @onclick="() => MassMarcarProximo(mr)">@Icons.Svg("check")Marcar enviado e próximo</button>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _user = "—";
    private readonly DateTime _today = DateTime.Today;

    private record Row(Opportunity Opp, FollowUp Fu, List<FollowUpRoutine.Milestone> Ms, FollowUpRoutine.Milestone? Cur, int Rank);

    private List<Row> _rows = new();
    private IEnumerable<string> _kamOptions = Array.Empty<string>();

    // Filtros.
    private string _kam = "", _status = "";
    private bool _onlyDue;

    // Drawer de contato.
    private FollowUp? _edit;
    private Opportunity? _editOpp;
    private Row? _editRow;
    private DateTime? _regDate, _regNext, _regSent;
    private string _regChannel = "Ligação", _regStatus = FollowUpStatus.EmContato, _regNote = "";
    private int _lang;
    private bool _copyOk;
    private List<FollowUpLog> _editLogs = new();

    // Rotina guiada.
    private bool _routineMode;
    private List<Row> _queue = new();
    private int _queueIdx;

    // Busca de contatos.
    private bool _searching;
    private string _contactMsg = "";

    // Envio em massa (rascunhos revisáveis, em fila).
    private bool _massMode;
    private List<Opportunity> _massQueue = new();
    private int _massIdx;
    private int _massLang;
    private int _massSkipped;

    // Modelos de e-mail (modal).
    private bool _showTpl;
    private int _tplLang;
    private readonly FollowUpRoutine.EmailCtx _sampleCtx = new("{cliente}", "{proposta}", "{valor}", "{fechamento}", "{vendedor}");

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) { var st = await AuthState; _user = st.User.Identity?.Name ?? "—"; }
        Load();
    }

    private void Load()
    {
        var fu = FUp.All();
        var open = Repo.All().Where(o => ForecastCategories.IsOpen(o.Category)).ToList();

        _rows = open.Select(o =>
        {
            var f = fu.TryGetValue(o.Id, out var x) ? x : new FollowUp { Id = o.Id, Status = FollowUpStatus.Pendente };
            var sent = f.SentDateValue ?? ParseDate(o.CreatedAt);
            var ms = FollowUpRoutine.Milestones(sent, o.ExpectedDateValue);
            var cur = FollowUpRoutine.Current(ms, f.LastContactValue);
            int rank;
            if (cur is null) rank = 5;                                            // rotina concluída
            else { var days = (cur.Date.Date - _today).Days; rank = days < 0 ? 0 : days == 0 ? 1 : days <= 7 ? 2 : 3; }
            return new Row(o, f, ms, cur, rank);
        })
        .OrderBy(r => r.Rank)
        .ThenBy(r => r.Cur?.Date ?? DateTime.MaxValue)
        .ThenByDescending(r => r.Opp.AmountBrl)
        .ToList();

        _kamOptions = _rows.Select(r => Vendedor(r.Opp)).Where(s => !string.IsNullOrWhiteSpace(s) && s != "—")
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private IEnumerable<Row> Filtered()
    {
        IEnumerable<Row> q = _rows;
        if (_kam != "") q = q.Where(r => string.Equals(Vendedor(r.Opp), _kam, StringComparison.OrdinalIgnoreCase));
        if (_status != "") q = q.Where(r => r.Fu.Status == _status);
        if (_onlyDue) q = q.Where(r => r.Rank <= 1);
        return q;
    }

    // ---- Busca do contato do cliente (nome + e-mail) nos arquivos de proposta ----
    // Porte da rotina VBA: as propostas já estão na base; só buscamos o contato.
    private async Task BuscarContatos()
    {
        if (_searching) return;
        if (!Contacts.Enabled) { _contactMsg = "Busca de contatos desativada nas configurações (Contatos:Enabled)."; return; }

        // Alvos: propostas do filtro que ainda não têm contato.
        var targets = Filtered().Where(r => !r.Fu.HasContact).Select(r => r.Opp).ToList();
        if (targets.Count == 0) { _contactMsg = "Todas as propostas do filtro já têm contato."; return; }

        _searching = true; _contactMsg = ""; StateHasChanged();

        var (found, notFound) = await Task.Run(() =>
        {
            var dict = FUp.All();
            int f = 0, nf = 0;
            foreach (var o in targets)
            {
                if (TryFindAndSave(o, dict)) f++; else nf++;
            }
            return (f, nf);
        });

        _searching = false;
        _contactMsg = $"Contatos encontrados: {found} · sem contato: {notFound} (de {targets.Count} proposta(s) do filtro).";
        Load();
    }

    // Busca o contato de UMA proposta (botão dentro do drawer).
    private async Task BuscarContatoDaLinha(Row r)
    {
        if (_searching) return;
        if (!Contacts.Enabled) { _contactMsg = "Busca de contatos desativada nas configurações (Contatos:Enabled)."; return; }
        _searching = true; StateHasChanged();

        var ok = await Task.Run(() => TryFindAndSave(r.Opp, FUp.All()));

        _searching = false;
        Load();
        // Atualiza o drawer com o registro recém-gravado (mantém o marco atual).
        var updated = _rows.FirstOrDefault(x => x.Opp.Id == r.Opp.Id);
        if (updated is not null) _editRow = updated;
        _contactMsg = ok ? "Contato localizado." : "Contato não localizado nos arquivos de proposta.";
    }

    // Executa a busca e grava o contato encontrado. Devolve true se achou algo.
    private bool TryFindAndSave(Opportunity o, Dictionary<string, FollowUp> dict)
    {
        var codigo = (o.ProposalNumber ?? "").Trim();
        if (codigo == "") return false;
        var hit = Contacts.Find(codigo, Cat.BuCode(o.PvBusinessUnitId));
        if (!hit.Found) return false;
        var fu = dict.TryGetValue(o.Id, out var x) ? x : new FollowUp { Id = o.Id, Status = FollowUpStatus.Pendente };
        if (!string.IsNullOrWhiteSpace(hit.Name)) fu.ContactName = hit.Name;
        if (!string.IsNullOrWhiteSpace(hit.Email)) fu.ContactEmail = hit.Email;
        FUp.Save(fu, _user);
        return true;
    }

    private string Vendedor(Opportunity o) => OpportunityImporter.CanonicalVendedor(Cat.KamName(o.KamId));
    private string Proposta(Opportunity o) => string.IsNullOrWhiteSpace(o.ProposalNumber) ? o.Name : o.ProposalNumber;
    private static DateTime? ParseDate(string s) =>
        DateTime.TryParse(s, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    // ---- rotina guiada ----
    private void IniciarRotina()
    {
        _queue = _rows.Where(r => r.Rank <= 1).ToList();   // em atraso + para hoje
        if (_queue.Count == 0) { _queue = _rows.Where(r => r.Cur is not null).ToList(); }
        if (_queue.Count == 0) return;
        _routineMode = true; _queueIdx = 0;
        OpenRegister(_queue[0], true);
    }

    // ---- envio em massa (rascunhos revisáveis, em fila) ----
    private void IniciarEnvioMassa()
    {
        // Elegíveis: propostas do filtro com marco pendente E e-mail de contato.
        var pend = Filtered().Where(r => r.Cur is not null).ToList();
        var comEmail = pend.Where(r => !string.IsNullOrWhiteSpace(r.Fu.ContactEmail)).ToList();
        _massSkipped = pend.Count - comEmail.Count;
        _massQueue = comEmail.Select(r => r.Opp).ToList();
        if (_massQueue.Count == 0)
        {
            _contactMsg = _massSkipped > 0
                ? $"{_massSkipped} proposta(s) sem e-mail de contato — use \"Buscar contatos\" antes de enviar em massa."
                : "Nenhuma proposta pendente de contato no filtro.";
            return;
        }
        _massIdx = 0; _massLang = 0; _massMode = true;
    }

    private Row? MassCurrentRow()
    {
        if (_massIdx < 0 || _massIdx >= _massQueue.Count) return null;
        var id = _massQueue[_massIdx].Id;
        return _rows.FirstOrDefault(r => r.Opp.Id == id);
    }

    private FollowUpRoutine.EmailCtx CtxFor(Row r)
    {
        var o = r.Opp;
        return new FollowUpRoutine.EmailCtx(Cat.CustomerName(o.CustomerId), Proposta(o), Fmt.Brl(o.AmountBrl), Fmt.Date(o.ExpectedDate), Vendedor(o));
    }

    private string MassEmailPreview(Row r) => FollowUpRoutine.Email(r.Cur?.Num ?? 1, _massLang, CtxFor(r));

    // Abre o rascunho no cliente de e-mail padrão (mailto:) para revisão/envio.
    private async Task MassAbrirRascunho(Row r)
    {
        var (subj, body) = FollowUpRoutine.EmailParts(r.Cur?.Num ?? 1, _massLang, CtxFor(r));
        var to = (r.Fu.ContactEmail ?? "").Trim();
        var b = body.Replace("\r\n", "\n").Replace("\n", "\r\n");   // quebras de linha p/ o mailto
        var url = $"mailto:{Uri.EscapeDataString(to)}?subject={Uri.EscapeDataString(subj)}&body={Uri.EscapeDataString(b)}";
        await JS.InvokeVoidAsync("openMail", url);
    }

    // Registra o contato do dia (avança a rotina) e passa para a próxima proposta.
    private void MassMarcarProximo(Row r)
    {
        var dict = FUp.All();
        var f = dict.TryGetValue(r.Opp.Id, out var x) ? x : new FollowUp { Id = r.Opp.Id, Status = FollowUpStatus.Pendente };
        if (string.IsNullOrWhiteSpace(f.SentDate))
            f.SentDate = (r.Fu.SentDateValue ?? ParseDate(r.Opp.CreatedAt) ?? _today).ToString("yyyy-MM-dd");
        if (FollowUpStatus.IsActive(f.Status)) f.Status = FollowUpStatus.EmContato;
        f.LastContact = _today.ToString("yyyy-MM-dd");
        f.NextFollowUp = "";
        FUp.Save(f, _user);
        FUp.AddLog(new FollowUpLog
        {
            OppId = r.Opp.Id, User = _user, Channel = "E-mail", Outcome = f.Status,
            Note = "Follow-up em massa", Ts = _today.ToString("yyyy-MM-ddTHH:mm:ss"),
        });
        Load();
        Avancar();
    }

    private void MassPular() => Avancar();

    private void Avancar()
    {
        _massIdx++;
        if (_massIdx >= _massQueue.Count) CloseMass();
    }

    private void CloseMass()
    {
        var done = _massMode;
        _massMode = false; _massQueue = new(); _massIdx = 0; _massSkipped = 0;
        if (done) _contactMsg = "Envio em massa concluído.";
    }

    // ---- drawer ----
    private void OpenRegister(Row r, bool routine)
    {
        _routineMode = routine;
        _editRow = r;
        _editOpp = r.Opp;
        _edit = new FollowUp
        {
            Id = r.Fu.Id, Status = r.Fu.Status, SentDate = r.Fu.SentDate, LastContact = r.Fu.LastContact,
            NextFollowUp = r.Fu.NextFollowUp, CadenceDays = r.Fu.CadenceDays, Notes = r.Fu.Notes,
        };
        _regSent = r.Fu.SentDateValue ?? ParseDate(r.Opp.CreatedAt) ?? _today;
        _regDate = _today;
        _regChannel = "E-mail";
        _regStatus = FollowUpStatus.IsActive(r.Fu.Status) && r.Fu.Status != FollowUpStatus.Pendente ? r.Fu.Status : FollowUpStatus.EmContato;
        _regNote = "";
        _lang = 0;
        _copyOk = false;
        _editLogs = FUp.Logs(r.Opp.Id);
    }

    private void CloseDrawer() { _edit = null; _editOpp = null; _editRow = null; _routineMode = false; }

    private string CurrentEmail()
    {
        if (_editOpp is null || _editRow is null) return "";
        var o = _editOpp;
        var ctx = new FollowUpRoutine.EmailCtx(Cat.CustomerName(o.CustomerId), Proposta(o), Fmt.Brl(o.AmountBrl), Fmt.Date(o.ExpectedDate), Vendedor(o));
        return FollowUpRoutine.Email(_editRow.Cur?.Num ?? 1, _lang, ctx);
    }

    private async Task CopyEmail() { _copyOk = await CopyText(CurrentEmail()); }

    private async Task<bool> CopyText(string text)
    {
        try { var ok = await JS.InvokeAsync<bool>("copyText", text); _copyOk = ok; return ok; }
        catch { return false; }
    }

    private void SaveRegister(bool next)
    {
        if (_edit is null || _editOpp is null) return;
        var contato = _regDate ?? _today;
        _edit.SentDate = _regSent?.ToString("yyyy-MM-dd") ?? _edit.SentDate;
        _edit.Status = _regStatus;
        _edit.LastContact = contato.ToString("yyyy-MM-dd");
        // Próximo follow-up = próximo marco após este contato (recalculado no Load).
        _edit.NextFollowUp = "";
        _edit.Notes = _regNote;
        FUp.Save(_edit, _user);
        FUp.AddLog(new FollowUpLog
        {
            OppId = _editOpp.Id, User = _user, Channel = _regChannel, Outcome = _regStatus,
            Note = _regNote, Ts = contato.ToString("yyyy-MM-ddTHH:mm:ss"),
        });
        Load();

        if (next && _routineMode && _queueIdx < _queue.Count - 1)
        {
            _queueIdx++;
            var nextRow = _rows.FirstOrDefault(r => r.Opp.Id == _queue[_queueIdx].Opp.Id) ?? _queue[_queueIdx];
            OpenRegister(nextRow, true);
        }
        else { CloseDrawer(); }
    }

    // ---- rótulos / cores ----
    private static string MarcoNome(int m) => m switch
    {
        1 => "1º · pós-envio (3 dias úteis após o envio)",
        2 => "2º · 15 dias antes do fechamento",
        3 => "3º · 1 semana antes do fechamento",
        _ => "4º · no dia do fechamento",
    };

    private string DueLabel(Row r)
    {
        if (r.Cur is null) return "Concluída";
        var days = (r.Cur.Date.Date - _today).Days;
        return days < 0 ? $"Atrasado {-days}d" : days == 0 ? "Hoje" : days <= 7 ? $"Em {days}d" : r.Cur.Date.ToString("dd/MM");
    }
    private static string DueCss(Row r) => r.Rank switch { 0 => "due-late", 1 => "due-today", 2 => "due-week", 5 => "due-done", _ => "due-future" };

    private static string StatusCss(string s) => s switch
    {
        FollowUpStatus.Ganho => "fc-commit",
        FollowUpStatus.Perdido => "badge-neg",
        FollowUpStatus.SemRetorno => "fc-pipe",
        FollowUpStatus.Aguardando => "fc-upside",
        FollowUpStatus.EmContato => "fc-best",
        _ => "fc-pipe",
    };
}
