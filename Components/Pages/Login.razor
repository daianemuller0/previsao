@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject HowdenSalesForecast.Data.BrandRepository Brand

<div class="cover">
    <!-- Painel esquerdo: apresentação -->
    <div class="cover-left">
        <div class="cover-top">
            <div class="cover-brand">
                @if (LoginLogo is { } logo)
                {
                    <img src="@logo" alt="Logo" class="cover-logo-img" />
                }
                else
                {
                    <div class="brand-mark big">H</div>
                    <div class="cover-brand-text"><strong>Howden</strong><span>A Chart Industries Company</span></div>
                }
            </div>
            <div class="cover-tags-top">
                <span>ENTERPRISE PLATFORM</span>
                <span class="dot">·</span>
                <span>SALES &amp; REVENUE INTELLIGENCE</span>
            </div>
        </div>

        <div class="cover-hero">
            <div class="cover-eyebrow">Sales Forecast</div>
            <h1 class="cover-title">Previsão de vendas para <span>bater a meta</span> com decisões guiadas por dados</h1>
            <p class="cover-desc">
                Plataforma executiva de previsão comercial: consolida o pipeline, pondera o
                forecast pela probabilidade de ganho e acompanha metas, oportunidades e
                resultados da operação de vendas em tempo real.
            </p>
            <ul class="cover-list">
                <li>@Icons.Svg("check")Forecast ponderado pela probabilidade de ganho e de fechamento</li>
                <li>@Icons.Svg("check")Pipeline e oportunidades priorizados por valor e chance de conversão</li>
                <li>@Icons.Svg("check")Metas, atingimento e gaps por período, por mercado e por KAM</li>
                <li>@Icons.Svg("check")Controladoria comercial: budget, realizado e projeção mês a mês</li>
            </ul>
            <div class="cover-badges">
                <span>Sales Forecast</span>
                <span>Pipeline Analytics</span>
                <span>Revenue Intelligence</span>
            </div>
        </div>
    </div>

    <!-- Painel direito: formulário -->
    <div class="cover-right">
        <div class="cover-form">
            <div class="cover-eyebrow dark">Sales &amp; Revenue Intelligence</div>
            <h2 class="cover-form-title">Acesso à plataforma</h2>
            <p class="cover-form-sub">Entre para acompanhar previsões, pipeline e indicadores executivos da sua operação comercial.</p>

            @if (Error)
            {
                <div class="alert-error">Usuário ou senha inválidos.</div>
            }

            <form method="post" action="/auth/login" class="login-form">
                <label>Usuário
                    <input type="text" name="usuario" autocomplete="username" placeholder="usuario@howden.com" required />
                </label>
                <label>Senha
                    <input type="password" name="senha" autocomplete="current-password" placeholder="••••••••" required />
                </label>
                <label>Perfil de acesso
                    <select name="perfil">
                        @foreach (var r in Roles.All)
                        {
                            <option value="@r.Role">@r.Label</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn-primary">Acessar plataforma @Icons.Svg("arrow-right")</button>
            </form>

            <div class="cover-form-foot">
                @Icons.Svg("lock")<span>Conexão segura · acesso restrito</span>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorFlag { get; set; }

    private bool Error => ErrorFlag == "1";
    private string? LoginLogo => Brand.Get(HowdenSalesForecast.Data.BrandRepository.LoginLogo);
}
