@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject HowdenSalesForecast.Data.BrandRepository Brand

<div class="cover">
    <!-- Painel esquerdo: apresentação -->
    <div class="cover-left">
        <div class="cover-top">
            <div class="cover-brand">
                @if (LoginLogo is { } logo)
                {
                    <img src="@logo" alt="Logo" class="cover-logo-img" />
                }
                else
                {
                    <div class="brand-mark big">H</div>
                    <div class="cover-brand-text"><strong>Howden</strong><span>A Chart Industries Company</span></div>
                }
            </div>
            <div class="cover-tags-top">
                <span>ENTERPRISE PLATFORM</span>
                <span class="dot">·</span>
                <span>SALES &amp; REVENUE INTELLIGENCE</span>
            </div>
        </div>

        <div class="cover-hero">
            <div class="cover-eyebrow">Sales Forecast</div>
            <h1 class="cover-title">Dados integrados para uma <span>gestão comercial mais precisa</span></h1>
            <p class="cover-desc">
                Uma plataforma integrada para consolidar previsões de vendas, acompanhar a
                evolução do pipeline e transformar dados comerciais em informações
                estratégicas para toda a organização.
            </p>
            <ul class="cover-list">
                <li>@Icons.Svg("check")Previsões ponderadas por probabilidade e expectativa de fechamento</li>
                <li>@Icons.Svg("check")Visão consolidada por região, mercado, unidade de negócio e responsável</li>
                <li>@Icons.Svg("check")Monitoramento de metas, desvios e oportunidades prioritárias</li>
                <li>@Icons.Svg("check")Comparativo entre orçamento, realizado e projeções futuras</li>
                <li>@Icons.Svg("check")Indicadores executivos para decisões comerciais mais rápidas e consistentes</li>
            </ul>
            <div class="cover-badges">
                <span>Sales Forecast</span>
                <span>Pipeline Management</span>
                <span>Revenue Intelligence</span>
            </div>
        </div>
    </div>

    <!-- Painel direito: formulário -->
    <div class="cover-right">
        <div class="cover-form">
            <div class="cover-eyebrow dark">Sales &amp; Revenue Intelligence</div>
            <h2 class="cover-form-title">Acesso ao ambiente corporativo</h2>
            <p class="cover-form-sub">Entre para acompanhar previsões, oportunidades, metas e indicadores estratégicos da operação comercial.</p>

            @if (Error)
            {
                <div class="alert-error">Usuário ou senha inválidos.</div>
            }

            <form method="post" action="/auth/login" class="login-form">
                <label>Usuário
                    <input type="text" name="usuario" autocomplete="username" placeholder="usuario@howden.com" required />
                </label>
                <label>Senha
                    <input type="password" name="senha" autocomplete="current-password" placeholder="••••••••" required />
                </label>
                <label>Perfil de acesso
                    <select name="perfil">
                        @foreach (var r in Roles.All)
                        {
                            <option value="@r.Role">@r.Label</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn-primary">Acessar plataforma @Icons.Svg("arrow-right")</button>
            </form>

            <div class="cover-form-foot">
                @Icons.Svg("lock")<span>Ambiente corporativo seguro • Acesso exclusivo para usuários autorizados</span>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorFlag { get; set; }

    private bool Error => ErrorFlag == "1";
    private string? LoginLogo => Brand.Get(HowdenSalesForecast.Data.BrandRepository.LoginLogo);
}
